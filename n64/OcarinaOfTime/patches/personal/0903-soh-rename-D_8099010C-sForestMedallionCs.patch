From 02ef96f16895135afdf9990450a837061b674e52 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:19:45 +0000
Subject: [PATCH 0903/3799] soh: rename D_8099010C -> sForestMedallionCs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: CutsceneData script installed into csCtx.segment by DemoSa_CsForestMedallion_Start, which awards ITEM_MEDALLION_FOREST.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa_cutscene_data.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c               | 2 +-
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa_cutscene_data.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 011b051d9..2d447aa33 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -290,7 +290,7 @@ void DemoSa_CsForestMedallion_Start(DemoSa* this, PlayState* play) {
     if ((gSaveContext.chamberCutsceneNum == 0) && (gSaveContext.sceneLayer < 4)) {
         player = GET_PLAYER(play);
         this->action = 1;
-        play->csCtx.segment = D_8099010C;
+        play->csCtx.segment = sForestMedallionCs;  // was D_8099010C [LLM:HIGH]
         gSaveContext.cutsceneTrigger = 2;
         if (GameInteractor_Should(VB_GIVE_ITEM_FOREST_MEDALLION, true)) {
             Item_Give(play, ITEM_MEDALLION_FOREST);
diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa_cutscene_data.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa_cutscene_data.c
index 9527c4681..9300424ae 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa_cutscene_data.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa_cutscene_data.c
@@ -2,7 +2,8 @@
 #include "z64cutscene_commands.h"
 
 // clang-format off
-static CutsceneData D_8099010C[] = {
+// LLM generated name (HIGH), was D_8099010C: CutsceneData script installed into csCtx.segment by DemoSa_CsForestMedallion_Start, which awards ITEM_MEDALLION_FOREST.
+static CutsceneData sForestMedallionCs[] = {  // was D_8099010C [LLM:HIGH]
     CS_BEGIN_CUTSCENE(29, 3001),
     CS_UNK_DATA_LIST(0x00000020, 1),
         CS_UNK_DATA(0x00010000, 0x0BB80000, 0x00000000, 0x00000000, 0xFFFFFFFC, 0x00000002, 0x00000000, 0xFFFFFFFC, 0x00000002, 0x00000000, 0x00000000, 0x00000000),
