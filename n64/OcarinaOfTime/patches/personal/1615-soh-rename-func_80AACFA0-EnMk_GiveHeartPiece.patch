From 74682880b33eb2aeb53baa37e211292d1d24db42 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:30:42 +0000
Subject: [PATCH 1615/3799] soh: rename func_80AACFA0 -> EnMk_GiveHeartPiece

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: re-offers that heart piece until the player takes it, then sets ITEMGETINF_10.
Defined in soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
index b38dcb94e..71ace8a9e 100644
--- a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
+++ b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
@@ -206,7 +206,8 @@ void EnMk_FrogsIntro(EnMk* this, PlayState* play) {
     this->flags |= 1;
 }
 
-void func_80AACFA0(EnMk* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AACFA0: re-offers that heart piece until the player takes it, then sets ITEMGETINF_10.
+void EnMk_GiveHeartPiece(EnMk* this, PlayState* play) {
     if (Actor_HasParent(&this->actor, play) || !GameInteractor_Should(VB_GIVE_ITEM_FROM_LAB_DIVE, true, this)) {
         this->actor.parent = NULL;
         this->actionFunc = EnMk_Talk;  // was func_80AACA40 [LLM:HIGH]
@@ -219,7 +220,7 @@ void func_80AACFA0(EnMk* this, PlayState* play) {
 // LLM generated name (HIGH), was func_80AAD014: once the diving-reward line closes it offers GI_HEART_PIECE.
 void EnMk_OfferHeartPiece(EnMk* this, PlayState* play) {
     if (Actor_TextboxIsClosing(&this->actor, play)) {
-        this->actionFunc = func_80AACFA0;
+        this->actionFunc = EnMk_GiveHeartPiece;  // was func_80AACFA0 [LLM:HIGH]
         if (GameInteractor_Should(VB_GIVE_ITEM_FROM_LAB_DIVE, true, this)) {
             Actor_OfferGetItem(&this->actor, play, GI_HEART_PIECE, 10000.0f, 50.0f);
         }
