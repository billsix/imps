From 8b885767b3ec9c292b8d49f535cf2768ced04517 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:31 +0000
Subject: [PATCH 315/784] soh: rename func_800AA4E0 -> View_GetOrtho

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.94.
Defined in soh/src/code/z_view.c.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_view.c   | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index aed696f2e..232ecd00a 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1401,7 +1401,7 @@ void View_GetScale(View* view, f32* scale);
 void func_800AA460(View* view, f32 fovy, f32 near, f32 far);
 void View_GetPerspective(View* view, f32* fovy, f32* near, f32* far);  // was func_800AA48C [oot]
 void View_SetOrtho(View* view, f32 fovy, f32 near, f32 far);  // was func_800AA4A8 [oot]
-void func_800AA4E0(View* view, f32* fovy, f32* near, f32* far);
+void View_GetOrtho(View* view, f32* fovy, f32* near, f32* far);  // was func_800AA4E0 [oot]
 void View_SetViewport(View* view, Viewport* viewport);
 void View_GetViewport(View* view, Viewport* viewport);
 void View_SetDistortionOrientation(View* view, f32 rotX, f32 rotY, f32 rotZ);
diff --git a/soh/src/code/z_view.c b/soh/src/code/z_view.c
index 8c06a78e0..0dbb02f4f 100644
--- a/soh/src/code/z_view.c
+++ b/soh/src/code/z_view.c
@@ -130,7 +130,8 @@ void View_SetOrtho(View* view, f32 fovy, f32 near, f32 far) {
     view->scale = 1.0f;
 }
 
-void func_800AA4E0(View* view, f32* fovy, f32* near, f32* far) {
+// Name from zeldaret/oot (was func_800AA4E0): adopted upstream's name for this address; body verified to match upstream at 0.94. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_view.c]
+void View_GetOrtho(View* view, f32* fovy, f32* near, f32* far) {
     *fovy = view->fovy;
     *near = view->zNear;
     *far = view->zFar;
