Date: Mon, 7 Sep 2026 15:02:49 +0000
Subject: [PATCH 0480/3799] soh: rename func_80AEF4E0 -> EnRu1_PlayLaughingSfx

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 6b777baaa..563b68352 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1990,7 +1990,8 @@ void EnRu1_PlayAbductedSfx(EnRu1* this, PlayState* play) {
     SoundSource_PlaySfxAtFixedWorldPos(play, &this->actor.projectedPos, 20, NA_SE_VO_RT_FALL);
 }
 
-void func_80AEF4E0(EnRu1* this) {
+// Name from zeldaret/oot (was func_80AEF4E0): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_PlayLaughingSfx(EnRu1* this) {
     if (Animation_OnFrame(&this->skelAnime, 5.0f)) {
         Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_VO_RT_LAUGH_0);
     }
@@ -2129,7 +2130,7 @@ void func_80AEFA2C(EnRu1* this, PlayState* play) {
     func_80AEB364(this, play);
     EnRu1_UpdateBgCheckInfo(this, play);
     something = EnRu1_UpdateSkelAnime(this);
-    func_80AEF4E0(this);
+    EnRu1_PlayLaughingSfx(this);
     func_80AEF5B8(this);
     EnRu1_PlayStepSoundNearSapphire(this);
     func_80AEF728(this, something);
