From 2109b51f9a71565b6768810087367a88fd5202d6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:37 +0000
Subject: [PATCH 3064/3799] soh: rename D_801208E4 -> sCs6001Duration

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the duration argument for 6001
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 6 +++---
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index c7ad1303f..dd460ab6d 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -678,15 +678,15 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
             Actor_GetWorld(&spA0, actor);
             if (spA0.pos.z > -750.0f) {
-                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, sCs6001AtPoints, sCs6001EyePoints);  // was D_801206A0 [LLM:HIGH]
+                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, sCs6001Duration, sCs6001AtPoints, sCs6001EyePoints);  // was D_801206A0 [LLM:HIGH]
             } else {
-                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, sCs6001AtPoints, sCs6001EyePointsAlt);  // was D_801206A0 [LLM:HIGH]
+                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, sCs6001Duration, sCs6001AtPoints, sCs6001EyePointsAlt);  // was D_801206A0 [LLM:HIGH]
             }
 
             i = Quake_Add(csCam, 1);
             Quake_SetSpeed(i, 32000);
             Quake_SetQuakeValues(i, 0, 0, 20, 0);
-            Quake_SetCountdown(i, D_801208E4 - 10);
+            Quake_SetCountdown(i, sCs6001Duration - 10);  // was D_801208E4 [LLM:HIGH]
             break;
         case 3400:
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index af07d62f0..6700c5b61 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -135,7 +135,8 @@ static CutsceneCameraPoint sCs6001EyePoints[12] = {  // was D_80120820 [LLM:HIGH
 };
 // LLM generated name (HIGH), was D_801208E0: the number of points in those arrays
 static s16 sCs6001PointCount = 12;  // was D_801208E0 [LLM:HIGH]
-static s16 D_801208E4 = 90;
+// LLM generated name (HIGH), was D_801208E4: the duration argument for 6001
+static s16 sCs6001Duration = 90;  // was D_801208E4 [LLM:HIGH]
 static s16 D_801208E8 = 8;
 
 static OnePointCsFull D_801208EC[3] = {
-- 
