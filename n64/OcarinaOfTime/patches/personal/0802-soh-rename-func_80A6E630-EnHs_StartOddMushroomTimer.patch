From d691775da08d4a24ace2cad647bae54d9d6b1ebc Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:23:52 +0000
Subject: [PATCH 0802/3799] soh: rename func_80A6E630 ->
 EnHs_StartOddMushroomTimer

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: action func entered once the Odd Mushroom is handed over: on text dismissal it starts the 180-unit trade sub-timer, clears the eventInf bit, and returns Grog to EnHs_SittingAwake.
Defined in soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c b/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
index 0bd365f67..5a96e399e 100644
--- a/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
+++ b/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
@@ -131,7 +131,8 @@ void EnHs_SittingAwakeTalk(EnHs* this, PlayState* play) {
     this->unk_2A8 |= 1;
 }
 
-void func_80A6E630(EnHs* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80A6E630: action func entered once the Odd Mushroom is handed over: on text dismissal it starts the 180-unit trade sub-timer, clears the eventInf bit, and returns Grog to EnHs_SittingAwake.
+void EnHs_StartOddMushroomTimer(EnHs* this, PlayState* play) {
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_DONE) && Message_ShouldAdvance(play)) {
         if (GameInteractor_Should(VB_TRADE_TIMER_ODD_MUSHROOM, true)) {
             Interface_SetSubTimer(180);
@@ -166,7 +167,7 @@ void EnHs_OfferOddMushroom(EnHs* this, PlayState* play) {
     if (Actor_HasParent(&this->actor, play) || !GameInteractor_Should(VB_TRADE_COJIRO, true, this)) {
         this->actor.parent = NULL;
         Flags_SetRandomizerInf(RAND_INF_ADULT_TRADES_LW_TRADE_COJIRO);
-        EnHs_SetActionFunc(this, func_80A6E630);
+        EnHs_SetActionFunc(this, EnHs_StartOddMushroomTimer);  // was func_80A6E630 [LLM:HIGH]
     } else {
         Actor_OfferGetItem(&this->actor, play, GI_ODD_MUSHROOM, 10000.0f, 50.0f);
     }
