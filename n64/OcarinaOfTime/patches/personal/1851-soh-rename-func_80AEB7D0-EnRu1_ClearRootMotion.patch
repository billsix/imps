From 6c321f62a4d1e2553f12fd5fe9c694fac04d6394 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:48:26 +0000
Subject: [PATCH 1851/3799] soh: rename func_80AEB7D0 -> EnRu1_ClearRootMotion

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: clears the skeleton's root-motion flags so the animation stops driving her position.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index bee0e0f95..dc522d9c5 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -556,7 +556,8 @@ void EnRu1_MoveInWater(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEB7D0(EnRu1* this) {
+// LLM generated name (HIGH), was func_80AEB7D0: clears the skeleton's root-motion flags so the animation stops driving her position.
+void EnRu1_ClearRootMotion(EnRu1* this) {
     this->skelAnime.movementFlags &= ~0x3;
 }
 
@@ -738,7 +739,7 @@ void EnRu1_ResurfaceProgress(EnRu1* this, PlayState* play, s32 arg2) {
 
     if (arg2 != 0) {
         frameCount = Animation_GetLastFrame(&gRutoChildTreadWaterAnim);
-        func_80AEB7D0(this);
+        EnRu1_ClearRootMotion(this);  // was func_80AEB7D0 [LLM:HIGH]
         Animation_Change(&this->skelAnime, &gRutoChildTreadWaterAnim, 1.0f, 0, frameCount, ANIMMODE_LOOP, -8.0f);
         this->action = 3;
     } else {
@@ -763,7 +764,7 @@ void EnRu1_StopTreading(EnRu1* this, PlayState* play) {
 // Name from zeldaret/oot (was func_80AEBF60): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.97. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
 void EnRu1_TransitionToBackSwimming(EnRu1* this, PlayState* play) {
     if (EnRu1_CheckFountainCueNotMatchingId(play, 6)) {
-        func_80AEB7D0(this);
+        EnRu1_ClearRootMotion(this);  // was func_80AEB7D0 [LLM:HIGH]
         this->action = 5;
         this->treadStartPos = this->actor.world.pos;
     } else {
-- 
