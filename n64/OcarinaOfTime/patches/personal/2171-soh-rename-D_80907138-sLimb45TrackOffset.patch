+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
@@ -296,7 +296,8 @@ static Vec3f sSwordTipOffset = { 0.0f, 0.0f, 17000.0f };  // was D_80907120 [LLM
 // LLM generated name (HIGH), was D_8090712C: 3000 units out along the blade, the near end of the same ribbon
 static Vec3f sSwordBaseOffset = { 0.0f, 0.0f, 3000.0f };  // was D_8090712C [LLM:HIGH]
 
-static Vec3f D_80907138 = { 0.0f, 0.0f, 0.0f };
