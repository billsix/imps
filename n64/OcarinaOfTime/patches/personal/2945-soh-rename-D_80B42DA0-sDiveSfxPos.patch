From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:48 +0000
Subject: [PATCH 2945/3799] soh: rename D_80B42DA0 -> sDiveSfxPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the projected position NA_SE_EV_DIVE_INTO_WATER is played at
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 344a17202..0133dbcef 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -500,7 +500,8 @@ void EnXc_PlaySkipSfxOutsideColossus(PlayState* play) {
     }
 }
 
-static Vec3f D_80B42DA0;
+// LLM generated name (HIGH), was D_80B42DA0: the projected position NA_SE_EV_DIVE_INTO_WATER is played at
+static Vec3f sDiveSfxPos;  // was D_80B42DA0 [LLM:HIGH]
 
 static s32 D_80B41D90 = 0;
 void EnXc_SetColossusWindSFX(PlayState* play) {
@@ -1458,8 +1459,8 @@ void EnXc_PlaySkipSfx() {
 void EnXc_PlayDiveSFX(Vec3f* src, PlayState* play) {
     f32 wDest[2];
 
-    SkinMatrix_Vec3fMtxFMultXYZW(&play->viewProjectionMtxF, src, &D_80B42DA0, wDest);
-    Sfx_PlaySfxAtPos(&D_80B42DA0, NA_SE_EV_DIVE_INTO_WATER);
+    SkinMatrix_Vec3fMtxFMultXYZW(&play->viewProjectionMtxF, src, &sDiveSfxPos, wDest);  // was D_80B42DA0 [LLM:HIGH]
+    Sfx_PlaySfxAtPos(&sDiveSfxPos, NA_SE_EV_DIVE_INTO_WATER);  // was D_80B42DA0 [LLM:HIGH]
 }
 
 void EnXc_LakeHyliaDive(PlayState* play) {
