From 66d1e284507ad47caf4ae6a2f3b29abfd8c828ad Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 22 Sep 2026 12:15:23 +0000
Subject: [PATCH 13/46] game: write the two special-object preset lookups with
 their exit test in the loop header
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Both lookups in macro_special_objects.c were `while (TRUE)` loops whose real
test sat in the body behind a `break`. Move the test into the header. The
first one also carried an empty-bodied `if (preset_id == 0xFF) { }` — a
bounds check whose body the original had optimised away; the read it
performed had no effect, so it is deleted.

Verified: macro_special_objects.c compiles to byte-identical assembly
before and after with the port's own flags (asmdiff over
compile_commands.json).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/game/macro_special_objects.c | 14 ++------------
 1 file changed, 2 insertions(+), 12 deletions(-)

diff --git a/src/game/macro_special_objects.c b/src/game/macro_special_objects.c
index 52f11d8d..e2456323 100644
--- a/src/game/macro_special_objects.c
+++ b/src/game/macro_special_objects.c
@@ -274,14 +274,7 @@ void spawn_special_objects(s16 areaIndex, s16 **specialObjList) {
         (*specialObjList)++;
 
         offset = 0;
-        while (TRUE) {
-            if (SpecialObjectPresets[offset].preset_id == presetID) {
-                break;
-            }
-
-            if (SpecialObjectPresets[offset].preset_id == 0xFF) {
-            }
-
+        while (SpecialObjectPresets[offset].preset_id != presetID) {
             offset++;
         }
 
@@ -344,10 +337,7 @@ u32 get_special_objects_size(s16 *data) {
         data += 3;
         offset = 0;
 
-        while (TRUE) {
-            if (SpecialObjectPresets[offset].preset_id == presetID) {
-                break;
-            }
+        while (SpecialObjectPresets[offset].preset_id != presetID) {
             offset++;
         }
 
