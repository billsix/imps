From 62c2958686d62e52bed9b5430214f091a04400e1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:11 +0000
Subject: [PATCH 3445/3799] soh: rename D_80A78FA0 -> sDeathSfxPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the scratch position EnIk_PlayDeathSfx plays its sound at
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index 92d1c6b2d..d66d01f83 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -1175,12 +1175,12 @@ void EnIk_PlayStaggerSfx(EnIk* this) {
 
 // LLM generated name (HIGH), was func_80A772EC: projects the actor's position through the view matrix and plays the death sound at that screen position; EnIk_SetupCsAction3 calls it.
 void EnIk_PlayDeathSfx(EnIk* this, PlayState* play) {
-    static Vec3f D_80A78FA0;
+    static Vec3f sDeathSfxPos;  // was D_80A78FA0 [LLM:HIGH]
     s32 pad[2];
     f32 wDest;
 
-    SkinMatrix_Vec3fMtxFMultXYZW(&play->viewProjectionMtxF, &this->actor.world.pos, &D_80A78FA0, &wDest);
-    Audio_PlaySfxGeneral(NA_SE_EN_IRONNACK_DEAD, &D_80A78FA0, 4, &gSfxDefaultFreqAndVolScale,
+    SkinMatrix_Vec3fMtxFMultXYZW(&play->viewProjectionMtxF, &this->actor.world.pos, &sDeathSfxPos, &wDest);  // was D_80A78FA0 [LLM:HIGH]
+    Audio_PlaySfxGeneral(NA_SE_EN_IRONNACK_DEAD, &sDeathSfxPos, 4, &gSfxDefaultFreqAndVolScale,  // was D_80A78FA0 [LLM:HIGH]
                          &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
 }
 
