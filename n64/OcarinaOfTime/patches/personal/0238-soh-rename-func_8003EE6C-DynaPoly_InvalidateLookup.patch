From a2286cf2727dca2d8383aee0ffe9f3afe6f467da Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:22 +0000
Subject: [PATCH 0238/3799] soh: rename func_8003EE6C ->
 DynaPoly_InvalidateLookup

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/code/z_bgcheck.c.
---
 soh/include/functions.h                                   | 2 +-
 soh/src/code/z_bgcheck.c                                  | 3 ++-
 soh/src/overlays/actors/ovl_Bg_Sst_Floor/z_bg_sst_floor.c | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 8d6733e08..3289e1b5c 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -656,7 +656,7 @@ void DynaPoly_DisableCeilingCollision(PlayState* play, DynaCollisionContext* dyn
 s32 DynaPoly_SetBgActor(PlayState* play, DynaCollisionContext* dyna, Actor* actor, CollisionHeader* colHeader);
 DynaPolyActor* DynaPoly_GetActor(CollisionContext* colCtx, s32 bgId);
 void DynaPoly_DeleteBgActor(PlayState* play, DynaCollisionContext* dyna, s32 bgId);
-void func_8003EE6C(PlayState* play, DynaCollisionContext* dyna);
+void DynaPoly_InvalidateLookup(PlayState* play, DynaCollisionContext* dyna);  // was func_8003EE6C [oot]
 void func_8003F8EC(PlayState* play, DynaCollisionContext* dyna, Actor* actor);
 void DynaPoly_Setup(PlayState* play, DynaCollisionContext* dyna);
 void DynaPoly_UpdateBgActorTransforms(PlayState* play, DynaCollisionContext* dyna);
diff --git a/soh/src/code/z_bgcheck.c b/soh/src/code/z_bgcheck.c
index 8063b77dc..09fdf0e11 100644
--- a/soh/src/code/z_bgcheck.c
+++ b/soh/src/code/z_bgcheck.c
@@ -2758,7 +2758,8 @@ void DynaPoly_DeleteBgActor(PlayState* play, DynaCollisionContext* dyna, s32 bgI
     }
 }
 
-void func_8003EE6C(PlayState* play, DynaCollisionContext* dyna) {
+// Name from zeldaret/oot (was func_8003EE6C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_bgcheck.c]
+void DynaPoly_InvalidateLookup(PlayState* play, DynaCollisionContext* dyna) {
     dyna->bitFlag |= DYNAPOLY_INVALIDATE_LOOKUP;
 }
 
diff --git a/soh/src/overlays/actors/ovl_Bg_Sst_Floor/z_bg_sst_floor.c b/soh/src/overlays/actors/ovl_Bg_Sst_Floor/z_bg_sst_floor.c
index 9dffb763a..2ee5632d5 100644
--- a/soh/src/overlays/actors/ovl_Bg_Sst_Floor/z_bg_sst_floor.c
+++ b/soh/src/overlays/actors/ovl_Bg_Sst_Floor/z_bg_sst_floor.c
@@ -119,7 +119,7 @@ void BgSstFloor_Update(BgSstFloor* thisx, PlayState* play) {
     if (this->drumPhase != 0) {
         this->drumPhase--;
     }
-    func_8003EE6C(play, &play->colCtx.dyna);
+    DynaPoly_InvalidateLookup(play, &play->colCtx.dyna);
 }
 
 void BgSstFloor_Draw(BgSstFloor* thisx, PlayState* play) {
