From 8e32c3872375dcdfd8a0442a2a18f1ffad8df1ee Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:35 +0000
Subject: [PATCH 2767/3799] soh: rename func_80034B28 -> Actor_AllocEmptyDList

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: allocates a one-command display list that only ends
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index c8351f200..6c8e8d5fd 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -4590,7 +4590,8 @@ void Npc_TrackPoint(Actor* actor, NpcInteractInfo* interactInfo, s16 presetIndex
                              rotLimits.rotateYaw);
 }
 
-Gfx* func_80034B28(GraphicsContext* gfxCtx) {
+// LLM generated name (HIGH), was func_80034B28: allocates a one-command display list that only ends
+Gfx* Actor_AllocEmptyDList(GraphicsContext* gfxCtx) {
     Gfx* displayList;
 
     displayList = Graph_Alloc(gfxCtx, sizeof(Gfx));
@@ -4623,7 +4624,7 @@ void func_80034BA0(PlayState* play, SkelAnime* skelAnime, OverrideLimbDraw overr
     gDPPipeSync(POLY_OPA_DISP++);
     gDPSetEnvColor(POLY_OPA_DISP++, 0, 0, 0, alpha);
     gDPPipeSync(POLY_OPA_DISP++);
-    gSPSegment(POLY_OPA_DISP++, 0x0C, func_80034B28(play->state.gfxCtx));
+    gSPSegment(POLY_OPA_DISP++, 0x0C, Actor_AllocEmptyDList(play->state.gfxCtx));  // was func_80034B28 [LLM:HIGH]
 
     POLY_OPA_DISP = SkelAnime_DrawFlex(play, skelAnime->skeleton, skelAnime->jointTable, skelAnime->dListCount,
                                        overrideLimbDraw, postLimbDraw, actor, POLY_OPA_DISP);
