From 82e83177f8b72bdf12a62a31c5762780834caacb Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:17 +0000
Subject: [PATCH 1801/3799] soh: rename D_8012ADC0 -> sSkyFaceTexOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the six 0x2000-step texture offsets, one per face of the outdoor skybox.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index c61e08f71..5450a796e 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -109,7 +109,8 @@ s16 sRoomQuadIndices[0x40] = {  // was D_8012AD40 [LLM:HIGH]
     0x19, 0x1A, 0x1E, 0x0A, 0x1A, 0x1B, 0x0B, 0x1E, 0x1B, 0x1C, 0x1F, 0x0B, 0x1C, 0x1D, 0x0F, 0x1F,
 };
 
-u32 D_8012ADC0[6] = {
+// LLM generated name (HIGH), was D_8012ADC0: the six 0x2000-step texture offsets, one per face of the outdoor skybox.
+u32 sSkyFaceTexOffsets[6] = {  // was D_8012ADC0 [LLM:HIGH]
     0x00000000, 0x00002000, 0x00004000, 0x00006000, 0x00008000, 0x0000C000,
 };
 
