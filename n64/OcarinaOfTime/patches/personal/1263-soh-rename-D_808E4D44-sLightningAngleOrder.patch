From 237efd3bd2e01e277eade3ac795e5d2a263a810e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:05:51 +0000
Subject: [PATCH 1263/3799] soh: rename D_808E4D44 -> sLightningAngleOrder

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: a permutation of 0 through 14 indexed by the lightning counter and scaled by pi/5 to give BossGanonEff_SpawnLightning its angle, so successive bolts land in a scattered order rather than sweeping round.
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index c47b5867e..676931ca0 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -2846,7 +2846,8 @@ void BossGanon_UpdateDamage(BossGanon* this, PlayState* play) {
     }
 }
 
-static f32 D_808E4D44[] = {
+// LLM generated name (HIGH), was D_808E4D44: a permutation of 0 through 14 indexed by the lightning counter and scaled by pi/5 to give BossGanonEff_SpawnLightning its angle, so successive bolts land in a scattered order rather than sweeping round.
+static f32 sLightningAngleOrder[] = {  // was D_808E4D44 [LLM:HIGH]
     1.0f, 3.0f, 0.0f, 7.0f, 13.0f, 4.0f, 6.0f, 11.0f, 5.0f, 2.0f, 8.0f, 14.0f, 10.0f, 12.0f, 9.0f,
 };
 
@@ -3023,7 +3024,7 @@ void BossGanon_Update(Actor* thisx, PlayState* play2) {
             BossGanonEff_SpawnLightning(play, 1.0f, 0.0f, 0.0f);
         }
 
-        BossGanonEff_SpawnLightning(play, 1.0f, D_808E4D44[this->unk_26C] * (M_PI / 5) + this->unk_270,
+        BossGanonEff_SpawnLightning(play, 1.0f, sLightningAngleOrder[this->unk_26C] * (M_PI / 5) + this->unk_270,  // was D_808E4D44 [LLM:HIGH]
                                     Rand_CenteredFloat(M_PI / 5) + (M_PI / 2));
     }
 
