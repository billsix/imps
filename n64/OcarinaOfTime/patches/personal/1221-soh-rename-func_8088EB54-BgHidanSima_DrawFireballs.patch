Subject: [PATCH 1221/3799] soh: rename func_8088EB54 ->
 BgHidanSima_DrawFireballs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: emits the trail of gFireTempleFireballDL quads ahead of the platform, growing them and cycling sFireballsTexs with the slide timer.
Defined in soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
index 114370647..2453355d5 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
@@ -232,7 +232,8 @@ void BgHidanSima_Update(Actor* thisx, PlayState* play) {
     }
 }
 
-Gfx* func_8088EB54(PlayState* play, BgHidanSima* this, Gfx* gfx) {
+// LLM generated name (HIGH), was func_8088EB54: emits the trail of gFireTempleFireballDL quads ahead of the platform, growing them and cycling sFireballsTexs with the slide timer.
+Gfx* BgHidanSima_DrawFireballs(PlayState* play, BgHidanSima* this, Gfx* gfx) {
     MtxF mtxF;
     s32 phi_s5;
     s32 s3;
@@ -293,7 +294,7 @@ void BgHidanSima_Draw(Actor* thisx, PlayState* play) {
             POLY_XLU_DISP = Gfx_SetupDL(POLY_XLU_DISP, 0x14);
             gDPSetPrimColor(POLY_XLU_DISP++, 0, 1, 255, 255, 0, 150);
             gDPSetEnvColor(POLY_XLU_DISP++, 255, 0, 0, 255);
-            POLY_XLU_DISP = func_8088EB54(play, this, POLY_XLU_DISP);
+            POLY_XLU_DISP = BgHidanSima_DrawFireballs(play, this, POLY_XLU_DISP);  // was func_8088EB54 [LLM:HIGH]
         }
     }
     CLOSE_DISPS(play->state.gfxCtx);
