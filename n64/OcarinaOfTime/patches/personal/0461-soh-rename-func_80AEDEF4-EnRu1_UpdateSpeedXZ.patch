Date: Mon, 7 Sep 2026 15:02:47 +0000
Subject: [PATCH 461/784] soh: rename func_80AEDEF4 -> EnRu1_UpdateSpeedXZ

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 20bfe8678..2495e4b20 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1466,7 +1466,8 @@ void EnRu1_UpdateBouncing(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEDEF4(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEDEF4): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_UpdateSpeedXZ(EnRu1* this, PlayState* play) {
     f32* speedXZ = &this->actor.speedXZ;
     DynaPolyActor* dynaPolyActor = DynaPoly_GetActor(&play->colCtx, this->actor.floorBgId);
 
@@ -1486,7 +1487,7 @@ void func_80AEDEF4(EnRu1* this, PlayState* play) {
 
 void func_80AEDFF4(EnRu1* this, PlayState* play) {
     EnRu1_UpdateBouncing(this, play);
-    func_80AEDEF4(this, play);
+    EnRu1_UpdateSpeedXZ(this, play);
     Actor_MoveXZGravity(&this->actor);
 }
 
