diff --git a/docker/Dockerfile b/docker/Dockerfile
new file mode 100644
index 000000000..acd43d165
--- /dev/null
+++ b/docker/Dockerfile
@@ -0,0 +1,75 @@
+# Reproducible Linux build environment for 2 Ship 2 Harkinian's CI AppImage.
+#
+# Mirrors the `build-linux` job of .github/workflows/main.yml: ubuntu-22.04 with
+# gcc-12, the shared apt list, and SDL2 / tinyxml2 / libzip built from source at
+# the same versions and flags the job uses. The one deliberate difference from
+# CI is the point of this image: those from-source library steps and the runner
+# image are frozen into layers, so the build is reproducible and a developer can
+# run the identical build locally.
+#
+# Build context is the repository root (see docker/Makefile), so the COPY reads
+# .github/workflows/apt-deps.txt — the SAME file the CI "Install dependencies"
+# step installs from — keeping the package list in one place.
+FROM ubuntu:22.04
+
+ENV DEBIAN_FRONTEND=noninteractive \
+    CC=gcc-12 \
+    CXX=g++-12 \
+    LANG=C.UTF-8
+
+# The CI apt list (apt-deps.txt) plus the packages a bare ubuntu:22.04 lacks
+# that a GitHub runner pre-provides (toolchain, download utilities, AppImage
+# packaging, the zip CLI tools the job installs alongside apt-deps).
+COPY .github/workflows/apt-deps.txt /tmp/apt-deps.txt
+RUN apt-get update && apt-get install -y --no-install-recommends \
+        $(cat /tmp/apt-deps.txt) \
+        ca-certificates wget curl gnupg git file patchelf desktop-file-utils \
+        lsb-release build-essential gcc-12 g++-12 pkg-config python3 \
+        zipcmp zipmerge ziptool \
+ && rm -rf /var/lib/apt/lists/*
+
+# The project requires CMake >= 3.26; jammy ships 3.22. Install Kitware's build
+# (the GitHub runner pre-provides a modern cmake, so CI never hits this).
+RUN wget -O /tmp/kitware-archive.sh https://apt.kitware.com/kitware-archive.sh \
+ && bash /tmp/kitware-archive.sh \
+ && apt-get install -y --no-install-recommends cmake \
+ && rm -rf /tmp/kitware-archive.sh /var/lib/apt/lists/*
+
+# SDL 2.30.3 from source (CI step "Install latest SDL").
+RUN mkdir -p /deps && cd /deps \
+ && wget -q https://github.com/libsdl-org/SDL/releases/download/release-2.30.3/SDL2-2.30.3.tar.gz \
+ && tar -xzf SDL2-2.30.3.tar.gz \
+ && cd SDL2-2.30.3 \
+ && ./configure --enable-hidapi-libusb \
+ && make -j"$(nproc)" \
+ && make install \
+ && cp -av /usr/local/lib/libSDL* /lib/x86_64-linux-gnu/ \
+ && ldconfig \
+ && cd / && rm -rf /deps
+
+# tinyxml2 10.0.0 from source (CI removes the apt one first).
+RUN apt-get update && apt-get remove -y libtinyxml2-dev \
+ && rm -rf /var/lib/apt/lists/* \
+ && mkdir -p /deps && cd /deps \
+ && wget -q https://github.com/leethomason/tinyxml2/archive/refs/tags/10.0.0.tar.gz \
+ && tar -xzf 10.0.0.tar.gz \
+ && cmake -S tinyxml2-10.0.0 -B tinyxml2-10.0.0/build -DCMAKE_BUILD_TYPE=Release \
+ && cmake --build tinyxml2-10.0.0/build -j"$(nproc)" \
+ && cmake --install tinyxml2-10.0.0/build \
+ && ldconfig \
+ && cd / && rm -rf /deps
+
+# libzip 1.10.1 without crypto backends (CI step "Install libzip without crypto").
+RUN mkdir -p /deps && cd /deps \
+ && wget -q https://github.com/nih-at/libzip/releases/download/v1.10.1/libzip-1.10.1.tar.gz \
+ && tar -xzf libzip-1.10.1.tar.gz \
+ && cmake -S libzip-1.10.1 -B libzip-1.10.1/build -DCMAKE_BUILD_TYPE=Release \
+        -DENABLE_COMMONCRYPTO=OFF -DENABLE_GNUTLS=OFF \
+        -DENABLE_MBEDTLS=OFF -DENABLE_OPENSSL=OFF \
+ && cmake --build libzip-1.10.1/build -j"$(nproc)" \
+ && cmake --install libzip-1.10.1/build \
+ && cp -av /usr/local/lib/libzip* /lib/x86_64-linux-gnu/ \
+ && ldconfig \
+ && cd / && rm -rf /deps
+
+WORKDIR /src
diff --git a/docker/Makefile b/docker/Makefile
new file mode 100644
index 000000000..101e978e5
--- /dev/null
+++ b/docker/Makefile
@@ -0,0 +1,84 @@
+SHELL := /bin/bash
+
+# Containerized, reproducible Linux AppImage build for 2 Ship 2 Harkinian.
+#
+# `make appimage` builds the repository (as checked out) inside the image
+# defined by docker/Dockerfile and emits out/2ship.appimage — the same artifact
+# the Linux CI job produces, from one path CI and developers share. The build
+# CONTEXT is the repository root (the parent of this dir), so the Dockerfile can
+# read .github/workflows/apt-deps.txt and the container sees the whole source.
+
+# Repo root = parent of this docker/ directory, regardless of the caller's cwd.
+ROOT   := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
+
+# podman on developer machines, docker on CI runners — pick whichever is on PATH.
+CONTAINER_CMD ?= $(shell command -v podman >/dev/null 2>&1 && echo podman || echo docker)
+
+IMAGE  := 2ship-ci-builder:latest
+OUT    := $(ROOT)/out
+NPROC  := $(shell nproc)
+
+# The port asset archive. The CI `generate-2ship-otr` job builds 2ship.o2r and
+# the Linux job downloads it to build-cmake/mm before calling `make appimage`;
+# the build bundles it into the AppImage. (Generating it inside the container is
+# a planned follow-up; for now this target consumes the supplied archive.)
+O2R    ?= build-cmake/mm/2ship.o2r
+
+# Extra flags for container `run` (not `build`): --cgroups=disabled lets the
+# build run inside an unprivileged nested container. Empty on a normal host/CI.
+PODMAN_RUN_FLAGS ?= $(if $(filter 1,$(NESTED_PODMAN)),--cgroups=disabled)
+
+RUN = $(CONTAINER_CMD) run --rm $(PODMAN_RUN_FLAGS) \
+        -v $(ROOT):/src:z -v $(OUT):/out:z -e HOME=/tmp $(IMAGE)
+
+.PHONY: help image build appimage run shell clean
+
+help:
+	@echo "Targets:"
+	@echo "  make image     - build the Linux build-environment image"
+	@echo "  make build     - compile 2Ship inside the container"
+	@echo "  make appimage  - produce out/2ship.appimage (needs a port o2r; see O2R)"
+	@echo "  make run       - run out/2ship.appimage"
+	@echo "  make shell     - interactive shell in the build container"
+	@echo "  make clean     - remove the container build dir and out/"
+
+image:
+	$(CONTAINER_CMD) build -t $(IMAGE) -f $(ROOT)/docker/Dockerfile $(ROOT)
+
+$(OUT):
+	mkdir -p $(OUT)
+
+build: image | $(OUT)
+	$(RUN) bash -c '\
+		set -euxo pipefail; \
+		cmake --no-warn-unused-cli -S /src -B /src/build-cmake -GNinja \
+		      -DCMAKE_BUILD_TYPE=Release -DBUILD_REMOTE_CONTROL=1; \
+		cmake --build /src/build-cmake --config Release -j$(NPROC); \
+	'
+
+appimage: build
+	@test -f $(ROOT)/$(O2R) || { \
+	  echo "ERROR: port asset archive '$(O2R)' not found under the repo root." >&2; \
+	  echo "       CI's generate-2ship-otr job supplies it; pass O2R=<path> otherwise." >&2; \
+	  exit 1; }
+	$(RUN) bash -c '\
+		set -euxo pipefail; \
+		cd /src/build-cmake && cpack -G External; \
+		shopt -s nullglob; \
+		artifacts=(/src/build-cmake/*.appimage /src/_packages/*.appimage); \
+		if [ $${#artifacts[@]} -eq 0 ]; then echo "ERROR: no .appimage produced" >&2; exit 1; fi; \
+		cp "$${artifacts[0]}" /out/2ship.appimage; \
+		chmod +x /out/2ship.appimage; \
+	'
+	@echo "==> AppImage: $(OUT)/2ship.appimage"
+
+run:
+	@test -x $(OUT)/2ship.appimage || { echo "no AppImage at $(OUT)/2ship.appimage -- run 'make appimage' first" >&2; exit 1; }
+	$(OUT)/2ship.appimage $(ARGS)
+
+shell: image | $(OUT)
+	$(CONTAINER_CMD) run --rm -it $(PODMAN_RUN_FLAGS) \
+	    -v $(ROOT):/src:z -v $(OUT):/out:z -e HOME=/tmp $(IMAGE) bash
+
+clean:
+	rm -rf $(ROOT)/build-cmake $(ROOT)/_packages $(OUT)
