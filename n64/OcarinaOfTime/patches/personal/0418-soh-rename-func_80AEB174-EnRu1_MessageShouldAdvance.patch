From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:43 +0000
Subject: [PATCH 418/784] soh: rename func_80AEB174 ->
 EnRu1_MessageShouldAdvance

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index e7496443e..741f8c9ba 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -341,7 +341,8 @@ Actor* func_80AEB124(PlayState* play) {
     return NULL;
 }
 
-s32 func_80AEB174(PlayState* play) {
+// Name from zeldaret/oot (was func_80AEB174): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_MessageShouldAdvance(PlayState* play) {
     return (Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT) && Message_ShouldAdvance(play);
 }
 
@@ -1852,7 +1853,7 @@ void func_80AEF170(EnRu1* this, PlayState* play, s32 cond) {
 }
 
 void func_80AEF188(EnRu1* this, PlayState* play) {
-    if (func_80AEB174(play) && !func_80AEF0BC(this, play)) {
+    if (EnRu1_MessageShouldAdvance(play) && !func_80AEF0BC(this, play)) {
         Message_CloseTextbox(play);
         Flags_SetInfTable(INFTABLE_RUTO_IN_JJ_TALK_FIRST_TIME);
         this->action = 24;
