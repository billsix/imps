From 12bc0c8e42642a98c374221be818eeb4c9cc18f0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:20:05 +0000
Subject: [PATCH 1449/3799] soh: rename D_808AD850 -> sLightningTextures

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the twelve texture frames the bolt effect steps through, bound to segment 8 by its draw function on the frame given by the same counter that kills the actor after twelve.
Defined in soh/src/overlays/actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c       | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c b/soh/src/overlays/actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c
index 5da98c7b2..dbaed0d0d 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c
@@ -25,7 +25,8 @@ void func_808ACB58(BgSpot02Objects* this, PlayState* play);
 void func_808ACC34(BgSpot02Objects* this, PlayState* play);
 void func_808AD3D4(BgSpot02Objects* this, PlayState* play);
 
-static void* D_808AD850[] = {
+// LLM generated name (HIGH), was D_808AD850: the twelve texture frames the bolt effect steps through, bound to segment 8 by its draw function on the frame given by the same counter that kills the actor after twelve.
+static void* sLightningTextures[] = {  // was D_808AD850 [LLM:HIGH]
     object_spot02_objects_Tex_0096B0, object_spot02_objects_Tex_00A2B0, object_spot02_objects_Tex_00AEB0,
     object_spot02_objects_Tex_00BAB0, object_spot02_objects_Tex_00C6B0, object_spot02_objects_Tex_00D2B0,
     object_spot02_objects_Tex_00DEB0, object_spot02_objects_Tex_00EAB0, object_spot02_objects_Tex_00F6B0,
@@ -262,7 +263,7 @@ void func_808ACCB8(Actor* thisx, PlayState* play) {
         gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, redPrim, greenPrim, bluePrim, 255);
         gDPSetEnvColor(POLY_XLU_DISP++, redEnv, greenEnv, blueEnv, 255);
         gSPMatrix(POLY_XLU_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
-        gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_808AD850[this->unk_16A]));
+        gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(sLightningTextures[this->unk_16A]));  // was D_808AD850 [LLM:HIGH]
         gDPPipeSync(POLY_XLU_DISP++);
         gSPDisplayList(POLY_XLU_DISP++, object_spot02_objects_DL_0126F0);
         gDPPipeSync(POLY_XLU_DISP++);
