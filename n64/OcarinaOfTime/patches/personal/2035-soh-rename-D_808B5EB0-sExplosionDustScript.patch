From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:09:37 +0000
Subject: [PATCH 2035/3799] soh: rename D_808B5EB0 -> sExplosionDustScript

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: rows of frame, x, y, z, scale, scale step and life driving BgSpot16Bombstone_SpawnTimedDust
Defined in soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../z_bg_spot16_bombstone.c                       | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c b/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
index a7d4a6af3..c71c33e57 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
@@ -90,7 +90,8 @@ static ColliderCylinderInit sCylinderInit = {
     { 190, 80, 0, { 10, 0, 50 } },
 };
 
-static s16 D_808B5EB0[][7] = {
+// LLM generated name (HIGH), was D_808B5EB0: rows of frame, x, y, z, scale, scale step and life driving BgSpot16Bombstone_SpawnTimedDust
+static s16 sExplosionDustScript[][7] = {  // was D_808B5EB0 [LLM:HIGH]
     { 0x0000, 0x000A, 0x003C, 0xFFF6, 0x0104, 0x01E0, 0x0007 },
     { 0x0000, 0x0000, 0x0032, 0x0000, 0x0104, 0x017C, 0x000D },
     { 0x0001, 0x001E, 0x0014, 0x0014, 0x00A0, 0x0104, 0x000A },
@@ -308,21 +309,21 @@ void BgSpot16Bombstone_SpawnTimedDust(BgSpot16Bombstone* this, PlayState* play)
     Vec3f* actorPosition = &this->actor.world.pos;
 
     while (true) {
-        if ((u32)this->unk_158 >= ARRAY_COUNTU(D_808B5EB0) || this->unk_154 < D_808B5EB0[this->unk_158][0]) {
+        if ((u32)this->unk_158 >= ARRAY_COUNTU(sExplosionDustScript) || this->unk_154 < sExplosionDustScript[this->unk_158][0]) {  // was D_808B5EB0 [LLM:HIGH]
             break;
         }
 
         index = this->unk_158;
 
-        tempUnk2 = D_808B5EB0[index][1];
-        tempUnk6 = D_808B5EB0[index][3];
+        tempUnk2 = sExplosionDustScript[index][1];  // was D_808B5EB0 [LLM:HIGH]
+        tempUnk6 = sExplosionDustScript[index][3];  // was D_808B5EB0 [LLM:HIGH]
 
         position.x = ((this->sinRotation * tempUnk6) + (tempUnk2 * this->cosRotation)) + actorPosition->x;
-        position.y = D_808B5EB0[index][2] + actorPosition->y;
+        position.y = sExplosionDustScript[index][2] + actorPosition->y;  // was D_808B5EB0 [LLM:HIGH]
         position.z = ((this->cosRotation * tempUnk6) - (tempUnk2 * this->sinRotation)) + actorPosition->z;
 
-        EffectSsDust_SpawnBrown5ScaledLife(play, &position, &sVelocity, &sAcceleration, D_808B5EB0[index][4], D_808B5EB0[index][5],  // was func_800287AC [LLM:HIGH]
-                      D_808B5EB0[index][6]);
+        EffectSsDust_SpawnBrown5ScaledLife(play, &position, &sVelocity, &sAcceleration, sExplosionDustScript[index][4], sExplosionDustScript[index][5],  // was func_800287AC [LLM:HIGH]
+                      sExplosionDustScript[index][6]);  // was D_808B5EB0 [LLM:HIGH]
 
         this->unk_158 += 1;
     }
