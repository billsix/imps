From 4b4865e246b4b4ac6899783769c42979f594ebe9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:51:20 +0000
Subject: [PATCH 1126/3799] soh: rename D_80865BA0 -> sShotWeaponTip

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the tip point handed to Player_UpdateWeaponInfo while the hook is in flight.
Defined in soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c b/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
index 3a589dacc..1d6d214c5 100644
--- a/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
+++ b/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
@@ -62,7 +62,8 @@ static Vec3f sShotHookOffset = { 0.0f, 0.0f, 900.0f };  // was D_80865B7C [LLM:H
 static Vec3f sStowedWeaponTip = { 0.0f, 500.0f, -3000.0f };  // was D_80865B88 [LLM:HIGH]
 // LLM generated name (HIGH), was D_80865B94: the matching base point for the stowed hook's weapon quad.
 static Vec3f sStowedWeaponBase = { 0.0f, -500.0f, -3000.0f };  // was D_80865B94 [LLM:HIGH]
-static Vec3f D_80865BA0 = { 0.0f, 500.0f, 1200.0f };
+// LLM generated name (HIGH), was D_80865BA0: the tip point handed to Player_UpdateWeaponInfo while the hook is in flight.
+static Vec3f sShotWeaponTip = { 0.0f, 500.0f, 1200.0f };  // was D_80865BA0 [LLM:HIGH]
 static Vec3f D_80865BAC = { 0.0f, -500.0f, 1200.0f };
 
 void ArmsHook_SetupAction(ArmsHook* this, ArmsHookActionFunc actionFunc) {
@@ -326,7 +327,7 @@ void ArmsHook_Draw(Actor* thisx, PlayState* play) {
             this->hookInfo.active = 0;
         } else {
             Matrix_MultVec3f(&sShotHookOffset, &this->unk_1E8);  // was D_80865B7C [LLM:HIGH]
-            Matrix_MultVec3f(&D_80865BA0, &sp6C);
+            Matrix_MultVec3f(&sShotWeaponTip, &sp6C);  // was D_80865BA0 [LLM:HIGH]
             Matrix_MultVec3f(&D_80865BAC, &sp60);
         }
 
