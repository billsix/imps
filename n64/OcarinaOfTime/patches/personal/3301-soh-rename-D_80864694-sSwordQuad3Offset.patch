From 2b8737f417521135810d780239da5e10e1e19bca Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:56 +0000
Subject: [PATCH 3301/3799] soh: rename D_80864694 -> sSwordQuad3Offset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the third corner of that quad
Defined in soh/src/overlays/actors/ovl_En_Test/z_en_test.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Test/z_en_test.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Test/z_en_test.c b/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
index 52c4aa7ac..0b4c816f7 100644
--- a/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
+++ b/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
@@ -1870,7 +1870,7 @@ void EnTest_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
     static Vec3f sLimbOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_80864670 [LLM:HIGH]
     static Vec3f sSwordQuad1Offset = { 7000.0f, 1000.0f, 0.0f };  // was D_8086467C [LLM:HIGH]
     static Vec3f sSwordQuad0Offset = { 3000.0f, -2000.0f, -1000.0f };  // was D_80864688 [LLM:HIGH]
-    static Vec3f D_80864694 = { 3000.0f, -2000.0f, 1000.0f };
+    static Vec3f sSwordQuad3Offset = { 3000.0f, -2000.0f, 1000.0f };  // was D_80864694 [LLM:HIGH]
     static Vec3f D_808646A0 = { -1300.0f, 1100.0f, 0.0f };
     static Vec3f unused2 = { -3000.0f, 1900.0f, 800.0f };
     static Vec3f unused3 = { -3000.0f, -1100.0f, 800.0f };
@@ -1890,7 +1890,7 @@ void EnTest_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
     if (limbIndex == STALFOS_LIMB_SWORD) {
         Matrix_MultVec3f(&sSwordQuad1Offset, &this->swordCollider.dim.quad[1]);  // was D_8086467C [LLM:HIGH]
         Matrix_MultVec3f(&sSwordQuad0Offset, &this->swordCollider.dim.quad[0]);  // was D_80864688 [LLM:HIGH]
-        Matrix_MultVec3f(&D_80864694, &this->swordCollider.dim.quad[3]);
+        Matrix_MultVec3f(&sSwordQuad3Offset, &this->swordCollider.dim.quad[3]);  // was D_80864694 [LLM:HIGH]
         Matrix_MultVec3f(&D_808646A0, &this->swordCollider.dim.quad[2]);
 
         Collider_SetQuadVertices(&this->swordCollider, &this->swordCollider.dim.quad[0],
