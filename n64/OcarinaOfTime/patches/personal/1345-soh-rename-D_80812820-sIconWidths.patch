From 7e1b330373d559cc10ea6785fd46cf719b148271 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:11:56 +0000
Subject: [PATCH 1345/3799] soh: rename D_80812820 -> sIconWidths

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: added to each icon quad's left edge to give its right edge in the same loop.
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c
index 6f2c8eb27..36c89f3ae 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c
@@ -1158,7 +1158,8 @@ void FileChoose_SetWindowVtx(GameState* thisx) {
 
 // LLM generated name (HIGH), was D_80812818: the horizontal advance from one icon quad to the next as the four-quad row is laid out.
 static s16 sIconXSteps[] = { 0x001A, 0x000A, 0x000A, 0x000A };  // was D_80812818 [LLM:HIGH]
-static s16 D_80812820[] = { 0x0020, 0x000C, 0x000C, 0x000C };
+// LLM generated name (HIGH), was D_80812820: added to each icon quad's left edge to give its right edge in the same loop.
+static s16 sIconWidths[] = { 0x0020, 0x000C, 0x000C, 0x000C };  // was D_80812820 [LLM:HIGH]
 static s16 D_80812828[] = { 0x0010, 0x000C, 0x000C, 0x000C };
 static s16 D_80812830[] = { 0x0040, 0x0054, 0x0068, 0x0274, 0x0278, 0x027C };
 static s16 D_8081283C[] = { 0x0040, 0x0054, 0x0068, 0x0278 };
@@ -1340,7 +1341,7 @@ void FileChoose_SetWindowContentVtx(GameState* thisx) {
             for (phi_a1 = 0; phi_a1 < 4; phi_a1++, phi_t2 += 4) {
                 this->windowContentVtx[phi_t2].v.ob[0] = this->windowContentVtx[phi_t2 + 2].v.ob[0] = phi_t0;
                 this->windowContentVtx[phi_t2 + 1].v.ob[0] = this->windowContentVtx[phi_t2 + 3].v.ob[0] =
-                    this->windowContentVtx[phi_t2].v.ob[0] + D_80812820[phi_a1];
+                    this->windowContentVtx[phi_t2].v.ob[0] + sIconWidths[phi_a1];  // was D_80812820 [LLM:HIGH]
                 this->windowContentVtx[phi_t2].v.ob[1] = this->windowContentVtx[phi_t2 + 1].v.ob[1] = temp_t1;
                 this->windowContentVtx[phi_t2 + 2].v.ob[1] = this->windowContentVtx[phi_t2 + 3].v.ob[1] =
                     this->windowContentVtx[phi_t2].v.ob[1] - D_80812828[phi_a1];
-- 
