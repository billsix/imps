From 96e1cd5dd22b8056a585688535ac7abdbc503124 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:51:19 +0000
Subject: [PATCH 1124/3799] soh: rename D_80865B88 -> sStowedWeaponTip

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the tip point handed to Player_UpdateWeaponInfo while the hook is stowed.
Defined in soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c b/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
index 1299f4606..6977bb28f 100644
--- a/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
+++ b/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
@@ -58,7 +58,8 @@ static Color_RGB8 sUnusedColors[] = {
 static Vec3f sStowedHookOffset = { 0.0f, 0.0f, 0.0f };  // was D_80865B70 [LLM:HIGH]
 // LLM generated name (HIGH), was D_80865B7C: the same offset while ArmsHook_Shoot is running and the timer has not expired, placing the hook 900 units ahead.
 static Vec3f sShotHookOffset = { 0.0f, 0.0f, 900.0f };  // was D_80865B7C [LLM:HIGH]
-static Vec3f D_80865B88 = { 0.0f, 500.0f, -3000.0f };
+// LLM generated name (HIGH), was D_80865B88: the tip point handed to Player_UpdateWeaponInfo while the hook is stowed.
+static Vec3f sStowedWeaponTip = { 0.0f, 500.0f, -3000.0f };  // was D_80865B88 [LLM:HIGH]
 static Vec3f D_80865B94 = { 0.0f, -500.0f, -3000.0f };
 static Vec3f D_80865BA0 = { 0.0f, 500.0f, 1200.0f };
 static Vec3f D_80865BAC = { 0.0f, -500.0f, 1200.0f };
@@ -319,7 +320,7 @@ void ArmsHook_Draw(Actor* thisx, PlayState* play) {
 
         if ((ArmsHook_Shoot != this->actionFunc) || (this->timer <= 0)) {
             Matrix_MultVec3f(&sStowedHookOffset, &this->unk_1E8);  // was D_80865B70 [LLM:HIGH]
-            Matrix_MultVec3f(&D_80865B88, &sp6C);
+            Matrix_MultVec3f(&sStowedWeaponTip, &sp6C);  // was D_80865B88 [LLM:HIGH]
             Matrix_MultVec3f(&D_80865B94, &sp60);
             this->hookInfo.active = 0;
         } else {
