From 086bd73d0532f2f074eec69318b9df2b3772d407 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:54 +0000
Subject: [PATCH 3279/3799] soh: rename D_8094A9D4 -> sLeftScepterOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the reach along limb 34 her left scepter position is recorded from
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index 5a799d4cb..41cc1494a 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -3645,7 +3645,7 @@ s32 BossTw_TwinrovaOverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList,
 void BossTw_TwinrovaPostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
     static Vec3f sTwinrovaFocusOffset = { 0.0f, 0.0f, 0.0f };  // was D_8094A9BC [LLM:HIGH]
     static Vec3f sTwinrovaCrownOffset = { 0.0f, 2000.0f, -2000.0f };  // was D_8094A9C8 [LLM:HIGH]
-    static Vec3f D_8094A9D4 = { 13000.0f, 0.0f, 0.0f };
+    static Vec3f sLeftScepterOffset = { 13000.0f, 0.0f, 0.0f };  // was D_8094A9D4 [LLM:HIGH]
     static Vec3f D_8094A9E0 = { 13000.0f, 0.0f, 0.0f };
 
     BossTw* this = (BossTw*)thisx;
@@ -3654,7 +3654,7 @@ void BossTw_TwinrovaPostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Ve
 
     switch (limbIndex) {
         case 34:
-            Matrix_MultVec3f(&D_8094A9D4, &this->leftScepterPos);
+            Matrix_MultVec3f(&sLeftScepterOffset, &this->leftScepterPos);  // was D_8094A9D4 [LLM:HIGH]
             break;
         case 40:
             Matrix_MultVec3f(&D_8094A9E0, &this->rightScepterPos);
