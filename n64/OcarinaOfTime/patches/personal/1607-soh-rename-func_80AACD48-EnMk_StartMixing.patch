From 5f23ce14fd0bc691db982a365ca526ab5755a78b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:30:41 +0000
Subject: [PATCH 1607/3799] soh: rename func_80AACD48 -> EnMk_StartMixing

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: closes the textbox, takes the trade item off the player and starts the eye-drops mixing sequence.
Defined in soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
index 0655a5b39..6dd98cc5c 100644
--- a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
+++ b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
@@ -156,7 +156,8 @@ void func_80AACCA0(EnMk* this, PlayState* play) {
     }
 }
 
-void func_80AACD48(EnMk* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AACD48: closes the textbox, takes the trade item off the player and starts the eye-drops mixing sequence.
+void EnMk_StartMixing(EnMk* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
 
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT) && Message_ShouldAdvance(play)) {
@@ -180,7 +181,7 @@ void EnMk_FrogsAccepted(EnMk* this, PlayState* play) {
         Animation_Change(&this->skelAnime, &object_mk_Anim_000AC0, 1.0f, 0.0f,
                          Animation_GetLastFrame(&object_mk_Anim_000AC0), ANIMMODE_ONCE, -4.0f);
         this->flags &= ~2;
-        this->actionFunc = func_80AACD48;
+        this->actionFunc = EnMk_StartMixing;  // was func_80AACD48 [LLM:HIGH]
     }
 
     this->flags |= 1;
