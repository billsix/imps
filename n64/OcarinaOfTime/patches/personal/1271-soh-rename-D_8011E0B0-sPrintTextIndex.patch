From 1b14b9f6211fa8f323146dad2bd13145242df1ef Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:06:42 +0000
Subject: [PATCH 1271/3799] soh: rename D_8011E0B0 -> sPrintTextIndex

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment on its declaration reads "PrintTextBuffer index"; it is the write cursor into sPrintTextBuffers and the count the draw pass stops at.
Defined in soh/src/code/z_debug.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_debug.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/code/z_debug.c b/soh/src/code/z_debug.c
index 43425429a..8c2bb8935 100644
--- a/soh/src/code/z_debug.c
+++ b/soh/src/code/z_debug.c
@@ -19,7 +19,8 @@ s32 sUnusedDebugValue; // no known symbols, was D_8015FA94 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8015FA98: the 0x16-entry PrintTextBuffer array that DebugCamera_CopyText fills and DebugCamera_DrawText prints.
 PrintTextBuffer sPrintTextBuffers[0x16];  // was D_8015FA98 [LLM:HIGH]
 
-s16 D_8011E0B0 = 0; // PrintTextBuffer index
+// LLM generated name (HIGH), was D_8011E0B0: the in-tree comment on its declaration reads "PrintTextBuffer index"; it is the write cursor into sPrintTextBuffers and the count the draw pass stops at.
+s16 sPrintTextIndex = 0; // PrintTextBuffer index, was D_8011E0B0 [LLM:HIGH]
 Color_RGBA8 printTextColors[] = {
     { 255, 255, 32, 192 }, { 255, 150, 128, 192 }, { 128, 96, 0, 64 },     { 192, 128, 16, 128 },
     { 255, 192, 32, 128 }, { 230, 230, 220, 64 },  { 128, 150, 255, 128 }, { 128, 255, 32, 128 },
@@ -88,8 +89,8 @@ void DebugCamera_CopyText(u8 x, u8 y, u8 colorId, const char* text) {
     char* bufText;
     s16 i;
 
-    buf = &sPrintTextBuffers[D_8011E0B0];  // was D_8015FA98 [LLM:HIGH]
-    if (D_8011E0B0 < 0x16) {
+    buf = &sPrintTextBuffers[sPrintTextIndex];  // was D_8015FA98 [LLM:HIGH]
+    if (sPrintTextIndex < 0x16) {  // was D_8011E0B0 [LLM:HIGH]
         buf->x = x;
         buf->y = y;
         buf->colorId = colorId;
@@ -103,7 +104,7 @@ void DebugCamera_CopyText(u8 x, u8 y, u8 colorId, const char* text) {
         }
 
         *bufText = '\0';
-        D_8011E0B0++;
+        sPrintTextIndex++;  // was D_8011E0B0 [LLM:HIGH]
     }
 }
 
@@ -116,7 +117,7 @@ void DebugCamera_DrawText(GfxPrint* printer) {
     char* text;
 
     i = 0;
-    if (D_8011E0B0 > 0) {
+    if (sPrintTextIndex > 0) {  // was D_8011E0B0 [LLM:HIGH]
         do {
             buffer = &sPrintTextBuffers[i];  // was D_8015FA98 [LLM:HIGH]
             text = buffer->text;
@@ -126,7 +127,7 @@ void DebugCamera_DrawText(GfxPrint* printer) {
             GfxPrint_SetPos(printer, buffer->x, buffer->y);
             GfxPrint_Printf(printer, "%s", text);
             i += 1;
-        } while (i < D_8011E0B0);
+        } while (i < sPrintTextIndex);  // was D_8011E0B0 [LLM:HIGH]
     }
 }
 
@@ -272,7 +273,7 @@ void Debug_DrawOverlay(GraphicsContext* gfxCtx) {
         Debug_DrawRegEditor(&printer);  // was func_80063C04 [LLM:HIGH]
     }
 
-    D_8011E0B0 = 0;
+    sPrintTextIndex = 0;  // was D_8011E0B0 [LLM:HIGH]
     sp7C = GfxPrint_Close(&printer);
     gSPEndDisplayList(sp7C++);
     Graph_BranchDlist(sp78, sp7C);
-- 
