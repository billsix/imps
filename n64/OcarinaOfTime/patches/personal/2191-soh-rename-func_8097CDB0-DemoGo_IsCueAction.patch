Subject: [PATCH 2191/3799] soh: rename func_8097CDB0 -> DemoGo_IsCueAction

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: true when this Goron's cue channel is live and sitting on the caller's action id
Defined in soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c b/soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c
index efc1b131c..254b0f93f 100644
--- a/soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c
+++ b/soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c
@@ -205,7 +205,8 @@ s32 DemoGo_UpdateSkelAnime(DemoGo* this) {
     return SkelAnime_Update(&this->skelAnime);
 }
 
-s32 func_8097CDB0(DemoGo* this, PlayState* play, u16 npcAction) {
+// LLM generated name (HIGH), was func_8097CDB0: true when this Goron's cue channel is live and sitting on the caller's action id
+s32 DemoGo_IsCueAction(DemoGo* this, PlayState* play, u16 npcAction) {
     CutsceneContext* csCtx = &play->csCtx;
     s32 actionIdx = DemoGo_GetCueChannel(this);
 
@@ -221,7 +222,7 @@ void func_8097CE10(DemoGo* this, PlayState* play) {
 }
 
 void func_8097CE20(DemoGo* this, PlayState* play) {
-    if (func_8097CDB0(this, play, 2)) {
+    if (DemoGo_IsCueAction(this, play, 2)) {  // was func_8097CDB0 [LLM:HIGH]
         this->action = 2;
         this->drawConfig = 1;
         DemoGo_MoveAlongCue(this, play);  // was func_8097CB0C [LLM:HIGH]
@@ -243,7 +244,7 @@ void func_8097CE78(DemoGo* this, PlayState* play) {
 }
 
 void func_8097CEEC(DemoGo* this, PlayState* play) {
-    if (func_8097CDB0(this, play, 3)) {
+    if (DemoGo_IsCueAction(this, play, 3)) {  // was func_8097CDB0 [LLM:HIGH]
         this->action = 4;
     }
 }
