     }
 }
 
-void func_80AEC93C(EnRu1* this, UNK_TYPE arg1) {
+// Name from zeldaret/oot (was func_80AEC93C): adopted upstream's name for this address; body verified to match upstream at 0.88. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_StartWalkingAway(EnRu1* this, UNK_TYPE arg1) {
     if (arg1 != 0) {
         Animation_Change(&this->skelAnime, &gRutoChildWalkAnim, 1.0f, 0, Animation_GetLastFrame(&gRutoChildWalkAnim),
