Subject: [PATCH 1018/3799] soh: rename func_80969F38 ->
 DemoDu_SpawnFireMedallion

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: spawns DEMO_EFFECT_MEDAL_FIRE above the player and awards ITEM_MEDALLION_FIRE.
Defined in soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c b/soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c
index e8d9bd01b..01b581cad 100644
--- a/soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c
+++ b/soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c
@@ -183,7 +183,8 @@ void DemoDu_CsFireMedallion_SpawnDoorWarp(DemoDu* this, PlayState* play) {
 }
 
 // Gives the Fire Medallion to Link.
-void func_80969F38(DemoDu* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80969F38: spawns DEMO_EFFECT_MEDAL_FIRE above the player and awards ITEM_MEDALLION_FIRE.
+void DemoDu_SpawnFireMedallion(DemoDu* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
     f32 posX = player->actor.world.pos.x;
     f32 posY = player->actor.world.pos.y + 80.0f;
@@ -263,7 +264,7 @@ void DemoDu_CsFireMedallion_AdvanceTo06(DemoDu* this, PlayState* play) {
 
         if ((npcAction != NULL) && (npcAction->action == 2)) {
             this->updateIndex = CS_FIREMEDALLION_SUBSCENE(6);
-            func_80969F38(this, play);
+            DemoDu_SpawnFireMedallion(this, play);  // was func_80969F38 [LLM:HIGH]
         }
     }
 }
