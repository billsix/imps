From a8a2b3843a971fc61151a3b04947499057e7177c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:42 +0000
Subject: [PATCH 2669/3799] soh: rename D_8082B0B8 -> sCommonVtxY

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Y offsets of those same shared quads
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 90834110d..25c557853 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2738,7 +2738,8 @@ static s16 sCommonVtxWidths[] = {  // was D_8082B08C [LLM:HIGH]
     0x0020, 0x0010, 0xFFFF, 0xFFFF, 0x0013, 0x0013, 0x0015, 0x0010, 0x0014, 0xFFFF, 0x0000,
 };
 
-static s16 D_8082B0B8[] = {
+// LLM generated name (HIGH), was D_8082B0B8: Y offsets of those same shared quads
+static s16 sCommonVtxY[] = {  // was D_8082B0B8 [LLM:HIGH]
     0x0001, 0x000F, 0x0014, 0x0009, 0xFFE2, 0xFFEF, 0xFFDE, 0x000F, 0x001E, 0x0001, 0xFED4,
     0x002A, 0x0007, 0xFED4, 0xFED4, 0x0018, 0x0024, 0x0035, 0x0025, 0xFFF3, 0xFED4, 0x0000,
 };
@@ -2955,7 +2956,7 @@ s16 KaleidoScope_SetPageVtx(PlayState* play, Vtx* vtx, s16 pageIndex, s16 arg3)
 
             vtx[vtxIndex + 1].v.ob[0] = vtx[vtxIndex + 3].v.ob[0] = vtx[vtxIndex + 0].v.ob[0] + sCommonVtxWidths[colorIndex];  // was D_8082B08C [LLM:HIGH]
 
-            vtx[vtxIndex + 0].v.ob[1] = vtx[vtxIndex + 1].v.ob[1] = D_8082B0B8[colorIndex] + pauseCtx->offsetY;
+            vtx[vtxIndex + 0].v.ob[1] = vtx[vtxIndex + 1].v.ob[1] = sCommonVtxY[colorIndex] + pauseCtx->offsetY;  // was D_8082B0B8 [LLM:HIGH]
 
             vtx[vtxIndex + 2].v.ob[1] = vtx[vtxIndex + 3].v.ob[1] = vtx[vtxIndex + 0].v.ob[1] - D_8082B0E4[colorIndex];
 
-- 
