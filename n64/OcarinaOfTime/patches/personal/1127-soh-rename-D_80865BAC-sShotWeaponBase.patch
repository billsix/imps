From 38c3b9a48b0730e412cc77665138b38a2ec8f367 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:51:20 +0000
Subject: [PATCH 1127/3799] soh: rename D_80865BAC -> sShotWeaponBase

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the matching base point for the in-flight hook's weapon quad.
Defined in soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c b/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
index 1d6d214c5..c945754a4 100644
--- a/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
+++ b/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
@@ -64,7 +64,8 @@ static Vec3f sStowedWeaponTip = { 0.0f, 500.0f, -3000.0f };  // was D_80865B88 [
 static Vec3f sStowedWeaponBase = { 0.0f, -500.0f, -3000.0f };  // was D_80865B94 [LLM:HIGH]
 // LLM generated name (HIGH), was D_80865BA0: the tip point handed to Player_UpdateWeaponInfo while the hook is in flight.
 static Vec3f sShotWeaponTip = { 0.0f, 500.0f, 1200.0f };  // was D_80865BA0 [LLM:HIGH]
-static Vec3f D_80865BAC = { 0.0f, -500.0f, 1200.0f };
+// LLM generated name (HIGH), was D_80865BAC: the matching base point for the in-flight hook's weapon quad.
+static Vec3f sShotWeaponBase = { 0.0f, -500.0f, 1200.0f };  // was D_80865BAC [LLM:HIGH]
 
 void ArmsHook_SetupAction(ArmsHook* this, ArmsHookActionFunc actionFunc) {
     this->actionFunc = actionFunc;
@@ -328,7 +329,7 @@ void ArmsHook_Draw(Actor* thisx, PlayState* play) {
         } else {
             Matrix_MultVec3f(&sShotHookOffset, &this->unk_1E8);  // was D_80865B7C [LLM:HIGH]
             Matrix_MultVec3f(&sShotWeaponTip, &sp6C);  // was D_80865BA0 [LLM:HIGH]
-            Matrix_MultVec3f(&D_80865BAC, &sp60);
+            Matrix_MultVec3f(&sShotWeaponBase, &sp60);  // was D_80865BAC [LLM:HIGH]
         }
 
         Player_UpdateWeaponInfo(play, &this->collider, &this->hookInfo, &sp6C, &sp60);
-- 
