From da92cfce19016e22239cf4b1934aadb172de6489 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:17 +0000
Subject: [PATCH 1807/3799] soh: rename D_8012AEBC -> sRoomFaceParams

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the four room-skybox faces, each carrying the five parameters the room face builder needs.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 18d73233e..90e11f8ce 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -151,7 +151,8 @@ typedef struct {
     /* 0x010 */ s32 unk_10;
 } Struct_8012AF0C; // size = 0x14
 
-Struct_8012AF0C D_8012AEBC[4] = {
+// LLM generated name (HIGH), was D_8012AEBC: the four room-skybox faces, each carrying the five parameters the room face builder needs.
+Struct_8012AF0C sRoomFaceParams[4] = {  // was D_8012AEBC [LLM:HIGH]
     { -0x7E, 0x7C, -0x7E, 0x3F, -0x1F },
     { 0x7E, 0x7C, -0x7E, 0x3F, -0x1F },
     { 0x7E, 0x7C, 0x7E, -0x3F, -0x1F },
@@ -436,18 +437,18 @@ void func_800AEFC8(SkyboxContext* skyboxCtx, s16 skyboxId) {
     if (skyboxId == SKYBOX_BAZAAR || skyboxId == SKYBOX_HAPPY_MASK_SHOP ||
         (skyboxId >= SKYBOX_KOKIRI_SHOP && skyboxId <= SKYBOX_BOMBCHU_SHOP)) {
         for (j = 0, i = 0; i < 2; i++, j += 2) {
-            phi_s3 = func_800ADBB0(skyboxCtx, skyboxCtx->roomVtx, phi_s3, D_8012AEBC[i].unk_0, D_8012AEBC[i].unk_4,
-                                   D_8012AEBC[i].unk_8, D_8012AEBC[i].unk_C, D_8012AEBC[i].unk_10, i, j);
+            phi_s3 = func_800ADBB0(skyboxCtx, skyboxCtx->roomVtx, phi_s3, sRoomFaceParams[i].unk_0, sRoomFaceParams[i].unk_4,  // was D_8012AEBC [LLM:HIGH]
+                                   sRoomFaceParams[i].unk_8, sRoomFaceParams[i].unk_C, sRoomFaceParams[i].unk_10, i, j);  // was D_8012AEBC [LLM:HIGH]
         }
     } else if (skyboxCtx->unk_140 == 2) {
         for (j = 0, i = 0; i < 3; i++, j += 2) {
-            phi_s3 = func_800ADBB0(skyboxCtx, skyboxCtx->roomVtx, phi_s3, D_8012AEBC[i].unk_0, D_8012AEBC[i].unk_4,
-                                   D_8012AEBC[i].unk_8, D_8012AEBC[i].unk_C, D_8012AEBC[i].unk_10, i, j);
+            phi_s3 = func_800ADBB0(skyboxCtx, skyboxCtx->roomVtx, phi_s3, sRoomFaceParams[i].unk_0, sRoomFaceParams[i].unk_4,  // was D_8012AEBC [LLM:HIGH]
+                                   sRoomFaceParams[i].unk_8, sRoomFaceParams[i].unk_C, sRoomFaceParams[i].unk_10, i, j);  // was D_8012AEBC [LLM:HIGH]
         }
     } else {
         for (j = 0, i = 0; i < 4; i++, j += 2) {
-            phi_s3 = func_800ADBB0(skyboxCtx, skyboxCtx->roomVtx, phi_s3, D_8012AEBC[i].unk_0, D_8012AEBC[i].unk_4,
-                                   D_8012AEBC[i].unk_8, D_8012AEBC[i].unk_C, D_8012AEBC[i].unk_10, i, j);
+            phi_s3 = func_800ADBB0(skyboxCtx, skyboxCtx->roomVtx, phi_s3, sRoomFaceParams[i].unk_0, sRoomFaceParams[i].unk_4,  // was D_8012AEBC [LLM:HIGH]
+                                   sRoomFaceParams[i].unk_8, sRoomFaceParams[i].unk_C, sRoomFaceParams[i].unk_10, i, j);  // was D_8012AEBC [LLM:HIGH]
         }
     }
 }
