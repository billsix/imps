From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:41:11 +0000
Subject: [PATCH 2610/3799] soh: rename func_80ACBC0C -> EnOwl_FlyAway

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: climbs and accelerates away on its chosen heading, dying once 6000 units out
Defined in soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
index cb670c1cf..f0124884a 100644
--- a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
+++ b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
@@ -869,7 +869,8 @@ void EnOwl_SetCutsceneMode(EnOwl* this, PlayState* play) {
     this->unk_40A = play->csCtx.npcActions[7]->action;
 }
 
-void func_80ACBC0C(EnOwl* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80ACBC0C: climbs and accelerates away on its chosen heading, dying once 6000 units out
+void EnOwl_FlyAway(EnOwl* this, PlayState* play) {
     this->actor.flags |= ACTOR_FLAG_DRAW_CULLING_DISABLED;
 
     if (this->actor.xzDistToPlayer > 6000.0f && !(this->actionFlags & 0x80)) {
@@ -911,7 +912,7 @@ void func_80ACBD4C(EnOwl* this, PlayState* play) {
     }
 
     if (this->actionFlags & 1) {
-        EnOwl_ChangeMode(this, func_80ACBC0C, func_80ACC460, &this->skelAnime, &gOwlFlyAnim, 0.0f);
+        EnOwl_ChangeMode(this, EnOwl_FlyAway, func_80ACC460, &this->skelAnime, &gOwlFlyAnim, 0.0f);  // was func_80ACBC0C [LLM:HIGH]
         this->unk_3FE = 6;
         if (this->actionFlags & 0x40) {
             this->unk_400 += 0x2000;
@@ -944,7 +945,7 @@ void func_80ACBF50(EnOwl* this, PlayState* play) {
     this->actor.shape.rot.y = this->actor.world.rot.y;
 
     if (this->actionFlags & 1) {
-        EnOwl_ChangeMode(this, func_80ACBC0C, func_80ACC460, &this->skelAnime, &gOwlFlyAnim, 0.0f);
+        EnOwl_ChangeMode(this, EnOwl_FlyAway, func_80ACC460, &this->skelAnime, &gOwlFlyAnim, 0.0f);  // was func_80ACBC0C [LLM:HIGH]
         this->unk_3FE = 6;
         this->actor.velocity.y = 2.0f;
         this->actor.gravity = 0.0f;
