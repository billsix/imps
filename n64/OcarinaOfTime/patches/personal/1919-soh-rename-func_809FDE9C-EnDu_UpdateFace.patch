     Npc_TrackPoint(&this->actor, &this->interactInfo, 3, trackingMode);
 }
 
-void func_809FDE9C(EnDu* this) {
+// LLM generated name (HIGH), was func_809FDE9C: runs the blink timer and picks the eye, mouth and nose texture indices from unk_1EC/unk_1ED/unk_1EE
+void EnDu_UpdateFace(EnDu* this) {
     if (this->blinkTimer > 0) {
         this->blinkTimer--;
     } else {
@@ -610,7 +611,7 @@ void EnDu_Update(Actor* thisx, PlayState* play) {
     }
 
     SkelAnime_Update(&this->skelAnime);
-    func_809FDE9C(this);
+    EnDu_UpdateFace(this);  // was func_809FDE9C [LLM:HIGH]
