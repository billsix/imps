From 4c5f4e9f9c0566f2597fea8f9b278e7630b6adc3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:24:06 +0000
Subject: [PATCH 2385/3799] soh: rename D_8086E0E0 -> sTallFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the 140-unit-high point transformed into the tall switch's focus position
Defined in soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
index 2c573977a..39ae9c31d 100644
--- a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
+++ b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
@@ -116,7 +116,8 @@ static InitChainEntry sInitChain[] = {
     ICHAIN_F32(uncullZoneDownward, 1200, ICHAIN_STOP),
 };
 
-static Vec3f D_8086E0E0 = { 0.0f, 140.0f, 0.0f };
+// LLM generated name (HIGH), was D_8086E0E0: the 140-unit-high point transformed into the tall switch's focus position
+static Vec3f sTallFocusOffset = { 0.0f, 140.0f, 0.0f };  // was D_8086E0E0 [LLM:HIGH]
 
 void BgBdanSwitch_InitDynaPoly(BgBdanSwitch* this, PlayState* play, CollisionHeader* collision, s32 flag) {
     s16 pad1;
@@ -562,7 +563,7 @@ void BgBdanSwitch_Draw(Actor* thisx, PlayState* play) {
         case YELLOW_TALL_2:
             BgBdanSwitch_DrawDList(this, play, gJabuYellowFloorSwitchDL);  // was func_8086DF58 [LLM:HIGH]
             Collider_UpdateSpheres(0, &this->collider);
-            Matrix_MultVec3f(&D_8086E0E0, &this->dyna.actor.focus.pos);
+            Matrix_MultVec3f(&sTallFocusOffset, &this->dyna.actor.focus.pos);  // was D_8086E0E0 [LLM:HIGH]
             break;
         case BLUE:
             BgBdanSwitch_DrawDList(this, play, gJabuBlueFloorSwitchDL);  // was func_8086DF58 [LLM:HIGH]
