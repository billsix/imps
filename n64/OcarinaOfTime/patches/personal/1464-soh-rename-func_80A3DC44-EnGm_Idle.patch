From ee801b5df19c9af3e9b7cd008581cdc0404285d1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:20:43 +0000
Subject: [PATCH 1464/3799] soh: rename func_80A3DC44 -> EnGm_Idle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the main idle: refreshes the text id and offers talk, routing an accepted conversation to the plain reply or to the buy/decline prompt according to the sale state.
Defined in soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/soh/Enhancements/randomizer/hook_handlers.cpp |  2 +-
 soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c       | 11 ++++++-----
 soh/src/overlays/actors/ovl_En_Gm/z_en_gm.h       |  2 +-
 3 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/soh/Enhancements/randomizer/hook_handlers.cpp b/soh/soh/Enhancements/randomizer/hook_handlers.cpp
index 239759591..add4baa40 100644
--- a/soh/soh/Enhancements/randomizer/hook_handlers.cpp
+++ b/soh/soh/Enhancements/randomizer/hook_handlers.cpp
@@ -1457,7 +1457,7 @@ void RandomizerOnVanillaBehaviorHandler(GIVanillaBehavior id, bool* should, va_l
                     Flags_SetInfTable(INFTABLE_B1);
                     Flags_SetRandomizerInf(RAND_INF_MERCHANTS_MEDIGORON);
                     enGm->actor.parent = NULL;
-                    enGm->actionFunc = (EnGmActionFunc)func_80A3DC44;
+                    enGm->actionFunc = (EnGmActionFunc)EnGm_Idle;  // was func_80A3DC44 [LLM:HIGH]
                     Rupees_ChangeBy(OTRGlobals::Instance->gRandoContext->GetItemLocation(RC_GC_MEDIGORON)->GetPrice() *
                                     -1);
                     *should = false;
diff --git a/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c b/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
index bd607829d..5a613c4c4 100644
--- a/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
+++ b/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
@@ -24,7 +24,8 @@ void EnGm_WaitForObject(EnGm* this, PlayState* play);  // was func_80A3D838 [LLM
 void EnGm_UpdateMain(EnGm* this, PlayState* play);  // was func_80A3DFBC [LLM:HIGH]
 // LLM generated name (HIGH), was func_80A3DB04: Medigoron's pre-reveal idle: offers only his brush-off line until the room's switch flag is set, at which point he starts the sales pitch.
 void EnGm_WaitForSwitch(EnGm* this, PlayState* play);  // was func_80A3DB04 [LLM:HIGH]
-void func_80A3DC44(EnGm* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A3DC44: the main idle: refreshes the text id and offers talk, routing an accepted conversation to the plain reply or to the buy/decline prompt according to the sale state.
+void EnGm_Idle(EnGm* this, PlayState* play);  // was func_80A3DC44 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80A3DBF4: waits out that brush-off textbox and returns to the pre-reveal idle.
 void EnGm_TalkBeforeSwitch(EnGm* this, PlayState* play);  // was func_80A3DBF4 [LLM:HIGH]
 void func_80A3DD7C(EnGm* this, PlayState* play);
@@ -184,7 +185,7 @@ void EnGm_WaitForSwitch(EnGm* this, PlayState* play) {
 
     if (Flags_GetSwitch(play, this->actor.params)) {
         EnGm_SetTextID(this);
-        this->actionFunc = func_80A3DC44;
+        this->actionFunc = EnGm_Idle;  // was func_80A3DC44 [LLM:HIGH]
     } else if (Actor_ProcessTalkRequest(&this->actor, play)) {
         this->actionFunc = EnGm_TalkBeforeSwitch;  // was func_80A3DBF4 [LLM:HIGH]
     } else if ((this->collider.base.ocFlags1 & OC1_HIT) || (SQ(dx) + SQ(dz)) < SQ(100.0f)) {
@@ -199,7 +200,7 @@ void EnGm_TalkBeforeSwitch(EnGm* this, PlayState* play) {
     }
 }
 
-void func_80A3DC44(EnGm* this, PlayState* play) {
+void EnGm_Idle(EnGm* this, PlayState* play) {
     f32 dx;
     f32 dz;
     s32 pad;
@@ -237,7 +238,7 @@ void func_80A3DD7C(EnGm* this, PlayState* play) {
     u8 dialogState = Message_GetState(&play->msgCtx);
 
     if ((dialogState == TEXT_STATE_DONE || dialogState == TEXT_STATE_EVENT) && Message_ShouldAdvance(play)) {
-        this->actionFunc = func_80A3DC44;
+        this->actionFunc = EnGm_Idle;  // was func_80A3DC44 [LLM:HIGH]
         if (dialogState == TEXT_STATE_EVENT) {
             play->msgCtx.msgMode = MSGMODE_TEXT_CLOSING;
             play->msgCtx.stateTimer = 4;
@@ -279,7 +280,7 @@ void func_80A3DF00(EnGm* this, PlayState* play) {
 void func_80A3DF60(EnGm* this, PlayState* play) {
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_DONE) && Message_ShouldAdvance(play)) {
         Rupees_ChangeBy(-200);
-        this->actionFunc = func_80A3DC44;
+        this->actionFunc = EnGm_Idle;  // was func_80A3DC44 [LLM:HIGH]
     }
 }
 
diff --git a/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.h b/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.h
