From 30a3e8a988dfe34126b2fbbb3df02885874f9434 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:01 +0000
Subject: [PATCH 3366/3799] soh: rename D_80A4856C -> sGo2HeadFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point EnGo2_PostLimbDraw records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
index c9a5f97eb..c5a5bbb3c 100644
--- a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
+++ b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
@@ -2092,10 +2092,10 @@ s32 EnGo2_OverrideLimbDraw(PlayState* play, s32 limb, Gfx** dList, Vec3f* pos, V
 
 void EnGo2_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
     EnGo2* this = (EnGo2*)thisx;
-    Vec3f D_80A4856C = { 600.0f, 0.0f, 0.0f };
+    Vec3f sGo2HeadFocusOffset = { 600.0f, 0.0f, 0.0f };  // was D_80A4856C [LLM:HIGH]
 
     if (limbIndex == 17) {
-        Matrix_MultVec3f(&D_80A4856C, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sGo2HeadFocusOffset, &this->actor.focus.pos);  // was D_80A4856C [LLM:HIGH]
     }
 }
 
