Subject: [PATCH 150/225] soh: rename func_80989B54 -> DemoKankyo_InitRainDrop

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c b/soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c
index 161926853..0109ede4b 100644
--- a/soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c
+++ b/soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c
@@ -488,7 +488,8 @@ void DemoKankyo_Draw(Actor* thisx, PlayState* play) {
 }
 
 // transform relating to blue rain
-void func_80989B54(Actor* thisx, PlayState* play, s16 i) {
+// LLM generated name (HIGH), was func_80989B54: initializes one rain-drop particle's position/velocity per scene.
+void DemoKankyo_InitRainDrop(Actor* thisx, PlayState* play, s16 i) {
     DemoKankyo* this = (DemoKankyo*)thisx;
 
     switch (play->sceneNum) {
@@ -545,7 +546,7 @@ void DemoKankyo_DrawRain(Actor* thisx, PlayState* play) {
 
         switch (this->unk_150[i].unk_22) {
             case 0:
-                func_80989B54(thisx, play, i);
+                DemoKankyo_InitRainDrop(thisx, play, i);
                 if (gSaveContext.entranceIndex == ENTR_CUTSCENE_MAP_0) { // Cutscene Map
                     this->unk_150[i].unk_0.y = Rand_ZeroOne() * 500.0f;
                 } else {
@@ -575,7 +576,7 @@ void DemoKankyo_DrawRain(Actor* thisx, PlayState* play) {
                 }
                 break;
             case 2:
-                func_80989B54(thisx, play, i);
+                DemoKankyo_InitRainDrop(thisx, play, i);
                 this->unk_150[i].unk_22--;
                 break;
         }
