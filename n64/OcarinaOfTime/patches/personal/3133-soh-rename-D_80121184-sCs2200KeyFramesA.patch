From 514054fd4fe274c0d0065893fa4807e0dab5565d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:43 +0000
Subject: [PATCH 3133/3799] soh: rename D_80121184 -> sCs2200KeyFramesA

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the first of the two keyframe sets cutscene 2200 chooses between
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 18 +++++++++---------
 soh/src/code/z_onepointdemo_data.inc |  3 ++-
 2 files changed, 11 insertions(+), 10 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index ad883bad0..9a0127321 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -23,7 +23,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs2270KeyFrames)                                   \
     F(sCs2280KeyFrames)                                   \
     F(sCs2230KeyFrames)                                   \
-    F(D_80121184)                                   \
+    F(sCs2200KeyFramesA)                                   \
     F(D_801211D4)                                   \
     F(sCs4510KeyFrames)                                   \
     F(sCs2210KeyFrames)                                   \
@@ -273,14 +273,14 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             if ((sp82 > 0) && (sp82 < 320) && (sp7E > 0) && (sp7E < 240) && (sp80 > 0) && (sp80 < 320) && (sp7C > 0) &&
                 (sp7C < 240) &&
                 !OnePointCutscene_BgCheckLineTest(&play->colCtx, &actor->focus.pos, &player->actor.focus.pos)) {
-                D_80121184[0].atTargetInit.x = (play->view.lookAt.x + actor->focus.pos.x) * 0.5f;
-                D_80121184[0].atTargetInit.y = (play->view.lookAt.y + actor->focus.pos.y) * 0.5f;
-                D_80121184[0].atTargetInit.z = (play->view.lookAt.z + actor->focus.pos.z) * 0.5f;
-                D_80121184[0].eyeTargetInit = play->view.eye;
-                D_80121184[0].eyeTargetInit.y = player->actor.focus.pos.y + 20.0f;
-                D_80121184[0].fovTargetInit = mainCam->fov * 0.75f;
-
-                csInfo->keyFrames = D_80121184;
+                sCs2200KeyFramesA[0].atTargetInit.x = (play->view.lookAt.x + actor->focus.pos.x) * 0.5f;  // was D_80121184 [LLM:HIGH]
+                sCs2200KeyFramesA[0].atTargetInit.y = (play->view.lookAt.y + actor->focus.pos.y) * 0.5f;  // was D_80121184 [LLM:HIGH]
+                sCs2200KeyFramesA[0].atTargetInit.z = (play->view.lookAt.z + actor->focus.pos.z) * 0.5f;  // was D_80121184 [LLM:HIGH]
+                sCs2200KeyFramesA[0].eyeTargetInit = play->view.eye;  // was D_80121184 [LLM:HIGH]
+                sCs2200KeyFramesA[0].eyeTargetInit.y = player->actor.focus.pos.y + 20.0f;  // was D_80121184 [LLM:HIGH]
+                sCs2200KeyFramesA[0].fovTargetInit = mainCam->fov * 0.75f;  // was D_80121184 [LLM:HIGH]
+
+                csInfo->keyFrames = sCs2200KeyFramesA;  // was D_80121184 [LLM:HIGH]
                 csInfo->keyFrameCnt = 2;
             } else {
                 D_801211D4[0].atTargetInit.x = actor->focus.pos.x;
