From 9d7e78219342daa2f94c0ece5958522611f22464 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:11 +0000
Subject: [PATCH 019/784] soh: rename UnkRumbleStruct -> RumbleMgr

Name source: deduced from the code (confidence HIGH).
Defined in soh/include/z64.h.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h   |  6 +++---
 soh/include/z64.h         |  2 +-
 soh/src/code/sys_rumble.c | 10 +++++-----
 soh/src/code/z_rumble.c   |  2 +-
 4 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 659306dca..9737446a9 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1830,9 +1830,9 @@ uintptr_t SysUcode_GetUCodeBoot(void);
 size_t SysUcode_GetUCodeBootSize(void);
 uint32_t SysUcode_GetUCode(void);
 uintptr_t SysUcode_GetUCodeData(void);
-void func_800D2E30(UnkRumbleStruct* arg0);
-void func_800D3140(UnkRumbleStruct* arg0);
-void func_800D3178(UnkRumbleStruct* arg0);
+void func_800D2E30(RumbleMgr* arg0);
+void func_800D3140(RumbleMgr* arg0);
+void func_800D3178(RumbleMgr* arg0);
 void func_800D31A0(void);
 void func_800D31F0(void);
 void func_800D3210(void);
diff --git a/soh/include/z64.h b/soh/include/z64.h
index 254b7e966..06871708a 100644
--- a/soh/include/z64.h
+++ b/soh/include/z64.h
@@ -2253,7 +2253,7 @@ typedef struct {
     /* 0x10B */ u8 unk_10B;
     /* 0x10C */ u8 unk_10C;
     /* 0x10D */ u8 unk_10D;
-} UnkRumbleStruct; // size = 0x10E
+} RumbleMgr; // size = 0x10E — LLM generated name (HIGH), was UnkRumbleStruct: the rumble manager state owned by PadMgr and driven by sys_rumble.c.
 
 typedef struct {
     /* 0x00 */ char unk_00[0x18];
diff --git a/soh/src/code/sys_rumble.c b/soh/src/code/sys_rumble.c
index 725df18cc..71bb80499 100644
--- a/soh/src/code/sys_rumble.c
+++ b/soh/src/code/sys_rumble.c
@@ -1,7 +1,7 @@
 #include "global.h"
 #include <string.h>
 
-void func_800D2E30(UnkRumbleStruct* arg0) {
+void func_800D2E30(RumbleMgr* arg0) {
     static u8 D_8012DBB0 = 1;
     s32 i;
     s32 unk_a3;
@@ -109,12 +109,12 @@ void func_800D2E30(UnkRumbleStruct* arg0) {
     }
 }
 
-void func_800D3140(UnkRumbleStruct* arg0) {
-    memset(arg0, 0, sizeof(UnkRumbleStruct));
+void func_800D3140(RumbleMgr* arg0) {
+    memset(arg0, 0, sizeof(RumbleMgr));
     arg0->unk_104 = 2;
     arg0->unk_105 = 1;
 }
 
-void func_800D3178(UnkRumbleStruct* arg0) {
-    memset(arg0, 0, sizeof(UnkRumbleStruct));
+void func_800D3178(RumbleMgr* arg0) {
+    memset(arg0, 0, sizeof(RumbleMgr));
 }
diff --git a/soh/src/code/z_rumble.c b/soh/src/code/z_rumble.c
index 512ad4940..750cea330 100644
--- a/soh/src/code/z_rumble.c
+++ b/soh/src/code/z_rumble.c
@@ -1,6 +1,6 @@
 #include "global.h"
 
-UnkRumbleStruct D_80160FD0;
+RumbleMgr D_80160FD0;
 
 void func_800A9F30(PadMgr* a, s32 b) {
