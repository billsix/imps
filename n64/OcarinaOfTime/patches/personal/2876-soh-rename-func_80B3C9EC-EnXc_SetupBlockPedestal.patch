From 65ea60b02621d21e98a1f0a0c9d6ef7887d77bd8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:41 +0000
Subject: [PATCH 2876/3799] soh: rename func_80B3C9EC ->
 EnXc_SetupBlockPedestal

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loops the arms-crossed idle and enters the pedestal-blocking action, which randomizer removes entirely
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 4f113d8aa..96016bc49 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -276,7 +276,8 @@ void EnXc_ClearRootMotion(EnXc* this) {
     this->skelAnime.movementFlags &= ~0x3;
 }
 
-void func_80B3C9EC(EnXc* this) {
+// LLM generated name (HIGH), was func_80B3C9EC: loops the arms-crossed idle and enters the pedestal-blocking action, which randomizer removes entirely
+void EnXc_SetupBlockPedestal(EnXc* this) {
     EnXc_ChangeAnimation(this, &gSheikArmsCrossedIdleAnim, ANIMMODE_LOOP, 0.0f, false);
     this->action = SHEIK_ACTION_BLOCK_PEDESTAL;
     this->drawMode = SHEIK_DRAW_DEFAULT;
@@ -1200,7 +1201,7 @@ void func_80B3EC90(EnXc* this, PlayState* play) {
         CsCmdActorCue* npcAction = csCtx->npcActions[4];
 
         if (npcAction != NULL && npcAction->action != 6) {
-            func_80B3C9EC(this);
+            EnXc_SetupBlockPedestal(this);  // was func_80B3C9EC [LLM:HIGH]
         }
     }
 }
@@ -2219,7 +2220,7 @@ void EnXc_InitTempleOfTime(EnXc* this, PlayState* play) {
             }
             this->action = SHEIK_ACTION_30; // Not sure what this does exactly
         } else if (!Flags_GetEventChkInf(EVENTCHKINF_LEARNED_PRELUDE_OF_LIGHT)) {
-            func_80B3C9EC(this);
+            EnXc_SetupBlockPedestal(this);  // was func_80B3C9EC [LLM:HIGH]
         } else {
             Actor_Kill(&this->actor);
         }
