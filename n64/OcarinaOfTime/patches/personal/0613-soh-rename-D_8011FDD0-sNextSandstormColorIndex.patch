From f026e366c69a88ab89ed2423ec5f24402b70d4de Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:12 +0000
Subject: [PATCH 0613/3799] soh: rename D_8011FDD0 -> sNextSandstormColorIndex

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/z_kankyo.c.
---
 soh/src/code/z_kankyo.c | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/src/code/z_kankyo.c b/soh/src/code/z_kankyo.c
index d3862184c..d7bbcb20d 100644
--- a/soh/src/code/z_kankyo.c
+++ b/soh/src/code/z_kankyo.c
@@ -203,7 +203,8 @@ SkyboxFile gSkyboxFiles[] = {
 
 // Name from zeldaret/oot (was D_8011FDCC): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_kankyo.c]
 u8 sSandstormColorIndex = 0;
-u8 D_8011FDD0 = 0;
+// Name from zeldaret/oot (was D_8011FDD0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_kankyo.c]
+u8 sNextSandstormColorIndex = 0;
 f32 D_8011FDD4 = 0.0f;
 
 u8 gCustomLensFlareOn;
@@ -993,7 +994,7 @@ void Environment_Update(PlayState* play, EnvironmentContext* envCtx, LightContex
                                                       ((void)0, gSaveContext.skyboxTime));
 
                         sSandstormColorIndex = TIME_ENTRY_1F.unk_04 & 3;
-                        D_8011FDD0 = TIME_ENTRY_1F.unk_05 & 3;
+                        sNextSandstormColorIndex = TIME_ENTRY_1F.unk_05 & 3;
                         D_8011FDD4 = sp8C;
 
                         if (envCtx->unk_21) {
@@ -2404,7 +2405,7 @@ void Environment_DrawSandstorm(PlayState* play, u8 sandstormState) {
         envColor.r = sSandstormEnvColors[1].r;
         envColor.g = sSandstormEnvColors[1].g;
         envColor.b = sSandstormEnvColors[1].b;
-    } else if (sSandstormColorIndex == D_8011FDD0) {
+    } else if (sSandstormColorIndex == sNextSandstormColorIndex) {
         primColor.r = sSandstormPrimColors[sSandstormColorIndex].r;
         primColor.g = sSandstormPrimColors[sSandstormColorIndex].g;
         primColor.b = sSandstormPrimColors[sSandstormColorIndex].b;
@@ -2412,12 +2413,12 @@ void Environment_DrawSandstorm(PlayState* play, u8 sandstormState) {
         envColor.g = sSandstormEnvColors[sSandstormColorIndex].g;
         envColor.b = sSandstormEnvColors[sSandstormColorIndex].b;
     } else {
-        primColor.r = (s32)F32_LERP(sSandstormPrimColors[sSandstormColorIndex].r, sSandstormPrimColors[D_8011FDD0].r, D_8011FDD4);
-        primColor.g = (s32)F32_LERP(sSandstormPrimColors[sSandstormColorIndex].g, sSandstormPrimColors[D_8011FDD0].g, D_8011FDD4);
-        primColor.b = (s32)F32_LERP(sSandstormPrimColors[sSandstormColorIndex].b, sSandstormPrimColors[D_8011FDD0].b, D_8011FDD4);
-        envColor.r = (s32)F32_LERP(sSandstormEnvColors[sSandstormColorIndex].r, sSandstormEnvColors[D_8011FDD0].r, D_8011FDD4);
-        envColor.g = (s32)F32_LERP(sSandstormEnvColors[sSandstormColorIndex].g, sSandstormEnvColors[D_8011FDD0].g, D_8011FDD4);
-        envColor.b = (s32)F32_LERP(sSandstormEnvColors[sSandstormColorIndex].b, sSandstormEnvColors[D_8011FDD0].b, D_8011FDD4);
+        primColor.r = (s32)F32_LERP(sSandstormPrimColors[sSandstormColorIndex].r, sSandstormPrimColors[sNextSandstormColorIndex].r, D_8011FDD4);
+        primColor.g = (s32)F32_LERP(sSandstormPrimColors[sSandstormColorIndex].g, sSandstormPrimColors[sNextSandstormColorIndex].g, D_8011FDD4);
+        primColor.b = (s32)F32_LERP(sSandstormPrimColors[sSandstormColorIndex].b, sSandstormPrimColors[sNextSandstormColorIndex].b, D_8011FDD4);
+        envColor.r = (s32)F32_LERP(sSandstormEnvColors[sSandstormColorIndex].r, sSandstormEnvColors[sNextSandstormColorIndex].r, D_8011FDD4);
+        envColor.g = (s32)F32_LERP(sSandstormEnvColors[sSandstormColorIndex].g, sSandstormEnvColors[sNextSandstormColorIndex].g, D_8011FDD4);
+        envColor.b = (s32)F32_LERP(sSandstormEnvColors[sSandstormColorIndex].b, sSandstormEnvColors[sNextSandstormColorIndex].b, D_8011FDD4);
     }
 
     envColor.r = ((envColor.r * sp98) + ((6.0f - sp98) * primColor.r)) * (1.0f / 6.0f);
-- 
2.55.0

