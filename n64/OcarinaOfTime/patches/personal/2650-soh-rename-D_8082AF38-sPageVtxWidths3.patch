+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2642,7 +2642,8 @@ static s16 sPageVtxWidths2[] = {  // was D_8082AF14 [LLM:HIGH]
     0x0030, 0x0030, 0x0060, 0x0018, 0x0018, 0x0018, 0x0018, 0x0018, 0x0018,
     0x0018, 0x0018, 0x0018, 0x0018, 0x0018, 0x0010, 0x0010, 0x0018, 0x0000,
 };
-static s16 D_8082AF38[] = {
+// LLM generated name (HIGH), was D_8082AF38: the widths in slot 3 of the sPageVtxWidths table
+static s16 sPageVtxWidths3[] = {  // was D_8082AF38 [LLM:HIGH]
     0x0000,
     0x0000,
 };
@@ -2698,7 +2699,7 @@ static s16* D_8082B000[] = {
 };
 
 static s16* D_8082B018[] = {
-    sPageVtxWidths0, sPageVtxWidths1, sPageVtxWidths2, D_8082AF38, sCloudTexWidths, D_8082AF3C,  // was D_8082AAEC [LLM:HIGH]
+    sPageVtxWidths0, sPageVtxWidths1, sPageVtxWidths2, sPageVtxWidths3, sCloudTexWidths, D_8082AF3C,  // was D_8082AAEC [LLM:HIGH]
 };
 
