Subject: [PATCH 053/225] soh: rename func_800E5000 -> AudioThread_UpdateImpl

Name source: zeldaret/oot.
Defined in soh/src/code/audio_thread.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_thread.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/audio_thread.c b/soh/src/code/audio_thread.c
index 52aa4a0fa..04d8a3d56 100644
--- a/soh/src/code/audio_thread.c
+++ b/soh/src/code/audio_thread.c
@@ -24,17 +24,17 @@ typedef enum {
 void func_800E6300(SequenceChannel* channel, AudioCmd* arg1);
 void func_800E59AC(s32 playerIdx, s32 fadeTimer);
 void Audio_InitMesgQueues(void);
-AudioTask* func_800E5000(void);
+AudioTask* AudioThread_UpdateImpl(void);
 void Audio_ProcessCmds(u32);
 void func_800E6128(SequencePlayer* seqPlayer, AudioCmd* arg1);
 void func_800E5958(s32 playerIdx, s32 fadeTimer);
 s32 func_800E66C0(s32 arg0);
 
 // AudioMgr_Retrace
-// Name from zeldaret/oot, was func_800E4FE0: thin wrapper returning func_800E5000(); audio thread [oot: https://github.com/zeldaret/oot/blob/main/src/audio/internal/thread.c]
+// Name from zeldaret/oot, was func_800E4FE0: thin wrapper returning AudioThread_UpdateImpl(); audio thread [oot: https://github.com/zeldaret/oot/blob/main/src/audio/internal/thread.c]
 // frame entry
 AudioTask* AudioThread_Update(void) {
-    return func_800E5000();
+    return AudioThread_UpdateImpl();
 }
 
 extern u64 rspAspMainDataStart[];
@@ -73,7 +73,9 @@ void AudioMgr_CreateNextAudioBuffer(s16* samples, u32 num_samples) {
     gAudioContext.audioRandom = (gAudioContext.audioRandom + gAudioContext.totalTaskCnt) * osGetCount();
 }
 
-AudioTask* func_800E5000(void) {
+// Name from zeldaret/oot, was func_800E5000: builds and returns the per-frame AudioTask; called by [oot: https://github.com/zeldaret/oot/blob/main/src/audio/internal/thread.c]
+// AudioThread_Update
+AudioTask* AudioThread_UpdateImpl(void) {
     return NULL;
 
     static s32 sMaxAbiCmdCnt = 0x80;
