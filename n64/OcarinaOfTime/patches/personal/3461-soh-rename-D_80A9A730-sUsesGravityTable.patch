From 1604e142809ca8dcb94c9d2727f5ee2fc26ea61c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:14 +0000
Subject: [PATCH 3461/3799] soh: rename D_80A9A730 -> sUsesGravityTable

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-type, per-quest-state flag EnKo_UsesGravity returns
Defined in soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
index 78f2bc0eb..b42298169 100644
--- a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
+++ b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
@@ -659,7 +659,7 @@ f32 EnKo_GetTrackYOffset(EnKo* this) {
 
 // LLM generated name (HIGH), was func_80A97C7C: the caller runs Actor_UpdateBgCheckInfo and sets gravity -1 when this is true, gravity 0 when false
 u8 EnKo_UsesGravity(EnKo* this) {
-    u8 D_80A9A730[13][5] = {
+    u8 sUsesGravityTable[13][5] = {  // was D_80A9A730 [LLM:HIGH]
         /* ENKO_TYPE_CHILD_0    */ { 1, 1, 1, 0, 1 },
         /* ENKO_TYPE_CHILD_1    */ { 1, 1, 1, 1, 1 },
         /* ENKO_TYPE_CHILD_2    */ { 1, 1, 1, 0, 1 },
@@ -675,7 +675,7 @@ u8 EnKo_UsesGravity(EnKo* this) {
         /* ENKO_TYPE_CHILD_FADO */ { 1, 1, 1, 1, 1 },
     };
 
-    return D_80A9A730[ENKO_TYPE][EnKo_GetForestQuestState(this)];
+    return sUsesGravityTable[ENKO_TYPE][EnKo_GetForestQuestState(this)];  // was D_80A9A730 [LLM:HIGH]
 }
 
 s32 EnKo_IsWithinTalkAngle(EnKo* this) {
