From 60a90c7dd367f47e23ac3b7df3581b2b5505f4a9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:08 +0000
Subject: [PATCH 3415/3799] soh: rename D_80A6EDFC -> sHsFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point EnHs_PostLimbDraw records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c b/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
index 5a96e399e..548b0d30c 100644
--- a/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
+++ b/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
@@ -300,11 +300,11 @@ s32 EnHs_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 }
 
 void EnHs_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
-    static Vec3f D_80A6EDFC = { 300.0f, 1000.0f, 0.0f };
+    static Vec3f sHsFocusOffset = { 300.0f, 1000.0f, 0.0f };  // was D_80A6EDFC [LLM:HIGH]
     EnHs* this = (EnHs*)thisx;
 
     if (limbIndex == 9) {
-        Matrix_MultVec3f(&D_80A6EDFC, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sHsFocusOffset, &this->actor.focus.pos);  // was D_80A6EDFC [LLM:HIGH]
     }
 }
 
