From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:27 +0000
Subject: [PATCH 0148/3799] soh: rename D_8098CF80 -> sRainSpeed

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 .../overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c   | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c b/soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c
index 6718d3714..ef40404ef 100644
--- a/soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c
+++ b/soh/src/overlays/actors/ovl_Demo_Kankyo/z_demo_kankyo.c
@@ -174,7 +174,8 @@ static CutsceneCameraPoint sSparklesCameraPoints[] = {
     { CS_CMD_STOP, 0, 2, 45.0f, { 0xFFF6, 0x002B, 0xFFD4 } },
 };
 
-static s16 D_8098CF80;
+// LLM generated name (HIGH), was D_8098CF80: per-scene rain fall speed multiplier used when init'ing rain drops.
+static s16 sRainSpeed;
 static s16 sRainScale;
 static s16 D_8098CF84;
 
@@ -200,15 +201,15 @@ void DemoKankyo_Init(Actor* thisx, PlayState* play) {
             switch (play->sceneNum) {
                 case SCENE_CUTSCENE_MAP:
                     play->roomCtx.curRoom.segment = NULL;
-                    D_8098CF80 = 10;
+                    sRainSpeed = 10;
                     sRainScale = 8;
                     break;
                 case SCENE_TEMPLE_OF_TIME:
-                    D_8098CF80 = 14;
+                    sRainSpeed = 14;
                     sRainScale = 8;
                     break;
                 case SCENE_HYRULE_FIELD:
-                    D_8098CF80 = 1;
+                    sRainSpeed = 1;
                     sRainScale = 5;
                     break;
                 default:
@@ -509,7 +510,7 @@ void func_80989B54(Actor* thisx, PlayState* play, s16 i) {
             this->unk_150[i].unk_0.z = (Rand_ZeroOne() - 0.5f) * 600.0f;
             break;
     }
-    this->unk_150[i].unk_18 = Rand_ZeroOne() * (D_8098CF80 * 4.0f) + D_8098CF80;
+    this->unk_150[i].unk_18 = Rand_ZeroOne() * (sRainSpeed * 4.0f) + sRainSpeed;
 }
 
 void DemoKankyo_DrawRain(Actor* thisx, PlayState* play) {
