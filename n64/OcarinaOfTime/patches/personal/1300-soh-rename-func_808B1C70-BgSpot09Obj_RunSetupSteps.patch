--- a/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
@@ -110,7 +110,8 @@ s32 BgSpot09Obj_InitCollision(BgSpot09Obj* this, PlayState* play) {
     return true;
 }
 
-s32 func_808B1C70(BgSpot09Obj* this, PlayState* play) {
+// LLM generated name (HIGH), was func_808B1C70: runs the three setup functions in order and returns false as soon as one of them does.
+s32 BgSpot09Obj_RunSetupSteps(BgSpot09Obj* this, PlayState* play) {
     s32 i;
 
     for (i = 0; i < ARRAY_COUNT(D_808B1FA4); i++) {
@@ -150,7 +151,7 @@ void BgSpot09Obj_Init(Actor* thisx, PlayState* play) {
                      this->dyna.actor.params);
     }
 
-    if (!func_808B1C70(this, play)) {
+    if (!BgSpot09Obj_RunSetupSteps(this, play)) {  // was func_808B1C70 [LLM:HIGH]
         Actor_Kill(&this->dyna.actor);
     } else if (!func_808B1D44(this, play)) {
         Actor_Kill(&this->dyna.actor);
