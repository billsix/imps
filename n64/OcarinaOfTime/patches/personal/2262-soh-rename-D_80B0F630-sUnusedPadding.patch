 };
 
-char D_80B0F630[0x80]; // unused
+// LLM generated name (GUESS), was D_80B0F630: an 0x80-byte file-scope buffer already commented unused; nothing in the overlay reads or writes it
+char sUnusedPadding[0x80]; // unused, was D_80B0F630 [LLM:GUESS]
 
