Subject: [PATCH 0455/3799] soh: rename func_80AED4FC ->
 EnRu1_PlayHittingSurfaceSfx

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 63be74872..77dec1270 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1242,7 +1242,8 @@ void func_80AED44C(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AED4FC(EnRu1* this) {
+// Name from zeldaret/oot (was func_80AED4FC): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_PlayHittingSurfaceSfx(EnRu1* this) {
     Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_EV_LAND_DIRT);
 }
 
@@ -1418,7 +1419,7 @@ void func_80AEDB30(EnRu1* this, PlayState* play) {
                     *gravity = 0.0f;
                 }
             }
-            func_80AED4FC(this);
+            EnRu1_PlayHittingSurfaceSfx(this);
         }
     }
     if (this->actor.bgCheckFlags & 0x10) {
@@ -1431,7 +1432,7 @@ void func_80AEDB30(EnRu1* this, PlayState* play) {
         }
         if (*velocityY >= 0.0f) {
             *velocityY *= -((kREG(20) * 0.01f) + 0.6f);
-            func_80AED4FC(this);
+            EnRu1_PlayHittingSurfaceSfx(this);
         }
     }
     if (this->actor.bgCheckFlags & BGCHECKFLAG_WALL) {
@@ -1453,7 +1454,7 @@ void func_80AEDB30(EnRu1* this, PlayState* play) {
                     *speedXZ = 0.0f;
                 }
                 this->actor.world.rot.y = temp_a1_2;
-                func_80AED4FC(this);
+                EnRu1_PlayHittingSurfaceSfx(this);
                 func_80AED5B8(this);
             }
         }
