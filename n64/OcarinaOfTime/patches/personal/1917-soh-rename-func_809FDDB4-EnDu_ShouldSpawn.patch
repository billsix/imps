From 895848df286ee85749a9af26580426602ca8dbdd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:03:59 +0000
Subject: [PATCH 1917/3799] soh: rename func_809FDDB4 -> EnDu_ShouldSpawn

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Init kills the actor when this returns 0; true only in Goron City as child, or in the Fire Temple as adult before INFTABLE_SPOKE_TO_DARUNIA_IN_FIRE_TEMPLE
Defined in soh/src/overlays/actors/ovl_En_Du/z_en_du.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Du/z_en_du.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Du/z_en_du.c b/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
index ce17854da..84243a6b6 100644
--- a/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
+++ b/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
@@ -175,7 +175,8 @@ s16 EnDu_UpdateTalkState(PlayState* play, Actor* actor) {
     return NPC_TALK_STATE_TALKING;
 }
 
-s32 func_809FDDB4(EnDu* this, PlayState* play) {
+// LLM generated name (HIGH), was func_809FDDB4: Init kills the actor when this returns 0; true only in Goron City as child, or in the Fire Temple as adult before INFTABLE_SPOKE_TO_DARUNIA_IN_FIRE_TEMPLE
+s32 EnDu_ShouldSpawn(EnDu* this, PlayState* play) {
     if (play->sceneNum == SCENE_GORON_CITY && LINK_IS_CHILD) {
         return 1;
     } else if (play->sceneNum == SCENE_FIRE_TEMPLE && !Flags_GetInfTable(INFTABLE_SPOKE_TO_DARUNIA_IN_FIRE_TEMPLE) &&
@@ -320,7 +321,7 @@ void EnDu_Init(Actor* thisx, PlayState* play) {
     Collider_InitCylinder(play, &this->collider);
     Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);
     CollisionCheck_SetInfo2(&this->actor.colChkInfo, DamageTable_Get(0x16), &sColChkInfoInit);
-    if (func_809FDDB4(this, play) == 0) {
+    if (EnDu_ShouldSpawn(this, play) == 0) {  // was func_809FDDB4 [LLM:HIGH]
         Actor_Kill(&this->actor);
         return;
     }
-- 
