 soh/src/code/audio_sfx.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index b63073a7d..1f5b8d043 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -103,7 +103,8 @@ s32 sUnusedSfxValue1 = 0; // unused, was D_801333E4 [LLM:GUESS]
 
 s8 gSfxDefaultReverb = 0; // default reverbAdd
 
-s32 D_801333EC = 0; // unused
+// LLM generated name (GUESS), was D_801333EC: the second such unused s32
+s32 sUnusedSfxValue2 = 0; // unused, was D_801333EC [LLM:GUESS]
 
 u8 D_801333F0 = 0;
 
