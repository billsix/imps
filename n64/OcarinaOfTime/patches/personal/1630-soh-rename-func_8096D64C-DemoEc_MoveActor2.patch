+++ b/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c
@@ -188,7 +188,8 @@ void DemoEc_MoveActorRebased(DemoEc* this, PlayState* play) {
     AnimationContext_SetMoveActor(play, &this->actor, &this->skelAnime, 1.0f);
 }
 
-void func_8096D64C(DemoEc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_8096D64C: a third copy of DemoEc_MoveActor at its own address, byte-identical to it and used by five of the update modes.
+void DemoEc_MoveActor2(DemoEc* this, PlayState* play) {
     this->skelAnime.movementFlags |= 3;
     AnimationContext_SetMoveActor(play, &this->actor, &this->skelAnime, 1.0f);
 }
@@ -358,7 +359,7 @@ void DemoEc_InitIngo(DemoEc* this, PlayState* play) {
