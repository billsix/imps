From 77431ff8686e61e15d681a2a027203032102d6da Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:33:18 +0000
Subject: [PATCH 0992/3799] soh: rename func_8001F404 -> EnItem00_ConvertDropId

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: its in-tree docstring reads "Converts a given drop type ID based on link's current age, health and owned items. Returns a new drop type ID or -1 to cancel the drop."
Defined in soh/src/code/z_en_item00.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/soh/Enhancements/Fixes/FixFlexDrops.cpp | 4 ++--
 soh/src/code/z_en_item00.c                  | 9 +++++----
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/soh/Enhancements/Fixes/FixFlexDrops.cpp b/soh/soh/Enhancements/Fixes/FixFlexDrops.cpp
index eb088e234..c34d04f3e 100644
--- a/soh/soh/Enhancements/Fixes/FixFlexDrops.cpp
+++ b/soh/soh/Enhancements/Fixes/FixFlexDrops.cpp
@@ -4,7 +4,7 @@
 
 extern "C" {
 // Converts a drop id based on age, health and owned items. Returns -1 when the drop can't be given.
-s16 func_8001F404(s16 dropId);
+s16 EnItem00_ConvertDropId(s16 dropId);  // was func_8001F404 [LLM:HIGH]
 }
 
 static void RegisterFixFlexDrops() {
@@ -12,7 +12,7 @@ static void RegisterFixFlexDrops() {
     // so the drop is thrown away instead of falling through to the next candidate.
     COND_VB_SHOULD(VB_FLEX_DROP_AMMO, CVarGetInteger(CVAR_ENHANCEMENT("FixFlexDrops"), 0), {
         s16 dropId = va_arg(args, s32);
-        if (*should && func_8001F404(dropId) == -1) {
+        if (*should && EnItem00_ConvertDropId(dropId) == -1) {  // was func_8001F404 [LLM:HIGH]
             *should = false;
         }
     });
diff --git a/soh/src/code/z_en_item00.c b/soh/src/code/z_en_item00.c
index ad11fa53c..1df286fd3 100644
--- a/soh/src/code/z_en_item00.c
+++ b/soh/src/code/z_en_item00.c
@@ -1532,7 +1532,8 @@ s16 EnItem00_ConvertBombDropToBombchu(s16 dropId) {
  * Converts a given drop type ID based on link's current age, health and owned items.
  * Returns a new drop type ID or -1 to cancel the drop.
  */
-s16 func_8001F404(s16 dropId) {
+// LLM generated name (HIGH), was func_8001F404: its in-tree docstring reads "Converts a given drop type ID based on link's current age, health and owned items. Returns a new drop type ID or -1 to cancel the drop."
+s16 EnItem00_ConvertDropId(s16 dropId) {
     if (LINK_IS_ADULT) {
         if (dropId == ITEM00_SEEDS) {
             dropId = ITEM00_ARROWS_SMALL;
@@ -1594,7 +1595,7 @@ EnItem00* Item_DropCollectible(PlayState* play, Vec3f* spawnPos, s16 params) {
                                           40);
     } else {
         if (!param8000) {
-            params = func_8001F404(params & 0x00FF);
+            params = EnItem00_ConvertDropId(params & 0x00FF);  // was func_8001F404 [LLM:HIGH]
         }
 
         if (params != -1) {
@@ -1640,7 +1641,7 @@ EnItem00* Item_DropCollectible2(PlayState* play, Vec3f* spawnPos, s16 params) {
         EffectSsDeadSound_SpawnStationary(play, spawnPos, NA_SE_EV_BUTTERFRY_TO_FAIRY, true, DEADSOUND_REPEAT_MODE_OFF,
                                           40);
     } else {
-        params = func_8001F404(params & 0x00FF);
+        params = EnItem00_ConvertDropId(params & 0x00FF);  // was func_8001F404 [LLM:HIGH]
         if (params != -1) {
             spawnedActor = (EnItem00*)Actor_Spawn(&play->actorCtx, play, ACTOR_EN_ITEM00, spawnPos->x, spawnPos->y,
                                                   spawnPos->z, 0, 0, 0, params | param8000 | param3F00);
@@ -1758,7 +1759,7 @@ void Item_DropCollectibleRandom(PlayState* play, Actor* fromActor, Vec3f* spawnP
         dropQuantity = sDropQuantities[params + dropTableIndex];
         while (dropQuantity > 0) {
             if (!param8000) {
-                dropId = func_8001F404(dropId);
+                dropId = EnItem00_ConvertDropId(dropId);  // was func_8001F404 [LLM:HIGH]
                 if (dropId != 0xFF) {
                     spawnedActor = (EnItem00*)Actor_Spawn(&play->actorCtx, play, ACTOR_EN_ITEM00, spawnPos->x,
                                                           spawnPos->y, spawnPos->z, 0, 0, 0, dropId);
-- 
