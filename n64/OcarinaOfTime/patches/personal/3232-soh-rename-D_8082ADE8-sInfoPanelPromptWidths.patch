From 44971ad41e92cfc6cd1bbf80ea8368011c5b6c73 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:49 +0000
Subject: [PATCH 3232/3799] soh: rename D_8082ADE8 -> sInfoPanelPromptWidths

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the width of the third info panel string in each language
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 6380f151c..e08bcea5e 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -1956,7 +1956,7 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
     };
     static u16 sInfoPanelLeftWidths[4] = { 56, 88, 80, 56 };  // was D_8082ADD8 [LLM:HIGH]
     static u16 sInfoPanelRightWidths[4] = { 64, 88, 72, 48 };  // was D_8082ADE0 [LLM:HIGH]
-    static u16 D_8082ADE8[4] = { 80, 104, 112, 80 };
+    static u16 sInfoPanelPromptWidths[4] = { 80, 104, 112, 80 };  // was D_8082ADE8 [LLM:HIGH]
     static s16 D_8082ADF0[][4] = {
         { 180, 210, 255, 220 },
         { 100, 100, 150, 220 },
@@ -2385,12 +2385,12 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
                     }
 
                     pauseCtx->infoPanelVtx[21].v.ob[0] = pauseCtx->infoPanelVtx[23].v.ob[0] =
-                        pauseCtx->infoPanelVtx[20].v.ob[0] + D_8082ADE8[gSaveContext.language];
+                        pauseCtx->infoPanelVtx[20].v.ob[0] + sInfoPanelPromptWidths[gSaveContext.language];  // was D_8082ADE8 [LLM:HIGH]
 
                     pauseCtx->infoPanelVtx[17].v.tc[0] = pauseCtx->infoPanelVtx[19].v.tc[0] = 0x300;
 
                     pauseCtx->infoPanelVtx[21].v.tc[0] = pauseCtx->infoPanelVtx[23].v.tc[0] =
-                        D_8082ADE8[gSaveContext.language] << 5;
+                        sInfoPanelPromptWidths[gSaveContext.language] << 5;  // was D_8082ADE8 [LLM:HIGH]
 
                     gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, aButtonColor.r, aButtonColor.g, aButtonColor.b, 255);
                     // gSPDisplayList(POLY_OPA_DISP++, gAButtonIconDL);
@@ -2404,7 +2404,7 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
 
                     POLY_OPA_DISP =
                         KaleidoScope_QuadTextureIA8(POLY_OPA_DISP, sPlayMelodyTextures[gSaveContext.language],
-                                                    D_8082ADE8[gSaveContext.language], 16, 4);
+                                                    sInfoPanelPromptWidths[gSaveContext.language], 16, 4);  // was D_8082ADE8 [LLM:HIGH]
                 }
             } else if (pauseCtx->pageIndex == PAUSE_EQUIP) {
                 pauseCtx->infoPanelVtx[16].v.ob[0] = pauseCtx->infoPanelVtx[18].v.ob[0] = WREG(64 + languageOffset);
