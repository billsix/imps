From f9ed058e0ac9efcf3e6e71e12218b1c1088bcf06 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:48:27 +0000
Subject: [PATCH 1855/3799] soh: rename func_80AED57C -> EnRu1_PlayThrowSfx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays Ruto's thrown voice clip, but only if she is actually moving.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index b8b108d50..460ab7770 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1344,7 +1344,8 @@ void EnRu1_PlayLiftSfx(EnRu1* this, PlayState* play) {
     Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_VO_RT_LIFT);
 }
 
-void func_80AED57C(EnRu1* this) {
+// LLM generated name (HIGH), was func_80AED57C: plays Ruto's thrown voice clip, but only if she is actually moving.
+void EnRu1_PlayThrowSfx(EnRu1* this) {
     if (this->actor.speedXZ != 0.0f) {
         Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_VO_RT_THROW);
     }
@@ -1798,7 +1799,7 @@ void EnRu1_UpdateCarriedBehavior(EnRu1* this, PlayState* play) {
         this->actor.velocity.y *= (kREG(26) * 0.01f) + 1.0f;
         this->actor.minVelocityY = -((kREG(24) * 0.01f) + 6.8f);
         this->actor.gravity = -((kREG(23) * 0.01f) + 1.3f);
-        func_80AED57C(this);
+        EnRu1_PlayThrowSfx(this);  // was func_80AED57C [LLM:HIGH]
         this->action = 28;
         *unk_370 = 0.0f;
         return;
@@ -2118,7 +2119,7 @@ void EnRu1_LookUpAtSapphire(EnRu1* this) {
         if (curFrame >= 60.0f) {
             EnRu1_SetEyeIndex(this, 3);
             EnRu1_SetMouthIndex(this, 0);
-            func_80AED57C(this);
+            EnRu1_PlayThrowSfx(this);  // was func_80AED57C [LLM:HIGH]
             sReachedForSapphire = 1;
         }
     }
