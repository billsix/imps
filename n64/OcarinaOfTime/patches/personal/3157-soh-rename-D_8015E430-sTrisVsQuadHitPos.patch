From 51fea2ed91f6ad9e2676ba5da8b12a0fdf7207fd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:49 +0000
Subject: [PATCH 3157/3799] soh: rename D_8015E430 -> sTrisVsQuadHitPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hit position CollisionCheck_AC_TrisVsQuad reports
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index 15b2ae208..4cdc1de6d 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2360,7 +2360,7 @@ static s8 sBssDummy10;
  * AC overlap check. Calculates the center of each collider element and the point of contact.
  */
 void CollisionCheck_AC_TrisVsQuad(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT, Collider* colAC) {
-    static Vec3f D_8015E430;
+    static Vec3f sTrisVsQuadHitPos;  // was D_8015E430 [LLM:HIGH]
     static TriNorm D_8015E440;
     static TriNorm D_8015E478;
     ColliderTris* at = (ColliderTris*)colAT;
@@ -2380,8 +2380,8 @@ void CollisionCheck_AC_TrisVsQuad(PlayState* play, CollisionCheckContext* colChk
             if (CollisionCheck_NoSharedFlags(&atItem->info, &ac->info) == 1) {
                 continue;
             }
-            if (Math3D_TriVsTriIntersect(&D_8015E440, &atItem->dim, &D_8015E430) == 1 ||
-                Math3D_TriVsTriIntersect(&D_8015E478, &atItem->dim, &D_8015E430) == 1) {
+            if (Math3D_TriVsTriIntersect(&D_8015E440, &atItem->dim, &sTrisVsQuadHitPos) == 1 ||  // was D_8015E430 [LLM:HIGH]
+                Math3D_TriVsTriIntersect(&D_8015E478, &atItem->dim, &sTrisVsQuadHitPos) == 1) {  // was D_8015E430 [LLM:HIGH]
                 Vec3f atPos;
                 Vec3f acPos;
 
@@ -2392,7 +2392,7 @@ void CollisionCheck_AC_TrisVsQuad(PlayState* play, CollisionCheckContext* colChk
                 acPos.y = (ac->dim.quad[0].y + (ac->dim.quad[1].y + (ac->dim.quad[3].y + ac->dim.quad[2].y))) / 4.0f;
                 acPos.z = (ac->dim.quad[0].z + (ac->dim.quad[1].z + (ac->dim.quad[3].z + ac->dim.quad[2].z))) / 4.0f;
                 CollisionCheck_SetATvsAC(play, &at->base, &atItem->info, &atPos, &ac->base, &ac->info, &acPos,
-                                         &D_8015E430);
+                                         &sTrisVsQuadHitPos);  // was D_8015E430 [LLM:HIGH]
                 return;
             }
         }
