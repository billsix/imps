Subject: [PATCH 3557/3799] soh: rename func_80B4EA40 -> EnZl2_ShutEyesToEye5

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: steps the eye texture 0, 1, 2 then holds at index 5, one step per frame
Defined in soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c b/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
index 8de3fbf85..5dfeb6246 100644
--- a/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
+++ b/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
@@ -157,7 +157,8 @@ void EnZl2_UpdateEyes(EnZl2* this) {
     *eyeTexIndex2 = *eyeTexIndex;
 }
 
-void func_80B4EA40(EnZl2* this) {
+// LLM generated name (HIGH), was func_80B4EA40: steps the eye texture 0, 1, 2 then holds at index 5, one step per frame
+void EnZl2_ShutEyesToEye5(EnZl2* this) {
     s16* eyeTexIndex = &this->eyeTexIndex;
     f32* unk_27C = &this->unk_27C;
 
@@ -1072,7 +1073,7 @@ void EnZl2_Action4(EnZl2* this, PlayState* play) {
 void EnZl2_Action5(EnZl2* this, PlayState* play) {
     func_80B4FCCC(this, play);
     func_80B4ED2C(this, play);
-    func_80B4EA40(this);
+    EnZl2_ShutEyesToEye5(this);  // was func_80B4EA40 [LLM:HIGH]
     EnZl2_SetupAction6OnAnimDone(this, EnZl2_UpdateSkelAnime(this));  // was func_80B50488 [LLM:HIGH]
 }
 
@@ -1261,7 +1262,7 @@ void func_80B51418(EnZl2* this, PlayState* play) {
 }
 
 void func_80B5146C(EnZl2* this, PlayState* play) {
-    func_80B4EA40(this);
+    EnZl2_ShutEyesToEye5(this);  // was func_80B4EA40 [LLM:HIGH]
     EnZl2_setMouthIndex(this, 0);
 }
 
