Subject: [PATCH 3146/3799] soh: rename D_8015E268 -> sJntSphVsQuadTri1

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the second triangle of that same split
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index 521508920..f124fcc4f 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2011,7 +2011,7 @@ void CollisionCheck_AC_TrisVsJntSph(PlayState* play, CollisionCheckContext* colC
 void CollisionCheck_AC_JntSphVsQuad(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT,
                                     Collider* colAC) {
     static TriNorm sJntSphVsQuadTri0;  // was D_8015E230 [LLM:HIGH]
-    static TriNorm D_8015E268;
+    static TriNorm sJntSphVsQuadTri1;  // was D_8015E268 [LLM:HIGH]
     ColliderJntSph* at = (ColliderJntSph*)colAT;
     ColliderQuad* ac = (ColliderQuad*)colAC;
     Vec3f hitPos;
@@ -2022,7 +2022,7 @@ void CollisionCheck_AC_JntSphVsQuad(PlayState* play, CollisionCheckContext* colC
             return;
         }
         Math3D_TriNorm(&sJntSphVsQuadTri0, &ac->dim.quad[2], &ac->dim.quad[3], &ac->dim.quad[1]);  // was D_8015E230 [LLM:HIGH]
-        Math3D_TriNorm(&D_8015E268, &ac->dim.quad[1], &ac->dim.quad[0], &ac->dim.quad[2]);
+        Math3D_TriNorm(&sJntSphVsQuadTri1, &ac->dim.quad[1], &ac->dim.quad[0], &ac->dim.quad[2]);  // was D_8015E268 [LLM:HIGH]
         for (atItem = at->elements; atItem < at->elements + at->count; atItem++) {
             if (CollisionCheck_SkipTouch(&atItem->info) == 1) {
                 continue;
@@ -2031,7 +2031,7 @@ void CollisionCheck_AC_JntSphVsQuad(PlayState* play, CollisionCheckContext* colC
                 continue;
             }
             if (Math3D_TriVsSphIntersect(&atItem->dim.worldSphere, &sJntSphVsQuadTri0, &hitPos) == 1 ||  // was D_8015E230 [LLM:HIGH]
-                Math3D_TriVsSphIntersect(&atItem->dim.worldSphere, &D_8015E268, &hitPos) == 1) {
+                Math3D_TriVsSphIntersect(&atItem->dim.worldSphere, &sJntSphVsQuadTri1, &hitPos) == 1) {  // was D_8015E268 [LLM:HIGH]
                 Vec3f atPos;
                 Vec3f acPos;
 
