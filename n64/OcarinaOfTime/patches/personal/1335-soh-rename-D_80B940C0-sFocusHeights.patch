From 7b37c0878c81e096b728fc52df3c1864c1460040 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:10:55 +0000
Subject: [PATCH 1335/3799] soh: rename D_80B940C0 -> sFocusHeights

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the Actor_SetFocus height for each params variant.
Defined in soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c b/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
index f3756b5c9..a61b1f785 100644
--- a/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
+++ b/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
@@ -39,7 +39,8 @@ const ActorInit Obj_Hsblock_InitVars = {
     NULL,
 };
 
-static f32 D_80B940C0[] = { 85.0f, 85.0f, 0.0f };
+// LLM generated name (HIGH), was D_80B940C0: the Actor_SetFocus height for each params variant.
+static f32 sFocusHeights[] = { 85.0f, 85.0f, 0.0f };  // was D_80B940C0 [LLM:HIGH]
 
 static InitChainEntry sInitChain[] = {
     ICHAIN_VEC3F_DIV1000(scale, 100, ICHAIN_CONTINUE),
@@ -149,7 +150,7 @@ void ObjHsblock_Update(Actor* thisx, PlayState* play) {
     if (this->actionFunc != NULL) {
         this->actionFunc(this, play);
     }
-    Actor_SetFocus(thisx, D_80B940C0[thisx->params & 3]);
+    Actor_SetFocus(thisx, sFocusHeights[thisx->params & 3]);  // was D_80B940C0 [LLM:HIGH]
 }
 
 void ObjHsblock_Draw(Actor* thisx, PlayState* play) {
-- 
