From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:44 +0000
Subject: [PATCH 0434/3799] soh: rename func_80AEC4CC ->
 EnRu1_MoveForwardConstant

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 6032316c7..15197e91b 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -823,7 +823,8 @@ void EnRu1_AccelerateAway(EnRu1* this) {
     Actor_MoveXZGravity(&this->actor);
 }
 
-void func_80AEC4CC(EnRu1* this) {
+// Name from zeldaret/oot (was func_80AEC4CC): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_MoveForwardConstant(EnRu1* this) {
     this->actor.velocity.y = -1.0f;
     Actor_MoveXZGravity(&this->actor);
 }
@@ -990,7 +991,7 @@ void func_80AECB60(EnRu1* this, PlayState* play) {
 }
 
 void func_80AECBB8(EnRu1* this, PlayState* play) {
-    func_80AEC4CC(this);
+    EnRu1_MoveForwardConstant(this);
     func_80AEC6E4(this, play);
     EnRu1_UpdateSkelAnime(this);
     EnRu1_UpdateEyes(this);
