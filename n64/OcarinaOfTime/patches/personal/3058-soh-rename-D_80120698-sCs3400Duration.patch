From fb821a815535c15f65f573226666f82c74518e77 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:36 +0000
Subject: [PATCH 3058/3799] soh: rename D_80120698 -> sCs3400Duration

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the duration argument for 3400
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 4 ++--
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 28d53a547..705e72c9b 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -691,14 +691,14 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
         case 3400:
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Player_SetCsAction(play, &player->actor, 8);
-            OnePointCutscene_SetCsCamPoints(csCam, D_8012069C | 0x2000, D_80120698, sCs3400AtPoints, sCs3400EyePoints);  // was D_801204D4 [LLM:HIGH]
+            OnePointCutscene_SetCsCamPoints(csCam, D_8012069C | 0x2000, sCs3400Duration, sCs3400AtPoints, sCs3400EyePoints);  // was D_801204D4 [LLM:HIGH]
             OnePointCutscene_Vec3sToVec3f(&mainCam->eye, &sCs3400EyePoints[sCs3400PointCount - 2].pos);  // was D_801205B4 [LLM:HIGH]
             OnePointCutscene_Vec3sToVec3f(&mainCam->at, &sCs3400AtPoints[sCs3400PointCount - 2].pos);  // was D_801204D4 [LLM:HIGH]
 
             i = Quake_Add(csCam, 1);
             Quake_SetSpeed(i, 0x4E20);
             Quake_SetQuakeValues(i, 1, 0, 50, 0);
-            Quake_SetCountdown(i, D_80120698 - 20);
+            Quake_SetCountdown(i, sCs3400Duration - 20);  // was D_80120698 [LLM:HIGH]
             break;
         case 3390:
             player->actor.shape.rot.y = player->actor.world.rot.y = player->yaw = -0x3FD9;
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 2240ba417..21e0861a8 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -101,7 +101,8 @@ static CutsceneCameraPoint sCs3400EyePoints[14] = {  // was D_801205B4 [LLM:HIGH
 };
 // LLM generated name (HIGH), was D_80120694: the number of points in those arrays
 static s16 sCs3400PointCount = 14;  // was D_80120694 [LLM:HIGH]
-static s16 D_80120698 = 190;
+// LLM generated name (HIGH), was D_80120698: the duration argument for 3400
+static s16 sCs3400Duration = 190;  // was D_80120698 [LLM:HIGH]
 static s16 D_8012069C = 8;
 
 static CutsceneCameraPoint D_801206A0[12] = {
-- 
2.55.0

