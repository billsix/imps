From 84e543a7b0967237c5e0a0633bee43a23eba1cf5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:21 +0000
Subject: [PATCH 0095/3799] soh: rename func_8006BE88 ->
 ElfMessage_CheckConditionsAnd

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/z_elf_message.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/z_elf_message.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_elf_message.c b/soh/src/code/z_elf_message.c
index 42c11319a..516d4b3cb 100644
--- a/soh/src/code/z_elf_message.c
+++ b/soh/src/code/z_elf_message.c
@@ -66,7 +66,8 @@ u32 ElfMessage_CheckCondition(ElfMessage* msg) {
     return false;
 }
 
-u32 func_8006BE88(ElfMessage** msgp) {
+// LLM generated name (HIGH), was func_8006BE88: ANDs a run of ELF_MSG_TYPE_UNK_1 conditions, false if any fails.
+u32 ElfMessage_CheckConditionsAnd(ElfMessage** msgp) {
     u32 temp = true;
 
     while (((*msgp)->byte0 & 0xE0) == (ELF_MSG_TYPE_UNK_1 << 5)) {
@@ -125,7 +126,7 @@ u16 ElfMessage_GetTextFromMsgs(ElfMessage* msg) {
                 }
                 break;
             case (ELF_MSG_TYPE_UNK_1 << 5):
-                if (func_8006BE88(&msg)) {
+                if (ElfMessage_CheckConditionsAnd(&msg)) {
                     return msg->byte2 | 0x100;
                 }
                 break;
