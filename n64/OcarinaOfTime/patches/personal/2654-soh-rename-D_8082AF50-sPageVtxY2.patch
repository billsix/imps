From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:41 +0000
Subject: [PATCH 2654/3799] soh: rename D_8082AF50 -> sPageVtxY2

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the Y offsets in slot 2 of the sPageVtxY table
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 681295c2a..80cb62920 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2661,7 +2661,8 @@ static s16 sPageVtxY1[] = {  // was D_8082AF4C [LLM:HIGH]
     0x0000,
     0x0000,
 };
-static s16 D_8082AF50[] = {
+// LLM generated name (HIGH), was D_8082AF50: the Y offsets in slot 2 of the sPageVtxY table
+static s16 sPageVtxY2[] = {  // was D_8082AF50 [LLM:HIGH]
     0x001C, 0x001C, 0x002E, 0x001C, 0xFFFE, 0xFFE0, 0x0032, 0x0024, 0x0016,
     0x0008, 0xFFFA, 0xFFEC, 0xFFDE, 0xFFD0, 0x0012, 0x0012, 0x0032, 0x0000,
 };
@@ -2706,7 +2707,7 @@ static s16* D_8082B018[] = {
 };
 
 static s16* D_8082B030[] = {
-    sPageVtxY0, sPageVtxY1, D_8082AF50, D_8082AF74, D_8082AF78, D_8082AFB8,  // was D_8082AF48 [LLM:HIGH]
+    sPageVtxY0, sPageVtxY1, sPageVtxY2, D_8082AF74, D_8082AF78, D_8082AFB8,  // was D_8082AF48 [LLM:HIGH]
 };
 
 static s16* D_8082B048[] = {
