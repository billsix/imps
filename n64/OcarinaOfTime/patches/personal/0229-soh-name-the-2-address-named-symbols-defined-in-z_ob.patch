+            Math_Vec3f_Copy(&this->actor.home.pos, &sFlagSetPos);  // was D_80B97F68 [LLM:GUESS]
         }
         this->actor.shape.rot.x = -0x4000;
         this->actor.shape.rot.z = 0;
