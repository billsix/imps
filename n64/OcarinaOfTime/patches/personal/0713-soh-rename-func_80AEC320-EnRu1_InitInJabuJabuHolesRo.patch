     EnRu1_EndGivingSapphire(this, play, something);
 }
 
-void func_80AEC320(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEC320): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.96. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_InitInJabuJabuHolesRoom(EnRu1* this, PlayState* play) {
     s8 actorRoom;
 
     if (!Flags_GetInfTable(INFTABLE_RUTO_IN_JJ_MEET_RUTO)) {
@@ -2393,7 +2394,7 @@ void EnRu1_Init(Actor* thisx, PlayState* play) {
             EnRu1_InitOutsideJabuJabu(this, play);
             break;
         case 2:
-            func_80AEC320(this, play);
+            EnRu1_InitInJabuJabuHolesRoom(this, play);
             break;
         case 3:
             func_80AED44C(this, play);
