From 3fe3f7d65bea7b323d1822481c1579c020822130 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:08 +0000
Subject: [PATCH 597/784] soh: rename func_80064824 -> CutsceneCmd_Misc

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 0.95.
Defined in soh/src/code/z_demo.c.
---
 soh/src/code/z_demo.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_demo.c b/soh/src/code/z_demo.c
index fcff59cb1..6cdbc963f 100644
--- a/soh/src/code/z_demo.c
+++ b/soh/src/code/z_demo.c
@@ -225,7 +225,8 @@ void CutsceneHandler_StartScript(PlayState* play, CutsceneContext* csCtx) {
 }
 
 // Command 3: Misc. Actions
-void func_80064824(PlayState* play, CutsceneContext* csCtx, CsCmdBase* cmd) {
+// Name from zeldaret/oot (was func_80064824): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.95. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_demo.c]
+void CutsceneCmd_Misc(PlayState* play, CutsceneContext* csCtx, CsCmdBase* cmd) {
     Player* player = GET_PLAYER(play);
     f32 temp;
     u8 sp3F = 0;
@@ -1758,7 +1759,7 @@ void Cutscene_ProcessCommands(PlayState* play, CutsceneContext* csCtx, u8* cutsc
                 memcpy(&cmdEntries, cutscenePtr, sizeof(CutsceneData));
                 cutscenePtr += sizeof(CutsceneData);
                 for (j = 0; j < cmdEntries; j++) {
-                    func_80064824(play, csCtx, (void*)cutscenePtr);
+                    CutsceneCmd_Misc(play, csCtx, (void*)cutscenePtr);
                     cutscenePtr += sizeof(CutsceneData) * 12;
                 }
                 break;
