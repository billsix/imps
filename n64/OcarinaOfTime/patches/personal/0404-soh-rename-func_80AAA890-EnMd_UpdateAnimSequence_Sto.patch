+++ b/soh/src/overlays/actors/ovl_En_Md/z_en_md.c
@@ -254,7 +254,8 @@ void EnMd_UpdateAnimSequence_IdleToAnnoyed(EnMd* this) {
     }
 }
 
-void func_80AAA890(EnMd* this) {
+// Name from zeldaret/oot (was func_80AAA890): adopted upstream's name for this address; body verified to match upstream at 0.89. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Md/z_en_md.c]
+void EnMd_UpdateAnimSequence_StopWalking(EnMd* this) {
     switch (this->animSequenceEntry) {
         case 0:
             Animation_ChangeByInfo(&this->skelAnime, sAnimationInfo, ENMD_ANIM_7);
@@ -306,7 +307,7 @@ void EnMd_UpdateAnimSequence(EnMd* this) {
             EnMd_UpdateAnimSequence_IdleToAnnoyed(this);
             break;
         case 11:
-            func_80AAA890(this);
+            EnMd_UpdateAnimSequence_StopWalking(this);
     }
 }
 
