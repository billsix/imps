+    EnOwl_ChangeMode(this, EnOwl_Perched, func_80ACC540, &this->skelAnime, &gOwlUnfoldWingsAnim, 0.0f);  // was func_80ACBEA0 [LLM:HIGH]
     this->eyeTexIndex = 0;
     this->blinkTimer = Rand_S16Offset(60, 60);
 }
@@ -925,7 +926,7 @@ void EnOwl_Takeoff(EnOwl* this, PlayState* play) {
     this->actionFlags |= 8;
 }
 
-void func_80ACBEA0(EnOwl* this, PlayState* PlayState) {
+void EnOwl_Perched(EnOwl* this, PlayState* PlayState) {
     if (this->actionFlags & 1) {
         this->unk_3FE = 3;
         EnOwl_ChangeMode(this, EnOwl_Takeoff, func_80ACC540, &this->skelAnime, &gOwlTakeoffAnim, 0.0f);  // was func_80ACBD4C [LLM:HIGH]
