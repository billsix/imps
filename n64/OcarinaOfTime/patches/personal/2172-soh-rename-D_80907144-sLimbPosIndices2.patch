+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -2772,7 +2772,7 @@ void func_8090523C(BossGanon2* this, PlayState* play) {
 }
 
 void BossGanon2_PostLimbDraw2(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
-    s8 temp_v1 = D_80907144[limbIndex];
+    s8 temp_v1 = sLimbPosIndices2[limbIndex];  // was D_80907144 [LLM:HIGH]
     BossGanon2* this = (BossGanon2*)thisx;
 
     if (temp_v1 >= 0) {
