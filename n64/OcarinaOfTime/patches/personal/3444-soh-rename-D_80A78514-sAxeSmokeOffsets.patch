From 8bfb2d50e773ae0a6ea07ff4cc74075303830a8a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:11 +0000
Subject: [PATCH 3444/3799] soh: rename D_80A78514 -> sAxeSmokeOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the points EnIk_SpawnAxeSmoke puffs smoke from
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index d2820e5b3..92d1c6b2d 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -1058,7 +1058,7 @@ void EnIk_PlayAxeSummonSfx(EnIk* this, PlayState* play, Vec3f* pos) {
 
 // Name from zeldaret/oot (was func_80A76E2C): adopted upstream's name for this address; body verified to match upstream at 0.88. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ik/z_en_ik.c]
 void EnIk_SpawnAxeSmoke(EnIk* this, PlayState* play, Vec3f* pos) {
-    static Vec3f D_80A78514[] = {
+    static Vec3f sAxeSmokeOffsets[] = {  // was D_80A78514 [LLM:HIGH]
         { 1000.0, -1000.0, 1000.0 },  { 0.0, -1000.0, 0.0 },        { -1000.0, -5000.0, -4000.0 },
         { 1000.0, -5000.0, -3000.0 }, { -1000.0, 1000.0, -6000.0 }, { -1000.0, 3000.0, -5000.0 },
         { -800.0, 1000.0, -3000.0 },  { 0.0, -4000.0, -2000.0 },    { -1000.0, -2000.0, -6000.0 },
@@ -1074,13 +1074,13 @@ void EnIk_SpawnAxeSmoke(EnIk* this, PlayState* play, Vec3f* pos) {
         Vec3f effectAccel = { 0.0f, 0.3f, 0.0f };
         s32 i;
 
-        for (i = ARRAY_COUNT(D_80A78514) - 1; i >= 0; i--) {
+        for (i = ARRAY_COUNT(sAxeSmokeOffsets) - 1; i >= 0; i--) {  // was D_80A78514 [LLM:HIGH]
             Color_RGBA8 primColor = { 200, 200, 200, 255 };
             Color_RGBA8 envColor = { 150, 150, 150, 0 };
             s32 temp_v0;
             Vec3f effectPos;
 
-            Matrix_MultVec3f(&D_80A78514[i], &effectPos);
+            Matrix_MultVec3f(&sAxeSmokeOffsets[i], &effectPos);  // was D_80A78514 [LLM:HIGH]
             temp_v0 = (Rand_ZeroOne() * 20.0f) - 10.0f;
             primColor.r += temp_v0;
             primColor.g += temp_v0;
-- 
2.55.0

