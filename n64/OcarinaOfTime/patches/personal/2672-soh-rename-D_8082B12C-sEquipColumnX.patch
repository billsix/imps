From 35474025c5ca3c0c75105b706c9f621fbec4d1fe Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:43 +0000
Subject: [PATCH 2672/3799] soh: rename D_8082B12C -> sEquipColumnX

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the X position of each of the four equipment columns
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 009c7825a..7b74ee486 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -3023,7 +3023,8 @@ static s16 sEquipVtxIndices[] = { 0, 4, 8, 12, 24, 32, 56 };  // was D_8082B11C
 static s16 D_8082B11C_all[] = { 0,  4,  8,  12, 16, 20, 24, 28, 32, 36, 40, 44,
                                 48, 52, 56, 60, 64, 68, 72, 76, 80, 84, 88, 96 };
 
-static s16 D_8082B12C[] = { -114, 12, 44, 76 };
+// LLM generated name (HIGH), was D_8082B12C: the X position of each of the four equipment columns
+static s16 sEquipColumnX[] = { -114, 12, 44, 76 };  // was D_8082B12C [LLM:HIGH]
 
 static u8 D_8082B134[] = { 1, 5, 9, 13 };
 
@@ -3298,7 +3299,7 @@ void KaleidoScope_InitVertices(PlayState* play, GraphicsContext* gfxCtx) {
 
     for (phi_t4 = 0, phi_t2 = 0, phi_t5 = 58; phi_t2 < 4; phi_t2++, phi_t5 -= 32) {
         for (phi_t3 = 0; phi_t3 < 4; phi_t3++, phi_t4 += 4) {
-            pauseCtx->equipVtx[phi_t4 + 0].v.ob[0] = pauseCtx->equipVtx[phi_t4 + 2].v.ob[0] = D_8082B12C[phi_t3] + 2;
+            pauseCtx->equipVtx[phi_t4 + 0].v.ob[0] = pauseCtx->equipVtx[phi_t4 + 2].v.ob[0] = sEquipColumnX[phi_t3] + 2;  // was D_8082B12C [LLM:HIGH]
 
             pauseCtx->equipVtx[phi_t4 + 1].v.ob[0] = pauseCtx->equipVtx[phi_t4 + 3].v.ob[0] =
                 pauseCtx->equipVtx[phi_t4 + 0].v.ob[0] + 28;
