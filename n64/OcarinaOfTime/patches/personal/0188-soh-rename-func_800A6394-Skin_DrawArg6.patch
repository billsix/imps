 void Skin_Draw(Actor* actor, PlayState* play, Skin* skin, SkinPostDraw postDraw, s32 setTranslation);  // was func_800A6330 [LLM:HIGH]
 void Skin_DrawOverrideLimb(Actor* actor, PlayState* play, Skin* skin, SkinPostDraw postDraw, SkinOverrideLimbDraw overrideLimbDraw, s32 setTranslation);  // was func_800A6360 [LLM:HIGH]
-void func_800A6394(Actor* actor, PlayState* play, Skin* skin, SkinPostDraw postDraw, SkinOverrideLimbDraw overrideLimbDraw, s32 setTranslation, s32 arg6);
+void Skin_DrawArg6(Actor* actor, PlayState* play, Skin* skin, SkinPostDraw postDraw, SkinOverrideLimbDraw overrideLimbDraw, s32 setTranslation, s32 arg6);  // was func_800A6394 [LLM:GUESS]
 void Skin_DrawAll(Actor* actor, PlayState* play, Skin* skin, SkinPostDraw postDraw, SkinOverrideLimbDraw overrideLimbDraw, s32 setTranslation, s32 arg6, s32 drawFlags);  // was func_800A63CC [LLM:GUESS]
 void Skin_GetLimbPos(Skin* skin, s32 limbIndex, Vec3f* arg2, Vec3f* dst);
 void Skin_Init(PlayState* play, Skin* skin, SkeletonHeader* skeletonHeader, AnimationHeader* animationHeader);
diff --git a/soh/src/code/z_skin.c b/soh/src/code/z_skin.c
index 6c36d6179..1e6e9bb26 100644
--- a/soh/src/code/z_skin.c
+++ b/soh/src/code/z_skin.c
@@ -252,7 +252,8 @@ void Skin_DrawOverrideLimb(Actor* actor, PlayState* play, Skin* skin, SkinPostDr
 }
 
 // allows specifying OverrideLimbDraw, PostLimbDraw, setTranslation, and arg6
-void func_800A6394(Actor* actor, PlayState* play, Skin* skin, SkinPostDraw postDraw,
+// LLM generated name (GUESS), was func_800A6394: fourth Skin_DrawImpl wrapper; like its siblings it is named for the parameter it adds over the previous one, but arg6's meaning is still unidentified so the name describes the signature, not the behaviour.
+void Skin_DrawArg6(Actor* actor, PlayState* play, Skin* skin, SkinPostDraw postDraw,
                    SkinOverrideLimbDraw overrideLimbDraw, s32 setTranslation, s32 arg6) {
     Skin_DrawImpl(actor, play, skin, postDraw, overrideLimbDraw, setTranslation, arg6, 0);
 }
