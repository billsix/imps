From 36b8ef1a499c5a91201a30e96243bd5139dd1089 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:39 +0000
Subject: [PATCH 3093/3799] soh: rename D_80121D3C -> sCs3240KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 3240 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 6 +++---
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 6587c98f6..d2d9ceba0 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -31,7 +31,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs3020KeyFrames)                                   \
     F(sCs3010KeyFrames)                                   \
     F(sCs3140KeyFrames)                                   \
-    F(D_80121D3C)                                   \
+    F(sCs3240KeyFrames)                                   \
     F(D_80121F1C)                                   \
     F(D_80121FBC)                                   \
     F(D_801220D4)                                   \
@@ -665,9 +665,9 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
             break;
         case 3240:
-            D_80121D3C[2].timerInit = timer - 5;
+            sCs3240KeyFrames[2].timerInit = timer - 5;  // was D_80121D3C [LLM:HIGH]
 
-            csInfo->keyFrames = D_80121D3C;
+            csInfo->keyFrames = sCs3240KeyFrames;  // was D_80121D3C [LLM:HIGH]
             csInfo->keyFrameCnt = 3;
 
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 377052378..acebfe46d 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -390,7 +390,8 @@ static OnePointCsFull sCs3140KeyFrames[7] = {  // was D_80121C24 [LLM:HIGH]
     { 0x11, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80121D3C[3] = {
+// LLM generated name (HIGH), was D_80121D3C: the keyframe set one-point cutscene 3240 installs
+static OnePointCsFull sCs3240KeyFrames[3] = {  // was D_80121D3C [LLM:HIGH]
     { 0x0F, 0xFF, 0x0101, 1, 0, 60.0f, 1.0f, { 1023.0f, 738.0f, -2628.0f }, { 993.0f, 770.0f, -2740.0f } },
     { 0x02, 0xFF, 0x0101, 4, 0, 50.0f, 1.0f, { 1255.0f, 350.0f, -1870.0f }, { 1240.0f, 575.0f, -2100.0f } },
     { 0x0F, 0xFF, 0x0000, -1, 0, 75.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
