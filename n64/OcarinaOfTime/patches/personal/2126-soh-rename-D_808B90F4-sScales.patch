From 0aa51ecf5a939666f2f0bf3f42796cfd49d5fef3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:12:55 +0000
Subject: [PATCH 2126/3799] soh: rename D_808B90F4 -> sScales

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-type scale applied by BgSpot18Obj_InitScale
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
index 818680003..9bc92d6f4 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
@@ -60,7 +60,8 @@ const ActorInit Bg_Spot18_Obj_InitVars = {
 // LLM generated name (HIGH), was D_808B90F0: per-type, per-age flag read by BgSpot18Obj_ShouldSpawn
 static u8 sSpawnByAge[2][2] = { { 0x01, 0x01 }, { 0x01, 0x00 } };  // was D_808B90F0 [LLM:HIGH]
 
-static f32 D_808B90F4[] = {
+// LLM generated name (HIGH), was D_808B90F4: per-type scale applied by BgSpot18Obj_InitScale
+static f32 sScales[] = {  // was D_808B90F4 [LLM:HIGH]
     0.1f,
     0.1f,
 };
@@ -135,7 +136,7 @@ s32 BgSpot18Obj_ShouldSpawn(BgSpot18Obj* this, PlayState* play) {
 }
 
 s32 BgSpot18Obj_InitScale(BgSpot18Obj* this, PlayState* play) {
-    Actor_SetScale(&this->dyna.actor, D_808B90F4[this->dyna.actor.params & 0xF]);
+    Actor_SetScale(&this->dyna.actor, sScales[this->dyna.actor.params & 0xF]);  // was D_808B90F4 [LLM:HIGH]
     return 1;
 }
 
