+s16 EnZl4_UpdateTalkState(PlayState* play, Actor* thisx) {
     EnZl4* this = (EnZl4*)thisx;
 
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_CLOSING) {
@@ -1204,7 +1205,7 @@ void EnZl4_Cutscene(EnZl4* this, PlayState* play) {
 
