From 5ed362319f7c94b8f7a31ad759ada9bfebf3634a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:35 +0000
Subject: [PATCH 3049/3799] soh: rename D_80120308 -> sCs9601AtPoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the at points for one-point cutscenes 9601 and 9602
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 8 ++++----
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 7452bb957..5aaa39cdf 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -370,17 +370,17 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
         case 9601:
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Play_CameraChangeSetting(play, CAM_ID_MAIN, mainCam->prevSetting);
-            if (GameInteractor_Should(VB_CRAWL_SPEED_EXIT_CS, true, csCam, csId, D_80120430, D_8012042C, D_80120308,
+            if (GameInteractor_Should(VB_CRAWL_SPEED_EXIT_CS, true, csCam, csId, D_80120430, D_8012042C, sCs9601AtPoints,  // was D_80120308 [LLM:HIGH]
                                       D_80120398)) {
-                OnePointCutscene_SetCsCamPoints(csCam, D_80120430 | 0x1000, D_8012042C, D_80120308, D_80120398);
+                OnePointCutscene_SetCsCamPoints(csCam, D_80120430 | 0x1000, D_8012042C, sCs9601AtPoints, D_80120398);  // was D_80120308 [LLM:HIGH]
             }
             break;
         case 9602:
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Play_CameraChangeSetting(play, CAM_ID_MAIN, mainCam->prevSetting);
-            if (GameInteractor_Should(VB_CRAWL_SPEED_EXIT_CS, true, csCam, csId, D_80120430, D_8012042C, D_80120308,
+            if (GameInteractor_Should(VB_CRAWL_SPEED_EXIT_CS, true, csCam, csId, D_80120430, D_8012042C, sCs9601AtPoints,  // was D_80120308 [LLM:HIGH]
                                       D_80120434)) {
-                OnePointCutscene_SetCsCamPoints(csCam, D_80120430 | 0x1000, D_8012042C, D_80120308, D_80120434);
+                OnePointCutscene_SetCsCamPoints(csCam, D_80120430 | 0x1000, D_8012042C, sCs9601AtPoints, D_80120434);  // was D_80120308 [LLM:HIGH]
             }
             break;
         case 4175:
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 73729dcae..6c1057ce3 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -34,7 +34,8 @@ static s16 sCs3050Duration = 210;  // was D_80120300 [LLM:HIGH]
 // LLM generated name (HIGH), was D_80120304: the flags argument, ORed with 0x2000 at the call
 static s16 sCs3050Flags = 0;  // was D_80120304 [LLM:HIGH]
 
-static CutsceneCameraPoint D_80120308[9] = {
+// LLM generated name (HIGH), was D_80120308: the at points for one-point cutscenes 9601 and 9602
+static CutsceneCameraPoint sCs9601AtPoints[9] = {  // was D_80120308 [LLM:HIGH]
     { CS_CMD_CONTINUE, 0, 10, 40.0f, { 0, 4, 0 } },  { CS_CMD_CONTINUE, 0, 10, 40.000004f, { 0, 4, 0 } },
     { CS_CMD_CONTINUE, 0, 10, 50.0f, { 0, 9, 0 } },  { CS_CMD_CONTINUE, 0, 12, 55.0f, { 0, 12, 0 } },
     { CS_CMD_CONTINUE, 0, 15, 61.0f, { 0, 18, 0 } }, { CS_CMD_CONTINUE, 0, 20, 65.0f, { 0, 29, 0 } },
-- 
