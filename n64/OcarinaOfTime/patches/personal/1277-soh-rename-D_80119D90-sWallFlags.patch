From bbdf4a09c713c15872163e7e4b618a76dce810ae Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:07:17 +0000
Subject: [PATCH 1277/3799] soh: rename D_80119D90 -> sWallFlags

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment above it reads "SurfaceType_GetWallFlags, SurfaceType wall types"; it maps each WALL_TYPE to the WALL_FLAG bits SurfaceType_GetWallFlags returns.
Defined in soh/src/code/z_bgcheck.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_bgcheck.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_bgcheck.c b/soh/src/code/z_bgcheck.c
index a855c17e4..2b8ecfd2f 100644
--- a/soh/src/code/z_bgcheck.c
+++ b/soh/src/code/z_bgcheck.c
@@ -30,7 +30,8 @@
 #define COLPOLY_IGNORE_PROJECTILES (1 << 2)
 
 // SurfaceType_GetWallFlags, SurfaceType wall types
-s32 D_80119D90[WALL_TYPE_MAX] = {
+// LLM generated name (HIGH), was D_80119D90: the in-tree comment above it reads "SurfaceType_GetWallFlags, SurfaceType wall types"; it maps each WALL_TYPE to the WALL_FLAG bits SurfaceType_GetWallFlags returns.
+s32 sWallFlags[WALL_TYPE_MAX] = {  // was D_80119D90 [LLM:HIGH]
     0,                                  // WALL_TYPE_0
     WALL_FLAG_0,                        // WALL_TYPE_1
     WALL_FLAG_0 | WALL_FLAG_LADDER,     // WALL_TYPE_2
@@ -4034,9 +4035,9 @@ u32 SurfaceType_GetWallType(CollisionContext* colCtx, CollisionPoly* poly, s32 b
  */
 s32 SurfaceType_GetWallFlags(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
     if (GameInteractor_Should(VB_SURFACE_IS_CLIMBABLE, false)) {
-        return WALL_FLAG_CLIMBABLE | D_80119D90[SurfaceType_GetWallType(colCtx, poly, bgId)];
+        return WALL_FLAG_CLIMBABLE | sWallFlags[SurfaceType_GetWallType(colCtx, poly, bgId)];  // was D_80119D90 [LLM:HIGH]
     } else {
-        return D_80119D90[SurfaceType_GetWallType(colCtx, poly, bgId)];
+        return sWallFlags[SurfaceType_GetWallType(colCtx, poly, bgId)];  // was D_80119D90 [LLM:HIGH]
     }
 }
 
