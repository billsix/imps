From 300c1016661f70510552733ba6afba8c1b283e08 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:17 +0000
Subject: [PATCH 1800/3799] soh: rename D_8012AD40 -> sRoomQuadIndices

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the 0x40 vertex indices, four per quad, that stitch a room-skybox face into sixteen quads.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 568f3a6f7..c61e08f71 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -101,7 +101,8 @@ s16 sRoomVtxV[9] = {  // was D_8012AD2C [LLM:HIGH]
     0x0000, 0x07C0, 0x0F80, 0x1740, 0x1F00, 0x26C0, 0x2E80, 0x3640, 0x3E00,
 };
 
-s16 D_8012AD40[0x40] = {
+// LLM generated name (HIGH), was D_8012AD40: the 0x40 vertex indices, four per quad, that stitch a room-skybox face into sixteen quads.
+s16 sRoomQuadIndices[0x40] = {  // was D_8012AD40 [LLM:HIGH]
     0x00, 0x10, 0x13, 0x12, 0x10, 0x01, 0x14, 0x13, 0x01, 0x11, 0x15, 0x14, 0x11, 0x05, 0x16, 0x15,
     0x12, 0x13, 0x17, 0x02, 0x13, 0x14, 0x03, 0x17, 0x14, 0x15, 0x18, 0x03, 0x15, 0x16, 0x07, 0x18,
     0x02, 0x17, 0x1A, 0x19, 0x17, 0x03, 0x1B, 0x1A, 0x03, 0x18, 0x1C, 0x1B, 0x18, 0x07, 0x1D, 0x1C,
@@ -259,8 +260,8 @@ s32 func_800ADBB0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                                    phi_a0_4, phi_a2_4, phi_a0_4 + 0x3F, phi_a2_4 + 0x1F, 0, G_TX_NOMIRROR | G_TX_WRAP,
                                    G_TX_NOMASK, G_TX_NOLOD, G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK, G_TX_NOLOD);
 
-                gSP1Quadrangle(skyboxCtx->unk_138++, D_8012AD40[phi_t2_4 + 1], D_8012AD40[phi_t2_4 + 2],
-                               D_8012AD40[phi_t2_4 + 3], D_8012AD40[phi_t2_4 + 0], 3);
+                gSP1Quadrangle(skyboxCtx->unk_138++, sRoomQuadIndices[phi_t2_4 + 1], sRoomQuadIndices[phi_t2_4 + 2],  // was D_8012AD40 [LLM:HIGH]
+                               sRoomQuadIndices[phi_t2_4 + 3], sRoomQuadIndices[phi_t2_4 + 0], 3);  // was D_8012AD40 [LLM:HIGH]
             }
         }
         gSPEndDisplayList(skyboxCtx->unk_138++);
