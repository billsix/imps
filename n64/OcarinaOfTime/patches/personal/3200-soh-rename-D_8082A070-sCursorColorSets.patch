-    static s16 D_8082A070[][4] = {
+    static s16 sCursorColorSets[][4] = {  // was D_8082A070 [LLM:HIGH]
         { 255, 0, 0, 255 },
         { 255, 70, 0, 150 },
         { 255, 70, 0, 150 },
@@ -414,36 +414,36 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
         }
     }
 
