From 36ce78b9bd00b75be0456e1986dde948fbeb9d7e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:06:35 +0000
Subject: [PATCH 1964/3799] soh: rename D_8094C858 -> sShieldFlashAlpha

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: prim alpha of the mirror-shield flash, driven up while sShieldFlashTimer runs and down after
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index bb3d3c89e..2128e0d81 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -184,7 +184,8 @@ static u8 sShieldFireCharge;
 static u8 sShieldIceCharge;
 // LLM generated name (HIGH), was D_8094C854: approaches 255 while the mirror shield charges and 0 as it discharges; used as the prim alpha of the charge glow
 static f32 sShieldChargeAlpha;  // was D_8094C854 [LLM:HIGH]
-static f32 D_8094C858;
+// LLM generated name (HIGH), was D_8094C858: prim alpha of the mirror-shield flash, driven up while sShieldFlashTimer runs and down after
+static f32 sShieldFlashAlpha;  // was D_8094C858 [LLM:HIGH]
 static u8 sTwinrovaBlastType;
 static u8 sFixedBlastType;
 static u8 sFixedBlatSeq;
@@ -475,7 +476,7 @@ void BossTw_Init(Actor* thisx, PlayState* play2) {
             D_8094C872 = sBeamDivertTimer = sEnvType = sGroundBlastType = sFreezeState = sTwinrovaBlastType =
                 sFixedBlatSeq = sShieldFireCharge = sShieldIceCharge = 0;
 
-        D_8094C858 = sShieldChargeAlpha = 0.0f;  // was D_8094C854 [LLM:HIGH]
+        sShieldFlashAlpha = sShieldChargeAlpha = 0.0f;  // was D_8094C854 [LLM:HIGH]
         sFixedBlastType = Rand_ZeroFloat(1.99f);
         play->specialEffects = sEffects;
 
@@ -3738,14 +3739,14 @@ void BossTw_ShieldChargeDraw(BossTw* this, PlayState* play) {
         f32 step = D_8094C872 > 0 ? 100.0f : 60.0f;
 
         D_8094C86F--;
-        Math_ApproachF(&D_8094C858, 255.0f, 1.0f, step);
+        Math_ApproachF(&sShieldFlashAlpha, 255.0f, 1.0f, step);  // was D_8094C858 [LLM:HIGH]
     } else {
         f32 step = D_8094C872 > 0 ? 40.0f : 20.0f;
 
-        Math_ApproachF(&D_8094C858, 0.0f, 1.0f, step);
+        Math_ApproachF(&sShieldFlashAlpha, 0.0f, 1.0f, step);  // was D_8094C858 [LLM:HIGH]
     }
 
-    if (Player_HasMirrorShieldEquipped(play) && D_8094C858 > 0.0f) {
+    if (Player_HasMirrorShieldEquipped(play) && sShieldFlashAlpha > 0.0f) {  // was D_8094C858 [LLM:HIGH]
         f32 scale = D_8094C872 > 0 ? 1.3f : 1.0f;
 
         Matrix_Mult(&player->shieldMf, MTXMODE_NEW);
@@ -3753,10 +3754,10 @@ void BossTw_ShieldChargeDraw(BossTw* this, PlayState* play) {
         Matrix_Scale(scale, scale, scale, MTXMODE_APPLY);
         gSPMatrix(POLY_XLU_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_LOAD | G_MTX_MODELVIEW | G_MTX_NOPUSH);
         if (sShieldFireCharge != 0) {
-            gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 255, 220, 20, (s16)D_8094C858);
+            gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 255, 220, 20, (s16)sShieldFlashAlpha);  // was D_8094C858 [LLM:HIGH]
             gDPSetEnvColor(POLY_XLU_DISP++, 255, 0, 20, 110);
         } else {
-            gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 255, 255, 255, (s16)D_8094C858);
+            gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 255, 255, 255, (s16)sShieldFlashAlpha);  // was D_8094C858 [LLM:HIGH]
             gDPSetEnvColor(POLY_XLU_DISP++, 185, 225, 205, 150);
         }
 
