From 0a3407b4da82d35ab98e8a1226f4235f51fcbc0f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:02:05 +0000
Subject: [PATCH 216/225] soh: rename D_80B7E114 -> sLureBiteTimer

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_Fishing/z_fishing.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_Fishing/z_fishing.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
index 535e74ff8..8ef023e55 100644
--- a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
+++ b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
@@ -393,7 +393,8 @@ static f32 sLure1Rotate; // lure type 1 is programmed to change this.
 static f32 sLurePosZOffset;
 static f32 sLureRotXTarget;
 static f32 sLureRotXStep;
-static s8 D_80B7E114;
+// LLM generated name (HIGH), was D_80B7E114: s8 set to 10 on bite, decremented; gates bite handling
+static s8 sLureBiteTimer;
 static s16 sRodPullback; // holding A+Down to keep the fish on line
 static u8 D_80B7E118;
 static f32 sRodReelingSpeed;
@@ -2192,8 +2193,8 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
         sRumbleDelay--;
     }
 
-    if (D_80B7E114 != 0) {
-        D_80B7E114--;
+    if (sLureBiteTimer != 0) {
+        sLureBiteTimer--;
     }
 
     if (sFishingPlayingState == 1) {
@@ -2212,7 +2213,7 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
         sRodLineSpooled = 195.0f;
 
         sRodCastState = sLureEquipped = sLureTimer = sCatchCutsceneTimer = sReelLockTimer = sRodCastTimer = sWiggleAttraction =
-            D_80B7E114 = D_80B7E150 = 0;
+            sLureBiteTimer = D_80B7E150 = 0;
         sLure1Rotate = sReelLinePosStep = sLurePosZOffset = 0.0f;
 
         sLureLineSegPosDelta = zeroVec;
@@ -2368,7 +2369,7 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
                     }
 
                     if ((sLurePos.y <= spE4) && (spE4 < spE0) && (spE4 == WATER_SURFACE_Y(play))) {
-                        D_80B7E114 = 10;
+                        sLureBiteTimer = 10;
                         Sfx_PlaySfxAtPos(&sSoundPos, NA_SE_EV_BOMB_DROP_WATER);
                         sLureCastDelta.y = 0.0f;
                         sLurePosDelta.y *= 0.2f;
@@ -2825,7 +2826,7 @@ void func_80B70ED4(Fishing* this, Input* input) {
         this->timerArray[1] = 50;
     }
 
-    if ((sLureEquipped != FS_LURE_SINKING) && (D_80B7E114 != 0) && (this->fishLength > 60.0f) &&
+    if ((sLureEquipped != FS_LURE_SINKING) && (sLureBiteTimer != 0) && (this->fishLength > 60.0f) &&
         (lineLengthSQ < SQ(30.0f)) && (this->fishState >= 10)) {
         this->fishStateNext = 0;
         this->fishState = 1;
@@ -4563,7 +4564,7 @@ void Fishing_UpdateGroupFishes(PlayState* play) {
     f32 temp1;
     f32 temp2;
 
-    if ((D_80B7E114 != 0) || (sRodCastState == 4)) {
+    if ((sLureBiteTimer != 0) || (sRodCastState == 4)) {
         refPos = &sLurePos;
     } else {
         refPos = &player->actor.world.pos;
-- 
