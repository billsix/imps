From bf2df9576076473a98134a0bbde82c5199b7157d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:21 +0000
Subject: [PATCH 101/784] soh: rename func_8006C510 -> Curve_CubicHermiteSpline

Name source: zeldaret/oot.
Defined in soh/src/code/z_fcurve_data.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/z_fcurve_data.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_fcurve_data.c b/soh/src/code/z_fcurve_data.c
index 833009e81..481ff686c 100644
--- a/soh/src/code/z_fcurve_data.c
+++ b/soh/src/code/z_fcurve_data.c
@@ -1,6 +1,7 @@
 #include "global.h"
 
-f32 func_8006C510(f32 arg0, f32 arg1, f32 arg2, f32 arg3, f32 arg4, f32 arg5) {
+// Name from zeldaret/oot, was func_8006C510: evaluates cubic Hermite basis (2t^3-3t^2+1, etc.) over endpoints and tangents [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_fcurve_data.c]
+f32 Curve_CubicHermiteSpline(f32 arg0, f32 arg1, f32 arg2, f32 arg3, f32 arg4, f32 arg5) {
     char pad[0x1C];
     f32 sq = SQ(arg0);
     f32 cube = sq * arg0;
@@ -31,7 +32,7 @@ f32 func_8006C5A8(f32 target, TransformData* transData, s32 refIdx) {
                            (transData[j].unk_08 - transData[i].unk_08);
             } else {
                 f32 diff = (f32)transData[j].unk_02 - (f32)transData[i].unk_02;
-                return func_8006C510((target - transData[i].unk_02) / ((f32)transData[j].unk_02 - transData[i].unk_02),
+                return Curve_CubicHermiteSpline((target - transData[i].unk_02) / ((f32)transData[j].unk_02 - transData[i].unk_02),
                                      diff * (1.0f / 30.0f), transData[i].unk_08, transData[j].unk_08,
                                      transData[i].unk_06, transData[j].unk_04);
             }
