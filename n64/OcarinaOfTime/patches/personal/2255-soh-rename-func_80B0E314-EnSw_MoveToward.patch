Date: Mon, 7 Sep 2026 23:19:19 +0000
Subject: [PATCH 2255/3799] soh: rename func_80B0E314 -> EnSw_MoveToward

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: eases the speed toward the caller's target and steps the position straight at the given point
Defined in soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
index 1b4e81856..cfe4353d4 100644
--- a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
+++ b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
@@ -776,7 +776,8 @@ s32 EnSw_CanKeepChasing(EnSw* this, PlayState* play) {
     return sp4C;
 }
 
-void func_80B0E314(EnSw* this, Vec3f arg1, f32 arg4) {
+// LLM generated name (HIGH), was func_80B0E314: eases the speed toward the caller's target and steps the position straight at the given point
+void EnSw_MoveToward(EnSw* this, Vec3f arg1, f32 arg4) {
     f32 xDist;
     f32 yDist;
     f32 zDist;
@@ -876,7 +877,7 @@ void func_80B0E728(EnSw* this, PlayState* play) {
             this->unk_448 = this->actor.home.pos;
             this->actionFunc = func_80B0E9BC;
         } else {
-            func_80B0E314(this, this->unk_448, 8.0f);
+            EnSw_MoveToward(this, this->unk_448, 8.0f);  // was func_80B0E314 [LLM:HIGH]
 
             if (DECR(this->unk_440) == 0) {
                 Audio_PlayActorSound2(&this->actor, NA_SE_EN_STALWALL_DASH);
@@ -893,7 +894,7 @@ void func_80B0E728(EnSw* this, PlayState* play) {
 void func_80B0E90C(EnSw* this, PlayState* play) {
     s32 pad;
 
-    func_80B0E314(this, this->unk_448, 0.0f);
+    EnSw_MoveToward(this, this->unk_448, 0.0f);  // was func_80B0E314 [LLM:HIGH]
     if (this->actor.speedXZ == 0.0f) {
         this->unk_444 = EnSw_GetRollToward(this, &this->actor.home.pos);  // was func_80B0DE34 [LLM:HIGH]
         this->unk_448 = this->actor.home.pos;
@@ -905,7 +906,7 @@ void func_80B0E9BC(EnSw* this, PlayState* play) {
     s32 pad;
 
     if (func_80B0E430(this, 6.0f, 0x3E8, 0, play)) {
-        func_80B0E314(this, this->unk_448, 2.0f);
+        EnSw_MoveToward(this, this->unk_448, 2.0f);  // was func_80B0E314 [LLM:HIGH]
         if (!(Math_Vec3f_DistXYZ(&this->actor.world.pos, &this->unk_448) > 4.0f)) {
             this->actionFunc = func_80B0E5E0;
         }
