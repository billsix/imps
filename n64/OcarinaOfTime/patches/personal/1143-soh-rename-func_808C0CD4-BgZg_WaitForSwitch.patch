From 714b3b0109cbc4680578dd9a36a1452c1998cecf Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:52:27 +0000
Subject: [PATCH 1143/3799] soh: rename func_808C0CD4 -> BgZg_WaitForSwitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sActionFuncs[0]: waits for the switch flag, then advances to action 1 and plays the opening sfx.
Defined in soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
index 94ff1aede..b03470bea 100644
--- a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
+++ b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
@@ -21,12 +21,13 @@ void BgZg_PlayOpenSfx(BgZg* this);  // was func_808C0C50 [LLM:HIGH]
 s32 BgZg_IsSwitchSet(BgZg* this, PlayState* play);  // was func_808C0C98 [LLM:HIGH]
 // LLM generated name (GUESS), was func_808C0CC8: returns the low byte of params; Init uses it only to scale the bars up when it is 8 or 9. What the byte actually selects is not stated anywhere in the file.
 s32 BgZg_GetVariant(BgZg* this);  // was func_808C0CC8 [LLM:GUESS]
-void func_808C0CD4(BgZg* this, PlayState* play);
+// LLM generated name (HIGH), was func_808C0CD4: sActionFuncs[0]: waits for the switch flag, then advances to action 1 and plays the opening sfx.
+void BgZg_WaitForSwitch(BgZg* this, PlayState* play);  // was func_808C0CD4 [LLM:HIGH]
 void func_808C0D08(BgZg* this, PlayState* play);
 void func_808C0EEC(BgZg* this, PlayState* play);
 
 static BgZgActionFunc sActionFuncs[] = {
-    func_808C0CD4,
+    BgZg_WaitForSwitch,  // was func_808C0CD4 [LLM:HIGH]
     func_808C0D08,
 };
 
@@ -74,7 +75,7 @@ s32 BgZg_GetVariant(BgZg* this) {
     return flag;
 }
 
-void func_808C0CD4(BgZg* this, PlayState* play) {
+void BgZg_WaitForSwitch(BgZg* this, PlayState* play) {
     if (BgZg_IsSwitchSet(this, play) != 0) {  // was func_808C0C98 [LLM:HIGH]
         this->action = 1;
         BgZg_PlayOpenSfx(this);  // was func_808C0C50 [LLM:HIGH]
