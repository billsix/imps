From 0367b34ce8d20ec62db8f274f6b798fc6a92bf07 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:41 +0000
Subject: [PATCH 3113/3799] soh: rename D_80122C14 -> sCs4210KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 4210 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 06d0c37a1..472d72956 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -908,7 +908,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
         case 4210:
             player->actor.freezeTimer = timer;
 
-            csInfo->keyFrames = D_80122C14;
+            csInfo->keyFrames = sCs4210KeyFrames;  // was D_80122C14 [LLM:HIGH]
             csInfo->keyFrameCnt = 1;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 278740e93..1fc5f822f 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -565,7 +565,8 @@ static OnePointCsFull sCs4200KeyFrames[3] = {  // was D_80122B9C [LLM:HIGH]
     { 0x11, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80122C14[1] = {
+// LLM generated name (HIGH), was D_80122C14: the keyframe set one-point cutscene 4210 installs
+static OnePointCsFull sCs4210KeyFrames[1] = {  // was D_80122C14 [LLM:HIGH]
     { 0x0F, 0xFF, 0x0101, 999, 0, 85.0f, 1.0f, { -15.0f, 185.0f, 160.0f }, { -15.0f, 210.0f, 250.0f } },
 };
 
