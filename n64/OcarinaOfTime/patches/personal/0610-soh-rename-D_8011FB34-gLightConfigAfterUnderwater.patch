Defined in soh/src/code/z_kankyo.c.
---
 soh/include/variables.h                           |  2 +-
 soh/src/code/z_kankyo.c                           | 15 ++++++++-------
 .../actors/ovl_En_Weather_Tag/z_en_weather_tag.c  |  4 ++--
 3 files changed, 11 insertions(+), 10 deletions(-)

diff --git a/soh/include/variables.h b/soh/include/variables.h
index 834f13004..19b7c0c67 100644
--- a/soh/include/variables.h
+++ b/soh/include/variables.h
