From 86116b742e4e08b761b6beb3137c6e0de437c263 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:19:09 +0000
Subject: [PATCH 0886/3799] soh: rename D_800122E0 -> sPowersOfTen
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: const f64 table 10^1, 10^2, 10^4, 10^8 … 10^256; the double-to-string conversion multiplies val and factor by entry i while walking the exponent bit by bit.
Defined in soh/src/libultra/rmon/xldtob.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/libultra/rmon/xldtob.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/libultra/rmon/xldtob.c b/soh/src/libultra/rmon/xldtob.c
index cc518a44b..783e90f52 100644
--- a/soh/src/libultra/rmon/xldtob.c
+++ b/soh/src/libultra/rmon/xldtob.c
@@ -5,7 +5,8 @@
 s16 _Ldunscale(s16*, _Pft*);
 void _Genld(_Pft*, u8, u8*, s16, s16);
 
-const f64 D_800122E0[] = { 10e0L, 10e1L, 10e3L, 10e7L, 10e15L, 10e31L, 10e63L, 10e127L, 10e255L };
+// LLM generated name (HIGH), was D_800122E0: const f64 table 10^1, 10^2, 10^4, 10^8 … 10^256; the double-to-string conversion multiplies val and factor by entry i while walking the exponent bit by bit.
+const f64 sPowersOfTen[] = { 10e0L, 10e1L, 10e3L, 10e7L, 10e15L, 10e31L, 10e63L, 10e127L, 10e255L };  // was D_800122E0 [LLM:HIGH]
 
 /* float properties */
 #define _D0 0
@@ -83,7 +84,7 @@ void _Ldtob(_Pft* args, u8 type) {
             exp = -n;
             for (i = 0; n > 0; n >>= 1, i++) {
                 if ((n & 1) != 0) {
-                    val *= D_800122E0[i];
+                    val *= sPowersOfTen[i];  // was D_800122E0 [LLM:HIGH]
                 }
             }
         } else if (exp > 0) {
@@ -92,7 +93,7 @@ void _Ldtob(_Pft* args, u8 type) {
 
             for (n = exp, i = 0; n > 0; n >>= 1, i++) {
                 if ((n & 1) != 0) {
-                    factor *= D_800122E0[i];
+                    factor *= sPowersOfTen[i];  // was D_800122E0 [LLM:HIGH]
                 }
             }
             val /= factor;
-- 
