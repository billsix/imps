Date: Mon, 7 Sep 2026 22:31:18 +0000
Subject: [PATCH 1626/3799] soh: rename func_80AD619C ->
 EnPoField_UpdateLightColor

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: drives the lantern light's colour: green while fleeing, flashing black on damage, and easing back to white otherwise.
Defined in soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
index 84c0b563a..0f58d7a2b 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
@@ -825,7 +825,8 @@ void EnPoField_DrawFlame(EnPoField* this, PlayState* play) {
     }
 }
 
-void func_80AD619C(EnPoField* this) {
+// LLM generated name (HIGH), was func_80AD619C: drives the lantern light's colour: green while fleeing, flashing black on damage, and easing back to white otherwise.
+void EnPoField_UpdateLightColor(EnPoField* this) {
     s16 temp_var;
 
     if (this->actionFunc == EnPoField_Flee) {
@@ -885,7 +886,7 @@ void EnPoField_Update(Actor* thisx, PlayState* play) {
     if (this->actionFunc != EnPoField_WaitForSpawn) {
         Actor_SetFocus(&this->actor, 42.0f);
         Actor_UpdateBgCheckInfo(play, &this->actor, 0.0f, 27.0f, 60.0f, 4);
-        func_80AD619C(this);
+        EnPoField_UpdateLightColor(this);  // was func_80AD619C [LLM:HIGH]
         func_80AD6330(this);
         Collider_UpdateCylinder(&this->actor, &this->collider);
         CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
