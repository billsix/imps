From 5aad62c0163aa0cd89ba918f1f3161334ffdd371 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:55 +0000
Subject: [PATCH 3295/3799] soh: rename D_808CA48C -> sLimb46Offset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the point limb 46 records its transformed position from
Defined in soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c b/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
index 8b58e5e6a..8bd6d0157 100644
--- a/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
+++ b/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
@@ -1350,7 +1350,7 @@ void BossDodongo_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s
     static Vec3f sFireOffset = { 11500.0f, -3000.0f, 0.0f };  // was D_808CA468 [LLM:HIGH]
     static Vec3f sMouthOffset = { 5000.0f, -2000.0f, 0.0f };  // was D_808CA474 [LLM:HIGH]
     static Vec3f sLimb39Offset = { 8000.0f, 0.0f, 0.0f };  // was D_808CA480 [LLM:HIGH]
-    static Vec3f D_808CA48C = { 8000.0f, 0.0f, 0.0f };
+    static Vec3f sLimb46Offset = { 8000.0f, 0.0f, 0.0f };  // was D_808CA48C [LLM:HIGH]
     BossDodongo* this = (BossDodongo*)thisx;
 
     if (limbIndex == 6) {
@@ -1361,7 +1361,7 @@ void BossDodongo_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s
     } else if (limbIndex == 39) {
         Matrix_MultVec3f(&sLimb39Offset, &this->unk_410);  // was D_808CA480 [LLM:HIGH]
     } else if (limbIndex == 46) {
-        Matrix_MultVec3f(&D_808CA48C, &this->unk_404);
+        Matrix_MultVec3f(&sLimb46Offset, &this->unk_404);  // was D_808CA48C [LLM:HIGH]
     }
     Collider_UpdateSpheres(limbIndex, &this->collider);
 }
