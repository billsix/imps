From 9175e9c331be60036a5f002df6164a1ced4e74b5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:08 +0000
Subject: [PATCH 1677/3799] soh: rename D_80B2EB88 -> sDeathFlameTextures

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the ten enemy-death flame frames, cycled by the gameplay frame counter and bound to segment 8 in the draw function.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index f09a8c997..7c3ed0f30 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -136,7 +136,8 @@ static Vec3f sBeamNearLeft = { -500.0f, 0.0f, 0.0f };  // was D_80B2EB70 [LLM:HI
 // LLM generated name (HIGH), was D_80B2EB7C: the scale passed to the enemy-death flame effect.
 static Vec3f sDeathFlameScale = { 0.4f, 0.4f, 0.4f };  // was D_80B2EB7C [LLM:HIGH]
 
-static void* D_80B2EB88[] = {
+// LLM generated name (HIGH), was D_80B2EB88: the ten enemy-death flame frames, cycled by the gameplay frame counter and bound to segment 8 in the draw function.
+static void* sDeathFlameTextures[] = {  // was D_80B2EB88 [LLM:HIGH]
     gEffEnemyDeathFlame1Tex, gEffEnemyDeathFlame2Tex,  gEffEnemyDeathFlame3Tex, gEffEnemyDeathFlame4Tex,
     gEffEnemyDeathFlame5Tex, gEffEnemyDeathFlame6Tex,  gEffEnemyDeathFlame7Tex, gEffEnemyDeathFlame8Tex,
     gEffEnemyDeathFlame9Tex, gEffEnemyDeathFlame10Tex,
@@ -550,11 +551,11 @@ void EnVm_Draw(Actor* thisx, PlayState* play2) {
         gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 255, 255, 255, 168);
         Gfx_SetupDL_60NoCDXlu(play->state.gfxCtx);
         gDPSetEnvColor(POLY_XLU_DISP++, 0, 0, 255, 0);
-        gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_80B2EB88[play->gameplayFrames % 8]));
+        gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(sDeathFlameTextures[play->gameplayFrames % 8]));  // was D_80B2EB88 [LLM:HIGH]
         gSPDisplayList(POLY_XLU_DISP++, gEffEnemyDeathFlameDL);
         Matrix_RotateY(32767.0f, MTXMODE_APPLY);
         gSPMatrix(POLY_XLU_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
-        gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_80B2EB88[(play->gameplayFrames + 4) % 8]));
+        gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(sDeathFlameTextures[(play->gameplayFrames + 4) % 8]));  // was D_80B2EB88 [LLM:HIGH]
         gSPDisplayList(POLY_XLU_DISP++, gEffEnemyDeathFlameDL);
     }
     gSPSegment(POLY_OPA_DISP++, 0x08, Gfx_TexScrollNoSize(play->state.gfxCtx, 0, this->beamTexScroll));  // was func_80094E78 [LLM:HIGH]
