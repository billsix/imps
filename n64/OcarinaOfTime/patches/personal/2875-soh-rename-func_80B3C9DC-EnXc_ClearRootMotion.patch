From 49a22ae64a2ed53936e67d3663d8a1510350bdf5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:41 +0000
Subject: [PATCH 2875/3799] soh: rename func_80B3C9DC -> EnXc_ClearRootMotion

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: clears the root motion flags
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 7f67fd801..4f113d8aa 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -271,7 +271,8 @@ void EnXc_ResetAndApplyRootMotion(EnXc* this, PlayState* play) {
     AnimationContext_SetMoveActor(play, &this->actor, &this->skelAnime, 1.0f);
 }
 
-void func_80B3C9DC(EnXc* this) {
+// LLM generated name (HIGH), was func_80B3C9DC: clears the root motion flags
+void EnXc_ClearRootMotion(EnXc* this) {
     this->skelAnime.movementFlags &= ~0x3;
 }
 
@@ -720,7 +721,7 @@ void func_80B3D8A4(EnXc* this, PlayState* play, s32 animFinished) {
         this->action = SHEIK_ACTION_ACCEL;
         this->timer = 0.0f;
 
-        func_80B3C9DC(this);
+        EnXc_ClearRootMotion(this);  // was func_80B3C9DC [LLM:HIGH]
         this->actor.gravity = -((kREG(1) * 0.01f) + 13.0f);
         this->actor.minVelocityY = -((kREG(1) * 0.01f) + 13.0f);
     } else {
@@ -1845,7 +1846,7 @@ void EnXc_SetupIdleInNocturne(EnXc* this, PlayState* play) {
     SkelAnime* skelAnime = &this->skelAnime;
     f32 frameCount = Animation_GetLastFrame(&gSheikIdleAnim);
 
-    func_80B3C9DC(this);
+    EnXc_ClearRootMotion(this);  // was func_80B3C9DC [LLM:HIGH]
     EnXc_SetPosRotFromCue(this, play, 4);  // was func_80B3C588 [LLM:HIGH]
     Animation_Change(skelAnime, &gSheikIdleAnim, 1.0f, 0.0f, frameCount, ANIMMODE_LOOP, 0.0f);
     this->action = SHEIK_ACTION_NOCTURNE_IDLE;
@@ -1897,7 +1898,7 @@ void EnXc_SetupHittingGroundInNocturne(EnXc* this, PlayState* play) {
     s32 pad[3];
     f32 frameCount = Animation_GetLastFrame(&gSheikHittingGroundAnim);
 
-    func_80B3C9DC(this);
+    EnXc_ClearRootMotion(this);  // was func_80B3C9DC [LLM:HIGH]
     EnXc_SetPosRotFromCue(this, play, 4);  // was func_80B3C588 [LLM:HIGH]
     Animation_Change(&this->skelAnime, &gSheikHittingGroundAnim, 1.0f, 0.0f, frameCount, ANIMMODE_ONCE, 0.0f);
     this->action = SHEIK_ACTION_NOCTURNE_HIT_GROUND;
@@ -1909,7 +1910,7 @@ void func_80B40A78(EnXc* this, PlayState* play) {
     s32 pad[3];
     f32 frameCount = Animation_GetLastFrame(&gSheikHittingGroundAnim);
 
-    func_80B3C9DC(this);
+    EnXc_ClearRootMotion(this);  // was func_80B3C9DC [LLM:HIGH]
     EnXc_SetPosRotFromCue(this, play, 4);  // was func_80B3C588 [LLM:HIGH]
     Animation_Change(&this->skelAnime, &gSheikHittingGroundAnim, 1.0f, 0.0f, frameCount, ANIMMODE_ONCE, 0.0f);
     this->action = SHEIK_ACTION_63;
@@ -1921,7 +1922,7 @@ void EnXc_SetupKneelInNocturne(EnXc* this, PlayState* play) {
     s32 pad[3];
     f32 frameCount = Animation_GetLastFrame(&gSheikKneelingAnim);
 
-    func_80B3C9DC(this);
+    EnXc_ClearRootMotion(this);  // was func_80B3C9DC [LLM:HIGH]
     EnXc_SetPosRotFromCue(this, play, 4);  // was func_80B3C588 [LLM:HIGH]
     Animation_Change(&this->skelAnime, &gSheikKneelingAnim, 1.0f, 0.0f, frameCount, ANIMMODE_LOOP, 0.0f);
     this->action = SHEIK_ACTION_NOCTURNE_KNEEL;
@@ -1932,7 +1933,7 @@ void EnXc_SetupKneelInNocturne(EnXc* this, PlayState* play) {
 void func_80B40BB4(EnXc* this, PlayState* play) {
     s32 pad[3];
     f32 frameCount = Animation_GetLastFrame(&gSheikIdleAnim);
-    func_80B3C9DC(this);
+    EnXc_ClearRootMotion(this);  // was func_80B3C9DC [LLM:HIGH]
     EnXc_SetPosRotFromCue(this, play, 4);  // was func_80B3C588 [LLM:HIGH]
     Animation_Change(&this->skelAnime, &gSheikIdleAnim, 1.0f, 0.0f, frameCount, ANIMMODE_LOOP, 0.0f);
     this->action = SHEIK_ACTION_65;
