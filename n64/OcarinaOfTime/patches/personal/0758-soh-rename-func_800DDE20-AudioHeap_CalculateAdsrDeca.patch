From 0b70d20d15bdebed89584e48d81657db5d984742 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:43:46 +0000
Subject: [PATCH 758/784] soh: rename func_800DDE20 ->
 AudioHeap_CalculateAdsrDecay

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 0.94.
Defined in soh/src/code/audio_heap.c.
---
 soh/src/code/audio_heap.c | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/src/code/audio_heap.c b/soh/src/code/audio_heap.c
index a6f2dae1e..09831eff9 100644
--- a/soh/src/code/audio_heap.c
+++ b/soh/src/code/audio_heap.c
@@ -10,29 +10,30 @@ void AudioHeap_DiscardSampleCaches(void);
 void AudioHeap_DiscardSampleBank(s32 sampleBankId);
 void AudioHeap_DiscardSampleBanks(void);
 
-f32 func_800DDE20(f32 arg0) {
+// Name from zeldaret/oot (was func_800DDE20): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.94. [oot: https://github.com/zeldaret/oot/blob/main/src/code/audio_heap.c]
+f32 AudioHeap_CalculateAdsrDecay(f32 arg0) {
     return 256.0f * gAudioContext.audioBufferParameters.unkUpdatesPerFrameScaled / arg0;
 }
 
 void func_800DDE3C(void) {
     s32 i;
 
-    gAudioContext.unk_3520[255] = func_800DDE20(0.25f);
-    gAudioContext.unk_3520[254] = func_800DDE20(0.33f);
-    gAudioContext.unk_3520[253] = func_800DDE20(0.5f);
-    gAudioContext.unk_3520[252] = func_800DDE20(0.66f);
-    gAudioContext.unk_3520[251] = func_800DDE20(0.75f);
+    gAudioContext.unk_3520[255] = AudioHeap_CalculateAdsrDecay(0.25f);
+    gAudioContext.unk_3520[254] = AudioHeap_CalculateAdsrDecay(0.33f);
+    gAudioContext.unk_3520[253] = AudioHeap_CalculateAdsrDecay(0.5f);
+    gAudioContext.unk_3520[252] = AudioHeap_CalculateAdsrDecay(0.66f);
+    gAudioContext.unk_3520[251] = AudioHeap_CalculateAdsrDecay(0.75f);
 
     for (i = 128; i < 251; i++) {
-        gAudioContext.unk_3520[i] = func_800DDE20(251 - i);
+        gAudioContext.unk_3520[i] = AudioHeap_CalculateAdsrDecay(251 - i);
     }
 
     for (i = 16; i < 128; i++) {
-        gAudioContext.unk_3520[i] = func_800DDE20(4 * (143 - i));
+        gAudioContext.unk_3520[i] = AudioHeap_CalculateAdsrDecay(4 * (143 - i));
     }
 
     for (i = 1; i < 16; i++) {
-        gAudioContext.unk_3520[i] = func_800DDE20(60 * (23 - i));
+        gAudioContext.unk_3520[i] = AudioHeap_CalculateAdsrDecay(60 * (23 - i));
     }
 
     gAudioContext.unk_3520[0] = 0.0f;
-- 
