From 22bb4ed540f13d0a968881c5eebc6ad950e0309e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:18 +0000
Subject: [PATCH 1812/3799] soh: rename func_800AF178 -> Skybox_BuildSky

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: builds the requested number of outdoor-skybox faces, five for the ordinary sky and six for the cutscene map.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 882e3272e..4b8ae3658 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -457,7 +457,8 @@ void Skybox_BuildRoom(SkyboxContext* skyboxCtx, s16 skyboxId) {
     }
 }
 
-void func_800AF178(SkyboxContext* skyboxCtx, s32 arg1) {
+// LLM generated name (HIGH), was func_800AF178: builds the requested number of outdoor-skybox faces, five for the ordinary sky and six for the cutscene map.
+void Skybox_BuildSky(SkyboxContext* skyboxCtx, s32 arg1) {
     s32 phi_s2 = 0;
     s32 i;
 
@@ -952,12 +953,12 @@ void Skybox_Init(GameState* state, SkyboxContext* skyboxCtx, s16 skyboxId) {
                 skyboxCtx->roomVtx = GAMESTATE_ALLOC_MC(state, 192 * sizeof(Vtx));
                 assert(skyboxCtx->roomVtx != NULL);
 
-                func_800AF178(skyboxCtx, 6);
+                Skybox_BuildSky(skyboxCtx, 6);  // was func_800AF178 [LLM:HIGH]
             } else {
                 skyboxCtx->roomVtx = GAMESTATE_ALLOC_MC(state, 160 * sizeof(Vtx));
                 assert(skyboxCtx->roomVtx != NULL);
 
-                func_800AF178(skyboxCtx, 5);
+                Skybox_BuildSky(skyboxCtx, 5);  // was func_800AF178 [LLM:HIGH]
             }
         }
         osSyncPrintf(VT_RST);
@@ -972,9 +973,9 @@ void Skybox_Update(SkyboxContext* skyboxCtx) {
             Skybox_BuildRoom(skyboxCtx, skyboxCtx->skyboxId);  // was func_800AEFC8 [LLM:HIGH]
         } else {
             if (skyboxCtx->skyboxId == SKYBOX_CUTSCENE_MAP) {
-                func_800AF178(skyboxCtx, 6);
+                Skybox_BuildSky(skyboxCtx, 6);  // was func_800AF178 [LLM:HIGH]
             } else {
-                func_800AF178(skyboxCtx, 5);
+                Skybox_BuildSky(skyboxCtx, 5);  // was func_800AF178 [LLM:HIGH]
             }
         }
         osSyncPrintf(VT_RST);
-- 
