From 0cc7b2708a6a757a5ce28402ef00cc5368cea3a4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:26:29 +0000
Subject: [PATCH 1548/3799] soh: rename D_8089BA08 -> sWallSlideSpeeds

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: how fast each segment slides while it is moving.
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c     | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c b/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
index 4f9e2ed0f..c556e25c6 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
@@ -46,7 +46,8 @@ static s16 sWallDirections[4] = { -1, 1, -1, 1 };  // was D_8089B9F8 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8089BA00: how long each segment rests between slides.
 static s16 sWallPauseFrames[4] = { 48, 48, 36, 36 };  // was D_8089BA00 [LLM:HIGH]
 
-static f32 D_8089BA08[4] = { 8.0f, 8.0f, 10.0f, 10.0f };
+// LLM generated name (HIGH), was D_8089BA08: how fast each segment slides while it is moving.
+static f32 sWallSlideSpeeds[4] = { 8.0f, 8.0f, 10.0f, 10.0f };  // was D_8089BA08 [LLM:HIGH]
 
 static s16 D_8089BA18[6][2] = {
     { 0x0388, 0x0395 }, { 0x03EA, 0x03FF }, { 0x0454, 0x0467 },
@@ -166,11 +167,11 @@ void func_8089B80C(BgJyaZurerukabe* this) {
 
 void func_8089B870(BgJyaZurerukabe* this, PlayState* play) {
     if (Math_StepToF(&this->dyna.actor.world.pos.x, this->dyna.actor.home.pos.x + (this->unk_16C * 75),
-                     D_8089BA08[this->unk_168])) {
+                     sWallSlideSpeeds[this->unk_168])) {  // was D_8089BA08 [LLM:HIGH]
         func_8089B7B4(this);
     }
 
-    sWallSpeeds[this->unk_168] = D_8089BA08[this->unk_168] * this->unk_16E;  // was D_8089B9C0 [LLM:HIGH]
+    sWallSpeeds[this->unk_168] = sWallSlideSpeeds[this->unk_168] * this->unk_16E;  // was D_8089B9C0 [LLM:HIGH]
     Actor_PlaySfx_Flagged(&this->dyna.actor, NA_SE_EV_ELEVATOR_MOVE - SFX_FLAG);
 }
 
