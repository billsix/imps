From 8566ea2e5842efd83fa4eae8cf22dc6d3ddbed5f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:49 +0000
Subject: [PATCH 3155/3799] soh: rename D_8015E410 -> sQuadVsCylHitPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hit position that check reports
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index df1540503..d59847bce 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2262,7 +2262,7 @@ static s8 sBssDummy1;
 void CollisionCheck_AC_QuadVsCyl(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT, Collider* colAC) {
     static TriNorm sQuadVsCylTri0;  // was D_8015E3A0 [LLM:HIGH]
     static TriNorm sQuadVsCylTri1;  // was D_8015E3D8 [LLM:HIGH]
-    static Vec3f D_8015E410;
+    static Vec3f sQuadVsCylHitPos;  // was D_8015E410 [LLM:HIGH]
     ColliderQuad* at = (ColliderQuad*)colAT;
     ColliderCylinder* ac = (ColliderCylinder*)colAC;
 
@@ -2275,8 +2275,8 @@ void CollisionCheck_AC_QuadVsCyl(PlayState* play, CollisionCheckContext* colChkC
         }
         Math3D_TriNorm(&sQuadVsCylTri0, &at->dim.quad[2], &at->dim.quad[3], &at->dim.quad[1]);  // was D_8015E3A0 [LLM:HIGH]
         Math3D_TriNorm(&sQuadVsCylTri1, &at->dim.quad[2], &at->dim.quad[1], &at->dim.quad[0]);  // was D_8015E3D8 [LLM:HIGH]
-        if (Math3D_CylTriVsIntersect(&ac->dim, &sQuadVsCylTri0, &D_8015E410) == 1) {  // was D_8015E3A0 [LLM:HIGH]
-            if (Collider_QuadSetNearestAC(play, at, &D_8015E410)) {
+        if (Math3D_CylTriVsIntersect(&ac->dim, &sQuadVsCylTri0, &sQuadVsCylHitPos) == 1) {  // was D_8015E3A0 [LLM:HIGH]
+            if (Collider_QuadSetNearestAC(play, at, &sQuadVsCylHitPos)) {  // was D_8015E410 [LLM:HIGH]
                 Vec3f atPos1;
                 Vec3f acPos1;
 
@@ -2285,12 +2285,12 @@ void CollisionCheck_AC_QuadVsCyl(PlayState* play, CollisionCheckContext* colChkC
                 atPos1.z = (at->dim.quad[0].z + (at->dim.quad[1].z + (at->dim.quad[3].z + at->dim.quad[2].z))) / 4.0f;
                 Math_Vec3s_ToVec3f(&acPos1, &ac->dim.pos);
                 CollisionCheck_SetATvsAC(play, &at->base, &at->info, &atPos1, &ac->base, &ac->info, &acPos1,
-                                         &D_8015E410);
+                                         &sQuadVsCylHitPos);  // was D_8015E410 [LLM:HIGH]
                 return;
             }
         }
-        if (Math3D_CylTriVsIntersect(&ac->dim, &sQuadVsCylTri1, &D_8015E410) == 1) {  // was D_8015E3D8 [LLM:HIGH]
-            if (Collider_QuadSetNearestAC(play, at, &D_8015E410)) {
+        if (Math3D_CylTriVsIntersect(&ac->dim, &sQuadVsCylTri1, &sQuadVsCylHitPos) == 1) {  // was D_8015E3D8 [LLM:HIGH]
+            if (Collider_QuadSetNearestAC(play, at, &sQuadVsCylHitPos)) {  // was D_8015E410 [LLM:HIGH]
                 Vec3f atPos2;
                 Vec3f acPos2;
 
@@ -2299,7 +2299,7 @@ void CollisionCheck_AC_QuadVsCyl(PlayState* play, CollisionCheckContext* colChkC
                 atPos2.z = (at->dim.quad[0].z + (at->dim.quad[1].z + (at->dim.quad[3].z + at->dim.quad[2].z))) / 4.0f;
                 Math_Vec3s_ToVec3f(&acPos2, &ac->dim.pos);
                 CollisionCheck_SetATvsAC(play, &at->base, &at->info, &atPos2, &ac->base, &ac->info, &acPos2,
-                                         &D_8015E410);
+                                         &sQuadVsCylHitPos);  // was D_8015E410 [LLM:HIGH]
             }
         }
     }
