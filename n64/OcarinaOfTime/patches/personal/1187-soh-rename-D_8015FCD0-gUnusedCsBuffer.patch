From 249fd7650c8d3677e4baae18d96e7ddd4487a49e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:55:36 +0000
Subject: [PATCH 1187/3799] soh: rename D_8015FCD0 -> gUnusedCsBuffer

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment on its declaration reads "unreferenced"; it is a 20-byte char array.
Defined in soh/src/code/z_demo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_demo.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/z_demo.c b/soh/src/code/z_demo.c
index 4f3218934..b3db6a5da 100644
--- a/soh/src/code/z_demo.c
+++ b/soh/src/code/z_demo.c
@@ -121,7 +121,8 @@ u8 gUseCutsceneCam;
 s16 sQuakeIndex;
 // LLM generated name (HIGH), was D_8015FCCC: the in-tree comment on its declaration reads "only written to, never read".
 u16 gUnusedCsFlag;      // only written to, never read, was D_8015FCCC [LLM:HIGH]
-char D_8015FCD0[20]; // unreferenced
+// LLM generated name (HIGH), was D_8015FCD0: the in-tree comment on its declaration reads "unreferenced"; it is a 20-byte char array.
+char gUnusedCsBuffer[20]; // unreferenced, was D_8015FCD0 [LLM:HIGH]
 u8 D_8015FCE4;       // only written to, never read
 
 // Name from zeldaret/oot (was func_80068ECC): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.98. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_demo.c]
