+                gDPLoadTextureBlock(POLY_OPA_DISP++, sOcarinaBtnIcons[gOcarinaSongButtons[sp224].buttonsIndex[phi_s3]],  // was D_8082A130 [LLM:HIGH]
                                     G_IM_FMT_IA, G_IM_SIZ_8b, 16, 16, 0, G_TX_NOMIRROR | G_TX_WRAP,
                                     G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
 
@@ -712,7 +712,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
 
                     gSPVertex(POLY_OPA_DISP++, &pauseCtx->questVtx[sp21A], 4, 0);
 
-                    gDPLoadTextureBlock(POLY_OPA_DISP++, D_8082A130[sSongNoteGlyphs[phi_s3]], G_IM_FMT_IA, G_IM_SIZ_8b, 16,  // was D_8082A124 [LLM:HIGH]
+                    gDPLoadTextureBlock(POLY_OPA_DISP++, sOcarinaBtnIcons[sSongNoteGlyphs[phi_s3]], G_IM_FMT_IA, G_IM_SIZ_8b, 16,  // was D_8082A124 [LLM:HIGH]
                                         16, 0, G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK,
                                         G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
 
