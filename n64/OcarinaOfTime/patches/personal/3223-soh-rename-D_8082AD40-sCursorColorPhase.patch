From 7716f33ec7bf68cb35ad36599dc71ce0e60de894 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:48 +0000
Subject: [PATCH 3223/3799] soh: rename D_8082AD40 -> sCursorColorPhase

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: which of the four cursor colour phases is active
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_scope_PAL.c   | 28 +++++++++----------
 1 file changed, 14 insertions(+), 14 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 8556b225e..5c9a2877e 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -1455,7 +1455,7 @@ void KaleidoScope_DrawPages(PlayState* play, GraphicsContext* gfxCtx) {
     }
 
     static s16 D_8082AD3C = 20;
-    static s16 D_8082AD40 = 0;
+    static s16 sCursorColorPhase = 0;  // was D_8082AD40 [LLM:HIGH]
     static s16 D_8082AD44 = 0;
     static s16 D_8082AD48 = 0;
     static s16 D_8082AD4C = 0;
@@ -1471,20 +1471,20 @@ void KaleidoScope_DrawPages(PlayState* play, GraphicsContext* gfxCtx) {
 
     if ((pauseCtx->state < 8) || (pauseCtx->state > 0x11)) {
         if (pauseCtx->state != 7) {
-            stepR = ABS(sCursorPrimR - D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].r) / D_8082AD3C;  // was D_8082AB8C [LLM:HIGH]
-            stepG = ABS(sCursorPrimG - D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].g) / D_8082AD3C;  // was D_8082AB90 [LLM:HIGH]
-            stepB = ABS(sCursorPrimB - D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].b) / D_8082AD3C;  // was D_8082AB94 [LLM:HIGH]
-            if (sCursorPrimR >= D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].r) {  // was D_8082AB8C [LLM:HIGH]
+            stepR = ABS(sCursorPrimR - D_8082ACF4[pauseCtx->cursorColorSet + sCursorColorPhase].r) / D_8082AD3C;  // was D_8082AB8C [LLM:HIGH]
+            stepG = ABS(sCursorPrimG - D_8082ACF4[pauseCtx->cursorColorSet + sCursorColorPhase].g) / D_8082AD3C;  // was D_8082AB90 [LLM:HIGH]
+            stepB = ABS(sCursorPrimB - D_8082ACF4[pauseCtx->cursorColorSet + sCursorColorPhase].b) / D_8082AD3C;  // was D_8082AB94 [LLM:HIGH]
+            if (sCursorPrimR >= D_8082ACF4[pauseCtx->cursorColorSet + sCursorColorPhase].r) {  // was D_8082AB8C [LLM:HIGH]
                 sCursorPrimR -= stepR;  // was D_8082AB8C [LLM:HIGH]
             } else {
                 sCursorPrimR += stepR;  // was D_8082AB8C [LLM:HIGH]
             }
-            if (sCursorPrimG >= D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].g) {  // was D_8082AB90 [LLM:HIGH]
+            if (sCursorPrimG >= D_8082ACF4[pauseCtx->cursorColorSet + sCursorColorPhase].g) {  // was D_8082AB90 [LLM:HIGH]
                 sCursorPrimG -= stepG;  // was D_8082AB90 [LLM:HIGH]
             } else {
                 sCursorPrimG += stepG;  // was D_8082AB90 [LLM:HIGH]
             }
-            if (sCursorPrimB >= D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].b) {  // was D_8082AB94 [LLM:HIGH]
+            if (sCursorPrimB >= D_8082ACF4[pauseCtx->cursorColorSet + sCursorColorPhase].b) {  // was D_8082AB94 [LLM:HIGH]
                 sCursorPrimB -= stepB;  // was D_8082AB94 [LLM:HIGH]
             } else {
                 sCursorPrimB += stepB;  // was D_8082AB94 [LLM:HIGH]
@@ -1492,13 +1492,13 @@ void KaleidoScope_DrawPages(PlayState* play, GraphicsContext* gfxCtx) {
 
             D_8082AD3C--;
             if (D_8082AD3C == 0) {
-                sCursorPrimR = D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].r;  // was D_8082AB8C [LLM:HIGH]
-                sCursorPrimG = D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].g;  // was D_8082AB90 [LLM:HIGH]
-                sCursorPrimB = D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].b;  // was D_8082AB94 [LLM:HIGH]
-                D_8082AD3C = ZREG(28 + D_8082AD40);
-                D_8082AD40++;
-                if (D_8082AD40 >= 4) {
-                    D_8082AD40 = 0;
+                sCursorPrimR = D_8082ACF4[pauseCtx->cursorColorSet + sCursorColorPhase].r;  // was D_8082AB8C [LLM:HIGH]
+                sCursorPrimG = D_8082ACF4[pauseCtx->cursorColorSet + sCursorColorPhase].g;  // was D_8082AB90 [LLM:HIGH]
+                sCursorPrimB = D_8082ACF4[pauseCtx->cursorColorSet + sCursorColorPhase].b;  // was D_8082AB94 [LLM:HIGH]
+                D_8082AD3C = ZREG(28 + sCursorColorPhase);  // was D_8082AD40 [LLM:HIGH]
+                sCursorColorPhase++;  // was D_8082AD40 [LLM:HIGH]
+                if (sCursorColorPhase >= 4) {  // was D_8082AD40 [LLM:HIGH]
+                    sCursorColorPhase = 0;  // was D_8082AD40 [LLM:HIGH]
                 }
             }
 
-- 
