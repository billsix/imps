From d6091553562d01c840e3972be18165a7afacd86d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:59 +0000
Subject: [PATCH 2530/3799] soh: rename D_8016B7E0 -> sSfxVolArg

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: holds the caller's volume for the duration of Audio_PlaySfxWithVolume
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index eb6c5ca40..2111087d2 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -1275,7 +1275,8 @@ FreqLerp sWaterfallFreqScaleLerp;
 f32 sRateVolScale;  // was D_8016B7D8 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8016B7DC: holds the caller's reverb for the duration of Audio_PlaySfxWithReverb
 s8 sSfxReverbArg;  // was D_8016B7DC [LLM:HIGH]
-f32 D_8016B7E0;
+// LLM generated name (HIGH), was D_8016B7E0: holds the caller's volume for the duration of Audio_PlaySfxWithVolume
+f32 sSfxVolArg;  // was D_8016B7E0 [LLM:HIGH]
 u16 D_8016B7E4; // decomp: debug only
 struct {
     s8 str[5];
@@ -1367,7 +1368,7 @@ s32 sAudioUpdateTaskEnd;      // decomp: debug only
     F(sWaterfallFreqScaleLerp)                         \
     F(sRateVolScale)                                      \
     F(sSfxReverbArg)                                      \
-    F(D_8016B7E0)                                      \
+    F(sSfxVolArg)                                      \
     F(sRiverSoundMainBgmVol)                           \
     F(sRiverSoundMainBgmCurrentVol)                    \
     F(sRiverSoundMainBgmLower)                         \
@@ -4521,8 +4522,8 @@ void Audio_PlaySfxWithReverb(Vec3f* pos, u16 sfxId, s8 arg2) {
 
 // LLM generated name (HIGH), was func_800F4578: plays a sound with a caller-supplied volume scale and default frequency and reverb
 void Audio_PlaySfxWithVolume(Vec3f* pos, u16 sfxId, f32 arg2) {
-    D_8016B7E0 = arg2;
-    Audio_PlaySfxGeneral(sfxId, pos, 4, &gSfxDefaultFreqAndVolScale, &D_8016B7E0, &gSfxDefaultReverb);
+    sSfxVolArg = arg2;  // was D_8016B7E0 [LLM:HIGH]
+    Audio_PlaySfxGeneral(sfxId, pos, 4, &gSfxDefaultFreqAndVolScale, &sSfxVolArg, &gSfxDefaultReverb);  // was D_8016B7E0 [LLM:HIGH]
 }
 
 // LLM generated name (HIGH), was func_800F45D0: drives NA_SE_IT_FISHING_REEL_SLOW on the interval timer with a rate-scaled companion sound
-- 
