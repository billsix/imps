+// LLM generated name (HIGH), was D_80865B7C: the same offset while ArmsHook_Shoot is running and the timer has not expired, placing the hook 900 units ahead.
+static Vec3f sShotHookOffset = { 0.0f, 0.0f, 900.0f };  // was D_80865B7C [LLM:HIGH]
+// LLM generated name (HIGH), was D_80865B88: the tip point handed to Player_UpdateWeaponInfo while the hook is stowed.
+static Vec3f sStowedWeaponTip = { 0.0f, 500.0f, -3000.0f };  // was D_80865B88 [LLM:HIGH]
+// LLM generated name (HIGH), was D_80865B94: the matching base point for the stowed hook's weapon quad.
+static Vec3f sStowedWeaponBase = { 0.0f, -500.0f, -3000.0f };  // was D_80865B94 [LLM:HIGH]
+// LLM generated name (HIGH), was D_80865BA0: the tip point handed to Player_UpdateWeaponInfo while the hook is in flight.
+static Vec3f sShotWeaponTip = { 0.0f, 500.0f, 1200.0f };  // was D_80865BA0 [LLM:HIGH]
+// LLM generated name (HIGH), was D_80865BAC: the matching base point for the in-flight hook's weapon quad.
+static Vec3f sShotWeaponBase = { 0.0f, -500.0f, 1200.0f };  // was D_80865BAC [LLM:HIGH]
 
 void ArmsHook_SetupAction(ArmsHook* this, ArmsHookActionFunc actionFunc) {
     this->actionFunc = actionFunc;
@@ -313,14 +319,14 @@ void ArmsHook_Draw(Actor* thisx, PlayState* play) {
         OPEN_DISPS(play->state.gfxCtx);
 
         if ((ArmsHook_Shoot != this->actionFunc) || (this->timer <= 0)) {
