Subject: [PATCH 1448/3799] soh: rename func_809784D4 -> DemoGeff_DrawNothing

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sDrawFuncs[0]: the empty draw used before the object has loaded.
Defined in soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c b/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
index ba264be07..346268966 100644
--- a/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
+++ b/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
@@ -23,7 +23,8 @@ void DemoGeff_WaitForObject(DemoGeff* this, PlayState* play);  // was func_80978
 // LLM generated name (HIGH), was func_80978308: sActionFuncs[1]: finds and follows the Demo_Gt and refreshes the rubble scale every frame.
 void DemoGeff_Active(DemoGeff* this, PlayState* play);  // was func_80978308 [LLM:HIGH]
 
-void func_809784D4(DemoGeff* this, PlayState* play);
+// LLM generated name (HIGH), was func_809784D4: sDrawFuncs[0]: the empty draw used before the object has loaded.
+void DemoGeff_DrawNothing(DemoGeff* this, PlayState* play);  // was func_809784D4 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80978344: sDrawFuncs[1]: draws gGanonRubbleDL through the shared draw helper.
 void DemoGeff_DrawRubble(DemoGeff* this, PlayState* play);  // was func_80978344 [LLM:HIGH]
 
@@ -42,7 +43,7 @@ static DemoGeffActionFunc sActionFuncs[] = {
 };
 
 static DemoGeffDrawFunc sDrawFuncs[] = {
-    func_809784D4,
+    DemoGeff_DrawNothing,  // was func_809784D4 [LLM:HIGH]
     DemoGeff_DrawRubble,  // was func_80978344 [LLM:HIGH]
 };
 
@@ -219,7 +220,7 @@ void DemoGeff_Update(Actor* thisx, PlayState* play) {
     sActionFuncs[this->action](this, play);
 }
 
-void func_809784D4(DemoGeff* this, PlayState* play) {
+void DemoGeff_DrawNothing(DemoGeff* this, PlayState* play) {
 }
 
 void DemoGeff_Draw(Actor* thisx, PlayState* play) {
