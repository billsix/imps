From bdf85694bb7786eb1968467b7d862e36555c92c9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:12:03 +0000
Subject: [PATCH 0519/3799] soh: rename func_800C24BC ->
 PreRender_RestoreFramebuffer

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.98.
Defined in soh/src/code/PreRender.c.
---
 soh/include/functions.h  | 2 +-
 soh/src/code/PreRender.c | 3 ++-
 soh/src/code/z_play.c    | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 70f5522df..6cd6bec8a 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1589,7 +1589,7 @@ void PreRender_FetchFbufCoverage(PreRender* this, Gfx** gfxp);  // was func_800C
 void PreRender_DrawCoverage(PreRender* this, Gfx** gfxp);  // was func_800C20B4 [oot]
 void PreRender_RestoreZBuffer(PreRender* this, Gfx** gfxp);  // was func_800C2118 [oot]
 void func_800C213C(PreRender* this, Gfx** gfxp);
-void func_800C24BC(PreRender* this, Gfx** gfxp);
+void PreRender_RestoreFramebuffer(PreRender* this, Gfx** gfxp);  // was func_800C24BC [oot]
 void func_800C24E0(PreRender* this, Gfx** gfxp);
 void PreRender_AntiAliasFilter(PreRender* this, s32 x, s32 y);  // was func_800C2500 [oot]
 void func_800C2FE4(PreRender* this);
diff --git a/soh/src/code/PreRender.c b/soh/src/code/PreRender.c
index d2c9fc81b..e95105041 100644
--- a/soh/src/code/PreRender.c
+++ b/soh/src/code/PreRender.c
@@ -352,7 +352,8 @@ void func_800C213C(PreRender* this, Gfx** gfxp) {
     }
 }
 
-void func_800C24BC(PreRender* this, Gfx** gfxp) {
+// Name from zeldaret/oot (was func_800C24BC): adopted upstream's name for this address; body verified to match upstream at 0.98. [oot: https://github.com/zeldaret/oot/blob/main/src/code/PreRender.c]
+void PreRender_RestoreFramebuffer(PreRender* this, Gfx** gfxp) {
     PreRender_CopyImage(this, gfxp, this->fbufSave, this->fbuf);
 }
 
diff --git a/soh/src/code/z_play.c b/soh/src/code/z_play.c
index 3a3c98720..2d4c1f9c8 100644
--- a/soh/src/code/z_play.c
+++ b/soh/src/code/z_play.c
@@ -1448,7 +1448,7 @@ void Play_Draw(PlayState* play) {
             Gfx* gfxP = POLY_OPA_DISP;
 
             // SOH [Port] Draw game framebuffer using our custom handling
-            // func_800C24BC(&play->pauseBgPreRender, &gfxP);
+            // PreRender_RestoreFramebuffer(&play->pauseBgPreRender, &gfxP);
             FB_DrawFromFramebuffer(&gfxP, gPauseFrameBuffer, 255);
             POLY_OPA_DISP = gfxP;
 
-- 
