From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:58 +0000
Subject: [PATCH 3791/3799] soh: rename func_80B59768 ->
 EnZl3_ShouldPlayRevengeSfx

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same test as EnZl3_ShouldStartCollapseEscape without the SUBTIMER_STATE_OFF allowance, so it fires only when the timer actually ran out
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 97eb15cb0..454c6f1c3 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -2702,7 +2702,8 @@ s32 EnZl3_ShouldStartCollapseEscape(EnZl3* this, PlayState* play) {
     return 0;
 }
 
-s32 func_80B59768(EnZl3* this, PlayState* play) {
+// LLM generated name (GUESS), was func_80B59768: the same test as EnZl3_ShouldStartCollapseEscape without the SUBTIMER_STATE_OFF allowance, so it fires only when the timer actually ran out
+s32 EnZl3_ShouldPlayRevengeSfx(EnZl3* this, PlayState* play) {
     s32 cond = Flags_GetSwitch(play, 0x37) &&
                ((play->sceneNum == SCENE_GANON_BOSS) || (play->sceneNum == SCENE_GANONS_TOWER_COLLAPSE_EXTERIOR) ||
                 (play->sceneNum == SCENE_GANONS_TOWER_COLLAPSE_INTERIOR) ||
@@ -2773,7 +2774,7 @@ void func_80B59828(EnZl3* this, PlayState* play) {
 }
 
 void func_80B59A80(EnZl3* this, PlayState* play) {
-    if (func_80B59768(this, play)) {
+    if (EnZl3_ShouldPlayRevengeSfx(this, play)) {  // was func_80B59768 [LLM:GUESS]
         Audio_PlaySfxGeneral(NA_SE_OC_REVENGE, &gSfxDefaultPos, 4, &gSfxDefaultFreqAndVolScale,
                              &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
     }
