From 82fedb42a560ffd00b9120ddfae5c906568b2d50 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:30 +0000
Subject: [PATCH 172/225] soh: rename D_809CE3EC -> sHeightAmpSinB_FlyAround

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c b/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
index a829bde73..05d6359bb 100644
--- a/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
+++ b/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
@@ -188,10 +188,11 @@ void EnButte_Destroy(Actor* thisx, PlayState* play2) {
 void EnButte_UpdateHeightFlyAround(EnButte* this) {
     // LLM generated name (HIGH), was D_809CE3E0: sine amplitude A for FlyAround height bob, indexed by flightParamsIdx.
     static f32 sHeightAmpSinA_FlyAround[] = { 50.0f, 80.0f, 100.0f };
-    static f32 D_809CE3EC[] = { 30.0f, 40.0f, 50.0f };
+    // LLM generated name (HIGH), was D_809CE3EC: sine amplitude B for FlyAround height bob.
+    static f32 sHeightAmpSinB_FlyAround[] = { 30.0f, 40.0f, 50.0f };
 
     this->actor.shape.yOffset += Math_SinS(this->unk_25C) * sHeightAmpSinA_FlyAround[this->flightParamsIdx] +
-                                 Math_SinS(this->unk_25E) * D_809CE3EC[this->flightParamsIdx];
+                                 Math_SinS(this->unk_25E) * sHeightAmpSinB_FlyAround[this->flightParamsIdx];
     this->actor.shape.yOffset = CLAMP(this->actor.shape.yOffset, -2000.0f, 2000.0f);
 }
 
