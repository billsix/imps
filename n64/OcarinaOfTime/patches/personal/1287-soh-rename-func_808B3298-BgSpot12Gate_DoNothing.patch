From 356e2ed8823172b415fa0adf4be6c741218106ad Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:08:02 +0000
Subject: [PATCH 1287/3799] soh: rename func_808B3298 -> BgSpot12Gate_DoNothing

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the empty terminal action installed once the gate is open.
Defined in soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c b/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
index 86d12fc5a..265559b59 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
@@ -28,7 +28,8 @@ void BgSpot12Gate_SetupOpen(BgSpot12Gate* this);  // was func_808B317C [LLM:HIGH
 void BgSpot12Gate_Open(BgSpot12Gate* this, PlayState* play);  // was func_808B318C [LLM:HIGH]
 // LLM generated name (HIGH), was func_808B3274: snaps the gate to its fully-open height; Init uses it when the switch flag is already set.
 void BgSpot12Gate_SetupOpened(BgSpot12Gate* this);  // was func_808B3274 [LLM:HIGH]
-void func_808B3298(BgSpot12Gate* this, PlayState* play);
+// LLM generated name (HIGH), was func_808B3298: the empty terminal action installed once the gate is open.
+void BgSpot12Gate_DoNothing(BgSpot12Gate* this, PlayState* play);  // was func_808B3298 [LLM:HIGH]
 
 const ActorInit Bg_Spot12_Gate_InitVars = {
     ACTOR_BG_SPOT12_GATE,
@@ -129,11 +130,11 @@ void BgSpot12Gate_Open(BgSpot12Gate* this, PlayState* play) {
 }
 
 void BgSpot12Gate_SetupOpened(BgSpot12Gate* this) {
-    this->actionFunc = func_808B3298;
+    this->actionFunc = BgSpot12Gate_DoNothing;  // was func_808B3298 [LLM:HIGH]
     this->dyna.actor.world.pos.y = this->dyna.actor.home.pos.y + 200.0f;
 }
 
-void func_808B3298(BgSpot12Gate* this, PlayState* play) {
+void BgSpot12Gate_DoNothing(BgSpot12Gate* this, PlayState* play) {
 }
 
 void BgSpot12Gate_Update(Actor* thisx, PlayState* play) {
