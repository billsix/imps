     if (Math_StepToF(&this->dyna.actor.world.pos.y, this->dyna.actor.home.pos.y, 1.0f)) {
-        this->actionFunc = func_8088B634;
+        this->actionFunc = BgHidanRock_WaitForPlayer;  // was func_8088B634 [LLM:HIGH]
     }
 }
 
