# The upstream checkout is disposable — only the scripts, patches/, Makefile,
# Dockerfile and docs are versioned. checkout/ is re-created by fetch.sh and
# patched by apply.sh; its Cargo build output (target/) lives inside it.
/checkout/

# Cargo build output, if a build ever lands outside the checkout.
/target/

# Podman image export tarballs (Makefile image-export) — large, never commit.
ripgrep-doc-builder-*.tar

# check-comment-only scratch (binary hashes / stripped-token diffs)
/.check-comment-only/

# Python bytecode cache from check_comment_only.py
__pycache__/
