From 4d6eaed4fe8bbec59cbd256797e490d19483f021 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:08 +0000
Subject: [PATCH 2424/3799] soh: rename func_80ADE4C8 -> EnPoh_SetupSpinAway

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays the idle animation once while backing off at -5 speed
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index a1b45889d..9b6c6d606 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -346,7 +346,8 @@ void EnPoh_SetupDissolve(EnPoh* this) {
     this->actionFunc = func_80ADF15C;
 }
 
-void func_80ADE4C8(EnPoh* this) {
+// LLM generated name (HIGH), was func_80ADE4C8: plays the idle animation once while backing off at -5 speed
+void EnPoh_SetupSpinAway(EnPoh* this) {
     Animation_PlayOnce(&this->skelAnime, this->info->idleAnim2);
     this->actionFunc = func_80ADF574;
     this->actor.speedXZ = -5.0f;
@@ -999,7 +1000,7 @@ void EnPoh_UpdateLiving(Actor* thisx, PlayState* play) {
 
     if (this->colliderSph.base.atFlags & AT_HIT) {
         this->colliderSph.base.atFlags &= ~AT_HIT;
-        func_80ADE4C8(this);
+        EnPoh_SetupSpinAway(this);  // was func_80ADE4C8 [LLM:HIGH]
     }
     func_80AE032C(this, play);
     EnPoh_UpdateVisibility(this);
-- 
