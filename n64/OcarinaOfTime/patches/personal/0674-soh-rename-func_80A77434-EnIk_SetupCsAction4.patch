From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:27 +0000
Subject: [PATCH 0674/3799] soh: rename func_80A77434 -> EnIk_SetupCsAction4

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index b36e9d49b..7b2c4fbbe 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -1181,7 +1181,8 @@ void EnIk_SetupCsAction3(EnIk* this, PlayState* play) {
     this->actor.shape.shadowAlpha = 0xFF;
 }
 
-void func_80A77434(EnIk* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80A77434): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ik/z_en_ik.c]
+void EnIk_SetupCsAction4(EnIk* this, PlayState* play) {
     this->action = 4;
     this->drawMode = 2;
     func_80A772A4(this);
@@ -1309,7 +1310,7 @@ void func_80A779DC(EnIk* this, PlayState* play) {
                     EnIk_SetupCsAction3(this, play);
                     break;
                 case 6:
-                    func_80A77434(this, play);
+                    EnIk_SetupCsAction4(this, play);
                     break;
                 case 7:
                     func_80A77474(this, play);
