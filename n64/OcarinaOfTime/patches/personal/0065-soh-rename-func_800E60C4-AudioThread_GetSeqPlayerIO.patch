From ed31fa0a948a0d3741e8730241ff1ee3f881a2ce Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:17 +0000
Subject: [PATCH 065/784] soh: rename func_800E60C4 ->
 AudioThread_GetSeqPlayerIO

Name source: zeldaret/oot.
Defined in soh/src/code/audio_thread.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_thread.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/audio_thread.c b/soh/src/code/audio_thread.c
index 4d89a13f7..a3ad2533e 100644
--- a/soh/src/code/audio_thread.c
+++ b/soh/src/code/audio_thread.c
@@ -614,7 +614,8 @@ s8 AudioThread_GetChannelIO(s32 playerIdx, s32 channelIdx, s32 scriptIdx) {
     }
 }
 
-s8 func_800E60C4(s32 playerIdx, s32 arg1) {
+// Name from zeldaret/oot, was func_800E60C4: reads seqPlayer soundScriptIO[arg1] [oot: https://github.com/zeldaret/oot/blob/main/src/audio/internal/thread.c]
+s8 AudioThread_GetSeqPlayerIO(s32 playerIdx, s32 arg1) {
     return gAudioContext.seqPlayers[playerIdx].soundScriptIO[arg1];
 }
 
