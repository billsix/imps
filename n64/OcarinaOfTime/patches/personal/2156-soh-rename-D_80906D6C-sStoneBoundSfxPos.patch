+                Sfx_PlaySfxAtPos(&sStoneBoundSfxPos, NA_SE_EV_STONE_BOUND);  // was D_80906D6C [LLM:HIGH]
                 Audio_QueueSeqCmd(SEQ_PLAYER_BGM_MAIN << 24 | NA_BGM_STOP);
