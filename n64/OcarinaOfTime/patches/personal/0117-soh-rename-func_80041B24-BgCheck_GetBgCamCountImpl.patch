From be27a52dadd69e4e5aee388d13fe6c6db0958dad Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:07 +0000
Subject: [PATCH 117/488] soh: rename func_80041B24 ->
 BgCheck_GetBgCamCountImpl

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 0.98.
Defined in soh/src/code/z_bgcheck.c.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/code/z_bgcheck.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_bgcheck.c b/soh/src/code/z_bgcheck.c
index e233d1a99..cd68edb4e 100644
--- a/soh/src/code/z_bgcheck.c
+++ b/soh/src/code/z_bgcheck.c
@@ -3918,7 +3918,8 @@ u16 SurfaceType_GetCameraSType(CollisionContext* colCtx, CollisionPoly* poly, s3
 /**
  * CamData Get number of cameras
  */
-u16 func_80041B24(CollisionContext* colCtx, u32 camId, s32 bgId) {
+// Name from zeldaret/oot (was func_80041B24): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.98. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_bgcheck.c]
+u16 BgCheck_GetBgCamCountImpl(CollisionContext* colCtx, u32 camId, s32 bgId) {
     CollisionHeader* colHeader = BgCheck_GetCollisionHeader(colCtx, bgId);
     CamData* camData;
 
@@ -3952,7 +3953,7 @@ u16 SurfaceType_GetNumCameras(CollisionContext* colCtx, CollisionPoly* poly, s32
     if (surfaceTypes == PHYSICAL_TO_VIRTUAL(gSegments[0])) {
         return 0;
     }
-    return func_80041B24(colCtx, SurfaceType_GetCamDataIndex(colCtx, poly, bgId), bgId);
+    return BgCheck_GetBgCamCountImpl(colCtx, SurfaceType_GetCamDataIndex(colCtx, poly, bgId), bgId);
 }
 
