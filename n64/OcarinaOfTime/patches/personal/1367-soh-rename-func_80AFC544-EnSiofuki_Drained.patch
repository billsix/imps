From 74a4f16564410c01297dcb004f812210c29eee0a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:13:14 +0000
Subject: [PATCH 1367/3799] soh: rename func_80AFC544 -> EnSiofuki_Drained

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the terminal state entered once the room's chest has been opened: the geyser stays at its lowest height and no longer pushes the player.
Defined in soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Siofuki/z_en_siofuki.c   | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c b/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
index 3ae2f6004..940b4738b 100644
--- a/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
+++ b/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
@@ -17,7 +17,8 @@ void EnSiofuki_Draw(Actor* thisx, PlayState* play);
 
 // LLM generated name (HIGH), was func_80AFC34C: the raising type's idle at height 10: waits for its switch flag, then targets full height and arms the 300-frame timer.
 void EnSiofuki_WaitLow(EnSiofuki* this, PlayState* play);  // was func_80AFC34C [LLM:HIGH]
-void func_80AFC544(EnSiofuki* this, PlayState* play);
+// LLM generated name (HIGH), was func_80AFC544: the terminal state entered once the room's chest has been opened: the geyser stays at its lowest height and no longer pushes the player.
+void EnSiofuki_Drained(EnSiofuki* this, PlayState* play);  // was func_80AFC544 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AFC478: the lowering type's idle at full height: waits for its switch flag, then starts the pause and the one-point cutscene that shows the water dropping.
 void EnSiofuki_WaitHigh(EnSiofuki* this, PlayState* play);  // was func_80AFC478 [LLM:HIGH]
 
@@ -94,7 +95,7 @@ void EnSiofuki_Init(Actor* thisx, PlayState* play) {
         if (Flags_GetTreasure(play, (u16)thisx->params & 0x3F)) {
             this->currentHeight = -45.0f;
             this->targetHeight = -45.0f;
-            this->actionFunc = func_80AFC544;
+            this->actionFunc = EnSiofuki_Drained;  // was func_80AFC544 [LLM:HIGH]
         } else {
             this->targetHeight = this->currentHeight;
             this->actionFunc = EnSiofuki_WaitHigh;  // was func_80AFC478 [LLM:HIGH]
@@ -220,7 +221,7 @@ void EnSiofuki_Active(EnSiofuki* this, PlayState* play) {
         this->currentHeight = -45.0f;
         this->targetHeight = -45.0f;
         Flags_UnsetSwitch(play, ((u16)this->dyna.actor.params >> 6) & 0x3F);
-        this->actionFunc = func_80AFC544;
+        this->actionFunc = EnSiofuki_Drained;  // was func_80AFC544 [LLM:HIGH]
     }
 }
 
@@ -252,7 +253,7 @@ void EnSiofuki_Delay(EnSiofuki* this, PlayState* play) {
     if (Flags_GetTreasure(play, (u16)this->dyna.actor.params & 0x3F)) {
         this->currentHeight = -45.0f;
         this->targetHeight = -45.0f;
-        this->actionFunc = func_80AFC544;
+        this->actionFunc = EnSiofuki_Drained;  // was func_80AFC544 [LLM:HIGH]
     }
 }
 
@@ -271,12 +272,12 @@ void EnSiofuki_WaitHigh(EnSiofuki* this, PlayState* play) {
         if (Flags_GetTreasure(play, (u16)this->dyna.actor.params & 0x3F)) {
             this->currentHeight = -45.0f;
             this->targetHeight = -45.0f;
-            this->actionFunc = func_80AFC544;
+            this->actionFunc = EnSiofuki_Drained;  // was func_80AFC544 [LLM:HIGH]
         }
     }
 }
 
-void func_80AFC544(EnSiofuki* this, PlayState* play) {
+void EnSiofuki_Drained(EnSiofuki* this, PlayState* play) {
     EnSiofuki_UpdateOscillation(this, play);  // was func_80AFBDC8 [LLM:HIGH]
     EnSiofuki_ApproachTargetHeight(this, play);  // was func_80AFC1D0 [LLM:HIGH]
 }
