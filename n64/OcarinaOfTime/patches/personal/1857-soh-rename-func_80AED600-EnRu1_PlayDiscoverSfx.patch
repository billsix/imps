     Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_VO_RT_UNBALLANCE);
 }
 
-void func_80AED600(EnRu1* this) {
+// LLM generated name (HIGH), was func_80AED600: plays Ruto's discovery voice clip, used when she spots the sapphire.
