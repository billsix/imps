From c55f2da5122912cb4eb7d2733bf44ac9a064fc88 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:36 +0000
Subject: [PATCH 3061/3799] soh: rename D_80120760 -> sCs6001EyePointsAlt

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the second eye point set 6001 chooses between
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index d7508dda4..925082cab 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -680,7 +680,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             if (spA0.pos.z > -750.0f) {
                 OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, sCs6001AtPoints, D_80120820);  // was D_801206A0 [LLM:HIGH]
             } else {
-                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, sCs6001AtPoints, D_80120760);  // was D_801206A0 [LLM:HIGH]
+                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, sCs6001AtPoints, sCs6001EyePointsAlt);  // was D_801206A0 [LLM:HIGH]
             }
 
             i = Quake_Add(csCam, 1);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index bec4cca90..c157e45cd 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -115,7 +115,8 @@ static CutsceneCameraPoint sCs6001AtPoints[12] = {  // was D_801206A0 [LLM:HIGH]
     { CS_CMD_CONTINUE, 1, 200, 65.0f, { 0, 17, 82 } },   { CS_CMD_CONTINUE, 1, 500, 65.0f, { 0, 18, 82 } },
     { CS_CMD_STOP, 8, 50, 65.0f, { 0, 18, 82 } },        { CS_CMD_STOP, 11, 60, 65.0f, { 0, 18, 82 } },
 };
-static CutsceneCameraPoint D_80120760[12] = {
+// LLM generated name (HIGH), was D_80120760: the second eye point set 6001 chooses between
+static CutsceneCameraPoint sCs6001EyePointsAlt[12] = {  // was D_80120760 [LLM:HIGH]
     { CS_CMD_CONTINUE, 6, 0, 80.0f, { -50, 10, 180 } }, { CS_CMD_CONTINUE, 6, 0, 80.0f, { -50, 20, 180 } },
     { CS_CMD_CONTINUE, 6, 0, 70.0f, { -40, 30, 177 } }, { CS_CMD_CONTINUE, 5, 0, 65.0f, { 0, 35, 172 } },
     { CS_CMD_CONTINUE, 4, 0, 65.0f, { 34, 35, 162 } },  { CS_CMD_CONTINUE, 3, 0, 65.0f, { 61, 32, 147 } },
