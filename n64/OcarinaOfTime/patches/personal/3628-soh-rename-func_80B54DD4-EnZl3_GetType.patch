From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:41 +0000
Subject: [PATCH 3628/3799] soh: rename func_80B54DD4 -> EnZl3_GetType

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: params & 0xF -- selects which of the three inits (inFinal, inFinal2, collapse) EnZl3_InitByType runs
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 16f1fd1a8..5f9b6da51 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -772,7 +772,8 @@ s32 EnZl3_GetPathIndex(EnZl3* this) {
     return params & 0xF;
 }
 
-s32 func_80B54DD4(EnZl3* this) {
+// LLM generated name (HIGH), was func_80B54DD4: params & 0xF -- selects which of the three inits (inFinal, inFinal2, collapse) EnZl3_InitByType runs
+s32 EnZl3_GetType(EnZl3* this) {
     s32 params = this->actor.params;
 
     return params & 0xF;
@@ -2633,7 +2634,7 @@ void func_80B59AD0(EnZl3* this, PlayState* play) {
 }
 
 void func_80B59B6C(EnZl3* this, PlayState* play) {
-    s32 sp2C = func_80B54DD4(this);
+    s32 sp2C = EnZl3_GetType(this);  // was func_80B54DD4 [LLM:HIGH]
 
     this->unk_3DC = Animation_GetLastFrame(SEGMENTED_TO_VIRTUAL(&gZelda2Anime2Anim_0091D8));
     this->unk_3E0 = Animation_GetLastFrame(SEGMENTED_TO_VIRTUAL(&gZelda2Anime2Anim_00A598));
@@ -2707,7 +2708,7 @@ void EnZl3_Init(Actor* thisx, PlayState* play) {
     EnZl3_InitCollider(thisx, play);  // was func_80B533B0 [LLM:HIGH]
     SkelAnime_InitFlex(play, &this->skelAnime, &gZelda2Skel, NULL, this->jointTable, this->morphTable, 15);
 
-    switch (func_80B54DD4(this)) {
+    switch (EnZl3_GetType(this)) {  // was func_80B54DD4 [LLM:HIGH]
         case 1:
             gSaveContext.subTimerState = SUBTIMER_STATE_OFF;
             break;
