From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:37 +0000
Subject: [PATCH 2785/3799] soh: rename func_80037C5C -> Actor_OnTextClosed

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: runs the flag updates for a text that just closed
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 9960fe473..7ae5cf8d0 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -6370,7 +6370,8 @@ u16 Actor_GetTextId(PlayState* play, s16 arg1) {
     return Actor_GetNpcTextId(play, arg1);  // was func_80035BFC [LLM:HIGH]
 }
 
-s32 func_80037C5C(PlayState* play, s16 arg1, u16 textId) {
+// LLM generated name (HIGH), was func_80037C5C: runs the flag updates for a text that just closed
+s32 Actor_OnTextClosed(PlayState* play, s16 arg1, u16 textId) {
     Actor_SetNpcTextFlags(textId, arg1);  // was func_80036E50 [LLM:HIGH]
     return false;
 }
@@ -6385,7 +6386,7 @@ s32 func_80037CB8(PlayState* play, Actor* actor, s16 arg2) {
 
     switch (Message_GetState(msgCtx)) {
         case TEXT_STATE_CLOSING:
-            func_80037C5C(play, arg2, actor->textId);
+            Actor_OnTextClosed(play, arg2, actor->textId);  // was func_80037C5C [LLM:HIGH]
             ret = true;
             break;
         case TEXT_STATE_CHOICE:
