From 4a7a4f0884bd1e719836d457cb1301a1441a0a96 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:08 +0000
Subject: [PATCH 2425/3799] soh: rename func_80ADE514 -> EnPoh_SetupTurnAround

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: records the opposite heading and stops while the poe turns onto it
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index 9b6c6d606..3169917e2 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -353,7 +353,8 @@ void EnPoh_SetupSpinAway(EnPoh* this) {
     this->actor.speedXZ = -5.0f;
 }
 
-void func_80ADE514(EnPoh* this) {
+// LLM generated name (HIGH), was func_80ADE514: records the opposite heading and stops while the poe turns onto it
+void EnPoh_SetupTurnAround(EnPoh* this) {
     Animation_PlayLoop(&this->skelAnime, this->info->idleAnim);
     this->unk_19C = this->actor.world.rot.y + 0x8000;
     this->actionFunc = func_80ADF5E0;
@@ -514,7 +515,7 @@ void EnPoh_Idle(EnPoh* this, PlayState* play) {
         EnPoh_SetupApproach(this);  // was func_80ADE1BC [LLM:HIGH]
     } else if (this->unk_198 == 0) {
         if (Rand_ZeroOne() < 0.1f) {
-            func_80ADE514(this);
+            EnPoh_SetupTurnAround(this);  // was func_80ADE514 [LLM:HIGH]
         } else {
             EnPoh_SetupHover(this);  // was func_80ADE114 [LLM:HIGH]
         }
