From 58bb106811406a11dec09b13262d0727281d498d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:08 +0000
Subject: [PATCH 2422/3799] soh: rename func_80ADE368 -> EnPoh_SetupFlee

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: morphs to the flee animation, turns away from the player and arms the 200-frame retreat
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index ae56550e0..fa8e2d030 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -311,7 +311,8 @@ void EnPoh_SetupDamage(EnPoh* this) {
     this->actionFunc = func_80ADEECC;
 }
 
-void func_80ADE368(EnPoh* this) {
+// LLM generated name (HIGH), was func_80ADE368: morphs to the flee animation, turns away from the player and arms the 200-frame retreat
+void EnPoh_SetupFlee(EnPoh* this) {
     Animation_MorphToLoop(&this->skelAnime, this->info->fleeAnim, -5.0f);
     this->actor.speedXZ = 5.0f;
     this->actor.world.rot.y = this->actor.shape.rot.y + 0x8000;
@@ -574,7 +575,7 @@ void func_80ADEECC(EnPoh* this, PlayState* play) {
     Math_StepToF(&this->actor.speedXZ, 0.0f, 0.5f);
     if (SkelAnime_Update(&this->skelAnime)) {
         if (this->actor.colChkInfo.health != 0) {
-            func_80ADE368(this);
+            EnPoh_SetupFlee(this);  // was func_80ADE368 [LLM:HIGH]
         } else {
             func_80ADE48C(this);
         }
