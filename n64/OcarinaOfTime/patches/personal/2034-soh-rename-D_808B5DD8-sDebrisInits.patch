From f06b2d6e2ae23abd27c0d690bc45736be5a52b08 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:09:37 +0000
Subject: [PATCH 2034/3799] soh: rename D_808B5DD8 -> sDebrisInits

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: one ten-value row per debris params: speed, y velocity, scale, the two tumble rates, yaw, height and the three shape rotations
Defined in soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../z_bg_spot16_bombstone.c                   | 23 ++++++++++---------
 1 file changed, 12 insertions(+), 11 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c b/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
index 61992835c..a7d4a6af3 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
@@ -33,7 +33,8 @@ static EnBombf* sPlayerBomb = NULL;
 
 static s16 sTimer = 0;
 
-static s16 D_808B5DD8[][10] = {
+// LLM generated name (HIGH), was D_808B5DD8: one ten-value row per debris params: speed, y velocity, scale, the two tumble rates, yaw, height and the three shape rotations
+static s16 sDebrisInits[][10] = {  // was D_808B5DD8 [LLM:HIGH]
     { 0x0008, 0x0004, 0x0046, 0x07D0, 0xFCE0, 0x0000, 0x0064, 0x0000, 0x0000, 0x0000 },
     { 0x0006, 0x0003, 0x0032, 0x00C8, 0x0A28, 0xC350, 0x005A, 0x0000, 0x0000, 0x0000 },
     { 0x0005, 0x0003, 0x0028, 0xF63C, 0x0190, 0x30B0, 0x0032, 0x0000, 0x0000, 0x0000 },
@@ -209,26 +210,26 @@ s32 BgSpot16Bombstone_InitDebris(BgSpot16Bombstone* this, PlayState* play) {
 
     Actor_ProcessInitChain(actor, sInitChainDebris);
 
-    actor->speedXZ = D_808B5DD8[actor->params][0];
-    actor->velocity.y = D_808B5DD8[actor->params][1];
+    actor->speedXZ = sDebrisInits[actor->params][0];  // was D_808B5DD8 [LLM:HIGH]
+    actor->velocity.y = sDebrisInits[actor->params][1];  // was D_808B5DD8 [LLM:HIGH]
 
-    Actor_SetScale(actor, D_808B5DD8[actor->params][2] * scaleFactor);
+    Actor_SetScale(actor, sDebrisInits[actor->params][2] * scaleFactor);  // was D_808B5DD8 [LLM:HIGH]
 
-    this->unk_210 = (f32)D_808B5DD8[actor->params][3];
-    this->unk_212 = (f32)D_808B5DD8[actor->params][4];
+    this->unk_210 = (f32)sDebrisInits[actor->params][3];  // was D_808B5DD8 [LLM:HIGH]
+    this->unk_212 = (f32)sDebrisInits[actor->params][4];  // was D_808B5DD8 [LLM:HIGH]
 
-    actor->world.rot.y = D_808B5DD8[actor->params][5];
+    actor->world.rot.y = sDebrisInits[actor->params][5];  // was D_808B5DD8 [LLM:HIGH]
 
     sinValue = Math_SinS(this->actor.world.rot.y);
     cosValue = Math_CosS(this->actor.world.rot.y);
 
     actor->world.pos.x = (sinValue * sinCosPosFactor) + actor->home.pos.x;
-    actor->world.pos.y = D_808B5DD8[actor->params][6] + actor->home.pos.y;
+    actor->world.pos.y = sDebrisInits[actor->params][6] + actor->home.pos.y;  // was D_808B5DD8 [LLM:HIGH]
     actor->world.pos.z = (cosValue * sinCosPosFactor) + actor->home.pos.z;
 
-    actor->shape.rot.x = D_808B5DD8[actor->params][7];
-    actor->shape.rot.y = D_808B5DD8[actor->params][8];
-    actor->shape.rot.z = D_808B5DD8[actor->params][9];
+    actor->shape.rot.x = sDebrisInits[actor->params][7];  // was D_808B5DD8 [LLM:HIGH]
+    actor->shape.rot.y = sDebrisInits[actor->params][8];  // was D_808B5DD8 [LLM:HIGH]
+    actor->shape.rot.z = sDebrisInits[actor->params][9];  // was D_808B5DD8 [LLM:HIGH]
 
     this->dList = object_bombiwa_DL_0009E0;
     this->bombiwaBankIndex = Object_GetIndex(&play->objectCtx, OBJECT_BOMBIWA);
