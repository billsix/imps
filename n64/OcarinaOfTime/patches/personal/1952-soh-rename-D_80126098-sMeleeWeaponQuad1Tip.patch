From 9f1d57edc7ccac653f41e36cb9840d3013ebe389 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:05:34 +0000
Subject: [PATCH 1952/3799] soh: rename D_80126098 -> sMeleeWeaponQuad1Tip

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: tip of the second sweep quad, sharing sMeleeWeaponQuad0Tip's x
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index 9fe2a36b7..5d16951fd 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1574,7 +1574,8 @@ void Player_UpdateShieldCollider(PlayState* play, Player* this, ColliderQuad* co
 Vec3f sMeleeWeaponBladeTip = { 5000.0f, 400.0f, 0.0f };  // was D_80126080 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8012608C: tip of the first sweep quad; its x tracks the blade length plus 1200 and the spin-attack stretch
 Vec3f sMeleeWeaponQuad0Tip = { 5000.0f, -400.0f, 1000.0f };  // was D_8012608C [LLM:HIGH]
-Vec3f D_80126098 = { 5000.0f, 1400.0f, -1000.0f };
+// LLM generated name (HIGH), was D_80126098: tip of the second sweep quad, sharing sMeleeWeaponQuad0Tip's x
+Vec3f sMeleeWeaponQuad1Tip = { 5000.0f, 1400.0f, -1000.0f };  // was D_80126098 [LLM:HIGH]
 
 Vec3f D_801260A4[3] = {
     { 0.0f, 400.0f, 0.0f },
@@ -1706,11 +1707,11 @@ void Player_CalcMeleeWeaponTipPositions(Player* this, Vec3f* vecs) {
     }
 
     sMeleeWeaponQuad0Tip.x += 1200.0f;  // was D_8012608C [LLM:HIGH]
-    D_80126098.x = sMeleeWeaponQuad0Tip.x;  // was D_8012608C [LLM:HIGH]
+    sMeleeWeaponQuad1Tip.x = sMeleeWeaponQuad0Tip.x;  // was D_8012608C [LLM:HIGH]
 
     Matrix_MultVec3f(&sMeleeWeaponBladeTip, &vecs[0]);  // was D_80126080 [LLM:HIGH]
     Matrix_MultVec3f(&sMeleeWeaponQuad0Tip, &vecs[1]);  // was D_8012608C [LLM:HIGH]
-    Matrix_MultVec3f(&D_80126098, &vecs[2]);
+    Matrix_MultVec3f(&sMeleeWeaponQuad1Tip, &vecs[2]);  // was D_80126098 [LLM:HIGH]
 }
 
 void Player_DrawHookshotReticle(PlayState* play, Player* this, f32 hookshotRange) {
-- 
