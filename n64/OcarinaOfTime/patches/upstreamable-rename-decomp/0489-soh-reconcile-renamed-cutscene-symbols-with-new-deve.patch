-            func_800C08AC(gPlayState, fd2->deathCamera, 0);
+            Play_ReturnToMainCam(gPlayState, fd2->deathCamera, 0);
             fd2->deathCamera = 0;
-            func_80064534(gPlayState, &gPlayState->csCtx);
+            Cutscene_StopManual(gPlayState, &gPlayState->csCtx);
             Player_SetCsActionWithHaltedActors(gPlayState, &fd2->actor, 7);
 
             if (GameInteractor_Should(VB_SPAWN_BLUE_WARP, true, fd2)) {
@@ -159,9 +159,9 @@ void RegisterQuickBossDeaths() {
             mainCam->eye = core->cameraEye;
             mainCam->eyeNext = core->cameraEye;
             mainCam->at = core->cameraAt;
-            func_800C08AC(gPlayState, core->csCamera, 0);
+            Play_ReturnToMainCam(gPlayState, core->csCamera, 0);
             core->csCamera = 0;
-            func_80064534(gPlayState, &gPlayState->csCtx);
+            Cutscene_StopManual(gPlayState, &gPlayState->csCtx);
             Player_SetCsActionWithHaltedActors(gPlayState, &core->actor, 7);
 
             if (GameInteractor_Should(VB_SPAWN_BLUE_WARP, true, tent)) {
diff --git a/soh/src/code/audio_thread.c b/soh/src/code/audio_thread.c
index 342bf776f..194b27dce 100644
--- a/soh/src/code/audio_thread.c
+++ b/soh/src/code/audio_thread.c
@@ -524,8 +524,8 @@ u32 AudioThread_GetExternalLoadQueueMsg(u32* out) {
     return sp1C >> 0x18;
 }
 
-u16* AudioThread_GetFontsForSequence(s32 arg0, u32* arg1) {
 // Name from zeldaret/oot, was func_800E5E84: forwards to AudioLoad_GetFontsForSequence [oot: https://github.com/zeldaret/oot/blob/main/src/audio/internal/thread.c]
+u16* AudioThread_GetFontsForSequence(s32 arg0, u32* arg1) {
     return AudioLoad_GetFontsForSequence(arg0, arg1);
 }
 
