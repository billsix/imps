From 427dc2b572993d625cb41ea1fc0a6aedb9dee0a7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:38:48 +0000
Subject: [PATCH 1710/3799] soh: rename D_80AFA120 -> sBlobRowsClass4

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-row half-widths of the largest brush, used for size class 4.
Defined in soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
index d1ece6f08..000e915b5 100644
--- a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
+++ b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
@@ -52,7 +52,8 @@ static s16 sBlobRowsClass2[] = {  // was D_80AFA108 [LLM:HIGH]
     2, 4, 5, 5, 6, 6, 6, 6, 5, 5, 4, 2,
 };
 
-static s16 D_80AFA120[] = {
+// LLM generated name (HIGH), was D_80AFA120: the per-row half-widths of the largest brush, used for size class 4.
+static s16 sBlobRowsClass4[] = {  // was D_80AFA120 [LLM:HIGH]
     2, 4, 5, 6, 7, 8, 8, 8, 8, 7, 6, 5, 4, 2,
 };
 
@@ -216,7 +217,7 @@ void func_80AF8F60(Player* player, u8* shadowTexture, f32 arg2) {
                 }
             } else if (sBlobSizeClass[i] == 4) {  // was D_80AFA15C [LLM:HIGH]
                 for (j = 0, phi_a3 = -0x1C0; j < 14; j++, phi_a3 += 0x40) {
-                    for (phi_a0 = -D_80AFA120[j]; phi_a0 < D_80AFA120[j]; phi_a0++) {
+                    for (phi_a0 = -sBlobRowsClass4[j]; phi_a0 < sBlobRowsClass4[j]; phi_a0++) {  // was D_80AFA120 [LLM:HIGH]
                         temp_v1 = temp_t0 + phi_a0;
                         if ((temp_v1 >= 0) && (temp_v1 < 0x40)) {
                             temp_v0 = temp_t1 + phi_a3;
-- 
