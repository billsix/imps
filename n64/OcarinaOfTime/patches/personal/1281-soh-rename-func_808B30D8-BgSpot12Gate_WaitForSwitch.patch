From 0f732059ce3924767730cf8726cc413bba226c0c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:08:00 +0000
Subject: [PATCH 1281/3799] soh: rename func_808B30D8 ->
 BgSpot12Gate_WaitForSwitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: waits for the gate's switch flag, then starts the delay and the one-point cutscene that shows it.
Defined in soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c b/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
index 26bdbb582..fca1c0896 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
@@ -16,7 +16,8 @@ void BgSpot12Gate_Draw(Actor* thisx, PlayState* play);
 
 // LLM generated name (HIGH), was func_808B30C0: snaps the gate down to home height and installs the waiting action.
 void BgSpot12Gate_SetupWaitForSwitch(BgSpot12Gate* this);  // was func_808B30C0 [LLM:HIGH]
-void func_808B30D8(BgSpot12Gate* this, PlayState* play);
+// LLM generated name (HIGH), was func_808B30D8: waits for the gate's switch flag, then starts the delay and the one-point cutscene that shows it.
+void BgSpot12Gate_WaitForSwitch(BgSpot12Gate* this, PlayState* play);  // was func_808B30D8 [LLM:HIGH]
 void func_808B3134(BgSpot12Gate* this);
 void func_808B314C(BgSpot12Gate* this, PlayState* play);
 void func_808B317C(BgSpot12Gate* this);
@@ -78,11 +79,11 @@ void BgSpot12Gate_Destroy(Actor* thisx, PlayState* play) {
 }
 
 void BgSpot12Gate_SetupWaitForSwitch(BgSpot12Gate* this) {
-    this->actionFunc = func_808B30D8;
+    this->actionFunc = BgSpot12Gate_WaitForSwitch;  // was func_808B30D8 [LLM:HIGH]
     this->dyna.actor.world.pos.y = this->dyna.actor.home.pos.y;
 }
 
-void func_808B30D8(BgSpot12Gate* this, PlayState* play) {
+void BgSpot12Gate_WaitForSwitch(BgSpot12Gate* this, PlayState* play) {
     if (Flags_GetSwitch(play, this->dyna.actor.params & 0x3F)) {
         func_808B3134(this);
         OnePointCutscene_Init(play, 4160, -99, &this->dyna.actor, CAM_ID_MAIN);
