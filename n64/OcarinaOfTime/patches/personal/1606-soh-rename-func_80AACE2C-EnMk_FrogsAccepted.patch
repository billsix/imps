From 9fca83ee5125991566cb0360cc5594ca4e4d9cd9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:30:41 +0000
Subject: [PATCH 1606/3799] soh: rename func_80AACE2C -> EnMk_FrogsAccepted

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the second line: it advances again and switches to the one-shot animation before the mixing begins.
Defined in soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
index f1513b0e9..0655a5b39 100644
--- a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
+++ b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
@@ -173,7 +173,8 @@ void func_80AACD48(EnMk* this, PlayState* play) {
     this->flags |= 1;
 }
 
-void func_80AACE2C(EnMk* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AACE2C: the second line: it advances again and switches to the one-shot animation before the mixing begins.
+void EnMk_FrogsAccepted(EnMk* this, PlayState* play) {
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT) && Message_ShouldAdvance(play)) {
         Message_ContinueTextbox(play, 0x4001);
         Animation_Change(&this->skelAnime, &object_mk_Anim_000AC0, 1.0f, 0.0f,
@@ -192,7 +193,7 @@ void EnMk_FrogsIntro(EnMk* this, PlayState* play) {
         Animation_Change(&this->skelAnime, &object_mk_Anim_000AC0, 1.0f, 0.0f,
                          Animation_GetLastFrame(&object_mk_Anim_000AC0), ANIMMODE_LOOP, -4.0f);
         this->flags &= ~2;
-        this->actionFunc = func_80AACE2C;
+        this->actionFunc = EnMk_FrogsAccepted;  // was func_80AACE2C [LLM:HIGH]
     }
 
     this->flags |= 1;
-- 
