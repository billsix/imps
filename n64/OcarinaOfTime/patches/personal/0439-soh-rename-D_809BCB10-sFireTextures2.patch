From 53268fd722df5d7ca776d67e0ebbfcad34a7431d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:37 +0000
Subject: [PATCH 439/488] soh: rename D_809BCB10 -> sFireTextures2

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same kind of flame texture cycle in EnBdfire_DrawFire
Defined in soh/src/overlays/actors/ovl_En_Bdfire/z_en_bdfire.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Bdfire/z_en_bdfire.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Bdfire/z_en_bdfire.c b/soh/src/overlays/actors/ovl_En_Bdfire/z_en_bdfire.c
index 4305a14cb..74246103e 100644
--- a/soh/src/overlays/actors/ovl_En_Bdfire/z_en_bdfire.c
+++ b/soh/src/overlays/actors/ovl_En_Bdfire/z_en_bdfire.c
@@ -198,7 +198,7 @@ void EnBdfire_Update(Actor* thisx, PlayState* play) {
 }
 
 void EnBdfire_DrawFire(EnBdfire* this, PlayState* play) {
-    static void* D_809BCB10[] = {
+    static void* sFireTextures2[] = {  // was D_809BCB10 [LLM:HIGH]
         object_kingdodongo_Tex_0264E0, object_kingdodongo_Tex_0274E0, object_kingdodongo_Tex_0284E0,
         object_kingdodongo_Tex_0294E0, object_kingdodongo_Tex_02A4E0, object_kingdodongo_Tex_02B4E0,
         object_kingdodongo_Tex_02C4E0, object_kingdodongo_Tex_02D4E0,
@@ -217,7 +217,7 @@ void EnBdfire_DrawFire(EnBdfire* this, PlayState* play) {
     gDPPipeSync(POLY_XLU_DISP++);
     gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 255, 255, 100, (s8)this->unk_18C);
     gDPSetEnvColor(POLY_XLU_DISP++, 200, 0, 0, 0);
-    gSPSegment(POLY_XLU_DISP++, 8, SEGMENTED_TO_VIRTUAL(D_809BCB10[temp]));
+    gSPSegment(POLY_XLU_DISP++, 8, SEGMENTED_TO_VIRTUAL(sFireTextures2[temp]));  // was D_809BCB10 [LLM:HIGH]
     Matrix_Translate(0.0f, 11.0f, 0.0f, MTXMODE_APPLY);
     gSPMatrix(POLY_XLU_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
     gSPDisplayList(POLY_XLU_DISP++, object_kingdodongo_DL_01D950);
