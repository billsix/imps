From f0e20e10d541819499f9f50adcfe1c73c76a0cbe Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:17 +0000
Subject: [PATCH 063/225] soh: rename func_800E5F88 ->
 AudioThread_ResetAudioHeap

Name source: zeldaret/oot.
Defined in soh/src/code/audio_thread.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h     | 2 +-
 soh/src/code/audio_seq.c    | 2 +-
 soh/src/code/audio_thread.c | 6 ++++--
 3 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 5da1bca31..502924e3b 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1997,7 +1997,7 @@ s32 Audio_ScheduleProcessCmds(void);
 u32 AudioThread_GetExternalLoadQueueMsg(u32* arg0);  // was func_800E5E20 [LLM:HIGH]
 u8* AudioThread_GetFontsForSequence(s32 arg0, u32* arg1);  // was func_800E5E84 [oot]
 s32 AudioThread_ResetComplete(void);  // was func_800E5EDC [LLM:HIGH]
-s32 func_800E5F88(s32 arg0);
+s32 AudioThread_ResetAudioHeap(s32 arg0);  // was func_800E5F88 [oot]
 void Audio_PreNMIInternal(void);
 s32 func_800E6680(void);
 u32 Audio_NextRandom(void);
diff --git a/soh/src/code/audio_seq.c b/soh/src/code/audio_seq.c
index 6ccb96a98..ea82bd04d 100644
--- a/soh/src/code/audio_seq.c
+++ b/soh/src/code/audio_seq.c
@@ -381,7 +381,7 @@ void Audio_ProcessSeqCmd(u32 cmd) {
             gSfxChannelLayout = (cmd & 0xFF00) >> 8;
             oldSpec = gAudioSpecId;
             gAudioSpecId = spec;
-            func_800E5F88(spec);
+            AudioThread_ResetAudioHeap(spec);
             func_800F71BC(oldSpec);
             Audio_QueueCmdS32(0xF8000000, 0);
             break;
diff --git a/soh/src/code/audio_thread.c b/soh/src/code/audio_thread.c
index 27bcfdeb4..6a7e03dc6 100644
--- a/soh/src/code/audio_thread.c
+++ b/soh/src/code/audio_thread.c
@@ -566,7 +566,9 @@ void AudioThread_ClearResetQueue(void) {
     // clang-format on
 }
 
-s32 func_800E5F88(s32 resetPreloadID) {
+// Name from zeldaret/oot, was func_800E5F88: clears reset queue and queues an audio-heap reset cmd for the [oot: https://github.com/zeldaret/oot/blob/main/src/audio/internal/thread.c]
+// preload id
+s32 AudioThread_ResetAudioHeap(s32 resetPreloadID) {
     s32 resetStatus;
     OSMesg msg;
     s32 pad;
@@ -594,7 +596,7 @@ s32 func_800E5F88(s32 resetPreloadID) {
 void Audio_PreNMIInternal(void) {
     gAudioContext.resetTimer = 1;
     if (gAudioContextInitalized) {
-        func_800E5F88(0);
+        AudioThread_ResetAudioHeap(0);
         gAudioContext.resetStatus = 0;
     }
 }
