From a5b968e44965709d84be39ff2833ac9fd497c0e6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:08 +0000
Subject: [PATCH 1670/3799] soh: rename D_80B2EB34 -> sEyeQuadTopRight

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: one corner of the eye's damage quad, transformed by the eye limb's matrix each frame.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index 3012d241b..b700cb2c4 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -115,7 +115,8 @@ static Vec3f sBeamOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_80B2EB1C [LLM:H
 // LLM generated name (HIGH), was D_80B2EB28: the point 1600 units ahead of the eye that gives the beam its direction.
 static Vec3f sBeamAimOffset = { 0.0f, 0.0f, 1600.0f };  // was D_80B2EB28 [LLM:HIGH]
 
-static Vec3f D_80B2EB34 = { 1000.0f, 700.0f, 2000.0f };
+// LLM generated name (HIGH), was D_80B2EB34: one corner of the eye's damage quad, transformed by the eye limb's matrix each frame.
+static Vec3f sEyeQuadTopRight = { 1000.0f, 700.0f, 2000.0f };  // was D_80B2EB34 [LLM:HIGH]
 
 static Vec3f D_80B2EB40 = { 1000.0f, -700.0f, 2000.0f };
 
@@ -513,7 +514,7 @@ void EnVm_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
                                          &this->colliderQuad1.dim.quad[3]);
             }
         }
-        Matrix_MultVec3f(&D_80B2EB34, &this->colliderQuad2.dim.quad[1]);
+        Matrix_MultVec3f(&sEyeQuadTopRight, &this->colliderQuad2.dim.quad[1]);  // was D_80B2EB34 [LLM:HIGH]
         Matrix_MultVec3f(&D_80B2EB40, &this->colliderQuad2.dim.quad[0]);
         Matrix_MultVec3f(&D_80B2EB4C, &this->colliderQuad2.dim.quad[3]);
         Matrix_MultVec3f(&D_80B2EB58, &this->colliderQuad2.dim.quad[2]);
-- 
