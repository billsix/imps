--- a/soh/src/boot/idle.c
+++ b/soh/src/boot/idle.c
@@ -7,9 +7,11 @@ StackEntry sMainStackInfo;
 OSMesg sPiMgrCmdBuff[50];
 OSMesgQueue gPiMgrCmdQ;
