From 61465bb253124f88707344b692ad1e5e773fdcc3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:19:22 +0000
Subject: [PATCH 1440/3799] soh: rename func_80977F80 ->
 DemoGeff_SetObjectSegment

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: binds this actor's loaded object bank to segment 6 for both the RSP and the CPU-side gSegments table.
Defined in soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c b/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
index 50e6cedc0..73a2d35d6 100644
--- a/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
+++ b/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
@@ -85,7 +85,8 @@ void DemoGeff_DrawDList(PlayState* play, Gfx* dlist) {
     CLOSE_DISPS(gfxCtx);
 }
 
-void func_80977F80(DemoGeff* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80977F80: binds this actor's loaded object bank to segment 6 for both the RSP and the CPU-side gSegments table.
+void DemoGeff_SetObjectSegment(DemoGeff* this, PlayState* play) {
     s32 pad[2];
     s32 objBankIndex = this->objBankIndex;
     GraphicsContext* gfxCtx = play->state.gfxCtx;
@@ -223,7 +224,7 @@ void DemoGeff_Draw(Actor* thisx, PlayState* play) {
         return;
     }
     if (drawConfig != 0) {
-        func_80977F80(this, play);
+        DemoGeff_SetObjectSegment(this, play);  // was func_80977F80 [LLM:HIGH]
     }
     sDrawFuncs[drawConfig](this, play);
 }
