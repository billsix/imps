From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:18:58 +0000
Subject: [PATCH 1437/3799] soh: rename func_809B0994 -> EnAni_CsWaitForGetUp

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: cutscene step 2: waits for actor cue 4, then plays the getting-up animation and restores the shadow.
Defined in soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c b/soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c
index 22434a9a3..dedc1c3cc 100644
--- a/soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c
+++ b/soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c
@@ -29,7 +29,8 @@ void EnAni_ChildIdle(EnAni* this, PlayState* play);  // was func_809B064C [LLM:H
 // LLM generated name (HIGH), was func_809B07F8: the adult-era twin of EnAni_ChildIdle, choosing its line from whether Death Mountain has erupted and whether the heart piece has already been taken.
 void EnAni_AdultIdle(EnAni* this, PlayState* play);  // was func_809B07F8 [LLM:HIGH]
 void func_809B0988(EnAni* this, PlayState* play);
-void func_809B0994(EnAni* this, PlayState* play);
+// LLM generated name (HIGH), was func_809B0994: cutscene step 2: waits for actor cue 4, then plays the getting-up animation and restores the shadow.
+void EnAni_CsWaitForGetUp(EnAni* this, PlayState* play);  // was func_809B0994 [LLM:HIGH]
 // LLM generated name (HIGH), was func_809B0A28: cutscene steps 1 and 3: advances the step as soon as the running animation finishes.
 void EnAni_CsWaitForAnimEnd(EnAni* this, PlayState* play);  // was func_809B0A28 [LLM:HIGH]
 // LLM generated name (HIGH), was func_809B0A6C: cutscene step 0: loops the current animation until actor cue 2, then plays the knockback animation, drops the shadow and advances the cutscene step.
@@ -220,7 +221,7 @@ void EnAni_AdultIdle(EnAni* this, PlayState* play) {
 void func_809B0988(EnAni* this, PlayState* play) {
 }
 
-void func_809B0994(EnAni* this, PlayState* play) {
+void EnAni_CsWaitForGetUp(EnAni* this, PlayState* play) {
     if (play->csCtx.npcActions[0]->action == 4) {
         Animation_Change(&this->skelAnime, &gRoofManGettingUpAfterKnockbackAnim, 1.0f, 0.0f,
                          Animation_GetLastFrame(&gRoofManGettingUpAfterKnockbackAnim), ANIMMODE_ONCE, -4.0f);
@@ -264,7 +265,7 @@ void EnAni_Update(Actor* thisx, PlayState* play) {
                 EnAni_CsWaitForAnimEnd(this, play);  // was func_809B0A28 [LLM:HIGH]
                 break;
             case 2:
-                func_809B0994(this, play);
+                EnAni_CsWaitForGetUp(this, play);  // was func_809B0994 [LLM:HIGH]
                 break;
             case 3:
                 EnAni_CsWaitForAnimEnd(this, play);  // was func_809B0A28 [LLM:HIGH]
