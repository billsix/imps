From 0433fcc57a35e15dd3a6119494555bf60df36322 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:20 +0000
Subject: [PATCH 087/784] soh: rename func_800432A0 ->
 DynaPolyActor_UpdateCarriedActorRotY

Name source: zeldaret/oot.
Defined in soh/src/code/z_bg_collect.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/z_bg_collect.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_bg_collect.c b/soh/src/code/z_bg_collect.c
index cbde66863..0d3c31f72 100644
--- a/soh/src/code/z_bg_collect.c
+++ b/soh/src/code/z_bg_collect.c
@@ -46,7 +46,10 @@ void DynaPolyActor_UpdateCarriedActorPos(CollisionContext* colCtx, s32 bgId, Act
 /**
  * Rotate actor
  */
-void func_800432A0(CollisionContext* colCtx, s32 bgId, Actor* actor) {
+// Name from zeldaret/oot src/code/z_bg_collect.c (was func_800432A0): adds bg actor's yaw delta to
+// carried actor's rotation (and Player yaw).
+// Source: https://github.com/zeldaret/oot/blob/main/src/code/z_bg_collect.c
+void DynaPolyActor_UpdateCarriedActorRotY(CollisionContext* colCtx, s32 bgId, Actor* actor) {
     if (DynaPoly_IsBgIdBgActor(bgId)) {
         s16 rot = colCtx->dyna.bgActors[bgId].curTransform.rot.y - colCtx->dyna.bgActors[bgId].prevTransform.rot.y;
 
@@ -100,7 +103,7 @@ s32 func_800433A4(CollisionContext* colCtx, s32 bgId, Actor* actor) {
     }
 
     if (dynaActor->transformFlags & 2) {
-        func_800432A0(colCtx, bgId, actor);
+        DynaPolyActor_UpdateCarriedActorRotY(colCtx, bgId, actor);
         result = true;
     }
 
