From e964085a9b3336abf0cac4fe9ababcd75aeca023 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:08 +0000
Subject: [PATCH 1676/3799] soh: rename D_80B2EB7C -> sDeathFlameScale

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the scale passed to the enemy-death flame effect.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index b77f0ed08..f09a8c997 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -133,7 +133,8 @@ static Vec3f sBeamNearRight = { 500.0f, 0.0f, 0.0f };  // was D_80B2EB64 [LLM:HI
 // LLM generated name (HIGH), was D_80B2EB70: the beam quad's near left corner, fixed at the emitter.
 static Vec3f sBeamNearLeft = { -500.0f, 0.0f, 0.0f };  // was D_80B2EB70 [LLM:HIGH]
 
-static Vec3f D_80B2EB7C = { 0.4f, 0.4f, 0.4f };
+// LLM generated name (HIGH), was D_80B2EB7C: the scale passed to the enemy-death flame effect.
+static Vec3f sDeathFlameScale = { 0.4f, 0.4f, 0.4f };  // was D_80B2EB7C [LLM:HIGH]
 
 static void* D_80B2EB88[] = {
     gEffEnemyDeathFlame1Tex, gEffEnemyDeathFlame2Tex,  gEffEnemyDeathFlame3Tex, gEffEnemyDeathFlame4Tex,
@@ -540,7 +541,7 @@ void EnVm_Draw(Actor* thisx, PlayState* play2) {
     Gfx_SetupDL_25Xlu(play->state.gfxCtx);
     SkelAnime_DrawSkeletonOpa(play, &this->skelAnime, EnVm_OverrideLimbDraw, EnVm_PostLimbDraw, this);
     actorPos = this->actor.world.pos;
-    func_80033C30(&actorPos, &D_80B2EB7C, 255, play);
+    func_80033C30(&actorPos, &sDeathFlameScale, 255, play);  // was D_80B2EB7C [LLM:HIGH]
 
     if (this->unk_260 >= 3) {
         Matrix_Translate(this->beamPos3.x, this->beamPos3.y + 10.0f, this->beamPos3.z, MTXMODE_NEW);
