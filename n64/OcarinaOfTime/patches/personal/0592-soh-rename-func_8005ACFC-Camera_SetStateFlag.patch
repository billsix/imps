From 648fc7452b4977cbf9670d0676bf3777ec3db002 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:06 +0000
Subject: [PATCH 592/784] soh: rename func_8005ACFC -> Camera_SetStateFlag

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/z_camera.c.
---
 soh/include/functions.h                                        | 2 +-
 soh/src/code/z_camera.c                                        | 3 ++-
 .../overlays/actors/ovl_Bg_Bdan_Objects/z_bg_bdan_objects.c    | 2 +-
 soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c        | 2 +-
 soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c                  | 2 +-
 5 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 115e647de..cf94dbb2b 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -745,7 +745,7 @@ s16 Camera_GetCamDirYaw(Camera* camera);
 s32 Camera_AddQuake(Camera* camera, s32 arg1, s16 y, s32 countdown);
 s32 Camera_SetParam(Camera* camera, s32 param, void* value);
 s32 Camera_OverwriteStateFlags(Camera* camera, s16 arg1);  // was func_8005AC48 [oot]
-s16 func_8005ACFC(Camera* camera, s16 arg1);
+s16 Camera_SetStateFlag(Camera* camera, s16 arg1);  // was func_8005ACFC [oot]
 s16 func_8005AD1C(Camera* camera, s16 arg1);
 s32 Camera_ResetAnim(Camera* camera);
 s32 Camera_SetCSParams(Camera* camera, CutsceneCameraPoint* atPoints, CutsceneCameraPoint* eyePoints, Player* player,
diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index fb78463c4..ba18c3c1e 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -8200,7 +8200,8 @@ s32 Camera_SetCSParams(Camera* camera, CutsceneCameraPoint* atPoints, CutsceneCa
     return 1;
 }
 
-s16 func_8005ACFC(Camera* camera, s16 arg1) {
+// Name from zeldaret/oot (was func_8005ACFC): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_camera.c]
+s16 Camera_SetStateFlag(Camera* camera, s16 arg1) {
     camera->unk_14C |= arg1;
     return camera->unk_14C;
 }
diff --git a/soh/src/overlays/actors/ovl_Bg_Bdan_Objects/z_bg_bdan_objects.c b/soh/src/overlays/actors/ovl_Bg_Bdan_Objects/z_bg_bdan_objects.c
index 939e8bfab..84f87c991 100644
--- a/soh/src/overlays/actors/ovl_Bg_Bdan_Objects/z_bg_bdan_objects.c
+++ b/soh/src/overlays/actors/ovl_Bg_Bdan_Objects/z_bg_bdan_objects.c
@@ -367,7 +367,7 @@ void BgBdanObjects_ElevatorOscillate(BgBdanObjects* this, PlayState* play) {
         }
         if (this->switchFlag == 0) {
             Camera_RequestSetting(play->cameraPtrs[CAM_ID_MAIN], this->cameraSetting);
-            func_8005ACFC(play->cameraPtrs[CAM_ID_MAIN], 4);
+            Camera_SetStateFlag(play->cameraPtrs[CAM_ID_MAIN], 4);
         }
     }
     this->dyna.actor.world.pos.y =
diff --git a/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c b/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
index 80e3e9d58..0e0db178f 100644
--- a/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
+++ b/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
@@ -645,7 +645,7 @@ void func_809BE26C(EnBigokuta* this, PlayState* play) {
         if (this->unk_198 == 0 && Math_StepToF(&this->actor.scale.y, 0.0f, 0.001f)) {
             Flags_SetClear(play, this->actor.room);
             Camera_RequestSetting(play->cameraPtrs[CAM_ID_MAIN], CAM_SET_DUNGEON0);
-            func_8005ACFC(play->cameraPtrs[CAM_ID_MAIN], 4);
+            Camera_SetStateFlag(play->cameraPtrs[CAM_ID_MAIN], 4);
             SoundSource_PlaySfxAtFixedWorldPos(play, &this->actor.world.pos, 50, NA_SE_EN_OCTAROCK_BUBLE);
             Item_DropCollectibleRandom(play, &this->actor, &this->actor.world.pos, 0xB0);
             Actor_Kill(&this->actor);
diff --git a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
index c298520ee..149844723 100644
--- a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
+++ b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
@@ -1171,7 +1171,7 @@ s32 EnGo2_IsCameraModified(EnGo2* this, PlayState* play) {
             func_8005AD1C(camera, 4);
         } else if (!EnGo2_IsWakingUp(this) && (camera->setting == CAM_SET_DIRECTED_YAW)) {
             Camera_RequestSetting(camera, CAM_SET_DUNGEON1);
-            func_8005ACFC(camera, 4);
+            Camera_SetStateFlag(camera, 4);
         }
     }
 
