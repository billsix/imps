+/// Search over a single in-memory slice with a matcher that can span lines.
+///
+/// Unlike the line-oriented strategies, matches are found with the general
+/// [`Matcher::find`] rather than by stepping line by line, then expanded to
+/// cover whole lines. `last_match` holds a pending match so that adjacent or
+/// overlapping matches (matches whose lines touch) are coalesced and each line
+/// is reported to the sink at most once.
 #[derive(Debug)]
 pub(crate) struct MultiLine<'s, M, S> {
     config: &'s Config,
@@ -196,6 +244,13 @@ impl<'s, M: Matcher, S: Sink> MultiLine<'s, M, S> {
         self.core.finish(byte_count, binary_byte_offset)
     }
 
+    /// Find and process the next match, coalescing it with any pending one.
+    ///
+    /// A match is not reported immediately: it is held in `last_match` so that
+    /// if the next match lands on an adjacent or overlapping line the two are
+    /// merged into a single block, guaranteeing a line is never sunk twice (see
+    /// the note referencing ripgrep issue #1311). The previous pending match is
+    /// flushed once a non-adjacent match is found.
