From 4fef3f29cce99ff95dbad499591e1d797d59bc8a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:58:38 +0000
Subject: [PATCH 1216/3799] soh: rename func_8088E5D0 -> BgHidanSima_Shake

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: jitters the platform in a circle for twenty frames with rumble and the block-shake sfx, then recentres it and starts sinking.
Defined in soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
index 89979313d..3ab3ae011 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
@@ -16,7 +16,8 @@ void BgHidanSima_Draw(Actor* thisx, PlayState* play);
 
 // LLM generated name (HIGH), was func_8088E518: the params 0 platform's resting action: steps back up to home height and, when the player steps on, arms the shake or drops straight to the sink.
 void BgHidanSima_Rise(BgHidanSima* this, PlayState* play);  // was func_8088E518 [LLM:HIGH]
-void func_8088E5D0(BgHidanSima* this, PlayState* play);
+// LLM generated name (HIGH), was func_8088E5D0: jitters the platform in a circle for twenty frames with rumble and the block-shake sfx, then recentres it and starts sinking.
+void BgHidanSima_Shake(BgHidanSima* this, PlayState* play);  // was func_8088E5D0 [LLM:HIGH]
 void func_8088E6D0(BgHidanSima* this, PlayState* play);
 void func_8088E760(BgHidanSima* this, PlayState* play);
 void func_8088E7A8(BgHidanSima* this, PlayState* play);
@@ -124,14 +125,14 @@ void BgHidanSima_Rise(BgHidanSima* this, PlayState* play) {
         this->timer = 20;
         this->dyna.actor.world.rot.y = Camera_GetCamDirYaw(GET_ACTIVE_CAM(play)) + 0x4000;
         if (this->dyna.actor.home.pos.y <= this->dyna.actor.world.pos.y) {
-            this->actionFunc = func_8088E5D0;
+            this->actionFunc = BgHidanSima_Shake;  // was func_8088E5D0 [LLM:HIGH]
         } else {
             this->actionFunc = func_8088E6D0;
         }
     }
 }
 
-void func_8088E5D0(BgHidanSima* this, PlayState* play) {
+void BgHidanSima_Shake(BgHidanSima* this, PlayState* play) {
     if (this->timer != 0) {
         this->timer--;
     }
