From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:47 +0000
Subject: [PATCH 3145/3799] soh: rename D_8015E230 -> sJntSphVsQuadTri0

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the first triangle the AC quad is split into in CollisionCheck_AC_JntSphVsQuad
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index c96135183..521508920 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2010,7 +2010,7 @@ void CollisionCheck_AC_TrisVsJntSph(PlayState* play, CollisionCheckContext* colC
  */
 void CollisionCheck_AC_JntSphVsQuad(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT,
                                     Collider* colAC) {
-    static TriNorm D_8015E230;
+    static TriNorm sJntSphVsQuadTri0;  // was D_8015E230 [LLM:HIGH]
     static TriNorm D_8015E268;
     ColliderJntSph* at = (ColliderJntSph*)colAT;
     ColliderQuad* ac = (ColliderQuad*)colAC;
@@ -2021,7 +2021,7 @@ void CollisionCheck_AC_JntSphVsQuad(PlayState* play, CollisionCheckContext* colC
         if (CollisionCheck_SkipBump(&ac->info) == 1) {
             return;
         }
-        Math3D_TriNorm(&D_8015E230, &ac->dim.quad[2], &ac->dim.quad[3], &ac->dim.quad[1]);
+        Math3D_TriNorm(&sJntSphVsQuadTri0, &ac->dim.quad[2], &ac->dim.quad[3], &ac->dim.quad[1]);  // was D_8015E230 [LLM:HIGH]
         Math3D_TriNorm(&D_8015E268, &ac->dim.quad[1], &ac->dim.quad[0], &ac->dim.quad[2]);
         for (atItem = at->elements; atItem < at->elements + at->count; atItem++) {
             if (CollisionCheck_SkipTouch(&atItem->info) == 1) {
@@ -2030,7 +2030,7 @@ void CollisionCheck_AC_JntSphVsQuad(PlayState* play, CollisionCheckContext* colC
             if (CollisionCheck_NoSharedFlags(&atItem->info, &ac->info) == 1) {
                 continue;
             }
-            if (Math3D_TriVsSphIntersect(&atItem->dim.worldSphere, &D_8015E230, &hitPos) == 1 ||
+            if (Math3D_TriVsSphIntersect(&atItem->dim.worldSphere, &sJntSphVsQuadTri0, &hitPos) == 1 ||  // was D_8015E230 [LLM:HIGH]
                 Math3D_TriVsSphIntersect(&atItem->dim.worldSphere, &D_8015E268, &hitPos) == 1) {
                 Vec3f atPos;
                 Vec3f acPos;
