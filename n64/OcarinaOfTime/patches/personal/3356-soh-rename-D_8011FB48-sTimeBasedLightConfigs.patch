From 3958a0288ed89fdc338784ec3fbd11460d935271 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:15:29 +0000
Subject: [PATCH 3356/3799] soh: rename D_8011FB48 -> sTimeBasedLightConfigs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-scene rows of time ranges and the light setting each blends between, read through the TIME_ENTRY macros
Defined in soh/src/code/z_kankyo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_kankyo.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_kankyo.c b/soh/src/code/z_kankyo.c
index e1db7e1db..da10e82ae 100644
--- a/soh/src/code/z_kankyo.c
+++ b/soh/src/code/z_kankyo.c
@@ -68,7 +68,8 @@ SHIP_SAVESTATE_DEFINE(Environment, ENVIRONMENT_SHIP_SAVESTATE_FIELDS)
 // LLM generated name (HIGH), was D_8011FB44: the pixel depth read at the sun's screen position, used to decide whether the lens flare is occluded
 u16 sSunDepth = 0xFFFC;  // was D_8011FB44 [LLM:HIGH]
 
-struct_8011FB48 D_8011FB48[][7] = {
+// LLM generated name (HIGH), was D_8011FB48: per-scene rows of time ranges and the light setting each blends between, read through the TIME_ENTRY macros
+struct_8011FB48 sTimeBasedLightConfigs[][7] = {  // was D_8011FB48 [LLM:HIGH]
     {
         { 0x0000, 0x2AAC, 3, 3 },
         { 0x2AAC, 0x4000, 3, 0 },
@@ -888,8 +889,8 @@ void Environment_PrintDebugInfo(PlayState* play, Gfx** gfx) {
     GfxPrint_Destroy(&printer);
 }
 
-#define TIME_ENTRY_1F (D_8011FB48[envCtx->unk_1F][i])
-#define TIME_ENTRY_20 (D_8011FB48[envCtx->unk_20][i])
+#define TIME_ENTRY_1F (sTimeBasedLightConfigs[envCtx->unk_1F][i])  // was D_8011FB48 [LLM:HIGH]
+#define TIME_ENTRY_20 (sTimeBasedLightConfigs[envCtx->unk_20][i])  // was D_8011FB48 [LLM:HIGH]
 
 // Name from zeldaret/oot (was func_80075B44): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.94. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_kankyo.c]
 void Environment_PlayTimeBasedSequence(PlayState* play);
@@ -990,7 +991,7 @@ void Environment_Update(PlayState* play, EnvironmentContext* envCtx, LightContex
 
         if (envCtx->unk_BF != 0xFE) {
             if (!envCtx->indoors && (envCtx->unk_BF == 0xFF)) {
-                for (i = 0; i < ARRAY_COUNT(D_8011FB48[envCtx->unk_1F]); i++) {
+                for (i = 0; i < ARRAY_COUNT(sTimeBasedLightConfigs[envCtx->unk_1F]); i++) {  // was D_8011FB48 [LLM:HIGH]
                     if ((gSaveContext.skyboxTime >= TIME_ENTRY_1F.startTime) &&
                         ((gSaveContext.skyboxTime < TIME_ENTRY_1F.endTime) || TIME_ENTRY_1F.endTime == 0xFFFF)) {
                         u8 blend8[2];
-- 
