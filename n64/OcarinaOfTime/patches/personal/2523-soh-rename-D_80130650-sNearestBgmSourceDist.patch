From f10551face706220fbdc711cfdb362c7fe3d1972 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:58 +0000
Subject: [PATCH 2523/3799] soh: rename D_80130650 -> sNearestBgmSourceDist

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the distance of the source Audio_PanBgmToNearestSource is currently following
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index c67460fc0..6633333e0 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -156,7 +156,8 @@ u8 sAudioExtraFilter = 0;
 u8 sAudioBaseFilter2 = 0;
 u8 sAudioExtraFilter2 = 0;
 Vec3f* sSariaBgmPtr = NULL;
-f32 D_80130650 = 2000.0f;
+// LLM generated name (HIGH), was D_80130650: the distance of the source Audio_PanBgmToNearestSource is currently following
+f32 sNearestBgmSourceDist = 2000.0f;  // was D_80130650 [LLM:HIGH]
 u8 sSeqModeInput = 0; // decomp: debug only
 
 #define SEQ_FLAG_ENEMY (1 << 0) // Allows enemy bgm
@@ -1351,7 +1352,7 @@ s32 sAudioUpdateTaskEnd;      // decomp: debug only
     F(sAudioBaseFilter2)                               \
     F(sAudioExtraFilter2)                              \
     F(sSariaBgmPtr)                                    \
-    F(D_80130650)                                      \
+    F(sNearestBgmSourceDist)                                      \
     F(D_8016B7A8)                                      \
     F(D_8016B7AC)                                      \
     F(D_8016B7B0)                                      \
@@ -4711,14 +4712,14 @@ void Audio_PanBgmToNearestSource(Vec3f* pos, f32 arg1) {
 
     if (sSariaBgmPtr == NULL) {
         sSariaBgmPtr = pos;
-        D_80130650 = arg1;
+        sNearestBgmSourceDist = arg1;  // was D_80130650 [LLM:HIGH]
     } else if (pos != sSariaBgmPtr) {
-        if (arg1 < D_80130650) {
+        if (arg1 < sNearestBgmSourceDist) {  // was D_80130650 [LLM:HIGH]
             sSariaBgmPtr = pos;
-            D_80130650 = arg1;
+            sNearestBgmSourceDist = arg1;  // was D_80130650 [LLM:HIGH]
         }
     } else {
-        D_80130650 = arg1;
+        sNearestBgmSourceDist = arg1;  // was D_80130650 [LLM:HIGH]
     }
 
     if (sSariaBgmPtr->x > 100.0f) {
@@ -4729,12 +4730,12 @@ void Audio_PanBgmToNearestSource(Vec3f* pos, f32 arg1) {
         phi_s4 = ((sSariaBgmPtr->x / 100.0f) * 64.0f) + 64.0f;
     }
 
-    if (D_80130650 > 400.0f) {
+    if (sNearestBgmSourceDist > 400.0f) {  // was D_80130650 [LLM:HIGH]
         phi_f22 = 0.1f;
-    } else if (D_80130650 < 120.0f) {
+    } else if (sNearestBgmSourceDist < 120.0f) {  // was D_80130650 [LLM:HIGH]
         phi_f22 = 1.0f;
     } else {
-        phi_f22 = ((1.0f - ((D_80130650 - 120.0f) / 280.0f)) * 0.9f) + 0.1f;
+        phi_f22 = ((1.0f - ((sNearestBgmSourceDist - 120.0f) / 280.0f)) * 0.9f) + 0.1f;  // was D_80130650 [LLM:HIGH]
     }
 
     for (i = 0; i < 0x10; i++) {
