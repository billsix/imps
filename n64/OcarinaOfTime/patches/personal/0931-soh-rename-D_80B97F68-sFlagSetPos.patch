From f4842c6f7538057d937417273c25cb1b6493bbc8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:09 +0000
Subject: [PATCH 0931/3799] soh: rename D_80B97F68 -> sFlagSetPos

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: fixed world position the params bit-0 lightswitch is snapped to in Init when its switch flag is already set; why that particular coordinate is hardcoded is not recoverable from the file.
Defined in soh/src/overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c         | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c b/soh/src/overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c
index 6f99ff87e..12b7375e5 100644
--- a/soh/src/overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c
+++ b/soh/src/overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c
@@ -80,7 +80,8 @@ static CollisionCheckInfoInit sColChkInfoInit = { 0, 12, 60, MASS_IMMOVABLE };
 static void* sFaceTextures[] = { object_lightswitch_Tex_000C20, object_lightswitch_Tex_000420,
                                  object_lightswitch_Tex_001420 };
 
-static Vec3f D_80B97F68 = { -1707.0f, 843.0f, -180.0f };
+// LLM generated name (GUESS), was D_80B97F68: fixed world position the params bit-0 lightswitch is snapped to in Init when its switch flag is already set; why that particular coordinate is hardcoded is not recoverable from the file.
+static Vec3f sFlagSetPos = { -1707.0f, 843.0f, -180.0f };  // was D_80B97F68 [LLM:GUESS]
 static Vec3f D_80B97F74 = { 0.0f, 0.0f, 0.0f };
 
 static InitChainEntry sInitChain[] = {
@@ -179,8 +180,8 @@ void ObjLightswitch_Init(Actor* thisx, PlayState* play) {
     }
     if ((this->actor.params & 1) == 1) {
         if (switchFlagSet) {
-            Math_Vec3f_Copy(&this->actor.world.pos, &D_80B97F68);
-            Math_Vec3f_Copy(&this->actor.home.pos, &D_80B97F68);
+            Math_Vec3f_Copy(&this->actor.world.pos, &sFlagSetPos);  // was D_80B97F68 [LLM:GUESS]
+            Math_Vec3f_Copy(&this->actor.home.pos, &sFlagSetPos);  // was D_80B97F68 [LLM:GUESS]
         }
         this->actor.shape.rot.x = -0x4000;
         this->actor.shape.rot.z = 0;
