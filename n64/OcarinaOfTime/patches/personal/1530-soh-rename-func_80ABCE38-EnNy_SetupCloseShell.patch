From 4e22b0446acd8a34b3a1384dd1fd6adc1f38cd51 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:25:00 +0000
Subject: [PATCH 1530/3799] soh: rename func_80ABCE38 -> EnNy_SetupCloseShell

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: arms the 60-frame closing timer and installs the closing action.
Defined in soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
index aea82735f..12f7b1572 100644
--- a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
+++ b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
@@ -194,7 +194,8 @@ void EnNy_SetupTurnToStone(EnNy* this) {
     this->unk_1E8 = 0.0f;
 }
 
-void func_80ABCE38(EnNy* this) {
+// LLM generated name (HIGH), was func_80ABCE38: arms the 60-frame closing timer and installs the closing action.
+void EnNy_SetupCloseShell(EnNy* this) {
     this->stoneTimer = 0x3C;
     this->actionFunc = func_80ABD11C;
 }
@@ -270,7 +271,7 @@ void EnNy_TurnToStone(EnNy* this, PlayState* play) {
             this->actor.bgCheckFlags &= ~2;
             this->actor.speedXZ = 0.0f;
             this->actor.world.rot.y = this->actor.shape.rot.y;
-            func_80ABCE38(this);
+            EnNy_SetupCloseShell(this);  // was func_80ABCE38 [LLM:HIGH]
         }
     }
     this->unk_1E0 = phi_f0;
