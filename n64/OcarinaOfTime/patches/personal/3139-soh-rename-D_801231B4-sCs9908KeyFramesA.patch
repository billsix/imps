From bd8f6fd5b5e96869c3410f04e3e99a516178fe42 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:44 +0000
Subject: [PATCH 3139/3799] soh: rename D_801231B4 -> sCs9908KeyFramesA

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the first keyframe set cutscene 9908 installs, whose eye depth varies with age
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 16 ++++++++--------
 soh/src/code/z_onepointdemo_data.inc |  3 ++-
 2 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 73f5f9bc9..3457f2d32 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -40,7 +40,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs3261KeyFrames)                                   \
     F(sCs8700KeyFrames)                                   \
     F(sCs1100KeyFramesB)                                   \
-    F(D_801231B4)                                   \
+    F(sCs9908KeyFramesA)                                   \
     F(D_80123254)                                   \
     F(sCs1000KeyFrames)                                   \
     F(sCs9703KeyFrames)                                   \
@@ -1012,22 +1012,22 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             break;
         case 9908:
             if (Play_CamIsNotFixed(play)) {
-                D_801231B4[0].eyeTargetInit.z = D_801231B4[1].eyeTargetInit.z = !LINK_IS_ADULT ? 100.0f : 120.0f;
+                sCs9908KeyFramesA[0].eyeTargetInit.z = sCs9908KeyFramesA[1].eyeTargetInit.z = !LINK_IS_ADULT ? 100.0f : 120.0f;  // was D_801231B4 [LLM:HIGH]
 
                 if (player->stateFlags1 & PLAYER_STATE1_IN_WATER) {
-                    D_801231B4[2].atTargetInit.z = 0.0f;
+                    sCs9908KeyFramesA[2].atTargetInit.z = 0.0f;  // was D_801231B4 [LLM:HIGH]
                 }
                 Actor_GetWorldPosShapeRot(&spA0, &player->actor);
                 OLib_Vec3fDiffToVecSphGeo(&spD0, &spA0.pos, &mainCam->at);
                 spD0.yaw -= spA0.rot.y;
-                OLib_VecSphGeoToVec3f(&D_801231B4[3].atTargetInit, &spD0);
+                OLib_VecSphGeoToVec3f(&sCs9908KeyFramesA[3].atTargetInit, &spD0);  // was D_801231B4 [LLM:HIGH]
                 OLib_Vec3fDiffToVecSphGeo(&spD0, &spA0.pos, &mainCam->eye);
                 spD0.yaw -= spA0.rot.y;
-                OLib_VecSphGeoToVec3f(&D_801231B4[3].eyeTargetInit, &spD0);
-                D_801231B4[3].fovTargetInit = mainCam->fov;
-                D_801231B4[3].timerInit = timer - 50;
+                OLib_VecSphGeoToVec3f(&sCs9908KeyFramesA[3].eyeTargetInit, &spD0);  // was D_801231B4 [LLM:HIGH]
+                sCs9908KeyFramesA[3].fovTargetInit = mainCam->fov;  // was D_801231B4 [LLM:HIGH]
+                sCs9908KeyFramesA[3].timerInit = timer - 50;  // was D_801231B4 [LLM:HIGH]
 
-                csInfo->keyFrames = D_801231B4;
+                csInfo->keyFrames = sCs9908KeyFramesA;  // was D_801231B4 [LLM:HIGH]
                 csInfo->keyFrameCnt = 4;
 
                 Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index ed4d7125d..459f10368 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -651,7 +651,8 @@ static OnePointCsFull sCs1100KeyFramesB[3] = {  // was D_8012313C [LLM:HIGH]
     { 0x92, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_801231B4[4] = {
+// LLM generated name (HIGH), was D_801231B4: the first keyframe set cutscene 9908 installs, whose eye depth varies with age
+static OnePointCsFull sCs9908KeyFramesA[4] = {  // was D_801231B4 [LLM:HIGH]
     { 0x8F, 0xC5, 0x4343, 1, 0, 50.0f, 1.0f, { 0.0f, 20.0f, 0.0f }, { 0.0f, 5.0f, -1.0f } },
     { 0x81, 0xC5, 0x4343, 48, 0, 50.0f, 0.75f, { 0.0f, 80.0f, 0.0f }, { 0.0f, 15.0f, -1.0f } },
     { 0x8F, 0xC5, 0x4343, 1, 5, 45.0f, 1.0f, { 0.0f, 0.0f, 30.0f }, { 30.0f, 120.0f, 60.0f } },
