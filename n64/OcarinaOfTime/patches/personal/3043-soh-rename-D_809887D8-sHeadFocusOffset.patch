From 01849800875ddb0ac044be3b6c048b791a01f682 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:59:25 +0000
Subject: [PATCH 3043/3799] soh: rename D_809887D8 -> sHeadFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point Impa's focus position is transformed from
Defined in soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
index ee40ecb92..f8699414e 100644
--- a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -116,7 +116,8 @@ static DemoImActionFunc sActionFuncs[] = {
     DemoIm_Action28, DemoIm_Action29, DemoIm_Action30,  // was func_809872A8 [LLM:HIGH]
 };
 
-static Vec3f D_809887D8 = { 0.0f, 10.0f, 0.0f };
+// LLM generated name (HIGH), was D_809887D8: the head-space point Impa's focus position is transformed from
+static Vec3f sHeadFocusOffset = { 0.0f, 10.0f, 0.0f };  // was D_809887D8 [LLM:HIGH]
 
 static DemoImDrawFunc sDrawFuncs[] = {
     DemoIm_DrawNothing,
@@ -1277,7 +1278,7 @@ void DemoIm_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
     DemoIm* this = (DemoIm*)thisx;
 
     if (limbIndex == IMPA_LIMB_HEAD) {
-        Vec3f sp28 = D_809887D8;
+        Vec3f sp28 = sHeadFocusOffset;  // was D_809887D8 [LLM:HIGH]
         Vec3f dest;
 
         Matrix_MultVec3f(&sp28, &dest);
