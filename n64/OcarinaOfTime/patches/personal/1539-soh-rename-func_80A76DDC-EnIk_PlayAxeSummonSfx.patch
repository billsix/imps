From 7a705847d739256f934f2ee68bfb5871b2c1ef52 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:25:46 +0000
Subject: [PATCH 1539/3799] soh: rename func_80A76DDC -> EnIk_PlayAxeSummonSfx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays the transform sfx that accompanies the axe appearing; EnIk_SpawnAxeSmoke calls it once the smoke has been thrown.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index deb33c218..00f3fc36d 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -1048,7 +1048,8 @@ void EnIk_PlayIntroSfx(EnIk* this) {
     }
 }
 
-void func_80A76DDC(EnIk* this, PlayState* play, Vec3f* pos) {
+// LLM generated name (HIGH), was func_80A76DDC: plays the transform sfx that accompanies the axe appearing; EnIk_SpawnAxeSmoke calls it once the smoke has been thrown.
+void EnIk_PlayAxeSummonSfx(EnIk* this, PlayState* play, Vec3f* pos) {
     Audio_PlaySfxGeneral(NA_SE_EN_TWINROBA_TRANSFORM, &this->actor.projectedPos, 4, &gSfxDefaultFreqAndVolScale,
                          &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
 }
@@ -1090,7 +1091,7 @@ void EnIk_SpawnAxeSmoke(EnIk* this, PlayState* play, Vec3f* pos) {
         }
 
         this->isAxeSummoned = 1;
-        func_80A76DDC(this, play, pos);
+        EnIk_PlayAxeSummonSfx(this, play, pos);  // was func_80A76DDC [LLM:HIGH]
     }
 }
 
