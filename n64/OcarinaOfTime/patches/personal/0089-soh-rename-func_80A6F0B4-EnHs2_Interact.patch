From 374eef0aaee7a9c075f7804de031254f76a9cc7b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:05 +0000
Subject: [PATCH 089/488] soh: rename func_80A6F0B4 -> EnHs2_Interact

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.90.
Defined in soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c b/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c
index 7f9fd0cba..e1a3fab88 100644
--- a/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c
+++ b/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c
@@ -73,7 +73,8 @@ void EnHs2_Destroy(Actor* thisx, PlayState* play) {
     Collider_DestroyCylinder(play, &this->collider);
 }
 
-s32 func_80A6F0B4(EnHs2* this, PlayState* play, u16 textId, EnHs2ActionFunc actionFunc) {
+// Name from zeldaret/oot (was func_80A6F0B4): adopted upstream's name for this address; body verified to match upstream at 0.90. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c]
+s32 EnHs2_Interact(EnHs2* this, PlayState* play, u16 textId, EnHs2ActionFunc actionFunc) {
     if (Actor_ProcessTalkRequest(&this->actor, play)) {
         this->actionFunc = actionFunc;
         return 1;
@@ -103,7 +104,7 @@ void func_80A6F1A4(EnHs2* this, PlayState* play) {
         textId = 0x5069;
     }
 
-    func_80A6F0B4(this, play, textId, func_80A6F164);
+    EnHs2_Interact(this, play, textId, func_80A6F164);
 }
 
 void EnHs2_Update(Actor* thisx, PlayState* play) {
