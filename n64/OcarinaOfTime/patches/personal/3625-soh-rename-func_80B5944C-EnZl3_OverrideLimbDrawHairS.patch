Subject: [PATCH 3625/3799] soh: rename func_80B5944C ->
 EnZl3_OverrideLimbDrawHairStill

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sOverrideLimbDrawFuncs[1]: the same seven-matrix hair chain at limb 14 as EnZl3_OverrideLimbDrawHair but with fixed offsets and no spring update, i.e. the hair frozen
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index f4ea8e52d..cb7905183 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -2481,7 +2481,8 @@ void func_80B593D0(EnZl3* this, PlayState* play) {
     func_80B58C08(this, play);
 }
 
-s32 func_80B5944C(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s* rot, void* thisx, Gfx** gfx) {
+// LLM generated name (GUESS), was func_80B5944C: sOverrideLimbDrawFuncs[1]: the same seven-matrix hair chain at limb 14 as EnZl3_OverrideLimbDrawHair but with fixed offsets and no spring update, i.e. the hair frozen
+s32 EnZl3_OverrideLimbDrawHairStill(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s* rot, void* thisx, Gfx** gfx) {
     if (limbIndex == 14) {
         Mtx* mtx = Graph_Alloc(play->state.gfxCtx, sizeof(Mtx) * 7);
         EnZl3* this = (EnZl3*)thisx;
@@ -2718,7 +2719,7 @@ void EnZl3_Init(Actor* thisx, PlayState* play) {
 
 static OverrideLimbDraw sOverrideLimbDrawFuncs[] = {
     EnZl3_OverrideLimbDrawHair,  // was func_80B5458C [LLM:HIGH]
-    func_80B5944C,
+    EnZl3_OverrideLimbDrawHairStill,  // was func_80B5944C [LLM:GUESS]
 };
 
 s32 EnZl3_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s* rot, void* thisx,
