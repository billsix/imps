Subject: [PATCH 2419/3799] soh: rename func_80ADE114 -> EnPoh_SetupHover

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loops the first idle animation, arms a short timer and stops the poe in place
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index cfaef8570..9fcfeef29 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -259,7 +259,8 @@ void EnPoh_Destroy(Actor* thisx, PlayState* play) {
     }
 }
 
-void func_80ADE114(EnPoh* this) {
+// LLM generated name (HIGH), was func_80ADE114: loops the first idle animation, arms a short timer and stops the poe in place
+void EnPoh_SetupHover(EnPoh* this) {
     Animation_PlayLoop(&this->skelAnime, this->info->idleAnim);
     this->unk_198 = Rand_S16Offset(2, 3);
     this->actionFunc = func_80ADEAC4;
@@ -510,7 +511,7 @@ void EnPoh_Idle(EnPoh* this, PlayState* play) {
         if (Rand_ZeroOne() < 0.1f) {
             func_80ADE514(this);
         } else {
-            func_80ADE114(this);
+            EnPoh_SetupHover(this);  // was func_80ADE114 [LLM:HIGH]
         }
     }
     if (this->lightColor.a == 255) {
