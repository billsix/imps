From 952ff059d6b96a1da117ad59d6d55b6e6e575f0d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:46 +0000
Subject: [PATCH 060/225] soh: rename func_800E5EA4 ->
 Audio_GetSampleBankIdsOfFont

Name source: zeldaret/oot.
Defined in soh/src/code/audio_thread.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_thread.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/audio_thread.c b/soh/src/code/audio_thread.c
index c84b40280..5597c4b96 100644
--- a/soh/src/code/audio_thread.c
+++ b/soh/src/code/audio_thread.c
@@ -538,7 +538,8 @@ u8* AudioThread_GetFontsForSequence(s32 arg0, u32* arg1) {
     return AudioLoad_GetFontsForSequence(arg0, arg1);
 }
 
-void func_800E5EA4(s32 arg0, u32* arg1, u32* arg2) {
+// Name from zeldaret/oot, was func_800E5EA4: returns the soundFont's two sampleBankId fields [oot: https://github.com/zeldaret/oot/blob/main/src/audio/internal/thread.c]
+void Audio_GetSampleBankIdsOfFont(s32 arg0, u32* arg1, u32* arg2) {
     *arg1 = gAudioContext.soundFonts[arg0].sampleBankId1;
     *arg2 = gAudioContext.soundFonts[arg0].sampleBankId2;
 }
-- 
