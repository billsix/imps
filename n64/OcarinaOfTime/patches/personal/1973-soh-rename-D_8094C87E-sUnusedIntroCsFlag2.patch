         sKoumePtr->work[YAW_TGT] = 0x4000;
         sUnusedIntroCsValue3 = 335;  // was D_8094C87A [LLM:GUESS]
-        D_8094C87E = 1;
+        sUnusedIntroCsFlag2 = 1;  // was D_8094C87E [LLM:GUESS]
     }
 
     if (this->work[CS_TIMER_2] == 530) {
