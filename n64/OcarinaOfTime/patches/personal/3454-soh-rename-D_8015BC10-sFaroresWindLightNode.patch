From f787b450e9402c9d2e55c9beb80d89149d377d48 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:13 +0000
Subject: [PATCH 3454/3799] soh: rename D_8015BC10 -> sFaroresWindLightNode

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the light node the Farore's Wind point is inserted as, so it can be removed again
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 2a52b5fb6..1238b7bfd 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -2355,7 +2355,8 @@ s32 Actor_CheckBlueBloodWall(PlayState* play, Actor* actor, CollisionPoly* poly,
 // Local data used for Farore's Wind light (stored in BSS, possibly a struct?)
 // LLM generated name (HIGH), was D_8015BC00: the light placed at the Farore's Wind warp point
 LightInfo sFaroresWindLight;  // was D_8015BC00 [LLM:HIGH]
-LightNode* D_8015BC10;
+// LLM generated name (HIGH), was D_8015BC10: the light node the Farore's Wind point is inserted as, so it can be removed again
+LightNode* sFaroresWindLightNode;  // was D_8015BC10 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8015BC14: counts the frames of the Farore's Wind warp effect down
 s32 sFaroresWindTimer;  // was D_8015BC14 [LLM:HIGH]
 // LLM generated name (GUESS), was D_8015BC18: drives the pull toward the warp point once the timer expires; read as progress from how it is stepped to zero
@@ -2389,7 +2390,7 @@ void Actor_InitFaroresWindPoint(PlayState* play) {
 
     Lights_PointNoGlowSetInfo(&sFaroresWindLight, lightPos.x, lightPos.y, lightPos.z, 0xFF, 0xFF, 0xFF, -1);  // was D_8015BC00 [LLM:HIGH]
 
-    D_8015BC10 = LightContext_InsertLight(play, &play->lightCtx, &sFaroresWindLight);  // was D_8015BC00 [LLM:HIGH]
+    sFaroresWindLightNode = LightContext_InsertLight(play, &play->lightCtx, &sFaroresWindLight);  // was D_8015BC00 [LLM:HIGH]
     sFaroresWindTimer = 0;  // was D_8015BC14 [LLM:HIGH]
     sFaroresWindWarpProgress = 0.0f;  // was D_8015BC18 [LLM:GUESS]
 }
@@ -2551,7 +2552,7 @@ void Actor_DrawFaroresWindPointer(PlayState* play) {
 
 // LLM generated name (HIGH), was func_80030488: removes that light from the light context
 void Actor_RemoveFaroresWindLight(PlayState* play) {
-    LightContext_RemoveLight(play, &play->lightCtx, D_8015BC10);
+    LightContext_RemoveLight(play, &play->lightCtx, sFaroresWindLightNode);  // was D_8015BC10 [LLM:HIGH]
 }
 
 void Actor_DisableLens(PlayState* play) {
-- 
