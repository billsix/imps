--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
@@ -31,7 +31,8 @@ s32 BgSpot18Obj_InitSpear(BgSpot18Obj* this, PlayState* play);  // was func_808B
 void BgSpot18Obj_SetupDoNothing(BgSpot18Obj* this);  // was func_808B8DC0 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808B8DD0: empty action
 void BgSpot18Obj_DoNothing(BgSpot18Obj* this, PlayState* play);  // was func_808B8DD0 [LLM:HIGH]
-void func_808B8E64(BgSpot18Obj* this);
