From 0cfe0c29b9dd3c65fb2e13d0cf544ccf200f6951 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:17 +0000
Subject: [PATCH 1806/3799] soh: rename D_8012AE3C -> sSkyQuadIndices

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the 0x40 vertex indices, four per quad, that stitch an outdoor-skybox face into sixteen quads.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 701fa2778..18d73233e 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -135,7 +135,8 @@ s16 sSkyVtxVCap[5] = {  // was D_8012AE30 [LLM:HIGH]
     0x0000, 0x07C0, 0x0F80, 0x07C0, 0x0000,
 };
 
-s16 D_8012AE3C[0x40] = {
+// LLM generated name (HIGH), was D_8012AE3C: the 0x40 vertex indices, four per quad, that stitch an outdoor-skybox face into sixteen quads.
+s16 sSkyQuadIndices[0x40] = {  // was D_8012AE3C [LLM:HIGH]
     0x00, 0x10, 0x13, 0x12, 0x10, 0x01, 0x14, 0x13, 0x01, 0x11, 0x15, 0x14, 0x11, 0x05, 0x16, 0x15,
     0x12, 0x13, 0x17, 0x02, 0x13, 0x14, 0x03, 0x17, 0x14, 0x15, 0x18, 0x03, 0x15, 0x16, 0x07, 0x18,
     0x02, 0x17, 0x1A, 0x19, 0x17, 0x03, 0x1B, 0x1A, 0x03, 0x18, 0x1C, 0x1B, 0x18, 0x07, 0x1D, 0x1C,
@@ -383,8 +384,8 @@ s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
 
                 gDPNoOpString(skyboxCtx->unk_138++, "TEST2", 0);
 
-                gSP1Quadrangle(skyboxCtx->unk_138++, D_8012AE3C[phi_t2_4 + 1], D_8012AE3C[phi_t2_4 + 2],
-                               D_8012AE3C[phi_t2_4 + 3], D_8012AE3C[phi_t2_4 + 0], 3);
+                gSP1Quadrangle(skyboxCtx->unk_138++, sSkyQuadIndices[phi_t2_4 + 1], sSkyQuadIndices[phi_t2_4 + 2],  // was D_8012AE3C [LLM:HIGH]
+                               sSkyQuadIndices[phi_t2_4 + 3], sSkyQuadIndices[phi_t2_4 + 0], 3);  // was D_8012AE3C [LLM:HIGH]
             }
         }
     } else {
@@ -399,8 +400,8 @@ s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                                  128, 0, phi_a0_4, phi_a2_4, phi_a0_4 + 0x1F, phi_a2_4 + 0x1F, 0,
                                  G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK, G_TX_NOLOD, G_TX_NOMIRROR | G_TX_WRAP,
                                  G_TX_NOMASK, G_TX_NOLOD);
-                gSP1Quadrangle(skyboxCtx->unk_138++, D_8012AE3C[phi_t2_4 + 1], D_8012AE3C[phi_t2_4 + 2],
-                               D_8012AE3C[phi_t2_4 + 3], D_8012AE3C[phi_t2_4 + 0], 3);
+                gSP1Quadrangle(skyboxCtx->unk_138++, sSkyQuadIndices[phi_t2_4 + 1], sSkyQuadIndices[phi_t2_4 + 2],  // was D_8012AE3C [LLM:HIGH]
+                               sSkyQuadIndices[phi_t2_4 + 3], sSkyQuadIndices[phi_t2_4 + 0], 3);  // was D_8012AE3C [LLM:HIGH]
             }
         }
         phi_a2_4 -= 0x1F;
@@ -414,8 +415,8 @@ s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                                  128, 0, phi_a0_4, phi_a2_4, phi_a0_4 + 0x1F, phi_a2_4 + 0x1F, 0,
                                  G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK, G_TX_NOLOD, G_TX_NOMIRROR | G_TX_WRAP,
                                  G_TX_NOMASK, G_TX_NOLOD);
-                gSP1Quadrangle(skyboxCtx->unk_138++, D_8012AE3C[phi_t2_4 + 1], D_8012AE3C[phi_t2_4 + 2],
-                               D_8012AE3C[phi_t2_4 + 3], D_8012AE3C[phi_t2_4 + 0], 3);
+                gSP1Quadrangle(skyboxCtx->unk_138++, sSkyQuadIndices[phi_t2_4 + 1], sSkyQuadIndices[phi_t2_4 + 2],  // was D_8012AE3C [LLM:HIGH]
+                               sSkyQuadIndices[phi_t2_4 + 3], sSkyQuadIndices[phi_t2_4 + 0], 3);  // was D_8012AE3C [LLM:HIGH]
             }
         }
     }
