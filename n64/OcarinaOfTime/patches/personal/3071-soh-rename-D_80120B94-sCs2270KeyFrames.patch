From 8f17992599a664bcf8e4c59a47a49f8606a022c1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:37 +0000
Subject: [PATCH 3071/3799] soh: rename D_80120B94 -> sCs2270KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 2270 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 16 ++++++++--------
 soh/src/code/z_onepointdemo_data.inc |  3 ++-
 2 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 57e86a1f4..11970d778 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -20,7 +20,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs1030KeyFrames)                                   \
     F(sCs5000KeyFrames)                                   \
     F(sCs2260KeyFrames)                                   \
-    F(D_80120B94)                                   \
+    F(sCs2270KeyFrames)                                   \
     F(D_80120D4C)                                   \
     F(D_80120FA4)                                   \
     F(D_80121184)                                   \
@@ -181,19 +181,19 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
             break;
         case 2270:
-            csInfo->keyFrames = D_80120B94;
+            csInfo->keyFrames = sCs2270KeyFrames;  // was D_80120B94 [LLM:HIGH]
             csInfo->keyFrameCnt = 11;
 
             for (i = 0; i < csInfo->keyFrameCnt - 3; i++) {
-                if (D_80120B94[i].actionFlags != 0x8F) {
-                    D_80120B94[i].atTargetInit.x = Rand_ZeroOne() * 5.0f;
-                    D_80120B94[i].atTargetInit.z = (Rand_ZeroOne() * 30.0f) + 10.0f;
-                    D_80120B94[i].eyeTargetInit.x = (Rand_ZeroOne() * 100.0f) + 20.0f;
-                    D_80120B94[i].eyeTargetInit.z = (Rand_ZeroOne() * 80.0f) + 50.0f;
+                if (sCs2270KeyFrames[i].actionFlags != 0x8F) {  // was D_80120B94 [LLM:HIGH]
+                    sCs2270KeyFrames[i].atTargetInit.x = Rand_ZeroOne() * 5.0f;  // was D_80120B94 [LLM:HIGH]
+                    sCs2270KeyFrames[i].atTargetInit.z = (Rand_ZeroOne() * 30.0f) + 10.0f;  // was D_80120B94 [LLM:HIGH]
+                    sCs2270KeyFrames[i].eyeTargetInit.x = (Rand_ZeroOne() * 100.0f) + 20.0f;  // was D_80120B94 [LLM:HIGH]
+                    sCs2270KeyFrames[i].eyeTargetInit.z = (Rand_ZeroOne() * 80.0f) + 50.0f;  // was D_80120B94 [LLM:HIGH]
                 }
             }
 
-            D_80120B94[camIdx - 1].eyeTargetInit.y =
+            sCs2270KeyFrames[camIdx - 1].eyeTargetInit.y =  // was D_80120B94 [LLM:HIGH]
                 ((mainCam->play->state.frames & 1) ? 3.0f : -3.0f) + Rand_ZeroOne();
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
 
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 30c2d7168..a687d2abe 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -177,7 +177,8 @@ static OnePointCsFull sCs2260KeyFrames[5] = {  // was D_80120ACC [LLM:HIGH]
     { 0x11, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80120B94[11] = {
+// LLM generated name (HIGH), was D_80120B94: the keyframe set one-point cutscene 2270 installs
+static OnePointCsFull sCs2270KeyFrames[11] = {  // was D_80120B94 [LLM:HIGH]
     { 0x8F, 0x01, 0x2142, 1, 0, 40.0f, 1.0f, { 20.0f, 40.0f, 20.0f }, { -20.0f, 0.0f, -30.0f } },
     { 0x84, 0xFF, 0x0404, 19, 5, 70.0f, 0.01f, { 0.0f, 30.0f, 20.0f }, { 120.0f, 60.0f, 120.0f } },
     { 0x84, 0xFF, 0x0404, 20, 0, 60.0f, 0.01f, { 0.0f, 20.0f, 20.0f }, { 120.0f, 60.0f, 120.0f } },
