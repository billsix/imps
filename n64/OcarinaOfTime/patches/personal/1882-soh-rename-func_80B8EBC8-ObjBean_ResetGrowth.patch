From 3785c73049aab24734cfe615459f94db33fc6ce8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:50:06 +0000
Subject: [PATCH 1882/3799] soh: rename func_80B8EBC8 -> ObjBean_ResetGrowth

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: zeroes the three growth angles and the sway offset, returning the plant to its ungrown state.
Defined in soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
index fe3dda12b..cfd9a8b7e 100644
--- a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
+++ b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
@@ -164,7 +164,8 @@ void ObjBean_FindFloor(ObjBean* this, PlayState* play) {
         BgCheck_EntityRaycastFloor4(&play->colCtx, &this->dyna.actor.floorPoly, &sp20, &this->dyna.actor, &vec);
 }
 
-void func_80B8EBC8(ObjBean* this) {
+// LLM generated name (HIGH), was func_80B8EBC8: zeroes the three growth angles and the sway offset, returning the plant to its ungrown state.
+void ObjBean_ResetGrowth(ObjBean* this) {
     this->unk_1B6.x = this->unk_1B6.y = this->unk_1B6.z = 0;
     this->unk_1E4 = 0.0f;
 }
@@ -867,7 +868,7 @@ void func_80B90A34(ObjBean* this, PlayState* play) {
         DynaPoly_EnableCollision(play, &play->colCtx.dyna, this->dyna.bgId);
     }
     if ((this->timer <= 0) && (!trampled)) {
-        func_80B8EBC8(this);
+        ObjBean_ResetGrowth(this);  // was func_80B8EBC8 [LLM:HIGH]
         ObjBean_SetupWaitForPlayer(this);
     }
 }
