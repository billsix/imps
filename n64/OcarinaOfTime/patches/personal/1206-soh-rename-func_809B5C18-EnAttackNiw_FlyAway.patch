         this->actor.gravity = 0.0f;
         this->unk_2DC = 0.0f;
         this->unk_2D0 = this->actor.world.rot.x - 5000.0f;
-        this->actionFunc = func_809B5C18;
+        this->actionFunc = EnAttackNiw_FlyAway;  // was func_809B5C18 [LLM:HIGH]
     } else if (this->actor.bgCheckFlags & BGCHECKFLAG_GROUND) {
         EnAttackNiw_UpdateFlapping(this, play, 5);  // was func_809B5268 [LLM:HIGH]
     } else {
@@ -291,7 +292,7 @@ void EnAttackNiw_ChasePlayer(EnAttackNiw* this, PlayState* play) {
     }
 }
 
