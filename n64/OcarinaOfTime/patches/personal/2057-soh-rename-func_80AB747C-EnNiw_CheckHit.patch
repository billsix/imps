From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:10:58 +0000
Subject: [PATCH 2057/3799] soh: rename func_80AB747C -> EnNiw_CheckHit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: on AC_HIT decrements the hit counter, cries, and sends the cucco fleeing
Defined in soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c b/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c
index 92bdfb71d..a7d661e9b 100644
--- a/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c
+++ b/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c
@@ -886,7 +886,8 @@ void EnNiw_WaitToLand(EnNiw* this, PlayState* play) {
     }
 }
 
-void func_80AB747C(EnNiw* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AB747C: on AC_HIT decrements the hit counter, cries, and sends the cucco fleeing
+void EnNiw_CheckHit(EnNiw* this, PlayState* play) {
     if (this->unk_2A8 == 0 && this->actor.params != 0xA && this->actionFunc != EnNiw_WaitToBeLifted &&  // was func_80AB6450 [LLM:HIGH]
         this->collider.base.acFlags & AC_HIT) {
         this->collider.base.acFlags &= ~AC_HIT;
@@ -1104,7 +1105,7 @@ void EnNiw_Update(Actor* thisx, PlayState* play) {
         Actor_SetPlayerKnockbackLarge(play, &this->actor, 2.0f, thisx->world.rot.y, 0.0f, 0x10);
     }
 
-    func_80AB747C(this, play);
+    EnNiw_CheckHit(this, play);  // was func_80AB747C [LLM:HIGH]
 
     if (this->sfxTimer2 == 0 && this->actionFunc == EnNiw_Held) {  // was func_80AB6BF8 [LLM:HIGH]
         this->sfxTimer2 = 7;
