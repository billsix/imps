From 92298f54fddbe213cfc0a3f12562e9dbafd8540a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:10:55 +0000
Subject: [PATCH 1332/3799] soh: rename func_80B93DF4 ->
 ObjHsblock_WaitForSwitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: waits for the block's switch flag before starting the rise.
Defined in soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c b/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
index 780da9681..9724e7af5 100644
--- a/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
+++ b/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
@@ -14,7 +14,8 @@ void ObjHsblock_Destroy(Actor* thisx, PlayState* play);
 void ObjHsblock_Update(Actor* thisx, PlayState* play);
 void ObjHsblock_Draw(Actor* thisx, PlayState* play);
 
-void func_80B93DF4(ObjHsblock* this, PlayState* play);
+// LLM generated name (HIGH), was func_80B93DF4: waits for the block's switch flag before starting the rise.
+void ObjHsblock_WaitForSwitch(ObjHsblock* this, PlayState* play);  // was func_80B93DF4 [LLM:HIGH]
 void func_80B93E5C(ObjHsblock* this, PlayState* play);
 
 // LLM generated name (HIGH), was func_80B93D90: clears actionFunc so the block just sits there; the terminal state for every variant.
@@ -117,10 +118,10 @@ void ObjHsblock_SetupIdle(ObjHsblock* this) {
 void ObjHsblock_SetupWaitForSwitch(ObjHsblock* this) {
     this->dyna.actor.flags |= ACTOR_FLAG_UPDATE_CULLING_DISABLED;
     this->dyna.actor.world.pos.y = this->dyna.actor.home.pos.y - 105.0f;
-    ObjHsblock_SetupAction(this, func_80B93DF4);
+    ObjHsblock_SetupAction(this, ObjHsblock_WaitForSwitch);  // was func_80B93DF4 [LLM:HIGH]
 }
 
-void func_80B93DF4(ObjHsblock* this, PlayState* play) {
+void ObjHsblock_WaitForSwitch(ObjHsblock* this, PlayState* play) {
     if (Flags_GetSwitch(play, (this->dyna.actor.params >> 8) & 0x3F)) {
         func_80B93E38(this);
     }
