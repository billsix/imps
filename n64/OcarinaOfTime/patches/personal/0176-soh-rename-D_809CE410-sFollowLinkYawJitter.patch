From 46fc4edb0e749f37188ceb4bb5545f8b61730918 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:30 +0000
Subject: [PATCH 176/225] soh: rename D_809CE410 -> sFollowLinkYawJitter

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c b/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
index 418fef5f5..d38420e79 100644
--- a/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
+++ b/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
@@ -299,7 +299,8 @@ void EnButte_SetupFollowLink(EnButte* this) {
 }
 
 void EnButte_FollowLink(EnButte* this, PlayState* play) {
-    static s32 D_809CE410 = 1500;
+    // LLM generated name (HIGH), was D_809CE410: random yaw offset toward the sword tip, sign flipped each cycle.
+    static s32 sFollowLinkYawJitter = 1500;
     EnButteFlightParams* flightParams = &sFollowLinkParams[this->flightParamsIdx];
     Player* player = GET_PLAYER(play);
     f32 distSqFromHome;
@@ -319,7 +320,7 @@ void EnButte_FollowLink(EnButte* this, PlayState* play) {
         swordTip.y = player->meleeWeaponInfo[0].tip.y;
         swordTip.z = player->meleeWeaponInfo[0].tip.z + Math_CosS(player->actor.shape.rot.y) * 10.0f;
 
-        yaw = Math_Vec3f_Yaw(&this->actor.world.pos, &swordTip) + (s16)(Rand_ZeroOne() * D_809CE410);
+        yaw = Math_Vec3f_Yaw(&this->actor.world.pos, &swordTip) + (s16)(Rand_ZeroOne() * sFollowLinkYawJitter);
         if (Math_ScaledStepToS(&this->actor.world.rot.y, yaw, 2000) != 0) {
             if (play->gameplayFrames % 2) {
                 this->actor.world.rot.y += (s16)(sinf(this->unk_25C) * 60.0f);
@@ -340,7 +341,7 @@ void EnButte_FollowLink(EnButte* this, PlayState* play) {
 
     if (this->timer <= 0) {
         EnButte_SelectFlightParams(this, &sFollowLinkParams[this->flightParamsIdx]);
-        D_809CE410 = -D_809CE410;
+        sFollowLinkYawJitter = -sFollowLinkYawJitter;
     }
 
     distSqFromHome = Math3D_Dist2DSq(this->actor.world.pos.x, this->actor.world.pos.z, this->actor.home.pos.x,
-- 
