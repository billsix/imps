From 900ca615e3a518a553cbc7a284f96ad2bae335e6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:11 +0000
Subject: [PATCH 3447/3799] soh: rename D_80AF7454 -> sSaFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point EnSa_PostLimbDraw records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
index b1e2d1c1f..c8a2dc862 100644
--- a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
+++ b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
@@ -819,10 +819,10 @@ s32 EnSa_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 
 void EnSa_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx, Gfx** gfx) {
     EnSa* this = (EnSa*)thisx;
-    Vec3f D_80AF7454 = { 400.0, 0.0f, 0.0f };
+    Vec3f sSaFocusOffset = { 400.0, 0.0f, 0.0f };  // was D_80AF7454 [LLM:HIGH]
 
     if (limbIndex == 16) {
-        Matrix_MultVec3f(&D_80AF7454, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sSaFocusOffset, &this->actor.focus.pos);  // was D_80AF7454 [LLM:HIGH]
     }
 }
 
