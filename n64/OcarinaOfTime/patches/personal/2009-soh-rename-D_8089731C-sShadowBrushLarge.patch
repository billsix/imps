From 72db62f1f0953e3de2cb16c1c4be79ef22a61347 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:08:50 +0000
Subject: [PATCH 2009/3799] soh: rename D_8089731C -> sShadowBrushLarge

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: 11x11 alpha brush stamped along the statue outline when building the shadow texture
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
index 8139692cd..09280132e 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
@@ -47,7 +47,8 @@ static u8 sBeamDimsWithAngle[] = { true, false, true, false };  // was D_8089731
 // LLM generated name (HIGH), was D_80897314: per-params yaw the statue is measured against when dimming the beam
 static s16 sBeamAlignedYaws[] = { -0x4000, 0000, 0x4000, 0000 };  // was D_80897314 [LLM:HIGH]
 
-static u8 D_8089731C[11][11] = {
+// LLM generated name (HIGH), was D_8089731C: 11x11 alpha brush stamped along the statue outline when building the shadow texture
+static u8 sShadowBrushLarge[11][11] = {  // was D_8089731C [LLM:HIGH]
     { 0x00, 0x00, 0x20, 0x80, 0x80, 0x80, 0x80, 0x80, 0x20, 0x00, 0x00 },
     { 0x00, 0x20, 0x80, 0xA0, 0xA3, 0xA3, 0xA3, 0xA0, 0x80, 0x20, 0x00 },
     { 0x20, 0x80, 0xA0, 0xA5, 0xA6, 0xA6, 0xA6, 0xA5, 0xA0, 0x80, 0x20 },
@@ -318,7 +319,7 @@ void BgJyaCobra_UpdateShadowFromSide(BgJyaCobra* this) {
                     for (l = 0; l < 11; l++) {
                         temp_x = x - 5 + l;
                         if (!(temp_x & ~0x3F)) {
-                            shadowTex[temp_z + temp_x] |= D_8089731C[k][l];
+                            shadowTex[temp_z + temp_x] |= sShadowBrushLarge[k][l];  // was D_8089731C [LLM:HIGH]
                         }
                     }
                 }
