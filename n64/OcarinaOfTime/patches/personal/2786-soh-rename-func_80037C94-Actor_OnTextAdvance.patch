From 32f08be79c9e179963782a07e32adf47ee90674b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:37 +0000
Subject: [PATCH 2786/3799] soh: rename func_80037C94 -> Actor_OnTextAdvance

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: runs the choice handler for the actor's current text
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 7ae5cf8d0..5f40c9c0a 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -6376,7 +6376,8 @@ s32 Actor_OnTextClosed(PlayState* play, s16 arg1, u16 textId) {
     return false;
 }
 
-s32 func_80037C94(PlayState* play, Actor* actor, s32 arg2) {
+// LLM generated name (HIGH), was func_80037C94: runs the choice handler for the actor's current text
+s32 Actor_OnTextAdvance(PlayState* play, Actor* actor, s32 arg2) {
     return Actor_HandleNpcChoice(play, actor, actor->textId);  // was func_800374E0 [LLM:HIGH]
 }
 
@@ -6391,7 +6392,7 @@ s32 func_80037CB8(PlayState* play, Actor* actor, s16 arg2) {
             break;
         case TEXT_STATE_CHOICE:
         case TEXT_STATE_EVENT:
-            if (Message_ShouldAdvance(play) && func_80037C94(play, actor, arg2)) {
+            if (Message_ShouldAdvance(play) && Actor_OnTextAdvance(play, actor, arg2)) {  // was func_80037C94 [LLM:HIGH]
                 Audio_PlaySfxGeneral(NA_SE_SY_CANCEL, &gSfxDefaultPos, 4, &gSfxDefaultFreqAndVolScale,
                                      &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
                 msgCtx->msgMode = MSGMODE_TEXT_CLOSING;
