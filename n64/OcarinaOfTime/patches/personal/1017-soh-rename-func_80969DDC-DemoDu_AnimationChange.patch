Subject: [PATCH 1017/3799] soh: rename func_80969DDC -> DemoDu_AnimationChange

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: wraps Animation_Change, choosing forward or reversed playback from its last argument; the counterpart of DemoSa_AnimationChange.
Defined in soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c b/soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c
index 047e150b1..e8d9bd01b 100644
--- a/soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c
+++ b/soh/src/overlays/actors/ovl_Demo_Du/z_demo_du.c
@@ -147,7 +147,8 @@ void DemoDu_MoveToNpcPos(DemoDu* this, PlayState* play, s32 idx) {
     }
 }
 
-void func_80969DDC(DemoDu* this, AnimationHeader* animation, u8 mode, f32 morphFrames, s32 arg4) {
+// LLM generated name (HIGH), was func_80969DDC: wraps Animation_Change, choosing forward or reversed playback from its last argument; the counterpart of DemoSa_AnimationChange.
+void DemoDu_AnimationChange(DemoDu* this, AnimationHeader* animation, u8 mode, f32 morphFrames, s32 arg4) {
     f32 startFrame;
     s16 lastFrame = Animation_GetLastFrame(animation);
     f32 endFrame;
@@ -874,18 +875,18 @@ void DemoDu_CsCredits_AdvanceTo02(DemoDu* this) {
 }
 
