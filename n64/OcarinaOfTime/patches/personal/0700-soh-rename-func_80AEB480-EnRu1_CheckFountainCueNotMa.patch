     return EnRu1_CheckCueMatchingId(play, action, 3);
 }
 
-s32 func_80AEB480(PlayState* play, u16 action) {
+// Name from zeldaret/oot (was func_80AEB480): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_CheckFountainCueNotMatchingId(PlayState* play, u16 action) {
     return EnRu1_CheckCueNotMatchingId(play, action, 3);
 }
 
