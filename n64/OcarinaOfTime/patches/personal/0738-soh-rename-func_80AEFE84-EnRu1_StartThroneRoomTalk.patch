Subject: [PATCH 738/784] soh: rename func_80AEFE84 ->
 EnRu1_StartThroneRoomTalk

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 632648851..48a0eb5c2 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -2330,7 +2330,8 @@ s32 EnRu1_IsThroneRoomTextClosing(EnRu1* this, PlayState* play) {
     return false;
 }
 
-void func_80AEFE84(EnRu1* this, PlayState* play, s32 cond) {
+// Name from zeldaret/oot (was func_80AEFE84): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_StartThroneRoomTalk(EnRu1* this, PlayState* play, s32 cond) {
     if (cond) {
         this->action = 45;
     }
@@ -2349,7 +2350,7 @@ void EnRu1_ThroneRoom_Idle(EnRu1* this, PlayState* play) {
     EnRu1_UpdateEyes(this);
     EnRu1_UpdateStandingOC(this, play);
     EnRu1_UpdateBgCheckInfo(this, play);
-    func_80AEFE84(this, play, EnRu1_ThroneRoomTalkOfferAccepted(this, play));
+    EnRu1_StartThroneRoomTalk(this, play, EnRu1_ThroneRoomTalkOfferAccepted(this, play));
 }
 
 void EnRu1_ThroneRoom_Talk(EnRu1* this, PlayState* play) {
