Date: Tue, 8 Sep 2026 00:19:12 +0000
Subject: [PATCH 3450/3799] soh: rename D_80B4A2A4 -> sZfSwordTipOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the sword tip point, as the file's own comment says
Defined in soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c b/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
index 305e54b52..fff01e5e9 100644
--- a/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
+++ b/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
@@ -2170,7 +2170,7 @@ s32 EnZf_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 void EnZf_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx, Gfx** gfx) {
     static Vec3f sUnused = { 1100.0f, -700.0f, 0.0f };
     static Vec3f footOffset = { 300.0f, 0.0f, 0.0f };
-    static Vec3f D_80B4A2A4 = { 300.0f, -1700.0f, 0.0f }; // Sword tip?
+    static Vec3f sZfSwordTipOffset = { 300.0f, -1700.0f, 0.0f }; // Sword tip?, was D_80B4A2A4 [LLM:HIGH]
     static Vec3f D_80B4A2B0 = { -600.0f, 300.0f, 0.0f };  // Sword hilt?
     static Vec3f swordQuadOffset1 = { 0.0f, 1500.0f, 0.0f };
     static Vec3f swordQuadOffset0 = { -600.0f, -3000.0f, 1000.0f };
@@ -2190,7 +2190,7 @@ void EnZf_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
         Collider_SetQuadVertices(&this->swordCollider, &this->swordCollider.dim.quad[0],
                                  &this->swordCollider.dim.quad[1], &this->swordCollider.dim.quad[2],
                                  &this->swordCollider.dim.quad[3]);
-        Matrix_MultVec3f(&D_80B4A2A4, &sp54);
+        Matrix_MultVec3f(&sZfSwordTipOffset, &sp54);  // was D_80B4A2A4 [LLM:HIGH]
         Matrix_MultVec3f(&D_80B4A2B0, &sp48);
 
         if (this->action == ENZF_ACTION_SLASH) {
