 void func_8089350C(BgJyaAmishutter* this);
@@ -89,14 +90,14 @@ void BgJyaAmishutter_SetupOpen(BgJyaAmishutter* this) {
 
 void BgJyaAmishutter_Open(BgJyaAmishutter* this) {
     if (Math_StepToF(&this->dyna.actor.world.pos.y, this->dyna.actor.home.pos.y + 100.0f, 3.0f)) {
-        func_808934B0(this);
+        BgJyaAmishutter_SetupWaitForPlayerLeave(this);  // was func_808934B0 [LLM:HIGH]
         Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_METALDOOR_STOP);
     } else {
         Actor_PlaySfx_Flagged(&this->dyna.actor, NA_SE_EV_METALDOOR_SLIDE - SFX_FLAG);
     }
 }
 
-void func_808934B0(BgJyaAmishutter* this) {
+void BgJyaAmishutter_SetupWaitForPlayerLeave(BgJyaAmishutter* this) {
     this->actionFunc = func_808934C0;
 }
 
