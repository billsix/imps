From 6161f2cb3675520adfed9cbc32b0c7019eee5db0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:38 +0000
Subject: [PATCH 2797/3799] soh: rename D_801160A0 ->
 sTargetCategorySearchOrder

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the actor categories the Z-target search walks, the first three before any fallback
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index edb0d8a47..f2e91f8fe 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -3638,7 +3638,8 @@ void Attention_FindActorInCategory(PlayState* play, ActorContext* actorCtx, Play
     }
 }
 
-u8 D_801160A0[] = {
+// LLM generated name (HIGH), was D_801160A0: the actor categories the Z-target search walks, the first three before any fallback
+u8 sTargetCategorySearchOrder[] = {  // was D_801160A0 [LLM:HIGH]
     ACTORCAT_BOSS,  ACTORCAT_ENEMY,  ACTORCAT_BG,   ACTORCAT_EXPLOSIVE, ACTORCAT_NPC,  ACTORCAT_ITEMACTION,
     ACTORCAT_CHEST, ACTORCAT_SWITCH, ACTORCAT_PROP, ACTORCAT_MISC,      ACTORCAT_DOOR, ACTORCAT_SWITCH,
 };
@@ -3652,7 +3653,7 @@ Actor* Attention_FindActor(PlayState* play, ActorContext* actorCtx, Actor** acto
     sBestTargetPriority = 0x7FFFFFFF;  // was D_8015BBF8 [LLM:HIGH]
 
     if (!Player_InCsMode(play)) {
-        entry = &D_801160A0[0];
+        entry = &sTargetCategorySearchOrder[0];  // was D_801160A0 [LLM:HIGH]
 
         actorCtx->targetCtx.bgmEnemy = NULL;
         sTargetPlayerYaw = player->actor.shape.rot.y;  // was D_8015BBFC [LLM:HIGH]
@@ -3663,7 +3664,7 @@ Actor* Attention_FindActor(PlayState* play, ActorContext* actorCtx, Actor** acto
         }
 
         if (D_8015BBE8 == NULL) {
-            for (; i < ARRAY_COUNT(D_801160A0); i++) {
+            for (; i < ARRAY_COUNT(sTargetCategorySearchOrder); i++) {  // was D_801160A0 [LLM:HIGH]
                 Attention_FindActorInCategory(play, actorCtx, player, *entry);
                 entry++;
             }
