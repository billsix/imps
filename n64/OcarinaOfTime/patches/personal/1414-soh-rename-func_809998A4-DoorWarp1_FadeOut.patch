From 03fed79f814871e92cff3649ae55686b07cd540a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:17:39 +0000
Subject: [PATCH 1414/3799] soh: rename func_809998A4 -> DoorWarp1_FadeOut

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: fades the light ray and the warp body away, looping the warp-hole sfx until they reach zero.
Defined in soh/src/overlays/actors/ovl_Door_Warp1/z_door_warp1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Door_Warp1/z_door_warp1.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Door_Warp1/z_door_warp1.c b/soh/src/overlays/actors/ovl_Door_Warp1/z_door_warp1.c
index 3723fdc9c..c9ab2bf85 100644
--- a/soh/src/overlays/actors/ovl_Door_Warp1/z_door_warp1.c
+++ b/soh/src/overlays/actors/ovl_Door_Warp1/z_door_warp1.c
@@ -25,7 +25,8 @@ void DoorWarp1_BlueCrystalFadeToBlack(DoorWarp1* this, PlayState* play);  // was
 void DoorWarp1_BlueCrystalStartFanfare(DoorWarp1* this, PlayState* play);  // was func_80999348 [LLM:HIGH]
 // LLM generated name (HIGH), was func_809995D4: once that wait ends it relocates the warp to its fixed chamber coordinates and re-aims both point lights at the new position.
 void DoorWarp1_BlueCrystalMoveIntoPlace(DoorWarp1* this, PlayState* play);  // was func_809995D4 [LLM:HIGH]
-void func_809998A4(DoorWarp1* this, PlayState* play);
+// LLM generated name (HIGH), was func_809998A4: fades the light ray and the warp body away, looping the warp-hole sfx until they reach zero.
+void DoorWarp1_FadeOut(DoorWarp1* this, PlayState* play);  // was func_809998A4 [LLM:HIGH]
 void DoorWarp1_ChildWarpIdle(DoorWarp1* this, PlayState* play);
 void DoorWarp1_RutoWarpIdle(DoorWarp1* this, PlayState* play);
 void DoorWarp1_ChildWarpOut(DoorWarp1* this, PlayState* play);
@@ -447,7 +448,7 @@ void DoorWarp1_WarpAppear(DoorWarp1* this, PlayState* play) {
         } else if (this->actor.params != WARP_SAGES && this->actor.params != WARP_YELLOW) {
             DoorWarp1_SetupAction(this, DoorWarp1_ChildWarpIdle);
         } else {
-            DoorWarp1_SetupAction(this, func_809998A4);
+            DoorWarp1_SetupAction(this, DoorWarp1_FadeOut);  // was func_809998A4 [LLM:HIGH]
         }
     } else {
         if (this->unk_1AE < -50) {
@@ -456,12 +457,12 @@ void DoorWarp1_WarpAppear(DoorWarp1* this, PlayState* play) {
         if (this->unk_1B0 < 70) {
             this->unk_1B0 += 4;
         } else {
-            DoorWarp1_SetupAction(this, func_809998A4);
+            DoorWarp1_SetupAction(this, DoorWarp1_FadeOut);  // was func_809998A4 [LLM:HIGH]
         }
     }
 }
 
-void func_809998A4(DoorWarp1* this, PlayState* play) {
+void DoorWarp1_FadeOut(DoorWarp1* this, PlayState* play) {
     if (this->lightRayAlpha != 0.0f) {
         Audio_PlayActorSound2(&this->actor, NA_SE_EV_WARP_HOLE - SFX_FLAG);
     }
