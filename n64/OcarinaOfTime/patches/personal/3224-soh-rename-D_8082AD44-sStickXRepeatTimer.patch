From d84eefc6630ba4e8f8bcb127db3b5f4751f1c4fd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:48 +0000
Subject: [PATCH 3224/3799] soh: rename D_8082AD44 -> sStickXRepeatTimer

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the repeat delay for horizontal stick input on the pause pages
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_scope_PAL.c   | 26 +++++++++----------
 1 file changed, 13 insertions(+), 13 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 5c9a2877e..8c1db243d 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -1456,7 +1456,7 @@ void KaleidoScope_DrawPages(PlayState* play, GraphicsContext* gfxCtx) {
 
     static s16 D_8082AD3C = 20;
     static s16 sCursorColorPhase = 0;  // was D_8082AD40 [LLM:HIGH]
-    static s16 D_8082AD44 = 0;
+    static s16 sStickXRepeatTimer = 0;  // was D_8082AD44 [LLM:HIGH]
     static s16 D_8082AD48 = 0;
     static s16 D_8082AD4C = 0;
     static s16 D_8082AD50 = 0;
@@ -1505,20 +1505,20 @@ void KaleidoScope_DrawPages(PlayState* play, GraphicsContext* gfxCtx) {
             if (CVarGetInteger(CVAR_SETTING("DpadHoldChange"), 1) && CVarGetInteger(CVAR_SETTING("DPadOnPause"), 0)) {
                 if (CHECK_BTN_ALL(input->cur.button, BTN_DLEFT)) {
                     if (CHECK_BTN_ALL(input->press.button, BTN_DLEFT)) {
-                        D_8082AD44 = XREG(8);
+                        sStickXRepeatTimer = XREG(8);  // was D_8082AD44 [LLM:HIGH]
                         D_8082AD4C = -1;
-                    } else if (--D_8082AD44 < 0) {
-                        D_8082AD44 = XREG(6);
+                    } else if (--sStickXRepeatTimer < 0) {  // was D_8082AD44 [LLM:HIGH]
+                        sStickXRepeatTimer = XREG(6);  // was D_8082AD44 [LLM:HIGH]
                         input->press.button |= BTN_DLEFT;
                     }
                 } else if (CHECK_BTN_ALL(input->rel.button, BTN_DLEFT)) {
                     D_8082AD4C = 0;
                 } else if (CHECK_BTN_ALL(input->cur.button, BTN_DRIGHT)) {
                     if (CHECK_BTN_ALL(input->press.button, BTN_DRIGHT)) {
-                        D_8082AD44 = XREG(8);
+                        sStickXRepeatTimer = XREG(8);  // was D_8082AD44 [LLM:HIGH]
                         D_8082AD4C = 1;
-                    } else if (--D_8082AD44 < 0) {
-                        D_8082AD44 = XREG(6);
+                    } else if (--sStickXRepeatTimer < 0) {  // was D_8082AD44 [LLM:HIGH]
+                        sStickXRepeatTimer = XREG(6);  // was D_8082AD44 [LLM:HIGH]
                         input->press.button |= BTN_DRIGHT;
                     }
                 } else if (CHECK_BTN_ALL(input->rel.button, BTN_DRIGHT)) {
@@ -1550,24 +1550,24 @@ void KaleidoScope_DrawPages(PlayState* play, GraphicsContext* gfxCtx) {
 
             if (pauseCtx->stickRelX < -30) {
                 if (D_8082AD4C == -1) {
-                    if (--D_8082AD44 < 0) {
-                        D_8082AD44 = XREG(6);
+                    if (--sStickXRepeatTimer < 0) {  // was D_8082AD44 [LLM:HIGH]
+                        sStickXRepeatTimer = XREG(6);  // was D_8082AD44 [LLM:HIGH]
                     } else {
                         pauseCtx->stickRelX = 0;
                     }
                 } else {
-                    D_8082AD44 = XREG(8);
+                    sStickXRepeatTimer = XREG(8);  // was D_8082AD44 [LLM:HIGH]
                     D_8082AD4C = -1;
                 }
             } else if (pauseCtx->stickRelX > 30) {
                 if (D_8082AD4C == 1) {
-                    if (--D_8082AD44 < 0) {
-                        D_8082AD44 = XREG(6);
+                    if (--sStickXRepeatTimer < 0) {  // was D_8082AD44 [LLM:HIGH]
+                        sStickXRepeatTimer = XREG(6);  // was D_8082AD44 [LLM:HIGH]
                     } else {
                         pauseCtx->stickRelX = 0;
                     }
                 } else {
-                    D_8082AD44 = XREG(8);
+                    sStickXRepeatTimer = XREG(8);  // was D_8082AD44 [LLM:HIGH]
                     D_8082AD4C = 1;
                 }
             } else {
