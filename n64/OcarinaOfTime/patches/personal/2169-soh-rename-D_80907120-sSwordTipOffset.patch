From e0345842695e96e71207eac34ebde70a5e6f8c10 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:15:36 +0000
Subject: [PATCH 2169/3799] soh: rename D_80907120 -> sSwordTipOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: 17000 units out along the blade, the far end of the sword trail ribbon
Defined in soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c     | 6 +++---
 .../overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c    | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
index 0355a9256..67a4e716a 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -2614,7 +2614,7 @@ void BossGanon2_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
 
     OPEN_DISPS(play->state.gfxCtx);
 
-    D_80907120.z = 17000.0f;
+    sSwordTipOffset.z = 17000.0f;  // was D_80907120 [LLM:HIGH]
     D_8090712C.z = 3000.0f;
 
     if (sLimbPosIndices[limbIndex] >= 0) {  // was D_809070CC [LLM:HIGH]
@@ -2659,12 +2659,12 @@ void BossGanon2_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
         if ((limbIndex == 7) && (this->unk_312 == 1)) {
             Matrix_MultVec3f(&sSwordTrailAnchorOffset, &this->unk_218);  // was D_809070FC [LLM:GUESS]
             func_808FD080(0, &this->unk_444, &this->unk_218);
-            Matrix_MultVec3f(&D_80907120, &this->unk_200);
+            Matrix_MultVec3f(&sSwordTipOffset, &this->unk_200);  // was D_80907120 [LLM:HIGH]
             Matrix_MultVec3f(&D_8090712C, &this->unk_20C);
         } else if ((limbIndex == 13) && (this->unk_312 == 2)) {
             Matrix_MultVec3f(&sSwordTrailAnchorOffset, &this->unk_218);  // was D_809070FC [LLM:GUESS]
             func_808FD080(1, &this->unk_444, &this->unk_218);
-            Matrix_MultVec3f(&D_80907120, &this->unk_200);
+            Matrix_MultVec3f(&sSwordTipOffset, &this->unk_200);  // was D_80907120 [LLM:HIGH]
             Matrix_MultVec3f(&D_8090712C, &this->unk_20C);
         }
     }
diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
index 97b68b856..b391dee85 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
@@ -290,7 +290,8 @@ static Vec3f sLimb3TrackOffset = { 0.0f, 2000.0f, 0.0f };  // was D_80907108 [LL
 // LLM generated name (HIGH), was D_80907114: the offset whose transformed position limb 9 records
 static Vec3f sLimb9TrackOffset = { 0.0f, 2000.0f, 0.0f };  // was D_80907114 [LLM:HIGH]
 
-static Vec3f D_80907120 = { 0.0f, 0.0f, 17000.0f };
+// LLM generated name (HIGH), was D_80907120: 17000 units out along the blade, the far end of the sword trail ribbon
+static Vec3f sSwordTipOffset = { 0.0f, 0.0f, 17000.0f };  // was D_80907120 [LLM:HIGH]
 
 static Vec3f D_8090712C = { 0.0f, 0.0f, 3000.0f };
 
