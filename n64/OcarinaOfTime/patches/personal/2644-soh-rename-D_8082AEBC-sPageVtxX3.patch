From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:40 +0000
Subject: [PATCH 2644/3799] soh: rename D_8082AEBC -> sPageVtxX3

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the X offsets in slot 3 of the sPageVtxX table
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 3ba54d177..7449f182a 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2612,7 +2612,8 @@ static s16 sPageVtxX2[] = {  // was D_8082AE98 [LLM:HIGH]
     0xFFDC, 0x000C, 0xFFEE, 0x0046, 0x0046, 0x0046, 0xFFA8, 0xFFA8, 0xFFA8,
     0xFFA8, 0xFFA8, 0xFFA8, 0xFFA8, 0xFFA8, 0xFF96, 0xFFC2, 0xFFD8, 0x0000,
 };
-static s16 D_8082AEBC[] = {
+// LLM generated name (HIGH), was D_8082AEBC: the X offsets in slot 3 of the sPageVtxX table
+static s16 sPageVtxX3[] = {  // was D_8082AEBC [LLM:HIGH]
     0x0000,
     0x0000,
 };
@@ -2688,7 +2689,7 @@ static s16 D_8082AFF4[] = {
 };
 
 static s16* D_8082B000[] = {
-    sPageVtxX0, sPageVtxX1, sPageVtxX2, D_8082AEBC, D_8082AEC0, D_8082AF00,  // was D_8082AE90 [LLM:HIGH]
+    sPageVtxX0, sPageVtxX1, sPageVtxX2, sPageVtxX3, D_8082AEC0, D_8082AF00,  // was D_8082AE90 [LLM:HIGH]
 };
 
 static s16* D_8082B018[] = {
