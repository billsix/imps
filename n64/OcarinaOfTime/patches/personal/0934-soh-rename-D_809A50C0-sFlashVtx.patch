From eadc3eaf64dd2733fa040cc06a6403667df0d94d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:09 +0000
Subject: [PATCH 0934/3799] soh: rename D_809A50C0 -> sFlashVtx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the Vtx[4] quad loaded by sFlashDList's gsSPVertex.
Defined in soh/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c     | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c b/soh/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c
index 28f2bbf85..6c067a9a6 100644
--- a/soh/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c
+++ b/soh/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c
@@ -201,7 +201,8 @@ void EffectSsFhgFlash_UpdateShock(PlayState* play, u32 index, EffectSs* this) {
     }
 }
 
-static Vtx D_809A50C0[4] = {
+// LLM generated name (HIGH), was D_809A50C0: the Vtx[4] quad loaded by sFlashDList's gsSPVertex.
+static Vtx sFlashVtx[4] = {  // was D_809A50C0 [LLM:HIGH]
     VTX(-10, -10, 0, 0, 1024, 0xFF, 0xFF, 0xFF, 0xFF),
     VTX(10, -10, 0, 1024, 1024, 0xFF, 0xFF, 0xFF, 0xFF),
     VTX(10, 10, 0, 1024, 0, 0xFF, 0xFF, 0xFF, 0xFF),
@@ -217,7 +218,7 @@ static Gfx sFlashDList[15] = {  // was D_809A5100 [LLM:HIGH]
     gsDPSetCombineLERP(PRIMITIVE, ENVIRONMENT, TEXEL0, ENVIRONMENT, TEXEL0, 0, PRIMITIVE, 0, 0, 0, 0, COMBINED, 0, 0, 0,
                        COMBINED),
     gsSPClearGeometryMode(G_CULL_BACK | G_FOG | G_LIGHTING | G_TEXTURE_GEN | G_TEXTURE_GEN_LINEAR),
-    gsSPVertex(D_809A50C0, 4, 0),
+    gsSPVertex(sFlashVtx, 4, 0),  // was D_809A50C0 [LLM:HIGH]
     gsSP2Triangles(0, 1, 2, 0, 0, 2, 3, 0),
     gsSPEndDisplayList(),
 };
