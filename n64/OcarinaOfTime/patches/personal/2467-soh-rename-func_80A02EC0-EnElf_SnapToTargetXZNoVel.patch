From 219a1ac09d37da4b3640f14a229357564a2a6dc7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:29:57 +0000
Subject: [PATCH 2467/3799] soh: rename func_80A02EC0 ->
 EnElf_SnapToTargetXZNoVel

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same snap with the horizontal velocity zeroed
Defined in soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c b/soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c
index bd3d56352..5b228a805 100644
--- a/soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c
+++ b/soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c
@@ -533,7 +533,8 @@ void EnElf_SnapToTargetXZ(EnElf* this, Vec3f* targetPos) {
     this->actor.world.pos.z = targetPos->z + this->unk_28C.z;
 }
 
-void func_80A02EC0(EnElf* this, Vec3f* targetPos) {
+// LLM generated name (HIGH), was func_80A02EC0: the same snap with the horizontal velocity zeroed
+void EnElf_SnapToTargetXZNoVel(EnElf* this, Vec3f* targetPos) {
     EnElf_StepVelocityY(this, targetPos, 0.2f);  // was func_80A02BD8 [LLM:HIGH]
     this->actor.velocity.x = this->actor.velocity.z = 0.0f;
     Actor_UpdatePos(&this->actor);
@@ -875,7 +876,7 @@ void func_80A03CF8(EnElf* this, PlayState* play) {
         prevPos = this->actor.world.pos;
 
         if (this->unk_2A8 == 0xA) {
-            func_80A02EC0(this, &nextPos);
+            EnElf_SnapToTargetXZNoVel(this, &nextPos);  // was func_80A02EC0 [LLM:HIGH]
         } else {
             EnElf_StepVelocityToTarget(this, &nextPos, 0.2f);  // was func_80A02C98 [LLM:HIGH]
         }
