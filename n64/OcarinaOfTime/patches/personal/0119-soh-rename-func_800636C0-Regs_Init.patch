 u8 CollisionCheck_GetSwordDamage(s32 dmgFlags, PlayState* play);
 void SaveContext_Init(void);
 s32 func_800635D0(s32);
-void func_800636C0(void);
+void Regs_Init(void);  // was func_800636C0 [oot]
 void DebugCamera_ScreenText(s32 arg0, s32 arg1, const char* text);  // was func_8006375C [oot]
 void func_8006376C(u8 x, u8 y, u8 colorId, const char* text);
 // ? func_80063828(?);
diff --git a/soh/src/code/main.c b/soh/src/code/main.c
index 4e68d5da1..78671148b 100644
--- a/soh/src/code/main.c
+++ b/soh/src/code/main.c
@@ -108,7 +108,7 @@ void Main(void* arg) {
 
     osSyncPrintf("debug_InitArena(%08x, %08x)\n", debugHeap, debugHeapSize);
     DebugArena_Init(debugHeap, debugHeapSize);
-    func_800636C0();
+    Regs_Init();
 
     R_ENABLE_ARENA_DBG = 0;
 
diff --git a/soh/src/code/z_debug.c b/soh/src/code/z_debug.c
index 30adda53d..16dea0107 100644
--- a/soh/src/code/z_debug.c
+++ b/soh/src/code/z_debug.c
@@ -59,7 +59,8 @@ InputCombo inputCombos[REG_GROUPS] = {
 char regChar[] = " SOPQMYDUIZCNKXcsiWAVHGmnBdkb";
 
 // initialize GameInfo
-void func_800636C0(void) {
+// Name from zeldaret/oot (was func_800636C0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.92. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_debug.c]
+void Regs_Init(void) {
     s32 i;
 
     gGameInfo = (GameInfo*)SYSTEM_ARENA_MALLOC_DEBUG(sizeof(GameInfo));
