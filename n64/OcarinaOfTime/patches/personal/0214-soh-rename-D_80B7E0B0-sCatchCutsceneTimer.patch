From 2a6425be909ef352e4c4d6a0c7c95b4d010ef55e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:02:05 +0000
Subject: [PATCH 214/225] soh: rename D_80B7E0B0 -> sCatchCutsceneTimer

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_Fishing/z_fishing.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 .../overlays/actors/ovl_Fishing/z_fishing.c   | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
index 76e4c71b4..7d75c34a2 100644
--- a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
+++ b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
@@ -378,7 +378,8 @@ static s16 sFishingMusicDelay;
 static Fishing* sFishingHookedFish;
 static s16 sFishingPlayingState;
 static s16 sLureTimer; // AND'd for various effects/checks
-static s16 D_80B7E0B0;
+// LLM generated name (HIGH), was D_80B7E0B0: countdown set to 5 on catch, decremented; gates catch cutscene camera
+static s16 sCatchCutsceneTimer;
 static s16 D_80B7E0B2;
 static s16 sRodCastTimer; // used for the inital line casting
 static u8 sLureEquipped;
@@ -1864,7 +1865,7 @@ void Fishing_DrawLureAndLine(PlayState* play, Vec3f* linePos, Vec3f* lineRot) {
         sLurePos = sReelLinePos[LINE_SEG_COUNT - 1];
         sLureRot.x = sReelLineRot[LINE_SEG_COUNT - 2].x + M_PI;
 
-        if ((player->actor.speedXZ == 0.0f) && (D_80B7E0B0 == 0)) {
+        if ((player->actor.speedXZ == 0.0f) && (sCatchCutsceneTimer == 0)) {
             Math_ApproachF(&sLureRot.y, sReelLineRot[LINE_SEG_COUNT - 2].y, 0.1f, 0.2f);
         } else {
             sLureRot.y = sReelLineRot[LINE_SEG_COUNT - 2].y;
@@ -2162,8 +2163,8 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
 
     sLureTimer++;
 
-    if (D_80B7E0B0 != 0) {
-        D_80B7E0B0--;
+    if (sCatchCutsceneTimer != 0) {
+        sCatchCutsceneTimer--;
     }
 
     if (D_80B7E0B2 != 0) {
@@ -2209,7 +2210,7 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
         D_80B7E148 = 520.0f;
         sRodLineSpooled = 195.0f;
 
-        sRodCastState = sLureEquipped = sLureTimer = D_80B7E0B0 = D_80B7E0B2 = sRodCastTimer = sWiggleAttraction =
+        sRodCastState = sLureEquipped = sLureTimer = sCatchCutsceneTimer = D_80B7E0B2 = sRodCastTimer = sWiggleAttraction =
             D_80B7E114 = D_80B7E150 = 0;
         sLure1Rotate = sReelLinePosStep = sLurePosZOffset = 0.0f;
 
@@ -2250,7 +2251,7 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
             }
 
             if (sRodCastTimer == 0) {
-                if ((D_80B7E0B0 == 0) && (player->unk_860 == 1)) {
+                if ((sCatchCutsceneTimer == 0) && (player->unk_860 == 1)) {
                     sRodCastTimer = 37;
                     Message_CloseTextbox(play);
                 }
@@ -2954,7 +2955,7 @@ void Fishing_UpdateFish(Actor* thisx, PlayState* play2) {
         playerSpeedMod = (player->actor.speedXZ * 0.3f) + 0.25f;
     }
 
-    if ((D_80B7E0B0 != 0) || (sSubCamId != 0) || ((player->actor.world.pos.z > 1150.0f) && (this->fishState != 100))) {
+    if ((sCatchCutsceneTimer != 0) || (sSubCamId != 0) || ((player->actor.world.pos.z > 1150.0f) && (this->fishState != 100))) {
         this->actor.flags &= ~ACTOR_FLAG_ATTENTION_ENABLED;
     } else {
         this->actor.flags |= ACTOR_FLAG_ATTENTION_ENABLED;
@@ -5474,7 +5475,7 @@ void Fishing_UpdateOwner(Actor* thisx, PlayState* play2) {
             Environment_EnableUnderwaterLights(play, 0);
             play->envCtx.adjFogNear = 0;
             player->unk_860 = -5;
-            D_80B7E0B0 = 5;
+            sCatchCutsceneTimer = 5;
             break;
         }
 
@@ -5625,7 +5626,7 @@ void Fishing_UpdateOwner(Actor* thisx, PlayState* play2) {
                         sFishingPlayerCinematicState = 0;
                         sSubCamId = 0;
                         player->unk_860 = -5;
-                        D_80B7E0B0 = 5;
+                        sCatchCutsceneTimer = 5;
                         sSinkingLureFound = false;
                         sFishingMusicDelay = 20;
                         Environment_EnableUnderwaterLights(play, 0);
