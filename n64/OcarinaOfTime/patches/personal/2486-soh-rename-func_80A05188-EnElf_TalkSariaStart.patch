     EnElf_UpdateAfterTalk(this, play);  // was func_80A04F94 [LLM:HIGH]
 }
 
-void func_80A05188(Actor* thisx, PlayState* play) {
+void EnElf_TalkSariaStart(Actor* thisx, PlayState* play) {
     EnElf* this = (EnElf*)thisx;
 
     EnElf_MoveToTalkPos(this, play);  // was func_80A04DE4 [LLM:HIGH]
@@ -1382,7 +1383,7 @@ void func_80A052F4(Actor* thisx, PlayState* play) {
 
             switch (play->msgCtx.choiceIndex) {
                 case 0: // yes
-                    this->actor.update = func_80A05188;
+                    this->actor.update = EnElf_TalkSariaStart;  // was func_80A05188 [LLM:HIGH]
                     Message_ContinueTextbox(play, 0xE2);
                     break;
                 case 1: // no
