From c2991c3f878fac170c7520c5dfe535d666204425 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:05:33 +0000
Subject: [PATCH 1944/3799] soh: rename D_80126038 -> sLegIkThighOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-age Vec3f translation applied before the shin joint's rotation; x is the thigh length in model units (1304 adult, 695 child)
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index 00411ea9d..4a5023002 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1150,7 +1150,8 @@ void Player_DrawImpl(PlayState* play, void** skeleton, Vec3s* jointTable, s32 dL
 
 Vec3f sZeroVec = { 0.0f, 0.0f, 0.0f };
 
-Vec3f D_80126038[] = {
+// LLM generated name (HIGH), was D_80126038: per-age Vec3f translation applied before the shin joint's rotation; x is the thigh length in model units (1304 adult, 695 child)
+Vec3f sLegIkThighOffsets[] = {  // was D_80126038 [LLM:HIGH]
     { 1304.0f, 0.0f, 0.0f },
     { 695.0f, 0.0f, 0.0f },
 };
@@ -1198,7 +1199,7 @@ void Player_AdjustLegToFloor(PlayState* play, Player* this, SkelAnime* skelAnime
         Matrix_Push();
         Matrix_TranslateRotateZYX(pos, rot);
         Matrix_MultVec3f(&sZeroVec, &spA4);
-        Matrix_TranslateRotateZYX(&D_80126038[gSaveContext.linkAge], &skelAnime->jointTable[shinLimbIndex]);
+        Matrix_TranslateRotateZYX(&sLegIkThighOffsets[gSaveContext.linkAge], &skelAnime->jointTable[shinLimbIndex]);  // was D_80126038 [LLM:HIGH]
         Matrix_Translate(D_80126050[gSaveContext.linkAge], 0.0f, 0.0f, MTXMODE_APPLY);
         Matrix_MultVec3f(&sZeroVec, &sp98);
         Matrix_MultVec3f(&D_80126070, &footprintPos);
