From 26ccd258319aed76a230dc77bbce0fdd1286e5ee Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:08:02 +0000
Subject: [PATCH 1286/3799] soh: rename func_808B3274 ->
 BgSpot12Gate_SetupOpened

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: snaps the gate to its fully-open height; Init uses it when the switch flag is already set.
Defined in soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c         | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c b/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
index 8a8dfba3f..86d12fc5a 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
@@ -26,7 +26,8 @@ void BgSpot12Gate_Delay(BgSpot12Gate* this, PlayState* play);  // was func_808B3
 void BgSpot12Gate_SetupOpen(BgSpot12Gate* this);  // was func_808B317C [LLM:HIGH]
 // LLM generated name (HIGH), was func_808B318C: accelerates the gate up to 200 units above home with the metal-gate sfx, finishing on the stop sfx and a camera shake.
 void BgSpot12Gate_Open(BgSpot12Gate* this, PlayState* play);  // was func_808B318C [LLM:HIGH]
-void func_808B3274(BgSpot12Gate* this);
+// LLM generated name (HIGH), was func_808B3274: snaps the gate to its fully-open height; Init uses it when the switch flag is already set.
+void BgSpot12Gate_SetupOpened(BgSpot12Gate* this);  // was func_808B3274 [LLM:HIGH]
 void func_808B3298(BgSpot12Gate* this, PlayState* play);
 
 const ActorInit Bg_Spot12_Gate_InitVars = {
@@ -70,7 +71,7 @@ void BgSpot12Gate_Init(Actor* thisx, PlayState* play) {
     Actor_ProcessInitChain(&this->dyna.actor, sInitChain);
 
     if (Flags_GetSwitch(play, this->dyna.actor.params & 0x3F)) {
-        func_808B3274(this);
+        BgSpot12Gate_SetupOpened(this);  // was func_808B3274 [LLM:HIGH]
     } else {
         BgSpot12Gate_SetupWaitForSwitch(this);  // was func_808B30C0 [LLM:HIGH]
     }
@@ -116,7 +117,7 @@ void BgSpot12Gate_Open(BgSpot12Gate* this, PlayState* play) {
     Math_StepToF(&this->dyna.actor.velocity.y, 1.6f, 0.03f);
     if (Math_StepToF(&this->dyna.actor.world.pos.y, this->dyna.actor.home.pos.y + 200.0f,
                      this->dyna.actor.velocity.y)) {
-        func_808B3274(this);
+        BgSpot12Gate_SetupOpened(this);  // was func_808B3274 [LLM:HIGH]
         var = Quake_Add(GET_ACTIVE_CAM(play), 3);
         Quake_SetSpeed(var, -0x3CB0);
         Quake_SetQuakeValues(var, 3, 0, 0, 0);
@@ -127,7 +128,7 @@ void BgSpot12Gate_Open(BgSpot12Gate* this, PlayState* play) {
     }
 }
 
-void func_808B3274(BgSpot12Gate* this) {
+void BgSpot12Gate_SetupOpened(BgSpot12Gate* this) {
     this->actionFunc = func_808B3298;
     this->dyna.actor.world.pos.y = this->dyna.actor.home.pos.y + 200.0f;
 }
