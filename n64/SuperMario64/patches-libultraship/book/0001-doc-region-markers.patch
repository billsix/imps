From 120efa079a6e455cb21ae94d24e327f111c75cdc Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Sun, 6 Sep 2026 16:48:54 +0000
Subject: [PATCH] docs: add doc-region markers for the Mario 64 book's
 literalinclude

Comment-only // doc-region-begin/end markers so the book can literalinclude
libultraship spans by name. Regions: combiner_input_to_glsl, set_combine_mode.
---
 src/fast/backends/gfx_opengl.cpp | 2 ++
 src/fast/interpreter.cpp         | 6 ++++++
 2 files changed, 8 insertions(+)

diff --git a/src/fast/backends/gfx_opengl.cpp b/src/fast/backends/gfx_opengl.cpp
index 6e0adc7c..aff68537 100644
--- a/src/fast/backends/gfx_opengl.cpp
+++ b/src/fast/backends/gfx_opengl.cpp
@@ -180,12 +180,14 @@ static const char* shader_item_to_str(uint32_t item, bool with_alpha, bool only_
                                       bool first_cycle, bool hint_single_element) {
     if (!only_alpha) {
         switch (item) {
+                // doc-region-begin combiner_input_to_glsl
             case SHADER_0:
                 return with_alpha ? "vec4(0.0, 0.0, 0.0, 0.0)" : "vec3(0.0, 0.0, 0.0)";
             case SHADER_1:
                 return with_alpha ? "vec4(1.0, 1.0, 1.0, 1.0)" : "vec3(1.0, 1.0, 1.0)";
             case SHADER_INPUT_1:
                 return with_alpha ? "uInputs[0]" : "uInputs[0].rgb";
+                // doc-region-end combiner_input_to_glsl
             case SHADER_INPUT_2:
                 return with_alpha ? "uInputs[1]" : "uInputs[1].rgb";
             case SHADER_INPUT_3:
diff --git a/src/fast/interpreter.cpp b/src/fast/interpreter.cpp
index 69e79615..90aa6f68 100644
--- a/src/fast/interpreter.cpp
+++ b/src/fast/interpreter.cpp
@@ -945,8 +945,10 @@ void Interpreter::ImportTextureRgba16(int tile, bool importReplacement) {
     uint32_t renderedPixels = tile_w * tile_h;
     bool pyramidLike =
         renderedPixels > 0 && loadedPixels > renderedPixels && loadedPixels * 8 < renderedPixels * 13; // < 1.625x
+    // doc-region-begin tile_wrap_modes
     bool clampS = (mRdp->texture_tile[tile].cms & G_TX_CLAMP) != 0;
     bool clampT = (mRdp->texture_tile[tile].cmt & G_TX_CLAMP) != 0;
+    // doc-region-end tile_wrap_modes
     // HD replacement textures must still clamp to the rendered tile region
     bool isHd = metadata->h_byte_scale != 1 || metadata->v_pixel_scale != 1;
     if ((isHd || pyramidLike || clampS) && tile_w > 0 && tile_w < width) {
@@ -2241,6 +2243,7 @@ void Interpreter::MatrixMul(float res[4][4], const float a[4][4], const float b[
     memcpy(res, tmp, sizeof(tmp));
 }
 
+// doc-region-begin light_dir_to_normal_space
 void Interpreter::CalculateNormalDir(const F3DLight_t* light, float coeffs[3]) {
     float light_dir[3] = { light->dir[0] / 127.0f, light->dir[1] / 127.0f, light->dir[2] / 127.0f };
 
@@ -2248,6 +2251,7 @@ void Interpreter::CalculateNormalDir(const F3DLight_t* light, float coeffs[3]) {
                                      mRsp->modelview_matrix_stack[mRsp->modelview_matrix_stack_size - 1]);
     Interpreter::NormalizeVector(coeffs);
 }
+// doc-region-end light_dir_to_normal_space
 
 void Interpreter::GfxSpMatrix(uint8_t parameters, const int32_t* addr) {
     float matrix[4][4];
@@ -3675,9 +3679,11 @@ static void GfxDpSetCombineMode(uint32_t rgb, uint32_t alpha) {
     mRdp->combine_mode = rgb | (alpha << 12);
 }*/
 
+// doc-region-begin set_combine_mode
 void Interpreter::GfxDpSetCombineMode(uint32_t rgb, uint32_t alpha, uint32_t rgb_cyc2, uint32_t alpha_cyc2) {
     mRdp->combine_mode = rgb | (alpha << 16) | ((uint64_t)rgb_cyc2 << 28) | ((uint64_t)alpha_cyc2 << 44);
 }
+// doc-region-end set_combine_mode
 
 static inline uint32_t color_comb(uint32_t a, uint32_t b, uint32_t c, uint32_t d) {
     return (a & 0xf) | ((b & 0xf) << 4) | ((c & 0x1f) << 8) | ((d & 7) << 13);

