From e652378156b6252d342045cd386994d0f980fa27 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:37 +0000
Subject: [PATCH 3072/3799] soh: rename D_80120D4C -> sCs2280KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 2280 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 16 ++++++++--------
 soh/src/code/z_onepointdemo_data.inc |  3 ++-
 2 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 11970d778..9cd701ac1 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -21,7 +21,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs5000KeyFrames)                                   \
     F(sCs2260KeyFrames)                                   \
     F(sCs2270KeyFrames)                                   \
-    F(D_80120D4C)                                   \
+    F(sCs2280KeyFrames)                                   \
     F(D_80120FA4)                                   \
     F(D_80121184)                                   \
     F(D_801211D4)                                   \
@@ -203,18 +203,18 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Quake_SetCountdown(i, 1600);
             break;
         case 2280:
-            csInfo->keyFrames = D_80120D4C;
+            csInfo->keyFrames = sCs2280KeyFrames;  // was D_80120D4C [LLM:HIGH]
             csInfo->keyFrameCnt = 7;
 
             for (i = 0; i < csInfo->keyFrameCnt - 3; i++) {
-                if (D_80120D4C[i].actionFlags != 0x8F) {
-                    D_80120D4C[i].atTargetInit.x = Rand_ZeroOne() * 20.0f;
-                    D_80120D4C[i].atTargetInit.z = (Rand_ZeroOne() * 40.0f) + 10.0f;
-                    D_80120D4C[i].eyeTargetInit.x = (Rand_ZeroOne() * 40.0f) + 60.0f;
-                    D_80120D4C[i].eyeTargetInit.z = (Rand_ZeroOne() * 40.0f) + 80.0f;
+                if (sCs2280KeyFrames[i].actionFlags != 0x8F) {  // was D_80120D4C [LLM:HIGH]
+                    sCs2280KeyFrames[i].atTargetInit.x = Rand_ZeroOne() * 20.0f;  // was D_80120D4C [LLM:HIGH]
+                    sCs2280KeyFrames[i].atTargetInit.z = (Rand_ZeroOne() * 40.0f) + 10.0f;  // was D_80120D4C [LLM:HIGH]
+                    sCs2280KeyFrames[i].eyeTargetInit.x = (Rand_ZeroOne() * 40.0f) + 60.0f;  // was D_80120D4C [LLM:HIGH]
+                    sCs2280KeyFrames[i].eyeTargetInit.z = (Rand_ZeroOne() * 40.0f) + 80.0f;  // was D_80120D4C [LLM:HIGH]
                 }
             }
-            D_80120D4C[camIdx - 1].eyeTargetInit.y =
+            sCs2280KeyFrames[camIdx - 1].eyeTargetInit.y =  // was D_80120D4C [LLM:HIGH]
                 ((mainCam->play->state.frames & 1) ? 3.0f : -3.0f) + Rand_ZeroOne();
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
 
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index a687d2abe..3f3658c46 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -192,7 +192,8 @@ static OnePointCsFull sCs2270KeyFrames[11] = {  // was D_80120B94 [LLM:HIGH]
     { 0x98, 0xFF, 0x0000, 1, 0, 50.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80120D4C[7] = {
+// LLM generated name (HIGH), was D_80120D4C: the keyframe set one-point cutscene 2280 installs
+static OnePointCsFull sCs2280KeyFrames[7] = {  // was D_80120D4C [LLM:HIGH]
     { 0x8F, 0x01, 0x2142, 1, 0, 40.0f, 1.0f, { 20.0f, 40.0f, 20.0f }, { -20.0f, 0.0f, -30.0f } },
     { 0x84, 0xFF, 0x0404, 19, 5, 70.0f, 0.01f, { 0.0f, 30.0f, 20.0f }, { 120.0f, 60.0f, 120.0f } },
     { 0x84, 0xFF, 0x0404, 20, 0, 60.0f, 0.01f, { 0.0f, 20.0f, 20.0f }, { 120.0f, 60.0f, 120.0f } },
