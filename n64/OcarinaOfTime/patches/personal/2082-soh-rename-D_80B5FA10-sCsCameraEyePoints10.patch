-    { sCsCameraAtPoints9, sCsCameraEyePoints9, 0 }, { sCsCameraAtPoints10, D_80B5FA10, 0 },  // was D_80B5F890 [LLM:HIGH]
+    { sCsCameraAtPoints9, sCsCameraEyePoints9, 0 }, { sCsCameraAtPoints10, sCsCameraEyePoints10, 0 },  // was D_80B5F890 [LLM:HIGH]
 };
