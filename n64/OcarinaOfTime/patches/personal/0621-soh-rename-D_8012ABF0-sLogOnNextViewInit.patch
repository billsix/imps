From 26b6dd7b5390bd21ccfe7ac08027c4d3923af7b1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:14 +0000
Subject: [PATCH 0621/3799] soh: rename D_8012ABF0 -> sLogOnNextViewInit

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/z_view.c.
---
 soh/src/code/z_view.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_view.c b/soh/src/code/z_view.c
index e40a21753..438d85ae4 100644
--- a/soh/src/code/z_view.c
+++ b/soh/src/code/z_view.c
@@ -7,7 +7,8 @@
 
 #include "soh/frame_interpolation.h"
 
-vu32 D_8012ABF0 = true;
+// Name from zeldaret/oot (was D_8012ABF0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_view.c]
+vu32 sLogOnNextViewInit = true;
 
 void View_ViewportToVp(Vp* dest, Viewport* src) {
     s32 width = src->rightX - src->leftX;
@@ -57,10 +58,10 @@ void View_Init(View* view, GraphicsContext* gfxCtx) {
     view->up.z = 0.0f;
     view->eye.z = -1.0f;
 
-    if (D_8012ABF0) {
-        if (D_8012ABF0 == 0) {}
+    if (sLogOnNextViewInit) {
+        if (sLogOnNextViewInit == 0) {}
         osSyncPrintf("\nview: initialize ---\n");
-        D_8012ABF0 = false;
+        sLogOnNextViewInit = false;
     }
 
     view->unk_124 = 0;
