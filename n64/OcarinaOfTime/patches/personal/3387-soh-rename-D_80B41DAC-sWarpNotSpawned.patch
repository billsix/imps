From 507260e72d2cef8596b3a390ade579d34672dcc1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:04 +0000
Subject: [PATCH 3387/3799] soh: rename D_80B41DAC -> sWarpNotSpawned

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: guards the frame 310 warp spawn so it happens only once
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 39165dcff..e41cf2f54 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -1493,13 +1493,14 @@ void EnXc_SpawnWarpAtFrame310(PlayState* play) {
     }
 }
 
-static s32 D_80B41DAC = 1;
+// LLM generated name (HIGH), was D_80B41DAC: guards the frame 310 warp spawn so it happens only once
+static s32 sWarpNotSpawned = 1;  // was D_80B41DAC [LLM:HIGH]
 
 #define EN_XC_SHIP_SAVESTATE_FIELDS(F) \
     F(sWindSfxStarted)                      \
     F(sFlameSpawned)                   \
     F(sPrevFlameCueAction)                      \
-    F(D_80B41DAC)
+    F(sWarpNotSpawned)  // was D_80B41DAC [LLM:HIGH]
 
 SHIP_SAVESTATE_DEFINE(EnXc, EN_XC_SHIP_SAVESTATE_FIELDS)
 
@@ -1510,7 +1511,7 @@ void EnXc_HandleCue0Actions(EnXc* this, PlayState* play) {
     if (npcAction != NULL) {
         s32 action = npcAction->action;
 
-        if (action != D_80B41DAC) {
+        if (action != sWarpNotSpawned) {  // was D_80B41DAC [LLM:HIGH]
             switch (action) {
                 case 2:
                     EnXc_PlaySkipSfx();  // was func_80B3F3D8 [LLM:HIGH]
@@ -1521,7 +1522,7 @@ void EnXc_HandleCue0Actions(EnXc* this, PlayState* play) {
                 default:
                     break;
             }
-            D_80B41DAC = action;
+            sWarpNotSpawned = action;  // was D_80B41DAC [LLM:HIGH]
         }
     }
 }
@@ -2570,5 +2571,5 @@ void EnXc_Reset(void) {
     sWindSfxStarted = 0;  // was D_80B41D90 [LLM:HIGH]
     sFlameSpawned = false;
     sPrevFlameCueAction = 1;  // was D_80B41DA8 [LLM:HIGH]
-    D_80B41DAC = 1;
+    sWarpNotSpawned = 1;  // was D_80B41DAC [LLM:HIGH]
 }
