Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c.
---
 .../overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c  | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c b/soh/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c
