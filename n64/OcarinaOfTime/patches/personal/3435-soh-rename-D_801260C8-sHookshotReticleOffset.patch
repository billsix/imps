From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:10 +0000
Subject: [PATCH 3435/3799] soh: rename D_801260C8 -> sHookshotReticleOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hand-space point Player_DrawHookshotReticle places the reticle from
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index 71a986cb2..05156bd26 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1717,7 +1717,7 @@ void Player_CalcMeleeWeaponTipPositions(Player* this, Vec3f* vecs) {
 }
 
 void Player_DrawHookshotReticle(PlayState* play, Player* this, f32 hookshotRange) {
-    static Vec3f D_801260C8 = { -500.0f, -100.0f, 0.0f };
+    static Vec3f sHookshotReticleOffset = { -500.0f, -100.0f, 0.0f };  // was D_801260C8 [LLM:HIGH]
     CollisionPoly* colPoly;
     s32 bgId;
     Vec3f hookshotStart;
@@ -1726,10 +1726,10 @@ void Player_DrawHookshotReticle(PlayState* play, Player* this, f32 hookshotRange
     Vec3f sp68;
     f32 sp64;
 
-    D_801260C8.z = 0.0f;
-    Matrix_MultVec3f(&D_801260C8, &hookshotStart);
-    D_801260C8.z = hookshotRange;
-    Matrix_MultVec3f(&D_801260C8, &hookshotEnd);
+    sHookshotReticleOffset.z = 0.0f;  // was D_801260C8 [LLM:HIGH]
+    Matrix_MultVec3f(&sHookshotReticleOffset, &hookshotStart);  // was D_801260C8 [LLM:HIGH]
+    sHookshotReticleOffset.z = hookshotRange;  // was D_801260C8 [LLM:HIGH]
+    Matrix_MultVec3f(&sHookshotReticleOffset, &hookshotEnd);  // was D_801260C8 [LLM:HIGH]
 
     if (BgCheck_AnyLineTest3(&play->colCtx, &hookshotStart, &hookshotEnd, &firstHit, &colPoly, 1, 1, 1, 1, &bgId)) {
         OPEN_DISPS(play->state.gfxCtx);
