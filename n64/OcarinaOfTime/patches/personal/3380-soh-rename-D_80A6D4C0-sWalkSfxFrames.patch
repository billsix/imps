From 42b3c1fccc85e338b746d0326846d8293029e10e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:03 +0000
Subject: [PATCH 3380/3799] soh: rename D_80A6D4C0 -> sWalkSfxFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the two animation frames EnHorseNormal_PlayWalkSfx fires a hoofbeat on
Defined in soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_En_Horse_Normal/z_en_horse_normal.c        | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c b/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c
index 70d0d5b74..a07bc3b29 100644
--- a/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c
+++ b/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c
@@ -157,14 +157,14 @@ static EnHorseNormalUnkStruct2 sUnusedPath2Header = { ARRAY_COUNT(sUnusedPath2),
 
 // LLM generated name (HIGH), was func_80A6B250: fires the walking hoofstep sfx as the animation passes each of its two step frames.
 void EnHorseNormal_PlayWalkSfx(EnHorseNormal* this) {
-    static s32 D_80A6D4C0[] = { 0, 16 };
+    static s32 sWalkSfxFrames[] = { 0, 16 };  // was D_80A6D4C0 [LLM:HIGH]
 
-    if (D_80A6D4C0[this->unk_200] < this->skin.skelAnime.curFrame &&
-        ((this->unk_200 != 0) || !(D_80A6D4C0[1] < this->skin.skelAnime.curFrame))) {
+    if (sWalkSfxFrames[this->unk_200] < this->skin.skelAnime.curFrame &&  // was D_80A6D4C0 [LLM:HIGH]
+        ((this->unk_200 != 0) || !(sWalkSfxFrames[1] < this->skin.skelAnime.curFrame))) {  // was D_80A6D4C0 [LLM:HIGH]
         Audio_PlaySfxGeneral(NA_SE_EV_HORSE_WALK, &this->actor.projectedPos, 4, &gSfxDefaultFreqAndVolScale,
                              &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
         this->unk_200++;
-        if (this->unk_200 >= ARRAY_COUNT(D_80A6D4C0)) {
+        if (this->unk_200 >= ARRAY_COUNT(sWalkSfxFrames)) {  // was D_80A6D4C0 [LLM:HIGH]
             this->unk_200 = 0;
         }
     }
