From f12b17555502cec4400026a64a806d5a29b08bd0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:35 +0000
Subject: [PATCH 3050/3799] soh: rename D_80120398 -> sCs9601EyePoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the eye points for 9601
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 4 ++--
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 5aaa39cdf..f94eec173 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -371,8 +371,8 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Play_CameraChangeSetting(play, CAM_ID_MAIN, mainCam->prevSetting);
             if (GameInteractor_Should(VB_CRAWL_SPEED_EXIT_CS, true, csCam, csId, D_80120430, D_8012042C, sCs9601AtPoints,  // was D_80120308 [LLM:HIGH]
-                                      D_80120398)) {
-                OnePointCutscene_SetCsCamPoints(csCam, D_80120430 | 0x1000, D_8012042C, sCs9601AtPoints, D_80120398);  // was D_80120308 [LLM:HIGH]
+                                      sCs9601EyePoints)) {  // was D_80120398 [LLM:HIGH]
+                OnePointCutscene_SetCsCamPoints(csCam, D_80120430 | 0x1000, D_8012042C, sCs9601AtPoints, sCs9601EyePoints);  // was D_80120308 [LLM:HIGH]
             }
             break;
         case 9602:
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 6c1057ce3..5eb51878b 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -42,7 +42,8 @@ static CutsceneCameraPoint sCs9601AtPoints[9] = {  // was D_80120308 [LLM:HIGH]
     { CS_CMD_CONTINUE, 0, 40, 60.0f, { 0, 34, 0 } }, { CS_CMD_STOP, 0, 40, 60.0f, { 0, 34, 0 } },
     { CS_CMD_STOP, 0, 10, 60.0f, { 0, 34, 0 } },
 };
-static CutsceneCameraPoint D_80120398[9] = {
+// LLM generated name (HIGH), was D_80120398: the eye points for 9601
+static CutsceneCameraPoint sCs9601EyePoints[9] = {  // was D_80120398 [LLM:HIGH]
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 9, 45 } },   { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 8, 50 } },
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 17, 58 } },  { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 21, 78 } },
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 46, 109 } }, { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 58, 118 } },
-- 
