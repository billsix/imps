From bdae4d55da179b4761887ded8d7ed423b77acd90 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:51:19 +0000
Subject: [PATCH 1125/3799] soh: rename D_80865B94 -> sStowedWeaponBase

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the matching base point for the stowed hook's weapon quad.
Defined in soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c b/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
index 6977bb28f..3a589dacc 100644
--- a/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
+++ b/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
@@ -60,7 +60,8 @@ static Vec3f sStowedHookOffset = { 0.0f, 0.0f, 0.0f };  // was D_80865B70 [LLM:H
 static Vec3f sShotHookOffset = { 0.0f, 0.0f, 900.0f };  // was D_80865B7C [LLM:HIGH]
 // LLM generated name (HIGH), was D_80865B88: the tip point handed to Player_UpdateWeaponInfo while the hook is stowed.
 static Vec3f sStowedWeaponTip = { 0.0f, 500.0f, -3000.0f };  // was D_80865B88 [LLM:HIGH]
-static Vec3f D_80865B94 = { 0.0f, -500.0f, -3000.0f };
+// LLM generated name (HIGH), was D_80865B94: the matching base point for the stowed hook's weapon quad.
+static Vec3f sStowedWeaponBase = { 0.0f, -500.0f, -3000.0f };  // was D_80865B94 [LLM:HIGH]
 static Vec3f D_80865BA0 = { 0.0f, 500.0f, 1200.0f };
 static Vec3f D_80865BAC = { 0.0f, -500.0f, 1200.0f };
 
@@ -321,7 +322,7 @@ void ArmsHook_Draw(Actor* thisx, PlayState* play) {
         if ((ArmsHook_Shoot != this->actionFunc) || (this->timer <= 0)) {
             Matrix_MultVec3f(&sStowedHookOffset, &this->unk_1E8);  // was D_80865B70 [LLM:HIGH]
             Matrix_MultVec3f(&sStowedWeaponTip, &sp6C);  // was D_80865B88 [LLM:HIGH]
-            Matrix_MultVec3f(&D_80865B94, &sp60);
+            Matrix_MultVec3f(&sStowedWeaponBase, &sp60);  // was D_80865B94 [LLM:HIGH]
             this->hookInfo.active = 0;
         } else {
             Matrix_MultVec3f(&sShotHookOffset, &this->unk_1E8);  // was D_80865B7C [LLM:HIGH]
-- 
