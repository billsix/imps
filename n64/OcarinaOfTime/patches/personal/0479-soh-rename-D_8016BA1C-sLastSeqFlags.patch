From 4ea24d8575a03e9b48b80f69b8c606077924aaec Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:41 +0000
Subject: [PATCH 479/490] soh: rename D_8016BA1C -> sLastSeqFlags

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: an s32 Audio_GetSeqFlags keeps across calls; named LastSeqFlags because the sSeqFlags table it reads is already taken
Defined in soh/src/code/audio_general.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/code/audio_general.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 19b6f6771..bb4a5785e 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -1309,7 +1309,8 @@ static u32 sOcarinaInputButtonCur;
 static u32 sOcarinaInputButtonStart;
 static u32 sOcarinaInputButtonPrev;
 static s32 sOcarinaInputButtonPress;
-static s32 D_8016BA1C;
+// LLM generated name (GUESS), was D_8016BA1C: an s32 Audio_GetSeqFlags keeps across calls; named LastSeqFlags because the sSeqFlags table it reads is already taken
+static s32 sLastSeqFlags;  // was D_8016BA1C [LLM:GUESS]
 static u8 sCurOcarinaSongWithoutMusicStaff[8];
 static u8 sOcarinaWithoutMusicStaffPos;
 static u8 sOcarinaHasStartedSong;
@@ -1426,7 +1427,7 @@ s32 sAudioUpdateTaskEnd;      // decomp: debug only
     F(sOcarinaInputButtonStart)                        \
     F(sOcarinaInputButtonPrev)                         \
     F(sOcarinaInputButtonPress)                        \
-    F(D_8016BA1C)                                      \
+    F(sLastSeqFlags)                                      \
     F(sCurOcarinaSongWithoutMusicStaff)                \
     F(sOcarinaWithoutMusicStaffPos)                    \
     F(sOcarinaHasStartedSong)                          \
