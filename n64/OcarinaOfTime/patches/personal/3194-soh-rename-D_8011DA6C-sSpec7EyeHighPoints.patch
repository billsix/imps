From d0358d3c701647c1c4d24eb2288636335687b1bc Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:04 +0000
Subject: [PATCH 3194/3799] soh: rename D_8011DA6C -> sSpec7EyeHighPoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the fixed eye positions the spec 7 camera uses above its height threshold
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c        | 4 ++--
 soh/src/code/z_camera_data.inc | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index a100cb6df..c285f7f92 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -6664,7 +6664,7 @@ s32 Camera_Special5(Camera* camera) {
 }
 
 /**
- * Camera's eye is fixed at points specified at D_8011DA6C / D_8011DA9C
+ * Camera's eye is fixed at points specified at sSpec7EyeHighPoints / D_8011DA9C  // was D_8011DA6C [LLM:HIGH]
  * depending on the player's position
  */
 s32 Camera_Special7(Camera* camera) {
@@ -6694,7 +6694,7 @@ s32 Camera_Special7(Camera* camera) {
         atTarget = playerPosRot->pos;
         atTarget.y -= 20.0f;
         Camera_LERPCeilVec3f(&atTarget, &camera->at, 0.4f, 0.4f, 0.10f);
-        camera->eye = camera->eyeNext = D_8011DA6C[spec7->idx];
+        camera->eye = camera->eyeNext = sSpec7EyeHighPoints[spec7->idx];  // was D_8011DA6C [LLM:HIGH]
         temp_f0 = (playerPosRot->pos.y - D_8011DADC[spec7->idx]) / (D_8011DACC[spec7->idx] - D_8011DADC[spec7->idx]);
         camera->roll = D_8011DAEC[spec7->idx] * temp_f0;
         camera->fov = (20.0f * temp_f0) + 60.0f;
diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index eb1ffd1e3..3fe5b9222 100644
--- a/soh/src/code/z_camera_data.inc
+++ b/soh/src/code/z_camera_data.inc
@@ -2394,7 +2394,8 @@ static OnePointCsFull sAttentionFarKeyFrames[] = {  // was D_8011D9F4 [LLM:HIGH]
     { 0x12, 0xFF, 0x0000, 0x0001, 0x0000, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-Vec3f D_8011DA6C[] = {
+// LLM generated name (HIGH), was D_8011DA6C: the fixed eye positions the spec 7 camera uses above its height threshold
+Vec3f sSpec7EyeHighPoints[] = {  // was D_8011DA6C [LLM:HIGH]
     { 3050.0f, 700.0f, 0.0f }, { 1755.0f, 3415.0f, -380.0f }, { -3120.0f, 3160.0f, 245.0f }, { 0.0f, -10.0f, 240.0f }
 };
 
-- 
