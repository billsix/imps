+++ b/soh/include/variables.h
@@ -67,7 +67,7 @@ extern "C"
 	extern u32 __osTimerCounter;
 	extern DmaEntry gDmaDataTable[0x60C];
 	extern u64 gUnusedUCodeData[];  // was D_801120C0 [LLM:GUESS]
-	extern u8 D_80113070[];
+	extern u8 gS2DExUCodeText[];  // was D_80113070 [LLM:HIGH]
 	extern u64 gJpegUCode[];
 	extern EffectSsOverlay gEffectSsOverlayTable[EFFECT_SS_TYPE_MAX];
 	extern Gfx sXluRenderModeDList[];  // was D_80116280 [LLM:HIGH]
@@ -182,7 +182,7 @@ extern "C"
 #define gTatumsPerBeat (gAudioTatumInit[1])  // was D_8014A6C0 [LLM:GUESS]
 	extern const AudioContextInitSizes gAudioHeapInitSizes;  // was D_8014A6C4 [LLM:HIGH]
 	extern s16 gOcarinaSongItemMap[];
-	extern u8 D_80155F50[];
+	extern u8 gF3DZExUCodeText[];  // was D_80155F50 [LLM:HIGH]
 	extern u8 D_80157580[];
 	extern u8 D_801579A0[];
 	extern u64 gJpegUCodeData[];
diff --git a/soh/src/code/graph.c b/soh/src/code/graph.c
index d1303eed9..52c1baa4b 100644
--- a/soh/src/code/graph.c
+++ b/soh/src/code/graph.c
@@ -33,16 +33,16 @@ void PadMgr_ThreadEntry(PadMgr* padMgr);
 // clang-format off
 // LLM generated name (HIGH), was D_8012D230: UCodeInfo table registered with the disassembler by Graph_DisassembleUCode.
 UCodeInfo sUCodeInfoDisas[3] = {  // was D_8012D230 [LLM:HIGH]
-    //{ UCODE_F3DZEX, D_80155F50 },
+    //{ UCODE_F3DZEX, gF3DZExUCodeText },, was D_80155F50 [LLM:HIGH]
     { UCODE_UNK, NULL },
-    //{ UCODE_S2DEX, D_80113070 },
+    //{ UCODE_S2DEX, gS2DExUCodeText },, was D_80113070 [LLM:HIGH]
 };
 
 // LLM generated name (HIGH), was D_8012D248: UCodeInfo table registered with the disassembler by Graph_UCodeFaultClient.
 UCodeInfo sUCodeInfoFault[3] = {  // was D_8012D248 [LLM:HIGH]
-    //{ UCODE_F3DZEX, D_80155F50 },
+    //{ UCODE_F3DZEX, gF3DZExUCodeText },, was D_80155F50 [LLM:HIGH]
     { UCODE_UNK, NULL },
-    //{ UCODE_S2DEX, D_80113070 },
+    //{ UCODE_S2DEX, gS2DExUCodeText },, was D_80113070 [LLM:HIGH]
 };
 // clang-format on
 
@@ -63,7 +63,7 @@ void Graph_DisassembleUCode(Gfx* workBuf) {
         UCodeDisas_Init(&disassembler);
         disassembler.enableLog = HREG(83);
         UCodeDisas_RegisterUCode(&disassembler, ARRAY_COUNT(sUCodeInfoDisas), sUCodeInfoDisas);  // was D_8012D230 [LLM:HIGH]
-        //UCodeDisas_SetCurUCode(&disassembler, D_80155F50);
+        //UCodeDisas_SetCurUCode(&disassembler, gF3DZExUCodeText);, was D_80155F50 [LLM:HIGH]
         UCodeDisas_Disassemble(&disassembler, workBuf);
         HREG(93) = disassembler.dlCnt;
         HREG(84) = disassembler.tri2Cnt * 2 + disassembler.tri1Cnt + (disassembler.quadCnt * 2) + disassembler.lineCnt;
@@ -99,7 +99,7 @@ void Graph_UCodeFaultClient(Gfx* workBuf) {
     UCodeDisas_Init(&disassembler);
     disassembler.enableLog = true;
     UCodeDisas_RegisterUCode(&disassembler, ARRAY_COUNT(sUCodeInfoFault), sUCodeInfoFault);  // was D_8012D248 [LLM:HIGH]
-    //UCodeDisas_SetCurUCode(&disassembler, D_80155F50);
+    //UCodeDisas_SetCurUCode(&disassembler, gF3DZExUCodeText);, was D_80155F50 [LLM:HIGH]
     UCodeDisas_Disassemble(&disassembler, workBuf);
     UCodeDisas_Destroy(&disassembler);
 #endif
