--- a/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.h
+++ b/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.h
@@ -24,6 +24,6 @@ typedef struct EnGm {
     /* 0x02C4 */ Vec3f talkPos;
 } EnGm; // size = 0x02D0
 
-void func_80A3DC44(EnGm* actor, PlayState* play);
+void EnGm_Idle(EnGm* actor, PlayState* play);  // was func_80A3DC44 [LLM:HIGH]
 
 #endif
