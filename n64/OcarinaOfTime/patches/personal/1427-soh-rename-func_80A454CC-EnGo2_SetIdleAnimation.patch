+++ b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
@@ -1137,7 +1137,8 @@ void EnGo2_RollForward(EnGo2* this) {
     this->actor.speedXZ = speedXZ;
 }
 
-void func_80A454CC(EnGo2* this) {
+// LLM generated name (HIGH), was func_80A454CC: picks the per-variant idle animation to settle into once the Goron has finished uncurling, including Biggoron's trade-dependent poses.
+void EnGo2_SetIdleAnimation(EnGo2* this) {
     switch (this->actor.params & 0x1F) {
         case GORON_CITY_ROLLING_BIG:
         case GORON_DMT_DC_ENTRANCE:
@@ -1703,7 +1704,7 @@ void func_80A46B40(EnGo2* this, PlayState* play) {
             if ((this->actor.params & 0x1F) == GORON_DMT_BIGGORON) {
                 this->actor.flags |= ACTOR_FLAG_ATTENTION_ENABLED;
             }
-            func_80A454CC(this);
+            EnGo2_SetIdleAnimation(this);  // was func_80A454CC [LLM:HIGH]
             this->unk_211 = true;
             this->collider.dim.height = sColliderDims[index].height;  // was D_80A4816C [LLM:HIGH]
         } else {
