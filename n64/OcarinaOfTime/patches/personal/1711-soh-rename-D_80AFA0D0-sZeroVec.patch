From 49dc56d65a754e736fe042191f4190f96d804d86 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:38:48 +0000
Subject: [PATCH 1711/3799] soh: rename D_80AFA0D0 -> sZeroVec

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: a zero Vec3f transformed by the current matrix to get the shadow's origin.
Defined in soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
index 000e915b5..b104faaa4 100644
--- a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
+++ b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
@@ -30,7 +30,8 @@ const ActorInit En_Sda_InitVars = {
     NULL,
 };
 
-static Vec3f D_80AFA0D0 = { 0.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80AFA0D0: a zero Vec3f transformed by the current matrix to get the shadow's origin.
+static Vec3f sZeroVec = { 0.0f, 0.0f, 0.0f };  // was D_80AFA0D0 [LLM:HIGH]
 
 // LLM generated name (HIGH), was D_80AFA0DC: the per-row half-widths of the smallest brush, used for size class 3.
 static s16 sBlobRowsClass3[] = {  // was D_80AFA0DC [LLM:HIGH]
@@ -295,7 +296,7 @@ void func_80AF95C4(EnSda* this, u8* shadowTexture, Player* player, PlayState* pl
         sp178.y += (KREG(87) << 0xF) + 0x8000;
         sp178.x *= (KREG(88) - 1);
         Matrix_Mult(&player->shieldMf, MTXMODE_NEW);
-        Matrix_MultVec3f(&D_80AFA0D0, &sp16C);
+        Matrix_MultVec3f(&sZeroVec, &sp16C);  // was D_80AFA0D0 [LLM:HIGH]
         Matrix_RotateY((sp178.y / 32768.0f) * M_PI, MTXMODE_NEW);
         Matrix_RotateX((sp178.x / 32768.0f) * M_PI, MTXMODE_APPLY);
         for (i = 0; i < 22; i++) {
-- 
