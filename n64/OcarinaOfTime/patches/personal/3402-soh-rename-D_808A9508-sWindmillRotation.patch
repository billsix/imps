From 709de33ddde61d6f2ed64a18e6bbef2740b169f4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:06 +0000
Subject: [PATCH 3402/3799] soh: rename D_808A9508 -> sWindmillRotation

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the accumulated rotation BgRelayObjects_RotateWindmill advances
Defined in soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_Bg_Relay_Objects/z_bg_relay_objects.c | 21 ++++++++++---------
 1 file changed, 11 insertions(+), 10 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c b/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c
index 2bd31faf7..98795d49d 100644
--- a/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c
+++ b/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c
@@ -52,9 +52,10 @@ static InitChainEntry sInitChain[] = {
     ICHAIN_VEC3F_DIV1000(scale, 100, ICHAIN_STOP),
 };
 
-static u32 D_808A9508 = 0;
+// LLM generated name (HIGH), was D_808A9508: the accumulated rotation BgRelayObjects_RotateWindmill advances
+static u32 sWindmillRotation = 0;  // was D_808A9508 [LLM:HIGH]
 
-#define BG_RELAY_OBJECTS_SHIP_SAVESTATE_FIELDS(F) F(D_808A9508)
+#define BG_RELAY_OBJECTS_SHIP_SAVESTATE_FIELDS(F) F(sWindmillRotation)  // was D_808A9508 [LLM:HIGH]
 
 SHIP_SAVESTATE_DEFINE(BgRelayObjects, BG_RELAY_OBJECTS_SHIP_SAVESTATE_FIELDS)
 
@@ -77,11 +78,11 @@ void BgRelayObjects_Init(Actor* thisx, PlayState* play) {
         Audio_PlayWindmillBgm();
         thisx->room = -1;
         thisx->flags |= ACTOR_FLAG_DRAW_CULLING_DISABLED;
-        if (D_808A9508 & 2) {
+        if (sWindmillRotation & 2) {  // was D_808A9508 [LLM:HIGH]
             thisx->params = 0xFF;
             Actor_Kill(thisx);
         } else {
-            D_808A9508 |= 2;
+            sWindmillRotation |= 2;  // was D_808A9508 [LLM:HIGH]
             this->actionFunc = BgRelayObjects_RotateWindmill;  // was func_808A939C [LLM:HIGH]
         }
     } else {
@@ -94,25 +95,25 @@ void BgRelayObjects_Init(Actor* thisx, PlayState* play) {
         thisx->room = -1;
         this->timer = 1;
         if (this->unk_169 >= 6) {
-            if (D_808A9508 & 1) {
+            if (sWindmillRotation & 1) {  // was D_808A9508 [LLM:HIGH]
                 Actor_Kill(thisx);
             } else {
-                D_808A9508 |= 1;
+                sWindmillRotation |= 1;  // was D_808A9508 [LLM:HIGH]
                 this->actionFunc = BgRelayObjects_DoNothing;
             }
         } else if (this->unk_169 != 5) {
             Flags_UnsetSwitch(play, this->switchFlag);
-            if (D_808A9508 & (1 << this->unk_169)) {
+            if (sWindmillRotation & (1 << this->unk_169)) {  // was D_808A9508 [LLM:HIGH]
                 Actor_Kill(thisx);
             } else {
-                D_808A9508 |= (1 << this->unk_169);
+                sWindmillRotation |= (1 << this->unk_169);  // was D_808A9508 [LLM:HIGH]
                 this->actionFunc = BgRelayObjects_OpenDoor;  // was func_808A90F4 [LLM:HIGH]
             }
         } else {
             Flags_SetSwitch(play, this->switchFlag);
             this->actionFunc = BgRelayObjects_WaitToClose;  // was func_808A91AC [LLM:HIGH]
             thisx->world.pos.y += 120.0f;
-            D_808A9508 |= 1;
+            sWindmillRotation |= 1;  // was D_808A9508 [LLM:HIGH]
         }
     }
     this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, thisx, colHeader);
@@ -223,5 +224,5 @@ void BgRelayObjects_Draw(Actor* thisx, PlayState* play) {
 }
 
 void BgRelayObjects_Reset(void) {
-    D_808A9508 = 0;
+    sWindmillRotation = 0;  // was D_808A9508 [LLM:HIGH]
 }
