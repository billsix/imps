--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
@@ -25,7 +25,8 @@ void BgHidanRock_Pushable(BgHidanRock* this, PlayState* play);  // was func_8088
 void BgHidanRock_Delay(BgHidanRock* this, PlayState* play);  // was func_8088B5F4 [LLM:HIGH]
 // LLM generated name (HIGH), was func_8088B634: the type 1 block's idle: once the player stands on it, it arms the 20-frame shake and aims it away from the camera.
 void BgHidanRock_WaitForPlayer(BgHidanRock* this, PlayState* play);  // was func_8088B634 [LLM:HIGH]
-void func_8088B69C(BgHidanRock* this, PlayState* play);
+// LLM generated name (HIGH), was func_8088B69C: jitters the block in a small circle with rumble and the block-shake sfx, then recentres it and starts the rise.
+void BgHidanRock_Shake(BgHidanRock* this, PlayState* play);  // was func_8088B69C [LLM:HIGH]
 void func_8088B79C(BgHidanRock* this, PlayState* play);
 void func_8088B90C(BgHidanRock* this, PlayState* play);
 void func_8088B954(BgHidanRock* this, PlayState* play);
@@ -227,11 +228,11 @@ void BgHidanRock_WaitForPlayer(BgHidanRock* this, PlayState* play) {
     if (DynaPolyActor_IsPlayerOnTop(&this->dyna)) {
         this->timer = 20;
         this->dyna.actor.world.rot.y = Camera_GetCamDirYaw(GET_ACTIVE_CAM(play)) + 0x4000;
-        this->actionFunc = func_8088B69C;
+        this->actionFunc = BgHidanRock_Shake;  // was func_8088B69C [LLM:HIGH]
     }
 }
 
-void func_8088B69C(BgHidanRock* this, PlayState* play) {
+void BgHidanRock_Shake(BgHidanRock* this, PlayState* play) {
     if (this->timer != 0) {
         this->timer--;
     }
