From 38ec63457e4fa94fce68d9b9a9626540ae52ecdd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:06:41 +0000
Subject: [PATCH 1265/3799] soh: rename func_80063828 -> DebugCamera_DrawText

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment above it reads "Draw Text"; it walks exactly the buffer DebugCamera_CopyText fills and prints each entry in its colour at its position.
Defined in soh/src/code/z_debug.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_debug.c  | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index e3c4ea0fc..00bb1fea5 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -853,7 +853,7 @@ s32 func_800635D0(s32);
 void Regs_Init(void);  // was func_800636C0 [oot]
 void DebugCamera_ScreenText(s32 arg0, s32 arg1, const char* text);  // was func_8006375C [oot]
 void DebugCamera_CopyText(u8 x, u8 y, u8 colorId, const char* text);  // was func_8006376C [LLM:HIGH]
-// ? func_80063828(?);
+// ? DebugCamera_DrawText(?);, was func_80063828 [LLM:HIGH]
 void func_8006390C(Input* input);
 // ? func_80063C04(?);
 void func_80063D7C(GraphicsContext* gfxCtx);
diff --git a/soh/src/code/z_debug.c b/soh/src/code/z_debug.c
index bebeca927..2c20e9013 100644
--- a/soh/src/code/z_debug.c
+++ b/soh/src/code/z_debug.c
@@ -106,7 +106,8 @@ void DebugCamera_CopyText(u8 x, u8 y, u8 colorId, const char* text) {
 }
 
 // Draw Text
-void func_80063828(GfxPrint* printer) {
+// LLM generated name (HIGH), was func_80063828: the in-tree comment above it reads "Draw Text"; it walks exactly the buffer DebugCamera_CopyText fills and prints each entry in its colour at its position.
+void DebugCamera_DrawText(GfxPrint* printer) {
     s32 i;
     Color_RGBA8* color;
     PrintTextBuffer* buffer;
@@ -259,7 +260,7 @@ void func_80063D7C(GraphicsContext* gfxCtx) {
     GfxPrint_Open(&printer, tempRet);
 
     if ((OREG(0) == 1) || (OREG(0) == 8)) {
-        func_80063828(&printer);
+        DebugCamera_DrawText(&printer);  // was func_80063828 [LLM:HIGH]
     }
 
     if (gGameInfo->regPage != 0) {
