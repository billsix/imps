From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:37 +0000
Subject: [PATCH 370/784] soh: rename func_80A7598C -> EnIk_SetupDie

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.85.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index e6bb61d31..cef3bb334 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -656,7 +656,8 @@ void EnIk_ReactToAttack(EnIk* this, PlayState* play) {
     }
 }
 
-void func_80A7598C(EnIk* this) {
+// Name from zeldaret/oot (was func_80A7598C): adopted upstream's name for this address; body verified to match upstream at 0.85. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ik/z_en_ik.c]
+void EnIk_SetupDie(EnIk* this) {
     f32 frames = Animation_GetLastFrame(&gIronKnuckleDeathAnim);
 
     this->unk_2FE = 0;
@@ -758,7 +759,7 @@ void func_80A75C38(EnIk* this, PlayState* play) {
     }
 
     if (this->actor.colChkInfo.health == 0) {
-        func_80A7598C(this);
+        EnIk_SetupDie(this);
         Enemy_StartFinishingBlow(play, &this->actor);
         return;
     }
