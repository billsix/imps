From 1793ddd4fc1ac57c6172d26b501222908e338c48 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:05:34 +0000
Subject: [PATCH 1945/3799] soh: rename D_80126050 -> sLegIkShinLengths

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-age translation from the shin joint out to the foot (1265 adult, 826 child)
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index 4a5023002..82192d400 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1156,7 +1156,8 @@ Vec3f sLegIkThighOffsets[] = {  // was D_80126038 [LLM:HIGH]
     { 695.0f, 0.0f, 0.0f },
 };
 
-f32 D_80126050[] = { 1265.0f, 826.0f };
+// LLM generated name (HIGH), was D_80126050: per-age translation from the shin joint out to the foot (1265 adult, 826 child)
+f32 sLegIkShinLengths[] = { 1265.0f, 826.0f };  // was D_80126050 [LLM:HIGH]
 f32 D_80126058[] = { SQ(13.04f), SQ(6.95f) };
 f32 D_80126060[] = { 10.019104f, -19.925102f };
 f32 D_80126068[] = { 5.0f, 3.0f };
@@ -1200,7 +1201,7 @@ void Player_AdjustLegToFloor(PlayState* play, Player* this, SkelAnime* skelAnime
         Matrix_TranslateRotateZYX(pos, rot);
         Matrix_MultVec3f(&sZeroVec, &spA4);
         Matrix_TranslateRotateZYX(&sLegIkThighOffsets[gSaveContext.linkAge], &skelAnime->jointTable[shinLimbIndex]);  // was D_80126038 [LLM:HIGH]
-        Matrix_Translate(D_80126050[gSaveContext.linkAge], 0.0f, 0.0f, MTXMODE_APPLY);
+        Matrix_Translate(sLegIkShinLengths[gSaveContext.linkAge], 0.0f, 0.0f, MTXMODE_APPLY);  // was D_80126050 [LLM:HIGH]
         Matrix_MultVec3f(&sZeroVec, &sp98);
         Matrix_MultVec3f(&D_80126070, &footprintPos);
         Matrix_Pop();
