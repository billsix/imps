Subject: [PATCH 2295/3799] soh: rename func_80AE7358 -> EnRl_SetupFadedOut

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loops the idle animation and drops to action 4 with nothing drawn and no shadow
Defined in soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c b/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
index ffc2a7ca1..2c6c7c925 100644
--- a/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
+++ b/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
@@ -53,7 +53,8 @@ void EnRl_UpdateEyes(EnRl* this) {
     }
 }
 
-void func_80AE7358(EnRl* this) {
+// LLM generated name (HIGH), was func_80AE7358: loops the idle animation and drops to action 4 with nothing drawn and no shadow
+void EnRl_SetupFadedOut(EnRl* this) {
     Animation_Change(&this->skelAnime, &object_rl_Anim_000A3C, 1.0f, 0.0f,
                      Animation_GetLastFrame(&object_rl_Anim_000A3C), ANIMMODE_LOOP, 0.0f);
     this->action = 4;
@@ -69,7 +70,7 @@ void func_80AE73D8(EnRl* this, PlayState* play) {
     if (play->csCtx.state == CS_STATE_IDLE) {
         if (D_80AE81AC) {
             if (this->actor.params == 2) {
-                func_80AE7358(this);
+                EnRl_SetupFadedOut(this);  // was func_80AE7358 [LLM:HIGH]
             }
             D_80AE81AC = 0;
         }
