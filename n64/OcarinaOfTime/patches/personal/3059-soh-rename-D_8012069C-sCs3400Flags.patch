From 89fc3a882445d22c9edcc0192485047d8609cd29 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:36 +0000
Subject: [PATCH 3059/3799] soh: rename D_8012069C -> sCs3400Flags

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the flags argument for 3400, ORed with 0x2000 at the call
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 705e72c9b..65026f84a 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -691,7 +691,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
         case 3400:
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Player_SetCsAction(play, &player->actor, 8);
-            OnePointCutscene_SetCsCamPoints(csCam, D_8012069C | 0x2000, sCs3400Duration, sCs3400AtPoints, sCs3400EyePoints);  // was D_801204D4 [LLM:HIGH]
+            OnePointCutscene_SetCsCamPoints(csCam, sCs3400Flags | 0x2000, sCs3400Duration, sCs3400AtPoints, sCs3400EyePoints);  // was D_801204D4 [LLM:HIGH]
             OnePointCutscene_Vec3sToVec3f(&mainCam->eye, &sCs3400EyePoints[sCs3400PointCount - 2].pos);  // was D_801205B4 [LLM:HIGH]
             OnePointCutscene_Vec3sToVec3f(&mainCam->at, &sCs3400AtPoints[sCs3400PointCount - 2].pos);  // was D_801204D4 [LLM:HIGH]
 
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 21e0861a8..8bacaf5de 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -103,7 +103,8 @@ static CutsceneCameraPoint sCs3400EyePoints[14] = {  // was D_801205B4 [LLM:HIGH
 static s16 sCs3400PointCount = 14;  // was D_80120694 [LLM:HIGH]
 // LLM generated name (HIGH), was D_80120698: the duration argument for 3400
 static s16 sCs3400Duration = 190;  // was D_80120698 [LLM:HIGH]
-static s16 D_8012069C = 8;
+// LLM generated name (HIGH), was D_8012069C: the flags argument for 3400, ORed with 0x2000 at the call
+static s16 sCs3400Flags = 8;  // was D_8012069C [LLM:HIGH]
 
 static CutsceneCameraPoint D_801206A0[12] = {
     { CS_CMD_CONTINUE, 6, 20, 80.0f, { -96, 40, 170 } }, { CS_CMD_CONTINUE, 6, 20, 80.0f, { -96, 40, 170 } },
-- 
2.55.0

