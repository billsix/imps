 void EnBw_SetupWalk(EnBw* this);  // was func_809CE9A8 [LLM:HIGH]
 // LLM generated name (HIGH), was func_809CEA24: the wandering action: it steers the slug over the floor on a wobbling path, tracks the player and picks the next behaviour when its timer expires.
 void EnBw_Walk(EnBw* this, PlayState* play);  // was func_809CEA24 [LLM:HIGH]
-void func_809CF72C(EnBw* this);
+// LLM generated name (HIGH), was func_809CF72C: plays the eyestalk-raise animation with the aiming sfx and installs the rearing action.
+void EnBw_SetupRearUp(EnBw* this);  // was func_809CF72C [LLM:HIGH]
