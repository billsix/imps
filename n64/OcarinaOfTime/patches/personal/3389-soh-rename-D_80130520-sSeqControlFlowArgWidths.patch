From dc5ec793acc5116be32ce0bcddce0413ae889dc1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:18:51 +0000
Subject: [PATCH 3389/3799] soh: rename D_80130520 -> sSeqControlFlowArgWidths

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-opcode packed argument widths AudioSeq_GetScriptControlFlowArgument decodes a control-flow command with
Defined in soh/src/code/audio_seqplayer.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_seqplayer.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_seqplayer.c b/soh/src/code/audio_seqplayer.c
index b99d29e1e..218b89350 100644
--- a/soh/src/code/audio_seqplayer.c
+++ b/soh/src/code/audio_seqplayer.c
@@ -22,7 +22,8 @@ u16 AudioSeq_ScriptReadCompressedU16(SeqScriptState* state);
 
 u8 AudioSeq_GetInstrument(SequenceChannel* channel, u8 instId, Instrument** instOut, AdsrSettings* adsr);
 
-u8 D_80130520[] = {
+// LLM generated name (HIGH), was D_80130520: per-opcode packed argument widths AudioSeq_GetScriptControlFlowArgument decodes a control-flow command with
+u8 sSeqControlFlowArgWidths[] = {  // was D_80130520 [LLM:HIGH]
     0x81, 0x00, 0x81, 0x01, 0x00, 0x00, 0x00, 0x81, 0x01, 0x01, 0x01, 0x42, 0x81, 0xC2, 0x00, 0x00,
     0x00, 0x01, 0x81, 0x00, 0x00, 0x00, 0x01, 0x42, 0x01, 0x01, 0x01, 0x81, 0x01, 0x01, 0x81, 0x81,
     0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x81, 0x01, 0x01, 0x01, 0x81, 0x01,
@@ -31,7 +32,7 @@ u8 D_80130520[] = {
 };
 
 u16 AudioSeq_GetScriptControlFlowArgument(SeqScriptState* state, u8 arg1) {
-    u8 temp_v0 = D_80130520[arg1 - 0xB0];
+    u8 temp_v0 = sSeqControlFlowArgWidths[arg1 - 0xB0];  // was D_80130520 [LLM:HIGH]
     u8 loBits = temp_v0 & 3;
     u16 ret = 0;
 
@@ -1011,7 +1012,7 @@ void AudioSeq_SequenceChannelProcessScript(SequenceChannel* channel) {
         s32 pad2;
 
         if (command >= 0xB0) {
-            highBits = D_80130520[(s32)command - 0xB0];
+            highBits = sSeqControlFlowArgWidths[(s32)command - 0xB0];  // was D_80130520 [LLM:HIGH]
             lowBits = highBits & 3;
 
             for (i = 0; i < lowBits; i++, highBits <<= 1) {
-- 
