From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:32:04 +0000
Subject: [PATCH 1638/3799] soh: rename func_8096F544 ->
 DemoEc_AdvanceAnimAfterUpdate20

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: starts gDemoEcAnim_009234 once the mode 20 animation has finished, staying in the same update mode.
Defined in soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c b/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c
index de7fecd7f..2447987d9 100644
--- a/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c
+++ b/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c
@@ -896,7 +896,8 @@ void DemoEc_SetupUpdate20(DemoEc* this, PlayState* play) {
     this->updateMode = EC_UPDATE_20;
 }
 
-void func_8096F544(DemoEc* this, s32 changeAnim) {
+// LLM generated name (HIGH), was func_8096F544: starts gDemoEcAnim_009234 once the mode 20 animation has finished, staying in the same update mode.
+void DemoEc_AdvanceAnimAfterUpdate20(DemoEc* this, s32 changeAnim) {
     if (changeAnim) {
         DemoEc_ChangeAnimation(this, &gDemoEcAnim_009234, 0, 0.0f, false);
     }
@@ -933,7 +934,7 @@ void func_8096F640(DemoEc* this, PlayState* play) {
     DemoEc_MoveActor(this, play);  // was func_8096D594 [LLM:HIGH]
     DemoEc_UpdateEyes(this);
     DemoEc_UpdateBgFlags(this, play);
-    func_8096F544(this, animDone);
+    DemoEc_AdvanceAnimAfterUpdate20(this, animDone);  // was func_8096F544 [LLM:HIGH]
 }
 
 void DemoEc_DrawMido(DemoEc* this, PlayState* play) {
