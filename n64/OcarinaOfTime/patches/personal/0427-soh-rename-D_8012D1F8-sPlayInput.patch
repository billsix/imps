From 0a0d2ff746df38931acc0fc17bde5167494cc4f8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:36 +0000
Subject: [PATCH 427/488] soh: rename D_8012D1F8 -> sPlayInput

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: a pointer to the first controller kept for code outside PlayState
Defined in soh/src/code/z_play.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/code/z_play.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_play.c b/soh/src/code/z_play.c
index 9eb82edd7..48a745da6 100644
--- a/soh/src/code/z_play.c
+++ b/soh/src/code/z_play.c
@@ -31,7 +31,8 @@ void* gDebugCutsceneScript = NULL;
 // LLM generated name (HIGH), was D_8012D1F4: the in-tree comment on its declaration reads "// unused".
 UNK_TYPE sUnusedPlayValue = 0; // unused, was D_8012D1F4 [LLM:HIGH]
 
-Input* D_8012D1F8 = NULL;
+// LLM generated name (HIGH), was D_8012D1F8: a pointer to the first controller kept for code outside PlayState
+Input* sPlayInput = NULL;  // was D_8012D1F8 [LLM:HIGH]
 
 PlayState* gPlayState;
 s16 firstInit = 0;
@@ -1660,7 +1661,7 @@ void Play_Main(GameState* thisx) {
         Actor_Spawn(&gPlayState->actorCtx, gPlayState, ACTOR_OBJECT_KANKYO, 0, 0, 0, 0, 0, 0, 3);
     }
 
-    D_8012D1F8 = &play->state.input[0];
+    sPlayInput = &play->state.input[0];  // was D_8012D1F8 [LLM:HIGH]
 
     DebugDisplay_Init();
 
