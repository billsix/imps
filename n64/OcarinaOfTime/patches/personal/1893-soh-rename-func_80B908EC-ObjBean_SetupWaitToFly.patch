From 7416f6aea55ebeb28b5f4061aa20fe8dc550e1ad Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:50:08 +0000
Subject: [PATCH 1893/3799] soh: rename func_80B908EC -> ObjBean_SetupWaitToFly

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: hides the plant and installs the action that waits for the player to step off.
Defined in soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
index 7a42f5b13..b630859e4 100644
--- a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
+++ b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
@@ -53,7 +53,8 @@ void ObjBean_Overshoot(ObjBean* this, PlayState* play);  // was func_80B8FF8C [L
 void ObjBean_Settle(ObjBean* this, PlayState* play);  // was func_80B90050 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80B90010: installs the settling action with its starting angle and decaying amplitude.
 void ObjBean_SetupSettle(ObjBean* this);  // was func_80B90010 [LLM:HIGH]
-void func_80B908EC(ObjBean* this);
+// LLM generated name (HIGH), was func_80B908EC: hides the plant and installs the action that waits for the player to step off.
+void ObjBean_SetupWaitToFly(ObjBean* this);  // was func_80B908EC [LLM:HIGH]
 void func_80B90918(ObjBean* this, PlayState* play);
 void func_80B90970(ObjBean* this);
 void func_80B909B0(ObjBean* this, PlayState* play);
@@ -833,7 +834,7 @@ void ObjBean_WaitForStepOff(ObjBean* this, PlayState* play) {
     ObjBean_UpdatePosition(this);
 }
 
-void func_80B908EC(ObjBean* this) {
+void ObjBean_SetupWaitToFly(ObjBean* this) {
     this->actionFunc = func_80B90918;
     ObjBean_SetDrawMode(this, 0);
 }
@@ -912,7 +913,7 @@ void ObjBean_Update(Actor* thisx, PlayState* play) {
             osSyncPrintf(VT_RST);
             ObjBean_Break(this, play);
             DynaPoly_DisableCollision(play, &play->colCtx.dyna, this->dyna.bgId);
-            func_80B908EC(this);
+            ObjBean_SetupWaitToFly(this);  // was func_80B908EC [LLM:HIGH]
         }
     } else {
         this->dyna.actor.shape.shadowDraw = NULL;
