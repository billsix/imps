From 7e724d664d0d46779d739a6fa5e8f741767f91bd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:39 +0000
Subject: [PATCH 2637/3799] soh: rename D_8082ABA4 -> sCursorEnvB

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: blue of that env colour
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_scope_PAL.c     | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index aa689045d..11b1d9b9c 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -934,7 +934,8 @@ static s16 sCursorPrimA = 255;  // was D_8082AB98 [LLM:HIGH]
 static s16 sCursorEnvR = 255;  // was D_8082AB9C [LLM:HIGH]
 // LLM generated name (HIGH), was D_8082ABA0: green of that env colour
 static s16 sCursorEnvG = 0;  // was D_8082ABA0 [LLM:HIGH]
-static s16 D_8082ABA4 = 0;
+// LLM generated name (HIGH), was D_8082ABA4: blue of that env colour
+static s16 sCursorEnvB = 0;  // was D_8082ABA4 [LLM:HIGH]
 
 static s16 sInDungeonScene = false;
 
@@ -3475,7 +3476,7 @@ void KaleidoScope_DrawGameOver(PlayState* play) {
                       COMBINED, ENVIRONMENT, COMBINED, 0, PRIMITIVE, 0);
 
     gDPSetPrimColor(POLY_OPA_DISP++, 0, 80, sCursorPrimR, sCursorPrimG, sCursorPrimB, sCursorPrimA);  // was D_8082AB8C [LLM:HIGH]
-    gDPSetEnvColor(POLY_OPA_DISP++, sCursorEnvR, sCursorEnvG, D_8082ABA4, 255);  // was D_8082AB9C [LLM:HIGH]
+    gDPSetEnvColor(POLY_OPA_DISP++, sCursorEnvR, sCursorEnvG, sCursorEnvB, 255);  // was D_8082AB9C [LLM:HIGH]
 
     VREG(89) -= 2;
 
@@ -4578,7 +4579,7 @@ void KaleidoScope_Update(PlayState* play) {
             sCursorPrimA = 0;  // was D_8082AB98 [LLM:HIGH]
             sCursorEnvR = 30;  // was D_8082AB9C [LLM:HIGH]
             sCursorEnvG = 0;  // was D_8082ABA0 [LLM:HIGH]
-            D_8082ABA4 = 0;
+            sCursorEnvB = 0;  // was D_8082ABA4 [LLM:HIGH]
             D_8082B260 = 30;
             VREG(88) = 98;
             pauseCtx->promptChoice = 0;
@@ -4613,7 +4614,7 @@ void KaleidoScope_Update(PlayState* play) {
 
             stepR = ABS(sCursorEnvR - 255) / D_8082B260;  // was D_8082AB9C [LLM:HIGH]
             stepG = ABS(sCursorEnvG - 130) / D_8082B260;  // was D_8082ABA0 [LLM:HIGH]
-            stepB = ABS(D_8082ABA4) / D_8082B260;
+            stepB = ABS(sCursorEnvB) / D_8082B260;  // was D_8082ABA4 [LLM:HIGH]
             if (sCursorEnvR >= 255) {  // was D_8082AB9C [LLM:HIGH]
                 sCursorEnvR -= stepR;  // was D_8082AB9C [LLM:HIGH]
             } else {
@@ -4624,10 +4625,10 @@ void KaleidoScope_Update(PlayState* play) {
             } else {
                 sCursorEnvG += stepG;  // was D_8082ABA0 [LLM:HIGH]
             }
-            if (D_8082ABA4 >= 0) {
-                D_8082ABA4 -= stepB;
+            if (sCursorEnvB >= 0) {  // was D_8082ABA4 [LLM:HIGH]
+                sCursorEnvB -= stepB;  // was D_8082ABA4 [LLM:HIGH]
             } else {
-                D_8082ABA4 += stepB;
+                sCursorEnvB += stepB;  // was D_8082ABA4 [LLM:HIGH]
             }
 
             D_8082B260--;
@@ -4639,7 +4640,7 @@ void KaleidoScope_Update(PlayState* play) {
 
                 sCursorEnvR = 255;  // was D_8082AB9C [LLM:HIGH]
                 sCursorEnvG = 130;  // was D_8082ABA0 [LLM:HIGH]
-                D_8082ABA4 = 0;
+                sCursorEnvB = 0;  // was D_8082ABA4 [LLM:HIGH]
 
                 pauseCtx->state++;
                 D_8082B260 = 40;
-- 
2.55.0

