From fe1e025e7915dafb2ab04255ecee4742b0152d96 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:49:08 +0000
Subject: [PATCH 1113/3799] soh: rename func_800DB680 ->
 AudioSynth_SaveRingBufferResampled

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the reverse direction: resamples each wet channel into scratch and writes it back into the left and right ring buffers, handling the wrap.
Defined in soh/src/code/audio_synthesis.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_synthesis.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_synthesis.c b/soh/src/code/audio_synthesis.c
index ba9d35226..f3314e33e 100644
--- a/soh/src/code/audio_synthesis.c
+++ b/soh/src/code/audio_synthesis.c
@@ -247,7 +247,8 @@ Acmd* AudioSynth_LoadRingBufferResampled(Acmd* cmd, s32 arg1, SynthesisReverb* r
     return cmd;
 }
 
-Acmd* func_800DB680(Acmd* cmd, SynthesisReverb* reverb, s16 bufIndex) {
+// LLM generated name (HIGH), was func_800DB680: the reverse direction: resamples each wet channel into scratch and writes it back into the left and right ring buffers, handling the wrap.
+Acmd* AudioSynth_SaveRingBufferResampled(Acmd* cmd, SynthesisReverb* reverb, s16 bufIndex) {
     ReverbRingBufferItem* bufItem = &reverb->items[reverb->curFrame][bufIndex];
 
     aSetBuffer(cmd++, 0, DMEM_WET_LEFT_CH, DMEM_WET_SCRATCH, bufItem->unk_18 * 2);
@@ -546,7 +547,7 @@ Acmd* AudioSynth_SaveReverbSamples(Acmd* cmd, SynthesisReverb* reverb, s16 bufIn
 
     if (reverb->downsampleRate == 1) {
         if (reverb->unk_18 != 0) {
-            cmd = func_800DB680(cmd, reverb, bufIndex);
+            cmd = AudioSynth_SaveRingBufferResampled(cmd, reverb, bufIndex);  // was func_800DB680 [LLM:HIGH]
         } else {
             // Put the oldest samples in the ring buffer into the wet channels
             cmd = AudioSynth_SaveRingBufferPart(cmd, DMEM_WET_LEFT_CH, bufItem->startPos, bufItem->lengthA, reverb);
-- 
