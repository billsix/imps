Subject: [PATCH 3031/3799] soh: rename func_80987018 ->
 DemoIm_SetupHiddenAction27

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loops the idle with nothing drawn at action 27
Defined in soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
index 559b41034..9f57c8345 100644
--- a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -1093,7 +1093,8 @@ void DemoIm_Action26(DemoIm* this, PlayState* play) {
     DemoIm_LeaveWhenPlayerNear(this, play);  // was func_80986CFC [LLM:HIGH]
 }
 
-void func_80987018(DemoIm* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80987018: loops the idle with nothing drawn at action 27
+void DemoIm_SetupHiddenAction27(DemoIm* this, PlayState* play) {
     DemoIm_ChangeAnim(this, &gImpaIdleAnim, ANIMMODE_LOOP, 0.0f, false);
     this->action = 27;
     this->drawConfig = 0;
@@ -1222,7 +1223,7 @@ void DemoIm_Init(Actor* thisx, PlayState* play) {
             DemoIm_SetupHiddenAction18(this, play);  // was func_809869B0 [LLM:HIGH]
             break;
         case 6:
-            func_80987018(this, play);
+            DemoIm_SetupHiddenAction27(this, play);  // was func_80987018 [LLM:HIGH]
             break;
         default:
             DemoIm_SetupUnderground(this, play);  // was func_80985310 [LLM:HIGH]
