From c9017cebdd0e38141bf67e2da1dd1abc8c765452 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:43 +0000
Subject: [PATCH 3135/3799] soh: rename D_80122C3C -> sCs4220KeyFramesA

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the set cutscene 4220 uses when the player is south of z -15
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index d4cae45d7..2d0f16dbe 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -919,7 +919,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Quake_SetCountdown(i, timer - 80);
             break;
         case 4220:
-            csInfo->keyFrames = (player->actor.world.pos.z < -15.0f) ? D_80122C3C : D_80122C64;
+            csInfo->keyFrames = (player->actor.world.pos.z < -15.0f) ? sCs4220KeyFramesA : D_80122C64;  // was D_80122C3C [LLM:HIGH]
             csInfo->keyFrameCnt = 1;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index ff0985f17..d9f23ca1a 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -572,7 +572,8 @@ static OnePointCsFull sCs4210KeyFrames[1] = {  // was D_80122C14 [LLM:HIGH]
     { 0x0F, 0xFF, 0x0101, 999, 0, 85.0f, 1.0f, { -15.0f, 185.0f, 160.0f }, { -15.0f, 210.0f, 250.0f } },
 };
 
-static OnePointCsFull D_80122C3C[1] = {
+// LLM generated name (HIGH), was D_80122C3C: the set cutscene 4220 uses when the player is south of z -15
+static OnePointCsFull sCs4220KeyFramesA[1] = {  // was D_80122C3C [LLM:HIGH]
     { 0x0F, 0xFF, 0x0101, 999, -2, 70.0f, 1.0f, { -62.0f, 60.0f, -315.0f }, { -115.0f, 30.0f, -445.0f } },
 };
 
