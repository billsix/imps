From 9218bc8ea3211cf1a29c5985e15ff346bbd7ee82 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:11:57 +0000
Subject: [PATCH 1347/3799] soh: rename D_80812830 -> sMainMenuButtonVtx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the windowContentVtx index whose Y anchors the highlight quad for each button of the main config menu; the warning banner is positioned from it too.
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/gamestates/ovl_file_choose/z_file_choose.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c
index bf949f956..b8dcf422a 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c
@@ -1162,7 +1162,8 @@ static s16 sIconXSteps[] = { 0x001A, 0x000A, 0x000A, 0x000A };  // was D_8081281
 static s16 sIconWidths[] = { 0x0020, 0x000C, 0x000C, 0x000C };  // was D_80812820 [LLM:HIGH]
 // LLM generated name (HIGH), was D_80812828: subtracted from each icon quad's top edge to give its bottom edge in the same loop.
 static s16 sIconHeights[] = { 0x0010, 0x000C, 0x000C, 0x000C };  // was D_80812828 [LLM:HIGH]
-static s16 D_80812830[] = { 0x0040, 0x0054, 0x0068, 0x0274, 0x0278, 0x027C };
+// LLM generated name (HIGH), was D_80812830: the windowContentVtx index whose Y anchors the highlight quad for each button of the main config menu; the warning banner is positioned from it too.
+static s16 sMainMenuButtonVtx[] = { 0x0040, 0x0054, 0x0068, 0x0274, 0x0278, 0x027C };  // was D_80812830 [LLM:HIGH]
 static s16 D_8081283C[] = { 0x0040, 0x0054, 0x0068, 0x0278 };
 static s16 D_80812844[] = { 0x0274, 0x0278 };
 static s16 D_80812848[] = { 0x0274, 0x0278 };
@@ -1418,7 +1419,7 @@ void FileChoose_SetWindowContentVtx(GameState* thisx) {
             } else if ((this->configMode == CM_ERASE_CONFIRM) || (this->configMode == CM_COPY_CONFIRM)) {
                 phi_t5 = D_80812844[this->buttonIndex];
             } else {
-                phi_t5 = D_80812830[this->buttonIndex];
+                phi_t5 = sMainMenuButtonVtx[this->buttonIndex];  // was D_80812830 [LLM:HIGH]
             }
         } else {
             phi_t5 = D_80812848[this->confirmButtonIndex];
@@ -1439,7 +1440,7 @@ void FileChoose_SetWindowContentVtx(GameState* thisx) {
     this->windowContentVtx[phi_t2 + 5].v.ob[0] = this->windowContentVtx[phi_t2 + 7].v.ob[0] =
         this->windowContentVtx[phi_t2 + 4].v.ob[0] + 0x80;
     this->windowContentVtx[phi_t2 + 4].v.ob[1] = this->windowContentVtx[phi_t2 + 5].v.ob[1] =
-        this->windowContentVtx[D_80812830[this->warningButtonIndex]].v.ob[1];
+        this->windowContentVtx[sMainMenuButtonVtx[this->warningButtonIndex]].v.ob[1];  // was D_80812830 [LLM:HIGH]
     this->windowContentVtx[phi_t2 + 6].v.ob[1] = this->windowContentVtx[phi_t2 + 7].v.ob[1] =
         this->windowContentVtx[phi_t2 + 4].v.ob[1] - 0x10;
     this->windowContentVtx[phi_t2 + 5].v.tc[0] = this->windowContentVtx[phi_t2 + 7].v.tc[0] = 0x1000;
-- 
