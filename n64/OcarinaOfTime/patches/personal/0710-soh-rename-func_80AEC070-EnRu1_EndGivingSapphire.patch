Subject: [PATCH 710/784] soh: rename func_80AEC070 -> EnRu1_EndGivingSapphire

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 272c2c27d..576233315 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -774,7 +774,8 @@ void EnRu1_EndSwimBack(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEC070(EnRu1* this, PlayState* play, UNK_TYPE arg2) {
+// Name from zeldaret/oot (was func_80AEC070): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_EndGivingSapphire(EnRu1* this, PlayState* play, UNK_TYPE arg2) {
     if ((EnRu1_CheckFountainCueMatchingId(play, 8)) && (arg2 != 0)) {
         Actor_Kill(&this->actor);
     }
@@ -841,7 +842,7 @@ void EnRu1_Fountain_FinishingSwimBack(EnRu1* this, PlayState* play) {
     EnRu1_UpdateBgCheckInfo(this, play);
     EnRu1_UpdateEyes(this);
     EnRu1_SpawnRippleTreading(this, play);
-    func_80AEC070(this, play, something);
+    EnRu1_EndGivingSapphire(this, play, something);
 }
 
 void func_80AEC320(EnRu1* this, PlayState* play) {
