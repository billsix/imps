+void BgBdanSwitch_SetupHeavyRelease(BgBdanSwitch* this);  // was func_8086DAB4 [LLM:HIGH]
 void func_8086DAC4(BgBdanSwitch* this, PlayState* play);
 void func_8086DB24(BgBdanSwitch* this);
 void func_8086DB40(BgBdanSwitch* this, PlayState* play);
@@ -400,12 +401,12 @@ void BgBdanSwitch_HeavyHalfPressed(BgBdanSwitch* this, PlayState* play) {
         }
     } else {
         if (this->unk_1D8 <= 0) {
-            func_8086DAB4(this);
+            BgBdanSwitch_SetupHeavyRelease(this);  // was func_8086DAB4 [LLM:HIGH]
         }
     }
 }
 
-void func_8086DAB4(BgBdanSwitch* this) {
+void BgBdanSwitch_SetupHeavyRelease(BgBdanSwitch* this) {
     this->actionFunc = func_8086DAC4;
 }
 
