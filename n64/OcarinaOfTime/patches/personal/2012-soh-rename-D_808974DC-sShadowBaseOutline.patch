From dd73d7abb4d8ad4a2a9c9938f1aef9069d2c8109 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:08:50 +0000
Subject: [PATCH 2012/3799] soh: rename D_808974DC -> sShadowBaseOutline

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the 5 points of the pedestal outline traced with sShadowBrushSmall
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
index ebe764051..e1b6fbd3c 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
@@ -99,7 +99,8 @@ static Vec3f sShadowStatueOutline[] = {  // was D_808973A4 [LLM:HIGH]
     { 0.0f, 101.4f, 5.0f },
 };
 
-static Vec3f D_808974DC[] = {
+// LLM generated name (HIGH), was D_808974DC: the 5 points of the pedestal outline traced with sShadowBrushSmall
+static Vec3f sShadowBaseOutline[] = {  // was D_808974DC [LLM:HIGH]
     { 12.0f, 21.300001f, -2.5f },  { 30.0f, 21.300001f, -2.5f }, { -15.0f, 21.300001f, -2.5f },
     { -30.0f, 21.300001f, -2.5f }, { 12.0f, 21.300001f, -2.5f },
 };
@@ -330,14 +331,14 @@ void BgJyaCobra_UpdateShadowFromSide(BgJyaCobra* this) {
     }
 
     for (i = 0; i < 4; i++) {
-        Math_Vec3f_Diff(&D_808974DC[i + 1], &D_808974DC[i], &spD4);
+        Math_Vec3f_Diff(&sShadowBaseOutline[i + 1], &sShadowBaseOutline[i], &spD4);  // was D_808974DC [LLM:HIGH]
         spD4.x *= 1 / 5.0f;
         spD4.y *= 1 / 5.0f;
         spD4.z *= 1 / 5.0f;
         for (j = 0; j < 5; j++) {
-            spC8.x = D_808974DC[i].x + (spD4.x * j);
-            spC8.y = D_808974DC[i].y + (spD4.y * j);
-            spC8.z = D_808974DC[i].z + (spD4.z * j);
+            spC8.x = sShadowBaseOutline[i].x + (spD4.x * j);  // was D_808974DC [LLM:HIGH]
+            spC8.y = sShadowBaseOutline[i].y + (spD4.y * j);  // was D_808974DC [LLM:HIGH]
+            spC8.z = sShadowBaseOutline[i].z + (spD4.z * j);  // was D_808974DC [LLM:HIGH]
             Matrix_MultVec3f(&spC8, &spBC);
             x = (s32)(((spBC.x + 50.0f) * 0.64f) + 0.5f);
             z = (s32)(((88.0f - spBC.z) * 0.64f) + 0.5f);
-- 
