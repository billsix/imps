From 81d4e33f002589a529b75abdb835b5bfad08abdd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:08:50 +0000
Subject: [PATCH 2011/3799] soh: rename D_808973A4 -> sShadowStatueOutline

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the 26 points of the cobra silhouette traced with sShadowBrushLarge
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
index 9c727b049..ebe764051 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
@@ -69,7 +69,8 @@ static u8 sShadowBrushSmall[3][3] = {  // was D_80897398 [LLM:HIGH]
     { 0x20, 0x80, 0x20 },
 };
 
-static Vec3f D_808973A4[] = {
+// LLM generated name (HIGH), was D_808973A4: the 26 points of the cobra silhouette traced with sShadowBrushLarge
+static Vec3f sShadowStatueOutline[] = {  // was D_808973A4 [LLM:HIGH]
     { -6.0f, 100.0f, 7.6f },
     { -12.6f, 69.200005f, -10.0f },
     { -9.0f, 43.0f, -1.0f },
@@ -302,14 +303,14 @@ void BgJyaCobra_UpdateShadowFromSide(BgJyaCobra* this) {
     Matrix_Scale(0.9f, 0.9f, 0.9f, MTXMODE_APPLY);
 
     for (i = 0; i < 25; i++) {
-        Math_Vec3f_Diff(&D_808973A4[i + 1], &D_808973A4[i], &spD4);
+        Math_Vec3f_Diff(&sShadowStatueOutline[i + 1], &sShadowStatueOutline[i], &spD4);  // was D_808973A4 [LLM:HIGH]
         spD4.x *= 1 / 2.0f;
         spD4.y *= 1 / 2.0f;
         spD4.z *= 1 / 2.0f;
         for (j = 0; j < 2; j++) {
-            spC8.x = D_808973A4[i].x + (spD4.x * j);
-            spC8.y = D_808973A4[i].y + (spD4.y * j);
-            spC8.z = D_808973A4[i].z + (spD4.z * j);
+            spC8.x = sShadowStatueOutline[i].x + (spD4.x * j);  // was D_808973A4 [LLM:HIGH]
+            spC8.y = sShadowStatueOutline[i].y + (spD4.y * j);  // was D_808973A4 [LLM:HIGH]
+            spC8.z = sShadowStatueOutline[i].z + (spD4.z * j);  // was D_808973A4 [LLM:HIGH]
             Matrix_MultVec3f(&spC8, &spBC);
             x = (spBC.x + 50.0f) * 0.64f + 0.5f;
             z = (88.0f - spBC.z) * 0.64f + 0.5f;
-- 
