From 51c2410173eb7ad092b8979e04f6cc3ac4f0a388 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:37 +0000
Subject: [PATCH 441/488] soh: rename D_809E4148 -> sEscapeOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the forward offset EnDaiku_EscapeSuccess moves the carpenter to
Defined in soh/src/overlays/actors/ovl_En_Daiku/z_en_daiku.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Daiku/z_en_daiku.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Daiku/z_en_daiku.c b/soh/src/overlays/actors/ovl_En_Daiku/z_en_daiku.c
index 950ee6ee2..475d3ea77 100644
--- a/soh/src/overlays/actors/ovl_En_Daiku/z_en_daiku.c
+++ b/soh/src/overlays/actors/ovl_En_Daiku/z_en_daiku.c
@@ -497,7 +497,7 @@ void EnDaiku_UpdateSubCamera(EnDaiku* this, PlayState* play) {
 }
 
 void EnDaiku_EscapeSuccess(EnDaiku* this, PlayState* play) {
-    static Vec3f D_809E4148 = { 0.0f, 0.0f, 120.0f };
+    static Vec3f sEscapeOffset = { 0.0f, 0.0f, 120.0f };  // was D_809E4148 [LLM:HIGH]
     Actor* gerudoGuard;
     Vec3f vec;
 
@@ -509,7 +509,7 @@ void EnDaiku_EscapeSuccess(EnDaiku* this, PlayState* play) {
 
     if (GET_EVENTCHKINF_CARPENTERS_FREE_ALL()) {
         Matrix_RotateY(this->initRot.y * (M_PI / 0x8000), MTXMODE_NEW);
-        Matrix_MultVec3f(&D_809E4148, &vec);
+        Matrix_MultVec3f(&sEscapeOffset, &vec);  // was D_809E4148 [LLM:HIGH]
         gerudoGuard = Actor_Spawn(&play->actorCtx, play, ACTOR_EN_GE3, this->initPos.x + vec.x, this->initPos.y + vec.y,
                                   this->initPos.z + vec.z, 0, Math_FAtan2F(-vec.x, -vec.z) * (0x8000 / M_PI), 0, 2);
 
