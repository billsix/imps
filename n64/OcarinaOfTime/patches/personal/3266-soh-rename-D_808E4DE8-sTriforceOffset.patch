From dc33deff9c791008778eedb9094dad41c7a48dda Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:10:29 +0000
Subject: [PATCH 3266/3799] soh: rename D_808E4DE8 -> sTriforceOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the point the triforce mark is placed at when Ganondorf carries it
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index d3c05b8ed..9d153371b 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -3333,7 +3333,7 @@ void BossGanon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
     static Vec3f sLimb6Offset = { 0.0f, 0.0f, 0.0f };  // was D_808E4DC4 [LLM:HIGH]
     static Vec3f sLimb10Offset = { 0.0f, 0.0f, 0.0f };  // was D_808E4DD0 [LLM:HIGH]
     static Vec3f sLimb10FarOffset = { 1300.0f, 0.0f, 0.0f };  // was D_808E4DDC [LLM:HIGH]
-    static Vec3f D_808E4DE8 = { 600.0f, 420.0f, 100.0f };
+    static Vec3f sTriforceOffset = { 600.0f, 420.0f, 100.0f };  // was D_808E4DE8 [LLM:HIGH]
     s8 bodyPart;
     BossGanon* this = (BossGanon*)thisx;
 
@@ -3366,7 +3366,7 @@ void BossGanon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
         this->unk_25C = 0;
 
         if (this->triforceType == GDF_TRIFORCE_DORF) {
-            Matrix_MultVec3f(&D_808E4DE8, &this->triforcePos);
+            Matrix_MultVec3f(&sTriforceOffset, &this->triforcePos);  // was D_808E4DE8 [LLM:HIGH]
         }
     } else if (limbIndex == 4) {
         Vec3f sp28 = sLeftHandBaseOffset;  // was D_808E4DA0 [LLM:HIGH]
