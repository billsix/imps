From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:33:26 +0000
Subject: [PATCH 1663/3799] soh: rename func_8008A994 ->
 Interface_SetFullscreenViewport

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: resets the interface view to the full-screen viewport and applies it.
Defined in soh/src/code/z_parameter.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_parameter.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_parameter.c b/soh/src/code/z_parameter.c
index a6aa1e3e3..77617d8cf 100644
--- a/soh/src/code/z_parameter.c
+++ b/soh/src/code/z_parameter.c
@@ -5094,7 +5094,8 @@ void Interface_SetViewport(PlayState* play, s32 topY, s32 bottomY, s32 leftX, s3
 }
 */
 
-void func_8008A994(InterfaceContext* interfaceCtx) {
+// LLM generated name (HIGH), was func_8008A994: resets the interface view to the full-screen viewport and applies it.
+void Interface_SetFullscreenViewport(InterfaceContext* interfaceCtx) {
     SET_FULLSCREEN_VIEWPORT(&interfaceCtx->view);
     func_800AB2C4(&interfaceCtx->view);
 }
@@ -5184,7 +5185,7 @@ void Interface_Draw(PlayState* play) {
 
     if (pauseCtx->debugState == 0) {
         Interface_InitVertices(play);
-        func_8008A994(interfaceCtx);
+        Interface_SetFullscreenViewport(interfaceCtx);  // was func_8008A994 [LLM:HIGH]
         if (fullUi || gSaveContext.health != gSaveContext.healthCapacity) {
             HealthMeter_Draw(play);
         }
@@ -5763,7 +5764,7 @@ void Interface_Draw(PlayState* play) {
 
         gDPPipeSync(OVERLAY_DISP++);
 
-        func_8008A994(interfaceCtx);
+        Interface_SetFullscreenViewport(interfaceCtx);  // was func_8008A994 [LLM:HIGH]
         svar3 = 16;
 
         if ((pauseCtx->state == 6) && (pauseCtx->unk_1E4 == 3)) {
