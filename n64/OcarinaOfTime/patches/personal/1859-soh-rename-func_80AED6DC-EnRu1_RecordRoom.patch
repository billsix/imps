         this->actor.velocity.y *= (kREG(26) * 0.01f) + 1.0f;
         this->actor.minVelocityY = -((kREG(24) * 0.01f) + 6.8f);
@@ -2024,7 +2025,7 @@ void EnRu1_HoldSittingPose(EnRu1* this, PlayState* play, UNK_TYPE arg2) {
                          Animation_GetLastFrame(&gRutoChildSittingAnim), ANIMMODE_LOOP, 0.0f);
         Message_CloseTextbox(play);
         Flags_SetInfTable(INFTABLE_143);
-        func_80AED6DC(this, play);
+        EnRu1_RecordRoom(this, play);  // was func_80AED6DC [LLM:HIGH]
         Actor_OfferCarry(&this->actor, play);
         this->action = 27;
         EnRu1_DisableSittingOC(this);
