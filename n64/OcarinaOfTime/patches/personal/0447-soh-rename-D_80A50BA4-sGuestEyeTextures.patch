From e7b1ceec67b8bd67b88271dc56bc1c7a008ba974 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:38 +0000
Subject: [PATCH 447/488] soh: rename D_80A50BA4 -> sGuestEyeTextures

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the eye textures EnGuest_Draw binds
Defined in soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c b/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c
index 8a62918aa..8a5724812 100644
--- a/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c
+++ b/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c
@@ -216,7 +216,7 @@ s32 EnGuest_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f*
 }
 
 void EnGuest_Draw(Actor* thisx, PlayState* play) {
-    static void* D_80A50BA4[] = {
+    static void* sGuestEyeTextures[] = {  // was D_80A50BA4 [LLM:HIGH]
         object_boj_Tex_0005FC,
         object_boj_Tex_0006FC,
         object_boj_Tex_0007FC,
@@ -229,7 +229,7 @@ void EnGuest_Draw(Actor* thisx, PlayState* play) {
 
     gSPSegment(POLY_OPA_DISP++, 0x08, EnGuest_AllocEnvColorDList(play->state.gfxCtx, 255, 255, 255, 255));  // was func_80A50708 [LLM:HIGH]
     gSPSegment(POLY_OPA_DISP++, 0x09, EnGuest_AllocEnvColorDList(play->state.gfxCtx, 160, 60, 220, 255));  // was func_80A50708 [LLM:HIGH]
-    gSPSegment(POLY_OPA_DISP++, 0x0A, SEGMENTED_TO_VIRTUAL(D_80A50BA4[this->unk_30E]));
+    gSPSegment(POLY_OPA_DISP++, 0x0A, SEGMENTED_TO_VIRTUAL(sGuestEyeTextures[this->unk_30E]));  // was D_80A50BA4 [LLM:HIGH]
 
     SkelAnime_DrawSkeletonOpa(play, &this->skelAnime, EnGuest_OverrideLimbDraw, NULL, this);
 
