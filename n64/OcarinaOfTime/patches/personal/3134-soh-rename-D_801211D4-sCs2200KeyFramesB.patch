From b2e3a4aaa405fa0be4c20d68c0d29bc7650c3503 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:43 +0000
Subject: [PATCH 3134/3799] soh: rename D_801211D4 -> sCs2200KeyFramesB

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the second of those two sets
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 16 ++++++++--------
 soh/src/code/z_onepointdemo_data.inc |  3 ++-
 2 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 9a0127321..d4cae45d7 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -24,7 +24,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs2280KeyFrames)                                   \
     F(sCs2230KeyFrames)                                   \
     F(sCs2200KeyFramesA)                                   \
-    F(D_801211D4)                                   \
+    F(sCs2200KeyFramesB)                                   \
     F(sCs4510KeyFrames)                                   \
     F(sCs2210KeyFrames)                                   \
     F(sCs3040KeyFrames)                                   \
@@ -283,16 +283,16 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
                 csInfo->keyFrames = sCs2200KeyFramesA;  // was D_80121184 [LLM:HIGH]
                 csInfo->keyFrameCnt = 2;
             } else {
-                D_801211D4[0].atTargetInit.x = actor->focus.pos.x;
-                D_801211D4[0].atTargetInit.y = actor->focus.pos.y - 5.0f;
-                D_801211D4[0].atTargetInit.z = actor->focus.pos.z;
+                sCs2200KeyFramesB[0].atTargetInit.x = actor->focus.pos.x;  // was D_801211D4 [LLM:HIGH]
+                sCs2200KeyFramesB[0].atTargetInit.y = actor->focus.pos.y - 5.0f;  // was D_801211D4 [LLM:HIGH]
+                sCs2200KeyFramesB[0].atTargetInit.z = actor->focus.pos.z;  // was D_801211D4 [LLM:HIGH]
                 spC0 = ((EnSw*)actor)->unk_364;
                 osSyncPrintf("%s(%d): xyz_t: %s (%f %f %f)\n", __FILE__, __LINE__, "&cp", spC0.x, spC0.y, spC0.z);
-                D_801211D4[0].eyeTargetInit.x = (actor->focus.pos.x + (120.0f * spC0.x)) - (Rand_ZeroOne() * 20.0f);
-                D_801211D4[0].eyeTargetInit.y = actor->focus.pos.y + (120.0f * spC0.y) + 20.0f;
-                D_801211D4[0].eyeTargetInit.z = (actor->focus.pos.z + (120.0f * spC0.z)) - (Rand_ZeroOne() * 20.0f);
+                sCs2200KeyFramesB[0].eyeTargetInit.x = (actor->focus.pos.x + (120.0f * spC0.x)) - (Rand_ZeroOne() * 20.0f);  // was D_801211D4 [LLM:HIGH]
+                sCs2200KeyFramesB[0].eyeTargetInit.y = actor->focus.pos.y + (120.0f * spC0.y) + 20.0f;  // was D_801211D4 [LLM:HIGH]
+                sCs2200KeyFramesB[0].eyeTargetInit.z = (actor->focus.pos.z + (120.0f * spC0.z)) - (Rand_ZeroOne() * 20.0f);  // was D_801211D4 [LLM:HIGH]
 
-                csInfo->keyFrames = D_801211D4;
+                csInfo->keyFrames = sCs2200KeyFramesB;  // was D_801211D4 [LLM:HIGH]
                 csInfo->keyFrameCnt = 2;
             }
             Play_ChangeCameraStatus(play, CAM_ID_MAIN, CAM_STAT_UNK3);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index fa3187579..ff0985f17 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -245,7 +245,8 @@ static OnePointCsFull sCs2200KeyFramesA[2] = {  // was D_80121184 [LLM:HIGH]
     { 0x12, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_801211D4[2] = {
+// LLM generated name (HIGH), was D_801211D4: the second of those two sets
+static OnePointCsFull sCs2200KeyFramesB[2] = {  // was D_801211D4 [LLM:HIGH]
     { 0x8F, 0x08, 0x0101, 50, 0, 60.0f, 1.0f, { 0.0f, 10.0f, 0.0f }, { -10.0f, 85.0f, 0.0f } },
     { 0x11, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
