@@ -868,7 +868,8 @@ void DemoGj_TumbleRubblePile6(DemoGj* this, PlayState* play) {
     DemoGj_SetupRotation(this, play);
 }
 
-void func_8097AA60(DemoGj* this, PlayState* play) {
+// LLM generated name (HIGH), was func_8097AA60: once Ganondorf starts rising, launches rubble pile 6 and switches it to update mode 13
+void DemoGj_CheckRisingPile6(DemoGj* this, PlayState* play) {
     if (DemoGj_IsGanondorfRisingFromRubble(this, play)) {
         DemoGj_SetupMovement(this, play);
         this->updateMode = 13;
@@ -885,7 +886,7 @@ void func_8097AAAC(DemoGj* this, PlayState* play) {
 // func_8097AADC
 void DemoGj_Update06(DemoGj* this, PlayState* play) {
     DemoGj_FindGanon(this, play);
-    func_8097AA60(this, play);
