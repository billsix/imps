-u8 D_80013960;
+// LLM generated name (GUESS), was D_80013960: u8 set from osTvType at boot (2 NTSC, 0x1E MPAL, 0x2C PAL) and passed to Sched_Init as arg3, which that function ignores; named for where it goes because what the value means is unrecoverable from this tree.
+u8 gSchedTvTypeParam;  // was D_80013960 [LLM:GUESS]
 
-s8 D_80009430 = 1;
+// LLM generated name (GUESS), was D_80009430: s8 set to 1 at boot right after osViSetMode and again in Graph_Update whenever gViConfigAdditionalScanLines or gViConfigYScale change; nothing in this tree reads it, so "changed flag" is inferred from the write sites.
+s8 gViConfigChanged = 1;  // was D_80009430 [LLM:GUESS]
 vu8 gViConfigUseDefault = 1;
 u8 gViConfigAdditionalScanLines = 0;
 u32 gViConfigFeatures = OS_VI_DITHER_FILTER_ON | OS_VI_GAMMA_OFF;
@@ -58,23 +60,23 @@ void Idle_ThreadEntry(void* arg) {
 
     switch (osTvType) {
         case OS_TV_NTSC:
-            D_80013960 = 2;
+            gSchedTvTypeParam = 2;  // was D_80013960 [LLM:GUESS]
             gViConfigMode = osViModeNtscLan1;
             break;
 
         case OS_TV_MPAL:
-            D_80013960 = 0x1E;
+            gSchedTvTypeParam = 0x1E;  // was D_80013960 [LLM:GUESS]
             gViConfigMode = osViModeMpalLan1;
             break;
 
         case OS_TV_PAL:
-            D_80013960 = 0x2C;
+            gSchedTvTypeParam = 0x2C;  // was D_80013960 [LLM:GUESS]
             gViConfigMode = osViModeFpalLan1;
             gViConfigYScale = 0.833f;
             break;
     }
 
-    D_80009430 = 1;
+    gViConfigChanged = 1;  // was D_80009430 [LLM:GUESS]
     osViSetMode(&gViConfigMode);
     ViConfig_UpdateVi(1);
     osViBlack(1);
diff --git a/soh/src/code/game.c b/soh/src/code/game.c
