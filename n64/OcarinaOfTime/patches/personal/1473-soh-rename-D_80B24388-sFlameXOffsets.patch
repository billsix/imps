From bfd57456410d7e9007593dc64239a3b49efd6eef Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:17 +0000
Subject: [PATCH 1473/3799] soh: rename D_80B24388 -> sFlameXOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the sideways offsets of the seven flame particles, applied along the camera-facing axis so the cluster spreads across the screen.
Defined in soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
index dcba01806..5fad059ad 100644
--- a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
+++ b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
@@ -68,7 +68,8 @@ static AnimationHeader* sCastMagicAnims[] = {  // was D_80B24380 [LLM:HIGH]
     &gKotakeKoumeCastMagicAnim,
 };
 
-static f32 D_80B24388[] = { 0.0f, 20.0f, -30.0f, 20.0f, -20.0f, -20.0f, 30.0f };
+// LLM generated name (HIGH), was D_80B24388: the sideways offsets of the seven flame particles, applied along the camera-facing axis so the cluster spreads across the screen.
+static f32 sFlameXOffsets[] = { 0.0f, 20.0f, -30.0f, 20.0f, -20.0f, -20.0f, 30.0f };  // was D_80B24388 [LLM:HIGH]
 
 static f32 D_80B243A4[] = { 0.0f, 30.0f, 0.0f, -30.0f, 30.0f, -30.0f, 0.0f };
 
@@ -240,9 +241,9 @@ void func_80B23254(EnTr* this, PlayState* play, s32 arg2, f32 arg3, f32 scale) {
     sp58.y -= velocity.y * 10.0f;
     sp58.z -= velocity.z * 10.0f;
 
-    pos.x = sp58.x + ((D_80B24388[arg2] * scale) * Math_CosS(yaw));
+    pos.x = sp58.x + ((sFlameXOffsets[arg2] * scale) * Math_CosS(yaw));  // was D_80B24388 [LLM:HIGH]
     pos.y = sp58.y + (D_80B243A4[arg2] * scale);
-    pos.z = sp58.z - ((D_80B24388[arg2] * scale) * Math_SinS(yaw));
+    pos.z = sp58.z - ((sFlameXOffsets[arg2] * scale) * Math_SinS(yaw));  // was D_80B24388 [LLM:HIGH]
     func_8002829C(play, &pos, &velocity, &accel, primColor, envColor, (s32)(800.0f * scale), (s32)(80.0f * scale));
 }
 
