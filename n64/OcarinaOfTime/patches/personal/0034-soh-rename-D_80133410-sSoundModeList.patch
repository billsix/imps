From 3d8a0d4cdc7acdcd3afa030a05d795b10f027c1c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:13 +0000
Subject: [PATCH 034/784] soh: rename D_80133410 -> sSoundModeList

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/audio_seq.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_seq.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_seq.c b/soh/src/code/audio_seq.c
index 11ef3eb7b..a1ec47ef3 100644
--- a/soh/src/code/audio_seq.c
+++ b/soh/src/code/audio_seq.c
@@ -25,7 +25,8 @@ u8 sSeqCmdRdPos = 0;
 u8 gStartSeqDisabled = 0;
 // Name from zeldaret/oot, was D_8013340C: gates the osSyncPrintf debug print of processed seq commands. [oot: https://github.com/zeldaret/oot/blob/main/src/audio/game/sequence.c]
 u8 gAudioDebugPrintSeqCmd = 1;
-u8 D_80133410[] = { 0, 1, 2, 3 };
+// LLM generated name (HIGH), was D_80133410: sound-mode values indexed to issue the set-sound-mode command.
+u8 sSoundModeList[] = { 0, 1, 2, 3 };
 u8 gAudioSpecId = 0;
 u8 D_80133418 = 0;
 
@@ -363,7 +364,7 @@ void Audio_ProcessSeqCmd(u32 cmd) {
             switch (subOp) {
                 case 0:
                     // set sound mode
-                    Audio_QueueCmdS32(0xF0000000, D_80133410[val]);
+                    Audio_QueueCmdS32(0xF0000000, sSoundModeList[val]);
                     break;
                 case 1:
                     // set sequence starting disabled?
