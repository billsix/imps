From dd0bcbe6295da202940aff9dc95f4ad742973237 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:47:37 +0000
Subject: [PATCH 1097/3799] soh: rename func_80B92D20 -> ObjElevator_SetupMove

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs ObjElevator_Move through ObjElevator_SetupAction.
Defined in soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c b/soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c
index 509bab32d..901336375 100644
--- a/soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c
+++ b/soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c
@@ -18,7 +18,8 @@ void ObjElevator_Draw(Actor* thisx, PlayState* play);
 void ObjElevator_SetupWaitForPlayer(ObjElevator* this);  // was func_80B92C5C [LLM:HIGH]
 // LLM generated name (HIGH), was func_80B92C80: on the frame the player steps on, picks the opposite end of the run (home, or home plus the params height) as the target and starts moving.
 void ObjElevator_WaitForPlayer(ObjElevator* this, PlayState* play);  // was func_80B92C80 [LLM:HIGH]
-void func_80B92D20(ObjElevator* this);
+// LLM generated name (HIGH), was func_80B92D20: installs ObjElevator_Move through ObjElevator_SetupAction.
+void ObjElevator_SetupMove(ObjElevator* this);  // was func_80B92D20 [LLM:HIGH]
 void func_80B92D44(ObjElevator* this, PlayState* play);
 
 const ActorInit Obj_Elevator_InitVars = {
@@ -96,11 +97,11 @@ void ObjElevator_WaitForPlayer(ObjElevator* this, PlayState* play) {
         } else {
             this->unk_168 = thisx->home.pos.y;
         }
-        func_80B92D20(this);
+        ObjElevator_SetupMove(this);  // was func_80B92D20 [LLM:HIGH]
     }
 }
 
-void func_80B92D20(ObjElevator* this) {
+void ObjElevator_SetupMove(ObjElevator* this) {
     ObjElevator_SetupAction(this, func_80B92D44);
 }
 
