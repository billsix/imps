From af3af1e0d75daada1af79a595cbb94f0530efde3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:37:36 +0000
Subject: [PATCH 1697/3799] soh: rename func_80045B08 -> Camera_CalcAtForTurn

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same at-point calculation with the offset swung to the player's side according to the caller's angle, used while the camera turns around them. Named to pair with Camera_CalcAtForNormal.
Defined in soh/src/code/z_camera.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 14abd9e68..8fa41e711 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -981,7 +981,8 @@ s32 Camera_CalcAtForNormal(Camera* camera, VecSph* eyeAtDir, f32 arg2, f32* arg3
     return 1;
 }
 
-s32 func_80045B08(Camera* camera, VecSph* eyeAtDir, f32 yExtra, s16 arg3) {
+// LLM generated name (GUESS), was func_80045B08: the same at-point calculation with the offset swung to the player's side according to the caller's angle, used while the camera turns around them. Named to pair with Camera_CalcAtForNormal.
+s32 Camera_CalcAtForTurn(Camera* camera, VecSph* eyeAtDir, f32 yExtra, s16 arg3) {
     f32 phi_f2;
     Vec3f posOffsetTarget;
     Vec3f atTarget;
@@ -1707,7 +1708,7 @@ s32 Camera_Normal1(Camera* camera) {
     if (norm1->interfaceFlags & 0x80) {
         Camera_CalcAtForNormal(camera, &atEyeNextGeo, spA0, &anim->yOffset, norm1->interfaceFlags & 1);  // was func_800458D4 [LLM:GUESS]
     } else if (norm1->interfaceFlags & 0x20) {
-        func_80045B08(camera, &atEyeNextGeo, spA0, anim->slopePitchAdj);
+        Camera_CalcAtForTurn(camera, &atEyeNextGeo, spA0, anim->slopePitchAdj);  // was func_80045B08 [LLM:GUESS]
     } else {
         Camera_CalcAtDefault(camera, &atEyeNextGeo, spA0, norm1->interfaceFlags & 1);
     }
