From afedb6917e0d003f19677f7897ce4fff34c7bf47 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:56:13 +0000
Subject: [PATCH 1194/3799] soh: rename D_8016C820 -> sOcarinaBank

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: gSoundBanks[5]; the same comment names entry 5 "Ocarina Bank size 3".
Defined in soh/src/code/audio_sfx.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_sfx.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index b263ec6c6..d45c0cd1f 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -46,7 +46,8 @@ SoundBankEntry sEnvironmentBank[22];  // was D_8016BEC0 [LLM:HIGH]
 SoundBankEntry sEnemyBank[20];  // was D_8016C2E0 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8016C6A0: gSoundBanks[4]; the same comment names entry 4 "System Bank size 8".
 SoundBankEntry sSystemBank[8];  // was D_8016C6A0 [LLM:HIGH]
-SoundBankEntry D_8016C820[3];
+// LLM generated name (HIGH), was D_8016C820: gSoundBanks[5]; the same comment names entry 5 "Ocarina Bank size 3".
+SoundBankEntry sOcarinaBank[3];  // was D_8016C820 [LLM:HIGH]
 SoundBankEntry D_8016C8B0[5];
 SoundRequest sSoundRequests[0x100];
 u8 sSoundBankListEnd[7];
@@ -76,12 +77,12 @@ u8 sSoundRequestReadIndex = 0;
  * 6 : Voice Bank           size 5
  */
 SoundBankEntry* gSoundBanks[7] = {
-    sPlayerBank, sItemBank, sEnvironmentBank, sEnemyBank, sSystemBank, D_8016C820, D_8016C8B0,  // was D_8016BAD0 [LLM:HIGH]
+    sPlayerBank, sItemBank, sEnvironmentBank, sEnemyBank, sSystemBank, sOcarinaBank, D_8016C8B0,  // was D_8016BAD0 [LLM:HIGH]
 };
 
 u8 sBankSizes[ARRAY_COUNT(gSoundBanks)] = {
     ARRAY_COUNT(sPlayerBank), ARRAY_COUNT(sItemBank), ARRAY_COUNT(sEnvironmentBank), ARRAY_COUNT(sEnemyBank),  // was D_8016BAD0 [LLM:HIGH]
-    ARRAY_COUNT(sSystemBank), ARRAY_COUNT(D_8016C820), ARRAY_COUNT(D_8016C8B0),  // was D_8016C6A0 [LLM:HIGH]
+    ARRAY_COUNT(sSystemBank), ARRAY_COUNT(sOcarinaBank), ARRAY_COUNT(D_8016C8B0),  // was D_8016C6A0 [LLM:HIGH]
 };
 
 u8 gSfxChannelLayout = 0;
-- 
