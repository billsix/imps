From 9e1c61e11663f80a36afad1d6b5e807273ef57b4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:05 +0000
Subject: [PATCH 3198/3799] soh: rename D_8011DAEC -> sSpec7Rolls

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the roll each spec 7 index reaches between those two heights
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c        | 2 +-
 soh/src/code/z_camera_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 10241f85e..87dca447f 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -6696,7 +6696,7 @@ s32 Camera_Special7(Camera* camera) {
         Camera_LERPCeilVec3f(&atTarget, &camera->at, 0.4f, 0.4f, 0.10f);
         camera->eye = camera->eyeNext = sSpec7EyeHighPoints[spec7->idx];  // was D_8011DA6C [LLM:HIGH]
         temp_f0 = (playerPosRot->pos.y - sSpec7LowY[spec7->idx]) / (sSpec7HighY[spec7->idx] - sSpec7LowY[spec7->idx]);  // was D_8011DACC [LLM:HIGH]
-        camera->roll = D_8011DAEC[spec7->idx] * temp_f0;
+        camera->roll = sSpec7Rolls[spec7->idx] * temp_f0;  // was D_8011DAEC [LLM:HIGH]
         camera->fov = (20.0f * temp_f0) + 60.0f;
     } else {
         atTarget = playerPosRot->pos;
diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index 396907163..a56d9aecf 100644
--- a/soh/src/code/z_camera_data.inc
+++ b/soh/src/code/z_camera_data.inc
@@ -2413,7 +2413,8 @@ f32 sSpec7HighY[] = { 1570.0f, 3680.0f, 3700.0f, 395.0f };  // was D_8011DACC [L
 // LLM generated name (HIGH), was D_8011DADC: the lower height threshold per spec 7 index
 f32 sSpec7LowY[] = { 320.0f, 320.0f, 320.0f, 0.0f };  // was D_8011DADC [LLM:HIGH]
 
-s16 D_8011DAEC[] = { -2000, -1000, 0, 0, 0, 0, 0, 0 };
+// LLM generated name (HIGH), was D_8011DAEC: the roll each spec 7 index reaches between those two heights
+s16 sSpec7Rolls[] = { -2000, -1000, 0, 0, 0, 0, 0, 0 };  // was D_8011DAEC [LLM:HIGH]
 
 s16 D_8011DAFC[] = {
     CAM_SET_NORMAL0, CAM_SET_NORMAL1, CAM_SET_NORMAL2, CAM_SET_DUNGEON0, CAM_SET_DUNGEON1, CAM_SET_DUNGEON2,
-- 
2.55.0

