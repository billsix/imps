From 0eab9e58783bd93d70f7a167db06be64d944a300 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:08:49 +0000
Subject: [PATCH 2003/3799] soh: rename func_80896ABC -> BgJyaCobra_Turn

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sweeps 0x2000 with an accelerating step, carrying the player, then returns to idle on the next detent
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c    | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
index 1bf17ecf5..4aaa921eb 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
@@ -20,7 +20,8 @@ void BgJyaCobra_SetupIdle(BgJyaCobra* this, PlayState* play);  // was func_80896
 void BgJyaCobra_Idle(BgJyaCobra* this, PlayState* play);  // was func_80896950 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808969F8: chooses the turn direction from the push angle and records the player's offset for the ride
 void BgJyaCobra_SetupTurn(BgJyaCobra* this, PlayState* play);  // was func_808969F8 [LLM:HIGH]
-void func_80896ABC(BgJyaCobra* this, PlayState* play);
+// LLM generated name (HIGH), was func_80896ABC: sweeps 0x2000 with an accelerating step, carrying the player, then returns to idle on the next detent
+void BgJyaCobra_Turn(BgJyaCobra* this, PlayState* play);  // was func_80896ABC [LLM:HIGH]
 
 #include "overlays/ovl_Bg_Jya_Cobra/ovl_Bg_Jya_Cobra.h"
 
@@ -468,7 +469,7 @@ void BgJyaCobra_SetupTurn(BgJyaCobra* this, PlayState* play) {
     s32 phi_a3;
     s16 temp2;
 
-    this->actionFunc = func_80896ABC;
+    this->actionFunc = BgJyaCobra_Turn;  // was func_80896ABC [LLM:HIGH]
 
     temp2 = this->dyna.actor.yawTowardsPlayer - this->dyna.actor.shape.rot.y;
     phi_a3 = (s16)(this->dyna.actor.shape.rot.y - this->dyna.unk_158);
@@ -488,7 +489,7 @@ void BgJyaCobra_SetupTurn(BgJyaCobra* this, PlayState* play) {
     this->unk_16E = CVarGetInteger(CVAR_ENHANCEMENT("FasterBlockPush"), 0) * 20;
 }
 
-void func_80896ABC(BgJyaCobra* this, PlayState* play) {
+void BgJyaCobra_Turn(BgJyaCobra* this, PlayState* play) {
     s16 temp_v0;
     Player* player = GET_PLAYER(play);
 
@@ -591,7 +592,7 @@ void BgJyaCobra_DrawShadow(BgJyaCobra* this, PlayState* play) {
     }
 
     // Fixes cobra statue shadow texture not updating when rotating it
-    if (this->actionFunc == func_80896ABC) {
+    if (this->actionFunc == BgJyaCobra_Turn) {  // was func_80896ABC [LLM:HIGH]
         gSPInvalidateTexCache(POLY_XLU_DISP++, COBRA_SHADOW_TEX_PTR(this));
     }
 
