From d0673def23d319832227e483b13dd1ae39889737 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:02 +0000
Subject: [PATCH 062/488] soh: rename func_80B0B81C ->
 EnStream_CheckPlayerInRange

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Stream/z_en_stream.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Stream/z_en_stream.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Stream/z_en_stream.c b/soh/src/overlays/actors/ovl_En_Stream/z_en_stream.c
index 6ac3bac20..461e0299f 100644
--- a/soh/src/overlays/actors/ovl_En_Stream/z_en_stream.c
+++ b/soh/src/overlays/actors/ovl_En_Stream/z_en_stream.c
@@ -51,7 +51,8 @@ void EnStream_Destroy(Actor* thisx, PlayState* play) {
 }
 
 // Checks if the player is in range of the vortex
-s32 func_80B0B81C(Vec3f* vortexPosRot, Vec3f* playerPosRot, Vec3f* posDifference, f32 vortexYScale) {
+// LLM generated name (HIGH), was func_80B0B81C: tests player XZ distance within vortex range, returns 1 if inside
+s32 EnStream_CheckPlayerInRange(Vec3f* vortexPosRot, Vec3f* playerPosRot, Vec3f* posDifference, f32 vortexYScale) {
     s32 ret = 0;
     f32 smallConstant = 28.0f;
     f32 upperBounds = 160 * vortexYScale * 50.0f;
@@ -86,7 +87,7 @@ void EnStream_SuckPlayer(EnStream* this, PlayState* play) {
     f32 xzDist;
     f32 yDistWithOffset;
 
-    if (func_80B0B81C(&this->actor.world.pos, &player->actor.world.pos, &posDifference, this->actor.scale.y) != 0) {
+    if (EnStream_CheckPlayerInRange(&this->actor.world.pos, &player->actor.world.pos, &posDifference, this->actor.scale.y) != 0) {
         xzDist = sqrtf(SQ(posDifference.x) + SQ(posDifference.z));
         yDistWithOffset = player->actor.world.pos.y - (this->actor.world.pos.y - 90.0f);
         player->pushedYaw = Math_FAtan2F(-posDifference.x, -posDifference.z) * (0x8000 / M_PI);
@@ -112,7 +113,7 @@ void EnStream_WaitForPlayer(EnStream* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
     Vec3f temp;
 
-    if (func_80B0B81C(&this->actor.world.pos, &player->actor.world.pos, &temp, this->actor.scale.y) != 0) {
+    if (EnStream_CheckPlayerInRange(&this->actor.world.pos, &player->actor.world.pos, &temp, this->actor.scale.y) != 0) {
         EnStream_SetupAction(this, EnStream_SuckPlayer);
     }
 }
