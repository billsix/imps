From 7a707f43442d89fd19b13a0f39b7478d35d786de Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:04 +0000
Subject: [PATCH 3192/3799] soh: rename D_8011D954 -> sAttentionDoorKeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframes used when the target is a door
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c        | 24 ++++++++++++------------
 soh/src/code/z_camera_data.inc |  3 ++-
 2 files changed, 14 insertions(+), 13 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index d0e954698..9bbac8762 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -6145,7 +6145,7 @@ s32 Camera_Demo5(Camera* camera) {
         }
     } else if (camera->target->category == ACTORCAT_DOOR) {
         // the target is a door.
-        D_8011D954[0].timerInit = camera->timer - 5;
+        sAttentionDoorKeyFrames[0].timerInit = camera->timer - 5;  // was D_8011D954 [LLM:HIGH]
         sp4A = 0;
         if (!Play_GetDoorFacingYaw(camera->play, camera->target, &sp4A)) {  // was func_800C0D34 [LLM:HIGH]
             osSyncPrintf(VT_COL(YELLOW, BLACK) "camera: attention demo: this door is dummy door!\n" VT_RST);
@@ -6156,28 +6156,28 @@ s32 Camera_Demo5(Camera* camera) {
             }
         }
 
-        D_8011D954[0].atTargetInit.y = D_8011D954[0].eyeTargetInit.y = D_8011D954[1].atTargetInit.y =
+        sAttentionDoorKeyFrames[0].atTargetInit.y = sAttentionDoorKeyFrames[0].eyeTargetInit.y = sAttentionDoorKeyFrames[1].atTargetInit.y =  // was D_8011D954 [LLM:HIGH]
             camera->target->shape.rot.y == sp4A ? 180.0f : 0.0f;
         sp90 = (BINANG_SUB(playerTargetGeo.yaw, sp4A) < 0 ? 20.0f : -20.0f) * Rand_ZeroOne();
-        D_8011D954[0].eyeTargetInit.y = D_8011D954->eyeTargetInit.y + sp90;
+        sAttentionDoorKeyFrames[0].eyeTargetInit.y = sAttentionDoorKeyFrames->eyeTargetInit.y + sp90;  // was D_8011D954 [LLM:HIGH]
         temp_v0 = Rand_ZeroOne() * (sp90 * -0.2f);
-        D_8011D954[1].rollTargetInit = temp_v0;
-        D_8011D954[0].rollTargetInit = temp_v0;
+        sAttentionDoorKeyFrames[1].rollTargetInit = temp_v0;  // was D_8011D954 [LLM:HIGH]
+        sAttentionDoorKeyFrames[0].rollTargetInit = temp_v0;  // was D_8011D954 [LLM:HIGH]
         Actor_GetFocus(&targethead, camera->target);
         targethead.pos.x += 50.0f * Math_SinS(BINANG_ROT180(sp4A));
         targethead.pos.z += 50.0f * Math_CosS(BINANG_ROT180(sp4A));
         if (Camera_BGCheck(camera, &playerhead.pos, &targethead.pos)) {
-            D_8011D954[1].actionFlags = 0xC1;
-            D_8011D954[2].actionFlags = 0x8F;
+            sAttentionDoorKeyFrames[1].actionFlags = 0xC1;  // was D_8011D954 [LLM:HIGH]
+            sAttentionDoorKeyFrames[2].actionFlags = 0x8F;  // was D_8011D954 [LLM:HIGH]
         } else {
-            D_8011D954[2].timerInit = (s16)(eyeTargetDist * 0.004f) + 6;
+            sAttentionDoorKeyFrames[2].timerInit = (s16)(eyeTargetDist * 0.004f) + 6;  // was D_8011D954 [LLM:HIGH]
         }
-        ONEPOINT_CS_INFO(camera)->keyFrames = D_8011D954;
-        ONEPOINT_CS_INFO(camera)->keyFrameCnt = ARRAY_COUNT(D_8011D954);
+        ONEPOINT_CS_INFO(camera)->keyFrames = sAttentionDoorKeyFrames;  // was D_8011D954 [LLM:HIGH]
+        ONEPOINT_CS_INFO(camera)->keyFrameCnt = ARRAY_COUNT(sAttentionDoorKeyFrames);  // was D_8011D954 [LLM:HIGH]
         if (camera->parentCamIdx != CAM_ID_MAIN) {
             ONEPOINT_CS_INFO(camera)->keyFrameCnt -= 2;
         } else {
-            camera->timer += D_8011D954[2].timerInit + D_8011D954[3].timerInit;
+            camera->timer += sAttentionDoorKeyFrames[2].timerInit + sAttentionDoorKeyFrames[3].timerInit;  // was D_8011D954 [LLM:HIGH]
         }
     } else {
         if (playerTargetGeo.r < 200.0f) {
@@ -8390,7 +8390,7 @@ s16 Camera_SetFinishedFlag(Camera* camera) {
     F(sAttentionCloseKeyFrames)                       \
     F(sAttentionCloseAltKeyFrames)                       \
     F(sAttentionSwingKeyFrames)                       \
-    F(D_8011D954)                       \
+    F(sAttentionDoorKeyFrames)                       \
     F(D_8011D9F4)                       \
     F(depthPhase)                       \
     F(screenPlanePhase)                 \
diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index 16b61d885..4a9f54a4a 100644
--- a/soh/src/code/z_camera_data.inc
+++ b/soh/src/code/z_camera_data.inc
@@ -2378,7 +2378,8 @@ static OnePointCsFull sAttentionSwingKeyFrames[] = {  // was D_8011D8DC [LLM:HIG
 };
 
 // target is a door.
-static OnePointCsFull D_8011D954[] = {
+// LLM generated name (HIGH), was D_8011D954: the keyframes used when the target is a door
+static OnePointCsFull sAttentionDoorKeyFrames[] = {  // was D_8011D954 [LLM:HIGH]
     { 0x0F, 0xFF, 0xC1C1, 0x0014, 0x0000, 60.0f, 1.0f, { 0.0f, 0.0f, 50.0f }, { 0.0f, 0.0f, 250.0f } },
     { 0x83, 0xFF, 0x05B1, 0x0005, 0x0000, 60.0f, 0.1f, { 0.0f, 10.0f, 50.0f }, { 0.0f, 10.0f, 100.0f } },
     { 0x82, 0xFF, 0x2121, 0x0005, 0x0002, 60.0f, 1.0f, { 0.0f, 10.0f, 0.0f }, { 0.0f, 20.0f, -150.0f } },
