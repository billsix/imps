Subject: [PATCH 485/784] soh: rename func_80AEF820 -> EnRu1_KeepArmsDown

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.86.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 6aa80a91f..c51bdfdac 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -2079,7 +2079,8 @@ void EnRu1_BringHandsDown(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEF820(EnRu1* this, UNK_TYPE arg1) {
+// Name from zeldaret/oot (was func_80AEF820): adopted upstream's name for this address; body verified to match upstream at 0.86. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_KeepArmsDown(EnRu1* this, UNK_TYPE arg1) {
     if (arg1 != 0) {
         Animation_Change(&this->skelAnime, &gRutoChildWait2Anim, 1.0f, 0, Animation_GetLastFrame(&gRutoChildWait2Anim),
                          ANIMMODE_LOOP, -8.0f);
@@ -2156,7 +2157,7 @@ void func_80AEFB04(EnRu1* this, PlayState* play) {
     EnRu1_UpdateBgCheckInfo(this, play);
     something = EnRu1_UpdateSkelAnime(this);
     EnRu1_UpdateEyes(this);
-    func_80AEF820(this, something);
+    EnRu1_KeepArmsDown(this, something);
     func_80AEB220(this, play);
 }
 
