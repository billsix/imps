From 875c937382f26d21f2b4c10c9b8bd88aa31532a2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:17 +0000
Subject: [PATCH 1475/3799] soh: rename D_80B243C0 -> sFlameColors

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: prim and env colour pairs indexed by params, giving Kotake's flame its own colours and Koume's another pair; the in-tree comment notes it is flattened to one dimension only to match.
Defined in soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
index 3935c7a18..658746dcd 100644
--- a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
+++ b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
@@ -75,7 +75,8 @@ static f32 sFlameXOffsets[] = { 0.0f, 20.0f, -30.0f, 20.0f, -20.0f, -20.0f, 30.0
 static f32 sFlameYOffsets[] = { 0.0f, 30.0f, 0.0f, -30.0f, 30.0f, -30.0f, 0.0f };  // was D_80B243A4 [LLM:HIGH]
 
 // Has to be 1-dimensional to match
-static Color_RGBA8 D_80B243C0[4] = {
+// LLM generated name (HIGH), was D_80B243C0: prim and env colour pairs indexed by params, giving Kotake's flame its own colours and Koume's another pair; the in-tree comment notes it is flattened to one dimension only to match.
+static Color_RGBA8 sFlameColors[4] = {  // was D_80B243C0 [LLM:HIGH]
     { 255, 200, 0, 255 },
     { 255, 0, 0, 255 },
     { 255, 255, 255, 255 },
@@ -234,8 +235,8 @@ void func_80B23254(EnTr* this, PlayState* play, s32 arg2, f32 arg3, f32 scale) {
     velocity.z = Math_CosS(reversePitch) * (arg3 * sp3C);
     accel.y = 0.5f;
 
-    primColor = &D_80B243C0[2 * this->actor.params];
-    envColor = &D_80B243C0[2 * this->actor.params + 1];
+    primColor = &sFlameColors[2 * this->actor.params];  // was D_80B243C0 [LLM:HIGH]
+    envColor = &sFlameColors[2 * this->actor.params + 1];  // was D_80B243C0 [LLM:HIGH]
 
     sp58 = this->actor.world.pos;
     sp58.x -= velocity.x * 10.0f;
