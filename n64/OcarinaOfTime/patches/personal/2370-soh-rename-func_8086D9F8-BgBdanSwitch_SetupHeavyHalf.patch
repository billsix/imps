-        func_8086D9F8(this);
+        BgBdanSwitch_SetupHeavyHalfPressed(this);  // was func_8086D9F8 [LLM:HIGH]
         Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_FOOT_SWITCH);
         Rumble_Request(this->dyna.actor.xyzDistToPlayerSq, 0x78, 0x14, 0xA);
     }
@@ -378,7 +379,7 @@ void BgBdanSwitch_HeavyFullPress(BgBdanSwitch* this, PlayState* play) {
     }
 }
 
-void func_8086D9F8(BgBdanSwitch* this) {
+void BgBdanSwitch_SetupHeavyHalfPressed(BgBdanSwitch* this) {
