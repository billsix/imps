From 90652de05dc48ed94e07a89691eaf138c390fdef Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:47 +0000
Subject: [PATCH 0846/3799] soh: rename D_80B28998 ->
 sBariCoreInvertTexCombinerDL

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c.
---
 soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c b/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c
index b7187a490..2ee085520 100644
--- a/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c
+++ b/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c
@@ -773,7 +773,8 @@ void EnVali_DrawBody(EnVali* this, PlayState* play) {
     CLOSE_DISPS(play->state.gfxCtx);
 }
 
-static Gfx D_80B28998[] = {
+// Name from zeldaret/oot (was D_80B28998): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Vali/z_en_vali.c]
+static Gfx sBariCoreInvertTexCombinerDL[] = {
     gsDPSetCombineLERP(1, TEXEL0, SHADE, 0, TEXEL0, 0, PRIMITIVE, 0, COMBINED, 0, PRIMITIVE, 0, TEXEL1, 0,
                        PRIM_LOD_FRAC, COMBINED),
     gsSPEndDisplayList(),
@@ -796,7 +797,7 @@ void EnVali_Draw(Actor* thisx, PlayState* play) {
                Gfx_TexScrollEx(play->state.gfxCtx, 0, (127 - (play->gameplayFrames * 12)) % 128, 32, 32, 0, -12));
 
     if ((this->lightningTimer % 2) != 0) {
-        gSPSegment(POLY_XLU_DISP++, 0x09, D_80B28998);
+        gSPSegment(POLY_XLU_DISP++, 0x09, sBariCoreInvertTexCombinerDL);
     } else {
         gSPSegment(POLY_XLU_DISP++, 0x09, D_80B289A8);
     }
