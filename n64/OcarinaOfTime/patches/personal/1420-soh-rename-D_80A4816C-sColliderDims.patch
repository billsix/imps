From db1d7301f13dee47223fd56e6782405ebcefad1d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:18:19 +0000
Subject: [PATCH 1420/3799] soh: rename D_80A4816C -> sColliderDims

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-Goron-variant collider radius, height and the XZ and Y offsets its collider sits at relative to the actor.
Defined in soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c | 25 ++++++++++---------
 1 file changed, 13 insertions(+), 12 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
index 89f5759bf..669461d00 100644
--- a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
+++ b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
@@ -110,7 +110,8 @@ const ActorInit En_Go2_InitVars = {
     NULL,
 };
 
-static EnGo2DataStruct1 D_80A4816C[14] = {
+// LLM generated name (HIGH), was D_80A4816C: per-Goron-variant collider radius, height and the XZ and Y offsets its collider sits at relative to the actor.
+static EnGo2DataStruct1 sColliderDims[14] = {  // was D_80A4816C [LLM:HIGH]
     { 0, 0, 0, 68, 148 }, { 0, 0, 0, 24, 52 }, { 0, 320, 380, 400, 120 }, { 0, 0, 0, 30, 68 }, { 0, 0, 0, 46, 90 },
     { 0, 0, 0, 30, 68 },  { 0, 0, 0, 30, 68 }, { 0, 0, 0, 30, 68 },       { 0, 0, 0, 30, 68 }, { 0, 0, 0, 30, 68 },
     { 0, 0, 0, 30, 68 },  { 0, 0, 0, 30, 68 }, { 0, 0, 0, 30, 68 },       { 0, 0, 0, 30, 68 },
@@ -844,8 +845,8 @@ s32 func_80A44790(EnGo2* this, PlayState* play) {
 void EnGo2_SetColliderDim(EnGo2* this) {
     u8 index = this->actor.params & 0x1F;
 
-    this->collider.dim.radius = D_80A4816C[index].radius;
-    this->collider.dim.height = D_80A4816C[index].height;
+    this->collider.dim.radius = sColliderDims[index].radius;  // was D_80A4816C [LLM:HIGH]
+    this->collider.dim.height = sColliderDims[index].height;  // was D_80A4816C [LLM:HIGH]
 }
 
 void EnGo2_SetShape(EnGo2* this) {
@@ -865,10 +866,10 @@ void EnGo2_CheckCollision(EnGo2* this, PlayState* play) {
     pos.x = this->actor.world.pos.x;
     pos.y = this->actor.world.pos.y;
     pos.z = this->actor.world.pos.z;
-    xzDist = D_80A4816C[this->actor.params & 0x1F].xzDist;
+    xzDist = sColliderDims[this->actor.params & 0x1F].xzDist;  // was D_80A4816C [LLM:HIGH]
     pos.x += (s16)(xzDist * Math_SinS(this->actor.shape.rot.y));
     pos.z += (s16)(xzDist * Math_CosS(this->actor.shape.rot.y));
-    pos.y += D_80A4816C[this->actor.params & 0x1F].yDist;
+    pos.y += sColliderDims[this->actor.params & 0x1F].yDist;  // was D_80A4816C [LLM:HIGH]
     this->collider.dim.pos = pos;
     CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
     CollisionCheck_SetAC(play, &play->colChkCtx, &this->collider.base);
@@ -1597,14 +1598,14 @@ void EnGo2_Init(Actor* thisx, PlayState* play) {
                 }
             } else {
                 Flags_UnsetInfTable(INFTABLE_STOPPED_GORON_LINKS_ROLLING);
-                this->collider.dim.height = (D_80A4816C[this->actor.params & 0x1F].height * 0.6f);
+                this->collider.dim.height = (sColliderDims[this->actor.params & 0x1F].height * 0.6f);  // was D_80A4816C [LLM:HIGH]
                 EnGo2_SetupRolling(this, play);
                 this->isAwake = true;
             }
             break;
         case GORON_CITY_ROLLING_BIG:
         case GORON_DMT_ROLLING_SMALL:
-            this->collider.dim.height = (D_80A4816C[this->actor.params & 0x1F].height * 0.6f);
+            this->collider.dim.height = (sColliderDims[this->actor.params & 0x1F].height * 0.6f);  // was D_80A4816C [LLM:HIGH]
             EnGo2_SetupRolling(this, play);
             break;
         case GORON_FIRE_GENERIC:
@@ -1659,11 +1660,11 @@ void EnGo2_CurledUp(EnGo2* this, PlayState* play) {
     }
 
     if ((s32)this->skelAnime.curFrame == 0) {
-        this->collider.dim.height = (D_80A4816C[index].height * 0.6f);
+        this->collider.dim.height = (sColliderDims[index].height * 0.6f);  // was D_80A4816C [LLM:HIGH]
     } else {
-        height = D_80A4816C[index].height;
+        height = sColliderDims[index].height;  // was D_80A4816C [LLM:HIGH]
         this->collider.dim.height =
-            ((D_80A4816C[index].height * 0.4f * (this->skelAnime.curFrame / this->skelAnime.startFrame)) +
+            ((sColliderDims[index].height * 0.4f * (this->skelAnime.curFrame / this->skelAnime.startFrame)) +  // was D_80A4816C [LLM:HIGH]
              (height * 0.6f));
     }
     if (EnGo2_IsFreeingGoronInFire(this, play)) {
@@ -1698,9 +1699,9 @@ void func_80A46B40(EnGo2* this, PlayState* play) {
             }
             func_80A454CC(this);
             this->unk_211 = true;
-            this->collider.dim.height = D_80A4816C[index].height;
+            this->collider.dim.height = sColliderDims[index].height;  // was D_80A4816C [LLM:HIGH]
         } else {
-            height = D_80A4816C[index].height;
+            height = sColliderDims[index].height;  // was D_80A4816C [LLM:HIGH]
             this->collider.dim.height =
                 (s16)((height * 0.4f * (this->skelAnime.curFrame / this->skelAnime.endFrame)) + (height * 0.6f));
         }
