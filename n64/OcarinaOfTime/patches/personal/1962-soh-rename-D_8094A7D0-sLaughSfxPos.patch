From eb525c8ded45d87ade470227c1b770800d86c163 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:06:35 +0000
Subject: [PATCH 1962/3799] soh: rename D_8094A7D0 -> sLaughSfxPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: its only use is as the position argument for NA_SE_EN_TWINROBA_LAUGH and LAUGH2
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index be48d7b99..53d414987 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -96,7 +96,8 @@ const ActorInit Boss_Tw_InitVars = {
     (ActorResetFunc)BossTw_Reset,
 };
 
-static Vec3f D_8094A7D0 = { 0.0f, 0.0f, 1000.0f };
+// LLM generated name (HIGH), was D_8094A7D0: its only use is as the position argument for NA_SE_EN_TWINROBA_LAUGH and LAUGH2
+static Vec3f sLaughSfxPos = { 0.0f, 0.0f, 1000.0f };  // was D_8094A7D0 [LLM:HIGH]
 static Vec3f sZeroVector = { 0.0f, 0.0f, 0.0f };
 
 static ColliderCylinderInit sCylinderInitBlasts = {
@@ -1760,8 +1761,8 @@ void BossTw_TwinrovaIntroCS(BossTw* this, PlayState* play) {
     }
 
     if (this->csSfxTimer == 180) {
-        Sfx_PlaySfxAtPos(&D_8094A7D0, NA_SE_EN_TWINROBA_LAUGH);
-        Sfx_PlaySfxAtPos(&D_8094A7D0, NA_SE_EN_TWINROBA_LAUGH2);
+        Sfx_PlaySfxAtPos(&sLaughSfxPos, NA_SE_EN_TWINROBA_LAUGH);  // was D_8094A7D0 [LLM:HIGH]
+        Sfx_PlaySfxAtPos(&sLaughSfxPos, NA_SE_EN_TWINROBA_LAUGH2);  // was D_8094A7D0 [LLM:HIGH]
         Audio_QueueSeqCmd(SEQ_PLAYER_BGM_MAIN << 24 | NA_BGM_KOTAKE_KOUME);
     }
 
