From f5d22c2a663071319a51e134c49bdf3382fe9514 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:15:30 +0000
Subject: [PATCH 3358/3799] soh: rename D_8015FDB0 -> sSandstormScroll

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the sandstorm texture scroll, advanced each frame and multiplied by three different rates for its layers
Defined in soh/src/code/z_kankyo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_kankyo.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_kankyo.c b/soh/src/code/z_kankyo.c
index 3789f3b5b..82f2aa538 100644
--- a/soh/src/code/z_kankyo.c
+++ b/soh/src/code/z_kankyo.c
@@ -230,7 +230,8 @@ LightInfo sNGameOverLightInfo;
 LightNode* sSGameOverLightNode;
 LightInfo sSGameOverLightInfo;
 u8 sGameOverLightsIntensity;
-u16 D_8015FDB0;
+// LLM generated name (HIGH), was D_8015FDB0: the sandstorm texture scroll, advanced each frame and multiplied by three different rates for its layers
+u16 sSandstormScroll;  // was D_8015FDB0 [LLM:HIGH]
 
 void LoadSkyboxPalette(SkyboxContext* skyboxCtx, int paletteIndex, char* palTex, int width, int height);
 void LoadSkyboxTex(SkyboxContext* skyboxCtx, int segmentIndex, int imageIndex, char* tex, int width, int height,
@@ -2433,9 +2434,9 @@ void Environment_DrawSandstorm(PlayState* play, u8 sandstormState) {
     envColor.g = ((envColor.g * sp98) + ((6.0f - sp98) * primColor.g)) * (1.0f / 6.0f);
     envColor.b = ((envColor.b * sp98) + ((6.0f - sp98) * primColor.b)) * (1.0f / 6.0f);
 
-    sp96 = (s32)(D_8015FDB0 * (11.0f / 6.0f));
-    sp94 = (s32)(D_8015FDB0 * (9.0f / 6.0f));
-    sp92 = (s32)(D_8015FDB0 * (6.0f / 6.0f));
+    sp96 = (s32)(sSandstormScroll * (11.0f / 6.0f));  // was D_8015FDB0 [LLM:HIGH]
+    sp94 = (s32)(sSandstormScroll * (9.0f / 6.0f));  // was D_8015FDB0 [LLM:HIGH]
+    sp92 = (s32)(sSandstormScroll * (6.0f / 6.0f));  // was D_8015FDB0 [LLM:HIGH]
 
     OPEN_DISPS(play->state.gfxCtx);
 
@@ -2452,7 +2453,7 @@ void Environment_DrawSandstorm(PlayState* play, u8 sandstormState) {
     gSPDisplayList(POLY_XLU_DISP++, gFieldSandstormDL);
     CLOSE_DISPS(play->state.gfxCtx);
 
-    D_8015FDB0 += (s32)sp98;
+    sSandstormScroll += (s32)sp98;  // was D_8015FDB0 [LLM:HIGH]
 }
 
 void Environment_AdjustLights(PlayState* play, f32 arg1, f32 arg2, f32 arg3, f32 arg4) {
-- 
