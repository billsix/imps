From b9a83ee1a75453db5f7ddef0ce62ed8e623a09a7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:32:04 +0000
Subject: [PATCH 1637/3799] soh: rename func_8096F4FC -> DemoEc_SetupUpdate20

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loads the animation object, starts gDemoEcAnim_008D1C and switches to update mode EC_UPDATE_20.
Defined in soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c b/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c
index 18b4a6f15..de7fecd7f 100644
--- a/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c
+++ b/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c
@@ -889,7 +889,8 @@ void DemoEc_InitMido(DemoEc* this, PlayState* play) {
     DemoEc_SetEyeTexIndex(this, 3);
 }
 
-void func_8096F4FC(DemoEc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_8096F4FC: loads the animation object, starts gDemoEcAnim_008D1C and switches to update mode EC_UPDATE_20.
+void DemoEc_SetupUpdate20(DemoEc* this, PlayState* play) {
     DemoEc_UseAnimationObject(this, play);
     DemoEc_ChangeAnimation(this, &gDemoEcAnim_008D1C, 2, -8.0f, false);
     this->updateMode = EC_UPDATE_20;
@@ -911,7 +912,7 @@ void func_8096F578(DemoEc* this, PlayState* play, s32 arg2) {
         if ((sp18 != this->npcAction)) {
             if (this->npcAction) {}
             if (sp18 == 2) {
-                func_8096F4FC(this, play);
+                DemoEc_SetupUpdate20(this, play);  // was func_8096F4FC [LLM:HIGH]
             }
             this->npcAction = sp18;
         }
