Date: Mon, 7 Sep 2026 15:02:44 +0000
Subject: [PATCH 429/784] soh: rename func_80AEBC84 -> EnRu1_PlayGiggleSfx

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.94.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 95b1dcd9b..8a9fcfb0a 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -617,7 +617,8 @@ void func_80AEBC30(PlayState* play) {
     }
 }
 
-void func_80AEBC84(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEBC84): adopted upstream's name for this address; body verified to match upstream at 0.94. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_PlayGiggleSfx(EnRu1* this, PlayState* play) {
     if (play->csCtx.frames == 0x82) {
         Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_VO_RT_LAUGH_0);
     }
@@ -719,7 +720,7 @@ void func_80AEC070(EnRu1* this, PlayState* play, UNK_TYPE arg2) {
 void func_80AEC0B4(EnRu1* this, PlayState* play) {
     func_80AEB89C(this, play);
     EnRu1_UpdateSkelAnime(this);
-    func_80AEBC84(this, play);
+    EnRu1_PlayGiggleSfx(this, play);
     func_80AEBC30(play);
     func_80AEBD1C(this, play);
 }
