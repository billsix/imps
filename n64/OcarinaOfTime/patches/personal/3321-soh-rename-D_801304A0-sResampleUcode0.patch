From b498baacd929eb754e2eb2f1d64fc96baef297bb Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:29 +0000
Subject: [PATCH 3321/3799] soh: rename D_801304A0 -> sResampleUcode0

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: one of four u32 words AudioSynth_FinalResample selects between; they read as packed RSP command words, which the body does not confirm
Defined in soh/src/code/audio_synthesis.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_synthesis.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_synthesis.c b/soh/src/code/audio_synthesis.c
index b577bd29d..f6665532b 100644
--- a/soh/src/code/audio_synthesis.c
+++ b/soh/src/code/audio_synthesis.c
@@ -31,7 +31,8 @@ Acmd* AudioSynth_ProcessEnvelope(Acmd* cmd, NoteSubEu* noteSubEu, NoteSynthesisS
 Acmd* AudioSynth_FinalResample(Acmd* cmd, NoteSynthesisState* synthState, s32 count, u16 pitch, u16 inpDmem,
                                s32 resampleFlags);
 
-u32 D_801304A0 = 0x13000000;
+// LLM generated name (GUESS), was D_801304A0: one of four u32 words AudioSynth_FinalResample selects between; they read as packed RSP command words, which the body does not confirm
+u32 sResampleUcode0 = 0x13000000;  // was D_801304A0 [LLM:GUESS]
 u32 D_801304A4 = 0x5CAEC8E2;
 u32 D_801304A8 = 0x945CC8E2;
 u32 D_801304AC = 0x94AEC8E2;
@@ -1202,7 +1203,7 @@ Acmd* AudioSynth_ProcessEnvelope(Acmd* cmd, NoteSubEu* noteSubEu, NoteSynthesisS
 
     aEnvMixer(cmd++, inBuf, aiBufLen, (sourceReverbVol & 0x80) >> 7, noteSubEu->bitField0.stereoHeadsetEffects,
               noteSubEu->bitField0.usesHeadsetPanEffects, noteSubEu->bitField0.stereoStrongRight,
-              noteSubEu->bitField0.stereoStrongLeft, phi_a1, D_801304A0);
+              noteSubEu->bitField0.stereoStrongLeft, phi_a1, sResampleUcode0);  // was D_801304A0 [LLM:GUESS]
     return cmd;
 }
 
