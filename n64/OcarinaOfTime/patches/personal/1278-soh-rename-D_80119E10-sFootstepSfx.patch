From d4722f049a1d9675ddea2ffd3c42452ee9e2c857 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:07:18 +0000
Subject: [PATCH 1278/3799] soh: rename D_80119E10 -> sFootstepSfx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment above it reads "SurfaceType_GetSfx"; it maps a surface material index to the matching NA_SE_PL_WALK_* sound.
Defined in soh/src/code/z_bgcheck.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_bgcheck.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_bgcheck.c b/soh/src/code/z_bgcheck.c
index 2b8ecfd2f..995bc954d 100644
--- a/soh/src/code/z_bgcheck.c
+++ b/soh/src/code/z_bgcheck.c
@@ -43,7 +43,8 @@ s32 sWallFlags[WALL_TYPE_MAX] = {  // was D_80119D90 [LLM:HIGH]
 };
 
 // SurfaceType_GetSfx
-u16 D_80119E10[14] = {
+// LLM generated name (HIGH), was D_80119E10: the in-tree comment above it reads "SurfaceType_GetSfx"; it maps a surface material index to the matching NA_SE_PL_WALK_* sound.
+u16 sFootstepSfx[14] = {  // was D_80119E10 [LLM:HIGH]
     NA_SE_PL_WALK_GROUND - SFX_FLAG, NA_SE_PL_WALK_SAND - SFX_FLAG,   NA_SE_PL_WALK_CONCRETE - SFX_FLAG,
     NA_SE_PL_WALK_DIRT - SFX_FLAG,   NA_SE_PL_WALK_WATER0 - SFX_FLAG, NA_SE_PL_WALK_WATER1 - SFX_FLAG,
     NA_SE_PL_WALK_WATER2 - SFX_FLAG, NA_SE_PL_WALK_MAGMA - SFX_FLAG,  NA_SE_PL_WALK_GRASS - SFX_FLAG,
@@ -4110,7 +4111,7 @@ u16 SurfaceType_GetSfx(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId)
     if (id < 0 || id > 13) {
         return NA_SE_PL_WALK_GROUND - SFX_FLAG;
     }
-    return D_80119E10[id];
+    return sFootstepSfx[id];  // was D_80119E10 [LLM:HIGH]
 }
 
