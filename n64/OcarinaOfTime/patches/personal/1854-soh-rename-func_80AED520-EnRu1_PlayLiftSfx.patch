From 94c582d1750d1c922c7353298416c1a5ead35b17 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:48:27 +0000
Subject: [PATCH 1854/3799] soh: rename func_80AED520 -> EnRu1_PlayLiftSfx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays the pull-up sfx and Ruto's lifted voice clip when Link picks her up.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 39aca3b13..b8b108d50 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1335,7 +1335,8 @@ void EnRu1_PlayHittingSurfaceSfx(EnRu1* this) {
     Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_EV_LAND_DIRT);
 }
 
-void func_80AED520(EnRu1* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AED520: plays the pull-up sfx and Ruto's lifted voice clip when Link picks her up.
+void EnRu1_PlayLiftSfx(EnRu1* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
 
     Audio_PlaySfxGeneral(NA_SE_PL_PULL_UP_RUTO, &player->actor.projectedPos, 4, &gSfxDefaultFreqAndVolScale,
@@ -1720,7 +1721,7 @@ void EnRu1_UpdateSittingAction(EnRu1* this, PlayState* play) {
         curRoomNum = play->roomCtx.curRoom.num;
         this->roomNum3 = curRoomNum;
         this->action = 31;
-        func_80AED520(this, play);
+        EnRu1_PlayLiftSfx(this, play);  // was func_80AED520 [LLM:HIGH]
     } else if ((!EnRu1_IsOnSapphirePlatform(this, play)) && (!(this->actor.bgCheckFlags & BGCHECKFLAG_GROUND))) {
         this->actor.minVelocityY = -((kREG(24) * 0.01f) + 6.8f);
         this->actor.gravity = -((kREG(23) * 0.01f) + 1.3f);
-- 
