From 32891f5b48db710d2f081c221489ea4a9e1ce8e2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:08:50 +0000
Subject: [PATCH 2013/3799] soh: rename D_80897518 -> sShadowBaseRowAlphas

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: minimum alpha for each of the four shadow rows that form the pedestal bar
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
index e1b6fbd3c..45685e773 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
@@ -105,7 +105,8 @@ static Vec3f sShadowBaseOutline[] = {  // was D_808974DC [LLM:HIGH]
     { -30.0f, 21.300001f, -2.5f }, { 12.0f, 21.300001f, -2.5f },
 };
 
-static s32 D_80897518[] = { 0x80, 0xA0, 0xA0, 0x80 };
+// LLM generated name (HIGH), was D_80897518: minimum alpha for each of the four shadow rows that form the pedestal bar
+static s32 sShadowBaseRowAlphas[] = { 0x80, 0xA0, 0xA0, 0x80 };  // was D_80897518 [LLM:HIGH]
 
 static InitChainEntry sInitChain[] = {
     ICHAIN_VEC3F_DIV1000(scale, 100, ICHAIN_CONTINUE),
@@ -403,8 +404,8 @@ void BgJyaCobra_UpdateShadowFromTop(BgJyaCobra* this) {
     for (i_copy = 0x780, counter = 0; counter < 4; counter++, i_copy += 0x40) {
         i = i_copy;
         for (j = 4; j < 0x3C; j++) {
-            if (shadowTex[i_copy + j] < D_80897518[counter]) {
-                shadowTex[i_copy + j] = D_80897518[counter];
+            if (shadowTex[i_copy + j] < sShadowBaseRowAlphas[counter]) {  // was D_80897518 [LLM:HIGH]
+                shadowTex[i_copy + j] = sShadowBaseRowAlphas[counter];  // was D_80897518 [LLM:HIGH]
             }
         }
         shadowTex[i + 0x3C] = 0x20;
-- 
