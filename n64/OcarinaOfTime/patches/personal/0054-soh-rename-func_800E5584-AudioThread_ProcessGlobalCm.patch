From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:46 +0000
Subject: [PATCH 054/225] soh: rename func_800E5584 ->
 AudioThread_ProcessGlobalCmd

Name source: zeldaret/oot.
Defined in soh/src/code/audio_thread.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_thread.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_thread.c b/soh/src/code/audio_thread.c
index 04d8a3d56..87ba3dd29 100644
--- a/soh/src/code/audio_thread.c
+++ b/soh/src/code/audio_thread.c
@@ -239,7 +239,9 @@ AudioTask* AudioThread_UpdateImpl(void) {
 #define ACMD_SND_MDE ((u32)0xF0000000)
 #define ACMD_MUTE ((u32)0xF1000000)
 
-void func_800E5584(AudioCmd* cmd) {
+// Name from zeldaret/oot, was func_800E5584: handles global AudioCmds (sound mode, fade timers, reset) [oot: https://github.com/zeldaret/oot/blob/main/src/audio/internal/thread.c]
+// drained from cmd queue
+void AudioThread_ProcessGlobalCmd(AudioCmd* cmd) {
     s32 i;
     s32 pad;
     s32 pad2;
@@ -455,14 +457,14 @@ void Audio_ProcessCmd(AudioCmd* cmd) {
     s32 i;
 
     if ((cmd->op & 0xF0) == 0xF0) {
-        func_800E5584(cmd);
+        AudioThread_ProcessGlobalCmd(cmd);
         return;
     }
 
     if (cmd->arg0 < gAudioContext.audioBufferParameters.numSequencePlayers) {
         seqPlayer = &gAudioContext.seqPlayers[cmd->arg0];
         if (cmd->op & 0x80) {
-            func_800E5584(cmd);
+            AudioThread_ProcessGlobalCmd(cmd);
             return;
         }
         if (cmd->op & 0x40) {
