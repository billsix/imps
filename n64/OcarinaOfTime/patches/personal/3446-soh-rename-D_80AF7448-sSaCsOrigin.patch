From 3356156524322c716a3bd8cb09699cd3babad94c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:11 +0000
Subject: [PATCH 3446/3799] soh: rename D_80AF7448 -> sSaCsOrigin

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the zero vector EnSa_HandleCutscene transforms
Defined in soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
index 18218d8f1..b1e2d1c1f 100644
--- a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
+++ b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
@@ -665,7 +665,7 @@ void EnSa_HandleCutscene(EnSa* this, PlayState* play) {
     s16 phi_v0;
     Vec3f startPos;
     Vec3f endPos;
-    Vec3f D_80AF7448 = { 0.0f, 0.0f, 0.0f };
+    Vec3f sSaCsOrigin = { 0.0f, 0.0f, 0.0f };  // was D_80AF7448 [LLM:HIGH]
     CsCmdActorCue* csAction;
     f32 temp_f0;
     f32 gravity;
@@ -714,7 +714,7 @@ void EnSa_HandleCutscene(EnSa* this, PlayState* play) {
         this->actor.shape.rot.x = csAction->urot.x;
         this->actor.shape.rot.y = csAction->urot.y;
         this->actor.shape.rot.z = csAction->urot.z;
-        this->actor.velocity = D_80AF7448;
+        this->actor.velocity = sSaCsOrigin;  // was D_80AF7448 [LLM:HIGH]
 
         if (play->csCtx.frames < csAction->endFrame) {
             temp_f0 = csAction->endFrame - csAction->startFrame;
