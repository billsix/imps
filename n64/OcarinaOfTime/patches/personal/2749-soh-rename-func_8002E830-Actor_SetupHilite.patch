From 175025587bd75c65245b8ff25e09a8612ac9385e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:32 +0000
Subject: [PATCH 2749/3799] soh: rename func_8002E830 -> Actor_SetupHilite

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: allocates the LookAt and Hilite for a specular highlight and writes them into the caller's display list
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 39fb4006f..2ba35b4c0 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -1767,7 +1767,8 @@ void Actor_UpdateBgCheckInfo(PlayState* play, Actor* actor, f32 wallCheckHeight,
 
 Mtx D_8015BBA8;
 
-Gfx* func_8002E830(Vec3f* object, Vec3f* eye, Vec3f* lightDir, GraphicsContext* gfxCtx, Gfx* gfx, Hilite** hilite) {
+// LLM generated name (HIGH), was func_8002E830: allocates the LookAt and Hilite for a specular highlight and writes them into the caller's display list
+Gfx* Actor_SetupHilite(Vec3f* object, Vec3f* eye, Vec3f* lightDir, GraphicsContext* gfxCtx, Gfx* gfx, Hilite** hilite) {
     LookAt* lookAt;
     f32 correctedEyeX;
 
@@ -1798,7 +1799,7 @@ Hilite* func_8002EABC(Vec3f* object, Vec3f* eye, Vec3f* lightDir, GraphicsContex
 
     OPEN_DISPS(gfxCtx);
 
-    POLY_OPA_DISP = func_8002E830(object, eye, lightDir, gfxCtx, POLY_OPA_DISP, &hilite);
+    POLY_OPA_DISP = Actor_SetupHilite(object, eye, lightDir, gfxCtx, POLY_OPA_DISP, &hilite);  // was func_8002E830 [LLM:HIGH]
 
     CLOSE_DISPS(gfxCtx);
 
@@ -1810,7 +1811,7 @@ Hilite* func_8002EB44(Vec3f* object, Vec3f* eye, Vec3f* lightDir, GraphicsContex
 
     OPEN_DISPS(gfxCtx);
 
-    POLY_XLU_DISP = func_8002E830(object, eye, lightDir, gfxCtx, POLY_XLU_DISP, &hilite);
+    POLY_XLU_DISP = Actor_SetupHilite(object, eye, lightDir, gfxCtx, POLY_XLU_DISP, &hilite);  // was func_8002E830 [LLM:HIGH]
 
     CLOSE_DISPS(gfxCtx);
 
