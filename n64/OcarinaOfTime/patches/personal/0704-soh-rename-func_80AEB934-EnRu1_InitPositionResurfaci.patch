Subject: [PATCH 704/784] soh: rename func_80AEB934 ->
 EnRu1_InitPositionResurfacing

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index a6d620bb7..57c189f09 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -582,7 +582,8 @@ void EnRu1_InitPositionDivingIntoFountain(EnRu1* this, PlayState* play) {
     func_80AEB89C(this, play);
 }
 
-void func_80AEB934(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEB934): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_InitPositionResurfacing(EnRu1* this, PlayState* play) {
     func_80AEB89C(this, play);
 }
 
@@ -702,7 +703,7 @@ void func_80AEBD94(EnRu1* this, PlayState* play) {
 
     if (EnRu1_CheckFountainCueNotMatchingId(play, 3)) {
         frameCount = Animation_GetLastFrame(&gRutoChildAnim_009060);
-        func_80AEB934(this, play);
+        EnRu1_InitPositionResurfacing(this, play);
         EnRu1_MoveInWater(this, play);
         Animation_Change(&this->skelAnime, &gRutoChildAnim_009060, 1.0f, 0.0f, frameCount, ANIMMODE_ONCE, 0.0f);
         this->action = 2;
