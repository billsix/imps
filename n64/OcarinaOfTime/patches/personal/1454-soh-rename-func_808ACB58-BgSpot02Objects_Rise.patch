Subject: [PATCH 1454/3799] soh: rename func_808ACB58 -> BgSpot02Objects_Rise

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: raises the block 255 units above home with the wall-moving sfx, ending on the stone-door stop sfx.
Defined in soh/src/overlays/actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c     | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c b/soh/src/overlays/actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c
index 85084a7c2..d81099082 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot02_Objects/z_bg_spot02_objects.c
@@ -25,7 +25,8 @@ void BgSpot02Objects_WaitForExplosion(BgSpot02Objects* this, PlayState* play);
 void BgSpot02Objects_Explode(BgSpot02Objects* this, PlayState* play);  // was func_808ACA08 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808ACAFC: waits for the switch flag, then aims the attention camera and starts raising the block.
 void BgSpot02Objects_WaitForSwitch(BgSpot02Objects* this, PlayState* play);  // was func_808ACAFC [LLM:HIGH]
-void func_808ACB58(BgSpot02Objects* this, PlayState* play);
+// LLM generated name (HIGH), was func_808ACB58: raises the block 255 units above home with the wall-moving sfx, ending on the stone-door stop sfx.
+void BgSpot02Objects_Rise(BgSpot02Objects* this, PlayState* play);  // was func_808ACB58 [LLM:HIGH]
 void func_808ACC34(BgSpot02Objects* this, PlayState* play);
 void func_808AD3D4(BgSpot02Objects* this, PlayState* play);
 
@@ -182,11 +183,11 @@ void BgSpot02Objects_WaitForSwitch(BgSpot02Objects* this, PlayState* play) {
     if (Flags_GetSwitch(play, this->unk_16B)) {
         Actor_SetFocus(&this->dyna.actor, 60.0f);
         OnePointCutscene_Attention(play, &this->dyna.actor);
-        this->actionFunc = func_808ACB58;
+        this->actionFunc = BgSpot02Objects_Rise;  // was func_808ACB58 [LLM:HIGH]
     }
 }
 
-void func_808ACB58(BgSpot02Objects* this, PlayState* play) {
+void BgSpot02Objects_Rise(BgSpot02Objects* this, PlayState* play) {
     if (Math_StepToF(&this->dyna.actor.world.pos.y, this->dyna.actor.home.pos.y + 255.0f, 1.0f)) {
         Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_STONEDOOR_STOP);
         this->actionFunc = BgSpot02Objects_DoNothing;  // was func_808AC8FC [LLM:HIGH]
