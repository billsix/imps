From 7530e9ba35164dd0c92f6832732aabe01f68264c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:26:57 +0000
Subject: [PATCH 1564/3799] soh: rename func_80A2FB40 -> EnGb_OfferBottle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: once the reward line is advanced it offers GI_BOTTLE.
Defined in soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/soh/Enhancements/randomizer/BigPoes.cpp | 2 +-
 soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c | 7 ++++---
 soh/src/overlays/actors/ovl_En_Gb/z_en_gb.h | 2 +-
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/soh/Enhancements/randomizer/BigPoes.cpp b/soh/soh/Enhancements/randomizer/BigPoes.cpp
index a9d497af8..149b65a55 100644
--- a/soh/soh/Enhancements/randomizer/BigPoes.cpp
+++ b/soh/soh/Enhancements/randomizer/BigPoes.cpp
@@ -34,7 +34,7 @@ void RegisterBigPoeHooks() {
             EnGb* enGb = va_arg(args, EnGb*);
             enGb->textId = 0x70F8;
             Message_ContinueTextbox(gPlayState, enGb->textId);
-            enGb->actionFunc = func_80A2FB40;
+            enGb->actionFunc = EnGb_OfferBottle;  // was func_80A2FB40 [LLM:HIGH]
             *should = false;
         }
     });
diff --git a/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c b/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
index 281322743..af4bae8df 100644
--- a/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
+++ b/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
@@ -25,7 +25,8 @@ void EnGb_BuyBigPoe(EnGb* this, PlayState* play);  // was func_80A2FA50 [LLM:HIG
 void EnGb_BuyPoe(EnGb* this, PlayState* play);  // was func_80A2F9C0 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80A2F94C: waits out the plain greeting, records that the player has spoken to him and returns to the idle.
 void EnGb_Talk(EnGb* this, PlayState* play);  // was func_80A2F94C [LLM:HIGH]
-void func_80A2FB40(EnGb* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A2FB40: once the reward line is advanced it offers GI_BOTTLE.
+void EnGb_OfferBottle(EnGb* this, PlayState* play);  // was func_80A2FB40 [LLM:HIGH]
 void func_80A2FBB0(EnGb* this, PlayState* play);
 void func_80A2FC0C(EnGb* this, PlayState* play);
 
@@ -357,12 +358,12 @@ void EnGb_BuyBigPoe(EnGb* this, PlayState* play) {
             player->exchangeItemId = EXCH_ITEM_NONE;
             this->textId = 0x70F8;
             Message_ContinueTextbox(play, this->textId);
-            this->actionFunc = func_80A2FB40;
+            this->actionFunc = EnGb_OfferBottle;  // was func_80A2FB40 [LLM:HIGH]
         }
     }
 }
 
-void func_80A2FB40(EnGb* this, PlayState* play) {
+void EnGb_OfferBottle(EnGb* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_DONE && Message_ShouldAdvance(play)) {
         if (GameInteractor_Should(VB_GIVE_ITEM_FROM_POE_COLLECTOR, true, this)) {
             Actor_OfferGetItem(&this->dyna.actor, play, GI_BOTTLE, 100.0f, 10.0f);
diff --git a/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.h b/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.h
index ab419e20c..636ff033d 100644
--- a/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.h
+++ b/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.h
@@ -47,7 +47,7 @@ typedef struct EnGb {
     /* 0x0388 */ EnGbCagedSoul cagedSouls[4];
 } EnGb; // size = 0x0438
 
-void func_80A2FB40(EnGb* actor, PlayState* play);
+void EnGb_OfferBottle(EnGb* actor, PlayState* play);  // was func_80A2FB40 [LLM:HIGH]
 void EnGb_Idle(EnGb* actor, PlayState* play);  // was func_80A2F83C [LLM:HIGH]
 
 #endif
