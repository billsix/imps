From 596a7419d7e1eabd4b17f7f2480b4b00bd5aebda Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:16 +0000
Subject: [PATCH 1797/3799] soh: rename D_8012ACA0 -> sRoomVtxIndices

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: two 0x20-entry index lists picking which of the generated vertices each room-skybox face uses.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index d5c107d3f..5035bbab2 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -83,7 +83,8 @@ u32 sRoomFaceTexOffsets[4] = {  // was D_8012AC90 [LLM:HIGH]
     0x00030000,
 };
 
-u16 D_8012ACA0[2][0x20] = {
+// LLM generated name (HIGH), was D_8012ACA0: two 0x20-entry index lists picking which of the generated vertices each room-skybox face uses.
+u16 sRoomVtxIndices[2][0x20] = {  // was D_8012ACA0 [LLM:HIGH]
     { 0x00, 0x02, 0x0A, 0x0C, 0x02, 0x04, 0x0C, 0x0E, 0x0A, 0x0C, 0x14, 0x16, 0x0C, 0x0E, 0x16, 0x18,
       0x01, 0x03, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0B, 0x0D, 0x0F, 0x10, 0x11, 0x12, 0x13, 0x15, 0x17 },
     { 0x14, 0x16, 0x1E, 0x20, 0x16, 0x18, 0x20, 0x22, 0x1E, 0x20, 0x28, 0x2A, 0x20, 0x22, 0x2A, 0x2C,
@@ -234,7 +235,7 @@ s32 func_800ADBB0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
         skyboxCtx->unk_138 = skyboxCtx->dListBuf[arg9 + sp424];
 
         for (i = 0; i < 0x20; i++) {
-            index = D_8012ACA0[sp424][i];
+            index = sRoomVtxIndices[sp424][i];  // was D_8012ACA0 [LLM:HIGH]
 
             roomVtx[arg2 + i].v.ob[0] = sp358[index];
             roomVtx[arg2 + i].v.ob[1] = sp2A4[index];
-- 
