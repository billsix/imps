From b83c69a8a7da56aa70f124d3dcf0efa78c3d952c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:39 +0000
Subject: [PATCH 458/489] soh: rename D_80B16E7C -> sTaFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point EnTa_PostLimbDraw records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c b/soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c
index ea3c2bf48..bbf386667 100644
--- a/soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c
+++ b/soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c
@@ -1194,7 +1194,7 @@ s32 EnTa_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 }
 
 void EnTa_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
-    static Vec3f D_80B16E7C = {
+    static Vec3f sTaFocusOffset = {  // was D_80B16E7C [LLM:HIGH]
         1100.0f,
         1000.0f,
         0.0f,
@@ -1202,7 +1202,7 @@ void EnTa_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
     EnTa* this = (EnTa*)thisx;
 
     if (limbIndex == 15) {
-        Matrix_MultVec3f(&D_80B16E7C, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sTaFocusOffset, &this->actor.focus.pos);  // was D_80B16E7C [LLM:HIGH]
     }
 }
 
