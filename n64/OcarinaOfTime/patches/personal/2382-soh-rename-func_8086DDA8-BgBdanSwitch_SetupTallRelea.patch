From 9f8b1ccacd6451159afea81815ca61d057d5eca4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:24:06 +0000
Subject: [PATCH 2382/3799] soh: rename func_8086DDA8 ->
 BgBdanSwitch_SetupTallRelease

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the tall switch's rising action and arms the camera wait
Defined in soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c         | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
index 4be91b89f..808d9b609 100644
--- a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
+++ b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
@@ -65,7 +65,8 @@ void BgBdanSwitch_TallPress(BgBdanSwitch* this, PlayState* play);  // was func_8
 void BgBdanSwitch_SetupTallPressed(BgBdanSwitch* this);  // was func_8086DCCC [LLM:HIGH]
 // LLM generated name (HIGH), was func_8086DCE8: releases the YELLOW_TALL_1 switch when its flag is cleared, and the YELLOW_TALL_2 one when it is hit again
 void BgBdanSwitch_TallPressed(BgBdanSwitch* this, PlayState* play);  // was func_8086DCE8 [LLM:HIGH]
-void func_8086DDA8(BgBdanSwitch* this);
+// LLM generated name (HIGH), was func_8086DDA8: installs the tall switch's rising action and arms the camera wait
+void BgBdanSwitch_SetupTallRelease(BgBdanSwitch* this);  // was func_8086DDA8 [LLM:HIGH]
 void func_8086DDC0(BgBdanSwitch* this, PlayState* play);
 
 const ActorInit Bg_Bdan_Switch_InitVars = {
@@ -485,20 +486,20 @@ void BgBdanSwitch_TallPressed(BgBdanSwitch* this, PlayState* play) {
     switch (this->dyna.actor.params & 0xFF) {
         case YELLOW_TALL_1:
             if (!Flags_GetSwitch(play, (this->dyna.actor.params >> 8) & 0x3F)) {
-                func_8086DDA8(this);
+                BgBdanSwitch_SetupTallRelease(this);  // was func_8086DDA8 [LLM:HIGH]
             }
             break;
         case YELLOW_TALL_2:
             if (((this->collider.base.acFlags & AC_HIT) != 0) && ((this->unk_1DC & 2) == 0) && (this->unk_1D8 <= 0)) {
                 this->unk_1D8 = 0xA;
-                func_8086DDA8(this);
+                BgBdanSwitch_SetupTallRelease(this);  // was func_8086DDA8 [LLM:HIGH]
                 BgBdanSwitch_ClearSwitchFlag(this, play);  // was func_8086D548 [LLM:HIGH]
             }
             break;
     }
 }
 
-void func_8086DDA8(BgBdanSwitch* this) {
+void BgBdanSwitch_SetupTallRelease(BgBdanSwitch* this) {
     this->actionFunc = func_8086DDC0;
     this->unk_1DA = 0x64;
 }
