From 846a36d4277a4732f54c14b6884a47ad41e2f7df Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:49 +0000
Subject: [PATCH 3233/3799] soh: rename D_8082ADF0 -> sInfoPanelColorSets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the two RGBA sets the info panel text alternates between
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_scope_PAL.c   | 26 +++++++++----------
 1 file changed, 13 insertions(+), 13 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index e08bcea5e..41a9748e8 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -1957,7 +1957,7 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
     static u16 sInfoPanelLeftWidths[4] = { 56, 88, 80, 56 };  // was D_8082ADD8 [LLM:HIGH]
     static u16 sInfoPanelRightWidths[4] = { 64, 88, 72, 48 };  // was D_8082ADE0 [LLM:HIGH]
     static u16 sInfoPanelPromptWidths[4] = { 80, 104, 112, 80 };  // was D_8082ADE8 [LLM:HIGH]
-    static s16 D_8082ADF0[][4] = {
+    static s16 sInfoPanelColorSets[][4] = {  // was D_8082ADF0 [LLM:HIGH]
         { 180, 210, 255, 220 },
         { 100, 100, 150, 220 },
     };
@@ -1991,26 +1991,26 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
 
     OPEN_DISPS(play->state.gfxCtx);
 
-    stepR = ABS(D_808321A0 - D_8082ADF0[D_8082AE04][0]) / D_8082AE00;
-    stepG = ABS(D_808321A2 - D_8082ADF0[D_8082AE04][1]) / D_8082AE00;
-    stepB = ABS(D_808321A4 - D_8082ADF0[D_8082AE04][2]) / D_8082AE00;
-    stepA = ABS(D_808321A6 - D_8082ADF0[D_8082AE04][3]) / D_8082AE00;
-    if (D_808321A0 >= D_8082ADF0[D_8082AE04][0]) {
+    stepR = ABS(D_808321A0 - sInfoPanelColorSets[D_8082AE04][0]) / D_8082AE00;  // was D_8082ADF0 [LLM:HIGH]
+    stepG = ABS(D_808321A2 - sInfoPanelColorSets[D_8082AE04][1]) / D_8082AE00;  // was D_8082ADF0 [LLM:HIGH]
+    stepB = ABS(D_808321A4 - sInfoPanelColorSets[D_8082AE04][2]) / D_8082AE00;  // was D_8082ADF0 [LLM:HIGH]
+    stepA = ABS(D_808321A6 - sInfoPanelColorSets[D_8082AE04][3]) / D_8082AE00;  // was D_8082ADF0 [LLM:HIGH]
+    if (D_808321A0 >= sInfoPanelColorSets[D_8082AE04][0]) {  // was D_8082ADF0 [LLM:HIGH]
         D_808321A0 -= stepR;
     } else {
         D_808321A0 += stepR;
     }
-    if (D_808321A2 >= D_8082ADF0[D_8082AE04][1]) {
+    if (D_808321A2 >= sInfoPanelColorSets[D_8082AE04][1]) {  // was D_8082ADF0 [LLM:HIGH]
         D_808321A2 -= stepG;
     } else {
         D_808321A2 += stepG;
     }
-    if (D_808321A4 >= D_8082ADF0[D_8082AE04][2]) {
+    if (D_808321A4 >= sInfoPanelColorSets[D_8082AE04][2]) {  // was D_8082ADF0 [LLM:HIGH]
         D_808321A4 -= stepB;
     } else {
         D_808321A4 += stepB;
     }
-    if (D_808321A6 >= D_8082ADF0[D_8082AE04][3]) {
+    if (D_808321A6 >= sInfoPanelColorSets[D_8082AE04][3]) {  // was D_8082ADF0 [LLM:HIGH]
         D_808321A6 -= stepA;
     } else {
         D_808321A6 += stepA;
@@ -2018,10 +2018,10 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
 
     D_8082AE00--;
     if (D_8082AE00 == 0) {
-        D_808321A0 = D_8082ADF0[D_8082AE04][0];
-        D_808321A2 = D_8082ADF0[D_8082AE04][1];
-        D_808321A4 = D_8082ADF0[D_8082AE04][2];
-        D_808321A6 = D_8082ADF0[D_8082AE04][3];
+        D_808321A0 = sInfoPanelColorSets[D_8082AE04][0];  // was D_8082ADF0 [LLM:HIGH]
+        D_808321A2 = sInfoPanelColorSets[D_8082AE04][1];  // was D_8082ADF0 [LLM:HIGH]
+        D_808321A4 = sInfoPanelColorSets[D_8082AE04][2];  // was D_8082ADF0 [LLM:HIGH]
+        D_808321A6 = sInfoPanelColorSets[D_8082AE04][3];  // was D_8082ADF0 [LLM:HIGH]
         D_8082AE00 = ZREG(28);
         D_8082AE04 ^= 1;
     }
-- 
