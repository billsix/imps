@@ -1894,7 +1894,8 @@ s32 EnZl3_IsPlayerAhead(EnZl3* this, PlayState* play) {
     }
 }
 
-s32 func_80B57564(EnZl3* this, PlayState* play) {
+// LLM generated name (GUESS), was func_80B57564: true when the player is within 50 units or EnZl3_IsPlayerAhead; the condition that stops Zelda walking on
+s32 EnZl3_ShouldWaitForPlayer(EnZl3* this, PlayState* play) {
     if (EnZl3_IsPlayerWithin(this, play, 50.0f) || EnZl3_IsPlayerAhead(this, play)) {  // was func_80B573FC [LLM:HIGH]
         return 1;
     }
@@ -2192,7 +2193,7 @@ void func_80B58014(EnZl3* this, PlayState* play) {
         EnZl3_StepYawTowardsPlayer(this);  // was func_80B537E8 [LLM:HIGH]
