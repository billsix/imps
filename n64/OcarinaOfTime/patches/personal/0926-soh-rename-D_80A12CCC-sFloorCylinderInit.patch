From 7d1c32bc153e6d4d3cb0ea50dd16b3f3a4564dd4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:27:07 +0000
Subject: [PATCH 0926/3799] soh: rename D_80A12CCC -> sFloorCylinderInit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: ColliderCylinderInit installed for the FIRE_ROCK_ON_FLOOR params branch, which resizes it and hands off to FireRock_WaitOnFloor.
Defined in soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c b/soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c
index 5234af68b..d4c747511 100644
--- a/soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c
+++ b/soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c
@@ -49,7 +49,8 @@ static ColliderCylinderInit sFallingCylinderInit = {  // was D_80A12CA0 [LLM:HIG
     { 30, 30, -10, { 0, 0, 0 } },
 };
 
-static ColliderCylinderInit D_80A12CCC = {
+// LLM generated name (HIGH), was D_80A12CCC: ColliderCylinderInit installed for the FIRE_ROCK_ON_FLOOR params branch, which resizes it and hands off to FireRock_WaitOnFloor.
+static ColliderCylinderInit sFloorCylinderInit = {  // was D_80A12CCC [LLM:HIGH]
     {
         COLTYPE_HARD,
         AT_ON | AT_TYPE_ENEMY,
@@ -94,7 +95,7 @@ void EnFireRock_Init(Actor* thisx, PlayState* play) {
         case FIRE_ROCK_ON_FLOOR:
             Actor_SetScale(&this->actor, 0.03f);
             Collider_InitCylinder(play, &this->collider);
-            Collider_SetCylinder(play, &this->collider, &this->actor, &D_80A12CCC);
+            Collider_SetCylinder(play, &this->collider, &this->actor, &sFloorCylinderInit);  // was D_80A12CCC [LLM:HIGH]
             // "☆☆☆☆☆ floor rock ☆☆☆☆☆"
             osSyncPrintf(VT_FGCOL(YELLOW) "☆☆☆☆☆ 床岩 ☆☆☆☆☆ \n" VT_RST);
             this->collider.dim.radius = 23;
