From 20ea3807f0719bf8c28f07a78267c6ad2e16a370 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:58 +0000
Subject: [PATCH 2517/3799] soh: rename D_801305B0 -> sFixedFreqScale

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the constant frequency scale Audio_PlaySfxWithFixedScales passes
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 404544a54..ef1caa007 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -115,7 +115,8 @@ u8 gUsedChannelsPerBank[4][7] = {
     { 2, 1, 0, 0, 1, 1, 1 },
 };
 
-f32 D_801305B0 = 0.7950898f;
+// LLM generated name (HIGH), was D_801305B0: the constant frequency scale Audio_PlaySfxWithFixedScales passes
+f32 sFixedFreqScale = 0.7950898f;  // was D_801305B0 [LLM:HIGH]
 s8 D_801305B4 = 35;
 s8 D_801305B8 = 20;
 s8 D_801305BC = 30;
@@ -1318,7 +1319,7 @@ s32 sAudioUpdateTaskEnd;      // decomp: debug only
     F(sOcarinaSongNotes[OCARINA_SONG_SCARECROW_SPAWN]) \
     F(sOcaMemoryGameAppendPos)                         \
     F(sOcaMemoryGameEndPos)                            \
-    F(D_801305B0)                                      \
+    F(sFixedFreqScale)                                      \
     F(D_801305B4)                                      \
     F(D_801305B8)                                      \
     F(D_801305BC)                                      \
@@ -4433,7 +4434,7 @@ void Audio_PlaySfxWithSpeedScales(Vec3f* pos, u16 sfxId, f32 arg2) {
 
 // LLM generated name (HIGH), was func_800F4190: plays a sound with the file's constant frequency scale and reverb
 void Audio_PlaySfxWithFixedScales(Vec3f* pos, u16 sfxId) {
-    Audio_PlaySfxGeneral(sfxId, pos, 4, &D_801305B0, &gSfxDefaultFreqAndVolScale, &D_801305B4);
+    Audio_PlaySfxGeneral(sfxId, pos, 4, &sFixedFreqScale, &gSfxDefaultFreqAndVolScale, &D_801305B4);  // was D_801305B0 [LLM:HIGH]
 }
 void Audio_PlaySoundRandom(Vec3f* pos, u16 baseSfxId, u8 randLim) {
     u8 offset = Audio_NextRandom() % randLim;
-- 
