From 66f8a8466e673cb37a182b6f00f83b3a82e3560d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:53:58 +0000
Subject: [PATCH 2861/3799] soh: rename D_80ADD7A4 -> sPostPositions

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the position each sister burns out at
Defined in soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c  | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
index 812d12ed0..54aecbaf9 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
@@ -180,7 +180,8 @@ static Vec3f sZeroVector = { 0.0f, 0.0f, 0.0f };
 // LLM generated name (HIGH), was D_80ADD79C: the yaw each sister faces once she reaches her post
 static s16 sPostYaws[4] = { 0xB000, 0xD000, 0x5000, 0x3000 };  // was D_80ADD79C [LLM:HIGH]
 
-static Vec3s D_80ADD7A4[4] = {
+// LLM generated name (HIGH), was D_80ADD7A4: the position each sister burns out at
+static Vec3s sPostPositions[4] = {  // was D_80ADD7A4 [LLM:HIGH]
     { -22, 337, -1704 },
     { -431, 879, -3410 },
     { 549, 879, -3410 },
@@ -888,9 +889,9 @@ void EnPoSisters_BurnOut(EnPoSisters* this, PlayState* play) {
         EnPoSisters_UpdateTrailRing(this, 64 - this->unk_19A, &this->actor.world.pos);  // was func_80AD9240 [LLM:HIGH]
     }
     if (this->unk_19A == 32) {
-        this->actor.world.pos.x = D_80ADD7A4[this->unk_194].x;
-        this->actor.world.pos.y = D_80ADD7A4[this->unk_194].y;
-        this->actor.world.pos.z = D_80ADD7A4[this->unk_194].z;
+        this->actor.world.pos.x = sPostPositions[this->unk_194].x;  // was D_80ADD7A4 [LLM:HIGH]
+        this->actor.world.pos.y = sPostPositions[this->unk_194].y;  // was D_80ADD7A4 [LLM:HIGH]
+        this->actor.world.pos.z = sPostPositions[this->unk_194].z;  // was D_80ADD7A4 [LLM:HIGH]
     }
 }
 
