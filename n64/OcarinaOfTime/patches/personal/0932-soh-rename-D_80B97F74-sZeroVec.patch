From 12a119559eda023b85dffa7203a1383a71fb10de Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:09 +0000
Subject: [PATCH 0932/3799] soh: rename D_80B97F74 -> sZeroVec

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Vec3f { 0, 0, 0 } passed as both the velocity and the acceleration argument of EffectSsDeadDb_Spawn.
Defined in soh/src/overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c  | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c b/soh/src/overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c
index 12b7375e5..24f457c6b 100644
--- a/soh/src/overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c
+++ b/soh/src/overlays/actors/ovl_Obj_Lightswitch/z_obj_lightswitch.c
@@ -82,7 +82,8 @@ static void* sFaceTextures[] = { object_lightswitch_Tex_000C20, object_lightswit
 
 // LLM generated name (GUESS), was D_80B97F68: fixed world position the params bit-0 lightswitch is snapped to in Init when its switch flag is already set; why that particular coordinate is hardcoded is not recoverable from the file.
 static Vec3f sFlagSetPos = { -1707.0f, 843.0f, -180.0f };  // was D_80B97F68 [LLM:GUESS]
-static Vec3f D_80B97F74 = { 0.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80B97F74: Vec3f { 0, 0, 0 } passed as both the velocity and the acceleration argument of EffectSsDeadDb_Spawn.
+static Vec3f sZeroVec = { 0.0f, 0.0f, 0.0f };  // was D_80B97F74 [LLM:HIGH]
 
 static InitChainEntry sInitChain[] = {
     ICHAIN_VEC3F_DIV1000(scale, 100, ICHAIN_CONTINUE),
@@ -158,7 +159,7 @@ void ObjLightswitch_SpawnDisappearEffects(ObjLightswitch* this, PlayState* play)
         pos.x = this->actor.world.pos.x + ((z * s) + (x * c));
         pos.y = this->actor.world.pos.y + y + 10.0f;
         pos.z = this->actor.world.pos.z + ((z * c) - (x * s));
-        EffectSsDeadDb_Spawn(play, &pos, &D_80B97F74, &D_80B97F74, 100, 0, 255, 255, 160, 160, 255, 0, 0, 1, 9, true);
+        EffectSsDeadDb_Spawn(play, &pos, &sZeroVec, &sZeroVec, 100, 0, 255, 255, 160, 160, 255, 0, 0, 1, 9, true);  // was D_80B97F74 [LLM:HIGH]
     }
 }
 
