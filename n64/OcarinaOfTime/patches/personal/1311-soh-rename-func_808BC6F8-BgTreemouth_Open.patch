 .../overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c | 11 ++++++-----
 .../overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.h |  2 +-
 3 files changed, 8 insertions(+), 7 deletions(-)

