From 6baf854bcca6fed2e47759c9c3dcce7dcc876879 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:38 +0000
Subject: [PATCH 444/488] soh: rename D_809FFC50 -> sDyExtraTexIndices

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the texture index sequence EnDyExtra_Draw walks
Defined in soh/src/overlays/actors/ovl_En_Dy_Extra/z_en_dy_extra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Dy_Extra/z_en_dy_extra.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Dy_Extra/z_en_dy_extra.c b/soh/src/overlays/actors/ovl_En_Dy_Extra/z_en_dy_extra.c
index ee41499f0..be12dcd2c 100644
--- a/soh/src/overlays/actors/ovl_En_Dy_Extra/z_en_dy_extra.c
+++ b/soh/src/overlays/actors/ovl_En_Dy_Extra/z_en_dy_extra.c
@@ -92,7 +92,7 @@ void EnDyExtra_Update(Actor* thisx, PlayState* play) {
 void EnDyExtra_Draw(Actor* thisx, PlayState* play) {
     static Color_RGBA8 primColors[] = { { 255, 255, 170, 255 }, { 255, 255, 170, 255 } };
     static Color_RGBA8 envColors[] = { { 255, 100, 255, 255 }, { 100, 255, 255, 255 } };
-    static u8 D_809FFC50[] = { 0x02, 0x01, 0x01, 0x02, 0x00, 0x00, 0x02, 0x01, 0x00, 0x02, 0x01, 0x00, 0x02, 0x01,
+    static u8 sDyExtraTexIndices[] = { 0x02, 0x01, 0x01, 0x02, 0x00, 0x00, 0x02, 0x01, 0x00, 0x02, 0x01, 0x00, 0x02, 0x01,  // was D_809FFC50 [LLM:HIGH]
                                0x00, 0x02, 0x01, 0x00, 0x02, 0x01, 0x00, 0x02, 0x01, 0x00, 0x01, 0x02, 0x00 };
     EnDyExtra* this = (EnDyExtra*)thisx;
     GraphicsContext* gfxCtx = play->state.gfxCtx;
@@ -105,8 +105,8 @@ void EnDyExtra_Draw(Actor* thisx, PlayState* play) {
     unk[2] = (s8)(this->unk_158 * 255.0f);
 
     for (i = 0; i < 27; i++) {
-        if (D_809FFC50[i]) {
-            vertices[i].v.cn[3] = unk[D_809FFC50[i]];
+        if (sDyExtraTexIndices[i]) {  // was D_809FFC50 [LLM:HIGH]
+            vertices[i].v.cn[3] = unk[sDyExtraTexIndices[i]];  // was D_809FFC50 [LLM:HIGH]
         }
     }
 
