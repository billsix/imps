@@ -101,7 +102,7 @@ void BgRelayObjects_Init(Actor* thisx, PlayState* play) {
                 Actor_Kill(thisx);
             } else {
                 D_808A9508 |= (1 << this->unk_169);
-                this->actionFunc = func_808A90F4;
+                this->actionFunc = BgRelayObjects_OpenDoor;  // was func_808A90F4 [LLM:HIGH]
             }
         } else {
             Flags_SetSwitch(play, this->switchFlag);
@@ -122,7 +123,7 @@ void BgRelayObjects_Destroy(Actor* thisx, PlayState* play) {
     }
 }
 
-void func_808A90F4(BgRelayObjects* this, PlayState* play) {
+void BgRelayObjects_OpenDoor(BgRelayObjects* this, PlayState* play) {
     if (Flags_GetSwitch(play, this->switchFlag)) {
         if (this->timer != 0) {
             Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_SLIDE_DOOR_OPEN);
