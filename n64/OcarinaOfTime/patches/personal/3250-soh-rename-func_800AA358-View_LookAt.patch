+++ b/soh/src/code/z_camera.c
@@ -7684,7 +7684,7 @@ Vec3s Camera_Update(Camera* camera) {
     if (gDbgCamEnabled) {
         camera->play->view.fovy = sDbCamera.fov;  // was D_8015BD80 [LLM:HIGH]
         DbCamera_Update(&sDbCamera, camera);  // was D_8015BD80 [LLM:HIGH]
-        func_800AA358(&camera->play->view, &sDbCamera.eye, &sDbCamera.at, &sDbCamera.unk_1C);  // was D_8015BD80 [LLM:HIGH]
+        View_LookAt(&camera->play->view, &sDbCamera.eye, &sDbCamera.at, &sDbCamera.unk_1C);  // was D_8015BD80 [LLM:HIGH]
         if (R_DBG_CAM_UPDATE) {
             osSyncPrintf("camera: debug out\n");
         }
@@ -7735,7 +7735,7 @@ Vec3s Camera_Update(Camera* camera) {
         View_SetScale(&camera->play->view, 1.0f);
     }
     camera->play->view.fovy = viewFov;
-    func_800AA358(&camera->play->view, &viewEye, &viewAt, &viewUp);
+    View_LookAt(&camera->play->view, &viewEye, &viewAt, &viewUp);  // was func_800AA358 [LLM:HIGH]
     camera->camDir.x = eyeAtAngle.pitch;
     camera->camDir.y = eyeAtAngle.yaw;
     camera->camDir.z = 0;
