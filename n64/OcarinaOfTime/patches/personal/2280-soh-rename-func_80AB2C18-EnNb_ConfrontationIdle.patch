 }
 
-void func_80AB2C18(EnNb* this, PlayState* play) {
+// LLM generated name (GUESS), was func_80AB2C18: the step the enum calls NB_ACTION_14: blinks, applies root motion and watches the cutscene; its purpose beyond waiting is not established
