From 98c11dc04283094ec6cf36097b14eb89ba80014d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:10:30 +0000
Subject: [PATCH 3271/3799] soh: rename D_808E4E38 -> sMaskLimbParents

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-limb index of the limb its mask position is interpolated toward, -1 where there is none
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index ce78bc4df..aa5afc17b 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -3697,7 +3697,7 @@ void BossGanon_DrawMaskTexPattern(BossGanon* this, u8* tex, f32 arg2) {
     static s16 sMaskStripeWidths7[] = { 2, 3, 4, 4, 4, 3, 2 };  // was D_808E4E00 [LLM:HIGH]
     static s16 sMaskStripeWidths8[] = { 2, 3, 4, 4, 4, 4, 3, 2 };  // was D_808E4E10 [LLM:HIGH]
     static s16 sMaskStripeWidths12[] = { 2, 4, 5, 5, 6, 6, 6, 6, 5, 5, 4, 2 };  // was D_808E4E20 [LLM:HIGH]
-    static s16 D_808E4E38[] = { 1, -1, 1, 1, 3, 4, 1, 6, 7, 2, 9, 10, 2, 12, 13 };
+    static s16 sMaskLimbParents[] = { 1, -1, 1, 1, 3, 4, 1, 6, 7, 2, 9, 10, 2, 12, 13 };  // was D_808E4E38 [LLM:HIGH]
     static u8 D_808E4E58[] = { 3, 2, 2, 1, 3, 3, 1, 3, 3, 1, 0, 3, 1, 0, 3 };
     s16 baseX;
     s16 index;
@@ -3713,7 +3713,7 @@ void BossGanon_DrawMaskTexPattern(BossGanon* this, u8* tex, f32 arg2) {
     Vec3f sp5C;
 
     for (i = 0; i < 15; i++) {
-        if (arg2 == 0.0f || (y = D_808E4E38[i]) >= 0) {
+        if (arg2 == 0.0f || (y = sMaskLimbParents[i]) >= 0) {  // was D_808E4E38 [LLM:HIGH]
             if (arg2 > 0.0f) {
                 lerpX = this->unk_2EC[i].x + (this->unk_2EC[y].x - this->unk_2EC[i].x) * arg2;
                 lerpY = this->unk_2EC[i].y + (this->unk_2EC[y].y - this->unk_2EC[i].y) * arg2;
