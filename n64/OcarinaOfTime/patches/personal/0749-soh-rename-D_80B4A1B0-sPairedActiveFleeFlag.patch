From 13f84db4655c8ac15dbb4d9566472c049e45b1f6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:47 +0000
Subject: [PATCH 0749/3799] soh: rename D_80B4A1B0 -> sPairedActiveFleeFlag

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c.
---
 soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c b/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
index b4d44c141..5268097e6 100644
--- a/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
+++ b/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
@@ -106,11 +106,12 @@ static Vec3f sPlatformPositions[] = {
 };
 
 // These seem to relate to the tagging in/out the minibosses do
-static s16 D_80B4A1B0 = 0;
+// Name from zeldaret/oot (was D_80B4A1B0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Zf/z_en_zf.c]
+static s16 sPairedActiveFleeFlag = 0;
 static s16 D_80B4A1B4 = 1;
 
 #define EN_ZF_SHIP_SAVESTATE_FIELDS(F) \
-    F(D_80B4A1B0)                      \
+    F(sPairedActiveFleeFlag)                      \
     F(D_80B4A1B4)
 
 SHIP_SAVESTATE_DEFINE(EnZf, EN_ZF_SHIP_SAVESTATE_FIELDS)
@@ -1669,7 +1670,7 @@ void EnZf_Damaged(EnZf* this, PlayState* play) {
 
         if (D_80B4A1B4 != -1) {
             if (this->damageEffect == ENZF_DMGEFF_PROJECTILE) {
-                D_80B4A1B0++;
+                sPairedActiveFleeFlag++;
             } else {
                 this->actor.world.rot.y = this->actor.shape.rot.y;
 
@@ -1940,7 +1941,7 @@ void EnZf_SetupDie(EnZf* this) {
         }
     }
 
-    D_80B4A1B0 = 0;
+    sPairedActiveFleeFlag = 0;
     Audio_PlayActorSound2(&this->actor, NA_SE_EN_RIZA_DEAD);
     EnZf_SetupAction(this, EnZf_Die);
 
@@ -2080,10 +2081,10 @@ void EnZf_Update(Actor* thisx, PlayState* play) {
             EnZf_UpdateHeadRotation(this, play);
         }
 
-        if ((D_80B4A1B0 != 0) && (D_80B4A1B4 != this->actor.params)) {
+        if ((sPairedActiveFleeFlag != 0) && (D_80B4A1B4 != this->actor.params)) {
             EnZf_SetupSheatheSword(this, play);
             D_80B4A1B4 = this->actor.params;
-            D_80B4A1B0 = 0;
+            sPairedActiveFleeFlag = 0;
 
             if (this->actor.prev != NULL) {
                 ((EnZf*)this->actor.prev)->unk_3F4 = 90;
@@ -2447,6 +2448,6 @@ s32 EnZf_DodgeRangedWaiting(PlayState* play, EnZf* this) {
 }
 
 void EnZf_Reset(void) {
-    D_80B4A1B0 = 0;
+    sPairedActiveFleeFlag = 0;
     D_80B4A1B4 = 1;
 }
