From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:47:37 +0000
Subject: [PATCH 1094/3799] soh: rename func_80B92B08 ->
 ObjElevator_InitDynaPoly

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: registers the elevator as a dyna-poly bg actor with the given collision header, warning when the bg actor table is full.
Defined in soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c b/soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c
index b2ca1527b..bdf1e65ee 100644
--- a/soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c
+++ b/soh/src/overlays/actors/ovl_Obj_Elevator/z_obj_elevator.c
@@ -44,7 +44,8 @@ void ObjElevator_SetupAction(ObjElevator* this, ObjElevatorActionFunc actionFunc
     this->actionFunc = actionFunc;
 }
 
-void func_80B92B08(ObjElevator* this, PlayState* play, CollisionHeader* collision, s32 flag) {
+// LLM generated name (HIGH), was func_80B92B08: registers the elevator as a dyna-poly bg actor with the given collision header, warning when the bg actor table is full.
+void ObjElevator_InitDynaPoly(ObjElevator* this, PlayState* play, CollisionHeader* collision, s32 flag) {
     s16 pad1;
     CollisionHeader* colHeader = NULL;
     s16 pad2;
@@ -63,7 +64,7 @@ void ObjElevator_Init(Actor* thisx, PlayState* play) {
     ObjElevator* this = (ObjElevator*)thisx;
     f32 temp_f0;
 
-    func_80B92B08(this, play, &object_d_elevator_Col_000360, DPM_PLAYER);
+    ObjElevator_InitDynaPoly(this, play, &object_d_elevator_Col_000360, DPM_PLAYER);  // was func_80B92B08 [LLM:HIGH]
     Actor_SetScale(thisx, sScales[thisx->params & 1]);
     Actor_ProcessInitChain(thisx, sInitChain);
     temp_f0 = (thisx->params >> 8) & 0xF;
