From 89a406a608b446e89ea6b4b3c2382c6ffae0bed8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:10:29 +0000
Subject: [PATCH 3267/3799] soh: rename D_808E4DF4 -> sMaskStripeWidths6

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the six row half-widths of the narrowest limb stripe stamped into the mask texture
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index 9d153371b..6c56f314a 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -3693,7 +3693,7 @@ void BossGanon_DrawDarkVortex(BossGanon* this, PlayState* play) {
 
 // LLM generated name (GUESS), was func_808E0254: stamps one shape into the caller's texture buffer using a set of local row-width tables, with the caller's float selecting how far through the pattern to draw; it is called from a loop that steps that value in fifths. What the resulting mask is used for is not visible from here.
 void BossGanon_DrawMaskTexPattern(BossGanon* this, u8* tex, f32 arg2) {
-    static s16 D_808E4DF4[] = { 1, 2, 3, 3, 2, 1 };
+    static s16 sMaskStripeWidths6[] = { 1, 2, 3, 3, 2, 1 };  // was D_808E4DF4 [LLM:HIGH]
     static s16 D_808E4E00[] = { 2, 3, 4, 4, 4, 3, 2 };
     static s16 D_808E4E10[] = { 2, 3, 4, 4, 4, 4, 3, 2 };
     static s16 D_808E4E20[] = { 2, 4, 5, 5, 6, 6, 6, 6, 5, 5, 4, 2 };
@@ -3765,7 +3765,7 @@ void BossGanon_DrawMaskTexPattern(BossGanon* this, u8* tex, f32 arg2) {
                 }
             } else {
                 for (y = 0, addY = -0x80; y < 6; y++, addY += 0x40) {
-                    for (x = -D_808E4DF4[y]; x < D_808E4DF4[y] - 1; x++) {
+                    for (x = -sMaskStripeWidths6[y]; x < sMaskStripeWidths6[y] - 1; x++) {  // was D_808E4DF4 [LLM:HIGH]
                         index = baseX + x + baseY + addY;
                         if ((index >= 0) && (index < 0x1000)) {
                             tex[index] = 255;
-- 
