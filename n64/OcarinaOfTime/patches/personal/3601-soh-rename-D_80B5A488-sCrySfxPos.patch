From 7272fb15761e43b8bb86c4106e0c43433ac8a2e3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:37 +0000
Subject: [PATCH 3601/3799] soh: rename D_80B5A488 -> sCrySfxPos

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the {0,0,0} position handed to Audio_PlaySoundRandom for the NA_SE_VO_Z1_CRY_0..1 cry, i.e. play it at the listener rather than at the actor
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 96d293c14..2d56090fb 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -59,7 +59,8 @@ static Vec3f sZl3FocusOffset = { 0.0f, 10.0f, 0.0f };  // was D_80B5A478 [LLM:GU
 // LLM generated name (GUESS), was D_80B5A484: counter stepped 0-to-4 by EnZl3_OpenEyesOnWake: eye texture 2 (shut) for the first two frames, 1 (half) for the next two, then normal blinking. A wake-up ramp, not a timer anything else reads
 static f32 sEyeOpenPhase = 0.0f;  // was D_80B5A484 [LLM:GUESS]
 
-static Vec3f D_80B5A488 = { 0.0f, 0.0f, 0.0f };
+// LLM generated name (GUESS), was D_80B5A488: the {0,0,0} position handed to Audio_PlaySoundRandom for the NA_SE_VO_Z1_CRY_0..1 cry, i.e. play it at the listener rather than at the actor
+static Vec3f sCrySfxPos = { 0.0f, 0.0f, 0.0f };  // was D_80B5A488 [LLM:GUESS]
 
 static s32 D_80B5A494 = -1;
 
@@ -1026,7 +1027,7 @@ void func_80B55808(EnZl3* this) {
 }
 
 void func_80B5582C(EnZl3* this) {
-    Audio_PlaySoundRandom(&D_80B5A488, NA_SE_VO_Z1_CRY_0, NA_SE_VO_Z1_CRY_1 - NA_SE_VO_Z1_CRY_0 + 1);
+    Audio_PlaySoundRandom(&sCrySfxPos, NA_SE_VO_Z1_CRY_0, NA_SE_VO_Z1_CRY_1 - NA_SE_VO_Z1_CRY_0 + 1);  // was D_80B5A488 [LLM:GUESS]
 }
 
 void func_80B5585C(EnZl3* this) {
