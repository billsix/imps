From 405634ba358a5c808dd01a52761119abec1acf2b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:09 +0000
Subject: [PATCH 2437/3799] soh: rename func_80ADF5E0 -> EnPoh_TurnAround

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: turns onto the recorded heading, breaking off early if the player comes close
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index 04d6168a1..85205aa83 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -38,7 +38,8 @@ void EnPoh_RegularAppear(EnPoh* this, PlayState* play);  // was func_80ADEF38 [L
 void EnPoh_Dissolve(EnPoh* this, PlayState* play);  // was func_80ADF15C [LLM:HIGH]
 // LLM generated name (HIGH), was func_80ADF574: spins the poe as it drifts backwards, then returns to the idle
 void EnPoh_SpinAway(EnPoh* this, PlayState* play);  // was func_80ADF574 [LLM:HIGH]
-void func_80ADF5E0(EnPoh* this, PlayState* play);
+// LLM generated name (HIGH), was func_80ADF5E0: turns onto the recorded heading, breaking off early if the player comes close
+void EnPoh_TurnAround(EnPoh* this, PlayState* play);  // was func_80ADF5E0 [LLM:HIGH]
 void EnPoh_Disappear(EnPoh* this, PlayState* play);
 void EnPoh_Appear(EnPoh* this, PlayState* play);
 void EnPoh_Death(EnPoh* this, PlayState* play);
@@ -363,7 +364,7 @@ void EnPoh_SetupSpinAway(EnPoh* this) {
 void EnPoh_SetupTurnAround(EnPoh* this) {
     Animation_PlayLoop(&this->skelAnime, this->info->idleAnim);
     this->unk_19C = this->actor.world.rot.y + 0x8000;
-    this->actionFunc = func_80ADF5E0;
+    this->actionFunc = EnPoh_TurnAround;  // was func_80ADF5E0 [LLM:HIGH]
     this->actor.speedXZ = 0.0f;
 }
 
@@ -682,7 +683,7 @@ void EnPoh_SpinAway(EnPoh* this, PlayState* play) {
     }
 }
 
-void func_80ADF5E0(EnPoh* this, PlayState* play) {
+void EnPoh_TurnAround(EnPoh* this, PlayState* play) {
     SkelAnime_Update(&this->skelAnime);
     if (Math_ScaledStepToS(&this->actor.world.rot.y, this->unk_19C, 1820) != 0) {
         EnPoh_SetupIdle(this);
@@ -915,12 +916,12 @@ void EnPoh_UpdateVisibility(EnPoh* this) {
             if ((this->unk_194 == 20 || this->visibilityTimer == 0) &&
                 (this->actionFunc == EnPoh_Hover || this->actionFunc == EnPoh_Idle ||  // was func_80ADEAC4 [LLM:HIGH]
                  this->actionFunc == EnPoh_Approach || this->actionFunc == func_80ADF894 ||  // was func_80ADEC9C [LLM:HIGH]
-                 this->actionFunc == func_80ADF5E0)) {
+                 this->actionFunc == EnPoh_TurnAround)) {  // was func_80ADF5E0 [LLM:HIGH]
                 EnPoh_SetupDisappear(this);
             }
         } else if (this->lightColor.a == 0 && this->visibilityTimer == 0 &&
                    (this->actionFunc == EnPoh_Hover || this->actionFunc == EnPoh_Idle ||  // was func_80ADEAC4 [LLM:HIGH]
-                    this->actionFunc == EnPoh_Approach || this->actionFunc == func_80ADF5E0)) {  // was func_80ADEC9C [LLM:HIGH]
+                    this->actionFunc == EnPoh_Approach || this->actionFunc == EnPoh_TurnAround)) {  // was func_80ADEC9C [LLM:HIGH]
             EnPoh_SetupAppear(this);
         }
     }
