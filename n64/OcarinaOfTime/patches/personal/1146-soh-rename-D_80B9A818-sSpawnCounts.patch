         (vec + i)->x += (80.0f * Math_SinS((i - 1) * 0x2000));
         (vec + i)->z += (80.0f * Math_CosS((i - 1) * 0x2000));
@@ -69,7 +70,7 @@ static Mure2sScatteredShrubInfo sScatteredShrubInfo[] = {
