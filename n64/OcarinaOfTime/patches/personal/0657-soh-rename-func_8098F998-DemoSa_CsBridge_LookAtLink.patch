Date: Mon, 7 Sep 2026 15:21:23 +0000
Subject: [PATCH 657/784] soh: rename func_8098F998 ->
 DemoSa_CsBridge_LookAtLink

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 9f720234c..d7d9a6d7d 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -690,7 +690,8 @@ void DemoSa_CsBridge_StillHidden(DemoSa* this) {
     this->actor.shape.shadowAlpha = 0;
 }
 
-void func_8098F998(DemoSa* this, PlayState* play) {
+// Name from zeldaret/oot (was func_8098F998): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_CsBridge_LookAtLink(DemoSa* this, PlayState* play) {
     if (this->cueId == 4) {
         DemoSa_SetStartPosRotFromCue(this, play, 1);
         this->action = 17;
@@ -753,7 +754,7 @@ void func_8098FB68(DemoSa* this, PlayState* play) {
                     DemoSa_CsBridge_StillHidden(this);
                     break;
                 case 12:
-                    func_8098F998(this, play);
+                    DemoSa_CsBridge_LookAtLink(this, play);
                     break;
                 case 13:
                     func_8098FA84(this);
