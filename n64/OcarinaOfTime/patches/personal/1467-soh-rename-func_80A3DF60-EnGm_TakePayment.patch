From d9e562d64c271ba2674bd925004650599f243ab7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:20:44 +0000
Subject: [PATCH 1467/3799] soh: rename func_80A3DF60 -> EnGm_TakePayment

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: once the get-item textbox is advanced it charges the 200 rupees and returns to the idle.
Defined in soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c b/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
index f80ca6d2a..9734ee591 100644
--- a/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
+++ b/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
@@ -33,7 +33,8 @@ void EnGm_Talk(EnGm* this, PlayState* play);  // was func_80A3DD7C [LLM:HIGH]
 void EnGm_ProcessChoiceIndex(EnGm* this, PlayState* play);
 // LLM generated name (HIGH), was func_80A3DF00: re-offers GI_SWORD_KNIFE until the player takes it, then moves on to the payment state.
 void EnGm_GiveKnife(EnGm* this, PlayState* play);  // was func_80A3DF00 [LLM:HIGH]
-void func_80A3DF60(EnGm* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A3DF60: once the get-item textbox is advanced it charges the 200 rupees and returns to the idle.
+void EnGm_TakePayment(EnGm* this, PlayState* play);  // was func_80A3DF60 [LLM:HIGH]
 
 const ActorInit En_Gm_InitVars = {
     ACTOR_EN_GM,
@@ -273,13 +274,13 @@ void EnGm_ProcessChoiceIndex(EnGm* this, PlayState* play) {
 void EnGm_GiveKnife(EnGm* this, PlayState* play) {
     if (Actor_HasParent(&this->actor, play)) {
         this->actor.parent = NULL;
-        this->actionFunc = func_80A3DF60;
+        this->actionFunc = EnGm_TakePayment;  // was func_80A3DF60 [LLM:HIGH]
     } else {
         Actor_OfferGetItem(&this->actor, play, GI_SWORD_KNIFE, 415.0f, 10.0f);
     }
 }
 
-void func_80A3DF60(EnGm* this, PlayState* play) {
+void EnGm_TakePayment(EnGm* this, PlayState* play) {
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_DONE) && Message_ShouldAdvance(play)) {
         Rupees_ChangeBy(-200);
         this->actionFunc = EnGm_Idle;  // was func_80A3DC44 [LLM:HIGH]
