         this->actionFunc = func_80AAE598;
@@ -200,7 +201,7 @@ void EnMm_Destroy(Actor* thisx, PlayState* play) {
     Collider_DestroyCylinder(play, &this->collider);
 }
 
-s32 func_80AADA70(void) {
+s32 EnMm_IsDay(void) {
     s32 isDay = false;
 
     if ((gSaveContext.dayTime > 0x3555) && (gSaveContext.dayTime <= 0xD556)) {
@@ -438,7 +439,7 @@ void func_80AAE294(EnMm* this, PlayState* play) {
 
         func_80AADEF0(this, play);
 
-        if (func_80AADA70() == 0) {
+        if (EnMm_IsDay() == 0) {  // was func_80AADA70 [LLM:HIGH]
             if (this->actor.floorPoly != NULL) {
                 floorYNorm = COLPOLY_GET_NORMAL(this->actor.floorPoly->normal.y);
 
@@ -492,7 +493,7 @@ void func_80AAE598(EnMm* this, PlayState* play) {
     Actor_TrackPlayer(play, &this->actor, &this->unk_248, &this->unk_24E, this->actor.focus.pos);
     SkelAnime_Update(&this->skelAnime);
 
-    if ((func_80AADA70() != 0) && (this->unk_1E0 == 0)) {
+    if ((EnMm_IsDay() != 0) && (this->unk_1E0 == 0)) {  // was func_80AADA70 [LLM:HIGH]
         this->unk_1E0 = 3;
         this->actionFunc = func_80AAE50C;
         this->unk_254 &= ~1;
