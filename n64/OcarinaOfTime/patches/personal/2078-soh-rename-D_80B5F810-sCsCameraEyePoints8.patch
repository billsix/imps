--- a/soh/src/overlays/actors/ovl_En_Zl4/z_en_zl4_cutscene_data.c
+++ b/soh/src/overlays/actors/ovl_En_Zl4/z_en_zl4_cutscene_data.c
@@ -164,7 +164,8 @@ static CutsceneCameraPoint sCsCameraAtPoints8[] = {  // was D_80B5F790 [LLM:HIGH
     { 0, 0, 30, 60.000114f, { 49, 51, -43 } },  { 0, 0, 30, 60.000114f, { 49, 51, -43 } },
     { -1, 0, 30, 60.000114f, { 49, 51, -43 } }, { -1, 0, 30, 60.000114f, { 49, 51, -43 } },
 };
-static CutsceneCameraPoint D_80B5F810[] = {
