+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1356,7 +1356,8 @@ void EnRu1_PlayBouncingOffWallSfx(EnRu1* this) {
     Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_VO_RT_CRASH);
 }
 
-void func_80AED5DC(EnRu1* this) {
+// LLM generated name (HIGH), was func_80AED5DC: plays Ruto's off-balance voice clip.
+void EnRu1_PlayUnbalanceSfx(EnRu1* this) {
     Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_VO_RT_UNBALLANCE);
 }
 
@@ -1819,7 +1820,7 @@ void EnRu1_UpdateCarriedBehavior(EnRu1* this, PlayState* play) {
                     frameCount = Animation_GetLastFrame(&gRutoChildSquirmAnim);
                     Animation_Change(&this->skelAnime, &gRutoChildSquirmAnim, 1.0f, 0, frameCount, ANIMMODE_LOOP,
