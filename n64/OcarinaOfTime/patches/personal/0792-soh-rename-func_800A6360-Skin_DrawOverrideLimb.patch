     Gfx_SetupDL_25Opa(play->state.gfxCtx);
-    func_800A6360(&this->actor, play, &this->skin, EnHorseLinkChild_PostDraw, EnHorseLinkChild_OverrideLimbDraw, true);
+    Skin_DrawOverrideLimb(&this->actor, play, &this->skin, EnHorseLinkChild_PostDraw, EnHorseLinkChild_OverrideLimbDraw, true);  // was func_800A6360 [LLM:HIGH]
 }
