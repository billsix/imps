From ef2ce08e72bae0c4a41a951b7cdda3df2c77ec51 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:20:37 +0000
Subject: [PATCH 3476/3799] soh: rename Struct_800A57C0 -> SkinVertexAlias

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: a typedef alias of SkinVertex kept for the address-named declarations
Defined in soh/include/z64skin.h.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/z64skin.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/include/z64skin.h b/soh/include/z64skin.h
index 1d77fad33..5cba5d569 100644
--- a/soh/include/z64skin.h
+++ b/soh/include/z64skin.h
@@ -50,7 +50,8 @@ typedef struct {
 
 // ZAPD compatibility typedefs
 // TODO: Remove when ZAPD adds support for them
-typedef SkinVertex Struct_800A57C0;
+// LLM generated name (HIGH), was Struct_800A57C0: a typedef alias of SkinVertex kept for the address-named declarations
+typedef SkinVertex SkinVertexAlias;  // was Struct_800A57C0 [LLM:HIGH]
 typedef SkinTransformation Struct_800A598C_2;
 typedef SkinAnimatedLimbData Struct_800A5E28;
 typedef SkinLimbModif Struct_800A598C;
