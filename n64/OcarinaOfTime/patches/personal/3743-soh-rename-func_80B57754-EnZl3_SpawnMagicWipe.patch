@@ -1961,7 +1961,8 @@ void EnZl3_UnsetRotZSwitchFlag(EnZl3* this, PlayState* play) {
     Flags_UnsetSwitch(play, unk_3C4);
 }
 
-void func_80B57754(EnZl3* this, PlayState* play) {
+// LLM generated name (GUESS), was func_80B57754: while no magic effect is running, spawns ACTOR_OCEFF_WIPE4 at the actor and plays the Zelda-power cue
+void EnZl3_SpawnMagicWipe(EnZl3* this, PlayState* play) {
     if (gSaveContext.magicState == MAGIC_STATE_IDLE) {
         Actor_Spawn(&play->actorCtx, play, ACTOR_OCEFF_WIPE4, this->actor.world.pos.x, this->actor.world.pos.y,
                     this->actor.world.pos.z, 0, 0, 0, 1);
@@ -2388,7 +2389,7 @@ void func_80B58AAC(EnZl3* this, PlayState* play) {
 
     *unk_2EC += 1.0f;
     if ((*unk_2EC >= kREG(7) + 24.0f) && (this->unk_36C == 0)) {
-        func_80B57754(this, play);
+        EnZl3_SpawnMagicWipe(this, play);  // was func_80B57754 [LLM:GUESS]
         func_80B5884C(this, play);
     } else if ((*unk_2EC >= kREG(8) + 50.0f) && (this->unk_370 == 0)) {
         EnZl3_SetSwitchFlag(this, play);  // was func_80B56EB8 [LLM:HIGH]
