From 706ef5f4c891448e73e1248d160e94e8736e0ec0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:48 +0000
Subject: [PATCH 0852/3799] soh: rename D_8082A6E0 ->
 sKaleidoPromptCursorAlphaVals

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_prompt.c.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_prompt.c   | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_prompt.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_prompt.c
index dbaaa1e1d..aa071be0f 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_prompt.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_prompt.c
@@ -1,6 +1,7 @@
 #include "z_kaleido_scope.h"
 
-static s16 D_8082A6E0[] = { 100, 255 };
+// Name from zeldaret/oot (was D_8082A6E0): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/misc/ovl_kaleido_scope/z_kaleido_prompt.c]
+static s16 sKaleidoPromptCursorAlphaVals[] = { 100, 255 };
 
 void KaleidoScope_UpdatePrompt(PlayState* play) {
     PauseContext* pauseCtx = &play->pauseCtx;
@@ -22,8 +23,8 @@ void KaleidoScope_UpdatePrompt(PlayState* play) {
             pauseCtx->promptChoice = 0;
         }
 
-        step = ABS(VREG(61) - D_8082A6E0[VREG(62)]) / VREG(63);
-        if (VREG(61) >= D_8082A6E0[VREG(62)]) {
+        step = ABS(VREG(61) - sKaleidoPromptCursorAlphaVals[VREG(62)]) / VREG(63);
+        if (VREG(61) >= sKaleidoPromptCursorAlphaVals[VREG(62)]) {
             VREG(61) -= step;
         } else {
             VREG(61) += step;
@@ -31,7 +32,7 @@ void KaleidoScope_UpdatePrompt(PlayState* play) {
 
         VREG(63)--;
         if (VREG(63) == 0) {
-            VREG(61) = D_8082A6E0[VREG(62)];
+            VREG(61) = sKaleidoPromptCursorAlphaVals[VREG(62)];
             VREG(63) = VREG(60) + VREG(62);
             VREG(62) ^= 1;
         }
-- 
2.55.0

