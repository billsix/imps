From 9d70c702b1868f02aa163891d8d45fd1dfff5370 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:50:06 +0000
Subject: [PATCH 1881/3799] soh: rename D_80B90E30 -> sWateredBean

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the one bean plant that has been watered this frame; a bean claims the slot so only one plays the growth cutscene, and clears it when it despawns.
Defined in soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Obj_Bean/z_obj_bean.c   | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
index 279d0b8c2..fe3dda12b 100644
--- a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
+++ b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
@@ -71,7 +71,8 @@ void ObjBean_WaitForStepOff(ObjBean* this, PlayState* play);
 #define BEAN_STATE_BEEN_WATERED (1 << 6)
 #define BEAN_STATE_PLAYER_ON_TOP (1 << 7)
 
-static ObjBean* D_80B90E30 = NULL;
+// LLM generated name (HIGH), was D_80B90E30: the one bean plant that has been watered this frame; a bean claims the slot so only one plays the growth cutscene, and clears it when it despawns.
+static ObjBean* sWateredBean = NULL;  // was D_80B90E30 [LLM:HIGH]
 
 const ActorInit Obj_Bean_InitVars = {
     ACTOR_OBJ_BEAN,
@@ -526,8 +527,8 @@ void ObjBean_Destroy(Actor* thisx, PlayState* play) {
     if (this->stateFlags & BEAN_STATE_COLLIDER_SET) {
         Collider_DestroyCylinder(play, &this->collider);
     }
-    if (D_80B90E30 == this) {
-        D_80B90E30 = NULL;
+    if (sWateredBean == this) {  // was D_80B90E30 [LLM:HIGH]
+        sWateredBean = NULL;  // was D_80B90E30 [LLM:HIGH]
     }
 }
 
@@ -635,18 +636,18 @@ void ObjBean_SetupWaitForWater(ObjBean* this) {
 void ObjBean_WaitForWater(ObjBean* this, PlayState* play) {
     this->transformFunc(this);
 
-    if (!(this->stateFlags & BEAN_STATE_BEEN_WATERED) && Flags_GetEnv(play, 5) && (D_80B90E30 == NULL) &&
+    if (!(this->stateFlags & BEAN_STATE_BEEN_WATERED) && Flags_GetEnv(play, 5) && (sWateredBean == NULL) &&  // was D_80B90E30 [LLM:HIGH]
         (this->dyna.actor.xzDistToPlayer < 50.0f)) {
         ObjBean_SetupGrowWaterPhase1(this);
-        D_80B90E30 = this;
+        sWateredBean = this;  // was D_80B90E30 [LLM:HIGH]
         OnePointCutscene_Init(play, 2210, -99, &this->dyna.actor, CAM_ID_MAIN);
         this->dyna.actor.flags |= ACTOR_FLAG_UPDATE_CULLING_DISABLED;
         return;
     }
 
-    if ((D_80B90E30 == this) && !Flags_GetEnv(play, 5)) {
-        D_80B90E30 = NULL;
-        if (D_80B90E30) {}
+    if ((sWateredBean == this) && !Flags_GetEnv(play, 5)) {  // was D_80B90E30 [LLM:HIGH]
+        sWateredBean = NULL;  // was D_80B90E30 [LLM:HIGH]
+        if (sWateredBean) {}  // was D_80B90E30 [LLM:HIGH]
     }
 }
 
