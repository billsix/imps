Subject: [PATCH 430/784] soh: rename func_80AEBCB8 -> EnRu1_StartBackSwimming

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.96.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 8a9fcfb0a..d26a85c39 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -624,7 +624,8 @@ void EnRu1_PlayGiggleSfx(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEBCB8(EnRu1* this, UNK_TYPE arg1) {
+// Name from zeldaret/oot (was func_80AEBCB8): adopted upstream's name for this address; body verified to match upstream at 0.96. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_StartBackSwimming(EnRu1* this, UNK_TYPE arg1) {
     if (arg1 != 0) {
         Animation_Change(&this->skelAnime, &gRutoChildSwimOnBackAnim, 1.0f, 0,
                          Animation_GetLastFrame(&gRutoChildSwimOnBackAnim), ANIMMODE_LOOP, -8.0f);
@@ -753,7 +754,7 @@ void func_80AEC1D4(EnRu1* this, PlayState* play) {
     EnRu1_UpdateBgCheckInfo(this, play);
     EnRu1_UpdateEyes(this);
     EnRu1_SpawnRippleTreading(this, play);
-    func_80AEBCB8(this, something);
+    EnRu1_StartBackSwimming(this, something);
     EnRu1_PlaySubmergeSfx(this);
     func_80AEBF60(this, play);
 }
@@ -766,7 +767,7 @@ void func_80AEC244(EnRu1* this, PlayState* play) {
     EnRu1_UpdateBgCheckInfo(this, play);
     EnRu1_UpdateEyes(this);
     EnRu1_SpawnRippleTreading(this, play);
-    func_80AEBCB8(this, something);
+    EnRu1_StartBackSwimming(this, something);
     EnRu1_PlaySwimStrokeSfx(this);
     func_80AEBFD8(this, play);
 }
