From eae76cc5b1f18144807ba1f0f404c1b97cf03f4d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:42 +0000
Subject: [PATCH 3123/3799] soh: rename D_8012345C -> sCs4000KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 4000 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 20c3dd865..ec209cb4b 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -1066,7 +1066,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
             break;
         case 4000:
-            csInfo->keyFrames = D_8012345C;
+            csInfo->keyFrames = sCs4000KeyFrames;  // was D_8012345C [LLM:HIGH]
             csInfo->keyFrameCnt = 4;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 1f7f8fca9..6855a8147 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -680,7 +680,8 @@ static OnePointCsFull sCs8604KeyFrames[5] = {  // was D_80123394 [LLM:HIGH]
     { 0x12, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_8012345C[4] = {
+// LLM generated name (HIGH), was D_8012345C: the keyframe set one-point cutscene 4000 installs
+static OnePointCsFull sCs4000KeyFrames[4] = {  // was D_8012345C [LLM:HIGH]
     { 0x01, 0x01, 0x4242, 40, 0, 40.0f, 1.0f, { 0.0f, 50.0f, -40.0f }, { 0.0f, 60.0f, -160.0f } },
     { 0x04, 0x4D, 0x4242, 40, 0, 60.0f, 0.3f, { 0.0f, 90.0f, -40.0f }, { 0.0f, 60.0f, -160.0f } },
     { 0x04, 0x01, 0x2121, 10, 0, 60.0f, 0.2f, { 0.0f, -10.0f, 10.0f }, { 0.0f, 10.0f, -80.0f } },
