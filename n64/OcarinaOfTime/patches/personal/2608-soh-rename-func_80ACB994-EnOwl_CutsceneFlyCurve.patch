         case 2:
             this->actor.draw = EnOwl_Draw;
-            EnOwl_ChangeMode(this, func_80ACB994, func_80ACC540, &this->skelAnime, &gOwlFlyAnim, 0.0f);
+            EnOwl_ChangeMode(this, EnOwl_CutsceneFlyCurve, func_80ACC540, &this->skelAnime, &gOwlFlyAnim, 0.0f);  // was func_80ACB994 [LLM:HIGH]
             break;
         case 3:
             this->actor.draw = NULL;
