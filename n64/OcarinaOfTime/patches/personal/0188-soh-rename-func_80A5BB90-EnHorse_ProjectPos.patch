From d6af155503351022f24ad131e8aa154079a994f4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:02:02 +0000
Subject: [PATCH 188/225] soh: rename func_80A5BB90 -> EnHorse_ProjectPos

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c b/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c
index 4a0991bca..5af2295ca 100644
--- a/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c
+++ b/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c
@@ -640,7 +640,8 @@ f32 EnHorse_SlopeSpeedMultiplier(EnHorse* this, PlayState* play) {
     return multiplier;
 }
 
-void func_80A5BB90(PlayState* play, Vec3f* vec, Vec3f* arg2, f32* arg3) {
+// LLM generated name (HIGH), was func_80A5BB90: projects a world pos through the view-projection matrix.
+void EnHorse_ProjectPos(PlayState* play, Vec3f* vec, Vec3f* arg2, f32* arg3) {
     SkinMatrix_Vec3fMtxFMultXYZW(&play->viewProjectionMtxF, vec, arg2, arg3);
 }
 
@@ -649,7 +650,7 @@ s32 func_80A5BBBC(PlayState* play, EnHorse* this, Vec3f* pos) {
     f32 sp20;
     f32 eyeDist;
 
-    func_80A5BB90(play, pos, &sp24, &sp20);
+    EnHorse_ProjectPos(play, pos, &sp24, &sp20);
     if (fabsf(sp20) < 0.008f) {
         return false;
     }
