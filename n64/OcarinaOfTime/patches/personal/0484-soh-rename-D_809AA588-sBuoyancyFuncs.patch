From 8cc6bb2cf2cd2eb22262491e293f53bfcfa5cfe1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:41 +0000
Subject: [PATCH 484/488] soh: rename D_809AA588 -> sBuoyancyFuncs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-mode functions EffectSsKakera picks between to compute a shard's buoyancy from its distance
Defined in soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c   | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
index f71f97d4d..35c49f936 100644
--- a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
+++ b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
@@ -287,7 +287,7 @@ s32 EffectSsKakera_ApplyRepulsion(EffectSs* this, Vec3f* diff, f32 dist) {
 
 // LLM generated name (HIGH), was func_809A9FD8: the fourth pass: picks a falloff function from the behaviour flags and scales the accumulated acceleration by it, with a random jitter.
 s32 EffectSsKakera_ApplyDrag(EffectSs* this, Vec3f* diff, f32 dist) {
-    static f32 (*D_809AA588[])(f32 dist, s32 arg1) = {
+    static f32 (*sBuoyancyFuncs[])(f32 dist, s32 arg1) = {  // was D_809AA588 [LLM:HIGH]
         EffectSsKakera_DragNone, EffectSsKakera_DragLinear, EffectSsKakera_DragLinear, EffectSsKakera_DragLinear, EffectSsKakera_DragSquared,  // was func_809A9DD8 [LLM:HIGH]
         EffectSsKakera_DragSquared, EffectSsKakera_DragSquared, EffectSsKakera_DragSquared2, EffectSsKakera_DragSquared2, EffectSsKakera_DragSquared2,  // was func_809A9E28 [LLM:HIGH]
     };
@@ -295,7 +295,7 @@ s32 EffectSsKakera_ApplyDrag(EffectSs* this, Vec3f* diff, f32 dist) {
     s32 temp_a1;
 
     temp_a1 = (this->rReg0 >> 7) & 0xF;
-    temp_f0 = D_809AA588[temp_a1](dist, temp_a1);
+    temp_f0 = sBuoyancyFuncs[temp_a1](dist, temp_a1);  // was D_809AA588 [LLM:HIGH]
     temp_f0 = EffectSsKakera_RandCentered(temp_f0, (this->rReg9 * temp_f0) / 1024.0f);  // was func_809A9818 [LLM:HIGH]
 
     this->accel.x *= temp_f0;
-- 
