     }
 }
 
-void func_80B3F7BC(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B3F7BC: on cue 4 action 9, stops drawing Sheik and enters action 52
+void EnXc_HideOnCue9(EnXc* this, PlayState* play) {
     if (EnXc_CompareCsAction(this, play, 9, 4)) {
         this->action = SHEIK_ACTION_52;
         this->drawMode = SHEIK_DRAW_NOTHING;
@@ -1616,7 +1617,7 @@ void EnXc_ActionFunc51(EnXc* this, PlayState* play) {
     EnXc_BgCheck(this, play);
