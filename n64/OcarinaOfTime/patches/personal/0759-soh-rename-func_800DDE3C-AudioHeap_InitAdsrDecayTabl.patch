From b62d66afbf39104e2e8475ad93053df1120fdb7d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:43:46 +0000
Subject: [PATCH 759/784] soh: rename func_800DDE3C ->
 AudioHeap_InitAdsrDecayTable

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/audio_heap.c.
---
 soh/src/code/audio_heap.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_heap.c b/soh/src/code/audio_heap.c
index 09831eff9..759d2dac4 100644
--- a/soh/src/code/audio_heap.c
+++ b/soh/src/code/audio_heap.c
@@ -15,7 +15,8 @@ f32 AudioHeap_CalculateAdsrDecay(f32 arg0) {
     return 256.0f * gAudioContext.audioBufferParameters.unkUpdatesPerFrameScaled / arg0;
 }
 
-void func_800DDE3C(void) {
+// Name from zeldaret/oot (was func_800DDE3C): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/audio_heap.c]
+void AudioHeap_InitAdsrDecayTable(void) {
     s32 i;
 
     gAudioContext.unk_3520[255] = AudioHeap_CalculateAdsrDecay(0.25f);
@@ -908,7 +909,7 @@ void AudioHeap_Init(void) {
     }
 
     gAudioContext.unk_3520 = AudioHeap_Alloc(&gAudioContext.notesAndBuffersPool, 0x100 * sizeof(f32));
-    func_800DDE3C();
+    AudioHeap_InitAdsrDecayTable();
     for (i = 0; i < 4; i++) {
         gAudioContext.synthesisReverbs[i].useReverb = 0;
     }
-- 
