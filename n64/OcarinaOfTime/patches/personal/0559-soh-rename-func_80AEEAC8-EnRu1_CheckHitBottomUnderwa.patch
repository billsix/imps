Subject: [PATCH 559/784] soh: rename func_80AEEAC8 ->
 EnRu1_CheckHitBottomUnderwater

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.91.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 1e8ce6638..b4006f3c8 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1769,7 +1769,8 @@ void EnRu1_UpdateCarriedBehavior(EnRu1* this, PlayState* play) {
     }
 }
 
-s32 func_80AEEAC8(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEEAC8): adopted upstream's name for this address; body verified to match upstream at 0.91. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_CheckHitBottomUnderwater(EnRu1* this, PlayState* play) {
     if (this->actor.bgCheckFlags & BGCHECKFLAG_GROUND) {
         EnRu1_StopMoving(this);
         Actor_OfferCarry(&this->actor, play);
@@ -1781,7 +1782,7 @@ s32 func_80AEEAC8(EnRu1* this, PlayState* play) {
 }
 
 void func_80AEEB24(EnRu1* this, PlayState* play) {
-    if ((func_80AEEAC8(this, play) == 0) && (this->waterState == 3)) {
+    if ((EnRu1_CheckHitBottomUnderwater(this, play) == 0) && (this->waterState == 3)) {
         this->action = 30;
         EnRu1_StopMoving(this);
         this->actor.gravity = -0.1f;
@@ -1835,7 +1836,7 @@ void func_80AEED58(EnRu1* this, PlayState* play) {
     Actor_MoveXZGravity(&this->actor);
     EnRu1_UpdateSkelAnime(this);
     EnRu1_UpdateEyes(this);
-    func_80AEEAC8(this, play);
+    EnRu1_CheckHitBottomUnderwater(this, play);
     func_80AED624(this, play);
     EnRu1_ResetBgCheckFlags(this, play);
 }
