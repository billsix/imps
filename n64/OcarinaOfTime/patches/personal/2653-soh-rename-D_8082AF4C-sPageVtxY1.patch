From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:41 +0000
Subject: [PATCH 2653/3799] soh: rename D_8082AF4C -> sPageVtxY1

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the Y offsets in slot 1 of the sPageVtxY table
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index df064a7f0..681295c2a 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2656,7 +2656,8 @@ static s16 sPageVtxY0[] = {  // was D_8082AF48 [LLM:HIGH]
     0x0000,
     0x0000,
 };
-static s16 D_8082AF4C[] = {
+// LLM generated name (HIGH), was D_8082AF4C: the Y offsets in slot 1 of the sPageVtxY table
+static s16 sPageVtxY1[] = {  // was D_8082AF4C [LLM:HIGH]
     0x0000,
     0x0000,
 };
@@ -2705,7 +2706,7 @@ static s16* D_8082B018[] = {
 };
 
 static s16* D_8082B030[] = {
-    sPageVtxY0, D_8082AF4C, D_8082AF50, D_8082AF74, D_8082AF78, D_8082AFB8,  // was D_8082AF48 [LLM:HIGH]
+    sPageVtxY0, sPageVtxY1, D_8082AF50, D_8082AF74, D_8082AF78, D_8082AFB8,  // was D_8082AF48 [LLM:HIGH]
 };
 
 static s16* D_8082B048[] = {
