 void Audio_PlaySfxAtInterval(Vec3f* pos, u16 sfxId, f32);  // was func_800F4414 [LLM:HIGH]
-void func_800F44EC(s8 arg0, s8 arg1);
+void Audio_SetSfxIntervalRange(s8 arg0, s8 arg1);  // was func_800F44EC [LLM:HIGH]
