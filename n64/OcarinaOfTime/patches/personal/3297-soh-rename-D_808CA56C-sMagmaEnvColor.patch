From 8eff037070cb71c10620b2b43e55d8cabe808a6a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:55 +0000
Subject: [PATCH 3297/3799] soh: rename D_808CA56C -> sMagmaEnvColor

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the env colour of those same puffs
Defined in soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c b/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
index d9164498a..996e5319c 100644
--- a/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
+++ b/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
@@ -1885,12 +1885,12 @@ void BossDodongo_DeathCutscene(BossDodongo* this, PlayState* play) {
             if ((this->unk_1DA < 0x2C6) && (Rand_ZeroOne() < 0.5f)) {
                 Vec3f sp68;
                 Color_RGBA8 sMagmaPrimColor = { 0, 0, 0, 100 };  // was D_808CA568 [LLM:HIGH]
-                Color_RGBA8 D_808CA56C = { 0, 0, 0, 0 };
+                Color_RGBA8 sMagmaEnvColor = { 0, 0, 0, 0 };  // was D_808CA56C [LLM:HIGH]
 
                 sp68.x = Rand_CenteredFloat(60.0f) + this->actor.focus.pos.x;
                 sp68.y = (Rand_ZeroOne() * 50.0f) + -1498.76f;
                 sp68.z = Rand_CenteredFloat(60.0f) + this->actor.focus.pos.z;
-                EffectSsGMagma2_Spawn(play, &sp68, &sMagmaPrimColor, &D_808CA56C, 5, 1, (s16)(Rand_ZeroOne() * 50.0f) + 50);  // was D_808CA568 [LLM:HIGH]
+                EffectSsGMagma2_Spawn(play, &sp68, &sMagmaPrimColor, &sMagmaEnvColor, 5, 1, (s16)(Rand_ZeroOne() * 50.0f) + 50);  // was D_808CA568 [LLM:HIGH]
             }
             break;
     }
