From 32d51bd41ae47b4cd7f82a224d3248f43aea16f9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:09 +0000
Subject: [PATCH 2432/3799] soh: rename func_80ADEC9C -> EnPoh_Approach

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: closes on the player, turning to face them and speeding up for the strike
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index 227f1d5d0..24d1fe598 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -25,7 +25,8 @@ void EnPoh_DrawSoul(Actor* thisx, PlayState* play);
 // LLM generated name (HIGH), was func_80ADEAC4: hovers at the player's height until the player comes within 200 units or the timer runs out
 void EnPoh_Hover(EnPoh* this, PlayState* play);  // was func_80ADEAC4 [LLM:HIGH]
 void EnPoh_Idle(EnPoh* this, PlayState* play);
-void func_80ADEC9C(EnPoh* this, PlayState* play);
+// LLM generated name (HIGH), was func_80ADEC9C: closes on the player, turning to face them and speeding up for the strike
+void EnPoh_Approach(EnPoh* this, PlayState* play);  // was func_80ADEC9C [LLM:HIGH]
 void EnPoh_Attack(EnPoh* this, PlayState* play);
 void func_80ADEECC(EnPoh* this, PlayState* play);
 void func_80ADF894(EnPoh* this, PlayState* play);
@@ -277,7 +278,7 @@ void EnPoh_SetupIdle(EnPoh* this) {
 // LLM generated name (HIGH), was func_80ADE1BC: loops the second idle animation and starts drifting at speed 2
 void EnPoh_SetupApproach(EnPoh* this) {
     Animation_PlayLoop(&this->skelAnime, this->info->idleAnim2);
-    this->actionFunc = func_80ADEC9C;
+    this->actionFunc = EnPoh_Approach;  // was func_80ADEC9C [LLM:HIGH]
     this->unk_198 = 0;
     this->actor.speedXZ = 2.0f;
 }
@@ -531,7 +532,7 @@ void EnPoh_Idle(EnPoh* this, PlayState* play) {
     }
 }
 
-void func_80ADEC9C(EnPoh* this, PlayState* play) {
+void EnPoh_Approach(EnPoh* this, PlayState* play) {
     Player* player;
     s16 facingDiff;
 
@@ -909,13 +910,13 @@ void EnPoh_UpdateVisibility(EnPoh* this) {
             }
             if ((this->unk_194 == 20 || this->visibilityTimer == 0) &&
                 (this->actionFunc == EnPoh_Hover || this->actionFunc == EnPoh_Idle ||  // was func_80ADEAC4 [LLM:HIGH]
-                 this->actionFunc == func_80ADEC9C || this->actionFunc == func_80ADF894 ||
+                 this->actionFunc == EnPoh_Approach || this->actionFunc == func_80ADF894 ||  // was func_80ADEC9C [LLM:HIGH]
                  this->actionFunc == func_80ADF5E0)) {
                 EnPoh_SetupDisappear(this);
             }
         } else if (this->lightColor.a == 0 && this->visibilityTimer == 0 &&
                    (this->actionFunc == EnPoh_Hover || this->actionFunc == EnPoh_Idle ||  // was func_80ADEAC4 [LLM:HIGH]
-                    this->actionFunc == func_80ADEC9C || this->actionFunc == func_80ADF5E0)) {
+                    this->actionFunc == EnPoh_Approach || this->actionFunc == func_80ADF5E0)) {  // was func_80ADEC9C [LLM:HIGH]
             EnPoh_SetupAppear(this);
         }
     }
