+            sJabuJabuWobblePhase += 0.15f + (play->roomCtx.unk_74[1] * 0.001f);  // was D_8012A398 [LLM:HIGH]
         }
     }
 
     if (play->roomCtx.curRoom.num == 2) {
-        Matrix_Scale(1.0f, sinf(D_8012A398) * 0.8f, 1.0f, MTXMODE_NEW);
+        Matrix_Scale(1.0f, sinf(sJabuJabuWobblePhase) * 0.8f, 1.0f, MTXMODE_NEW);  // was D_8012A398 [LLM:HIGH]
     } else {
-        Matrix_Scale(1.005f, sinf(D_8012A398) * 0.8f, 1.005f, MTXMODE_NEW);
+        Matrix_Scale(1.005f, sinf(sJabuJabuWobblePhase) * 0.8f, 1.005f, MTXMODE_NEW);  // was D_8012A398 [LLM:HIGH]
