From b5b579eb2d5b034e996f7f6eaf17ea03d2155aae Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:46 +0000
Subject: [PATCH 450/784] soh: rename func_80AED084 -> EnRu1_CheckBlueWarpState

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index ceb887ff8..71eebd5e4 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1115,7 +1115,8 @@ s32 EnRu1_IsLinkInBlueWarp(EnRu1* this, PlayState* play) {
     return false;
 }
 
-s32 func_80AED084(EnRu1* this, s32 state) {
+// Name from zeldaret/oot (was func_80AED084): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_CheckBlueWarpState(EnRu1* this, s32 state) {
     if (this->blueWarp != NULL && this->blueWarp->rutoWarpState == state) {
         return true;
     }
@@ -1149,7 +1150,7 @@ void func_80AED110(EnRu1* this) {
 }
 
 void func_80AED154(EnRu1* this, PlayState* play) {
-    if (func_80AED084(this, WARP_BLUE_RUTO_STATE_ENTERED)) {
+    if (EnRu1_CheckBlueWarpState(this, WARP_BLUE_RUTO_STATE_ENTERED)) {
         this->action = 0x13;
         this->walkingFrame = 0.0f;
         EnRu1_SetPlayerMarkInBlueWarp(this, play);
@@ -1167,12 +1168,12 @@ void func_80AED19C(EnRu1* this, s32 cond) {
 }
 
 void func_80AED218(EnRu1* this, UNK_TYPE arg1) {
-    if (func_80AED084(this, WARP_BLUE_RUTO_STATE_TALKING)) {
+    if (EnRu1_CheckBlueWarpState(this, WARP_BLUE_RUTO_STATE_TALKING)) {
         if (arg1 != 0) {
             Animation_Change(&this->skelAnime, &gRutoChildWaitSittingAnim, 1.0f, 0,
                              Animation_GetLastFrame(&gRutoChildWaitSittingAnim), ANIMMODE_LOOP, -8.0f);
         }
-    } else if (func_80AED084(this, WARP_BLUE_RUTO_STATE_WARPING)) {
+    } else if (EnRu1_CheckBlueWarpState(this, WARP_BLUE_RUTO_STATE_WARPING)) {
         Animation_Change(&this->skelAnime, &gRutoChildWaitInBlueWarpAnim, 1.0f, 0,
                          Animation_GetLastFrame(&gRutoChildWaitInBlueWarpAnim), ANIMMODE_ONCE, -8.0f);
         this->action = 21;
-- 
2.55.0

