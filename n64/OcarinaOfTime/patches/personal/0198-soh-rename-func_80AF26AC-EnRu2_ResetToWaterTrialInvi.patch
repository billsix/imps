From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:33 +0000
Subject: [PATCH 0198/3799] soh: rename func_80AF26AC ->
 EnRu2_ResetToWaterTrialInvisible

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c b/soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c
index 55ee95830..b4a16e826 100644
--- a/soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c
+++ b/soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c
@@ -185,7 +185,8 @@ s32 EnRu2_GetType(EnRu2* this) {
     return params & 0xFF;
 }
 
-void func_80AF26AC(EnRu2* this) {
+// LLM generated name (HIGH), was func_80AF26AC: resets action to WATER_TRIAL_INVISIBLE with alpha/shadow zeroed
+void EnRu2_ResetToWaterTrialInvisible(EnRu2* this) {
     this->action = ENRU2_WATER_TRIAL_INVISIBLE;
     this->drawConfig = ENRU2_DRAW_NOTHING;
     this->alpha = 0;
@@ -201,7 +202,7 @@ void func_80AF26D0(EnRu2* this, PlayState* play) {
         if (sWasCutscenePlaying != 0) {
             // Seems like this state is never reached
             if (this->actor.params == 2) {
-                func_80AF26AC(this);
+                EnRu2_ResetToWaterTrialInvisible(this);
             }
             sWasCutscenePlaying = 0;
             return;
