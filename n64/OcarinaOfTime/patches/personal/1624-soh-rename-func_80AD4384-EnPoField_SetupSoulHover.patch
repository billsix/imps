Date: Mon, 7 Sep 2026 22:31:18 +0000
Subject: [PATCH 1624/3799] soh: rename func_80AD4384 ->
 EnPoField_SetupSoulHover

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sizes the soul's collider, arms the 400-frame lifetime and enables targeting before installing the hovering action.
Defined in soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
index 9d2cdb81c..f5a8176bb 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
@@ -352,7 +352,8 @@ void EnPoField_SetupSoulAppear(EnPoField* this) {
     this->actionFunc = EnPoField_SoulAppear;  // was func_80AD587C [LLM:HIGH]
 }
 
-void func_80AD4384(EnPoField* this) {
+// LLM generated name (HIGH), was func_80AD4384: sizes the soul's collider, arms the 400-frame lifetime and enables targeting before installing the hovering action.
+void EnPoField_SetupSoulHover(EnPoField* this) {
     this->actor.home.pos.y = this->actor.world.pos.y;
     Actor_SetFocus(&this->actor, -10.0f);
     this->collider.dim.radius = 13;
@@ -663,7 +664,7 @@ void EnPoField_SoulAppear(EnPoField* this, PlayState* play) {
     this->actor.home.pos.y += 2.0f;
     EnPoField_SoulUpdateProperties(this, 20);
     if (this->lightColor.a == 255) {
-        func_80AD4384(this);
+        EnPoField_SetupSoulHover(this);  // was func_80AD4384 [LLM:HIGH]
     }
 }
 
