From c63509fd9b9abd5433979f0f0813f2445ddbb6a4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:54 +0000
Subject: [PATCH 3280/3799] soh: rename D_8094A9E0 -> sRightScepterOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same reach along limb 40 for the right scepter
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index 41cc1494a..ed20f126d 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -3646,7 +3646,7 @@ void BossTw_TwinrovaPostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Ve
     static Vec3f sTwinrovaFocusOffset = { 0.0f, 0.0f, 0.0f };  // was D_8094A9BC [LLM:HIGH]
     static Vec3f sTwinrovaCrownOffset = { 0.0f, 2000.0f, -2000.0f };  // was D_8094A9C8 [LLM:HIGH]
     static Vec3f sLeftScepterOffset = { 13000.0f, 0.0f, 0.0f };  // was D_8094A9D4 [LLM:HIGH]
-    static Vec3f D_8094A9E0 = { 13000.0f, 0.0f, 0.0f };
+    static Vec3f sRightScepterOffset = { 13000.0f, 0.0f, 0.0f };  // was D_8094A9E0 [LLM:HIGH]
 
     BossTw* this = (BossTw*)thisx;
 
@@ -3657,7 +3657,7 @@ void BossTw_TwinrovaPostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Ve
             Matrix_MultVec3f(&sLeftScepterOffset, &this->leftScepterPos);  // was D_8094A9D4 [LLM:HIGH]
             break;
         case 40:
-            Matrix_MultVec3f(&D_8094A9E0, &this->rightScepterPos);
+            Matrix_MultVec3f(&sRightScepterOffset, &this->rightScepterPos);  // was D_8094A9E0 [LLM:HIGH]
             break;
         case 21:
             Matrix_MultVec3f(&sTwinrovaFocusOffset, &this->actor.focus.pos);  // was D_8094A9BC [LLM:HIGH]
-- 
