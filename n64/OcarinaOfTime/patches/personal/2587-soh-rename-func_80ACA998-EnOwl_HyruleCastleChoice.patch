From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:41:09 +0000
Subject: [PATCH 2587/3799] soh: rename func_80ACA998 ->
 EnOwl_HyruleCastleChoice

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the repeat or accept choice on the Hyrule Castle owl's message, texts 0x2069 and 0x206B
Defined in soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
index 32396bbf5..bdd764890 100644
--- a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
+++ b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
@@ -402,7 +402,8 @@ void EnOwl_WaitOutsideKokiri(EnOwl* this, PlayState* play) {
     }
 }
 
-void func_80ACA998(EnOwl* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80ACA998: the repeat or accept choice on the Hyrule Castle owl's message, texts 0x2069 and 0x206B
+void EnOwl_HyruleCastleChoice(EnOwl* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_CHOICE && Message_ShouldAdvance(play)) {
         // swap the order of the responses if better owl is enabled
         switch (play->msgCtx.choiceIndex) {
@@ -423,7 +424,7 @@ void func_80ACA998(EnOwl* this, PlayState* play) {
 void func_80ACAA54(EnOwl* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT && Message_ShouldAdvance(play)) {
         Message_ContinueTextbox(play, 0x206A);
-        this->actionFunc = func_80ACA998;
+        this->actionFunc = EnOwl_HyruleCastleChoice;  // was func_80ACA998 [LLM:HIGH]
         this->actionFlags |= 2;
         EnOwl_StartHeadTurn(this);  // was func_80ACA71C [LLM:HIGH]
     }
