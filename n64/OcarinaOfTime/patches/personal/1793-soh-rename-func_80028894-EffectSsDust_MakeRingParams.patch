From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:43:30 +0000
Subject: [PATCH 1793/3799] soh: rename func_80028894 ->
 EffectSsDust_MakeRingParams

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: picks a random point on a circle of the given radius around the source, and fills in the upward velocity and acceleration for one puff of a ring burst.
Defined in soh/src/code/z_effect_soft_sprite_old_init.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_effect_soft_sprite_old_init.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_effect_soft_sprite_old_init.c b/soh/src/code/z_effect_soft_sprite_old_init.c
index 00a429119..7cf37feb8 100644
--- a/soh/src/code/z_effect_soft_sprite_old_init.c
+++ b/soh/src/code/z_effect_soft_sprite_old_init.c
@@ -189,7 +189,8 @@ void EffectSsDust_SpawnDrawFlags1Default(PlayState* play, Vec3f* pos, Vec3f* vel
     EffectSsDust_SpawnDrawFlags1(play, pos, velocity, accel, primColor, envColor, 100, 5);  // was func_80028304 [LLM:HIGH]
 }
 
-void func_80028894(Vec3f* srcPos, f32 randScale, Vec3f* newPos, Vec3f* velocity, Vec3f* accel) {
+// LLM generated name (HIGH), was func_80028894: picks a random point on a circle of the given radius around the source, and fills in the upward velocity and acceleration for one puff of a ring burst.
+void EffectSsDust_MakeRingParams(Vec3f* srcPos, f32 randScale, Vec3f* newPos, Vec3f* velocity, Vec3f* accel) {
     s16 randAngle;
     f32 rand = Rand_ZeroOne() * randScale;
 
@@ -216,7 +217,7 @@ void func_80028990(PlayState* play, f32 randScale, Vec3f* srcPos) {
     Vec3f accel;
 
     for (i = 0; i < 20; i++) {
-        func_80028894(srcPos, randScale, &pos, &velocity, &accel);
+        EffectSsDust_MakeRingParams(srcPos, randScale, &pos, &velocity, &accel);  // was func_80028894 [LLM:HIGH]
         EffectSsDust_SpawnBrown4ScaledLife(play, &pos, &velocity, &accel, 100, 30, 7);  // was func_8002873C [LLM:HIGH]
     }
 }
@@ -228,7 +229,7 @@ void func_80028A54(PlayState* play, f32 randScale, Vec3f* srcPos) {
     Vec3f accel;
 
     for (i = 0; i < 20; i++) {
-        func_80028894(srcPos, randScale, &pos, &velocity, &accel);
+        EffectSsDust_MakeRingParams(srcPos, randScale, &pos, &velocity, &accel);  // was func_80028894 [LLM:HIGH]
         EffectSsDust_SpawnBrown5ScaledLife(play, &pos, &velocity, &accel, 100, 30, 7);  // was func_800287AC [LLM:HIGH]
     }
 }
