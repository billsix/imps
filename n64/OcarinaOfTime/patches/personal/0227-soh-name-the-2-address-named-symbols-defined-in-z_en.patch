+static ColliderCylinderInit sHurtCylinderInit = {  // was D_80A4B7CC [LLM:HIGH]
     {
         COLTYPE_HIT3,
         AT_NONE,
@@ -173,9 +175,9 @@ void EnGoma_Init(Actor* thisx, PlayState* play) {
         this->eggSquishAngle = Rand_ZeroOne() * 1000.0f;
         this->actionTimer = 50;
         Collider_InitCylinder(play, &this->colCyl1);
