Subject: [PATCH 1853/3799] soh: rename func_80AEBC30 -> EnRu1_PlayDiveSfx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays the dive-into-water sfx on one fixed cutscene frame.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 73b308757..39aca3b13 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -681,7 +681,8 @@ void EnRu1_PlaySubmergeSfx(EnRu1* this) {
     }
 }
 
-void func_80AEBC30(PlayState* play) {
+// LLM generated name (HIGH), was func_80AEBC30: plays the dive-into-water sfx on one fixed cutscene frame.
+void EnRu1_PlayDiveSfx(PlayState* play) {
     Player* player;
 
     if (play->csCtx.frames == 0xCD) {
@@ -803,7 +804,7 @@ void EnRu1_Fountain_GazingAtLink(EnRu1* this, PlayState* play) {
     EnRu1_SnapToFountainCue(this, play);  // was func_80AEB89C [LLM:HIGH]
     EnRu1_UpdateSkelAnime(this);
     EnRu1_PlayGiggleSfx(this, play);
-    func_80AEBC30(play);
+    EnRu1_PlayDiveSfx(play);  // was func_80AEBC30 [LLM:HIGH]
     EnRu1_EnterFountainWater(this, play);
 }
 
