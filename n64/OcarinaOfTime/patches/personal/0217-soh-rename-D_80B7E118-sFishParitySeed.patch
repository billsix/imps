From 050eef30a643625bae5f6b9665a079933585ee29 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:35 +0000
Subject: [PATCH 217/784] soh: rename D_80B7E118 -> sFishParitySeed

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_Fishing/z_fishing.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_Fishing/z_fishing.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
index 8ef023e55..1612b09ad 100644
--- a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
+++ b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
@@ -396,7 +396,8 @@ static f32 sLureRotXStep;
 // LLM generated name (HIGH), was D_80B7E114: s8 set to 10 on bite, decremented; gates bite handling
 static s8 sLureBiteTimer;
 static s16 sRodPullback; // holding A+Down to keep the fish on line
-static u8 D_80B7E118;
+// LLM generated name (HIGH), was D_80B7E118: random 0/1 seed added before &1 parity tests on params/pos
+static u8 sFishParitySeed;
 static f32 sRodReelingSpeed;
 static u8 sWiggleAttraction;
 static s16 sLureBitTimer;
@@ -2275,7 +2276,7 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
                     D_80B7E148 = 0.0f;
                     sReelLockTimer = 5;
                     sRodReelingSpeed = 0.5f;
-                    D_80B7E118 = Rand_ZeroFloat(1.9f);
+                    sFishParitySeed = Rand_ZeroFloat(1.9f);
                     sFishMouthOffset.y = 500.0f;
                     Sfx_PlaySfxAtPos(&sSoundPos, NA_SE_IT_SWORD_SWING_HARD);
                 }
@@ -3320,7 +3321,7 @@ void Fishing_UpdateFish(Actor* thisx, PlayState* play2) {
             break;
 
         case 2:
-            if (((this->actor.params + D_80B7E118) & 1) != 0) {
+            if (((this->actor.params + sFishParitySeed) & 1) != 0) {
                 multiVecSrc.x = 10.0f;
             } else {
                 multiVecSrc.x = -10.0f;
@@ -3451,7 +3452,7 @@ void Fishing_UpdateFish(Actor* thisx, PlayState* play2) {
             this->lilyTimer = 6;
             rotXYScale = 2;
 
-            if ((((s16)player->actor.world.pos.x + D_80B7E118) & 1) != 0) {
+            if ((((s16)player->actor.world.pos.x + sFishParitySeed) & 1) != 0) {
                 multiVecSrc.x = 30.0f;
             } else {
                 multiVecSrc.x = -30.0f;
