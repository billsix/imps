From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:40 +0000
Subject: [PATCH 3623/3799] soh: rename func_80B54360 -> EnZl3_StepHairPitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the spring driven with sp30.x in EnZl3_OverrideLimbDrawHair, coupling each joint to the one above it via the unk_25C index chain
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index bdeef1096..b3c32d637 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -564,7 +564,8 @@ void EnZl3_StepHairRoll(EnZl3* this, s16 z, s32 idx) {
     this->unk_2BC[idx] = z;
 }
 
-void func_80B54360(EnZl3* this, s16 arg1, s32 arg2) {
+// LLM generated name (HIGH), was func_80B54360: the spring driven with sp30.x in EnZl3_OverrideLimbDrawHair, coupling each joint to the one above it via the unk_25C index chain
+void EnZl3_StepHairPitch(EnZl3* this, s16 arg1, s32 arg2) {
     if (this->unk_2FC != 0) {
         s32 temp_v1 = this->unk_28C[arg2] - arg1;
         s16 temp_t0 = temp_v1;
@@ -655,7 +656,7 @@ s32 func_80B5458C(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s
         Matrix_MtxFToYXZRotS(&sp38, &sp30, 0);
         if (!FrameAdvance_IsEnabled(play)) {
             EnZl3_StepHairYaw(this, sp30.y, 0);  // was func_80B53980 [LLM:HIGH]
-            func_80B54360(this, sp30.x, 1);
+            EnZl3_StepHairPitch(this, sp30.x, 1);  // was func_80B54360 [LLM:HIGH]
             EnZl3_StepHairRoll(this, sp30.z, 2);  // was func_80B53B64 [LLM:HIGH]
         }
         Matrix_RotateZYX(unk_28C[0] + kREG(31), unk_28C[1] + kREG(32), unk_28C[2] + kREG(33), MTXMODE_APPLY);
@@ -672,7 +673,7 @@ s32 func_80B5458C(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s
         Matrix_Get(&sp38);
         Matrix_MtxFToYXZRotS(&sp38, &sp30, 0);
         if (!FrameAdvance_IsEnabled(play)) {
-            func_80B54360(this, sp30.x, 7);
+            EnZl3_StepHairPitch(this, sp30.x, 7);  // was func_80B54360 [LLM:HIGH]
         }
         Matrix_RotateZYX(unk_28C[6] + kREG(37), unk_28C[7] + kREG(38), unk_28C[8] + kREG(39), MTXMODE_APPLY);
         Matrix_Translate(-1019.0f, -26.0f, 0.0f, MTXMODE_APPLY);
@@ -684,7 +685,7 @@ s32 func_80B5458C(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s
         Matrix_MtxFToYXZRotS(&sp38, &sp30, 0);
         if (!FrameAdvance_IsEnabled(play)) {
             EnZl3_StepHairYaw(this, sp30.y, 9);  // was func_80B53980 [LLM:HIGH]
-            func_80B54360(this, sp30.x, 10);
+            EnZl3_StepHairPitch(this, sp30.x, 10);  // was func_80B54360 [LLM:HIGH]
             EnZl3_StepHairRoll(this, sp30.z, 11);  // was func_80B53B64 [LLM:HIGH]
         }
         Matrix_RotateZYX(unk_28C[9] + kREG(40), unk_28C[10] + kREG(41), unk_28C[11] + kREG(42), MTXMODE_APPLY);
@@ -694,7 +695,7 @@ s32 func_80B5458C(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s
         Matrix_MtxFToYXZRotS(&sp38, &sp30, 0);
         if (!FrameAdvance_IsEnabled(play)) {
             EnZl3_StepHairYaw(this, sp30.y, 12);  // was func_80B53980 [LLM:HIGH]
-            func_80B54360(this, sp30.x, 13);
+            EnZl3_StepHairPitch(this, sp30.x, 13);  // was func_80B54360 [LLM:HIGH]
             EnZl3_StepHairRoll(this, sp30.z, 14);  // was func_80B53B64 [LLM:HIGH]
         }
         Matrix_RotateZYX(unk_28C[12] + kREG(43), unk_28C[13] + kREG(44), unk_28C[14] + kREG(45), MTXMODE_APPLY);
@@ -707,7 +708,7 @@ s32 func_80B5458C(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s
         Matrix_MtxFToYXZRotS(&sp38, &sp30, 0);
         if (!FrameAdvance_IsEnabled(play)) {
             EnZl3_StepHairYaw(this, sp30.y, 15);  // was func_80B53980 [LLM:HIGH]
-            func_80B54360(this, sp30.x, 16);
+            EnZl3_StepHairPitch(this, sp30.x, 16);  // was func_80B54360 [LLM:HIGH]
             EnZl3_StepHairRoll(this, sp30.z, 17);  // was func_80B53B64 [LLM:HIGH]
         }
         Matrix_RotateZYX(unk_28C[15] + kREG(46), unk_28C[16] + kREG(47), unk_28C[17] + kREG(48), MTXMODE_APPLY);
@@ -717,7 +718,7 @@ s32 func_80B5458C(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s
         Matrix_MtxFToYXZRotS(&sp38, &sp30, 0);
         if (!FrameAdvance_IsEnabled(play)) {
             EnZl3_StepHairYaw(this, sp30.y, 18);  // was func_80B53980 [LLM:HIGH]
-            func_80B54360(this, sp30.x, 19);
+            EnZl3_StepHairPitch(this, sp30.x, 19);  // was func_80B54360 [LLM:HIGH]
             EnZl3_StepHairRoll(this, sp30.z, 20);  // was func_80B53B64 [LLM:HIGH]
         }
         Matrix_RotateZYX(unk_28C[18] + kREG(49), unk_28C[19] + kREG(50), unk_28C[20] + kREG(51), MTXMODE_APPLY);
