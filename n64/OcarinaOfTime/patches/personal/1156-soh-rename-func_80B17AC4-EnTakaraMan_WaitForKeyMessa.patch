From 7d1144ae879782ba4fe49068706cf8c01531476f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:54:05 +0000
Subject: [PATCH 1156/3799] soh: rename func_80B17AC4 ->
 EnTakaraMan_WaitForKeyMessage

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: waits out the get-item textbox after the key is handed over, then returns to the idle setup.
Defined in soh/src/overlays/actors/ovl_En_Takara_Man/z_en_takara_man.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Takara_Man/z_en_takara_man.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Takara_Man/z_en_takara_man.c b/soh/src/overlays/actors/ovl_En_Takara_Man/z_en_takara_man.c
index bf992a7d9..d6ee4c866 100644
--- a/soh/src/overlays/actors/ovl_En_Takara_Man/z_en_takara_man.c
+++ b/soh/src/overlays/actors/ovl_En_Takara_Man/z_en_takara_man.c
@@ -30,7 +30,8 @@ void func_80B17B14(EnTakaraMan* this, PlayState* play);
 void EnTakaraMan_HandlePlayChoice(EnTakaraMan* this, PlayState* play);  // was func_80B17934 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80B17A6C: keeps re-offering GI_DOOR_KEY until Actor_HasParent reports the player took it.
 void EnTakaraMan_OfferKey(EnTakaraMan* this, PlayState* play);  // was func_80B17A6C [LLM:HIGH]
-void func_80B17AC4(EnTakaraMan* this, PlayState* play);
+// LLM generated name (HIGH), was func_80B17AC4: waits out the get-item textbox after the key is handed over, then returns to the idle setup.
+void EnTakaraMan_WaitForKeyMessage(EnTakaraMan* this, PlayState* play);  // was func_80B17AC4 [LLM:HIGH]
 
 const ActorInit En_Takara_Man_InitVars = {
     ACTOR_EN_TAKARA_MAN,
@@ -184,13 +185,13 @@ void EnTakaraMan_HandlePlayChoice(EnTakaraMan* this, PlayState* play) {
 
 void EnTakaraMan_OfferKey(EnTakaraMan* this, PlayState* play) {
     if (Actor_HasParent(&this->actor, play)) {
-        this->actionFunc = func_80B17AC4;
+        this->actionFunc = EnTakaraMan_WaitForKeyMessage;  // was func_80B17AC4 [LLM:HIGH]
     } else if (GameInteractor_Should(VB_TAKARA_MAN_OFFER_GET_ITEM, true, this)) {
         Actor_OfferGetItem(&this->actor, play, GI_DOOR_KEY, 2000.0f, 1000.0f);
     }
 }
 
-void func_80B17AC4(EnTakaraMan* this, PlayState* play) {
+void EnTakaraMan_WaitForKeyMessage(EnTakaraMan* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_DONE && Message_ShouldAdvance(play)) {
         this->actionFunc = EnTakaraMan_SetupIdle;  // was func_80B176E0 [LLM:HIGH]
     }
