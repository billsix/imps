 void BgBdanSwitch_SetupHeavyRelease(BgBdanSwitch* this);  // was func_8086DAB4 [LLM:HIGH]
 // LLM generated name (HIGH), was func_8086DAC4: raises the heavy switch back to its idle height
 void BgBdanSwitch_HeavyRelease(BgBdanSwitch* this, PlayState* play);  // was func_8086DAC4 [LLM:HIGH]
