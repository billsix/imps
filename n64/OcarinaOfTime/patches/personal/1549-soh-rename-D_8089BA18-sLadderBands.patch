From 2c3fad79c3b1342e38e1b578dfc9095e38aa7a4b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:26:29 +0000
Subject: [PATCH 1549/3799] soh: rename D_8089BA18 -> sLadderBands

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the six climbable height bands of the ladder wall, each a low and high Y; the knock-off check finds which band the player is hanging in.
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c     | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c b/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
index c556e25c6..3f1a4cd53 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
@@ -49,7 +49,8 @@ static s16 sWallPauseFrames[4] = { 48, 48, 36, 36 };  // was D_8089BA00 [LLM:HIG
 // LLM generated name (HIGH), was D_8089BA08: how fast each segment slides while it is moving.
 static f32 sWallSlideSpeeds[4] = { 8.0f, 8.0f, 10.0f, 10.0f };  // was D_8089BA08 [LLM:HIGH]
 
-static s16 D_8089BA18[6][2] = {
+// LLM generated name (HIGH), was D_8089BA18: the six climbable height bands of the ladder wall, each a low and high Y; the knock-off check finds which band the player is hanging in.
+static s16 sLadderBands[6][2] = {  // was D_8089BA18 [LLM:HIGH]
     { 0x0388, 0x0395 }, { 0x03EA, 0x03FF }, { 0x0454, 0x0467 },
     { 0x04B4, 0x04C1 }, { 0x0518, 0x0528 }, { 0x0581, 0x0590 },
 };
@@ -85,10 +86,10 @@ void func_8089B4C8(BgJyaZurerukabe* this, PlayState* play) {
     if ((player->stateFlags1 == PLAYER_STATE1_CLIMBING_LADDER) && (player->actor.wallPoly != NULL)) {
         s32 i;
 
-        for (i = 0; i < ARRAY_COUNT(D_8089BA18); i++) {
+        for (i = 0; i < ARRAY_COUNT(sLadderBands); i++) {  // was D_8089BA18 [LLM:HIGH]
             f32 posY = player->actor.world.pos.y;
 
-            if ((posY >= D_8089BA18[i][0]) && (posY <= D_8089BA18[i][1])) {
+            if ((posY >= sLadderBands[i][0]) && (posY <= sLadderBands[i][1])) {  // was D_8089BA18 [LLM:HIGH]
                 break;
             }
         }
