     Collider_DestroyCylinder(play, &this->collider);
 }
 
-void func_809D1D0C(Actor* thisx, PlayState* play) {
+// LLM generated name (HIGH), was func_809D1D0C: transforms quad corner verts and calls Collider_SetQuadVertices
+void EnBx_UpdateQuadCollider(Actor* thisx, PlayState* play) {
     Vec3f sp5C = { 8000.0f, 15000.0f, 2500.0f };
     Vec3f sp50 = { 8000.0f, 10000.0f, 2500.0f };
-    static Vec3f D_809D2540 = { -8000.0f, 15000.0f, 2500.0f };
-    static Vec3f D_809D254C = { -8000.0f, 10000.0f, 2500.0f };
+    // LLM generated name (HIGH), was D_809D2540: top-left quad corner, MultVec3f'd into collider vertices
+    static Vec3f sQuadVtxTopLeft = { -8000.0f, 15000.0f, 2500.0f };
+    // LLM generated name (HIGH), was D_809D254C: bottom-left quad corner, MultVec3f'd into collider vertices
+    static Vec3f sQuadVtxBottomLeft = { -8000.0f, 10000.0f, 2500.0f };
     Vec3f sp44;
     Vec3f sp38;
     EnBx* this = (EnBx*)thisx;
 
-    Matrix_MultVec3f(&D_809D2540, &sp44);
-    Matrix_MultVec3f(&D_809D254C, &sp38);
+    Matrix_MultVec3f(&sQuadVtxTopLeft, &sp44);
+    Matrix_MultVec3f(&sQuadVtxBottomLeft, &sp38);
     Matrix_MultVec3f(&sp5C, &this->colliderQuad.dim.quad[1]);
     Matrix_MultVec3f(&sp50, &this->colliderQuad.dim.quad[0]);
     Collider_SetQuadVertices(&this->colliderQuad, &sp38, &sp44, &this->colliderQuad.dim.quad[0],
@@ -198,7 +201,9 @@ void EnBx_Update(Actor* thisx, PlayState* play) {
 }
 
 void EnBx_Draw(Actor* thisx, PlayState* play) {
-    static void* D_809D2560[] = {
+    // LLM generated name (GUESS), was D_809D2560: void*[] object_bxa tentacle textures,
+    // indexed by actor.params & 0x7F in EnBx_Draw.
+    static void* sTentacleTextures[] = {
         object_bxa_Tex_0024F0,
         object_bxa_Tex_0027F0,
         object_bxa_Tex_0029F0,
@@ -213,14 +218,14 @@ void EnBx_Draw(Actor* thisx, PlayState* play) {
     Gfx_SetupDL_25Opa(play->state.gfxCtx);
 
     gSPSegment(POLY_OPA_DISP++, 0x0C, mtx);
-    gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_809D2560[this->actor.params & 0x7F]));
+    gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(sTentacleTextures[this->actor.params & 0x7F]));
     gSPSegment(POLY_OPA_DISP++, 0x09,
                Gfx_TwoTexScrollEx(play->state.gfxCtx, 0, 0, 0, 16, 16, 1, 0, (play->gameplayFrames * -10) % 128, 32, 32,
                                   0, 0, 0, -10));
     gSPMatrix(POLY_OPA_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
 
     if (this->actor.params & 0x80) {
-        func_809D1D0C(&this->actor, play);
+        EnBx_UpdateQuadCollider(&this->actor, play);
     }
 
     this->unk_14E -= 0xBB8;
