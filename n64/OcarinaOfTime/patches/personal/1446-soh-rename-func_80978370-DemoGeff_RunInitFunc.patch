From 34f85224c448eef37da3b879ea1488ed4d0e868a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:19:23 +0000
Subject: [PATCH 1446/3799] soh: rename func_80978370 -> DemoGeff_RunInitFunc

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: looks the params up in sInitFuncs and calls it, killing the actor and complaining when the slot is empty.
Defined in soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c b/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
index cdfa63b99..86550c7e2 100644
--- a/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
+++ b/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
@@ -177,7 +177,8 @@ void DemoGeff_DrawRubble(DemoGeff* this, PlayState* play) {
     DemoGeff_DrawDList(play, gGanonRubbleDL);  // was func_80977EA8 [LLM:HIGH]
 }
 
-void func_80978370(DemoGeff* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80978370: looks the params up in sInitFuncs and calls it, killing the actor and complaining when the slot is empty.
+void DemoGeff_RunInitFunc(DemoGeff* this, PlayState* play) {
     s16 params = this->actor.params;
     DemoGeffInitFunc initFunc = sInitFuncs[params];
     if (initFunc == NULL) {
@@ -203,7 +204,7 @@ void func_809783D4(DemoGeff* this, PlayState* play) {
     }
     if (Object_IsLoaded(objCtx, objBankIndex)) {
         this->objBankIndex = objBankIndex;
-        func_80978370(this, play);
+        DemoGeff_RunInitFunc(this, play);  // was func_80978370 [LLM:HIGH]
     }
 }
 
