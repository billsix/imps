 static Vec3f sDiveSfxPos;  // was D_80B42DA0 [LLM:HIGH]
 
-static s32 D_80B41D90 = 0;
+// LLM generated name (HIGH), was D_80B41D90: set once the colossus wind sound has a previous camera position to measure speed against
+static s32 sWindSfxStarted = 0;  // was D_80B41D90 [LLM:HIGH]
 void EnXc_SetColossusWindSFX(PlayState* play) {
     if (gSaveContext.sceneLayer == 4) {
         static Vec3f sPos = { 0.0f, 0.0f, 0.0f };
         static f32 sMaxSpeed = 0.0f;
-        static Vec3f D_80B42DB0;
+        static Vec3f sWindSfxPrevEye;  // was D_80B42DB0 [LLM:HIGH]
         s32 pad;
         s16 sceneNum = play->sceneNum;
 
@@ -520,8 +521,8 @@ void EnXc_SetColossusWindSFX(PlayState* play) {
                 s32 pad;
                 Vec3f* eye = &play->view.eye;
 
-                if (D_80B41D90 != 0) {
-                    f32 speed = Math3D_Vec3f_DistXYZ(&D_80B42DB0, eye) / 7.058922f;
+                if (sWindSfxStarted != 0) {  // was D_80B41D90 [LLM:HIGH]
+                    f32 speed = Math3D_Vec3f_DistXYZ(&sWindSfxPrevEye, eye) / 7.058922f;  // was D_80B42DB0 [LLM:HIGH]
 
                     sMaxSpeed = CLAMP_MIN(sMaxSpeed, speed);
 
@@ -531,10 +532,10 @@ void EnXc_SetColossusWindSFX(PlayState* play) {
                     Audio_PlaySfxScaledByRate(&sPos, NA_SE_EV_FLYING_AIR - SFX_FLAG, 0.6f + (0.4f * speed));  // was func_800F436C [LLM:HIGH]
                 }
 
-                D_80B42DB0.x = eye->x;
-                D_80B42DB0.y = eye->y;
-                D_80B42DB0.z = eye->z;
-                D_80B41D90 = 1;
+                sWindSfxPrevEye.x = eye->x;  // was D_80B42DB0 [LLM:HIGH]
+                sWindSfxPrevEye.y = eye->y;  // was D_80B42DB0 [LLM:HIGH]
+                sWindSfxPrevEye.z = eye->z;  // was D_80B42DB0 [LLM:HIGH]
+                sWindSfxStarted = 1;  // was D_80B41D90 [LLM:HIGH]
             }
         }
     }
@@ -575,7 +576,8 @@ void EnXc_DestroyFlame(EnXc* this) {
     Actor_Kill(&this->actor);
 }
 
-static s32 D_80B41DA8 = 1;
+// LLM generated name (HIGH), was D_80B41DA8: the cue action EnXc_DestroyFlame last acted on, so each new one fires once
+static s32 sPrevFlameCueAction = 1;  // was D_80B41DA8 [LLM:HIGH]
 void EnXc_InitFlame(EnXc* this, PlayState* play) {
     s32 pad;
     s16 sceneNum = play->sceneNum;
@@ -585,7 +587,7 @@ void EnXc_InitFlame(EnXc* this, PlayState* play) {
         if (npcAction != NULL) {
             s32 action = npcAction->action;
 
-            if (D_80B41DA8 != action) {
+            if (sPrevFlameCueAction != action) {  // was D_80B41DA8 [LLM:HIGH]
                 if (action != 1) {
                     EnXc_SpawnFlame(this, play);
                 }
@@ -594,7 +596,7 @@ void EnXc_InitFlame(EnXc* this, PlayState* play) {
                     EnXc_DestroyFlame(this);
                 }
 
-                D_80B41DA8 = action;
+                sPrevFlameCueAction = action;  // was D_80B41DA8 [LLM:HIGH]
             }
 
             EnXc_SetupFlamePos(this, play);
@@ -1491,13 +1493,14 @@ void EnXc_SpawnWarpAtFrame310(PlayState* play) {
     }
 }
 
-static s32 D_80B41DAC = 1;
+// LLM generated name (HIGH), was D_80B41DAC: guards the frame 310 warp spawn so it happens only once
+static s32 sWarpNotSpawned = 1;  // was D_80B41DAC [LLM:HIGH]
 
 #define EN_XC_SHIP_SAVESTATE_FIELDS(F) \
-    F(D_80B41D90)                      \
+    F(sWindSfxStarted)                      \
     F(sFlameSpawned)                   \
-    F(D_80B41DA8)                      \
-    F(D_80B41DAC)
+    F(sPrevFlameCueAction)                      \
+    F(sWarpNotSpawned)  // was D_80B41DAC [LLM:HIGH]
 
 SHIP_SAVESTATE_DEFINE(EnXc, EN_XC_SHIP_SAVESTATE_FIELDS)
 
@@ -1508,7 +1511,7 @@ void EnXc_HandleCue0Actions(EnXc* this, PlayState* play) {
     if (npcAction != NULL) {
         s32 action = npcAction->action;
 
-        if (action != D_80B41DAC) {
+        if (action != sWarpNotSpawned) {  // was D_80B41DAC [LLM:HIGH]
             switch (action) {
                 case 2:
                     EnXc_PlaySkipSfx();  // was func_80B3F3D8 [LLM:HIGH]
@@ -1519,7 +1522,7 @@ void EnXc_HandleCue0Actions(EnXc* this, PlayState* play) {
                 default:
                     break;
             }
-            D_80B41DAC = action;
+            sWarpNotSpawned = action;  // was D_80B41DAC [LLM:HIGH]
         }
     }
 }
@@ -2565,8 +2568,8 @@ const ActorInit En_Xc_InitVars = {
 };
 
 void EnXc_Reset(void) {
-    D_80B41D90 = 0;
+    sWindSfxStarted = 0;  // was D_80B41D90 [LLM:HIGH]
     sFlameSpawned = false;
-    D_80B41DA8 = 1;
-    D_80B41DAC = 1;
+    sPrevFlameCueAction = 1;  // was D_80B41DA8 [LLM:HIGH]
+    sWarpNotSpawned = 1;  // was D_80B41DAC [LLM:HIGH]
 }
