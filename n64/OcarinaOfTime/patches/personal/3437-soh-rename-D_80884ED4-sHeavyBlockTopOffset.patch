From 226560e3c8bbc3225e3e68d13a24832cdc69c556 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:10 +0000
Subject: [PATCH 3437/3799] soh: rename D_80884ED4 -> sHeavyBlockTopOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the 400-unit-high point it transforms alongside
Defined in soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c   | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c b/soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c
index 4396d5407..dbf69c2b3 100644
--- a/soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c
+++ b/soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c
@@ -487,7 +487,7 @@ void BgHeavyBlock_Update(Actor* thisx, PlayState* play) {
 
 void BgHeavyBlock_Draw(Actor* thisx, PlayState* play) {
     static Vec3f sHeavyBlockOrigin = { 0.0f, 0.0f, 0.0f };  // was D_80884EC8 [LLM:HIGH]
-    static Vec3f D_80884ED4 = { 0.0f, 400.0f, 0.0f };
+    static Vec3f sHeavyBlockTopOffset = { 0.0f, 400.0f, 0.0f };  // was D_80884ED4 [LLM:HIGH]
     BgHeavyBlock* this = (BgHeavyBlock*)thisx;
     s32 pad;
     Player* player = GET_PLAYER(play);
@@ -500,11 +500,11 @@ void BgHeavyBlock_Draw(Actor* thisx, PlayState* play) {
         Matrix_Translate(-this->unk_164.x, -this->unk_164.y, -this->unk_164.z, MTXMODE_APPLY);
     } else if ((thisx->gravity == 0.0f) && (BgHeavyBlock_Land == this->actionFunc)) {
         Matrix_SetTranslateRotateYXZ(thisx->home.pos.x, thisx->home.pos.y, thisx->home.pos.z, &thisx->shape.rot);
-        Matrix_Translate(-D_80884ED4.x, -D_80884ED4.y, -D_80884ED4.z, MTXMODE_APPLY);
+        Matrix_Translate(-sHeavyBlockTopOffset.x, -sHeavyBlockTopOffset.y, -sHeavyBlockTopOffset.z, MTXMODE_APPLY);  // was D_80884ED4 [LLM:HIGH]
     }
 
     Matrix_MultVec3f(&sHeavyBlockOrigin, &thisx->world.pos);  // was D_80884EC8 [LLM:HIGH]
-    Matrix_MultVec3f(&D_80884ED4, &thisx->home.pos);
+    Matrix_MultVec3f(&sHeavyBlockTopOffset, &thisx->home.pos);  // was D_80884ED4 [LLM:HIGH]
     Gfx_SetupDL_25Opa(play->state.gfxCtx);
 
     gSPMatrix(POLY_OPA_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
