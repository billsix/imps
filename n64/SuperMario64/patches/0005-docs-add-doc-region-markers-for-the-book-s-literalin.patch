From d6e74fd2b7d0a99eafec835e6b2f286162c68465 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Sun, 6 Sep 2026 16:32:16 +0000
Subject: [PATCH] docs: add doc-region markers for the book's literalinclude

Comment-only markers (// doc-region-begin/end <name>) so the Mario 64 book can
literalinclude exact spans by name instead of drift-prone line numbers. First
region: euler_zxy_to_matrix (the Euler-angle rotation matrix builder).
---
 src/engine/math_util.c          | 4 ++++
 src/game/camera.h               | 2 ++
 src/game/rendering_graph_node.c | 8 ++++++++
 src/port/Engine.cpp             | 2 ++
 src/port/Game.cpp               | 2 ++
 5 files changed, 18 insertions(+)

diff --git a/src/engine/math_util.c b/src/engine/math_util.c
index a5a491b9..e3b0f8e2 100644
--- a/src/engine/math_util.c
+++ b/src/engine/math_util.c
@@ -276,6 +276,7 @@ void mtxf_lookat(Mat4 mtx, Vec3f from, Vec3f to, s16 roll) {
  * Build a matrix that rotates around the z axis, then the x axis, then the y
  * axis, and then translates.
  */
+// doc-region-begin euler_zxy_to_matrix
 void mtxf_rotate_zxy_and_translate(Mat4 dest, Vec3f translate, Vec3s rotate) {
     FrameInterpolation_RecordMatrixPosRotZXY(dest, translate, rotate);
     register f32 sx = sins(rotate[0]);
@@ -305,6 +306,7 @@ void mtxf_rotate_zxy_and_translate(Mat4 dest, Vec3f translate, Vec3s rotate) {
     dest[0][3] = dest[1][3] = dest[2][3] = 0.0f;
     dest[3][3] = 1.0f;
 }
+// doc-region-end euler_zxy_to_matrix
 
 /**
  * Build a matrix that rotates around the x axis, then the y axis, then the z
@@ -498,6 +500,7 @@ void mtxf_align_terrain_triangle(Mat4 mtx, Vec3f pos, s16 yaw, f32 radius) {
  * The resulting matrix represents first applying transformation b and
  * then a.
  */
+// doc-region-begin mtxf_mul_affine
 void mtxf_mul(Mat4 dest, Mat4 a, Mat4 b) {
     // TODO: FrameInterpolation is broken, fix it
     // FrameInterpolation_RecordMatrixMult(dest, dest, 0);
@@ -543,6 +546,7 @@ void mtxf_mul(Mat4 dest, Mat4 a, Mat4 b) {
 
     mtxf_copy(dest, temp);
 }
+// doc-region-end mtxf_mul_affine
 
 /**
  * Set matrix 'dest' to 'mtx' scaled by vector s
