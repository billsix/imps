From 1e72fa377fcf7b7feec5a36139c7f44ee4cfe920 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:07 +0000
Subject: [PATCH 1666/3799] soh: rename D_80B2EB04 -> sBeamFarRightTemplate

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the template for the beam quad's far right corner; only its Z is overwritten with the measured beam length.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index 06ba27da2..efbb3b444 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -103,7 +103,8 @@ static Vec3f sZeroVec = { 0.0f, 0.0f, 0.0f };  // was D_80B2EAEC [LLM:HIGH]
 // LLM generated name (HIGH), was D_80B2EAF8: the template copied into the local that is stretched to the beam's current length to find its far end.
 static Vec3f sBeamEndTemplate = { 0.0f, 0.0f, 0.0f };  // was D_80B2EAF8 [LLM:HIGH]
 
-static Vec3f D_80B2EB04 = { 500.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80B2EB04: the template for the beam quad's far right corner; only its Z is overwritten with the measured beam length.
+static Vec3f sBeamFarRightTemplate = { 500.0f, 0.0f, 0.0f };  // was D_80B2EB04 [LLM:HIGH]
 
 static Vec3f D_80B2EB10 = { -500.0f, 0.0f, 0.0f };
 
@@ -471,7 +472,7 @@ s32 EnVm_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 void EnVm_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
     EnVm* this = (EnVm*)thisx;
     Vec3f sp80 = sBeamEndTemplate;  // was D_80B2EAF8 [LLM:HIGH]
-    Vec3f sp74 = D_80B2EB04;
+    Vec3f sp74 = sBeamFarRightTemplate;  // was D_80B2EB04 [LLM:HIGH]
     Vec3f sp68 = D_80B2EB10;
     s32 pad;
     Vec3f posResult;
-- 
