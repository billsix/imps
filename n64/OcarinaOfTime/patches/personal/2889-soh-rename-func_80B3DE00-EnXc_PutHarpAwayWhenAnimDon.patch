From dcfb8d57a32d0f5ac49d1989e5411912514d7082 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:42 +0000
Subject: [PATCH 2889/3799] soh: rename func_80B3DE00 ->
 EnXc_PutHarpAwayWhenAnimDone

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays the harp pull-out backwards to put it away
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 7851898a6..cf001db3b 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -851,7 +851,8 @@ void EnXc_SetupHarpPutawayAction(EnXc* this, PlayState* play) {
     }
 }
 
-void func_80B3DE00(EnXc* this, s32 animFinished) {
+// LLM generated name (HIGH), was func_80B3DE00: plays the harp pull-out backwards to put it away
+void EnXc_PutHarpAwayWhenAnimDone(EnXc* this, s32 animFinished) {
     if (animFinished) {
         Animation_Change(&this->skelAnime, &gSheikPullingOutHarpAnim, -1.0f,
                          Animation_GetLastFrame(&gSheikPullingOutHarpAnim), 0.0f, ANIMMODE_ONCE, 0.0f);
@@ -1033,7 +1034,7 @@ void EnXc_ActionFunc11(EnXc* this, PlayState* play) {
 
     EnXc_BgCheck(this, play);
     EnXc_SetEyePattern(this);
-    func_80B3DE00(this, animFinished);
+    EnXc_PutHarpAwayWhenAnimDone(this, animFinished);  // was func_80B3DE00 [LLM:HIGH]
 }
 
 void EnXc_ActionFunc12(EnXc* this, PlayState* play) {
