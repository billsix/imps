From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:15:29 +0000
Subject: [PATCH 3353/3799] soh: rename Struct_8011FAF0 ->
 ZBufValConversionEntry

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the shift and base pair of sZBufValConversionTable, which upstream already named
Defined in soh/src/code/z_kankyo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_kankyo.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_kankyo.c b/soh/src/code/z_kankyo.c
index 0613e4366..dc7b0cf5a 100644
--- a/soh/src/code/z_kankyo.c
+++ b/soh/src/code/z_kankyo.c
@@ -42,10 +42,10 @@ typedef struct {
 typedef struct {
     /* 0x00 */ s32 unk_00;
     /* 0x04 */ s32 unk_04;
-} Struct_8011FAF0; // size = 0x8
+} ZBufValConversionEntry; // size = 0x8, was Struct_8011FAF0 [LLM:HIGH]
 
 // Name from zeldaret/oot (was D_8011FAF0): adopted upstream's name for this address; body verified to match upstream at 0.89. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_kankyo.c]
-Struct_8011FAF0 sZBufValConversionTable[] = {
+ZBufValConversionEntry sZBufValConversionTable[] = {  // was Struct_8011FAF0 [LLM:HIGH]
     { 6, 0x00000000 }, { 5, 0x00020000 }, { 4, 0x00030000 }, { 3, 0x00038000 },
     { 2, 0x0003C000 }, { 1, 0x0003E000 }, { 0, 0x0003F000 }, { 0, 0x0003F800 },
 };
