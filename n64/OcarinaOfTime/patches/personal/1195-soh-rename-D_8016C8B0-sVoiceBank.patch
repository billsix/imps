From 6309e9ccfe542b2bb74a05a3cf93096053de1f36 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:56:13 +0000
Subject: [PATCH 1195/3799] soh: rename D_8016C8B0 -> sVoiceBank

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: gSoundBanks[6]; the same comment names entry 6 "Voice Bank size 5".
Defined in soh/src/code/audio_sfx.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_sfx.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index d45c0cd1f..833fbeba3 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -48,7 +48,8 @@ SoundBankEntry sEnemyBank[20];  // was D_8016C2E0 [LLM:HIGH]
 SoundBankEntry sSystemBank[8];  // was D_8016C6A0 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8016C820: gSoundBanks[5]; the same comment names entry 5 "Ocarina Bank size 3".
 SoundBankEntry sOcarinaBank[3];  // was D_8016C820 [LLM:HIGH]
-SoundBankEntry D_8016C8B0[5];
+// LLM generated name (HIGH), was D_8016C8B0: gSoundBanks[6]; the same comment names entry 6 "Voice Bank size 5".
+SoundBankEntry sVoiceBank[5];  // was D_8016C8B0 [LLM:HIGH]
 SoundRequest sSoundRequests[0x100];
 u8 sSoundBankListEnd[7];
 u8 sSoundBankFreeListStart[7];
@@ -77,12 +78,12 @@ u8 sSoundRequestReadIndex = 0;
  * 6 : Voice Bank           size 5
  */
 SoundBankEntry* gSoundBanks[7] = {
-    sPlayerBank, sItemBank, sEnvironmentBank, sEnemyBank, sSystemBank, sOcarinaBank, D_8016C8B0,  // was D_8016BAD0 [LLM:HIGH]
+    sPlayerBank, sItemBank, sEnvironmentBank, sEnemyBank, sSystemBank, sOcarinaBank, sVoiceBank,  // was D_8016BAD0 [LLM:HIGH]
 };
 
 u8 sBankSizes[ARRAY_COUNT(gSoundBanks)] = {
     ARRAY_COUNT(sPlayerBank), ARRAY_COUNT(sItemBank), ARRAY_COUNT(sEnvironmentBank), ARRAY_COUNT(sEnemyBank),  // was D_8016BAD0 [LLM:HIGH]
-    ARRAY_COUNT(sSystemBank), ARRAY_COUNT(sOcarinaBank), ARRAY_COUNT(D_8016C8B0),  // was D_8016C6A0 [LLM:HIGH]
+    ARRAY_COUNT(sSystemBank), ARRAY_COUNT(sOcarinaBank), ARRAY_COUNT(sVoiceBank),  // was D_8016C6A0 [LLM:HIGH]
 };
 
 u8 gSfxChannelLayout = 0;
-- 
