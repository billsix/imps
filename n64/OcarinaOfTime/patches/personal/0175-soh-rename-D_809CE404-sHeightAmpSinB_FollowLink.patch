From 078b9d80dc33f38c1b8c8624bc1698757772983e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:30 +0000
Subject: [PATCH 175/784] soh: rename D_809CE404 -> sHeightAmpSinB_FollowLink

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c b/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
index 198d61e05..418fef5f5 100644
--- a/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
+++ b/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
@@ -201,10 +201,11 @@ void EnButte_UpdateHeightFlyAround(EnButte* this) {
 void EnButte_UpdateHeightFollowLink(EnButte* this) {
     // LLM generated name (HIGH), was D_809CE3F8: sine amplitude A for FollowLink height bob.
     static f32 sHeightAmpSinA_FollowLink[] = { 15.0f, 20.0f, 25.0f };
-    static f32 D_809CE404[] = { 7.5f, 10.0f, 12.5f };
+    // LLM generated name (HIGH), was D_809CE404: sine amplitude B for FollowLink height bob.
+    static f32 sHeightAmpSinB_FollowLink[] = { 7.5f, 10.0f, 12.5f };
 
     this->actor.shape.yOffset += Math_SinS(this->unk_25C) * sHeightAmpSinA_FollowLink[this->flightParamsIdx] +
-                                 Math_SinS(this->unk_25E) * D_809CE404[this->flightParamsIdx];
+                                 Math_SinS(this->unk_25E) * sHeightAmpSinB_FollowLink[this->flightParamsIdx];
     this->actor.shape.yOffset = CLAMP(this->actor.shape.yOffset, -500.0f, 500.0f);
 }
 
