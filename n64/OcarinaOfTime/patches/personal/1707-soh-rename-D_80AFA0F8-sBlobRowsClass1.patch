From 88e74207110d9bc6cd25d1b7782160c55e6a092b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:38:47 +0000
Subject: [PATCH 1707/3799] soh: rename D_80AFA0F8 -> sBlobRowsClass1

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-row half-widths of the brush used for size class 1.
Defined in soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
index e02e4e2e9..fd1120102 100644
--- a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
+++ b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
@@ -41,7 +41,8 @@ static s16 sBlobRowsClass0[] = {  // was D_80AFA0E8 [LLM:HIGH]
     2, 3, 4, 4, 4, 3, 2, 0,
 };
 
-static s16 D_80AFA0F8[] = {
+// LLM generated name (HIGH), was D_80AFA0F8: the per-row half-widths of the brush used for size class 1.
+static s16 sBlobRowsClass1[] = {  // was D_80AFA0F8 [LLM:HIGH]
     2, 3, 4, 4, 4, 4, 3, 2,
 };
 
@@ -189,7 +190,7 @@ void func_80AF8F60(Player* player, u8* shadowTexture, f32 arg2) {
                 }
             } else if (sBlobSizeClass[i] == 1) {  // was D_80AFA15C [LLM:HIGH]
                 for (j = 0, phi_a3 = -0x100; j < 8; j++, phi_a3 += 0x40) {
-                    for (phi_a0 = -D_80AFA0F8[j]; phi_a0 < D_80AFA0F8[j]; phi_a0++) {
+                    for (phi_a0 = -sBlobRowsClass1[j]; phi_a0 < sBlobRowsClass1[j]; phi_a0++) {  // was D_80AFA0F8 [LLM:HIGH]
                         temp_v1 = temp_t0 + phi_a0;
                         if ((temp_v1 >= 0) && (temp_v1 < 0x40)) {
                             temp_v0 = temp_t1 + phi_a3;
