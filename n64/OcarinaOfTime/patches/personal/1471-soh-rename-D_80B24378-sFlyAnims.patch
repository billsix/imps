From 0e697fec49cf055f790a919d6913caf83f002e1a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:16 +0000
Subject: [PATCH 1471/3799] soh: rename D_80B24378 -> sFlyAnims

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the flying animation for each twin, played when they take off and looped while they move.
Defined in soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
index e99cb4e2b..e2bc9f368 100644
--- a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
+++ b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
@@ -56,7 +56,8 @@ static AnimationHeader* sLookingOverShoulderAnims[] = {  // was D_80B24370 [LLM:
     &gKotakeKoumeLookingOverRightShoulderAnim,
 };
 
-static AnimationHeader* D_80B24378[] = {
+// LLM generated name (HIGH), was D_80B24378: the flying animation for each twin, played when they take off and looped while they move.
+static AnimationHeader* sFlyAnims[] = {  // was D_80B24378 [LLM:HIGH]
     &gKotakeKoumeFlyAnim,
     &gKotakeKoumeFlyAnim,
 };
@@ -161,7 +162,7 @@ void EnTr_ChooseAction2(EnTr* this, PlayState* play) {
                     Animation_Change(&this->skelAnime, D_80B24380[this->actor.params], 1.0f, 0.0f,
                                      Animation_GetLastFrame(D_80B24380[this->actor.params]), ANIMMODE_ONCE, -5.0f);
                     EnTr_SetupAction(this, EnTr_CrySpellcast);
-                    this->animation = D_80B24378[this->actor.params];
+                    this->animation = sFlyAnims[this->actor.params];  // was D_80B24378 [LLM:HIGH]
                     this->timer = 39;
                     Actor_SpawnAsChild(&play->actorCtx, &this->actor, play, ACTOR_DEMO_6K, this->actor.world.pos.x,
                                        this->actor.world.pos.y, this->actor.world.pos.z, 0, 0, 0,
@@ -313,12 +314,12 @@ void EnTr_WaitToReappear(EnTr* this, PlayState* play) {
 }
 
 void EnTr_TakeOff(EnTr* this, PlayState* play) {
-    f32 lastFrame = Animation_GetLastFrame(D_80B24378[this->actor.params]);
+    f32 lastFrame = Animation_GetLastFrame(sFlyAnims[this->actor.params]);  // was D_80B24378 [LLM:HIGH]
 
     if (play->csCtx.state != CS_STATE_IDLE) {
         if ((play->csCtx.npcActions[this->actionIndex] != NULL) &&
             (play->csCtx.npcActions[this->actionIndex]->action == 3)) {
-            Animation_Change(&this->skelAnime, D_80B24378[this->actor.params], 1.0f, 0.0f, lastFrame, ANIMMODE_LOOP,
+            Animation_Change(&this->skelAnime, sFlyAnims[this->actor.params], 1.0f, 0.0f, lastFrame, ANIMMODE_LOOP,  // was D_80B24378 [LLM:HIGH]
                              -10.0f);
             this->animation = NULL;
             EnTr_SetupAction(this, EnTr_ChooseAction2);
