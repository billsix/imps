From 2c044936127f95ff87f4f488956bdb22f57f28ce Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:07:47 +0000
Subject: [PATCH 1976/3799] soh: rename func_80A97BC0 -> EnKo_GetTrackYOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns the head-tracking yOffset for this Kokiri's type and forest quest state; Fado as adult is a fixed -20
Defined in soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
index 9cc1c4379..b18fc4c3b 100644
--- a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
+++ b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
@@ -626,7 +626,8 @@ s32 EnKo_GetForestQuestState(EnKo* this) {
     return result;
 }
 
-f32 func_80A97BC0(EnKo* this) {
+// LLM generated name (HIGH), was func_80A97BC0: returns the head-tracking yOffset for this Kokiri's type and forest quest state; Fado as adult is a fixed -20
+f32 EnKo_GetTrackYOffset(EnKo* this) {
     f32 D_80A9A62C[13][5] = {
         /* ENKO_TYPE_CHILD_0    */ { 0.0f, 0.0f, 0.0f, -30.0f, -20.0f },
         /* ENKO_TYPE_CHILD_1    */ { 0.0f, 0.0f, 0.0f, -20.0f, -10.0f },
@@ -967,7 +968,7 @@ void func_80A9877C(EnKo* this, PlayState* play) {
         }
     } else {
         this->interactInfo.trackPos = player->actor.world.pos;
-        this->interactInfo.yOffset = func_80A97BC0(this);
+        this->interactInfo.yOffset = EnKo_GetTrackYOffset(this);  // was func_80A97BC0 [LLM:HIGH]
         if ((func_80A98ECC(this, play) == 0) && (this->interactInfo.talkState == NPC_TALK_STATE_IDLE)) {
             return;
         }
