From dc4a5514eedb828805ac180fbe382e57477d9801 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:41 +0000
Subject: [PATCH 3627/3799] soh: rename func_80B54DC4 -> EnZl3_GetPathIndex

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: (params >> 4) & 0xF -- the index into play->setupPathList used by EnZl3_GetPathInfo
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index c1c219e92..16f1fd1a8 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -765,7 +765,8 @@ s32 EnZl3_GetSwitchFlagIndex(EnZl3* this) {
     return params & 0xFF;
 }
 
-s32 func_80B54DC4(EnZl3* this) {
+// LLM generated name (HIGH), was func_80B54DC4: (params >> 4) & 0xF -- the index into play->setupPathList used by EnZl3_GetPathInfo
+s32 EnZl3_GetPathIndex(EnZl3* this) {
     s32 params = this->actor.params >> 4;
 
     return params & 0xF;
@@ -1610,7 +1611,7 @@ void func_80B56F10(EnZl3* this, PlayState* play) {
     Path* pathHead = play->setupPathList;
 
     if (pathHead != NULL) {
-        waypoint = func_80B54DC4(this);
+        waypoint = EnZl3_GetPathIndex(this);  // was func_80B54DC4 [LLM:HIGH]
         pathHead += waypoint;
         this->unk_30C = pathHead;
         this->unk_310 = pathHead->count;
-- 
