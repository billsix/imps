From 45a7b20a89f89e13794ad383c5c7139622490278 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:00 +0000
Subject: [PATCH 3363/3799] soh: rename D_80A4854C -> sGoronFireZeroRot

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the zero rotation EnGo2_GoronFireGenericAction passes
Defined in soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
index 585fa2f17..abf601c23 100644
--- a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
+++ b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
@@ -1934,7 +1934,7 @@ void EnGo2_GoronLinkStopRolling(EnGo2* this, PlayState* play) {
 
 void EnGo2_GoronFireGenericAction(EnGo2* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
-    Vec3s D_80A4854C = { 0x00, 0x00, 0x00 };
+    Vec3s sGoronFireZeroRot = { 0x00, 0x00, 0x00 };  // was D_80A4854C [LLM:HIGH]
 
     switch (this->goronState) {
         case 0: // Wake up
@@ -1951,8 +1951,8 @@ void EnGo2_GoronFireGenericAction(EnGo2* this, PlayState* play) {
                 this->animTimer = 60;
                 this->actor.gravity = 0.0f;
                 this->actor.speedXZ = 2.0f;
-                this->interactInfo.headRot = D_80A4854C;
-                this->interactInfo.torsoRot = D_80A4854C;
+                this->interactInfo.headRot = sGoronFireZeroRot;  // was D_80A4854C [LLM:HIGH]
+                this->interactInfo.torsoRot = sGoronFireZeroRot;  // was D_80A4854C [LLM:HIGH]
                 this->goronState++;
                 this->goronState++;
                 player->actor.world.rot.y = this->actor.world.rot.y;
