Subject: [PATCH 062/784] soh: rename func_800E5F34 ->
 AudioThread_ClearResetQueue

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/audio_thread.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_thread.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_thread.c b/soh/src/code/audio_thread.c
index 7f50bf2aa..27bcfdeb4 100644
--- a/soh/src/code/audio_thread.c
+++ b/soh/src/code/audio_thread.c
@@ -558,7 +558,8 @@ s32 AudioThread_ResetComplete(void) {
     }
 }
 
-void func_800E5F34(void) {
+// LLM generated name (HIGH), was func_800E5F34: drains all messages from audioResetQueue
+void AudioThread_ClearResetQueue(void) {
     // macro?
     // clang-format off
     s32 chk = -1; OSMesg sp28; do {} while (osRecvMesg(gAudioContext.audioResetQueueP, &sp28, OS_MESG_NOBLOCK) != chk);
@@ -570,7 +571,7 @@ s32 func_800E5F88(s32 resetPreloadID) {
     OSMesg msg;
     s32 pad;
 
-    func_800E5F34();
+    AudioThread_ClearResetQueue();
     resetStatus = gAudioContext.resetStatus;
     if (resetStatus != 0) {
         Audio_ResetCmdQueue();
@@ -584,7 +585,7 @@ s32 func_800E5F88(s32 resetPreloadID) {
         }
     }
 
-    func_800E5F34();
+    AudioThread_ClearResetQueue();
     Audio_QueueCmdS32(0xF9000000, resetPreloadID);
 
     return Audio_ScheduleProcessCmds();
