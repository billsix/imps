From 4d04ae605a5e69bfbe742299c71afd8ab165705e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:08 +0000
Subject: [PATCH 3414/3799] soh: rename D_80A6AF5C -> sChildWalkSfxFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the two animation frames EnHorseLinkChild_PlayWalkSfx fires a hoofbeat on
Defined in soh/src/overlays/actors/ovl_En_Horse_Link_Child/z_en_horse_link_child.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_En_Horse_Link_Child/z_en_horse_link_child.c       | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Horse_Link_Child/z_en_horse_link_child.c b/soh/src/overlays/actors/ovl_En_Horse_Link_Child/z_en_horse_link_child.c
index d5713b6f4..b9b1203a5 100644
--- a/soh/src/overlays/actors/ovl_En_Horse_Link_Child/z_en_horse_link_child.c
+++ b/soh/src/overlays/actors/ovl_En_Horse_Link_Child/z_en_horse_link_child.c
@@ -91,14 +91,14 @@ static CollisionCheckInfoInit sColCheckInfoInit = { 10, 35, 100, MASS_HEAVY };
 
 // LLM generated name (HIGH), was func_80A693D0: fires the foal's hoofstep sfx as the walk animation passes each of its two step frames.
 void EnHorseLinkChild_PlayWalkSfx(EnHorseLinkChild* this) {
-    static s32 D_80A6AF5C[] = { 1, 19 };
+    static s32 sChildWalkSfxFrames[] = { 1, 19 };  // was D_80A6AF5C [LLM:HIGH]
 
-    if ((this->skin.skelAnime.curFrame > D_80A6AF5C[this->unk_1F0]) &&
-        !((this->unk_1F0 == 0) && (this->skin.skelAnime.curFrame > D_80A6AF5C[1]))) {
+    if ((this->skin.skelAnime.curFrame > sChildWalkSfxFrames[this->unk_1F0]) &&  // was D_80A6AF5C [LLM:HIGH]
+        !((this->unk_1F0 == 0) && (this->skin.skelAnime.curFrame > sChildWalkSfxFrames[1]))) {  // was D_80A6AF5C [LLM:HIGH]
         Audio_PlaySfxGeneral(NA_SE_EV_KID_HORSE_WALK, &this->actor.projectedPos, 4, &gSfxDefaultFreqAndVolScale,
                              &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
         this->unk_1F0++;
-        if (this->unk_1F0 >= ARRAY_COUNT(D_80A6AF5C)) {
+        if (this->unk_1F0 >= ARRAY_COUNT(sChildWalkSfxFrames)) {  // was D_80A6AF5C [LLM:HIGH]
             this->unk_1F0 = 0;
         }
     }
