Subject: [PATCH 1052/3799] soh: rename func_808BA204 ->
 BgTokiHikari_WaitToFadeIn

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the params 1 idle: waits for the room's cutscene state to become non-zero before starting the fade-in.
Defined in soh/src/overlays/actors/ovl_Bg_Toki_Hikari/z_bg_toki_hikari.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Toki_Hikari/z_bg_toki_hikari.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Toki_Hikari/z_bg_toki_hikari.c b/soh/src/overlays/actors/ovl_Bg_Toki_Hikari/z_bg_toki_hikari.c
index 742953561..7a0a7b024 100644
--- a/soh/src/overlays/actors/ovl_Bg_Toki_Hikari/z_bg_toki_hikari.c
+++ b/soh/src/overlays/actors/ovl_Bg_Toki_Hikari/z_bg_toki_hikari.c
@@ -17,7 +17,8 @@ void BgTokiHikari_Draw(Actor* thisx, PlayState* play);
 void BgTokiHikari_DoNothing(BgTokiHikari* this, PlayState* play);
 // LLM generated name (GUESS), was func_808BA018: the params 0 draw path, picking an adult or child display list and scrolling two texture segments for the child version. The object_toki_objects display lists are unnamed, so "temple light" comes from the actor's role rather than from anything the code states.
 void BgTokiHikari_DrawTempleLight(BgTokiHikari* this, PlayState* play);  // was func_808BA018 [LLM:GUESS]
-void func_808BA204(BgTokiHikari* this, PlayState* play);
+// LLM generated name (HIGH), was func_808BA204: the params 1 idle: waits for the room's cutscene state to become non-zero before starting the fade-in.
+void BgTokiHikari_WaitToFadeIn(BgTokiHikari* this, PlayState* play);  // was func_808BA204 [LLM:HIGH]
 void func_808BA22C(BgTokiHikari* this, PlayState* play);
 void func_808BA274(BgTokiHikari* this, PlayState* play);
 void func_808BA2CC(BgTokiHikari* this, PlayState* play);
@@ -49,7 +50,7 @@ void BgTokiHikari_Init(Actor* thisx, PlayState* play) {
             break;
         case 1:
             if (!Flags_GetEventChkInf(EVENTCHKINF_OPENED_THE_DOOR_OF_TIME)) {
-                this->actionFunc = func_808BA204;
+                this->actionFunc = BgTokiHikari_WaitToFadeIn;  // was func_808BA204 [LLM:HIGH]
                 this->unk_14C = 0.0f;
             } else {
                 Actor_Kill(&this->actor);
@@ -108,7 +109,7 @@ void BgTokiHikari_DrawTempleLight(BgTokiHikari* this, PlayState* play) {
     CLOSE_DISPS(play->state.gfxCtx);
 }
 
-void func_808BA204(BgTokiHikari* this, PlayState* play) {
+void BgTokiHikari_WaitToFadeIn(BgTokiHikari* this, PlayState* play) {
     if (play->roomCtx.unk_74[1] != 0) {
         this->actionFunc = func_808BA22C;
     }
