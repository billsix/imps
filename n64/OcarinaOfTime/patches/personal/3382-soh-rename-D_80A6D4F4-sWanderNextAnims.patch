From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:03 +0000
Subject: [PATCH 3382/3799] soh: rename D_80A6D4F4 -> sWanderNextAnims

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the animation the wandering horse picks at random when it starts moving
Defined in soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c   | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c b/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c
index 47e6bc890..ec2b8111d 100644
--- a/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c
+++ b/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c
@@ -379,7 +379,7 @@ void EnHorseNormal_PlayAnimSfx(EnHorseNormal* this) {
 }
 
 void EnHorseNormal_Wander(EnHorseNormal* this, PlayState* play) {
-    static s32 D_80A6D4F4[] = { 0, 1, 4, 5, 6, 2, 3 };
+    static s32 sWanderNextAnims[] = { 0, 1, 4, 5, 6, 2, 3 };  // was D_80A6D4F4 [LLM:HIGH]
     static s32 D_80A6D510[] = { 0, 0, 2, 2, 1, 1, 1, 3, 3 };
     s32 phi_t0 = this->animationIdx;
     s32 pad;
@@ -460,7 +460,7 @@ void EnHorseNormal_Wander(EnHorseNormal* this, PlayState* play) {
                         this->unk_218 = 1.0f;
                         phi_t0 = 4;
                     } else {
-                        phi_t0 = D_80A6D4F4[(s32)(Rand_ZeroOne() * 2)];
+                        phi_t0 = sWanderNextAnims[(s32)(Rand_ZeroOne() * 2)];  // was D_80A6D4F4 [LLM:HIGH]
                         this->actor.speedXZ = 0.0f;
                         this->unk_218 = 0.0f;
                     }
