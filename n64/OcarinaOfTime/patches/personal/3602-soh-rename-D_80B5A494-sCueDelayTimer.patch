From 5f14b72e0eac5899146ca7067774c59244b57963 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:37 +0000
Subject: [PATCH 3602/3799] soh: rename D_80B5A494 -> sCueDelayTimer

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: counts down in EnZl3_CheckDemoModeInFinal2; cue 8 arms it to 10 and when it reaches 0 the delayed EnZl3_SetupAction17 fires. Reset to -1 by EnZl3_Reset and listed in EN_ZL3_SHIP_SAVESTATE_FIELDS
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 2d56090fb..1249ec650 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -62,7 +62,8 @@ static f32 sEyeOpenPhase = 0.0f;  // was D_80B5A484 [LLM:GUESS]
 // LLM generated name (GUESS), was D_80B5A488: the {0,0,0} position handed to Audio_PlaySoundRandom for the NA_SE_VO_Z1_CRY_0..1 cry, i.e. play it at the listener rather than at the actor
 static Vec3f sCrySfxPos = { 0.0f, 0.0f, 0.0f };  // was D_80B5A488 [LLM:GUESS]
 
-static s32 D_80B5A494 = -1;
+// LLM generated name (GUESS), was D_80B5A494: counts down in EnZl3_CheckDemoModeInFinal2; cue 8 arms it to 10 and when it reaches 0 the delayed EnZl3_SetupAction17 fires. Reset to -1 by EnZl3_Reset and listed in EN_ZL3_SHIP_SAVESTATE_FIELDS
+static s32 sCueDelayTimer = -1;  // was D_80B5A494 [LLM:GUESS]
 
 static Vec3f D_80B5A498 = { 148.0f, 260.0f, -87.0f };
 
@@ -74,7 +75,7 @@ static u32 D_80B5A4BC = 0;
 
 #define EN_ZL3_SHIP_SAVESTATE_FIELDS(F) \
     F(sTurningToPlayer)                       \
-    F(D_80B5A494)                       \
+    F(sCueDelayTimer)                       \
     F(D_80B5A4BC)
 
 SHIP_SAVESTATE_DEFINE(EnZl3, EN_ZL3_SHIP_SAVESTATE_FIELDS)
@@ -1306,7 +1307,7 @@ void func_80B56474(EnZl3* this, s32 arg1) {
 
 void func_80B564A8(EnZl3* this, PlayState* play) {
     s32 temp_v0;
-    s32* val = &D_80B5A494;
+    s32* val = &sCueDelayTimer;  // was D_80B5A494 [LLM:GUESS]
 
     temp_v0 = func_80B5396C(this);
 
@@ -2794,6 +2795,6 @@ const ActorInit En_Zl3_InitVars = {
 
 void EnZl3_Reset(void) {
     sTurningToPlayer = 0;  // was D_80B5A468 [LLM:GUESS]
-    D_80B5A494 = -1;
+    sCueDelayTimer = -1;  // was D_80B5A494 [LLM:GUESS]
     D_80B5A4BC = 0;
 }
