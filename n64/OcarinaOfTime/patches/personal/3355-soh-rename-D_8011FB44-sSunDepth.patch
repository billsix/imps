From b4312b5d45175c5338cc5fc4c67a9bc8696cced9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:15:29 +0000
Subject: [PATCH 3355/3799] soh: rename D_8011FB44 -> sSunDepth

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the pixel depth read at the sun's screen position, used to decide whether the lens flare is occluded
Defined in soh/src/code/z_kankyo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_kankyo.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_kankyo.c b/soh/src/code/z_kankyo.c
index b88268755..e1db7e1db 100644
--- a/soh/src/code/z_kankyo.c
+++ b/soh/src/code/z_kankyo.c
@@ -65,7 +65,8 @@ u16 gTimeSpeed = 0;
 #define ENVIRONMENT_SHIP_SAVESTATE_FIELDS(F) F(gTimeSpeed)
 SHIP_SAVESTATE_DEFINE(Environment, ENVIRONMENT_SHIP_SAVESTATE_FIELDS)
 
-u16 D_8011FB44 = 0xFFFC;
+// LLM generated name (HIGH), was D_8011FB44: the pixel depth read at the sun's screen position, used to decide whether the lens flare is occluded
+u16 sSunDepth = 0xFFFC;  // was D_8011FB44 [LLM:HIGH]
 
 struct_8011FB48 D_8011FB48[][7] = {
     {
@@ -251,7 +252,7 @@ void Environment_GraphCallback(GraphicsContext* gfxCtx, void* param) {
     OTRGetPixelDepthPrepare(sSunDepthTestX, sSunDepthTestY);
     Lights_GlowCheckPrepare(play);
 
-    D_8011FB44 = Environment_GetPixelDepth(sSunDepthTestX, sSunDepthTestY);
+    sSunDepth = Environment_GetPixelDepth(sSunDepthTestX, sSunDepthTestY);  // was D_8011FB44 [LLM:HIGH]
     Lights_GlowCheck(play);
 }
 
@@ -1529,7 +1530,7 @@ void Environment_DrawLensFlare(PlayState* play, EnvironmentContext* envCtx, View
             Play_GetScreenPos(play, &pos, &screenPos);
             sSunDepthTestX = (s16)screenPos.x;
             sSunDepthTestY = (s16)screenPos.y - 5.0f;
-            if (D_8011FB44 != 0xFFFC || screenPos.x < 0.0f || screenPos.y < shrink || screenPos.x > SCREEN_WIDTH ||
+            if (sSunDepth != 0xFFFC || screenPos.x < 0.0f || screenPos.y < shrink || screenPos.x > SCREEN_WIDTH ||  // was D_8011FB44 [LLM:HIGH]
                 screenPos.y > (SCREEN_HEIGHT - shrink)) {
                 isOffScreen = true;
             }
-- 
