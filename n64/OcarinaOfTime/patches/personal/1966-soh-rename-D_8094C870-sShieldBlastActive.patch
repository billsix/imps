From 1123631638bb9da6f730002c526193d99be8c330 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:06:36 +0000
Subject: [PATCH 1966/3799] soh: rename D_8094C870 -> sShieldBlastActive

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: set while a TWEFF_SHLD_BLST effect lives; BossTw_TwinrovaDoneBlastShoot waits for it to clear
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index a60ad0d0e..ec9536b29 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -195,7 +195,8 @@ static s16 sShieldHitYaw;
 static u8 sBeamDivertTimer;
 // LLM generated name (HIGH), was D_8094C86F: countdown that decides whether sShieldFlashAlpha rises or falls
 static u8 sShieldFlashTimer;  // was D_8094C86F [LLM:HIGH]
-static u8 D_8094C870;
+// LLM generated name (HIGH), was D_8094C870: set while a TWEFF_SHLD_BLST effect lives; BossTw_TwinrovaDoneBlastShoot waits for it to clear
+static u8 sShieldBlastActive;  // was D_8094C870 [LLM:HIGH]
 static s16 D_8094C872;
 static s16 D_8094C874;
 static s16 D_8094C876;
@@ -473,7 +474,7 @@ void BossTw_Init(Actor* thisx, PlayState* play2) {
         play->envCtx.unk_BD = 1;
         play->envCtx.unk_D8 = 0.0f;
 
-        D_8094C874 = D_8094C876 = D_8094C878 = D_8094C87A = D_8094C87C = D_8094C87E = D_8094C870 = sShieldFlashTimer =  // was D_8094C86F [LLM:HIGH]
+        D_8094C874 = D_8094C876 = D_8094C878 = D_8094C87A = D_8094C87C = D_8094C87E = sShieldBlastActive = sShieldFlashTimer =  // was D_8094C86F [LLM:HIGH]
             D_8094C872 = sBeamDivertTimer = sEnvType = sGroundBlastType = sFreezeState = sTwinrovaBlastType =
                 sFixedBlatSeq = sShieldFireCharge = sShieldIceCharge = 0;
 
@@ -4640,7 +4641,7 @@ void BossTw_UpdateEffects(PlayState* play) {
                     }
                 }
             } else if (eff->type == TWEFF_SHLD_BLST) {
-                D_8094C870 = 1;
+                sShieldBlastActive = 1;  // was D_8094C870 [LLM:HIGH]
                 eff->work[EFF_UNKS1]++;
                 if (eff->work[EFF_UNKS1] > 30) {
                     eff->alpha -= 10;
@@ -5256,7 +5257,7 @@ void BossTw_TwinrovaSetupDoneBlastShoot(BossTw* this, PlayState* play) {
 void BossTw_TwinrovaDoneBlastShoot(BossTw* this, PlayState* play) {
     SkelAnime_Update(&this->skelAnime);
 
-    if (this->timers[1] == 0 && D_8094C870 == 0) {
+    if (this->timers[1] == 0 && sShieldBlastActive == 0) {  // was D_8094C870 [LLM:HIGH]
         if (sTwinrovaPtr->timers[2] == 0) {
             BossTw_TwinrovaSetupFly(this, play);
         } else {
@@ -5264,7 +5265,7 @@ void BossTw_TwinrovaDoneBlastShoot(BossTw* this, PlayState* play) {
         }
     }
 
-    D_8094C870 = 0;
+    sShieldBlastActive = 0;  // was D_8094C870 [LLM:HIGH]
     Math_ApproachS(&this->actor.shape.rot.y, this->actor.yawTowardsPlayer, 5, 0x1000);
 }
 
