From 38ec2ce921b36f997486c0cd9cb6ab99c56a2339 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:22 +0000
Subject: [PATCH 0103/3799] soh: rename func_80077D10 ->
 Lib_GetControlStickData

Name source: zeldaret/oot.
Defined in soh/src/code/z_lib.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h                             | 2 +-
 soh/soh/Enhancements/controls/Mouse.cpp             | 2 +-
 soh/src/code/z_lib.c                                | 3 ++-
 soh/src/overlays/actors/ovl_player_actor/z_player.c | 2 +-
 4 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 3146a2eca..53a773b4d 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -960,7 +960,7 @@ s32 Math_StepUntilS(s16* pValue, s16 limit, s16 step);
 s32 Math_StepToAngleS(s16* pValue, s16 target, s16 step);
 s32 Math_StepUntilF(f32* pValue, f32 limit, f32 step);
 s32 Math_AsymStepToF(f32* pValue, f32 target, f32 incrStep, f32 decrStep);
-void func_80077D10(f32* arg0, s16* arg1, Input* input);
+void Lib_GetControlStickData(f32* arg0, s16* arg1, Input* input);  // was func_80077D10 [oot]
 s16 Rand_S16Offset(s16 base, s16 range);
 void Math_Vec3f_Copy(Vec3f* dest, Vec3f* src);
 void Math_Vec3s_ToVec3f(Vec3f* dest, Vec3s* src);
diff --git a/soh/soh/Enhancements/controls/Mouse.cpp b/soh/soh/Enhancements/controls/Mouse.cpp
index c745c22de..6f16848de 100644
--- a/soh/soh/Enhancements/controls/Mouse.cpp
+++ b/soh/soh/Enhancements/controls/Mouse.cpp
@@ -107,7 +107,7 @@ bool Mouse_HandleQuickspin(bool* should, s8* iter2, s8* sp3C) {
     }
 
     for (i = 0; i < 4; i++, iter2++) {
-        // Calculating angles as per z_lib.c:func_80077D10()
+        // Calculating angles as per z_lib.c:Lib_GetControlStickData()
         s32 relY = mouseQuickspinY[i + 1] - mouseQuickspinY[i];
         s32 relX = mouseQuickspinX[i + 1] - mouseQuickspinX[i];
         s16 aTan = Math_Atan2S((f32)relY, (f32)-relX);
diff --git a/soh/src/code/z_lib.c b/soh/src/code/z_lib.c
index ae91c4f82..7c8ffbe41 100644
--- a/soh/src/code/z_lib.c
+++ b/soh/src/code/z_lib.c
@@ -197,7 +197,8 @@ s32 Math_AsymStepToF(f32* pValue, f32 target, f32 incrStep, f32 decrStep) {
     return 0;
 }
 
-void func_80077D10(f32* arg0, s16* arg1, Input* input) {
+// Name from zeldaret/oot, was func_80077D10: converts control-stick rel x/y to polar magnitude and angle [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_lib.c]
+void Lib_GetControlStickData(f32* arg0, s16* arg1, Input* input) {
     f32 relX = input->rel.stick_x;
     f32 relY = input->rel.stick_y;
 
diff --git a/soh/src/overlays/actors/ovl_player_actor/z_player.c b/soh/src/overlays/actors/ovl_player_actor/z_player.c
index 0786319c4..904b39c63 100644
--- a/soh/src/overlays/actors/ovl_player_actor/z_player.c
+++ b/soh/src/overlays/actors/ovl_player_actor/z_player.c
@@ -2044,7 +2044,7 @@ void Player_ProcessControlStick(PlayState* play, Player* this) {
     this->prevControlStickMagnitude = sControlStickMagnitude;
     this->prevControlStickAngle = sControlStickAngle;
 
-    func_80077D10(&sControlStickMagnitude, &sControlStickAngle, sControlInput);
+    Lib_GetControlStickData(&sControlStickMagnitude, &sControlStickAngle, sControlInput);
 
     sControlStickWorldYaw = Camera_GetInputDirYaw(GET_ACTIVE_CAM(play)) + sControlStickAngle;
 
