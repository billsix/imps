From 25cf6463ac6ad46f972d6ae35399430e1feaf491 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:42 +0000
Subject: [PATCH 2666/3799] soh: rename D_8082B048 -> sPageVtxHeights

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-page height tables, indexed by pageIndex
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 922b93176..26ef19c33 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2721,7 +2721,8 @@ static s16* sPageVtxY[] = {  // was D_8082B030 [LLM:HIGH]
     sPageVtxY0, sPageVtxY1, sPageVtxY2, sPageVtxY3, sPageVtxY4, sPageVtxY5,  // was D_8082AF48 [LLM:HIGH]
 };
 
-static s16* D_8082B048[] = {
+// LLM generated name (HIGH), was D_8082B048: the per-page height tables, indexed by pageIndex
+static s16* sPageVtxHeights[] = {  // was D_8082B048 [LLM:HIGH]
     sPageVtxHeights0, sPageVtxHeights1, sPageVtxHeights2, sPageVtxHeights3, sCloudTexHeights, sPageVtxHeights5,  // was D_8082AB2C [LLM:HIGH]
 };
 
@@ -2904,7 +2905,7 @@ s16 KaleidoScope_SetPageVtx(PlayState* play, Vtx* vtx, s16 pageIndex, s16 arg3)
         ptr1 = sPageVtxX[pageIndex];  // was D_8082B000 [LLM:HIGH]
         ptr2 = sPageVtxWidths[pageIndex];  // was D_8082B018 [LLM:HIGH]
         ptr3 = sPageVtxY[pageIndex];  // was D_8082B030 [LLM:HIGH]
-        ptr4 = D_8082B048[pageIndex];
+        ptr4 = sPageVtxHeights[pageIndex];  // was D_8082B048 [LLM:HIGH]
 
         for (colorIndex = 0; colorIndex < arg3; colorIndex++, vtxIndex += 4) {
             vtx[vtxIndex + 2].v.ob[0] = vtx[vtxIndex + 0].v.ob[0] = ptr1[colorIndex];
-- 
