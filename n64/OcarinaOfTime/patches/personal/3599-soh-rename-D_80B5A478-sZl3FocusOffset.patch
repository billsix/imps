From c64fd57f55ff7e587797017e16c1649c8a22614c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:37 +0000
Subject: [PATCH 3599/3799] soh: rename D_80B5A478 -> sZl3FocusOffset

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the {0,10,0} vector Matrix_MultVec3f-ed at limb 14 (the head) in EnZl3_PostLimbDraw to place actor.focus.pos, i.e. the point the camera and Z-target aim at
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 279fcdcf2..4bc78f80f 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -53,7 +53,8 @@ static s32 sTurningToPlayer = 0;  // was D_80B5A468 [LLM:GUESS]
 // LLM generated name (GUESS), was D_80B5A46C: the {0,0,0} vector Matrix_MultVec3f-ed at limb 13 in EnZl3_PostLimbDraw to fill this->unk_31C. Zero, so it just samples the limb matrix origin
 static Vec3f sLimb13Offset = { 0.0f, 0.0f, 0.0f };  // was D_80B5A46C [LLM:GUESS]
 
-static Vec3f D_80B5A478 = { 0.0f, 10.0f, 0.0f };
+// LLM generated name (GUESS), was D_80B5A478: the {0,10,0} vector Matrix_MultVec3f-ed at limb 14 (the head) in EnZl3_PostLimbDraw to place actor.focus.pos, i.e. the point the camera and Z-target aim at
+static Vec3f sZl3FocusOffset = { 0.0f, 10.0f, 0.0f };  // was D_80B5A478 [LLM:GUESS]
 
 static f32 D_80B5A484 = 0.0f;
 
@@ -721,7 +722,7 @@ void EnZl3_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
         sp34 = sLimb13Offset;  // was D_80B5A46C [LLM:GUESS]
         Matrix_MultVec3f(&sp34, &this->unk_31C);
     } else if (limbIndex == 14) {
-        sp24 = D_80B5A478;
+        sp24 = sZl3FocusOffset;  // was D_80B5A478 [LLM:GUESS]
         Matrix_MultVec3f(&sp24, &sp18);
         this->actor.focus.pos.x = sp18.x;
         this->actor.focus.pos.y = sp18.y;
-- 
