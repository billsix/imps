From be7cf1749fa19d3e9f0552847e785dc7bdf22709 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:48 +0000
Subject: [PATCH 3149/3799] soh: rename D_8015E310 -> sTrisVsCylHitPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hit position CollisionCheck_AC_TrisVsCyl reports
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index 1fd785fdc..5e89e57f9 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2180,7 +2180,7 @@ void CollisionCheck_AC_CylVsTris(PlayState* play, CollisionCheckContext* colChkC
  * AC overlap check. Calculates the center of each collider element and the point of contact.
  */
 void CollisionCheck_AC_TrisVsCyl(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT, Collider* colAC) {
-    static Vec3f D_8015E310;
+    static Vec3f sTrisVsCylHitPos;  // was D_8015E310 [LLM:HIGH]
     ColliderTris* at = (ColliderTris*)colAT;
     ColliderTrisElement* atItem;
     ColliderCylinder* ac = (ColliderCylinder*)colAC;
@@ -2199,13 +2199,13 @@ void CollisionCheck_AC_TrisVsCyl(PlayState* play, CollisionCheckContext* colChkC
                 continue;
             }
 
-            if (Math3D_CylTriVsIntersect(&ac->dim, &atItem->dim, &D_8015E310) == 1) {
+            if (Math3D_CylTriVsIntersect(&ac->dim, &atItem->dim, &sTrisVsCylHitPos) == 1) {  // was D_8015E310 [LLM:HIGH]
                 atPos.x = (atItem->dim.vtx[0].x + atItem->dim.vtx[1].x + atItem->dim.vtx[2].x) * (1.0f / 3);
                 atPos.y = (atItem->dim.vtx[0].y + atItem->dim.vtx[1].y + atItem->dim.vtx[2].y) * (1.0f / 3);
                 atPos.z = (atItem->dim.vtx[0].z + atItem->dim.vtx[1].z + atItem->dim.vtx[2].z) * (1.0f / 3);
                 Math_Vec3s_ToVec3f(&acPos, &ac->dim.pos);
                 CollisionCheck_SetATvsAC(play, &at->base, &atItem->info, &atPos, &ac->base, &ac->info, &acPos,
-                                         &D_8015E310);
+                                         &sTrisVsCylHitPos);  // was D_8015E310 [LLM:HIGH]
                 return;
             }
         }
