From 5cedba0bf5cd54531204245525eccedef2bdeaa9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:31:18 +0000
Subject: [PATCH 1622/3799] soh: rename func_80AD42B0 ->
 EnPoField_SetupSoulAppear

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: zeroes the soul's scale, light and motion, plays the appearing sfx and installs the fade-in action.
Defined in soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
index b5aca89ec..b5ffb47f1 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
@@ -331,7 +331,8 @@ void EnPoField_SetupSoulIdle(EnPoField* this, PlayState* play) {
     this->actionFunc = EnPoField_SoulIdle;
 }
 
-void func_80AD42B0(EnPoField* this) {
+// LLM generated name (HIGH), was func_80AD42B0: zeroes the soul's scale, light and motion, plays the appearing sfx and installs the fade-in action.
+void EnPoField_SetupSoulAppear(EnPoField* this) {
     Lights_PointNoGlowSetInfo(&this->lightInfo, this->actor.world.pos.x, this->actor.world.pos.y,
                               this->actor.world.pos.z, 0, 0, 0, 0);
     this->actor.shape.rot.y = 0;
@@ -627,7 +628,7 @@ void EnPoField_SoulIdle(EnPoField* this, PlayState* play) {
     if (this->actor.bgCheckFlags & BGCHECKFLAG_GROUND) {
         EffectSsHahen_SpawnBurst(play, &this->actor.world.pos, 6.0f, 0, 1, 1, 15, OBJECT_PO_FIELD, 10,
                                  gPoeFieldLanternDL);
-        func_80AD42B0(this);
+        EnPoField_SetupSoulAppear(this);  // was func_80AD42B0 [LLM:HIGH]
     } else if (this->actionTimer == 0) {
         EnPoField_SetupWaitForSpawn(this, play);
     }
