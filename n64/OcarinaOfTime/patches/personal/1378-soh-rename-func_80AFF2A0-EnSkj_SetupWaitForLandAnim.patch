         }
     }
 }
@@ -770,7 +771,7 @@ void EnSkj_PickNextFightAction(EnSkj* this, PlayState* play) {
     }
 }
 
-void func_80AFF2A0(EnSkj* this) {
+void EnSkj_SetupWaitForLandAnim(EnSkj* this) {
     EnSkj_CalculateCenter(this);
     this->actor.speedXZ = 0.0f;
     EnSkj_ChangeAnim(this, SKJ_ANIM_LAND);
