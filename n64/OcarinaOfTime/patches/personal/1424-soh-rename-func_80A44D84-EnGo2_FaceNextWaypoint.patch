From ec45f78e941b97779ea84971ed6e62cdde3532a0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:18:19 +0000
Subject: [PATCH 1424/3799] soh: rename func_80A44D84 -> EnGo2_FaceNextWaypoint

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: orients the actor toward its current path waypoint and stores that yaw in world.rot.y.
Defined in soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
index b987a79bd..b6c8bf637 100644
--- a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
+++ b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
@@ -960,7 +960,8 @@ s32 EnGo2_Orient(EnGo2* this, PlayState* play) {
     }
 }
 
-s32 func_80A44D84(EnGo2* this) {
+// LLM generated name (HIGH), was func_80A44D84: orients the actor toward its current path waypoint and stores that yaw in world.rot.y.
+s32 EnGo2_FaceNextWaypoint(EnGo2* this) {
     s16 targetYaw;
 
     Path_OrientAndGetDistSq(&this->actor, this->path, this->waypoint, &targetYaw);
@@ -1941,7 +1942,7 @@ void EnGo2_GoronFireGenericAction(EnGo2* this, PlayState* play) {
                 Animation_ChangeByInfo(&this->skelAnime, sAnimationInfo, ENGO2_ANIM_2);
                 this->waypoint = 1;
                 this->skelAnime.playSpeed = 2.0f;
-                func_80A44D84(this);
+                EnGo2_FaceNextWaypoint(this);  // was func_80A44D84 [LLM:HIGH]
                 this->actor.shape.rot = this->actor.world.rot;
                 this->animTimer = 60;
                 this->actor.gravity = 0.0f;
