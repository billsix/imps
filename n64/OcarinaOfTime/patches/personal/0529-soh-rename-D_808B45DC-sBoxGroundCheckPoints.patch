From adba47c7a7bb21a6341b9823dfc3adde642f7849 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:12:05 +0000
Subject: [PATCH 0529/3799] soh: rename D_808B45DC -> sBoxGroundCheckPoints

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c.
---
 .../ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c     | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c b/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
index c0cc27428..2af062842 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
@@ -50,7 +50,8 @@ static Vec3f D_808B45C4[] = {
     { 770.0f, 1550.0f, -299.0f },
 };
 
-static Vec3f D_808B45DC[] = {
+// Name from zeldaret/oot (was D_808B45DC): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c]
+static Vec3f sBoxGroundCheckPoints[] = {
     { 29.99f, 0.01f, -29.99f }, { -29.99f, 0.01f, -29.99f }, { -29.99f, 0.01f, 29.99f },
     { 29.99f, 0.01f, 29.99f },  { 0.0f, 0.01f, 0.0f },
 };
@@ -148,9 +149,9 @@ s32 BgSpot15Rrbox_TrySnapToCheckedPoint(BgSpot15Rrbox* this, PlayState* play, s3
 
     func_808B3A34(this);
 
-    actorScale.x = D_808B45DC[arg2].x * (this->dyna.actor.scale.x * 10.0f);
-    actorScale.y = D_808B45DC[arg2].y * (this->dyna.actor.scale.y * 10.0f);
-    actorScale.z = D_808B45DC[arg2].z * (this->dyna.actor.scale.z * 10.0f);
+    actorScale.x = sBoxGroundCheckPoints[arg2].x * (this->dyna.actor.scale.x * 10.0f);
+    actorScale.y = sBoxGroundCheckPoints[arg2].y * (this->dyna.actor.scale.y * 10.0f);
+    actorScale.z = sBoxGroundCheckPoints[arg2].z * (this->dyna.actor.scale.z * 10.0f);
 
     BgSpot15Rrbox_RotatePoint(&actorPosition, &actorScale, this->unk_16C, this->unk_170);
 
@@ -178,10 +179,10 @@ f32 BgSpot15Rrbox_GetFloorHeight(BgSpot15Rrbox* this, PlayState* play) {
     s32 bgId;
 
     func_808B3A34(this);
-    for (i = 0; i < ARRAY_COUNT(D_808B45DC); i++) {
-        scale.x = D_808B45DC[i].x * (actor->scale.x * 10.0f);
-        scale.y = D_808B45DC[i].y * (actor->scale.y * 10.0f);
-        scale.z = D_808B45DC[i].z * (actor->scale.z * 10.0f);
+    for (i = 0; i < ARRAY_COUNT(sBoxGroundCheckPoints); i++) {
+        scale.x = sBoxGroundCheckPoints[i].x * (actor->scale.x * 10.0f);
+        scale.y = sBoxGroundCheckPoints[i].y * (actor->scale.y * 10.0f);
+        scale.z = sBoxGroundCheckPoints[i].z * (actor->scale.z * 10.0f);
 
         BgSpot15Rrbox_RotatePoint(&position, &scale, this->unk_16C, this->unk_170);
 
