From 388d0ca39647a532aa6795169709642595c4cfb8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:08:50 +0000
Subject: [PATCH 2015/3799] soh: rename D_80897540 -> sShadowRotParams2

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the shadow's rotation for the params 2 statue, drawn 70 units east of it
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
index f3b6fdd63..1084c17c9 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
@@ -118,7 +118,8 @@ static InitChainEntry sInitChain[] = {
 // LLM generated name (HIGH), was D_80897538: the shadow's rotation for the params 0 statue, drawn 50 units west of it
 static Vec3s sShadowRotParams0 = { 0, -0x4000, 0 };  // was D_80897538 [LLM:HIGH]
 
-static Vec3s D_80897540 = { 0, 0x4000, 0 };
+// LLM generated name (HIGH), was D_80897540: the shadow's rotation for the params 2 statue, drawn 70 units east of it
+static Vec3s sShadowRotParams2 = { 0, 0x4000, 0 };  // was D_80897540 [LLM:HIGH]
 
 static Vec3f D_80897548[] = {
     { 0.1f, 0.1f, 0.1f },
@@ -596,7 +597,7 @@ void BgJyaCobra_DrawShadow(BgJyaCobra* this, PlayState* play) {
         sp64.x = this->dyna.actor.world.pos.x + 70.0f;
         sp64.y = this->dyna.actor.world.pos.y;
         sp64.z = this->dyna.actor.world.pos.z;
-        phi_a3 = &D_80897540;
+        phi_a3 = &sShadowRotParams2;  // was D_80897540 [LLM:HIGH]
     } else { // params == 1
         phi_a3 = &this->dyna.actor.shape.rot;
         Math_Vec3f_Copy(&sp64, &this->dyna.actor.world.pos);
-- 
