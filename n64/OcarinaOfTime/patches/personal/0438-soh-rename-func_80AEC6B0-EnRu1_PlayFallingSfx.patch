From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:45 +0000
Subject: [PATCH 438/784] soh: rename func_80AEC6B0 -> EnRu1_PlayFallingSfx

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index a49bd8ba7..57cc3f263 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -868,7 +868,8 @@ void EnRu1_PlayStepSfx(EnRu1* this) {
     }
 }
 
-void func_80AEC6B0(EnRu1* this) {
+// Name from zeldaret/oot (was func_80AEC6B0): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_PlayFallingSfx(EnRu1* this) {
     Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_EV_FALL_DOWN_DIRT);
     Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_VO_RT_FALL);
 }
@@ -878,7 +879,7 @@ void func_80AEC6E4(EnRu1* this, PlayState* play) {
         Animation_Change(&this->skelAnime, &gRutoChildBringArmsUpAnim, 1.0f, 0,
                          Animation_GetLastFrame(&gRutoChildBringArmsUpAnim), ANIMMODE_ONCE, -8.0f);
         this->isFalling = 1;
-        func_80AEC6B0(this);
+        EnRu1_PlayFallingSfx(this);
     }
 }
 
