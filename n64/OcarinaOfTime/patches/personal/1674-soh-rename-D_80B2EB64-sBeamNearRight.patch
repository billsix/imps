From b17ea92d4be0ab85c1f56bbe24aaade1bde35d24 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:08 +0000
Subject: [PATCH 1674/3799] soh: rename D_80B2EB64 -> sBeamNearRight

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the beam quad's near right corner, fixed at the emitter.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index bd31f4739..1aa649bae 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -127,7 +127,8 @@ static Vec3f sEyeQuadTopLeft = { -1000.0f, 700.0f, 1500.0f };  // was D_80B2EB4C
 // LLM generated name (HIGH), was D_80B2EB58: the fourth corner of that same eye quad.
 static Vec3f sEyeQuadBottomLeft = { -1000.0f, -700.0f, 1500.0f };  // was D_80B2EB58 [LLM:HIGH]
 
-static Vec3f D_80B2EB64 = { 500.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80B2EB64: the beam quad's near right corner, fixed at the emitter.
+static Vec3f sBeamNearRight = { 500.0f, 0.0f, 0.0f };  // was D_80B2EB64 [LLM:HIGH]
 
 static Vec3f D_80B2EB70 = { -500.0f, 0.0f, 0.0f };
 
@@ -508,7 +509,7 @@ void EnVm_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
                     dist = 70.0f;
                 }
                 sp74.z = sp68.z = Math_Vec3f_DistXYZ(&this->beamPos1, &this->beamPos3) * dist;
-                Matrix_MultVec3f(&D_80B2EB64, &this->colliderQuad1.dim.quad[3]);
+                Matrix_MultVec3f(&sBeamNearRight, &this->colliderQuad1.dim.quad[3]);  // was D_80B2EB64 [LLM:HIGH]
                 Matrix_MultVec3f(&D_80B2EB70, &this->colliderQuad1.dim.quad[2]);
                 Matrix_MultVec3f(&sp74, &this->colliderQuad1.dim.quad[1]);
                 Matrix_MultVec3f(&sp68, &this->colliderQuad1.dim.quad[0]);
-- 
