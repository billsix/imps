From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:52:28 +0000
Subject: [PATCH 1144/3799] soh: rename func_808C0D08 -> BgZg_Rise

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sActionFuncs[1]: lifts the bars at a fixed rate and kills the actor once they are about 240 units above home.
Defined in soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
index b03470bea..7b6c32e46 100644
--- a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
+++ b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
@@ -23,12 +23,13 @@ s32 BgZg_IsSwitchSet(BgZg* this, PlayState* play);  // was func_808C0C98 [LLM:HI
 s32 BgZg_GetVariant(BgZg* this);  // was func_808C0CC8 [LLM:GUESS]
 // LLM generated name (HIGH), was func_808C0CD4: sActionFuncs[0]: waits for the switch flag, then advances to action 1 and plays the opening sfx.
 void BgZg_WaitForSwitch(BgZg* this, PlayState* play);  // was func_808C0CD4 [LLM:HIGH]
-void func_808C0D08(BgZg* this, PlayState* play);
+// LLM generated name (HIGH), was func_808C0D08: sActionFuncs[1]: lifts the bars at a fixed rate and kills the actor once they are about 240 units above home.
+void BgZg_Rise(BgZg* this, PlayState* play);  // was func_808C0D08 [LLM:HIGH]
 void func_808C0EEC(BgZg* this, PlayState* play);
 
 static BgZgActionFunc sActionFuncs[] = {
     BgZg_WaitForSwitch,  // was func_808C0CD4 [LLM:HIGH]
-    func_808C0D08,
+    BgZg_Rise,  // was func_808C0D08 [LLM:HIGH]
 };
 
 static InitChainEntry sInitChain[] = {
@@ -82,7 +83,7 @@ void BgZg_WaitForSwitch(BgZg* this, PlayState* play) {
     }
 }
 
-void func_808C0D08(BgZg* this, PlayState* play) {
+void BgZg_Rise(BgZg* this, PlayState* play) {
     this->dyna.actor.world.pos.y += (kREG(16) + 20.0f) * 1.2f;
     if ((((kREG(17) + 200.0f) * 1.2f) + this->dyna.actor.home.pos.y) <= this->dyna.actor.world.pos.y) {
         Actor_Kill(&this->dyna.actor);
