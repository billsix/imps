     DemoSa_UpdateSkelAnime(this);
 }
 
-void func_8098ECF4(DemoSa* this, PlayState* play) {
+// Name from zeldaret/oot (was func_8098ECF4): adopted upstream's name for this address; body verified to match upstream at 0.95. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_InitTrialOrSealingGanon(DemoSa* this, PlayState* play) {
     s32 pad[2];
     SkelAnime* skelAnime = &this->skelAnime;
     f32 frameCount = Animation_GetLastFrame(&gSariaSealGanonAnim);
@@ -777,7 +778,7 @@ void DemoSa_Init(Actor* thisx, PlayState* play) {
 
     switch (this->actor.params) {
