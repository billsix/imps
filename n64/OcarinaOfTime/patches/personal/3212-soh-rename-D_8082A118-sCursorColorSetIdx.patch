From 0daa1d6129e24572e13e0ffd54facf86d4827f81 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:00 +0000
Subject: [PATCH 3212/3799] soh: rename D_8082A118 -> sCursorColorSetIdx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: which of sCursorColorSets the cursor is easing toward
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_collect.c     | 32 +++++++++----------
 1 file changed, 16 insertions(+), 16 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
index de9f53a1e..faa424ed1 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
@@ -29,7 +29,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
     static s16 sCursorB = 0;  // was D_8082A10C [LLM:HIGH]
     static s16 sCursorA = 0;  // was D_8082A110 [LLM:HIGH]
     static s16 sCursorFadeTimer = 20;  // was D_8082A114 [LLM:HIGH]
-    static s16 D_8082A118 = 0;
+    static s16 sCursorColorSetIdx = 0;  // was D_8082A118 [LLM:HIGH]
     static s16 D_8082A11C = 0;
     static s16 D_8082A120 = 0;
     static u8 D_8082A124[] = {
@@ -414,39 +414,39 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
         }
     }
 
-    sp226 = ABS(sCursorR - sCursorColorSets[D_8082A118][0]) / sCursorFadeTimer;  // was D_8082A070 [LLM:HIGH]
-    sp224 = ABS(sCursorG - sCursorColorSets[D_8082A118][1]) / sCursorFadeTimer;  // was D_8082A070 [LLM:HIGH]
-    sp222 = ABS(sCursorB - sCursorColorSets[D_8082A118][2]) / sCursorFadeTimer;  // was D_8082A070 [LLM:HIGH]
-    sp220 = ABS(sCursorA - sCursorColorSets[D_8082A118][3]) / sCursorFadeTimer;  // was D_8082A070 [LLM:HIGH]
-    if (sCursorR >= sCursorColorSets[D_8082A118][0]) {  // was D_8082A070 [LLM:HIGH]
+    sp226 = ABS(sCursorR - sCursorColorSets[sCursorColorSetIdx][0]) / sCursorFadeTimer;  // was D_8082A070 [LLM:HIGH]
+    sp224 = ABS(sCursorG - sCursorColorSets[sCursorColorSetIdx][1]) / sCursorFadeTimer;  // was D_8082A070 [LLM:HIGH]
+    sp222 = ABS(sCursorB - sCursorColorSets[sCursorColorSetIdx][2]) / sCursorFadeTimer;  // was D_8082A070 [LLM:HIGH]
+    sp220 = ABS(sCursorA - sCursorColorSets[sCursorColorSetIdx][3]) / sCursorFadeTimer;  // was D_8082A070 [LLM:HIGH]
+    if (sCursorR >= sCursorColorSets[sCursorColorSetIdx][0]) {  // was D_8082A070 [LLM:HIGH]
         sCursorR -= sp226;  // was D_8082A104 [LLM:HIGH]
     } else {
         sCursorR += sp226;  // was D_8082A104 [LLM:HIGH]
     }
-    if (sCursorG >= sCursorColorSets[D_8082A118][1]) {  // was D_8082A070 [LLM:HIGH]
+    if (sCursorG >= sCursorColorSets[sCursorColorSetIdx][1]) {  // was D_8082A070 [LLM:HIGH]
         sCursorG -= sp224;  // was D_8082A108 [LLM:HIGH]
     } else {
         sCursorG += sp224;  // was D_8082A108 [LLM:HIGH]
     }
-    if (sCursorB >= sCursorColorSets[D_8082A118][2]) {  // was D_8082A070 [LLM:HIGH]
+    if (sCursorB >= sCursorColorSets[sCursorColorSetIdx][2]) {  // was D_8082A070 [LLM:HIGH]
         sCursorB -= sp222;  // was D_8082A10C [LLM:HIGH]
     } else {
         sCursorB += sp222;  // was D_8082A10C [LLM:HIGH]
     }
-    if (sCursorA >= sCursorColorSets[D_8082A118][3]) {  // was D_8082A070 [LLM:HIGH]
+    if (sCursorA >= sCursorColorSets[sCursorColorSetIdx][3]) {  // was D_8082A070 [LLM:HIGH]
         sCursorA -= sp220;  // was D_8082A110 [LLM:HIGH]
     } else {
         sCursorA += sp220;  // was D_8082A110 [LLM:HIGH]
     }
 
     if (--sCursorFadeTimer == 0) {  // was D_8082A114 [LLM:HIGH]
-        sCursorR = sCursorColorSets[D_8082A118][0];  // was D_8082A070 [LLM:HIGH]
-        sCursorG = sCursorColorSets[D_8082A118][1];  // was D_8082A070 [LLM:HIGH]
-        sCursorB = sCursorColorSets[D_8082A118][2];  // was D_8082A070 [LLM:HIGH]
-        sCursorA = sCursorColorSets[D_8082A118][3];  // was D_8082A070 [LLM:HIGH]
-        sCursorFadeTimer = ZREG(24 + D_8082A118);  // was D_8082A114 [LLM:HIGH]
-        if (++D_8082A118 >= 4) {
-            D_8082A118 = 0;
+        sCursorR = sCursorColorSets[sCursorColorSetIdx][0];  // was D_8082A070 [LLM:HIGH]
+        sCursorG = sCursorColorSets[sCursorColorSetIdx][1];  // was D_8082A070 [LLM:HIGH]
+        sCursorB = sCursorColorSets[sCursorColorSetIdx][2];  // was D_8082A070 [LLM:HIGH]
+        sCursorA = sCursorColorSets[sCursorColorSetIdx][3];  // was D_8082A070 [LLM:HIGH]
+        sCursorFadeTimer = ZREG(24 + sCursorColorSetIdx);  // was D_8082A114 [LLM:HIGH]
+        if (++sCursorColorSetIdx >= 4) {  // was D_8082A118 [LLM:HIGH]
+            sCursorColorSetIdx = 0;  // was D_8082A118 [LLM:HIGH]
         }
     }
 
