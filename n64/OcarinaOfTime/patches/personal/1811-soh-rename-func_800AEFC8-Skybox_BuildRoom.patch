From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:18 +0000
Subject: [PATCH 1811/3799] soh: rename func_800AEFC8 -> Skybox_BuildRoom

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: builds the whole room skybox, using two faces for the shops, three for one special case and four otherwise.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 44712be43..882e3272e 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -428,7 +428,8 @@ s32 Skybox_BuildSkyFace(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 ar
     return arg2;
 }
 
-void func_800AEFC8(SkyboxContext* skyboxCtx, s16 skyboxId) {
+// LLM generated name (HIGH), was func_800AEFC8: builds the whole room skybox, using two faces for the shops, three for one special case and four otherwise.
+void Skybox_BuildRoom(SkyboxContext* skyboxCtx, s16 skyboxId) {
     s32 i;
     s32 j;
     s32 phi_s3 = 0;
@@ -942,7 +943,7 @@ void Skybox_Init(GameState* state, SkyboxContext* skyboxCtx, s16 skyboxId) {
             skyboxCtx->roomVtx = GAMESTATE_ALLOC_MC(state, 256 * sizeof(Vtx));
             assert(skyboxCtx->roomVtx != NULL);
 
-            func_800AEFC8(skyboxCtx, skyboxId);
+            Skybox_BuildRoom(skyboxCtx, skyboxId);  // was func_800AEFC8 [LLM:HIGH]
         } else {
             skyboxCtx->dListBuf = GAMESTATE_ALLOC_MC(state, 12 * 150 * sizeof(Gfx));
             assert(skyboxCtx->dListBuf != NULL);
@@ -968,7 +969,7 @@ void Skybox_Update(SkyboxContext* skyboxCtx) {
         osSyncPrintf(VT_FGCOL(GREEN));
 
         if (skyboxCtx->unk_140 != 0) {
-            func_800AEFC8(skyboxCtx, skyboxCtx->skyboxId);
+            Skybox_BuildRoom(skyboxCtx, skyboxCtx->skyboxId);  // was func_800AEFC8 [LLM:HIGH]
         } else {
             if (skyboxCtx->skyboxId == SKYBOX_CUTSCENE_MAP) {
                 func_800AF178(skyboxCtx, 6);
