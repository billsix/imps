From b9881d9e7b41dfbff1345eeb5d3d208ca8a4d657 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:06:35 +0000
Subject: [PATCH 1963/3799] soh: rename D_8094C854 -> sShieldChargeAlpha

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: approaches 255 while the mirror shield charges and 0 as it discharges; used as the prim alpha of the charge glow
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Boss_Tw/z_boss_tw.c   | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index 53d414987..bb3d3c89e 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -182,7 +182,8 @@ static BossTw* sKoumePtr;
 BossTw* sTwinrovaPtr; // global for CS skip hook
 static u8 sShieldFireCharge;
 static u8 sShieldIceCharge;
-static f32 D_8094C854;
+// LLM generated name (HIGH), was D_8094C854: approaches 255 while the mirror shield charges and 0 as it discharges; used as the prim alpha of the charge glow
+static f32 sShieldChargeAlpha;  // was D_8094C854 [LLM:HIGH]
 static f32 D_8094C858;
 static u8 sTwinrovaBlastType;
 static u8 sFixedBlastType;
@@ -474,7 +475,7 @@ void BossTw_Init(Actor* thisx, PlayState* play2) {
             D_8094C872 = sBeamDivertTimer = sEnvType = sGroundBlastType = sFreezeState = sTwinrovaBlastType =
                 sFixedBlatSeq = sShieldFireCharge = sShieldIceCharge = 0;
 
-        D_8094C858 = D_8094C854 = 0.0f;
+        D_8094C858 = sShieldChargeAlpha = 0.0f;  // was D_8094C854 [LLM:HIGH]
         sFixedBlastType = Rand_ZeroFloat(1.99f);
         play->specialEffects = sEffects;
 
@@ -3689,15 +3690,15 @@ void BossTw_ShieldChargeDraw(BossTw* this, PlayState* play) {
     }
 
     if (temp_t0 != 0 && temp_t0 < 4) {
-        Math_ApproachF(&D_8094C854, 255.0f, 1.0f, 20.0f);
+        Math_ApproachF(&sShieldChargeAlpha, 255.0f, 1.0f, 20.0f);  // was D_8094C854 [LLM:HIGH]
         if (temp_t0 == 3) {
             temp_t0 *= 3;
         }
     } else if (temp_t0 == 0) {
-        D_8094C854 = 0.0f;
+        sShieldChargeAlpha = 0.0f;  // was D_8094C854 [LLM:HIGH]
     } else {
-        Math_ApproachF(&D_8094C854, 0.0f, 1.0f, 10.0f);
-        if (D_8094C854 == 0.0f) {
+        Math_ApproachF(&sShieldChargeAlpha, 0.0f, 1.0f, 10.0f);  // was D_8094C854 [LLM:HIGH]
+        if (sShieldChargeAlpha == 0.0f) {  // was D_8094C854 [LLM:HIGH]
             sShieldIceCharge = 0;
             sShieldFireCharge = 0;
         }
@@ -3710,7 +3711,7 @@ void BossTw_ShieldChargeDraw(BossTw* this, PlayState* play) {
             Matrix_Mult(&player->shieldMf, MTXMODE_NEW);
             Matrix_RotateX(M_PI / 2.0f, MTXMODE_APPLY);
             gSPMatrix(POLY_XLU_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_LOAD | G_MTX_MODELVIEW | G_MTX_NOPUSH);
-            temp_a0 = (Math_SinS(this->work[CS_TIMER_1] * 2730 * temp_t0) * D_8094C854 * 0.5f) + (D_8094C854 * 0.5f);
+            temp_a0 = (Math_SinS(this->work[CS_TIMER_1] * 2730 * temp_t0) * sShieldChargeAlpha * 0.5f) + (sShieldChargeAlpha * 0.5f);  // was D_8094C854 [LLM:HIGH]
             if (sShieldFireCharge != 0) {
                 gDPSetEnvColor(POLY_XLU_DISP++, 255, 245, 255, temp_a0);
                 gSPDisplayList(POLY_XLU_DISP++, SEGMENTED_TO_VIRTUAL(gTwinrovaMirrorShieldFireChargeSidesDL));
@@ -3718,7 +3719,7 @@ void BossTw_ShieldChargeDraw(BossTw* this, PlayState* play) {
                            Gfx_TwoTexScrollEx(play->state.gfxCtx, 0, (this->work[CS_TIMER_1] * 2) * temp_t0, 0, 0x20,
                                               0x20, 1, (-this->work[CS_TIMER_1] * 2) * temp_t0, 0, 0x20, 0x20, 0,
                                               2 * temp_t0, -2 * temp_t0, 0));
-                gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 100, 20, 0, (s16)D_8094C854);
+                gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 100, 20, 0, (s16)sShieldChargeAlpha);  // was D_8094C854 [LLM:HIGH]
                 gSPDisplayList(POLY_XLU_DISP++, SEGMENTED_TO_VIRTUAL(gTwinrovaMirrorShieldFireChargeCenterDL));
             } else {
                 gDPSetEnvColor(POLY_XLU_DISP++, 225, 255, 255, temp_a0);
@@ -3727,7 +3728,7 @@ void BossTw_ShieldChargeDraw(BossTw* this, PlayState* play) {
                            Gfx_TwoTexScrollEx(play->state.gfxCtx, 0, 0, (-this->work[CS_TIMER_1] * 5) * temp_t0, 0x20,
                                               0x40, 1, (this->work[CS_TIMER_1] * 4) * temp_t0, 0, 0x20, 0x200, 0,
                                               -5 * temp_t0, 4 * temp_t0, 0));
-                gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 175, 205, 195, (s16)D_8094C854);
+                gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 175, 205, 195, (s16)sShieldChargeAlpha);  // was D_8094C854 [LLM:HIGH]
                 gSPDisplayList(POLY_XLU_DISP++, SEGMENTED_TO_VIRTUAL(gTwinrovaMirrorShieldIceChargeCenterDL));
             }
         }
