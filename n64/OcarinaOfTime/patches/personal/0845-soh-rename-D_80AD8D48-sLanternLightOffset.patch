From 7c0db7639b938dae87c601b7b5e509f933613e7e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:47 +0000
Subject: [PATCH 0845/3799] soh: rename D_80AD8D48 -> sLanternLightOffset

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c.
---
 soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c b/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c
index 7a38e3524..b5b00655e 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c
@@ -85,7 +85,8 @@ static Vec3f sDisappearParticlesVelocity = { 0.0f, 1.5f, 0.0f };
 // Name from zeldaret/oot (was D_80AD8D3C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c]
 static Vec3f sDisappearParticlesAccel = { 0.0f, 0.0f, 0.0f };
 
-static Vec3f D_80AD8D48 = { 0.0f, 1200.0f, 0.0f };
+// Name from zeldaret/oot (was D_80AD8D48): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c]
+static Vec3f sLanternLightOffset = { 0.0f, 1200.0f, 0.0f };
 
 static void* sEyesTextures[] = {
     gDampeEyeOpenTex,
@@ -401,7 +402,7 @@ void EnPoRelay_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
         gDPSetEnvColor(POLY_OPA_DISP++, this->lightColor.r, this->lightColor.g, this->lightColor.b, 128);
         gSPDisplayList(POLY_OPA_DISP++, gDampeLanternDL);
         CLOSE_DISPS(play->state.gfxCtx);
-        Matrix_MultVec3f(&D_80AD8D48, &vec);
+        Matrix_MultVec3f(&sLanternLightOffset, &vec);
         Lights_PointNoGlowSetInfo(&this->lightInfo, vec.x, vec.y, vec.z, this->lightColor.r, this->lightColor.g,
                                   this->lightColor.b, 200);
     } else if (limbIndex == 8) {
