From 683c041ce5b316a9766d2ad17c34fa3cc0546900 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:06 +0000
Subject: [PATCH 0591/3799] soh: rename func_8005AC48 ->
 Camera_OverwriteStateFlags

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/z_camera.c.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_camera.c | 3 ++-
 soh/src/code/z_play.c   | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 692ca6a8c..115e647de 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -744,7 +744,7 @@ s16 Camera_GetCamDirPitch(Camera* camera);
 s16 Camera_GetCamDirYaw(Camera* camera);
 s32 Camera_AddQuake(Camera* camera, s32 arg1, s16 y, s32 countdown);
 s32 Camera_SetParam(Camera* camera, s32 param, void* value);
-s32 func_8005AC48(Camera* camera, s16 arg1);
+s32 Camera_OverwriteStateFlags(Camera* camera, s16 arg1);  // was func_8005AC48 [oot]
 s16 func_8005ACFC(Camera* camera, s16 arg1);
 s16 func_8005AD1C(Camera* camera, s16 arg1);
 s32 Camera_ResetAnim(Camera* camera);
diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 6b6afdbfc..fb78463c4 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -8166,7 +8166,8 @@ s32 Camera_UnsetParam(Camera* camera, s16 param) {
     return true;
 }
 
-s32 func_8005AC48(Camera* camera, s16 arg1) {
+// Name from zeldaret/oot (was func_8005AC48): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_camera.c]
+s32 Camera_OverwriteStateFlags(Camera* camera, s16 arg1) {
     camera->unk_14C = arg1;
     return true;
 }
diff --git a/soh/src/code/z_play.c b/soh/src/code/z_play.c
index 2d4c1f9c8..d02237107 100644
--- a/soh/src/code/z_play.c
+++ b/soh/src/code/z_play.c
@@ -409,7 +409,7 @@ void Play_Init(GameState* thisx) {
     play->cameraPtrs[CAM_ID_MAIN] = &play->mainCamera;
     play->cameraPtrs[CAM_ID_MAIN]->uid = 0;
     play->activeCamera = CAM_ID_MAIN;
-    func_8005AC48(&play->mainCamera, 0xFF);
+    Camera_OverwriteStateFlags(&play->mainCamera, 0xFF);
     // Sram_Init(this, &this->sramCtx);
     Regs_InitData(play);
     Message_Init(play);
-- 
2.55.0

