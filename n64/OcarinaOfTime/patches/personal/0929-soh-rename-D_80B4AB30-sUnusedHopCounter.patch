From bcba3d4047ea2b41a2c4e5b74dacc6d2700849b8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:09 +0000
Subject: [PATCH 0929/3799] soh: rename D_80B4AB30 -> sUnusedHopCounter

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment on its declaration reads "Set to 0 and incremented in EnZf_HopAway, but not actually used".
Defined in soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c b/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
index de92a338a..2f6e0af4b 100644
--- a/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
+++ b/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
@@ -221,7 +221,8 @@ static InitChainEntry sInitChain[] = {
 
 static AnimationHeader* sHoppingAnims[] = { &gZfHopCrouchingAnim, &gZfHopLeapingAnim, &gZfHopLandingAnim };
 
-static s32 D_80B4AB30; // Set to 0 and incremented in EnZf_HopAway, but not actually used
+// LLM generated name (HIGH), was D_80B4AB30: the in-tree comment on its declaration reads "Set to 0 and incremented in EnZf_HopAway, but not actually used".
+static s32 sUnusedHopCounter; // Set to 0 and incremented in EnZf_HopAway, but not actually used, was D_80B4AB30 [LLM:HIGH]
 
 void EnZf_SetupAction(EnZf* this, EnZfActionFunc actionFunc) {
     this->actionFunc = actionFunc;
@@ -1512,7 +1513,7 @@ void EnZf_HopAway(EnZf* this, PlayState* play) {
         case 0:
             this->actor.world.rot.y = sp5A;
             this->actor.shape.rot.y = sp5A + 0x8000;
-            D_80B4AB30 = 0;
+            sUnusedHopCounter = 0;  // was D_80B4AB30 [LLM:HIGH]
             this->homePlatform = this->curPlatform;
             temp_v1_2 = !EnZf_PrimaryFloorCheck(this, play, 107.0f);
             temp_v1_2 |= !EnZf_PrimaryFloorCheck(this, play, 220.0f) << 1;
@@ -1577,7 +1578,7 @@ void EnZf_HopAway(EnZf* this, PlayState* play) {
             } else {
                 Math_SmoothStepToS(&this->actor.world.rot.y, sp5A, 1, 0xFA0, 0);
                 this->actor.shape.rot.y = this->actor.world.rot.y + 0x8000;
-                D_80B4AB30++;
+                sUnusedHopCounter++;  // was D_80B4AB30 [LLM:HIGH]
             }
             break;
 
