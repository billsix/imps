From 5431edb556698a97c321ea4caceb93bac43f967a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:30:41 +0000
Subject: [PATCH 1608/3799] soh: rename func_80AACCA0 -> EnMk_TurnAway

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: spins the researcher away over the mixing timer, then switches to the next animation and stage.
Defined in soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
index 6dd98cc5c..62b7dc564 100644
--- a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
+++ b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
@@ -143,7 +143,8 @@ void func_80AACC04(EnMk* this, PlayState* play) {
     }
 }
 
-void func_80AACCA0(EnMk* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AACCA0: spins the researcher away over the mixing timer, then switches to the next animation and stage.
+void EnMk_TurnAway(EnMk* this, PlayState* play) {
     if (this->timer > 0) {
         this->timer--;
         this->actor.shape.rot.y += 0x800;
@@ -162,7 +163,7 @@ void EnMk_StartMixing(EnMk* this, PlayState* play) {
 
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT) && Message_ShouldAdvance(play)) {
         Message_CloseTextbox(play);
-        this->actionFunc = func_80AACCA0;
+        this->actionFunc = EnMk_TurnAway;  // was func_80AACCA0 [LLM:HIGH]
         play->msgCtx.msgMode = MSGMODE_PAUSED;
         player->exchangeItemId = EXCH_ITEM_NONE;
         this->timer = GameInteractor_Should(VB_PLAY_EYEDROP_CREATION_ANIM, true, this) ? 16 : 0;
-- 
