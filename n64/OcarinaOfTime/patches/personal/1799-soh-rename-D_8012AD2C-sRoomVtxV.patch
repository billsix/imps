From bede5687f4703e63338778fd9300d70034035106 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:17 +0000
Subject: [PATCH 1799/3799] soh: rename D_8012AD2C -> sRoomVtxV

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the nine texture V coordinates for the same grid.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 87ffc7d0b..568f3a6f7 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -96,7 +96,8 @@ s16 sRoomVtxU[5] = {  // was D_8012AD20 [LLM:HIGH]
     0x0000, 0x0FC0, 0x1F80, 0x2F40, 0x3F00,
 };
 
-s16 D_8012AD2C[9] = {
+// LLM generated name (HIGH), was D_8012AD2C: the nine texture V coordinates for the same grid.
+s16 sRoomVtxV[9] = {  // was D_8012AD2C [LLM:HIGH]
     0x0000, 0x07C0, 0x0F80, 0x1740, 0x1F00, 0x26C0, 0x2E80, 0x3640, 0x3E00,
 };
 
@@ -188,7 +189,7 @@ s32 func_800ADBB0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp358[k] = pad42C;
                     sp2A4[k] = pad428;
                     sp13C[k] = sRoomVtxU[j];  // was D_8012AD20 [LLM:HIGH]
-                    sp88[k] = D_8012AD2C[i];
+                    sp88[k] = sRoomVtxV[i];  // was D_8012AD2C [LLM:HIGH]
                     pad42C += arg6;
                 }
                 pad428 += arg7;
@@ -206,7 +207,7 @@ s32 func_800ADBB0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp2A4[k] = pad428;
                     sp1F0[k] = pad42C;
                     sp13C[k] = sRoomVtxU[j];  // was D_8012AD20 [LLM:HIGH]
-                    sp88[k] = D_8012AD2C[i];
+                    sp88[k] = sRoomVtxV[i];  // was D_8012AD2C [LLM:HIGH]
                     pad42C += arg6;
                 }
                 pad428 += arg7;
@@ -224,7 +225,7 @@ s32 func_800ADBB0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp358[k] = pad42C;
                     sp1F0[k] = pad428;
                     sp13C[k] = sRoomVtxU[j];  // was D_8012AD20 [LLM:HIGH]
-                    sp88[k] = D_8012AD2C[i];
+                    sp88[k] = sRoomVtxV[i];  // was D_8012AD2C [LLM:HIGH]
                     pad42C += arg6;
                 }
                 pad428 += arg7;
-- 
