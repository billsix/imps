From 6af2bdd8d88ce31ad3e7028fde132662b6846bfa Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:46:31 +0000
Subject: [PATCH 1070/3799] soh: rename D_80B3BF70 -> sXluDLists

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the optional translucent overlay drawn on top of sDLists, NULL for the drawTypes that have none.
Defined in soh/src/overlays/actors/ovl_En_Wood02/z_en_wood02.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/soh/Enhancements/randomizer/ShuffleTrees.cpp    | 2 +-
 soh/src/overlays/actors/ovl_En_Wood02/z_en_wood02.c | 7 ++++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/soh/Enhancements/randomizer/ShuffleTrees.cpp b/soh/soh/Enhancements/randomizer/ShuffleTrees.cpp
index 5f0381a43..9cf61bc54 100644
--- a/soh/soh/Enhancements/randomizer/ShuffleTrees.cpp
+++ b/soh/soh/Enhancements/randomizer/ShuffleTrees.cpp
@@ -20,7 +20,7 @@ static Gfx* sDLists[] = {  // was D_80B3BF54 [LLM:HIGH]
     (Gfx*)object_wood02_DL_000700,
 };
 
-static Gfx* D_80B3BF70[] = {
+static Gfx* sXluDLists[] = {  // was D_80B3BF70 [LLM:HIGH]
     (Gfx*)object_wood02_DL_007968,
     (Gfx*)object_wood02_DL_007D38,
     (Gfx*)object_wood02_DL_0081A8,
diff --git a/soh/src/overlays/actors/ovl_En_Wood02/z_en_wood02.c b/soh/src/overlays/actors/ovl_En_Wood02/z_en_wood02.c
index 342626b24..32d409b57 100644
--- a/soh/src/overlays/actors/ovl_En_Wood02/z_en_wood02.c
+++ b/soh/src/overlays/actors/ovl_En_Wood02/z_en_wood02.c
@@ -81,7 +81,8 @@ static Gfx* sDLists[] = {  // was D_80B3BF54 [LLM:HIGH]
     object_wood02_DL_000340, object_wood02_DL_000340, object_wood02_DL_000700,
 };
 
-static Gfx* D_80B3BF70[] = {
+// LLM generated name (HIGH), was D_80B3BF70: the optional translucent overlay drawn on top of sDLists, NULL for the drawTypes that have none.
+static Gfx* sXluDLists[] = {  // was D_80B3BF70 [LLM:HIGH]
     object_wood02_DL_007968,
     object_wood02_DL_007D38,
     object_wood02_DL_0081A8,
@@ -468,11 +469,11 @@ void EnWood02_Draw(Actor* thisx, PlayState* play) {
         Gfx_SetupDL_25Opa(gfxCtx);
         gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, red, green, blue, 127);
         Gfx_DrawDListOpa(play, object_wood02_DL_000700);
-    } else if (GameInteractor_Should(VB_TREE_SETUP_DRAW, D_80B3BF70[this->drawType & 0xF] != NULL, this)) {
+    } else if (GameInteractor_Should(VB_TREE_SETUP_DRAW, sXluDLists[this->drawType & 0xF] != NULL, this)) {  // was D_80B3BF70 [LLM:HIGH]
         Gfx_DrawDListOpa(play, sDLists[this->drawType & 0xF]);  // was D_80B3BF54 [LLM:HIGH]
         gDPSetEnvColor(POLY_XLU_DISP++, red, green, blue, 0);
         gSPMatrix(POLY_XLU_DISP++, MATRIX_NEWMTX(gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
-        gSPDisplayList(POLY_XLU_DISP++, D_80B3BF70[this->drawType & 0xF]);
+        gSPDisplayList(POLY_XLU_DISP++, sXluDLists[this->drawType & 0xF]);  // was D_80B3BF70 [LLM:HIGH]
     } else {
         Gfx_SetupDL_25Xlu(gfxCtx);
         gSPMatrix(POLY_XLU_DISP++, MATRIX_NEWMTX(gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
