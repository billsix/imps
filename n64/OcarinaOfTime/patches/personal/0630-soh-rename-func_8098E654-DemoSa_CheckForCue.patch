From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:16 +0000
Subject: [PATCH 0630/3799] soh: rename func_8098E654 -> DemoSa_CheckForCue

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 2384cfb50..d95181544 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -172,7 +172,8 @@ CsCmdActorCue* DemoSa_GetNpcAction(PlayState* play, s32 idx) {
     return NULL;
 }
 
-s32 func_8098E654(DemoSa* this, PlayState* play, u16 arg2, s32 arg3) {
+// Name from zeldaret/oot (was func_8098E654): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+s32 DemoSa_CheckForCue(DemoSa* this, PlayState* play, u16 arg2, s32 arg3) {
     CsCmdActorCue* npcAction = DemoSa_GetNpcAction(play, arg3);
 
     if ((npcAction != NULL) && (npcAction->action == arg2)) {
@@ -402,7 +403,7 @@ void DemoSa_SageMagic_SpawnLightBall(DemoSa* this, PlayState* play) {
 }
 
 void func_8098EEA8(DemoSa* this, PlayState* play) {
-    if (func_8098E654(this, play, 4, 4)) {
+    if (DemoSa_CheckForCue(this, play, 4, 4)) {
         this->action = 8;
         this->drawConfig = 2;
         this->alpha = 0;
@@ -416,7 +417,7 @@ void func_8098EEFC(DemoSa* this, PlayState* play) {
     s32 alpha = 255;
     f32* unk_1A0 = &this->unk_1A0;
 
-    if (func_8098E654(this, play, 4, 4)) {
+    if (DemoSa_CheckForCue(this, play, 4, 4)) {
         *unk_1A0 += 1.0f;
         if ((kREG(5) + 10.0f) <= *unk_1A0) {
             this->action = 9;
-- 
