From d27070846a32b954cf3e8c80c1e5aac9978dc39a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:56 +0000
Subject: [PATCH 3299/3799] soh: rename D_8086467C -> sSwordQuad1Offset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the first corner of the sword collider quad
Defined in soh/src/overlays/actors/ovl_En_Test/z_en_test.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Test/z_en_test.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Test/z_en_test.c b/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
index 974e4279a..39d979245 100644
--- a/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
+++ b/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
@@ -1868,7 +1868,7 @@ void EnTest_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
     static Vec3f D_80864658 = { 300.0f, 0.0f, 0.0f };
     static Vec3f D_80864664 = { 3400.0f, 0.0f, 0.0f };
     static Vec3f sLimbOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_80864670 [LLM:HIGH]
-    static Vec3f D_8086467C = { 7000.0f, 1000.0f, 0.0f };
+    static Vec3f sSwordQuad1Offset = { 7000.0f, 1000.0f, 0.0f };  // was D_8086467C [LLM:HIGH]
     static Vec3f D_80864688 = { 3000.0f, -2000.0f, -1000.0f };
     static Vec3f D_80864694 = { 3000.0f, -2000.0f, 1000.0f };
     static Vec3f D_808646A0 = { -1300.0f, 1100.0f, 0.0f };
@@ -1888,7 +1888,7 @@ void EnTest_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
     BodyBreak_SetInfo(&this->bodyBreak, limbIndex, 0, 60, 60, dList, BODYBREAK_OBJECT_DEFAULT);
 
     if (limbIndex == STALFOS_LIMB_SWORD) {
-        Matrix_MultVec3f(&D_8086467C, &this->swordCollider.dim.quad[1]);
+        Matrix_MultVec3f(&sSwordQuad1Offset, &this->swordCollider.dim.quad[1]);  // was D_8086467C [LLM:HIGH]
         Matrix_MultVec3f(&D_80864688, &this->swordCollider.dim.quad[0]);
         Matrix_MultVec3f(&D_80864694, &this->swordCollider.dim.quad[3]);
         Matrix_MultVec3f(&D_808646A0, &this->swordCollider.dim.quad[2]);
-- 
