Subject: [PATCH 253/784] soh: rename func_8006472C -> Cutscene_StepTimer

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.88.
Defined in soh/src/code/z_demo.c.
---
 soh/src/code/z_demo.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_demo.c b/soh/src/code/z_demo.c
index 2c8c95c61..2a41effb9 100644
--- a/soh/src/code/z_demo.c
+++ b/soh/src/code/z_demo.c
@@ -194,7 +194,8 @@ void func_800645A0(PlayState* play, CutsceneContext* csCtx) {
 void CutsceneHandler_DoNothing(PlayState* play, CutsceneContext* csCtx) {
 }
 
-u32 func_8006472C(PlayState* play, CutsceneContext* csCtx, f32 target) {
+// Name from zeldaret/oot (was func_8006472C): adopted upstream's name for this address; body verified to match upstream at 0.88. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_demo.c]
+u32 Cutscene_StepTimer(PlayState* play, CutsceneContext* csCtx, f32 target) {
     return Math_StepToF(&csCtx->unk_0C, target, 0.1f);
 }
 
@@ -202,7 +203,7 @@ void func_80064760(PlayState* play, CutsceneContext* csCtx) {
     Interface_ChangeHudVisibilityMode(1);
     Letterbox_SetSizeTarget(0x20);
 
-    if (func_8006472C(play, csCtx, 1.0f)) {
+    if (Cutscene_StepTimer(play, csCtx, 1.0f)) {
         Audio_SetCutsceneFlag(1);
         csCtx->state++;
     }
@@ -213,7 +214,7 @@ void func_800647C0(PlayState* play, CutsceneContext* csCtx) {
     Interface_ChangeHudVisibilityMode(1);
     Letterbox_SetSizeTarget(0x20);
 
-    if (func_8006472C(play, csCtx, 1.0f)) {
+    if (Cutscene_StepTimer(play, csCtx, 1.0f)) {
         Audio_SetCutsceneFlag(1);
         csCtx->state++;
     }
@@ -2092,7 +2093,7 @@ void func_80068C3C(PlayState* play, CutsceneContext* csCtx) {
 }
 
 void func_80068D84(PlayState* play, CutsceneContext* csCtx) {
-    if (func_8006472C(play, csCtx, 0.0f)) {
+    if (Cutscene_StepTimer(play, csCtx, 0.0f)) {
         Audio_SetCutsceneFlag(0);
         csCtx->state = CS_STATE_IDLE;
     }
@@ -2101,7 +2102,7 @@ void func_80068D84(PlayState* play, CutsceneContext* csCtx) {
 void func_80068DC0(PlayState* play, CutsceneContext* csCtx) {
     s16 i;
 
-    if (func_8006472C(play, csCtx, 0.0f)) {
+    if (Cutscene_StepTimer(play, csCtx, 0.0f)) {
         csCtx->linkAction = NULL;
 
         for (i = 0; i < 10; i++) {
