                 Message_ContinueTextbox(play, 0x10C1);
-                this->actionFunc = func_80ACB4FC;
+                this->actionFunc = EnOwl_LWPreSariaAdvance;  // was func_80ACB4FC [LLM:HIGH]
                 break;
             case OWL_OK:
                 Message_ContinueTextbox(play, 0x10C3);
@@ -700,7 +701,7 @@ void EnOwl_LWPreSariaChoice(EnOwl* this, PlayState* play) {
     }
 }
 
-void func_80ACB4FC(EnOwl* this, PlayState* play) {
