From 33c48abd702e35e11de3d1df596be12ed2d39fa7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:27 +0000
Subject: [PATCH 675/784] soh: rename func_80A77474 -> EnIk_SetupCsAction5

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index 7b2c4fbbe..61805fe3e 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -1189,7 +1189,8 @@ void EnIk_SetupCsAction4(EnIk* this, PlayState* play) {
     this->actor.shape.shadowAlpha = 0xFF;
 }
 
-void func_80A77474(EnIk* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80A77474): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ik/z_en_ik.c]
+void EnIk_SetupCsAction5(EnIk* this, PlayState* play) {
     this->action = 5;
     this->drawMode = 0;
     this->actor.shape.shadowAlpha = 0;
@@ -1313,7 +1314,7 @@ void func_80A779DC(EnIk* this, PlayState* play) {
                     EnIk_SetupCsAction4(this, play);
                     break;
                 case 7:
-                    func_80A77474(this, play);
+                    EnIk_SetupCsAction5(this, play);
                     break;
                 default:
                     osSyncPrintf("En_Ik_inConfrontion_Check_DemoMode:そんな動作は無い!!!!!!!!\n");
