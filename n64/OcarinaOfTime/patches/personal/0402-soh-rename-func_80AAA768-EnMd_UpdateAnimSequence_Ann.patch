+void EnMd_UpdateAnimSequence_AnnoyedToHalt(EnMd* this) {
     switch (this->animSequenceEntry) {
         case 0:
             Animation_ChangeByInfo(&this->skelAnime, sAnimationInfo, ENMD_ANIM_12);
@@ -298,7 +299,7 @@ void EnMd_UpdateAnimSequence(EnMd* this) {
