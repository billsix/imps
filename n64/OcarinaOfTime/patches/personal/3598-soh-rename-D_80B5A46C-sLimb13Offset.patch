From 1cecd2645559c55224c2af9989a0aa07b878a162 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:37 +0000
Subject: [PATCH 3598/3799] soh: rename D_80B5A46C -> sLimb13Offset

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the {0,0,0} vector Matrix_MultVec3f-ed at limb 13 in EnZl3_PostLimbDraw to fill this->unk_31C. Zero, so it just samples the limb matrix origin
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 225621ecc..279fcdcf2 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -50,7 +50,8 @@ static void* sMouthTextures[] = { gZelda2MouthSeriousTex, gZelda2MouthHappyTex,
 // LLM generated name (GUESS), was D_80B5A468: set to 1 once the yaw error to the player exceeds 0x1556 and cleared when EnZl3_StepYawTowardsPlayer reports the turn finished; gates that turn in EnZl3_UpdateTurnToPlayer. Reset by EnZl3_Reset and listed in EN_ZL3_SHIP_SAVESTATE_FIELDS
 static s32 sTurningToPlayer = 0;  // was D_80B5A468 [LLM:GUESS]
 
-static Vec3f D_80B5A46C = { 0.0f, 0.0f, 0.0f };
+// LLM generated name (GUESS), was D_80B5A46C: the {0,0,0} vector Matrix_MultVec3f-ed at limb 13 in EnZl3_PostLimbDraw to fill this->unk_31C. Zero, so it just samples the limb matrix origin
+static Vec3f sLimb13Offset = { 0.0f, 0.0f, 0.0f };  // was D_80B5A46C [LLM:GUESS]
 
 static Vec3f D_80B5A478 = { 0.0f, 10.0f, 0.0f };
 
@@ -717,7 +718,7 @@ void EnZl3_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
     Vec3f sp18;
 
     if (limbIndex == 13) {
-        sp34 = D_80B5A46C;
+        sp34 = sLimb13Offset;  // was D_80B5A46C [LLM:GUESS]
         Matrix_MultVec3f(&sp34, &this->unk_31C);
     } else if (limbIndex == 14) {
         sp24 = D_80B5A478;
-- 
