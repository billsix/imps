     { 28.0f, 0.01f, 6, 30.0f },  { 28.0f, 0.01f, 6, 30.0f },
 };
 
-static f32 D_80A482D8[14][2] = {
+// Name from zeldaret/oot (was D_80A482D8): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Go2/z_en_go2.c]
