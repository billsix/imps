From f662a61283a251e210f49d30a4ae645589ae221f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:12 +0000
Subject: [PATCH 169/488] soh: rename D_809E010C -> sHeadFocusOffset

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Cow/z_en_cow.c.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Cow/z_en_cow.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Cow/z_en_cow.c b/soh/src/overlays/actors/ovl_En_Cow/z_en_cow.c
index c993d03bc..3196261f8 100644
--- a/soh/src/overlays/actors/ovl_En_Cow/z_en_cow.c
+++ b/soh/src/overlays/actors/ovl_En_Cow/z_en_cow.c
@@ -59,7 +59,8 @@ static ColliderCylinderInit sCylinderInit = {
     { 30, 40, 0, { 0, 0, 0 } },
 };
 
-static Vec3f D_809E010C = { 0.0f, -1300.0f, 1100.0f };
+// Name from zeldaret/oot (was D_809E010C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Cow/z_en_cow.c]
+static Vec3f sHeadFocusOffset = { 0.0f, -1300.0f, 1100.0f };
 
 void EnCow_RotateY(Vec3f* vec, s16 rotY) {
     f32 xCalc;
@@ -376,7 +377,7 @@ void EnCow_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
     EnCow* this = (EnCow*)thisx;
 
     if (limbIndex == 2) {
-        Matrix_MultVec3f(&D_809E010C, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sHeadFocusOffset, &this->actor.focus.pos);
     }
 }
 
