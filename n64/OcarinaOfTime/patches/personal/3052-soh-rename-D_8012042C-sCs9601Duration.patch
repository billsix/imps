From b6d7f0f45610def6373f669218af80b4fad148de Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:35 +0000
Subject: [PATCH 3052/3799] soh: rename D_8012042C -> sCs9601Duration

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the duration argument for 9601 and 9602
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 8 ++++----
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index f94eec173..75b2d34a9 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -370,17 +370,17 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
         case 9601:
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Play_CameraChangeSetting(play, CAM_ID_MAIN, mainCam->prevSetting);
-            if (GameInteractor_Should(VB_CRAWL_SPEED_EXIT_CS, true, csCam, csId, D_80120430, D_8012042C, sCs9601AtPoints,  // was D_80120308 [LLM:HIGH]
+            if (GameInteractor_Should(VB_CRAWL_SPEED_EXIT_CS, true, csCam, csId, D_80120430, sCs9601Duration, sCs9601AtPoints,  // was D_80120308 [LLM:HIGH]
                                       sCs9601EyePoints)) {  // was D_80120398 [LLM:HIGH]
-                OnePointCutscene_SetCsCamPoints(csCam, D_80120430 | 0x1000, D_8012042C, sCs9601AtPoints, sCs9601EyePoints);  // was D_80120308 [LLM:HIGH]
+                OnePointCutscene_SetCsCamPoints(csCam, D_80120430 | 0x1000, sCs9601Duration, sCs9601AtPoints, sCs9601EyePoints);  // was D_80120308 [LLM:HIGH]
             }
             break;
         case 9602:
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Play_CameraChangeSetting(play, CAM_ID_MAIN, mainCam->prevSetting);
-            if (GameInteractor_Should(VB_CRAWL_SPEED_EXIT_CS, true, csCam, csId, D_80120430, D_8012042C, sCs9601AtPoints,  // was D_80120308 [LLM:HIGH]
+            if (GameInteractor_Should(VB_CRAWL_SPEED_EXIT_CS, true, csCam, csId, D_80120430, sCs9601Duration, sCs9601AtPoints,  // was D_80120308 [LLM:HIGH]
                                       D_80120434)) {
-                OnePointCutscene_SetCsCamPoints(csCam, D_80120430 | 0x1000, D_8012042C, sCs9601AtPoints, D_80120434);  // was D_80120308 [LLM:HIGH]
+                OnePointCutscene_SetCsCamPoints(csCam, D_80120430 | 0x1000, sCs9601Duration, sCs9601AtPoints, D_80120434);  // was D_80120308 [LLM:HIGH]
             }
             break;
         case 4175:
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 54212339a..4c6cdd9ee 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -52,7 +52,8 @@ static CutsceneCameraPoint sCs9601EyePoints[9] = {  // was D_80120398 [LLM:HIGH]
 };
 // LLM generated name (HIGH), was D_80120428: the number of points in those arrays
 static s16 sCs9601PointCount = 9;  // was D_80120428 [LLM:HIGH]
-static s16 D_8012042C = 90;
+// LLM generated name (HIGH), was D_8012042C: the duration argument for 9601 and 9602
+static s16 sCs9601Duration = 90;  // was D_8012042C [LLM:HIGH]
 static s16 D_80120430 = 1;
 static CutsceneCameraPoint D_80120434[10] = {
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 9, -45 } },   { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 9, -45 } },
-- 
