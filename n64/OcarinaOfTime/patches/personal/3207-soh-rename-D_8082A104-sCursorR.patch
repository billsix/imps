From d1f98ea813950578984d411754f926ba3c262f93 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:00 +0000
Subject: [PATCH 3207/3799] soh: rename D_8082A104 -> sCursorR

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the current red of the quest cursor
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../misc/ovl_kaleido_scope/z_kaleido_collect.c     | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
index d8d98293f..3cafaf89c 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
@@ -24,7 +24,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
     static s16 sQuestItemB[] = { 150, 150, 150, 150, 150, 150 };  // was D_8082A0F0 [LLM:HIGH]
     static s16 sQuestItemFadeTimer = 20;  // was D_8082A0FC [LLM:HIGH]
     static s16 sQuestItemFadeState = 0;  // was D_8082A100 [LLM:HIGH]
-    static s16 D_8082A104 = 0;
+    static s16 sCursorR = 0;  // was D_8082A104 [LLM:HIGH]
     static s16 D_8082A108 = 0;
     static s16 D_8082A10C = 0;
     static s16 D_8082A110 = 0;
@@ -414,14 +414,14 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
         }
     }
 
-    sp226 = ABS(D_8082A104 - sCursorColorSets[D_8082A118][0]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
+    sp226 = ABS(sCursorR - sCursorColorSets[D_8082A118][0]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
     sp224 = ABS(D_8082A108 - sCursorColorSets[D_8082A118][1]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
     sp222 = ABS(D_8082A10C - sCursorColorSets[D_8082A118][2]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
     sp220 = ABS(D_8082A110 - sCursorColorSets[D_8082A118][3]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
-    if (D_8082A104 >= sCursorColorSets[D_8082A118][0]) {  // was D_8082A070 [LLM:HIGH]
-        D_8082A104 -= sp226;
+    if (sCursorR >= sCursorColorSets[D_8082A118][0]) {  // was D_8082A070 [LLM:HIGH]
+        sCursorR -= sp226;  // was D_8082A104 [LLM:HIGH]
     } else {
-        D_8082A104 += sp226;
+        sCursorR += sp226;  // was D_8082A104 [LLM:HIGH]
     }
     if (D_8082A108 >= sCursorColorSets[D_8082A118][1]) {  // was D_8082A070 [LLM:HIGH]
         D_8082A108 -= sp224;
@@ -440,7 +440,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
     }
 
     if (--D_8082A114 == 0) {
-        D_8082A104 = sCursorColorSets[D_8082A118][0];  // was D_8082A070 [LLM:HIGH]
+        sCursorR = sCursorColorSets[D_8082A118][0];  // was D_8082A070 [LLM:HIGH]
         D_8082A108 = sCursorColorSets[D_8082A118][1];  // was D_8082A070 [LLM:HIGH]
         D_8082A10C = sCursorColorSets[D_8082A118][2];  // was D_8082A070 [LLM:HIGH]
         D_8082A110 = sCursorColorSets[D_8082A118][3];  // was D_8082A070 [LLM:HIGH]
@@ -459,7 +459,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
             gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, sCursorColorSets[0][0], sCursorColorSets[0][1], sCursorColorSets[0][2],  // was D_8082A070 [LLM:HIGH]
                             pauseCtx->alpha);
         } else {
-            gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, D_8082A104, D_8082A108, D_8082A10C, D_8082A110);
+            gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, sCursorR, D_8082A108, D_8082A10C, D_8082A110);  // was D_8082A104 [LLM:HIGH]
         }
 
         gDPSetEnvColor(POLY_OPA_DISP++, 0, 0, 0, 255);
