diff --git a/soh/src/code/z_view.c b/soh/src/code/z_view.c
index a3515bec6..017f765d6 100644
--- a/soh/src/code/z_view.c
+++ b/soh/src/code/z_view.c
@@ -80,7 +80,8 @@ void View_GetParams(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up) {
     // view->flags |= 1;
 }
 
-void func_800AA358(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up) {
+// LLM generated name (HIGH), was func_800AA358: stores the eye, look-at and up vectors, nudging the eye off a perfectly vertical line first
+void View_LookAt(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up) {
     if (eye->x == lookAt->x && eye->z == lookAt->z) {
         eye->x += 0.1f;
     }
