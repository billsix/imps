Date: Mon, 7 Sep 2026 23:53:53 +0000
Subject: [PATCH 2804/3799] soh: rename func_80AD943C ->
 EnPoSisters_SetupCircle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the circling action
Defined in soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
index b62f68d19..b83ff9834 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
@@ -269,7 +269,8 @@ void EnPoSisters_SetupFloat(EnPoSisters* this) {
     this->actionFunc = func_80ADA530;
 }
 
-void func_80AD943C(EnPoSisters* this) {
+// LLM generated name (HIGH), was func_80AD943C: installs the circling action
+void EnPoSisters_SetupCircle(EnPoSisters* this) {
     this->actionFunc = func_80ADA6A0;
 }
 
@@ -623,7 +624,7 @@ void func_80ADA530(EnPoSisters* this, PlayState* play) {
         this->unk_19A--;
     }
     if (this->actor.xzDistToPlayer < 200.0f && fabsf(this->actor.yDistToPlayer + 5.0f) < 30.0f) {
-        func_80AD943C(this);
+        EnPoSisters_SetupCircle(this);  // was func_80AD943C [LLM:HIGH]
     } else if (this->unk_19A == 0 && Math_StepToF(&this->actor.speedXZ, 0.0f, 0.2f) != 0) {
         EnPoSisters_SetupSway(this);  // was func_80AD9368 [LLM:HIGH]
     }
