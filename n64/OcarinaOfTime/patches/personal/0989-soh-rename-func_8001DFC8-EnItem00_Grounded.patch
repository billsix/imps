From 3649266f497e655bb683d98c59e3b542106d620f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:33:18 +0000
Subject: [PATCH 0989/3799] soh: rename func_8001DFC8 -> EnItem00_Grounded

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the resting action: spins rupees, flips the shield drops, counts the despawn timers down and hands off to the falling action whenever the drop leaves the ground.
Defined in soh/src/code/z_en_item00.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_en_item00.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_en_item00.c b/soh/src/code/z_en_item00.c
index e4f7966d9..c0dee4b49 100644
--- a/soh/src/code/z_en_item00.c
+++ b/soh/src/code/z_en_item00.c
@@ -13,7 +13,8 @@ void EnItem00_Destroy(Actor* thisx, PlayState* play);
 void EnItem00_Update(Actor* thisx, PlayState* play);
 void EnItem00_Draw(Actor* thisx, PlayState* play);
 
-void func_8001DFC8(EnItem00* this, PlayState* play);
+// LLM generated name (HIGH), was func_8001DFC8: the resting action: spins rupees, flips the shield drops, counts the despawn timers down and hands off to the falling action whenever the drop leaves the ground.
+void EnItem00_Grounded(EnItem00* this, PlayState* play);  // was func_8001DFC8 [LLM:HIGH]
 void func_8001E1C8(EnItem00* this, PlayState* play);
 void func_8001E304(EnItem00* this, PlayState* play);
 // Name from zeldaret/oot (was func_8001E5C8): adopted upstream's name for this address; body verified to match upstream at 0.94. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_en_item00.c]
@@ -495,7 +496,7 @@ void EnItem00_Init(Actor* thisx, PlayState* play) {
     this->getItemId = GI_NONE;
 
     if (!spawnParam8000) {
-        EnItem00_SetupAction(this, func_8001DFC8);
+        EnItem00_SetupAction(this, EnItem00_Grounded);  // was func_8001DFC8 [LLM:HIGH]
         this->unk_15A = -1;
         return;
     }
@@ -594,7 +595,7 @@ void EnItem00_Destroy(Actor* thisx, PlayState* play) {
     Collider_DestroyCylinder(play, &this->collider);
 }
 
-void func_8001DFC8(EnItem00* this, PlayState* play) {
+void EnItem00_Grounded(EnItem00* this, PlayState* play) {
     if ((this->actor.params <= ITEM00_RUPEE_RED) || ((this->actor.params == ITEM00_HEART) && (this->unk_15A < 0)) ||
         (this->actor.params == ITEM00_HEART_PIECE)) {
         this->actor.shape.rot.y += 960;
@@ -659,7 +660,7 @@ void func_8001E1C8(EnItem00* this, PlayState* play) {
     if (this->actor.bgCheckFlags & 0x0003) {
         originalVelocity = this->actor.velocity.y;
         if (originalVelocity > -2.0f) {
-            EnItem00_SetupAction(this, func_8001DFC8);
+            EnItem00_SetupAction(this, EnItem00_Grounded);  // was func_8001DFC8 [LLM:HIGH]
             this->actor.velocity.y = 0.0f;
         } else {
             this->actor.velocity.y = originalVelocity * -0.8f;
@@ -715,7 +716,7 @@ void func_8001E304(EnItem00* this, PlayState* play) {
     }
 
     if (this->actor.bgCheckFlags & 0x0003) {
-        EnItem00_SetupAction(this, func_8001DFC8);
+        EnItem00_SetupAction(this, EnItem00_Grounded);  // was func_8001DFC8 [LLM:HIGH]
         this->actor.shape.rot.z = 0;
         this->actor.velocity.y = 0.0f;
         this->actor.speedXZ = 0.0f;
