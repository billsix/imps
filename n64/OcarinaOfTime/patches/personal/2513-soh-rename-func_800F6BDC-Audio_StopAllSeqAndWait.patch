 soh/src/code/audio_general.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 2559f1a97..b10c7caca 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -5443,7 +5443,8 @@ s8 Audio_GetActiveNoteCount(void) {
     return AudioThread_GetActiveNoteCount();
 }
 
-void func_800F6BDC(void) {
+// LLM generated name (HIGH), was func_800F6BDC: disables every sequence and spins until no notes are left playing
+void Audio_StopAllSeqAndWait(void) {
     Audio_DisableAllSeq();
     Audio_ScheduleProcessCmds();
     while (true) {
