From b22c64bf16840ca0ec303cd315472e44c4b0d0cc Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:31:18 +0000
Subject: [PATCH 1619/3799] soh: rename D_80AD7114 -> sDeathEffectVelocity

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the upward velocity given to the EffectSsDeadDb puffs spawned as the Poe dies.
Defined in soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
index 419bcada4..916e98e75 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
@@ -141,7 +141,8 @@ static InitChainEntry sInitChain[] = {
     ICHAIN_F32(targetArrowOffset, 3200, ICHAIN_STOP),
 };
 
-static Vec3f D_80AD7114 = { 0.0f, 3.0f, 0.0f };
+// LLM generated name (HIGH), was D_80AD7114: the upward velocity given to the EffectSsDeadDb puffs spawned as the Poe dies.
+static Vec3f sDeathEffectVelocity = { 0.0f, 3.0f, 0.0f };  // was D_80AD7114 [LLM:HIGH]
 
 static Vec3f D_80AD7120 = { 0.0f, 0.0f, 0.0f };
 
@@ -576,15 +577,15 @@ void EnPoField_Death(EnPoField* this, PlayState* play) {
             sp6C.x = Math_SinS(Camera_GetCamDirYaw(GET_ACTIVE_CAM(play)) + 0x4800) * 23.0f + this->actor.world.pos.x;
             sp6C.z = Math_CosS(Camera_GetCamDirYaw(GET_ACTIVE_CAM(play)) + 0x4800) * 23.0f + this->actor.world.pos.z;
         }
-        EffectSsDeadDb_Spawn(play, &sp6C, &D_80AD7114, &D_80AD7120, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,
+        EffectSsDeadDb_Spawn(play, &sp6C, &sDeathEffectVelocity, &D_80AD7120, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,  // was D_80AD7114 [LLM:HIGH]
                              0, 0, 255, 1, 9, 1);
         sp6C.x = (this->actor.world.pos.x + this->actor.world.pos.x) - sp6C.x;
         sp6C.z = (this->actor.world.pos.z + this->actor.world.pos.z) - sp6C.z;
-        EffectSsDeadDb_Spawn(play, &sp6C, &D_80AD7114, &D_80AD7120, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,
+        EffectSsDeadDb_Spawn(play, &sp6C, &sDeathEffectVelocity, &D_80AD7120, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,  // was D_80AD7114 [LLM:HIGH]
                              0, 0, 255, 1, 9, 1);
         sp6C.x = this->actor.world.pos.x;
         sp6C.z = this->actor.world.pos.z;
-        EffectSsDeadDb_Spawn(play, &sp6C, &D_80AD7114, &D_80AD7120, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,
+        EffectSsDeadDb_Spawn(play, &sp6C, &sDeathEffectVelocity, &D_80AD7120, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,  // was D_80AD7114 [LLM:HIGH]
                              0, 0, 255, 1, 9, 1);
         if (this->actionTimer == 1) {
             Audio_PlayActorSound2(&this->actor, NA_SE_EN_EXTINCT);
