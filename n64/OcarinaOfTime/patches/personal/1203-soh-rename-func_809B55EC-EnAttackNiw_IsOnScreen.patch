Date: Mon, 7 Sep 2026 21:57:24 +0000
Subject: [PATCH 1203/3799] soh: rename func_809B55EC -> EnAttackNiw_IsOnScreen

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns whether the cucco's projected position is still in front of the camera and inside the screen rectangle; every action kills the actor when it returns false.
Defined in soh/src/overlays/actors/ovl_En_Attack_Niw/z_en_attack_niw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Attack_Niw/z_en_attack_niw.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Attack_Niw/z_en_attack_niw.c b/soh/src/overlays/actors/ovl_En_Attack_Niw/z_en_attack_niw.c
index 8ad2b15c7..8111ff69e 100644
--- a/soh/src/overlays/actors/ovl_En_Attack_Niw/z_en_attack_niw.c
+++ b/soh/src/overlays/actors/ovl_En_Attack_Niw/z_en_attack_niw.c
@@ -170,7 +170,8 @@ void EnAttackNiw_UpdateFlapping(EnAttackNiw* this, PlayState* play, s16 arg2) {
     }
 }
 
-s32 func_809B55EC(EnAttackNiw* this, PlayState* play) {
+// LLM generated name (HIGH), was func_809B55EC: returns whether the cucco's projected position is still in front of the camera and inside the screen rectangle; every action kills the actor when it returns false.
+s32 EnAttackNiw_IsOnScreen(EnAttackNiw* this, PlayState* play) {
     s16 sp1E;
     s16 sp1C;
 
@@ -248,7 +249,7 @@ void func_809B5670(EnAttackNiw* this, PlayState* play) {
 }
 
 void func_809B59B0(EnAttackNiw* this, PlayState* play) {
-    if (!func_809B55EC(this, play)) {
+    if (!EnAttackNiw_IsOnScreen(this, play)) {  // was func_809B55EC [LLM:HIGH]
         Actor_Kill(&this->actor);
         return;
     }
@@ -289,7 +290,7 @@ void func_809B59B0(EnAttackNiw* this, PlayState* play) {
 }
 
 void func_809B5C18(EnAttackNiw* this, PlayState* play) {
-    if (!func_809B55EC(this, play)) {
+    if (!EnAttackNiw_IsOnScreen(this, play)) {  // was func_809B55EC [LLM:HIGH]
         Actor_Kill(&this->actor);
         return;
     }
