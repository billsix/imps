From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:33 +0000
Subject: [PATCH 0332/3799] soh: rename func_8098EE28 ->
 DemoSa_SageMagic_SpawnLightBall

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 2572dfa6f..e2bc92c53 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -391,7 +391,8 @@ void DemoSa_Sfx_WhiteOut(void) {
     Sfx_PlaySfxCentered2(NA_SE_SY_WHITE_OUT_T);
 }
 
-void func_8098EE28(DemoSa* this, PlayState* play) {
+// Name from zeldaret/oot (was func_8098EE28): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_SageMagic_SpawnLightBall(DemoSa* this, PlayState* play) {
     Actor_SpawnAsChild(&play->actorCtx, &this->actor, play, ACTOR_DEMO_6K, this->actor.world.pos.x,
                        (kREG(23) + 25.0f) + this->actor.world.pos.y, this->actor.world.pos.z, 0, 0, 0, 4);
 }
@@ -442,7 +443,7 @@ void func_8098F050(DemoSa* this, PlayState* play) {
         this->unk_1A0 = kREG(5) + 10.0f;
         this->alpha = 255;
         if (this->unk_1A8 == 0) {
-            func_8098EE28(this, play);
+            DemoSa_SageMagic_SpawnLightBall(this, play);
             this->unk_1A8 = 1;
         }
         this->actor.shape.shadowAlpha = 0xFF;
