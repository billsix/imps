                 EffectSsStick_Spawn(play, &this->bodyPartsPos[PLAYER_BODYPART_R_HAND],
                                     this->actor.shape.rot.y + 0x8000);
-                func_800849EC(play);
+                Interface_SwapGiantsKnife(play);  // was func_800849EC [LLM:HIGH]
                 Player_PlaySfx(this, NA_SE_IT_MAJIN_SWORD_BROKEN);
             }
         }
