From 49173e1cdd68cb484c2dcc6096785c018976cde8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:18:19 +0000
Subject: [PATCH 1421/3799] soh: rename D_80A481F8 -> sShapeData

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-Goron-variant shadow scale, actor scale, target mode and interact range, all applied by EnGo2_SetShape.
Defined in soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
index 669461d00..664413d3d 100644
--- a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
+++ b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
@@ -117,7 +117,8 @@ static EnGo2DataStruct1 sColliderDims[14] = {  // was D_80A4816C [LLM:HIGH]
     { 0, 0, 0, 30, 68 },  { 0, 0, 0, 30, 68 }, { 0, 0, 0, 30, 68 },       { 0, 0, 0, 30, 68 },
 };
 
-static EnGo2DataStruct2 D_80A481F8[14] = {
+// LLM generated name (HIGH), was D_80A481F8: per-Goron-variant shadow scale, actor scale, target mode and interact range, all applied by EnGo2_SetShape.
+static EnGo2DataStruct2 sShapeData[14] = {  // was D_80A481F8 [LLM:HIGH]
     { 30.0f, 0.026f, 6, 60.0f }, { 24.0f, 0.008f, 6, 30.0f }, { 28.0f, 0.16f, 5, 380.0f }, { 28.0f, 0.01f, 7, 40.0f },
     { 30.0f, 0.015f, 6, 30.0f }, { 28.0f, 0.01f, 6, 30.0f },  { 28.0f, 0.01f, 6, 30.0f },  { 28.0f, 0.01f, 6, 30.0f },
     { 28.0f, 0.01f, 6, 30.0f },  { 28.0f, 0.01f, 6, 30.0f },  { 28.0f, 0.01f, 6, 30.0f },  { 28.0f, 0.01f, 6, 30.0f },
@@ -852,10 +853,10 @@ void EnGo2_SetColliderDim(EnGo2* this) {
 void EnGo2_SetShape(EnGo2* this) {
     u8 index = this->actor.params & 0x1F;
 
-    this->actor.shape.shadowScale = D_80A481F8[index].shape_unk_10;
-    Actor_SetScale(&this->actor, D_80A481F8[index].scale);
-    this->actor.targetMode = D_80A481F8[index].actor_unk_1F;
-    this->interactRange = D_80A481F8[index].interactRange;
+    this->actor.shape.shadowScale = sShapeData[index].shape_unk_10;  // was D_80A481F8 [LLM:HIGH]
+    Actor_SetScale(&this->actor, sShapeData[index].scale);  // was D_80A481F8 [LLM:HIGH]
+    this->actor.targetMode = sShapeData[index].actor_unk_1F;  // was D_80A481F8 [LLM:HIGH]
+    this->interactRange = sShapeData[index].interactRange;  // was D_80A481F8 [LLM:HIGH]
     this->interactRange += this->collider.dim.radius;
 }
 
