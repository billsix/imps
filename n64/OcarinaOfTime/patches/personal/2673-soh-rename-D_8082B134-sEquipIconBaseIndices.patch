From f149bf802fdf792b91221ccc98db17e8b087064c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:43 +0000
Subject: [PATCH 2673/3799] soh: rename D_8082B134 -> sEquipIconBaseIndices

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: added to each equipment value to reach its icon index; which icon table it lands in is not established
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 7b74ee486..945967c0b 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -3026,7 +3026,8 @@ static s16 D_8082B11C_all[] = { 0,  4,  8,  12, 16, 20, 24, 28, 32, 36, 40, 44,
 // LLM generated name (HIGH), was D_8082B12C: the X position of each of the four equipment columns
 static s16 sEquipColumnX[] = { -114, 12, 44, 76 };  // was D_8082B12C [LLM:HIGH]
 
-static u8 D_8082B134[] = { 1, 5, 9, 13 };
+// LLM generated name (GUESS), was D_8082B134: added to each equipment value to reach its icon index; which icon table it lands in is not established
+static u8 sEquipIconBaseIndices[] = { 1, 5, 9, 13 };  // was D_8082B134 [LLM:GUESS]
 
 static s16 D_8082B138[] = {
     74,  74,  46,  18,  18,  46,   -108, -90,  -72, -54, -36, -18, -108, -90, -72, -54,
@@ -3336,7 +3337,7 @@ void KaleidoScope_InitVertices(PlayState* play, GraphicsContext* gfxCtx) {
 
     for (phi_t3 = 0; phi_t3 < 4; phi_t3++, phi_t4 += 4) {
         if (CUR_EQUIP_VALUE(phi_t3) != 0) {
-            phi_t2 = (CUR_EQUIP_VALUE(phi_t3) + D_8082B134[phi_t3] - 1) * 4;
+            phi_t2 = (CUR_EQUIP_VALUE(phi_t3) + sEquipIconBaseIndices[phi_t3] - 1) * 4;  // was D_8082B134 [LLM:GUESS]
 
             pauseCtx->equipVtx[phi_t4 + 0].v.ob[0] = pauseCtx->equipVtx[phi_t4 + 2].v.ob[0] =
                 pauseCtx->equipVtx[phi_t2].v.ob[0] - 2;
