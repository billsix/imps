     static Vec3f sCrownOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_8094A944 [LLM:HIGH]
     static Vec3f sCrownOffset = { 0.0f, 2000.0f, -2000.0f };  // was D_8094A950 [LLM:HIGH]
