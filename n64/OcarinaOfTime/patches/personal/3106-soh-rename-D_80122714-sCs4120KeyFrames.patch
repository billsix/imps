From 52464d42c409dd6a42ed816462c829bc36b9d48e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:41 +0000
Subject: [PATCH 3106/3799] soh: rename D_80122714 -> sCs4120KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 4120 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 6 +++---
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 830010464..84c95ffc5 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -35,7 +35,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs3290KeyFrames)                                   \
     F(sCs3340KeyFrames)                                   \
     F(sCs3350KeyFrames)                                   \
-    F(D_80122714)                                   \
+    F(sCs4120KeyFrames)                                   \
     F(D_80122CB4)                                   \
     F(D_80122D04)                                   \
     F(D_80122E44)                                   \
@@ -852,8 +852,8 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             break;
         case 4120:
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
-            D_80122714[1].timerInit = 80;
-            csInfo->keyFrames = D_80122714;
+            sCs4120KeyFrames[1].timerInit = 80;  // was D_80122714 [LLM:HIGH]
+            csInfo->keyFrames = sCs4120KeyFrames;  // was D_80122714 [LLM:HIGH]
             csInfo->keyFrameCnt = 4;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 9cf38e446..e53f0bee9 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -505,7 +505,8 @@ static OnePointCsFull sCs4110KeyFrames[3] = {  // was D_8012269C [LLM:HIGH]
     { 0x11, 0xFF, 0x0000, 1, -1, -1.0f, -1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80122714[4] = {
+// LLM generated name (HIGH), was D_80122714: the keyframe set one-point cutscene 4120 installs
+static OnePointCsFull sCs4120KeyFrames[4] = {  // was D_80122714 [LLM:HIGH]
     { 0x0F, 0xFF, 0x0101, 20, 0, 45.0f, 1.0f, { -915.0f, -2185.0f, 6335.0f }, { -915.0f, -2290.0f, 6165.0f } },
     { 0x02, 0xFF, 0x0101, -1, 0, 80.0f, 0.8f, { -920.0f, -2270.0f, 6140.0f }, { -920.0f, -2280.0f, 6070.0f } },
     { 0x02, 0xFF, 0x0101, 20, 0, 80.0f, 0.9f, { -920.0f, -2300.0f, 6140.0f }, { -920.0f, -2300.0f, 6070.0f } },
