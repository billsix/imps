From 87849a9bb306297bd62c70a94d254c81733b3a15 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:10 +0000
Subject: [PATCH 0939/3799] soh: rename D_801157CC -> sVtxTemplateRest

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Vtx_t[4] copied four vertices at a time for each remaining blure element after the first.
Defined in soh/src/code/z_eff_blure.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_eff_blure.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_eff_blure.c b/soh/src/code/z_eff_blure.c
index 1fcbc6317..f0033ace8 100644
--- a/soh/src/code/z_eff_blure.c
+++ b/soh/src/code/z_eff_blure.c
@@ -966,7 +966,8 @@ Vtx_t sVtxTemplateFirst[] = {  // was D_8011578C [LLM:HIGH]
     VTX_T(0, 0, 0, 2048, 0, 0xFF, 0xFF, 0xFF, 0xFF),
 };
 
-Vtx_t D_801157CC[] = {
+// LLM generated name (HIGH), was D_801157CC: Vtx_t[4] copied four vertices at a time for each remaining blure element after the first.
+Vtx_t sVtxTemplateRest[] = {  // was D_801157CC [LLM:HIGH]
     VTX_T(0, 0, 0, 2048, 1024, 0xFF, 0xFF, 0xFF, 0xFF),
     VTX_T(0, 0, 0, 2048, 0, 0xFF, 0xFF, 0xFF, 0xFF),
     VTX_T(0, 0, 0, 2048, 1024, 0xFF, 0xFF, 0xFF, 0xFF),
@@ -1006,7 +1007,7 @@ void EffectBlure_DrawSimple(EffectBlure* this2, GraphicsContext* gfxCtx) {
         if (this->numElements >= 2) {
             for (elem = this->elements; elem < this->elements + this->numElements - 2; elem++) {
                 for (i = 0; i < 4; i++) {
-                    vtxIter->v = D_801157CC[i];
+                    vtxIter->v = sVtxTemplateRest[i];  // was D_801157CC [LLM:HIGH]
                     vtxIter++;
                 }
             }
