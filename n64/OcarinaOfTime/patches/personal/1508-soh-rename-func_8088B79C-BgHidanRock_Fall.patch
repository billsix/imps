From a6f84f19f461b661f9389d159556e5964c211bb4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:23:58 +0000
Subject: [PATCH 1508/3799] soh: rename func_8088B79C -> BgHidanRock_Fall

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: falls under gravity, fading the flame out on the way, and on landing plays the impact and surface sfx before either restarting the cycle or settling.
Defined in soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c        | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
index f4f83a5f9..6fc3fd3c4 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
@@ -27,7 +27,8 @@ void BgHidanRock_Delay(BgHidanRock* this, PlayState* play);  // was func_8088B5F
 void BgHidanRock_WaitForPlayer(BgHidanRock* this, PlayState* play);  // was func_8088B634 [LLM:HIGH]
 // LLM generated name (HIGH), was func_8088B69C: jitters the block in a small circle with rumble and the block-shake sfx, then recentres it and starts the rise.
 void BgHidanRock_Shake(BgHidanRock* this, PlayState* play);  // was func_8088B69C [LLM:HIGH]
-void func_8088B79C(BgHidanRock* this, PlayState* play);
+// LLM generated name (HIGH), was func_8088B79C: falls under gravity, fading the flame out on the way, and on landing plays the impact and surface sfx before either restarting the cycle or settling.
+void BgHidanRock_Fall(BgHidanRock* this, PlayState* play);  // was func_8088B79C [LLM:HIGH]
 void func_8088B90C(BgHidanRock* this, PlayState* play);
 // LLM generated name (HIGH), was func_8088B954: holds the block at the top for twenty frames, then zeroes its vertical velocity and lets it fall.
 void BgHidanRock_HangAtTop(BgHidanRock* this, PlayState* play);  // was func_8088B954 [LLM:HIGH]
@@ -196,7 +197,7 @@ void BgHidanRock_Pushable(BgHidanRock* this, PlayState* play) {
         this->dyna.actor.speedXZ = 0.0f;
         D_8088BFC0 = 0.0f;
         player->stateFlags2 &= ~PLAYER_STATE2_MOVING_DYNAPOLY;
-        this->actionFunc = func_8088B79C;
+        this->actionFunc = BgHidanRock_Fall;  // was func_8088B79C [LLM:HIGH]
     }
 
     frame = play->gameplayFrames & 0xFF;
@@ -256,7 +257,7 @@ void BgHidanRock_Shake(BgHidanRock* this, PlayState* play) {
     }
 }
 
-void func_8088B79C(BgHidanRock* this, PlayState* play) {
+void BgHidanRock_Fall(BgHidanRock* this, PlayState* play) {
     this->timer--;
     if (this->dyna.actor.bgCheckFlags & 2) {
         if (this->type == 0) {
@@ -304,7 +305,7 @@ void BgHidanRock_HangAtTop(BgHidanRock* this, PlayState* play) {
     }
 
     if (this->timer == 0) {
-        this->actionFunc = func_8088B79C;
+        this->actionFunc = BgHidanRock_Fall;  // was func_8088B79C [LLM:HIGH]
         this->dyna.actor.velocity.y = 0.0f;
     }
 }
@@ -349,7 +350,7 @@ void BgHidanRock_Update(Actor* thisx, PlayState* play) {
     BgHidanRock* this = (BgHidanRock*)thisx;
 
     this->actionFunc(this, play);
-    if (this->actionFunc == func_8088B79C) {
+    if (this->actionFunc == BgHidanRock_Fall) {  // was func_8088B79C [LLM:HIGH]
         Actor_MoveXZGravity(&this->dyna.actor);
         Actor_UpdateBgCheckInfo(play, &this->dyna.actor, 0.0f, 0.0f, 0.0f, 4);
     }
