-void func_800FCA18(void* blk, u32 nBlk, u32 blkSize, arg3_800FCA18 arg3, s32 arg4) {
+// LLM generated name (HIGH), was func_800FCA18: destructs the elements from the end backwards and frees the block
+void SystemHeap_DeleteArray(void* blk, u32 nBlk, u32 blkSize, arg3_800FCA18 arg3, s32 arg4) {
     uintptr_t pos;
     uintptr_t end;
     s32 masked_arg2;
@@ -169,11 +176,12 @@ void func_800FCA18(void* blk, u32 nBlk, u32 blkSize, arg3_800FCA18 arg3, s32 arg
     }
 
     if (arg4 != 0) {
-        func_800FC83C(blk);
+        SystemHeap_Delete(blk);  // was func_800FC83C [LLM:HIGH]
     }
 }
 
-void func_800FCB34(void) {
+// LLM generated name (HIGH), was func_800FCB34: walks the sInitFuncs chain running each entry
+void SystemHeap_RunInitFuncs(void) {
     InitFunc* initFunc = (InitFunc*)&sInitFuncs;
     u32 nextOffset = initFunc->nextOffset;
     InitFunc* prev = NULL;
@@ -195,5 +203,5 @@ void func_800FCB34(void) {
 
