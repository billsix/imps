From 02d61ea7a0b77cb7db827d90ddbc5fd4506658c9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:16:31 +0000
Subject: [PATCH 1393/3799] soh: rename func_80AFCD60 -> EnSkb_ChooseAction

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the shared dispatch every finished action returns to: it burrows away in daylight, attacks when the player is close and in front, and otherwise walks.
Defined in soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
index fd6891ba8..607236977 100644
--- a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
+++ b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
@@ -10,7 +10,8 @@ void EnSkb_Destroy(Actor* thisx, PlayState* play);
 void EnSkb_Update(Actor* thisx, PlayState* play);
 void EnSkb_Draw(Actor* thisx, PlayState* play);
 
-void func_80AFCD60(EnSkb* this);
+// LLM generated name (HIGH), was func_80AFCD60: the shared dispatch every finished action returns to: it burrows away in daylight, attacks when the player is close and in front, and otherwise walks.
+void EnSkb_ChooseAction(EnSkb* this);  // was func_80AFCD60 [LLM:HIGH]
 void func_80AFCDF8(EnSkb* this);
 void func_80AFCE5C(EnSkb* this, PlayState* play);
 void func_80AFCF48(EnSkb* this);
@@ -193,7 +194,7 @@ void EnSkb_Destroy(Actor* thisx, PlayState* play) {
     Collider_DestroyJntSph(play, &this->collider);
 }
 
-void func_80AFCD60(EnSkb* this) {
+void EnSkb_ChooseAction(EnSkb* this) {
     // Don't despawn stallchildren during daytime when enemy randomizer is enabled.
     if (IS_DAY && !CVarGetInteger(CVAR_ENHANCEMENT("RandomizedEnemies"), 0)) {
         func_80AFCF48(this);
@@ -226,7 +227,7 @@ void func_80AFCE5C(EnSkb* this, PlayState* play) {
         EnSkb_SpawnDebris(play, this, &this->actor.world.pos);
     }
     if ((SkelAnime_Update(&this->skelAnime) != 0) && (0.0f == this->actor.shape.yOffset)) {
-        func_80AFCD60(this);
+        EnSkb_ChooseAction(this);  // was func_80AFCD60 [LLM:HIGH]
     }
 }
 
@@ -326,7 +327,7 @@ void EnSkb_SetupAttack(EnSkb* this, PlayState* play) {
         this->collider.base.atFlags &= ~6;
         func_80AFD47C(this);
     } else if (SkelAnime_Update(&this->skelAnime) != 0) {
-        func_80AFCD60(this);
+        EnSkb_ChooseAction(this);  // was func_80AFCD60 [LLM:HIGH]
     }
 }
 
@@ -341,7 +342,7 @@ void func_80AFD47C(EnSkb* this) {
 
 void func_80AFD508(EnSkb* this, PlayState* play) {
     if (SkelAnime_Update(&this->skelAnime) != 0) {
-        func_80AFCD60(this);
+        EnSkb_ChooseAction(this);  // was func_80AFCD60 [LLM:HIGH]
     }
 }
 
@@ -368,7 +369,7 @@ void EnSkb_Stunned(EnSkb* this, PlayState* play) {
         if (this->actor.colChkInfo.health == 0) {
             EnSkb_SetupDeath(this, play);
         } else {
-            func_80AFCD60(this);
+            EnSkb_ChooseAction(this);  // was func_80AFCD60 [LLM:HIGH]
         }
     }
 }
@@ -405,7 +406,7 @@ void EnSkb_TakeDamage(EnSkb* this, PlayState* play) {
 
         Math_SmoothStepToS(&this->actor.shape.rot.y, this->actor.yawTowardsPlayer, 1, 0x1194, 0);
         if (SkelAnime_Update(&this->skelAnime) && (this->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) {
-            func_80AFCD60(this);
+            EnSkb_ChooseAction(this);  // was func_80AFCD60 [LLM:HIGH]
         }
     }
 }
