From c64e027cb6e9600e3afde81e19d7696741fc85de Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:09:29 +0000
Subject: [PATCH 1308/3799] soh: rename func_808BC80C -> BgTreemouth_WobbleOpen

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: raises the mouth-open amount to 0.8, then hands off to the closing half of the wobble.
Defined in soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c    | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c b/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c
index 1514962b8..f5cae0af5 100644
--- a/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c
+++ b/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c
@@ -18,7 +18,8 @@ void BgTreemouth_Draw(Actor* thisx, PlayState* play);
 
 void func_808BC65C(BgTreemouth* this, PlayState* play);
 void func_808BC6F8(BgTreemouth* this, PlayState* play);
-void func_808BC80C(BgTreemouth* this, PlayState* play);
+// LLM generated name (HIGH), was func_808BC80C: raises the mouth-open amount to 0.8, then hands off to the closing half of the wobble.
+void BgTreemouth_WobbleOpen(BgTreemouth* this, PlayState* play);  // was func_808BC80C [LLM:HIGH]
 void func_808BC864(BgTreemouth* this, PlayState* play);
 void BgTreemouth_DoNothing(BgTreemouth* this, PlayState* play);
 // LLM generated name (HIGH), was func_808BC8B8: the child-era idle: enables targeting once the player is facing it from close enough, and starts either the first-meeting or the enter-the-tree choice cutscene.
@@ -106,7 +107,7 @@ void func_808BC65C(BgTreemouth* this, PlayState* play) {
         npcAction = play->csCtx.npcActions[0];
         if (npcAction != NULL) {
             if (npcAction->action == 2) {
-                BgTreemouth_SetupAction(this, func_808BC80C);
+                BgTreemouth_SetupAction(this, BgTreemouth_WobbleOpen);  // was func_808BC80C [LLM:HIGH]
             } else if (npcAction->action == 3) {
                 Audio_PlaySfxGeneral(NA_SE_EV_WOODDOOR_OPEN, &gSfxDefaultPos, 4, &gSfxDefaultFreqAndVolScale,
                                      &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
@@ -133,7 +134,7 @@ void func_808BC6F8(BgTreemouth* this, PlayState* play) {
     }
 }
 
-void func_808BC80C(BgTreemouth* this, PlayState* play) {
+void BgTreemouth_WobbleOpen(BgTreemouth* this, PlayState* play) {
     this->unk_168 += 0.05f;
     if (this->unk_168 >= 0.8f) {
         BgTreemouth_SetupAction(this, func_808BC864);
@@ -212,7 +213,7 @@ void BgTreemouth_WaitForCue(BgTreemouth* this, PlayState* play) {
         npcAction = play->csCtx.npcActions[0];
         if (npcAction != NULL) {
             if (npcAction->action == 2) {
-                BgTreemouth_SetupAction(this, func_808BC80C);
+                BgTreemouth_SetupAction(this, BgTreemouth_WobbleOpen);  // was func_808BC80C [LLM:HIGH]
             } else if (npcAction->action == 3) {
                 Audio_PlaySfxGeneral(NA_SE_EV_WOODDOOR_OPEN, &gSfxDefaultPos, 4, &gSfxDefaultFreqAndVolScale,
                                      &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
