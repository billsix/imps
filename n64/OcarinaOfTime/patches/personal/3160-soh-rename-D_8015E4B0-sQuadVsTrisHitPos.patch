From 963861e99b1d21ac21947c5cd7727a01dc6584bf Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:49 +0000
Subject: [PATCH 3160/3799] soh: rename D_8015E4B0 -> sQuadVsTrisHitPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hit position CollisionCheck_AC_QuadVsTris reports
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index 1e4f16353..7175e2fb9 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2403,7 +2403,7 @@ void CollisionCheck_AC_TrisVsQuad(PlayState* play, CollisionCheckContext* colChk
  * AC overlap check. Calculates the center of each collider element and the point of contact.
  */
 void CollisionCheck_AC_QuadVsTris(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT, Collider* colAC) {
-    static Vec3f D_8015E4B0;
+    static Vec3f sQuadVsTrisHitPos;  // was D_8015E4B0 [LLM:HIGH]
     static TriNorm D_8015E4C0;
     static TriNorm D_8015E4F8;
     ColliderQuad* at = (ColliderQuad*)colAT;
@@ -2423,9 +2423,9 @@ void CollisionCheck_AC_QuadVsTris(PlayState* play, CollisionCheckContext* colChk
             if (CollisionCheck_NoSharedFlags(&at->info, &acElem->info) == 1) {
                 continue;
             }
-            if (Math3D_TriVsTriIntersect(&D_8015E4C0, &acElem->dim, &D_8015E4B0) == 1 ||
-                Math3D_TriVsTriIntersect(&D_8015E4F8, &acElem->dim, &D_8015E4B0) == 1) {
-                if (Collider_QuadSetNearestAC(play, at, &D_8015E4B0)) {
+            if (Math3D_TriVsTriIntersect(&D_8015E4C0, &acElem->dim, &sQuadVsTrisHitPos) == 1 ||  // was D_8015E4B0 [LLM:HIGH]
+                Math3D_TriVsTriIntersect(&D_8015E4F8, &acElem->dim, &sQuadVsTrisHitPos) == 1) {  // was D_8015E4B0 [LLM:HIGH]
+                if (Collider_QuadSetNearestAC(play, at, &sQuadVsTrisHitPos)) {  // was D_8015E4B0 [LLM:HIGH]
                     Vec3f atPos;
                     Vec3f acPos;
 
@@ -2439,7 +2439,7 @@ void CollisionCheck_AC_QuadVsTris(PlayState* play, CollisionCheckContext* colChk
                     atPos.z =
                         (at->dim.quad[0].z + (at->dim.quad[1].z + (at->dim.quad[3].z + at->dim.quad[2].z))) / 4.0f;
                     CollisionCheck_SetATvsAC(play, &at->base, &at->info, &atPos, &ac->base, &acElem->info, &acPos,
-                                             &D_8015E4B0);
+                                             &sQuadVsTrisHitPos);  // was D_8015E4B0 [LLM:HIGH]
                     return;
                 }
             }
