From 97d2df4fef9d6ddcf0b23b2ce84867a02a3756dd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:27:07 +0000
Subject: [PATCH 0925/3799] soh: rename D_80A12CA0 -> sFallingCylinderInit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: ColliderCylinderInit with AT_ON | AT_TYPE_ENEMY, installed for the FIRE_ROCK_SPAWNED_FALLING and FIRE_ROCK_BROKEN_PIECE params, which hand off to EnFireRock_Fall.
Defined in soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c b/soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c
index 5567887c9..5234af68b 100644
--- a/soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c
+++ b/soh/src/overlays/actors/ovl_En_Fire_Rock/z_en_fire_rock.c
@@ -28,7 +28,8 @@ const ActorInit En_Fire_Rock_InitVars = {
     NULL,
 };
 
-static ColliderCylinderInit D_80A12CA0 = {
+// LLM generated name (HIGH), was D_80A12CA0: ColliderCylinderInit with AT_ON | AT_TYPE_ENEMY, installed for the FIRE_ROCK_SPAWNED_FALLING and FIRE_ROCK_BROKEN_PIECE params, which hand off to EnFireRock_Fall.
+static ColliderCylinderInit sFallingCylinderInit = {  // was D_80A12CA0 [LLM:HIGH]
     {
         COLTYPE_HARD,
         AT_ON | AT_TYPE_ENEMY,
@@ -111,7 +112,7 @@ void EnFireRock_Init(Actor* thisx, PlayState* play) {
             this->scale = (Rand_ZeroFloat(2.0f) / 100.0f) + 0.02f;
             Actor_SetScale(&this->actor, this->scale);
             Collider_InitCylinder(play, &this->collider);
-            Collider_SetCylinder(play, &this->collider, &this->actor, &D_80A12CA0);
+            Collider_SetCylinder(play, &this->collider, &this->actor, &sFallingCylinderInit);  // was D_80A12CA0 [LLM:HIGH]
             this->actor.world.rot.y = this->actor.shape.rot.y = Rand_CenteredFloat(65535.0f);
             this->actionFunc = EnFireRock_Fall;
             this->actor.shape.shadowScale = 15.0f;
@@ -123,7 +124,7 @@ void EnFireRock_Init(Actor* thisx, PlayState* play) {
             Actor_SetScale(&this->actor, this->scale);
             this->actor.gravity = -1.5f;
             Collider_InitCylinder(play, &this->collider);
-            Collider_SetCylinder(play, &this->collider, &this->actor, &D_80A12CA0);
+            Collider_SetCylinder(play, &this->collider, &this->actor, &sFallingCylinderInit);  // was D_80A12CA0 [LLM:HIGH]
             this->actor.shape.shadowScale = 10.0f;
             this->actor.world.rot.y = this->actor.shape.rot.y = Rand_CenteredFloat(65535.0f);
             this->actionFunc = EnFireRock_Fall;
-- 
