+    { sCsCameraAtPoints6, sCsCameraEyePoints6, 0 }, { sCsCameraAtPoints7, sCsCameraEyePoints7, 0 }, { sCsCameraAtPoints8, sCsCameraEyePoints8, 0 },  // was D_80B5F530 [LLM:HIGH]
     { D_80B5F890, D_80B5F910, 0 }, { D_80B5F990, D_80B5FA10, 0 },
