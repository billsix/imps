From 0df6ddcd608ece55864b116e08ee871214dc2f5b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:02 +0000
Subject: [PATCH 3375/3799] soh: rename D_808547C0 -> sBombchuSparkEnvColor

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the env colour of those sparks
Defined in soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c | 5 +++--
 soh/src/overlays/actors/ovl_player_actor/z_player.c   | 4 ++--
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c b/soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c
index 0d3a90e51..85a84c9fd 100644
--- a/soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c
+++ b/soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c
@@ -364,7 +364,8 @@ static Vec3f sBombchuSparkAccel = { 0.0f, 0.5f, 0.0f };  // was D_808547B0 [LLM:
 
 // LLM generated name (HIGH), was D_808547BC: the prim colour of those sparks
 static Color_RGBA8 sBombchuSparkPrimColor = { 255, 255, 100, 255 };  // was D_808547BC [LLM:HIGH]
-static Color_RGBA8 D_808547C0 = { 255, 50, 0, 0 };
+// LLM generated name (HIGH), was D_808547C0: the env colour of those sparks
+static Color_RGBA8 sBombchuSparkEnvColor = { 255, 50, 0, 0 };  // was D_808547C0 [LLM:HIGH]
 
 void UseDekuStick(Actor* thisx, PlayState* play, u8 started) {
     EnPartner* this = (EnPartner*)thisx;
@@ -383,7 +384,7 @@ void UseDekuStick(Actor* thisx, PlayState* play, u8 started) {
                 this->stickWeaponInfo.tip = this->actor.world.pos;
                 this->stickWeaponInfo.tip.y += 7.0f;
 
-                EffectSsDust_SpawnDrawFlags0Life(play, &this->stickWeaponInfo.tip, &sBombchuSparkVelocity, &sBombchuSparkAccel, &sBombchuSparkPrimColor, &D_808547C0,  // was func_8002836C [LLM:HIGH]
+                EffectSsDust_SpawnDrawFlags0Life(play, &this->stickWeaponInfo.tip, &sBombchuSparkVelocity, &sBombchuSparkAccel, &sBombchuSparkPrimColor, &sBombchuSparkEnvColor,  // was func_8002836C [LLM:HIGH]
                               200.0f, 0, 8);
 
                 CollisionCheck_SetAT(play, &play->colChkCtx, &this->collider.base);
diff --git a/soh/src/overlays/actors/ovl_player_actor/z_player.c b/soh/src/overlays/actors/ovl_player_actor/z_player.c
index 0e0b86180..712340854 100644
--- a/soh/src/overlays/actors/ovl_player_actor/z_player.c
+++ b/soh/src/overlays/actors/ovl_player_actor/z_player.c
@@ -11550,7 +11550,7 @@ static Vec3f sBombchuSparkVelocity = { 0.0f, 0.5f, 0.0f };  // was D_808547A4 [L
 static Vec3f sBombchuSparkAccel = { 0.0f, 0.5f, 0.0f };  // was D_808547B0 [LLM:HIGH]
 
 static Color_RGBA8 sBombchuSparkPrimColor = { 255, 255, 100, 255 };  // was D_808547BC [LLM:HIGH]
-static Color_RGBA8 D_808547C0 = { 255, 50, 0, 0 };
+static Color_RGBA8 sBombchuSparkEnvColor = { 255, 50, 0, 0 };  // was D_808547C0 [LLM:HIGH]
 
 void Player_UpdateBurningDekuStick(PlayState* play, Player* this) {
     f32 temp;
@@ -11574,7 +11574,7 @@ void Player_UpdateBurningDekuStick(PlayState* play, Player* this) {
         this->unk_85C = temp;
     }
 
-    EffectSsDust_SpawnDrawFlags0Life(play, &this->meleeWeaponInfo[0].tip, &sBombchuSparkVelocity, &sBombchuSparkAccel, &sBombchuSparkPrimColor, &D_808547C0,  // was func_8002836C [LLM:HIGH]
+    EffectSsDust_SpawnDrawFlags0Life(play, &this->meleeWeaponInfo[0].tip, &sBombchuSparkVelocity, &sBombchuSparkAccel, &sBombchuSparkPrimColor, &sBombchuSparkEnvColor,  // was func_8002836C [LLM:HIGH]
                   temp * 200.0f, 0, 8);
 }
 
