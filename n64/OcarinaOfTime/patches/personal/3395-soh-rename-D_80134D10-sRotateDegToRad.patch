From 62a854d7c3470ee2192cd20b69d7f27cea746745 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:05 +0000
Subject: [PATCH 3395/3799] soh: rename D_80134D10 -> sRotateDegToRad

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same constant in guRotateF; named separately because both files declare their own
Defined in soh/src/libultra/gu/rotate.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/libultra/gu/rotate.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/libultra/gu/rotate.c b/soh/src/libultra/gu/rotate.c
index 64d4bd6ac..408e5fbdf 100644
--- a/soh/src/libultra/gu/rotate.c
+++ b/soh/src/libultra/gu/rotate.c
@@ -1,7 +1,7 @@
 #include "global.h"
 
 void guRotateF(f32 m[4][4], f32 a, f32 x, f32 y, f32 z) {
-    static f32 D_80134D10 = M_PI / 180.0f;
+    static f32 sRotateDegToRad = M_PI / 180.0f;  // was D_80134D10 [LLM:HIGH]
     f32 sine;
     f32 cosine;
     f32 ab;
@@ -14,7 +14,7 @@ void guRotateF(f32 m[4][4], f32 a, f32 x, f32 y, f32 z) {
 
     guNormalize(&x, &y, &z);
 
-    a = a * D_80134D10;
+    a = a * sRotateDegToRad;  // was D_80134D10 [LLM:HIGH]
 
     sine = sinf(a);
     cosine = cosf(a);
-- 
