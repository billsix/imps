From a4ab709c14f761491245eed9d6c8c31f03540419 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:58 +0000
Subject: [PATCH 2524/3799] soh: rename D_8016B7A8 -> sSpeedVolScale

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the volume scale Audio_SetSfxScalesFromSpeed writes, 0.775 to 1.0
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 6633333e0..a3b4e4047 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -1261,7 +1261,8 @@ OcarinaSongButtons gOcarinaSongButtons[OCARINA_SONG_MAX] = {
 
 u32 sAudioUpdateStartTime; // decomp: debug only
 u32 sAudioUpdateEndTime;   // decomp: debug only
-f32 D_8016B7A8;
+// LLM generated name (HIGH), was D_8016B7A8: the volume scale Audio_SetSfxScalesFromSpeed writes, 0.775 to 1.0
+f32 sSpeedVolScale;  // was D_8016B7A8 [LLM:HIGH]
 f32 D_8016B7AC;
 f32 D_8016B7B0;
 f32 D_8016B7B4;
@@ -1353,7 +1354,7 @@ s32 sAudioUpdateTaskEnd;      // decomp: debug only
     F(sAudioExtraFilter2)                              \
     F(sSariaBgmPtr)                                    \
     F(sNearestBgmSourceDist)                                      \
-    F(D_8016B7A8)                                      \
+    F(sSpeedVolScale)                                      \
     F(D_8016B7AC)                                      \
     F(D_8016B7B0)                                      \
     F(D_8016B7B4)                                      \
@@ -4391,11 +4392,11 @@ f32 Audio_SetSfxScalesFromSpeed(f32 arg0) {
     f32 ret = 1.0f;
 
     if (arg0 > 6.0f) {
-        D_8016B7A8 = 1.0f;
+        sSpeedVolScale = 1.0f;  // was D_8016B7A8 [LLM:HIGH]
         D_8016B7B0 = 1.1f;
     } else {
         ret = arg0 / 6.0f;
-        D_8016B7A8 = (ret * 0.22500002f) + 0.775f;
+        sSpeedVolScale = (ret * 0.22500002f) + 0.775f;  // was D_8016B7A8 [LLM:HIGH]
         D_8016B7B0 = (ret * 0.2f) + 0.9f;
     }
     return ret;
@@ -4410,7 +4411,7 @@ void Audio_PlayWalkSfx(Vec3f* pos, u16 sfxId, f32 arg2) {
 
     D_80131C8C = arg2;
     sp24 = Audio_SetSfxScalesFromSpeed(arg2);  // was func_800F3F84 [LLM:HIGH]
-    Audio_PlaySfxGeneral(sfxId, pos, 4, &D_8016B7B0, &D_8016B7A8, &gSfxDefaultReverb);
+    Audio_PlaySfxGeneral(sfxId, pos, 4, &D_8016B7B0, &sSpeedVolScale, &gSfxDefaultReverb);  // was D_8016B7A8 [LLM:HIGH]
 
     if ((sfxId & 0xF0) == 0xB0) {
         phi_f0 = 0.3f;
@@ -4435,7 +4436,7 @@ void Audio_PlayWalkSfx(Vec3f* pos, u16 sfxId, f32 arg2) {
 // LLM generated name (HIGH), was func_800F4138: plays a sound with the frequency and volume scales derived from the caller's speed
 void Audio_PlaySfxWithSpeedScales(Vec3f* pos, u16 sfxId, f32 arg2) {
     Audio_SetSfxScalesFromSpeed(arg2);  // was func_800F3F84 [LLM:HIGH]
-    Audio_PlaySfxGeneral(sfxId, pos, 4, &D_8016B7B0, &D_8016B7A8, &gSfxDefaultReverb);
+    Audio_PlaySfxGeneral(sfxId, pos, 4, &D_8016B7B0, &sSpeedVolScale, &gSfxDefaultReverb);  // was D_8016B7A8 [LLM:HIGH]
 }
 
 // LLM generated name (HIGH), was func_800F4190: plays a sound with the file's constant frequency scale and reverb
@@ -5468,7 +5469,7 @@ void Audio_PreNMI(void) {
 // LLM generated name (HIGH), was func_800F6C34: resets audio filter/seq-mode/lerp state; called during audio reset
 void Audio_ResetData(void) {
     sPrevSeqMode = 0;
-    D_8016B7A8 = 1.0f;
+    sSpeedVolScale = 1.0f;  // was D_8016B7A8 [LLM:HIGH]
     D_8016B7B0 = 1.0f;
     sAudioBaseFilter = 0;
     sAudioExtraFilter = 0;
