From 0c16b3afdea71e494d113e47cb450c3c5369d124 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:09 +0000
Subject: [PATCH 600/784] soh: rename D_8011E1C4 -> sCurOcarinaAction

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/z_demo.c.
---
 soh/src/code/z_demo.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_demo.c b/soh/src/code/z_demo.c
index 4b7f29667..11bd79f78 100644
--- a/soh/src/code/z_demo.c
+++ b/soh/src/code/z_demo.c
@@ -38,7 +38,8 @@
 
 // Name from zeldaret/oot (was D_8011E1C0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_demo.c]
 u16 sCurTextId = 0;
-u16 D_8011E1C4 = 0;
+// Name from zeldaret/oot (was D_8011E1C4): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_demo.c]
+u16 sCurOcarinaAction = 0;
 
 typedef void (*CutsceneStateHandler)(PlayState*, CutsceneContext*);
 
@@ -1657,8 +1658,8 @@ void Cutscene_Command_Textbox(PlayState* play, CutsceneContext* csCtx, CsCmdText
                 return;
             }
         } else {
-            if (D_8011E1C4 != cmd->base) {
-                D_8011E1C4 = cmd->base;
+            if (sCurOcarinaAction != cmd->base) {
+                sCurOcarinaAction = cmd->base;
                 Message_StartOcarinaSunsSongEnabled(play, cmd->base);
                 return;
             }
@@ -1712,7 +1713,7 @@ void Cutscene_Command_Textbox(PlayState* play, CutsceneContext* csCtx, CsCmdText
             if (csCtx->frames == originalCsFrames) {
                 Interface_ChangeHudVisibilityMode(1);
                 sCurTextId = 0;
-                D_8011E1C4 = 0;
+                sCurOcarinaAction = 0;
             }
         }
     }
@@ -2150,7 +2151,7 @@ void Cutscene_SetupScripted(PlayState* play, CutsceneContext* csCtx) {
         Flags_UnsetEnv(play, 0);
 
         sCurTextId = 0;
-        D_8011E1C4 = 0;
+        sCurOcarinaAction = 0;
         csCtx->unk_12 = 0;
         csCtx->linkAction = NULL;
 
