From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:38 +0000
Subject: [PATCH 3080/3799] soh: rename D_801213B4 -> sCs2210KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 2210 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 10 +++++-----
 soh/src/code/z_onepointdemo_data.inc |  3 ++-
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 1a09414e4..93b42a300 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -26,7 +26,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(D_80121184)                                   \
     F(D_801211D4)                                   \
     F(sCs4510KeyFrames)                                   \
-    F(D_801213B4)                                   \
+    F(sCs2210KeyFrames)                                   \
     F(D_8012151C)                                   \
     F(D_8012156C)                                   \
     F(D_801215BC)                                   \
@@ -349,14 +349,14 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             break;
         case 2210:
             OLib_Vec3fDiffToVecSphGeo(&spD0, &player->actor.world.pos, &actor->world.pos);
-            D_801213B4[0].eyeTargetInit.y = D_801213B4[1].eyeTargetInit.y = D_801213B4[2].eyeTargetInit.y =
-                D_801213B4[2].atTargetInit.y = BINANG_TO_DEGF(spD0.yaw);
+            sCs2210KeyFrames[0].eyeTargetInit.y = sCs2210KeyFrames[1].eyeTargetInit.y = sCs2210KeyFrames[2].eyeTargetInit.y =  // was D_801213B4 [LLM:HIGH]
+                sCs2210KeyFrames[2].atTargetInit.y = BINANG_TO_DEGF(spD0.yaw);  // was D_801213B4 [LLM:HIGH]
             if (Rand_ZeroOne() < 0.0f) {
-                D_801213B4[3].eyeTargetInit.x = -D_801213B4[3].eyeTargetInit.x;
+                sCs2210KeyFrames[3].eyeTargetInit.x = -sCs2210KeyFrames[3].eyeTargetInit.x;  // was D_801213B4 [LLM:HIGH]
             }
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
 
-            csInfo->keyFrames = D_801213B4;
+            csInfo->keyFrames = sCs2210KeyFrames;  // was D_801213B4 [LLM:HIGH]
             csInfo->keyFrameCnt = 5;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
