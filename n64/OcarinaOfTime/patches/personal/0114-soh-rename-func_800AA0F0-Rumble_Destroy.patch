+++ b/soh/src/code/z_rumble.c
@@ -69,7 +69,8 @@ void Rumble_Init(void) {
     gPadMgr.retraceCallbackValue = 0;
 }
 
-void func_800AA0F0(void) {
+// Name from zeldaret/oot src/code/z_rumble.c (was func_800AA0F0): unregisters the retrace callback and destroys the manager. Source: https://github.com/zeldaret/oot/blob/main/src/code/z_rumble.c
+void Rumble_Destroy(void) {
     PadMgr* padmgr = &gPadMgr;
 
     if ((padmgr->retraceCallback == Rumble_Update) && (padmgr->retraceCallbackValue == 0)) {
