From a547a2cf83d72de886d49d265a231d8319fa1f5a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:14 +0000
Subject: [PATCH 0044/3799] soh: rename D_80133340 -> sSfxDebugName

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/audio_sfx.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_sfx.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index f0b0dddc5..13d3b6a86 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -22,7 +22,8 @@ typedef struct {
 
 // rodata for Audio_ProcessSoundRequest (this file)
 // (probably moved to .data due to -use_readwrite_const)
-char D_80133340[] = "SE";
+// LLM generated name (HIGH), was D_80133340: string "SE" passed to AudioDebug_ScrPrt as the on-screen SFX debug label
+char sSfxDebugName[] = "SE";
 
 // rodata for Audio_ChooseActiveSounds (this file)
 char D_80133344[] = VT_COL(RED, WHITE) "<INAGAKI CHECK> dist over! flag:%04X ptr:%08X pos:%f-%f-%f" VT_RST "\n";
@@ -228,7 +229,7 @@ void Audio_ProcessSoundRequest(void) {
     }
     bankId = SFX_BANK(req->sfxId);
     if ((1 << bankId) & D_801333F0) {
-        AudioDebug_ScrPrt((const s8*)D_80133340, req->sfxId);
+        AudioDebug_ScrPrt((const s8*)sSfxDebugName, req->sfxId);
         bankId = SFX_BANK(req->sfxId);
     }
     count = 0;
-- 
