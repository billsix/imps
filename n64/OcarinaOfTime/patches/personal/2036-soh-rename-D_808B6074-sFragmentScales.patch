From 277eeb6e9846b8304ed7183e20f5f6c59dd90f8a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:09:37 +0000
Subject: [PATCH 2036/3799] soh: rename D_808B6074 -> sFragmentScales

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-fragment scale factors for the EffectSsKakera shards
Defined in soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c      | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c b/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
index c71c33e57..4dfb51f5d 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
@@ -149,7 +149,8 @@ static Vec3f sVelocity = { 0.0f, 0.0f, 0.0f };
 
 static Vec3f sAcceleration = { 0.0f, 0.4f, 0.0f };
 
-static f32 D_808B6074[] = { 66.0f, 51.0f, 48.0f, 36.0f, 21.0f };
+// LLM generated name (HIGH), was D_808B6074: per-fragment scale factors for the EffectSsKakera shards
+static f32 sFragmentScales[] = { 66.0f, 51.0f, 48.0f, 36.0f, 21.0f };  // was D_808B6074 [LLM:HIGH]
 
 static s16 D_808B6088[] = { 0, 1, 2, 3, 4 };
 
@@ -344,7 +345,7 @@ void BgSpot16Bombstone_SpawnFragments(BgSpot16Bombstone* this, PlayState* play)
         index = 0;
     }
 
-    if (index < ARRAY_COUNT(D_808B6074)) {
+    if (index < ARRAY_COUNT(sFragmentScales)) {  // was D_808B6074 [LLM:HIGH]
         do {
             pos.x = ((Rand_ZeroOne() - 0.5f) * 8.0f) + this->actor.world.pos.x;
             pos.y = ((Rand_ZeroOne() * 5.0f) + this->actor.world.pos.y) + 8.0f;
@@ -354,12 +355,12 @@ void BgSpot16Bombstone_SpawnFragments(BgSpot16Bombstone* this, PlayState* play)
             velocity.y = (Rand_ZeroOne() * 14.0) + (fabsf(this->actor.velocity.y) * velocityYMultiplier);
             velocity.z = (Rand_ZeroOne() - 0.5f) * 16.0f;
 
-            scale = D_808B6074[index] * this->actor.scale.x * 3;
+            scale = sFragmentScales[index] * this->actor.scale.x * 3;  // was D_808B6074 [LLM:HIGH]
 
             EffectSsKakera_Spawn(play, &pos, &velocity, &this->actor.world.pos, -420, 0x31, 0xF, 0xF, 0, scale, 2, 0x40,
                                  160, KAKERA_COLOR_NONE, OBJECT_BOMBIWA, object_bombiwa_DL_0009E0);
             index += 1;
-        } while (index != ARRAY_COUNT(D_808B6074));
+        } while (index != ARRAY_COUNT(sFragmentScales));  // was D_808B6074 [LLM:HIGH]
     }
 }
 
