diff --git a/docker/Dockerfile b/docker/Dockerfile
new file mode 100644
index 000000000..9810eaf69
--- /dev/null
+++ b/docker/Dockerfile
@@ -0,0 +1,81 @@
+# Reproducible Linux build environment for PaperBoat's CI AppImage.
+#
+# Mirrors the `build-linux` job of .github/workflows/build.yml: gcc-14, the same
+# apt package list, and SDL2 / tinyxml2 / libzip built from source at the same
+# versions the job uses (Ubuntu's are older than libultraship expects). The one
+# deliberate difference from CI is the point of this image: the floating
+# `ubuntu-latest` runner and those from-source library steps are frozen into
+# image layers, so the build is reproducible and a developer can run the
+# identical build locally.
+#
+# Build context is the repository root (see docker/Makefile), so the container
+# sees the whole source tree (including the vendored external/ submodules).
+FROM ubuntu:24.04
+
+ENV DEBIAN_FRONTEND=noninteractive \
+    LANG=C.UTF-8
+
+# The CI job's "Install dependencies" apt list, plus the packages a bare
+# ubuntu:24.04 lacks that a GitHub runner pre-provides (download utilities,
+# python3, AppImage packaging).
+RUN apt-get update && apt-get install -y --no-install-recommends \
+        gcc-14 g++-14 git cmake ninja-build lsb-release file \
+        libsdl2-dev libsdl2-net-dev libpng-dev libzip-dev zipcmp zipmerge ziptool \
+        nlohmann-json3-dev libtinyxml2-dev libspdlog-dev libfmt-dev libboost-dev \
+        libopengl-dev libgl1-mesa-dev libogg-dev libvorbis-dev zlib1g-dev libbz2-dev \
+        libvulkan-dev libshaderc-dev glslang-dev spirv-tools \
+        ca-certificates wget curl gnupg patchelf desktop-file-utils \
+        build-essential pkg-config python3 \
+ && rm -rf /var/lib/apt/lists/*
+
+# libultraship links `shaderc_shared`, but Ubuntu ships the shared library as
+# plain libshaderc.so; without this compat name cmake falls back to the static
+# libshaderc_combined.a, which on 24.04 is ABI-skewed against the newer
+# spirv-tools static libs (undefined spvtools:: symbols at link).
+RUN ln -s /usr/lib/x86_64-linux-gnu/libshaderc.so \
+          /usr/lib/x86_64-linux-gnu/libshaderc_shared.so
+
+# libultraship's vendored FindVulkan.cmake uses a policy that needs a newer
+# CMake than 24.04's apt 3.28 (the GitHub runner pre-provides a modern cmake,
+# so CI never hits this). Install Kitware's build.
+RUN wget -O /tmp/kitware-archive.sh https://apt.kitware.com/kitware-archive.sh \
+ && bash /tmp/kitware-archive.sh \
+ && apt-get install -y --no-install-recommends cmake \
+ && rm -rf /tmp/kitware-archive.sh /var/lib/apt/lists/*
+
+# SDL 2.30.3 from source (CI step "Install latest SDL").
+RUN mkdir -p /deps && cd /deps \
+ && wget -q https://www.libsdl.org/release/SDL2-2.30.3.tar.gz \
+ && tar -xzf SDL2-2.30.3.tar.gz \
+ && cd SDL2-2.30.3 \
+ && ./configure --enable-hidapi-libusb \
+ && make -j"$(nproc)" \
+ && make install \
+ && cp -av /usr/local/lib/libSDL* /lib/x86_64-linux-gnu/ \
+ && ldconfig \
+ && cd / && rm -rf /deps
+
+# tinyxml2 10.0.0 from source (CI step "Install latest tinyxml2").
+RUN mkdir -p /deps && cd /deps \
+ && wget -q -O tinyxml2-10.0.0.tar.gz https://github.com/leethomason/tinyxml2/archive/refs/tags/10.0.0.tar.gz \
+ && tar -xzf tinyxml2-10.0.0.tar.gz \
+ && cmake -S tinyxml2-10.0.0 -B tinyxml2-10.0.0/build -DCMAKE_BUILD_TYPE=Release \
+ && cmake --build tinyxml2-10.0.0/build -j"$(nproc)" \
+ && cmake --install tinyxml2-10.0.0/build \
+ && ldconfig \
+ && cd / && rm -rf /deps
+
+# libzip 1.10.1 without crypto backends (CI step "Install libzip without crypto").
+RUN mkdir -p /deps && cd /deps \
+ && wget -q https://github.com/nih-at/libzip/releases/download/v1.10.1/libzip-1.10.1.tar.gz \
+ && tar -xzf libzip-1.10.1.tar.gz \
+ && cmake -S libzip-1.10.1 -B libzip-1.10.1/build -DCMAKE_BUILD_TYPE=Release \
+        -DENABLE_COMMONCRYPTO=OFF -DENABLE_GNUTLS=OFF \
+        -DENABLE_MBEDTLS=OFF -DENABLE_OPENSSL=OFF \
+ && cmake --build libzip-1.10.1/build -j"$(nproc)" \
+ && cmake --install libzip-1.10.1/build \
+ && cp -av /usr/local/lib/libzip* /lib/x86_64-linux-gnu/ \
+ && ldconfig \
+ && cd / && rm -rf /deps
+
+WORKDIR /src
diff --git a/docker/Makefile b/docker/Makefile
new file mode 100644
index 000000000..9e30868bd
--- /dev/null
+++ b/docker/Makefile
@@ -0,0 +1,79 @@
+SHELL := /bin/bash
+
+# Containerized, reproducible Linux AppImage build for PaperBoat.
+#
+# `make appimage` builds the repository (as checked out) inside the image
+# defined by docker/Dockerfile and emits out/Paperboat.AppImage — the same
+# artifact the Linux CI job produces, from one path CI and developers share.
+# The build target already depends on GeneratePortO2R, so the port asset
+# archive (paperboat.o2r, ROM-free) is generated in-build and bundled; there is
+# no separate asset job to feed it. The build CONTEXT is the repository root
+# (the parent of this dir), so the container sees the whole source tree,
+# including the vendored external/ submodules.
+
+# Repo root = parent of this docker/ directory, regardless of the caller's cwd.
+ROOT   := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
+
+# podman on developer machines, docker on CI runners — pick whichever is on PATH.
+CONTAINER_CMD ?= $(shell command -v podman >/dev/null 2>&1 && echo podman || echo docker)
+
+IMAGE  := paperboat-ci-builder:latest
+OUT    := $(ROOT)/out
+NPROC  := $(shell nproc)
+
+# Extra flags for container `run` (not `build`): --cgroups=disabled lets the
+# build run inside an unprivileged nested container. Empty on a normal host/CI.
+PODMAN_RUN_FLAGS ?= $(if $(filter 1,$(NESTED_PODMAN)),--cgroups=disabled)
+
+RUN = $(CONTAINER_CMD) run --rm $(PODMAN_RUN_FLAGS) \
+        -v $(ROOT):/src:z -v $(OUT):/out:z -e HOME=/tmp $(IMAGE)
+
+.PHONY: help image build appimage run shell clean
+
+help:
+	@echo "Targets:"
+	@echo "  make image     - build the Linux build-environment image"
+	@echo "  make build     - compile PaperBoat inside the container"
+	@echo "  make appimage  - produce out/Paperboat.AppImage"
+	@echo "  make run       - run out/Paperboat.AppImage"
+	@echo "  make shell     - interactive shell in the build container"
+	@echo "  make clean     - remove the container build dir and out/"
+
+image:
+	$(CONTAINER_CMD) build -t $(IMAGE) -f $(ROOT)/docker/Dockerfile $(ROOT)
+
+$(OUT):
+	mkdir -p $(OUT)
+
+build: image | $(OUT)
+	$(RUN) bash -c '\
+		set -euxo pipefail; \
+		cd /src; \
+		cmake --preset ninja-release \
+		      -DCMAKE_C_COMPILER=gcc-14 -DCMAKE_CXX_COMPILER=g++-14; \
+		cmake --build /src/build/ninja-release --parallel $(NPROC); \
+	'
+
+appimage: build
+	$(RUN) bash -c '\
+		set -euxo pipefail; \
+		export APPIMAGE_EXTRACT_AND_RUN=1; \
+		cd /src/build/ninja-release && cpack -G External; \
+		shopt -s nullglob; \
+		artifacts=(/src/build/ninja-release/*.AppImage); \
+		if [ $${#artifacts[@]} -eq 0 ]; then echo "ERROR: no .AppImage produced" >&2; exit 1; fi; \
+		cp "$${artifacts[0]}" /out/Paperboat.AppImage; \
+		chmod +x /out/Paperboat.AppImage; \
+	'
+	@echo "==> AppImage: $(OUT)/Paperboat.AppImage"
+
+run:
+	@test -x $(OUT)/Paperboat.AppImage || { echo "no AppImage at $(OUT)/Paperboat.AppImage -- run 'make appimage' first" >&2; exit 1; }
+	APPIMAGE_EXTRACT_AND_RUN=1 $(OUT)/Paperboat.AppImage $(ARGS)
+
+shell: image | $(OUT)
+	$(CONTAINER_CMD) run --rm -it $(PODMAN_RUN_FLAGS) \
+	    -v $(ROOT):/src:z -v $(OUT):/out:z -e HOME=/tmp $(IMAGE) bash
+
+clean:
+	rm -rf $(ROOT)/build $(ROOT)/out
-- 
