             Audio_PlayFanfare(NA_BGM_OWL);
-            this->actionFunc = func_80ACB274;
+            this->actionFunc = EnOwl_EndDeathMountainTalk;  // was func_80ACB274 [LLM:HIGH]
             return;
         }
     } else {
