From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:17:02 +0000
Subject: [PATCH 1410/3799] soh: rename func_80AAE598 -> EnMm_Sit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the sitting action: tracks the player with his head and, once day breaks and no conversation is running, stands up.
Defined in soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c b/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
index 8641a724b..07f2acfbe 100644
--- a/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
+++ b/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
@@ -30,7 +30,8 @@ void EnMm_Destroy(Actor* thisx, PlayState* play);
 void EnMm_Update(Actor* thisx, PlayState* play);
 void EnMm_Draw(Actor* thisx, PlayState* play);
 
-void func_80AAE598(EnMm* this, PlayState* play);
+// LLM generated name (HIGH), was func_80AAE598: the sitting action: tracks the player with his head and, once day breaks and no conversation is running, stands up.
+void EnMm_Sit(EnMm* this, PlayState* play);  // was func_80AAE598 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AAE294: the running action: steps the animation with footstep sfx, follows the path and, once night falls, breaks off to sit down.
 void EnMm_Run(EnMm* this, PlayState* play);  // was func_80AAE294 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AAE50C: waits for the stand-up animation, then picks the sprint or ordinary run animation depending on whether the player has already traded him the mask, and starts running.
@@ -189,7 +190,7 @@ void EnMm_Init(Actor* thisx, PlayState* play) {
     if (EnMm_IsDay() == 1) {  // was func_80AADA70 [LLM:HIGH]
         this->mouthTexIndex = RM_MOUTH_OPEN;
         EnMm_ChangeAnim(this, RM_ANIM_RUN, &this->curAnimIndex);
-        this->actionFunc = func_80AAE598;
+        this->actionFunc = EnMm_Sit;  // was func_80AAE598 [LLM:HIGH]
     } else {
         this->mouthTexIndex = RM_MOUTH_CLOSED;
         EnMm_ChangeAnim(this, RM_ANIM_SIT_WAIT, &this->curAnimIndex);
@@ -405,7 +406,7 @@ s32 EnMm_UpdateWaypoint(EnMm* this, PlayState* play) {
 
 void EnMm_SitDown(EnMm* this, PlayState* play) {
     if (SkelAnime_Update(&this->skelAnime)) {
-        this->actionFunc = func_80AAE598;
+        this->actionFunc = EnMm_Sit;  // was func_80AAE598 [LLM:HIGH]
         this->unk_1E8 = 0;
         this->mouthTexIndex = RM_MOUTH_CLOSED;
         this->unk_254 |= 1;
@@ -496,7 +497,7 @@ void EnMm_StandUp(EnMm* this, PlayState* play) {
     }
 }
 
-void func_80AAE598(EnMm* this, PlayState* play) {
+void EnMm_Sit(EnMm* this, PlayState* play) {
     Actor_TrackPlayer(play, &this->actor, &this->unk_248, &this->unk_24E, this->actor.focus.pos);
     SkelAnime_Update(&this->skelAnime);
 
