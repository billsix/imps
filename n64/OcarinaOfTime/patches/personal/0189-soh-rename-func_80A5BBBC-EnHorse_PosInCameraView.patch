From 142e445a662c8588f73a95e3e49d63cefa3488ff Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:32 +0000
Subject: [PATCH 189/225] soh: rename func_80A5BBBC -> EnHorse_PosInCameraView

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c b/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c
index 5af2295ca..7e69e4c5a 100644
--- a/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c
+++ b/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c
@@ -645,7 +645,8 @@ void EnHorse_ProjectPos(PlayState* play, Vec3f* vec, Vec3f* arg2, f32* arg3) {
     SkinMatrix_Vec3fMtxFMultXYZW(&play->viewProjectionMtxF, vec, arg2, arg3);
 }
 
-s32 func_80A5BBBC(PlayState* play, EnHorse* this, Vec3f* pos) {
+// LLM generated name (HIGH), was func_80A5BBBC: projects pos and tests whether it lies within the camera frustum.
+s32 EnHorse_PosInCameraView(PlayState* play, EnHorse* this, Vec3f* pos) {
     Vec3f sp24;
     f32 sp20;
     f32 eyeDist;
@@ -699,7 +700,7 @@ s32 EnHorse_Spawn(EnHorse* this, PlayState* play) {
                 dist = Math3D_Vec3f_DistXYZ(&player->actor.world.pos, &spawnPos);
 
                 if (play->sceneNum) {}
-                if (!(minDist < dist) && !func_80A5BBBC(play, this, &spawnPos)) {
+                if (!(minDist < dist) && !EnHorse_PosInCameraView(play, this, &spawnPos)) {
                     minDist = dist;
                     this->actor.world.pos.x = sHorseSpawns[i].pos.x;
                     this->actor.world.pos.y = sHorseSpawns[i].pos.y;
@@ -1824,7 +1825,7 @@ void EnHorse_Idle(EnHorse* this, PlayState* play) {
 
     if (DREG(53) && this->type == HORSE_EPONA) {
         DREG(53) = 0;
-        if (!func_80A5BBBC(play, this, &this->actor.world.pos)) {
+        if (!EnHorse_PosInCameraView(play, this, &this->actor.world.pos)) {
             if (EnHorse_Spawn(this, play)) {
                 Audio_PlaySfxGeneral(NA_SE_EV_HORSE_NEIGH, &this->actor.projectedPos, 4, &gSfxDefaultFreqAndVolScale,
                                      &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
