+// LLM generated name (HIGH), was D_80B3BF54: the tree's main display list per drawType; drawn opaquely when the translucent overlay exists and translucently on its own when it does not.
+static Gfx* sDLists[] = {  // was D_80B3BF54 [LLM:HIGH]
     object_wood02_DL_0078D0, object_wood02_DL_007CA0, object_wood02_DL_0080D0, object_wood02_DL_000090,
