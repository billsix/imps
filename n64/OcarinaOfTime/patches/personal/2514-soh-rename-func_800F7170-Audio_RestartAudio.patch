From 3ce89ce32add38590020dab1938ac01b8b38aef6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:57 +0000
Subject: [PATCH 2514/3799] soh: rename func_800F7170 -> Audio_RestartAudio

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: restarts the SFX sequence and pushes the mute and reset commands through; whether this belongs to a spec change or another reset path is not established
Defined in soh/src/code/audio_general.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h      | 2 +-
 soh/src/code/audio_general.c | 3 ++-
 soh/src/code/audio_seq.c     | 4 ++--
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 560901af3..796455b69 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -2136,7 +2136,7 @@ void Audio_SetNatureAmbienceChannelIO(u8 channelIdxRange, u8 port, u8 val);
 void Audio_PlayNatureAmbienceSequence(u8 natureAmbienceId);
 void Audio_Init();
 void Audio_InitSound();
-void func_800F7170(void);
+void Audio_RestartAudio(void);  // was func_800F7170 [LLM:GUESS]
 void func_800F71BC(s32 arg0);
 void Audio_SetSfxBanksMute(u16 muteMask);
 void Audio_QueueSeqCmdMute(u8 channelIdx);
diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index b10c7caca..3fb6cff85 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -5587,7 +5587,8 @@ void Audio_InitSound(void) {
     Audio_StartSequence(SEQ_PLAYER_SFX, 0, 0x70, 10);
 }
 
-void func_800F7170(void) {
+// LLM generated name (GUESS), was func_800F7170: restarts the SFX sequence and pushes the mute and reset commands through; whether this belongs to a spec change or another reset path is not established
+void Audio_RestartAudio(void) {
     Audio_StartSequence(SEQ_PLAYER_SFX, 0, 0x70, 1);
     Audio_QueueCmdS32(0xF2000000, 1);
     Audio_ScheduleProcessCmds();
diff --git a/soh/src/code/audio_seq.c b/soh/src/code/audio_seq.c
index ea82bd04d..a1dc2170b 100644
--- a/soh/src/code/audio_seq.c
+++ b/soh/src/code/audio_seq.c
@@ -700,13 +700,13 @@ u8 Audio_UpdateResetState(void) {
             if (AudioThread_ResetComplete() == 1) {
                 sAudioResetState = 0;
                 Audio_QueueCmdS8(0x46020000, gSfxChannelLayout);
-                func_800F7170();
+                Audio_RestartAudio();  // was func_800F7170 [LLM:GUESS]
             }
         } else if (sAudioResetState == 2) {
             while (AudioThread_ResetComplete() != 1) {}
             sAudioResetState = 0;
             Audio_QueueCmdS8(0x46020000, gSfxChannelLayout);
-            func_800F7170();
+            Audio_RestartAudio();  // was func_800F7170 [LLM:GUESS]
         }
     }
 
