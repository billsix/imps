From bc716b9905d74b03c99e25f0d81d2c3c21134af1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:39 +0000
Subject: [PATCH 2638/3799] soh: rename D_8082ABAC -> sPageRotateEyeDx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-mode X step applied to the pause camera while the pages rotate
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 11b1d9b9c..4301de81e 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -939,7 +939,8 @@ static s16 sCursorEnvB = 0;  // was D_8082ABA4 [LLM:HIGH]
 
 static s16 sInDungeonScene = false;
 
-static f32 D_8082ABAC[] = {
+// LLM generated name (HIGH), was D_8082ABAC: per-mode X step applied to the pause camera while the pages rotate
+static f32 sPageRotateEyeDx[] = {  // was D_8082ABAC [LLM:HIGH]
     -4.0f, 4.0f, 4.0f, 4.0f, 4.0f, -4.0f, -4.0f, -4.0f,
 };
 
@@ -2544,7 +2545,7 @@ void KaleidoScope_RotatePageSlow(PlayState* play, Input* input) {
 
     if (!cond) {
         mode = pauseCtx->mode;
-        pauseCtx->eye.x += D_8082ABAC[mode];
+        pauseCtx->eye.x += sPageRotateEyeDx[mode];  // was D_8082ABAC [LLM:HIGH]
         pauseCtx->eye.z += D_8082ABCC[mode];
 
         if (pauseCtx->unk_1EA < 32) {
@@ -3566,7 +3567,7 @@ uint32_t _bswap32(uint32_t a) {
 void KaleidoScope_RotatePageFast(PlayState* play) {
     PauseContext* pauseCtx = &play->pauseCtx;
 
-    pauseCtx->eye.x += D_8082ABAC[pauseCtx->mode] * ZREG(46);
+    pauseCtx->eye.x += sPageRotateEyeDx[pauseCtx->mode] * ZREG(46);  // was D_8082ABAC [LLM:HIGH]
     pauseCtx->eye.z += D_8082ABCC[pauseCtx->mode] * ZREG(46);
     pauseCtx->unk_1EA += 4 * ZREG(46);
 
-- 
