From aac3f4900de6fda80134324b6e972ef22b66cfc6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:08:49 +0000
Subject: [PATCH 2007/3799] soh: rename D_80897310 -> sBeamDimsWithAngle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-params flag enabling the misalignment dimming in BgJyaCobra_UpdateBeamParams
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
index 3b733388d..06148ad3c 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
@@ -41,7 +41,8 @@ const ActorInit Bg_Jya_Cobra_InitVars = {
 // LLM generated name (HIGH), was D_80897308: per-params X rotation added to the beam direction and to the beam model, all zero in the shipped table
 static s16 sBeamPitchOffsets[] = { 0, 0, 0, 0 };  // was D_80897308 [LLM:HIGH]
 
-static u8 D_80897310[] = { true, false, true, false };
+// LLM generated name (HIGH), was D_80897310: per-params flag enabling the misalignment dimming in BgJyaCobra_UpdateBeamParams
+static u8 sBeamDimsWithAngle[] = { true, false, true, false };  // was D_80897310 [LLM:HIGH]
 
 static s16 D_80897314[] = { -0x4000, 0000, 0x4000, 0000 };
 
@@ -224,7 +225,7 @@ void BgJyaCobra_UpdateBeamParams(BgJyaCobra* this, PlayState* play) {
         Math_StepToF(&this->unk_18C, 0.0f, 0.05f);
     } else {
         this->unk_18C = 1.0f;
-        if (D_80897310[params & 3]) {
+        if (sBeamDimsWithAngle[params & 3]) {  // was D_80897310 [LLM:HIGH]
             phi_v0 = this->dyna.actor.shape.rot.y - D_80897314[params & 3];
             phi_v0 = ABS(phi_v0);
             if (phi_v0 < 0x2000 && phi_v0 != -0x8000) {
-- 
2.55.0

