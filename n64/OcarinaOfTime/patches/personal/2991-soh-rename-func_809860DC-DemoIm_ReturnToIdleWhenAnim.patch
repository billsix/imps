Subject: [PATCH 2991/3799] soh: rename func_809860DC ->
 DemoIm_ReturnToIdleWhenAnimDone

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loops the idle animation again once the current one ends
Defined in soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
index 755766d03..7a17338a6 100644
--- a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -641,7 +641,8 @@ void DemoIm_SetupWhistling(DemoIm* this) {
     this->drawConfig = 1;
 }
 
-void func_809860DC(DemoIm* this, s32 arg1) {
+// LLM generated name (HIGH), was func_809860DC: loops the idle animation again once the current one ends
+void DemoIm_ReturnToIdleWhenAnimDone(DemoIm* this, s32 arg1) {
     if (arg1 != 0) {
         Animation_Change(&this->skelAnime, &gImpaIdleAnim, 1.0f, 0.0f, Animation_GetLastFrame(&gImpaIdleAnim),
                          ANIMMODE_LOOP, -8.0f);
@@ -757,7 +758,7 @@ void func_809864D4(DemoIm* this, PlayState* play) {
     DemoIm_UpdateBgCheckInfo(this, play);
     sp24 = DemoIm_UpdateSkelAnime(this);
     DemoIm_UpdateEyes(this);  // was func_80984BE0 [LLM:HIGH]
-    func_809860DC(this, sp24);
+    DemoIm_ReturnToIdleWhenAnimDone(this, sp24);  // was func_809860DC [LLM:HIGH]
     func_8098629C(this, play);
 }
 
