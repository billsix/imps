From e57b155a2d674075bdc5661900ea8a2ad6c8618c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:49 +0000
Subject: [PATCH 3156/3799] soh: rename D_8015E420 -> sTrisVsTrisHitPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hit position CollisionCheck_AC_TrisVsTris reports
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index d59847bce..15b2ae208 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2314,7 +2314,7 @@ static s8 sBssDummy6;
  * AC overlap check. Calculates the center of each collider element and the point of contact.
  */
 void CollisionCheck_AC_TrisVsTris(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT, Collider* colAC) {
-    static Vec3f D_8015E420;
+    static Vec3f sTrisVsTrisHitPos;  // was D_8015E420 [LLM:HIGH]
     ColliderTris* at = (ColliderTris*)colAT;
     ColliderTrisElement* atItem;
     ColliderTris* ac = (ColliderTris*)colAC;
@@ -2332,7 +2332,7 @@ void CollisionCheck_AC_TrisVsTris(PlayState* play, CollisionCheckContext* colChk
                 if (CollisionCheck_NoSharedFlags(&atItem->info, &acElem->info) == 1) {
                     continue;
                 }
-                if (Math3D_TriVsTriIntersect(&atItem->dim, &acElem->dim, &D_8015E420) == 1) {
+                if (Math3D_TriVsTriIntersect(&atItem->dim, &acElem->dim, &sTrisVsTrisHitPos) == 1) {  // was D_8015E420 [LLM:HIGH]
                     Vec3f atPos;
                     Vec3f acPos;
 
@@ -2343,7 +2343,7 @@ void CollisionCheck_AC_TrisVsTris(PlayState* play, CollisionCheckContext* colChk
                     acPos.y = (acElem->dim.vtx[0].y + acElem->dim.vtx[1].y + acElem->dim.vtx[2].y) * (1.0f / 3);
                     acPos.z = (acElem->dim.vtx[0].z + acElem->dim.vtx[1].z + acElem->dim.vtx[2].z) * (1.0f / 3);
                     CollisionCheck_SetATvsAC(play, &at->base, &atItem->info, &atPos, &ac->base, &acElem->info, &acPos,
-                                             &D_8015E420);
+                                             &sTrisVsTrisHitPos);  // was D_8015E420 [LLM:HIGH]
                     return;
                 }
             }
