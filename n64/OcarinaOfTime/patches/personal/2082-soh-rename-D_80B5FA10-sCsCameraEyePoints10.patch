     { 0, 0, 0, 20.799965f, { -549, 124, 29 } },  { 0, 0, 0, 20.799965f, { -549, 124, 29 } },
@@ -203,5 +204,5 @@ static CutsceneCameraMove sCsCameraMove[] = {
     { sCsCameraAtPoints0, sCsCameraEyePoints0, 0 }, { sCsCameraAtPoints1, sCsCameraEyePoints1, 0 }, { sCsCameraAtPoints2, sCsCameraEyePoints2, 0 },  // was D_80B5EC70 [LLM:HIGH]
