Subject: [PATCH 1918/3799] soh: rename func_809FDE24 -> EnDu_TrackPlayer

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: feeds the player's position to Npc_TrackPoint, disabling head tracking while idle or mid-cutscene
Defined in soh/src/overlays/actors/ovl_En_Du/z_en_du.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Du/z_en_du.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Du/z_en_du.c b/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
index 84243a6b6..9b77e79ba 100644
--- a/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
+++ b/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
@@ -186,7 +186,8 @@ s32 EnDu_ShouldSpawn(EnDu* this, PlayState* play) {
     return 0;
 }
 
-void func_809FDE24(EnDu* this, PlayState* play) {
+// LLM generated name (HIGH), was func_809FDE24: feeds the player's position to Npc_TrackPoint, disabling head tracking while idle or mid-cutscene
+void EnDu_TrackPlayer(EnDu* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
     s16 trackingMode = NPC_TRACKING_PLAYER_AUTO_TURN;
 
@@ -610,7 +611,7 @@ void EnDu_Update(Actor* thisx, PlayState* play) {
 
     SkelAnime_Update(&this->skelAnime);
     func_809FDE9C(this);
-    func_809FDE24(this, play);
+    EnDu_TrackPlayer(this, play);  // was func_809FDE24 [LLM:HIGH]
 
     if (this->actionFunc == func_809FE890) {
         this->actor.world.pos.x += this->actor.velocity.x;
