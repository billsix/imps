-    SkelAnime_DrawSkeletonOpa(play, skelAnime, func_80AB2FC0, NULL, &this->actor);
+    SkelAnime_DrawSkeletonOpa(play, skelAnime, EnNb_OverrideLimbDrawMouthOpen, NULL, &this->actor);  // was func_80AB2FC0 [LLM:HIGH]
 
     CLOSE_DISPS(play->state.gfxCtx);
 }
