Subject: [PATCH 1111/3799] soh: rename func_800DB2C0 ->
 AudioSynth_DisableLaterNoteSubEus

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: disables one note's noteSubEu in every update slot after the given one, stopping at the first slot that still needs init.
Defined in soh/src/code/audio_synthesis.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_synthesis.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_synthesis.c b/soh/src/code/audio_synthesis.c
index ecf0bf346..1bd8ca6bd 100644
--- a/soh/src/code/audio_synthesis.c
+++ b/soh/src/code/audio_synthesis.c
@@ -182,7 +182,8 @@ Acmd* AudioSynth_Update(Acmd* cmdStart, s32* cmdCnt, s16* aiStart, s32 aiBufLen)
     return cmdP;
 }
 
-void func_800DB2C0(s32 updateIndexStart, s32 noteIndex) {
+// LLM generated name (HIGH), was func_800DB2C0: disables one note's noteSubEu in every update slot after the given one, stopping at the first slot that still needs init.
+void AudioSynth_DisableLaterNoteSubEus(s32 updateIndexStart, s32 noteIndex) {
     NoteSubEu* temp_v1;
     s32 i;
 
@@ -1010,7 +1011,7 @@ Acmd* AudioSynth_ProcessNote(s32 noteIndex, NoteSubEu* noteSubEu, NoteSynthesisS
                                            (samplesLenAdjusted - nSamplesProcessed) * 2);
                     finished = true;
                     note->noteSubEu.bitField0.finished = true;
-                    func_800DB2C0(updateIndex, noteIndex);
+                    AudioSynth_DisableLaterNoteSubEus(updateIndex, noteIndex);  // was func_800DB2C0 [LLM:HIGH]
                     break;
                 } else {
                     if (restart) {
