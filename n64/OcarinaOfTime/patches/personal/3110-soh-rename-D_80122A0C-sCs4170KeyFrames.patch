From ee23eaabc393019197717e054789bd0886e94a96 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:41 +0000
Subject: [PATCH 3110/3799] soh: rename D_80122A0C -> sCs4170KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 4170 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 0d91abbd6..30eb38174 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -882,7 +882,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
             break;
         case 4170:
-            csInfo->keyFrames = D_80122A0C;
+            csInfo->keyFrames = sCs4170KeyFrames;  // was D_80122A0C [LLM:HIGH]
             csInfo->keyFrameCnt = 2;
 
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 803ebcfa8..88c942aad 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -540,7 +540,8 @@ static OnePointCsFull sCs4160KeyFrames[4] = {  // was D_8012296C [LLM:HIGH]
     { 0x11, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80122A0C[2] = {
+// LLM generated name (HIGH), was D_80122A0C: the keyframe set one-point cutscene 4170 installs
+static OnePointCsFull sCs4170KeyFrames[2] = {  // was D_80122A0C [LLM:HIGH]
     { 0x0F, 0xFF, 0x0101, 60, 4, 50.0f, 1.0f, { 0.0f, 400.0f, -1000.0f }, { -200.0f, 500.0f, -850.0f } },
     { 0x12, 0xFF, 0x0000, 1, 0, 50.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
