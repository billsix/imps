Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c.
---
 soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c b/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
index 1a8cc2cb3..478f33772 100644
--- a/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
+++ b/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
@@ -18,7 +18,8 @@ void EnHs_Draw(Actor* thisx, PlayState* play);
 
 // Name from zeldaret/oot (was func_80A6E9AC): adopted upstream's name for this address; body verified to match upstream at 0.83. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Hs/z_en_hs.c]
 void EnHs_SleepingInteract(EnHs* this, PlayState* play);
-void func_80A6E6B0(EnHs* this, PlayState* play);
