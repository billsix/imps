From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:46 +0000
Subject: [PATCH 742/784] soh: rename func_80AF5CE4 -> EnSa_Animate

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c.
---
 soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
index af8e006ea..705e440b4 100644
--- a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
+++ b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
@@ -361,7 +361,8 @@ void EnSa_SetAnimGroup(EnSa* this, u8 arg1) {
     this->unk_20A = 0;
 }
 
-void func_80AF5CE4(EnSa* this) {
+// Name from zeldaret/oot (was func_80AF5CE4): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Sa/z_en_sa.c]
+void EnSa_Animate(EnSa* this) {
     switch (this->unk_20B) {
         case 1:
             EnSa_ExtendRightHand(this);
@@ -619,7 +620,7 @@ void func_80AF6448(EnSa* this, PlayState* play) {
         } else {
             EnSa_SetAnimGroup(this, 0);
         }
-        func_80AF5CE4(this);
+        EnSa_Animate(this);
     }
     if (this->skelAnime.animation == &gSariaStopPlayingOcarinaAnim) {
         this->skelAnime.playSpeed = -1.0f;
