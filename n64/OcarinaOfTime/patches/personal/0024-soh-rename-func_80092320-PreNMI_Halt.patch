From 00c0a7a9c59c900006b7409aef262d349cbac6c4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:24:59 +0000
Subject: [PATCH 024/488] soh: rename func_80092320 -> PreNMI_Halt

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/z_prenmi.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/code/z_prenmi.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_prenmi.c b/soh/src/code/z_prenmi.c
index 4a6f777ae..d344259a9 100644
--- a/soh/src/code/z_prenmi.c
+++ b/soh/src/code/z_prenmi.c
@@ -1,7 +1,8 @@
 #include "global.h"
 #include "vt.h"
 
-void func_80092320(PreNMIContext* this) {
+// LLM generated name (HIGH), was func_80092320: stops the PreNMI GameState by clearing running/init when the timer expires
+void PreNMI_Halt(PreNMIContext* this) {
     this->state.running = false;
     this->state.init = NULL;
     this->state.size = 0;
@@ -18,7 +19,7 @@ void PreNMI_Update(PreNMIContext* this) {
 
     if (this->timer == 0) {
         ViConfig_UpdateVi(1);
-        func_80092320(this);
+        PreNMI_Halt(this);
         return;
     }
 
