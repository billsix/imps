From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:31:17 +0000
Subject: [PATCH 1616/3799] soh: rename D_80AD7080 -> sCylinderInit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the body ColliderCylinderInit; Init installs it and the respawn path restores its dimensions from it.
Defined in soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Po_Field/z_en_po_field.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
index 7753253e1..74727e371 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
@@ -53,7 +53,8 @@ const ActorInit En_Po_Field_InitVars = {
     (ActorResetFunc)EnPoField_Reset,
 };
 
-static ColliderCylinderInit D_80AD7080 = {
+// LLM generated name (HIGH), was D_80AD7080: the body ColliderCylinderInit; Init installs it and the respawn path restores its dimensions from it.
+static ColliderCylinderInit sCylinderInit = {  // was D_80AD7080 [LLM:HIGH]
     {
         COLTYPE_HIT3,
         AT_NONE,
@@ -179,7 +180,7 @@ void EnPoField_Init(Actor* thisx, PlayState* play) {
     Actor_ProcessInitChain(&this->actor, sInitChain);
     SkelAnime_Init(play, &this->skelAnime, &gPoeFieldSkel, &gPoeFieldFloatAnim, this->jointTable, this->morphTable, 10);
     Collider_InitCylinder(play, &this->collider);
-    Collider_SetCylinder(play, &this->collider, &this->actor, &D_80AD7080);
+    Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);  // was D_80AD7080 [LLM:HIGH]
     Collider_InitCylinder(play, &this->flameCollider);
     Collider_SetCylinder(play, &this->flameCollider, &this->actor, &D_80AD70AC);
     CollisionCheck_SetInfo(&this->actor.colChkInfo, &sDamageTable, &D_80AD70D8);
@@ -237,9 +238,9 @@ void EnPoField_SetupAppear(EnPoField* this) {
         this->actor.naviEnemyId = 0x5A;
     } else {
         this->actor.speedXZ = 0.0f;
-        this->collider.dim.radius = D_80AD7080.dim.radius;
-        this->collider.dim.height = D_80AD7080.dim.height;
-        this->collider.dim.yShift = D_80AD7080.dim.yShift;
+        this->collider.dim.radius = sCylinderInit.dim.radius;  // was D_80AD7080 [LLM:HIGH]
+        this->collider.dim.height = sCylinderInit.dim.height;  // was D_80AD7080 [LLM:HIGH]
+        this->collider.dim.yShift = sCylinderInit.dim.yShift;  // was D_80AD7080 [LLM:HIGH]
         this->actor.shape.shadowScale = 37.0f;
         this->scaleModifier = 0.01f;
         this->actor.naviEnemyId = 0x5C;
@@ -1015,4 +1016,4 @@ void EnPoField_Reset(void) {
 
     memset(sSpawnPositions, 0, sizeof(sSpawnPositions));
     memset(sSpawnSwitchFlags, 0, sizeof(sSpawnSwitchFlags));
-}
\ No newline at end of file
+}
