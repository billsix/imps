From 1dd8f433f8b6ed0f53d9dd16899dd481894c4067 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:42 +0000
Subject: [PATCH 2663/3799] soh: rename D_8082B000 -> sPageVtxX

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-page X offset tables, indexed by pageIndex
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index e7c50ddee..248979c84 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2706,7 +2706,8 @@ static s16 sPageVtxHeights5[] = {  // was D_8082AFF4 [LLM:HIGH]
     0x0010, 0x0030, 0x0030, 0x0010, 0x0010, 0x0000,
 };
 
-static s16* D_8082B000[] = {
+// LLM generated name (HIGH), was D_8082B000: the per-page X offset tables, indexed by pageIndex
+static s16* sPageVtxX[] = {  // was D_8082B000 [LLM:HIGH]
     sPageVtxX0, sPageVtxX1, sPageVtxX2, sPageVtxX3, sPageVtxX4, sPageVtxX5,  // was D_8082AE90 [LLM:HIGH]
 };
 
@@ -2898,7 +2899,7 @@ s16 KaleidoScope_SetPageVtx(PlayState* play, Vtx* vtx, s16 pageIndex, s16 arg3)
     phi_s2 = vtxIndex;
 
     if (arg3 != 0) {
-        ptr1 = D_8082B000[pageIndex];
+        ptr1 = sPageVtxX[pageIndex];  // was D_8082B000 [LLM:HIGH]
         ptr2 = D_8082B018[pageIndex];
         ptr3 = D_8082B030[pageIndex];
         ptr4 = D_8082B048[pageIndex];
