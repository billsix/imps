From 5889897962b619c79e8b4a74cbf86bc6640ce770 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:24:57 +0000
Subject: [PATCH 003/488] soh: rename func_800C3C80 -> AudioMgr_NotifyTaskDone

Name source: zeldaret/oot.
Defined in soh/src/code/audioMgr.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/include/functions.h | 2 +-
 soh/src/code/audioMgr.c | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 9737446a9..afb3b2171 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1624,7 +1624,7 @@ void THA_Init(TwoHeadArena* tha);
 void THA_Ct(TwoHeadArena* tha, void* ptr, size_t size);
 void THA_Dt(TwoHeadArena* tha);
 void func_800C3C20(void);
-void func_800C3C80(AudioMgr* audioMgr);
+void AudioMgr_NotifyTaskDone(AudioMgr* audioMgr);  // was func_800C3C80 [oot]
 void AudioMgr_HandleRetrace(AudioMgr* audioMgr);
 void AudioMgr_HandlePRENMI(AudioMgr* audioMgr);
 void AudioMgr_ThreadEntry(void* arg0);
diff --git a/soh/src/code/audioMgr.c b/soh/src/code/audioMgr.c
index 51b3ce53e..4c4c5b5a2 100644
--- a/soh/src/code/audioMgr.c
+++ b/soh/src/code/audioMgr.c
@@ -1,7 +1,8 @@
 #include "global.h"
 #include <string.h>
 
-void func_800C3C80(AudioMgr* audioMgr) {
+// Name from zeldaret/oot, was func_800C3C80: posts to the RSP audio task's queue to signal task completion. [oot: https://github.com/zeldaret/oot/blob/main/src/code/audio_thread_manager.c]
+void AudioMgr_NotifyTaskDone(AudioMgr* audioMgr) {
     AudioTask* task;
 
     task = audioMgr->rspTask;
@@ -39,7 +40,7 @@ void AudioMgr_HandleRetrace(AudioMgr* audioMgr) {
     D_8016A550 = 0;
     if (audioMgr->rspTask != NULL) {
         osRecvMesg(&audioMgr->unk_AC, NULL, OS_MESG_BLOCK);
-        func_800C3C80(audioMgr);
+        AudioMgr_NotifyTaskDone(audioMgr);
     }
     audioMgr->rspTask = rspTask;
 }
