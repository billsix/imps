From eabf004f1f5c151346f6c7863aae95fcef395dbf Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:19:10 +0000
Subject: [PATCH 0900/3799] soh: rename D_80B1B634 -> sAttackAnimations

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: AnimationHeader* table indexed by this->vAttackState and handed to Animation_PlayOnce.
Defined in soh/src/overlays/actors/ovl_En_Tite/z_en_tite.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Tite/z_en_tite.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tite/z_en_tite.c b/soh/src/overlays/actors/ovl_En_Tite/z_en_tite.c
index 2b9896f9b..7f69a58dc 100644
--- a/soh/src/overlays/actors/ovl_En_Tite/z_en_tite.c
+++ b/soh/src/overlays/actors/ovl_En_Tite/z_en_tite.c
@@ -157,7 +157,8 @@ static InitChainEntry sInitChain[] = {
     ICHAIN_F32_DIV1000(gravity, -1000, ICHAIN_STOP),
 };
 
-static AnimationHeader* D_80B1B634[] = {
+// LLM generated name (HIGH), was D_80B1B634: AnimationHeader* table indexed by this->vAttackState and handed to Animation_PlayOnce.
+static AnimationHeader* sAttackAnimations[] = {  // was D_80B1B634 [LLM:HIGH]
     &object_tite_Anim_00083C, &object_tite_Anim_0004F8, &object_tite_Anim_00069C, NULL, NULL, NULL,
 };
 
@@ -339,7 +340,7 @@ void EnTite_Attack(EnTite* this, PlayState* play) {
         }
         // If switching attack state, change animation (unless tektite is switching between submerged and landed)
         if (attackState != this->vAttackState) {
-            Animation_PlayOnce(&this->skelAnime, D_80B1B634[this->vAttackState]);
+            Animation_PlayOnce(&this->skelAnime, sAttackAnimations[this->vAttackState]);  // was D_80B1B634 [LLM:HIGH]
         }
     }
 
