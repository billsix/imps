From 0fe3f275927737b5121ab9b3add93b7d38411b6f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:03 +0000
Subject: [PATCH 3384/3799] soh: rename D_80B41D90 -> sWindSfxStarted

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: set once the colossus wind sound has a previous camera position to measure speed against
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index fef3e390f..84a75590c 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -503,7 +503,8 @@ void EnXc_PlaySkipSfxOutsideColossus(PlayState* play) {
 // LLM generated name (HIGH), was D_80B42DA0: the projected position NA_SE_EV_DIVE_INTO_WATER is played at
 static Vec3f sDiveSfxPos;  // was D_80B42DA0 [LLM:HIGH]
 
-static s32 D_80B41D90 = 0;
+// LLM generated name (HIGH), was D_80B41D90: set once the colossus wind sound has a previous camera position to measure speed against
+static s32 sWindSfxStarted = 0;  // was D_80B41D90 [LLM:HIGH]
 void EnXc_SetColossusWindSFX(PlayState* play) {
     if (gSaveContext.sceneLayer == 4) {
         static Vec3f sPos = { 0.0f, 0.0f, 0.0f };
@@ -520,7 +521,7 @@ void EnXc_SetColossusWindSFX(PlayState* play) {
                 s32 pad;
                 Vec3f* eye = &play->view.eye;
 
-                if (D_80B41D90 != 0) {
+                if (sWindSfxStarted != 0) {  // was D_80B41D90 [LLM:HIGH]
                     f32 speed = Math3D_Vec3f_DistXYZ(&D_80B42DB0, eye) / 7.058922f;
 
                     sMaxSpeed = CLAMP_MIN(sMaxSpeed, speed);
@@ -534,7 +535,7 @@ void EnXc_SetColossusWindSFX(PlayState* play) {
                 D_80B42DB0.x = eye->x;
                 D_80B42DB0.y = eye->y;
                 D_80B42DB0.z = eye->z;
-                D_80B41D90 = 1;
+                sWindSfxStarted = 1;  // was D_80B41D90 [LLM:HIGH]
             }
         }
     }
@@ -1494,7 +1495,7 @@ void EnXc_SpawnWarpAtFrame310(PlayState* play) {
 static s32 D_80B41DAC = 1;
 
 #define EN_XC_SHIP_SAVESTATE_FIELDS(F) \
-    F(D_80B41D90)                      \
+    F(sWindSfxStarted)                      \
     F(sFlameSpawned)                   \
     F(D_80B41DA8)                      \
     F(D_80B41DAC)
@@ -2565,7 +2566,7 @@ const ActorInit En_Xc_InitVars = {
 };
 
 void EnXc_Reset(void) {
-    D_80B41D90 = 0;
+    sWindSfxStarted = 0;  // was D_80B41D90 [LLM:HIGH]
     sFlameSpawned = false;
     D_80B41DA8 = 1;
     D_80B41DAC = 1;
