From cbcd7cec7af604dfdcf1dd12a11c981027f1654a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:38 +0000
Subject: [PATCH 379/784] soh: rename func_80A771E4 -> EnIk_SetupCsAction2

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.90.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index 54e720108..46c31f0d9 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -1128,7 +1128,8 @@ void EnIk_SetupCsAction1(EnIk* this, PlayState* play) {
     this->actor.shape.shadowAlpha = 0xFF;
 }
 
-void func_80A771E4(EnIk* this) {
+// Name from zeldaret/oot (was func_80A771E4): adopted upstream's name for this address; body verified to match upstream at 0.90. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ik/z_en_ik.c]
+void EnIk_SetupCsAction2(EnIk* this) {
     Animation_Change(&this->skelAnime, &gIronKnuckleNabooruSummonAxeAnim, 1.0f, 0.0f,
                      Animation_GetLastFrame(&gIronKnuckleNabooruSummonAxeAnim), ANIMMODE_ONCE, 0.0f);
     this->action = 2;
@@ -1290,7 +1291,7 @@ void func_80A779DC(EnIk* this, PlayState* play) {
                     EnIk_SetupCsAction1(this, play);
                     break;
                 case 3:
-                    func_80A771E4(this);
+                    EnIk_SetupCsAction2(this);
                     break;
                 case 4:
                     func_80A78160(this, play);
