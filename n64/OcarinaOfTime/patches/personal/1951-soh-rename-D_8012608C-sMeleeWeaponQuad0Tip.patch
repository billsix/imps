From 1ca5cc8c597683f98b6801f80ecec4c987e343c6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:05:34 +0000
Subject: [PATCH 1951/3799] soh: rename D_8012608C -> sMeleeWeaponQuad0Tip

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: tip of the first sweep quad; its x tracks the blade length plus 1200 and the spin-attack stretch
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index 60194affd..9fe2a36b7 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1572,7 +1572,8 @@ void Player_UpdateShieldCollider(PlayState* play, Player* this, ColliderQuad* co
 
 // LLM generated name (HIGH), was D_80126080: tip of the blade line in hand space; its x is overwritten each frame with the held weapon's length
 Vec3f sMeleeWeaponBladeTip = { 5000.0f, 400.0f, 0.0f };  // was D_80126080 [LLM:HIGH]
-Vec3f D_8012608C = { 5000.0f, -400.0f, 1000.0f };
+// LLM generated name (HIGH), was D_8012608C: tip of the first sweep quad; its x tracks the blade length plus 1200 and the spin-attack stretch
+Vec3f sMeleeWeaponQuad0Tip = { 5000.0f, -400.0f, 1000.0f };  // was D_8012608C [LLM:HIGH]
 Vec3f D_80126098 = { 5000.0f, 1400.0f, -1000.0f };
 
 Vec3f D_801260A4[3] = {
@@ -1697,18 +1698,18 @@ void Player_DrawGetItem(PlayState* play, Player* this) {
 
 // Name from zeldaret/oot (was func_80090A28): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.99. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_player_lib.c]
 void Player_CalcMeleeWeaponTipPositions(Player* this, Vec3f* vecs) {
-    D_8012608C.x = sMeleeWeaponBladeTip.x;  // was D_80126080 [LLM:HIGH]
+    sMeleeWeaponQuad0Tip.x = sMeleeWeaponBladeTip.x;  // was D_80126080 [LLM:HIGH]
 
     if (this->unk_845 >= 3) {
         this->unk_845 += 1;
-        D_8012608C.x *= 1.0f + ((9 - this->unk_845) * 0.1f);
+        sMeleeWeaponQuad0Tip.x *= 1.0f + ((9 - this->unk_845) * 0.1f);  // was D_8012608C [LLM:HIGH]
     }
 
-    D_8012608C.x += 1200.0f;
-    D_80126098.x = D_8012608C.x;
+    sMeleeWeaponQuad0Tip.x += 1200.0f;  // was D_8012608C [LLM:HIGH]
+    D_80126098.x = sMeleeWeaponQuad0Tip.x;  // was D_8012608C [LLM:HIGH]
 
     Matrix_MultVec3f(&sMeleeWeaponBladeTip, &vecs[0]);  // was D_80126080 [LLM:HIGH]
-    Matrix_MultVec3f(&D_8012608C, &vecs[1]);
+    Matrix_MultVec3f(&sMeleeWeaponQuad0Tip, &vecs[1]);  // was D_8012608C [LLM:HIGH]
     Matrix_MultVec3f(&D_80126098, &vecs[2]);
 }
 
