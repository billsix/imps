Subject: [PATCH 0406/3799] soh: rename func_80AAAF04 -> EnMd_UpdateTalkState

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.84.
Defined in soh/src/overlays/actors/ovl_En_Md/z_en_md.c.
---
 soh/src/overlays/actors/ovl_En_Md/z_en_md.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Md/z_en_md.c b/soh/src/overlays/actors/ovl_En_Md/z_en_md.c
index ec4231baf..fdfa7d9b9 100644
--- a/soh/src/overlays/actors/ovl_En_Md/z_en_md.c
+++ b/soh/src/overlays/actors/ovl_En_Md/z_en_md.c
@@ -456,7 +456,8 @@ u16 EnMd_GetText(PlayState* play, Actor* thisx) {
     }
 }
 
-s16 func_80AAAF04(PlayState* play, Actor* thisx) {
+// Name from zeldaret/oot (was func_80AAAF04): adopted upstream's name for this address; body verified to match upstream at 0.84. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Md/z_en_md.c]
+s16 EnMd_UpdateTalkState(PlayState* play, Actor* thisx) {
     EnMd* this = (EnMd*)thisx;
     switch (EnMd_TrackMessageState(this, play)) {
         case TEXT_STATE_NONE:
@@ -576,7 +577,7 @@ void EnMd_UpdateTalking(EnMd* this, PlayState* play) {
     if (this->actionFunc != EnMd_ListenToOcarina) {
         if (canUpdateTalking) {
             Npc_UpdateTalking(play, &this->actor, &this->interactInfo.talkState, this->collider.dim.radius + 30.0f,
-                              EnMd_GetText, func_80AAAF04);
+                              EnMd_GetText, EnMd_UpdateTalkState);
         }
     }
 }
