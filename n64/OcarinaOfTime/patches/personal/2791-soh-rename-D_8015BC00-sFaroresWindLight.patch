From 04f304f1fb02dca4380d9a9a4fecedb6006832a5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:37 +0000
Subject: [PATCH 2791/3799] soh: rename D_8015BC00 -> sFaroresWindLight

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the light placed at the Farore's Wind warp point
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index ed7fb898d..c82c3cbd2 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -2353,7 +2353,8 @@ s32 Actor_CheckBlueBloodWall(PlayState* play, Actor* actor, CollisionPoly* poly,
 }
 
 // Local data used for Farore's Wind light (stored in BSS, possibly a struct?)
-LightInfo D_8015BC00;
+// LLM generated name (HIGH), was D_8015BC00: the light placed at the Farore's Wind warp point
+LightInfo sFaroresWindLight;  // was D_8015BC00 [LLM:HIGH]
 LightNode* D_8015BC10;
 s32 D_8015BC14;
 f32 D_8015BC18;
@@ -2384,9 +2385,9 @@ void Actor_InitFaroresWindPoint(PlayState* play) {
     lightPos.y = gSaveContext.respawn[RESPAWN_MODE_TOP].pos.y + 80.0f;
     lightPos.z = gSaveContext.respawn[RESPAWN_MODE_TOP].pos.z;
 
-    Lights_PointNoGlowSetInfo(&D_8015BC00, lightPos.x, lightPos.y, lightPos.z, 0xFF, 0xFF, 0xFF, -1);
+    Lights_PointNoGlowSetInfo(&sFaroresWindLight, lightPos.x, lightPos.y, lightPos.z, 0xFF, 0xFF, 0xFF, -1);  // was D_8015BC00 [LLM:HIGH]
 
-    D_8015BC10 = LightContext_InsertLight(play, &play->lightCtx, &D_8015BC00);
+    D_8015BC10 = LightContext_InsertLight(play, &play->lightCtx, &sFaroresWindLight);  // was D_8015BC00 [LLM:HIGH]
     D_8015BC14 = 0;
     D_8015BC18 = 0.0f;
 }
@@ -2539,7 +2540,7 @@ void Actor_DrawFaroresWindPointer(PlayState* play) {
             gSPDisplayList(POLY_XLU_DISP++, gEffFlash1DL);
         }
 
-        Lights_PointNoGlowSetInfo(&D_8015BC00, ((void)0, gSaveContext.respawn[RESPAWN_MODE_TOP].pos.x),
+        Lights_PointNoGlowSetInfo(&sFaroresWindLight, ((void)0, gSaveContext.respawn[RESPAWN_MODE_TOP].pos.x),  // was D_8015BC00 [LLM:HIGH]
                                   ((void)0, gSaveContext.respawn[RESPAWN_MODE_TOP].pos.y) + yOffset,
                                   ((void)0, gSaveContext.respawn[RESPAWN_MODE_TOP].pos.z), 255, 255, 255, lightRadius);
     }
