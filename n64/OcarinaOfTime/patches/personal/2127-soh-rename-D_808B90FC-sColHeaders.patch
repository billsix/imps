From 55de2139995e9afd8024b39a3f249d71b5a37547 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:12:56 +0000
Subject: [PATCH 2127/3799] soh: rename D_808B90FC -> sColHeaders

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-type collision header, statue and spear
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
index 9bc92d6f4..2b85a4b95 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
@@ -66,7 +66,8 @@ static f32 sScales[] = {  // was D_808B90F4 [LLM:HIGH]
     0.1f,
 };
 
-static CollisionHeader* D_808B90FC[] = {
+// LLM generated name (HIGH), was D_808B90FC: per-type collision header, statue and spear
+static CollisionHeader* sColHeaders[] = {  // was D_808B90FC [LLM:HIGH]
     &gGoronCityStatueCol,
     &gGoronCityStatueSpearCol,
 };
@@ -145,7 +146,7 @@ s32 BgSpot18Obj_InitDynaPoly(BgSpot18Obj* this, PlayState* play) {
     CollisionHeader* colHeader = NULL;
 
     DynaPolyActor_Init(&this->dyna, DPM_UNK);
-    CollisionHeader_GetVirtual(D_808B90FC[this->dyna.actor.params & 0xF], &colHeader);
+    CollisionHeader_GetVirtual(sColHeaders[this->dyna.actor.params & 0xF], &colHeader);  // was D_808B90FC [LLM:HIGH]
     this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, &this->dyna.actor, colHeader);
     return 1;
 }
