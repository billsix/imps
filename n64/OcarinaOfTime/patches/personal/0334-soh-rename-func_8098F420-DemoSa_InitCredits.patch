Subject: [PATCH 0334/3799] soh: rename func_8098F420 -> DemoSa_InitCredits

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.85.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index b64d9ab6a..5c54b0e78 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -509,7 +509,8 @@ void func_8098F3F0(DemoSa* this, PlayState* play) {
     DemoSa_Blink(this);
 }
 
-void func_8098F420(DemoSa* this, PlayState* play) {
+// Name from zeldaret/oot (was func_8098F420): adopted upstream's name for this address; body verified to match upstream at 0.85. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_InitCredits(DemoSa* this, PlayState* play) {
     SkelAnime_InitFlex(play, &this->skelAnime, &gSariaSkel, &gSariaSitting3Anim, NULL, NULL, 0);
     this->action = 11;
     this->drawConfig = 0;
@@ -788,7 +789,7 @@ void DemoSa_Init(Actor* thisx, PlayState* play) {
             DemoSa_InitUnused(this, play);
             break;
         case 4:
-            func_8098F420(this, play);
+            DemoSa_InitCredits(this, play);
             break;
         case 5:
             func_8098F83C(this, play);
