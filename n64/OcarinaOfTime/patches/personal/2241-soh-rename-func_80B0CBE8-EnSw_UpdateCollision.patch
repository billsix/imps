Date: Mon, 7 Sep 2026 23:19:17 +0000
Subject: [PATCH 2241/3799] soh: rename func_80B0CBE8 -> EnSw_UpdateCollision

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: runs down the invulnerability and attack timers and registers the collider as AT, AC and OC while it is alive
Defined in soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
index 40ac68b89..712d4bb10 100644
--- a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
+++ b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
@@ -376,7 +376,8 @@ s32 EnSw_CheckDamage(EnSw* this, PlayState* play) {
     return false;
 }
 
-void func_80B0CBE8(EnSw* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B0CBE8: runs down the invulnerability and attack timers and registers the collider as AT, AC and OC while it is alive
+void EnSw_UpdateCollision(EnSw* this, PlayState* play) {
     if ((((this->actor.params & 0xE000) >> 0xD) > 0) && (this->actionFunc != func_80B0D590)) {
         if (this->unk_392 != 0) {
             this->unk_392--;
@@ -904,7 +905,7 @@ void EnSw_Update(Actor* thisx, PlayState* play) {
     SkelAnime_Update(&this->skelAnime);
     EnSw_CheckDamage(this, play);  // was func_80B0C9F0 [LLM:HIGH]
     this->actionFunc(this, play);
-    func_80B0CBE8(this, play);
+    EnSw_UpdateCollision(this, play);  // was func_80B0CBE8 [LLM:HIGH]
 }
 
 s32 EnSw_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s* rot, void* thisx) {
