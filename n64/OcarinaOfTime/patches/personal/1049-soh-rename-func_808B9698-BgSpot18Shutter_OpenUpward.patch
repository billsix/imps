From 2a97aa43d029ca00d0bedc3a046da6767eabb9d9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:38:31 +0000
Subject: [PATCH 1049/3799] soh: rename func_808B9698 ->
 BgSpot18Shutter_OpenUpward

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: raises the door 180 units above home with the stone-statue sfx, ending on the stone-door stop sfx.
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c   | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c
index 3289d3954..531e3ff19 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c
@@ -20,7 +20,8 @@ void BgSpot18Shutter_DoNothing(BgSpot18Shutter* this, PlayState* play);  // was
 void BgSpot18Shutter_WaitForSwitch(BgSpot18Shutter* this, PlayState* play);  // was func_808B95B8 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808B9618: the adult idle: waits for INFTABLE_GORON_CITY_DOORS_UNLOCKED, then starts the upward slide or, for the sideways door, the sliding-aside move with its one-point cutscene.
 void BgSpot18Shutter_WaitForCityUnlock(BgSpot18Shutter* this, PlayState* play);  // was func_808B9618 [LLM:HIGH]
-void func_808B9698(BgSpot18Shutter* this, PlayState* play);
+// LLM generated name (HIGH), was func_808B9698: raises the door 180 units above home with the stone-statue sfx, ending on the stone-door stop sfx.
+void BgSpot18Shutter_OpenUpward(BgSpot18Shutter* this, PlayState* play);  // was func_808B9698 [LLM:HIGH]
 void func_808B971C(BgSpot18Shutter* this, PlayState* play);
 
 const ActorInit Bg_Spot18_Shutter_InitVars = {
@@ -92,7 +93,7 @@ void BgSpot18Shutter_WaitForSwitch(BgSpot18Shutter* this, PlayState* play) {
     if (Flags_GetSwitch(play, this->dyna.actor.params & 0x3F)) {
         Actor_SetFocus(&this->dyna.actor, 70.0f);
         OnePointCutscene_Attention(play, &this->dyna.actor);
-        this->actionFunc = func_808B9698;
+        this->actionFunc = BgSpot18Shutter_OpenUpward;  // was func_808B9698 [LLM:HIGH]
     }
 }
 
@@ -100,7 +101,7 @@ void BgSpot18Shutter_WaitForCityUnlock(BgSpot18Shutter* this, PlayState* play) {
     if (Flags_GetInfTable(INFTABLE_GORON_CITY_DOORS_UNLOCKED)) {
         Actor_SetFocus(&this->dyna.actor, 70.0f);
         if (((this->dyna.actor.params >> 8) & 1) == 0) {
-            this->actionFunc = func_808B9698;
+            this->actionFunc = BgSpot18Shutter_OpenUpward;  // was func_808B9698 [LLM:HIGH]
         } else {
             this->actionFunc = func_808B971C;
             OnePointCutscene_Init(play, 4221, 140, &this->dyna.actor, CAM_ID_MAIN);
@@ -108,7 +109,7 @@ void BgSpot18Shutter_WaitForCityUnlock(BgSpot18Shutter* this, PlayState* play) {
     }
 }
 
-void func_808B9698(BgSpot18Shutter* this, PlayState* play) {
+void BgSpot18Shutter_OpenUpward(BgSpot18Shutter* this, PlayState* play) {
     if (Math_StepToF(&this->dyna.actor.world.pos.y, this->dyna.actor.home.pos.y + 180.0f, 1.44f)) {
         Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_STONEDOOR_STOP);
         this->actionFunc = BgSpot18Shutter_DoNothing;  // was func_808B95AC [LLM:HIGH]
