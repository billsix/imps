     }
 
     if (thisx->params == 0) {
@@ -203,7 +204,7 @@ void BgHidanHrock_Fall(BgHidanHrock* this, PlayState* play) {
     }
 }
 
-void func_808896B8(BgHidanHrock* this, PlayState* play) {
+void BgHidanHrock_WaitForHit(BgHidanHrock* this, PlayState* play) {
     if (this->collider.base.acFlags & 2) {
