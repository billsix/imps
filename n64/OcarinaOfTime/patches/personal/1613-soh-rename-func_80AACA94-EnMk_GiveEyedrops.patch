From 11ffecfd3923c53ffee42795872f13a40a346edd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:30:42 +0000
Subject: [PATCH 1613/3799] soh: rename func_80AACA94 -> EnMk_GiveEyedrops

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: re-offers the eye drops until the player takes them, then starts the 240-frame trade sub-timer.
Defined in soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
index 3a5c146db..9f6501745 100644
--- a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
+++ b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
@@ -91,7 +91,8 @@ void EnMk_Talk(EnMk* this, PlayState* play) {
     this->flags |= 1;
 }
 
-void func_80AACA94(EnMk* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AACA94: re-offers the eye drops until the player takes them, then starts the 240-frame trade sub-timer.
+void EnMk_GiveEyedrops(EnMk* this, PlayState* play) {
     if (Actor_HasParent(&this->actor, play) != 0 || !GameInteractor_Should(VB_TRADE_FROG, true, this)) {
         this->actor.parent = NULL;
         if (GameInteractor_Should(VB_TRADE_TIMER_EYEDROPS, true, this)) {
@@ -107,7 +108,7 @@ void func_80AACA94(EnMk* this, PlayState* play) {
 // LLM generated name (HIGH), was func_80AACB14: once the line closes it offers GI_EYEDROPS.
 void EnMk_OfferEyedrops(EnMk* this, PlayState* play) {
     if (Actor_TextboxIsClosing(&this->actor, play)) {
-        this->actionFunc = func_80AACA94;
+        this->actionFunc = EnMk_GiveEyedrops;  // was func_80AACA94 [LLM:HIGH]
         if (GameInteractor_Should(VB_TRADE_FROG, true, this)) {
             Actor_OfferGetItem(&this->actor, play, GI_EYEDROPS, 10000.0f, 50.0f);
         }
