 void DebugCamera_CopyText(u8 x, u8 y, u8 colorId, const char* text);  // was func_8006376C [LLM:HIGH]
 // ? DebugCamera_DrawText(?);, was func_80063828 [LLM:HIGH]
-void func_8006390C(Input* input);
+void Debug_EditRegs(Input* input);  // was func_8006390C [LLM:HIGH]
 // ? func_80063C04(?);
 void func_80063D7C(GraphicsContext* gfxCtx);
 void DebugDisplay_Init(void);
diff --git a/soh/src/code/game.c b/soh/src/code/game.c
index 5133742ec..a9098381e 100644
--- a/soh/src/code/game.c
+++ b/soh/src/code/game.c
@@ -109,7 +109,7 @@ void GameState_UpdateDebugRegisters(GameState* gameState) {
     }
 
     if (CVarGetInteger(CVAR_DEVELOPER_TOOLS("RegEditEnabled"), 0) || gIsCtrlr2Valid) {
-        func_8006390C(&gameState->input[1]);
+        Debug_EditRegs(&gameState->input[1]);  // was func_8006390C [LLM:HIGH]
     }
 
     gDmaMgrVerbose = HREG(60);
diff --git a/soh/src/code/z_debug.c b/soh/src/code/z_debug.c
index 2c20e9013..7b8a45071 100644
--- a/soh/src/code/z_debug.c
+++ b/soh/src/code/z_debug.c
@@ -129,7 +129,8 @@ void DebugCamera_DrawText(GfxPrint* printer) {
 }
 
 // Edit REG
