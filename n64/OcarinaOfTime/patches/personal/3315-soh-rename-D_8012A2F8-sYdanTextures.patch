From 9284648308b7ea9524ff3d285f8fbe67f3f81270 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:27 +0000
Subject: [PATCH 3315/3799] soh: rename D_8012A2F8 -> sYdanTextures

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the day and night entrance textures Scene_DrawConfigYdan binds
Defined in soh/src/code/z_scene_table.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_scene_table.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_scene_table.c b/soh/src/code/z_scene_table.c
index 5a865b92e..c05359c94 100644
--- a/soh/src/code/z_scene_table.c
+++ b/soh/src/code/z_scene_table.c
@@ -118,7 +118,8 @@ void Scene_DrawConfigDefault(PlayState* play) {
     CLOSE_DISPS(play->state.gfxCtx);
 }
 
-void* D_8012A2F8[] = {
+// LLM generated name (HIGH), was D_8012A2F8: the day and night entrance textures Scene_DrawConfigYdan binds
+void* sYdanTextures[] = {  // was D_8012A2F8 [LLM:HIGH]
     gYdanTex_00BA18,
     gYdanTex_00CA18,
 };
@@ -142,7 +143,7 @@ void Scene_DrawConfigYdan(PlayState* play) {
     if (ResourceMgr_IsGameMasterQuest()) {
         gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_8012A2F8_MQ[gSaveContext.nightFlag]));
     } else {
-        gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_8012A2F8[gSaveContext.nightFlag]));
+        gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(sYdanTextures[gSaveContext.nightFlag]));  // was D_8012A2F8 [LLM:HIGH]
     }
 
     CLOSE_DISPS(play->state.gfxCtx);
-- 
