From b716149abded1120eb835dcbeaae1e024d7ea529 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:52:27 +0000
Subject: [PATCH 1141/3799] soh: rename func_808C0C98 -> BgZg_IsSwitchSet

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns Flags_GetSwitch for the switch index held in the high byte of params.
Defined in soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
index 73be2994b..5fda6a9f3 100644
--- a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
+++ b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
@@ -17,7 +17,8 @@ void BgZg_Draw(Actor* thisx, PlayState* play);
 
 // LLM generated name (HIGH), was func_808C0C50: plays NA_SE_EV_METALDOOR_OPEN at the actor's position; called once when the bars start rising.
 void BgZg_PlayOpenSfx(BgZg* this);  // was func_808C0C50 [LLM:HIGH]
-s32 func_808C0C98(BgZg* this, PlayState* play);
+// LLM generated name (HIGH), was func_808C0C98: returns Flags_GetSwitch for the switch index held in the high byte of params.
+s32 BgZg_IsSwitchSet(BgZg* this, PlayState* play);  // was func_808C0C98 [LLM:HIGH]
 s32 func_808C0CC8(BgZg* this);
 void func_808C0CD4(BgZg* this, PlayState* play);
 void func_808C0D08(BgZg* this, PlayState* play);
@@ -60,7 +61,7 @@ void BgZg_PlayOpenSfx(BgZg* this) {
                          &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
 }
 
-s32 func_808C0C98(BgZg* this, PlayState* play) {
+s32 BgZg_IsSwitchSet(BgZg* this, PlayState* play) {
     s32 flag = (this->dyna.actor.params >> 8) & 0xFF;
 
     return Flags_GetSwitch(play, flag);
@@ -73,7 +74,7 @@ s32 func_808C0CC8(BgZg* this) {
 }
 
 void func_808C0CD4(BgZg* this, PlayState* play) {
-    if (func_808C0C98(this, play) != 0) {
+    if (BgZg_IsSwitchSet(this, play) != 0) {  // was func_808C0C98 [LLM:HIGH]
         this->action = 1;
         BgZg_PlayOpenSfx(this);  // was func_808C0C50 [LLM:HIGH]
     }
@@ -116,7 +117,7 @@ void BgZg_Init(Actor* thisx, PlayState* play) {
 
     this->action = 0;
     this->drawConfig = 0;
-    if (func_808C0C98(this, play)) {
+    if (BgZg_IsSwitchSet(this, play)) {  // was func_808C0C98 [LLM:HIGH]
         Actor_Kill(&this->dyna.actor);
     }
 }
