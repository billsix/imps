Subject: [PATCH 1447/3799] soh: rename func_809783D4 -> DemoGeff_WaitForObject

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sActionFuncs[0]: waits for this params variant's object bank to load, then records its index and runs the init function.
Defined in soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c b/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
index 86550c7e2..ba264be07 100644
--- a/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
+++ b/soh/src/overlays/actors/ovl_Demo_Geff/z_demo_geff.c
@@ -18,7 +18,8 @@ void DemoGeff_Draw(Actor* thisx, PlayState* play);
 // LLM generated name (HIGH), was func_80978030: the only entry in sInitFuncs: advances the actor to action 1 and draw config 1 and gives it the per-params rubble scale, all three axes tunable through kREG.
 void DemoGeff_SetupRubble(DemoGeff* this, PlayState* play);  // was func_80978030 [LLM:HIGH]
 
-void func_809783D4(DemoGeff* this, PlayState* play);
+// LLM generated name (HIGH), was func_809783D4: sActionFuncs[0]: waits for this params variant's object bank to load, then records its index and runs the init function.
+void DemoGeff_WaitForObject(DemoGeff* this, PlayState* play);  // was func_809783D4 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80978308: sActionFuncs[1]: finds and follows the Demo_Gt and refreshes the rubble scale every frame.
 void DemoGeff_Active(DemoGeff* this, PlayState* play);  // was func_80978308 [LLM:HIGH]
 
@@ -36,7 +37,7 @@ static DemoGeffInitFunc sInitFuncs[] = {
 };
 
 static DemoGeffActionFunc sActionFuncs[] = {
-    func_809783D4,
+    DemoGeff_WaitForObject,  // was func_809783D4 [LLM:HIGH]
     DemoGeff_Active,  // was func_80978308 [LLM:HIGH]
 };
 
@@ -189,7 +190,7 @@ void DemoGeff_RunInitFunc(DemoGeff* this, PlayState* play) {
     initFunc(this, play);
 }
 
-void func_809783D4(DemoGeff* this, PlayState* play) {
+void DemoGeff_WaitForObject(DemoGeff* this, PlayState* play) {
     ObjectContext* objCtx = &play->objectCtx;
     Actor* thisx = &this->actor;
     s32 params = thisx->params;
