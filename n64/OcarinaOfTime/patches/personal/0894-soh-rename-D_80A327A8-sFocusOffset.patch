From fc50b6b26c6781f467626c2405ef0ab0acab3909 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:19:10 +0000
Subject: [PATCH 0894/3799] soh: rename D_80A327A8 -> sFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Vec3f { 600, 700, 0 } fed to Matrix_MultVec3f to place actor.focus.pos during limb drawing.
Defined in soh/src/overlays/actors/ovl_En_Ge1/z_en_ge1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ge1/z_en_ge1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ge1/z_en_ge1.c b/soh/src/overlays/actors/ovl_En_Ge1/z_en_ge1.c
index 8579d7390..23b997563 100644
--- a/soh/src/overlays/actors/ovl_En_Ge1/z_en_ge1.c
+++ b/soh/src/overlays/actors/ovl_En_Ge1/z_en_ge1.c
@@ -83,7 +83,8 @@ static Gfx* sHairstyleDLists[] = {
     gGerudoWhiteHairstyleSpikyDL,
 };
 
-static Vec3f D_80A327A8 = { 600.0f, 700.0f, 0.0f };
+// LLM generated name (HIGH), was D_80A327A8: Vec3f { 600, 700, 0 } fed to Matrix_MultVec3f to place actor.focus.pos during limb drawing.
+static Vec3f sFocusOffset = { 600.0f, 700.0f, 0.0f };  // was D_80A327A8 [LLM:HIGH]
 
 static void* sEyeTextures[] = {
     gGerudoWhiteEyeOpenTex,
@@ -812,7 +813,7 @@ void EnGe1_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
 
     if (limbIndex == GE1_LIMB_HEAD) {
         gSPDisplayList(POLY_OPA_DISP++, sHairstyleDLists[this->hairstyle]);
-        Matrix_MultVec3f(&D_80A327A8, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sFocusOffset, &this->actor.focus.pos);  // was D_80A327A8 [LLM:HIGH]
     }
 
     CLOSE_DISPS(play->state.gfxCtx);
-- 
