From d7e47843bc2bf34c6adc1732a1bdb396ce725939 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:31:18 +0000
Subject: [PATCH 1627/3799] soh: rename func_80AD6330 ->
 EnPoField_UpdateSoulColor

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: fades the soul's colour and alpha up over the first frames of the appear animation and flickers it randomly afterwards.
Defined in soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
index 0f58d7a2b..3cbf69aef 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
@@ -857,7 +857,8 @@ void EnPoField_UpdateLightColor(EnPoField* this) {
     }
 }
 
-void func_80AD6330(EnPoField* this) {
+// LLM generated name (HIGH), was func_80AD6330: fades the soul's colour and alpha up over the first frames of the appear animation and flickers it randomly afterwards.
+void EnPoField_UpdateSoulColor(EnPoField* this) {
     f32 rand;
 
     if (this->actionFunc == EnPoField_Appear && this->skelAnime.curFrame < 12.0f) {
@@ -887,7 +888,7 @@ void EnPoField_Update(Actor* thisx, PlayState* play) {
         Actor_SetFocus(&this->actor, 42.0f);
         Actor_UpdateBgCheckInfo(play, &this->actor, 0.0f, 27.0f, 60.0f, 4);
         EnPoField_UpdateLightColor(this);  // was func_80AD619C [LLM:HIGH]
-        func_80AD6330(this);
+        EnPoField_UpdateSoulColor(this);  // was func_80AD6330 [LLM:HIGH]
         Collider_UpdateCylinder(&this->actor, &this->collider);
         CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
         if (this->collider.base.acFlags & AC_ON) {
@@ -983,7 +984,7 @@ void EnPoField_UpdateDead(Actor* thisx, PlayState* play) {
 
     this->actionFunc(this, play);
     if (this->actionFunc == EnPoField_SoulIdle) {
-        func_80AD6330(this);
+        EnPoField_UpdateSoulColor(this);  // was func_80AD6330 [LLM:HIGH]
     }
     EnPoField_UpdateFlame(this, play);
 }
