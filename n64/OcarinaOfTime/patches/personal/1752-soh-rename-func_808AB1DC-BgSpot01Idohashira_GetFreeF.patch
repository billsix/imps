Date: Mon, 7 Sep 2026 22:40:42 +0000
Subject: [PATCH 1752/3799] soh: rename func_808AB1DC ->
 BgSpot01Idohashira_GetFreeFallY

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the osSyncPrintf in its divide-by-zero guard names it "Bg_Spot01_Idohashira_Get_FreeFall"; it returns the height along a parabola between the start and end heights for the given frame.
Defined in soh/src/overlays/actors/ovl_Bg_Spot01_Idohashira/z_bg_spot01_idohashira.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot01_Idohashira/z_bg_spot01_idohashira.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot01_Idohashira/z_bg_spot01_idohashira.c b/soh/src/overlays/actors/ovl_Bg_Spot01_Idohashira/z_bg_spot01_idohashira.c
index bf468f57d..3689748b7 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot01_Idohashira/z_bg_spot01_idohashira.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot01_Idohashira/z_bg_spot01_idohashira.c
@@ -172,7 +172,8 @@ void BgSpot01Idohashira_Tumble(BgSpot01Idohashira* this) {
     this->dyna.actor.shape.rot.z += (s16)(kREG(8) + 0x7D0);
 }
 
-f32 func_808AB1DC(f32 arg0, f32 arg1, u16 arg2, u16 arg3, u16 arg4) {
+// LLM generated name (HIGH), was func_808AB1DC: the osSyncPrintf in its divide-by-zero guard names it "Bg_Spot01_Idohashira_Get_FreeFall"; it returns the height along a parabola between the start and end heights for the given frame.
+f32 BgSpot01Idohashira_GetFreeFallY(f32 arg0, f32 arg1, u16 arg2, u16 arg3, u16 arg4) {
     f32 temp_f12;
     f32 regFloat;
     f32 diff23;
@@ -210,7 +211,7 @@ s32 func_808AB29C(BgSpot01Idohashira* this, PlayState* play) {
         thisPos = &this->dyna.actor.world.pos;
         thisPos->x = ((endX - initPos.x) * temp_f0) + initPos.x;
         thisPos->y =
-            func_808AB1DC(initPos.y, tempY, npcAction->endFrame, npcAction->startFrame, play->csCtx.frames) + initPos.y;
+            BgSpot01Idohashira_GetFreeFallY(initPos.y, tempY, npcAction->endFrame, npcAction->startFrame, play->csCtx.frames) + initPos.y;  // was func_808AB1DC [LLM:HIGH]
         thisPos->z = ((endZ - initPos.z) * temp_f0) + initPos.z;
 
         if (temp_f0 >= 1.0f) {
