From 6c229070884ce0fe01e3d910e6d58837d8a08c6b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:58 +0000
Subject: [PATCH 2518/3799] soh: rename D_801305B4 -> sFixedReverb

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the constant reverb that goes with it
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index ef1caa007..39b601d52 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -117,7 +117,8 @@ u8 gUsedChannelsPerBank[4][7] = {
 
 // LLM generated name (HIGH), was D_801305B0: the constant frequency scale Audio_PlaySfxWithFixedScales passes
 f32 sFixedFreqScale = 0.7950898f;  // was D_801305B0 [LLM:HIGH]
-s8 D_801305B4 = 35;
+// LLM generated name (HIGH), was D_801305B4: the constant reverb that goes with it
+s8 sFixedReverb = 35;  // was D_801305B4 [LLM:HIGH]
 s8 D_801305B8 = 20;
 s8 D_801305BC = 30;
 s8 D_801305C0 = 20;
@@ -1320,7 +1321,7 @@ s32 sAudioUpdateTaskEnd;      // decomp: debug only
     F(sOcaMemoryGameAppendPos)                         \
     F(sOcaMemoryGameEndPos)                            \
     F(sFixedFreqScale)                                      \
-    F(D_801305B4)                                      \
+    F(sFixedReverb)                                      \
     F(D_801305B8)                                      \
     F(D_801305BC)                                      \
     F(D_801305C0)                                      \
@@ -4434,7 +4435,7 @@ void Audio_PlaySfxWithSpeedScales(Vec3f* pos, u16 sfxId, f32 arg2) {
 
 // LLM generated name (HIGH), was func_800F4190: plays a sound with the file's constant frequency scale and reverb
 void Audio_PlaySfxWithFixedScales(Vec3f* pos, u16 sfxId) {
-    Audio_PlaySfxGeneral(sfxId, pos, 4, &sFixedFreqScale, &gSfxDefaultFreqAndVolScale, &D_801305B4);  // was D_801305B0 [LLM:HIGH]
+    Audio_PlaySfxGeneral(sfxId, pos, 4, &sFixedFreqScale, &gSfxDefaultFreqAndVolScale, &sFixedReverb);  // was D_801305B0 [LLM:HIGH]
 }
 void Audio_PlaySoundRandom(Vec3f* pos, u16 baseSfxId, u8 randLim) {
     u8 offset = Audio_NextRandom() % randLim;
-- 
