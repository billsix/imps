From 4bc0cd8556075c53e5dfb39a13006299d7211f8a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:13 +0000
Subject: [PATCH 3456/3799] soh: rename D_8015BBEC -> sNearestTargetActorAlt

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the fallback candidate used when the search finds no preferred one
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 6d8fec8e0..e72fb077c 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -3580,7 +3580,8 @@ s32 Attention_ActorOnScreen(PlayState* play, Actor* actor) {
 
 // LLM generated name (HIGH), was D_8015BBE8: the best Z-target candidate found so far in the search
 Actor* sNearestTargetActor;  // was D_8015BBE8 [LLM:HIGH]
-Actor* D_8015BBEC;
+// LLM generated name (HIGH), was D_8015BBEC: the fallback candidate used when the search finds no preferred one
+Actor* sNearestTargetActorAlt;  // was D_8015BBEC [LLM:HIGH]
 // LLM generated name (HIGH), was D_8015BBF0: the best weighted distance found so far while searching for a Z-target
 f32 sNearestTargetDistSq;  // was D_8015BBF0 [LLM:HIGH]
 f32 sbgmEnemyDistSq;
@@ -3625,7 +3626,7 @@ void Attention_FindActorInCategory(PlayState* play, ActorContext* actorCtx, Play
                      SurfaceType_IsIgnoredByProjectiles(&play->colCtx, sp80, sp7C))) {
                     if (actor->targetPriority != 0) {
                         if (actor->targetPriority < sBestTargetPriority) {  // was D_8015BBF8 [LLM:HIGH]
-                            D_8015BBEC = actor;
+                            sNearestTargetActorAlt = actor;  // was D_8015BBEC [LLM:HIGH]
                             sBestTargetPriority = actor->targetPriority;  // was D_8015BBF8 [LLM:HIGH]
                         }
                     } else {
@@ -3650,7 +3651,7 @@ Actor* Attention_FindActor(PlayState* play, ActorContext* actorCtx, Actor** acto
     s32 i;
     u8* entry;
 
-    sNearestTargetActor = D_8015BBEC = NULL;  // was D_8015BBE8 [LLM:HIGH]
+    sNearestTargetActor = sNearestTargetActorAlt = NULL;  // was D_8015BBE8 [LLM:HIGH]
     sNearestTargetDistSq = sbgmEnemyDistSq = FLT_MAX;  // was D_8015BBF0 [LLM:HIGH]
     sBestTargetPriority = 0x7FFFFFFF;  // was D_8015BBF8 [LLM:HIGH]
 
@@ -3674,7 +3675,7 @@ Actor* Attention_FindActor(PlayState* play, ActorContext* actorCtx, Actor** acto
     }
 
     if (sNearestTargetActor == 0) {  // was D_8015BBE8 [LLM:HIGH]
-        *actorPtr = D_8015BBEC;
+        *actorPtr = sNearestTargetActorAlt;  // was D_8015BBEC [LLM:HIGH]
     } else {
         *actorPtr = sNearestTargetActor;  // was D_8015BBE8 [LLM:HIGH]
     }
