     gSPSegment(POLY_OPA_DISP++, 0x0D, MATRIX_NEWMTX(play->state.gfxCtx));
@@ -1705,13 +1707,13 @@ void Scene_DrawConfigInsideGanonsCastle(PlayState* play) {
 // Scene Draw Config 52
 // Name from zeldaret/oot (was func_800A055C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_scene_table.c]
 void Scene_DrawConfigInsideGanonsCastleCollapse(PlayState* play) {
-    func_8009BEEC(play);
+    Scene_AddGanonsTowerCollapseQuake(play);  // was func_8009BEEC [LLM:HIGH]
