     { 40, 80, 0, { 2259, 108, -1580 } },
 };
 
-static Vec3f D_808B272C = { 2259.0f, 108.0f, -1550.0f };
+// LLM generated name (HIGH), was D_808B272C: offset summed with world.pos to place fragment/dust effect spawns.
+static Vec3f sEffectSpawnOffset = { 2259.0f, 108.0f, -1550.0f };
 static Vec3f D_808B2738 = { 2259.0f, 108.0f, -1550.0f };
 
