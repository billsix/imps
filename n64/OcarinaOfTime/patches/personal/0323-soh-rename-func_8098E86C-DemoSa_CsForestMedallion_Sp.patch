     DemoSa_SetMouthIndex(this, SARIA_MOUTH_CLOSED2);
 }
 
-void func_8098E86C(DemoSa* this, PlayState* play) {
+// Name from zeldaret/oot (was func_8098E86C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_CsForestMedallion_SpawnDoorWarp(DemoSa* this, PlayState* play) {
     Vec3f* world = &this->actor.world.pos;
     f32 posX = world->x;
     f32 posY = world->y;
@@ -275,7 +276,7 @@ void func_8098E9EC(DemoSa* this, PlayState* play) {
         if ((npcAction != NULL) && (npcAction->action == 2)) {
             this->action = 2;
             this->drawConfig = 1;
-            func_8098E86C(this, play);
+            DemoSa_CsForestMedallion_SpawnDoorWarp(this, play);
         }
     }
 }
