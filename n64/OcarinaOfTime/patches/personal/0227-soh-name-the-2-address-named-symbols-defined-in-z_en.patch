+        Collider_SetCylinder(play, &this->colCyl1, &this->actor, &sAttackCylinderInit);  // was D_80A4B7A0 [LLM:HIGH]
         Collider_InitCylinder(play, &this->colCyl2);
-        Collider_SetCylinder(play, &this->colCyl2, &this->actor, &D_80A4B7CC);
+        Collider_SetCylinder(play, &this->colCyl2, &this->actor, &sHurtCylinderInit);  // was D_80A4B7CC [LLM:HIGH]
     }
 }
 
@@ -914,4 +916,4 @@ void EnGoma_BossLimb(EnGoma* this, PlayState* play) {
 
 void EnGoma_Reset(void) {
     sSpawnNum = 0;
-}
