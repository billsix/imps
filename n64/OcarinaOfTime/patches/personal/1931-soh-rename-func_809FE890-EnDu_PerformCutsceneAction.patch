-        EnDu_SetupAction(this, func_809FE890);
+        EnDu_SetupAction(this, EnDu_PerformCutsceneAction);  // was func_809FE890 [LLM:HIGH]
         play->msgCtx.ocarinaMode = OCARINA_MODE_04;
     } else if (play->msgCtx.ocarinaMode == OCARINA_MODE_03) {
         Audio_PlaySfxGeneral(NA_SE_SY_CORRECT_CHIME, &gSfxDefaultPos, 4, &gSfxDefaultFreqAndVolScale,
@@ -407,7 +408,7 @@ void EnDu_CheckOcarinaSong(EnDu* this, PlayState* play) {
             gSaveContext.cutsceneTrigger = 1;
         }
         this->unk_1E8 = 0;
-        EnDu_SetupAction(this, func_809FE890);
+        EnDu_SetupAction(this, EnDu_PerformCutsceneAction);  // was func_809FE890 [LLM:HIGH]
         play->msgCtx.ocarinaMode = OCARINA_MODE_04;
     } else {
         player->stateFlags2 |= PLAYER_STATE2_NEAR_OCARINA_ACTOR;
@@ -484,7 +485,7 @@ void EnDu_FireTempleDepart(EnDu* this, PlayState* play) {
     }
 }
 
-void func_809FE890(EnDu* this, PlayState* play) {
+void EnDu_PerformCutsceneAction(EnDu* this, PlayState* play) {
     f32 frame;
     Vec3f startPos;
     Vec3f endPos;
@@ -625,7 +626,7 @@ void EnDu_Update(Actor* thisx, PlayState* play) {
