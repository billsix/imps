         if (Rand_ZeroOne() < 0.26f) {
             func_80033480(play, &pos, 200.0f, 1, sThroneDebrisScales[j & 7] * 4 + 60, sThroneDebrisScales[j & 7] * 4 + 80, 1);  // was D_80899510 [LLM:HIGH]
         }
