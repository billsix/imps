From 61a0ae32b914872adbdb1e9eacaa26a6e824294c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:43 +0000
Subject: [PATCH 426/784] soh: rename func_80AEBB3C -> EnRu1_PlayResurfacingSfx

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index bce07ff4e..0f0b80bf9 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -583,7 +583,8 @@ void EnRu1_PlayDivingEntrySfx(EnRu1* this) {
     }
 }
 
-void func_80AEBB3C(EnRu1* this) {
+// Name from zeldaret/oot (was func_80AEBB3C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_PlayResurfacingSfx(EnRu1* this) {
     if (Animation_OnFrame(&this->skelAnime, 5.0f)) {
         Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_PL_FACE_UP);
     }
@@ -730,7 +731,7 @@ void func_80AEC130(EnRu1* this, PlayState* play) {
     s32 something = EnRu1_UpdateSkelAnime(this);
 
     EnRu1_UpdateBgCheckInfo(this, play);
-    func_80AEBB3C(this);
+    EnRu1_PlayResurfacingSfx(this);
     func_80AEBE3C(this, play, something);
 }
 
