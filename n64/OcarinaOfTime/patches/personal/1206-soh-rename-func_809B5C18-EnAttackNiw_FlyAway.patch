         Math_Vec3f_Copy(&sp30, &this->actor.world.pos);
         sp30.y += this->actor.yDistToWater;
         EffectSsGSplash_Spawn(play, &sp30, 0, 0, 0, 0x190);
@@ -358,7 +359,7 @@ void EnAttackNiw_Update(Actor* thisx, PlayState* play) {
         this->actor.gravity = 0.0f;
         this->unk_2E0 = 0.0f;
         this->unk_2D0 = this->actor.world.rot.x - 5000.0f;
-        this->actionFunc = func_809B5C18;
+        this->actionFunc = EnAttackNiw_FlyAway;  // was func_809B5C18 [LLM:HIGH]
         return;
     }
 
