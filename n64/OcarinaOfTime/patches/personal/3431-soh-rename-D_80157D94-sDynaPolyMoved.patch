From 97679af6a06f01d5ee72950254ba7ff2cdde1dd6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:10 +0000
Subject: [PATCH 3431/3799] soh: rename D_80157D94 -> sDynaPolyMoved

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: whether any dynapoly actor moved on that frame
Defined in soh/src/code/z_en_item00.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_en_item00.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_en_item00.c b/soh/src/code/z_en_item00.c
index 260b6dc9b..34f9c0414 100644
--- a/soh/src/code/z_en_item00.c
+++ b/soh/src/code/z_en_item00.c
@@ -760,7 +760,7 @@ void EnItem00_Collected(EnItem00* this, PlayState* play) {
 // The BSS in the function acted weird in the past. It is matching now but might cause issues in the future
 void EnItem00_Update(Actor* thisx, PlayState* play) {
     static u32 sDynaPolyCheckFrame;  // was D_80157D90 [LLM:HIGH]
-    static s16 D_80157D94[1];
+    static s16 sDynaPolyMoved[1];  // was D_80157D94 [LLM:HIGH]
     s16* params;
     Actor* dynaActor;
     s32 getItemId = GI_NONE;
@@ -803,7 +803,7 @@ void EnItem00_Update(Actor* thisx, PlayState* play) {
         if (this->actor.bgCheckFlags & 0x0003) {
             if (*temp != play->gameplayFrames) {
                 sDynaPolyCheckFrame = play->gameplayFrames;  // was D_80157D90 [LLM:HIGH]
-                D_80157D94[0] = 0;
+                sDynaPolyMoved[0] = 0;  // was D_80157D94 [LLM:HIGH]
                 for (i = 0; i < 50; i++) {
                     if (play->colCtx.dyna.bgActorFlags[i] & 1) {
                         dynaActor = play->colCtx.dyna.bgActors[i].actor;
@@ -811,7 +811,7 @@ void EnItem00_Update(Actor* thisx, PlayState* play) {
                             if ((dynaActor->world.pos.x != dynaActor->prevPos.x) ||
                                 (dynaActor->world.pos.y != dynaActor->prevPos.y) ||
                                 (dynaActor->world.pos.z != dynaActor->prevPos.z)) {
-                                D_80157D94[0]++;
+                                sDynaPolyMoved[0]++;  // was D_80157D94 [LLM:HIGH]
                                 break;
                             }
                         }
@@ -824,7 +824,7 @@ void EnItem00_Update(Actor* thisx, PlayState* play) {
             Actor_MoveXZGravity(&this->actor);
         }
 
-        if (sp3A || D_80157D94[0]) {
+        if (sp3A || sDynaPolyMoved[0]) {  // was D_80157D94 [LLM:HIGH]
             Actor_UpdateBgCheckInfo(play, &this->actor, 10.0f, 15.0f, 15.0f, 0x1D);
 
             if (GameInteractor_Should(VB_ITEM00_KILL, this->actor.floorHeight <= -10000.0f, this)) {
