From 7d350112f2f16f093d20c7658d223d7b0171eddd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:17 +0000
Subject: [PATCH 1805/3799] soh: rename D_8012AE30 -> sSkyVtxVCap

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the V coordinates for the top and bottom faces, which fold back on themselves so the texture meets at the pole.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 7a596835d..701fa2778 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -130,7 +130,8 @@ s16 sSkyVtxV[5] = {  // was D_8012AE24 [LLM:HIGH]
     0x0000, 0x07C0, 0x0F80, 0x1740, 0x1F00,
 };
 
-s16 D_8012AE30[5] = {
+// LLM generated name (HIGH), was D_8012AE30: the V coordinates for the top and bottom faces, which fold back on themselves so the texture meets at the pole.
+s16 sSkyVtxVCap[5] = {  // was D_8012AE30 [LLM:HIGH]
     0x0000, 0x07C0, 0x0F80, 0x07C0, 0x0000,
 };
 
@@ -305,7 +306,7 @@ s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp2B4[k] = temp2;
                     sp250[k] = temp1;
                     sp188[k] = sSkyVtxU[j];  // was D_8012AE18 [LLM:HIGH]
-                    sp124[k] = D_8012AE30[i];
+                    sp124[k] = sSkyVtxVCap[i];  // was D_8012AE30 [LLM:HIGH]
                     temp2 += arg6;
                 }
                 temp1 += arg7;
@@ -323,7 +324,7 @@ s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp250[k] = temp1;
                     sp1EC[k] = temp2;
                     sp188[k] = sSkyVtxU[j];  // was D_8012AE18 [LLM:HIGH]
-                    sp124[k] = D_8012AE30[i];
+                    sp124[k] = sSkyVtxVCap[i];  // was D_8012AE30 [LLM:HIGH]
                     temp2 += arg6;
                 }
                 temp1 += arg7;
-- 
