Date: Mon, 7 Sep 2026 23:21:14 +0000
Subject: [PATCH 2271/3799] soh: rename func_80AB1390 -> EnNb_IsCueAction

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: true when the given cue channel is live and sitting on the caller's action id
Defined in soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c b/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
index cfed20a76..1420f7124 100644
--- a/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
+++ b/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
@@ -256,7 +256,8 @@ void EnNb_SetupCsPosRot(EnNb* this, PlayState* play, s32 npcActionIdx) {
     }
 }
 
-s32 func_80AB1390(EnNb* this, PlayState* play, u16 arg2, s32 npcActionIdx) {
+// LLM generated name (HIGH), was func_80AB1390: true when the given cue channel is live and sitting on the caller's action id
+s32 EnNb_IsCueAction(EnNb* this, PlayState* play, u16 arg2, s32 npcActionIdx) {
     CsCmdActorCue* csCmdNPCAction;
 
     if ((play->csCtx.state != CS_STATE_IDLE) &&
@@ -472,7 +473,7 @@ void EnNb_InitializeDemo6K(EnNb* this, PlayState* play) {
 }
 
 void EnNb_SetupHide(EnNb* this, PlayState* play) {
-    if (func_80AB1390(this, play, 4, 1)) {
+    if (EnNb_IsCueAction(this, play, 4, 1)) {  // was func_80AB1390 [LLM:HIGH]
         this->action = NB_SEAL_HIDE;
         this->drawMode = NB_DRAW_HIDE;
         this->alpha = 0;
@@ -486,7 +487,7 @@ void EnNb_CheckToFade(EnNb* this, PlayState* play) {
     f32* alphaTimer = &this->alphaTimer;
     s32 alpha;
 
-    if (func_80AB1390(this, play, 4, 1)) {
+    if (EnNb_IsCueAction(this, play, 4, 1)) {  // was func_80AB1390 [LLM:HIGH]
         *alphaTimer += 1.0f;
         if (*alphaTimer >= kREG(5) + 10.0f) {
             this->action = NB_ACTION_9;
