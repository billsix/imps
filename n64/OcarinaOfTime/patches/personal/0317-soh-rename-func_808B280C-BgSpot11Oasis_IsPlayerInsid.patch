--- a/soh/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c
@@ -56,7 +56,8 @@ void BgSpot11Oasis_SetWaterLevel(PlayState* play, s16 waterSurface) {
     waterBox->ySurface = waterSurface;
 }
 
-s32 func_808B280C(PlayState* play) {
+// Name from zeldaret/oot (was func_808B280C): adopted upstream's name for this address; body verified to match upstream at 0.81. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c]
+s32 BgSpot11Oasis_IsPlayerInsideOasis(PlayState* play) {
     Player* player = GET_PLAYER(play);
     Vec3f sp58;
     Vec3f sp4C;
@@ -96,7 +97,7 @@ void func_808B2970(BgSpot11Oasis* this) {
 }
 
 void func_808B2980(BgSpot11Oasis* this, PlayState* play) {
-    if (Flags_GetEnv(play, 5) && func_808B280C(play)) {
+    if (Flags_GetEnv(play, 5) && BgSpot11Oasis_IsPlayerInsideOasis(play)) {
         OnePointCutscene_Init(play, 4150, -99, &this->actor, CAM_ID_MAIN);
         func_808B29E0(this);
     }
