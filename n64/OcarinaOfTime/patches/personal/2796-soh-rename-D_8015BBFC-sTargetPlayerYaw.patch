From 5a64eed33c6f7913d19265a76509e7d3bc1483f7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:38 +0000
Subject: [PATCH 2796/3799] soh: rename D_8015BBFC -> sTargetPlayerYaw

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the player's yaw the search weights candidate directions against
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 603b1fdbb..edb0d8a47 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -3584,7 +3584,8 @@ f32 sNearestTargetDistSq;  // was D_8015BBF0 [LLM:HIGH]
 f32 sbgmEnemyDistSq;
 // LLM generated name (HIGH), was D_8015BBF8: the best targetPriority found so far in that same search
 s32 sBestTargetPriority;  // was D_8015BBF8 [LLM:HIGH]
-s16 D_8015BBFC;
+// LLM generated name (HIGH), was D_8015BBFC: the player's yaw the search weights candidate directions against
+s16 sTargetPlayerYaw;  // was D_8015BBFC [LLM:HIGH]
 
 void Attention_FindActorInCategory(PlayState* play, ActorContext* actorCtx, Player* player, u32 actorCategory) {
     f32 var;
@@ -3614,7 +3615,7 @@ void Attention_FindActorInCategory(PlayState* play, ActorContext* actorCtx, Play
             }
 
             if (actor != sp84) {
-                var = Attention_WeightedDistToPlayerSq(actor, player, D_8015BBFC);
+                var = Attention_WeightedDistToPlayerSq(actor, player, sTargetPlayerYaw);  // was D_8015BBFC [LLM:HIGH]
                 if ((var < sNearestTargetDistSq) && Attention_ActorIsInRange(actor, var) &&  // was D_8015BBF0 [LLM:HIGH]
                     Attention_ActorOnScreen(play, actor) &&
                     (!BgCheck_CameraLineTest1(&play->colCtx, &player->actor.focus.pos, &actor->focus.pos, &sp70, &sp80,
@@ -3654,7 +3655,7 @@ Actor* Attention_FindActor(PlayState* play, ActorContext* actorCtx, Actor** acto
         entry = &D_801160A0[0];
 
         actorCtx->targetCtx.bgmEnemy = NULL;
-        D_8015BBFC = player->actor.shape.rot.y;
+        sTargetPlayerYaw = player->actor.shape.rot.y;  // was D_8015BBFC [LLM:HIGH]
 
         for (i = 0; i < 3; i++) {
             Attention_FindActorInCategory(play, actorCtx, player, *entry);
