From 24726d5f6a7a3c7b55120fb23fc5dac641fbcbf2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:08:01 +0000
Subject: [PATCH 1283/3799] soh: rename func_808B314C -> BgSpot12Gate_Delay

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: holds until that pause expires, then hands off to the opening setup.
Defined in soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c b/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
index 7e9275b89..35f77f09e 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
@@ -20,7 +20,8 @@ void BgSpot12Gate_SetupWaitForSwitch(BgSpot12Gate* this);  // was func_808B30C0
 void BgSpot12Gate_WaitForSwitch(BgSpot12Gate* this, PlayState* play);  // was func_808B30D8 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808B3134: arms the 40-frame pause before the gate starts moving.
 void BgSpot12Gate_SetupDelay(BgSpot12Gate* this);  // was func_808B3134 [LLM:HIGH]
-void func_808B314C(BgSpot12Gate* this, PlayState* play);
+// LLM generated name (HIGH), was func_808B314C: holds until that pause expires, then hands off to the opening setup.
+void BgSpot12Gate_Delay(BgSpot12Gate* this, PlayState* play);  // was func_808B314C [LLM:HIGH]
 void func_808B317C(BgSpot12Gate* this);
 void func_808B318C(BgSpot12Gate* this, PlayState* play);
 void func_808B3274(BgSpot12Gate* this);
@@ -92,11 +93,11 @@ void BgSpot12Gate_WaitForSwitch(BgSpot12Gate* this, PlayState* play) {
 }
 
 void BgSpot12Gate_SetupDelay(BgSpot12Gate* this) {
-    this->actionFunc = func_808B314C;
+    this->actionFunc = BgSpot12Gate_Delay;  // was func_808B314C [LLM:HIGH]
     this->unk_168 = 40;
 }
 
-void func_808B314C(BgSpot12Gate* this, PlayState* play) {
+void BgSpot12Gate_Delay(BgSpot12Gate* this, PlayState* play) {
     if (this->unk_168 <= 0) {
         func_808B317C(this);
     }
