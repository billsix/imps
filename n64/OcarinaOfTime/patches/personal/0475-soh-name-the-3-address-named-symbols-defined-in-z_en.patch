 soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c b/soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c
index ebe5abeae..8d7fc6258 100644
--- a/soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c
+++ b/soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c
@@ -472,18 +472,18 @@ void EnArrow_Update(Actor* thisx, PlayState* play) {
 
 // LLM generated name (HIGH), was func_809B4800: transforms the fixed tip and base offsets by the current matrix and feeds them to EffectBlure_AddVertex, extending the arrow's trail; called from the draw function.
 void EnArrow_UpdateBlure(EnArrow* this, PlayState* play) {
-    static Vec3f D_809B4E88 = { 0.0f, 400.0f, 1500.0f };
-    static Vec3f D_809B4E94 = { 0.0f, -400.0f, 1500.0f };
-    static Vec3f D_809B4EA0 = { 0.0f, 0.0f, -300.0f };
+    static Vec3f sBlureVertexA = { 0.0f, 400.0f, 1500.0f };  // was D_809B4E88 [LLM:HIGH]
+    static Vec3f sBlureVertexB = { 0.0f, -400.0f, 1500.0f };  // was D_809B4E94 [LLM:HIGH]
+    static Vec3f sBlureVertexC = { 0.0f, 0.0f, -300.0f };  // was D_809B4EA0 [LLM:HIGH]
     Vec3f sp44;
     Vec3f sp38;
     s32 addBlureVertex;
 
-    Matrix_MultVec3f(&D_809B4EA0, &this->unk_21C);
+    Matrix_MultVec3f(&sBlureVertexC, &this->unk_21C);  // was D_809B4EA0 [LLM:HIGH]
 
     if (EnArrow_Fly == this->actionFunc) {
-        Matrix_MultVec3f(&D_809B4E88, &sp44);
-        Matrix_MultVec3f(&D_809B4E94, &sp38);
+        Matrix_MultVec3f(&sBlureVertexA, &sp44);  // was D_809B4E88 [LLM:HIGH]
+        Matrix_MultVec3f(&sBlureVertexB, &sp38);  // was D_809B4E94 [LLM:HIGH]
 
         if (this->actor.params <= ARROW_SEED) {
             addBlureVertex = this->actor.params <= ARROW_LIGHT;
