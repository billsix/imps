Subject: [PATCH 0589/3799] soh: rename func_80044ADC ->
 Camera_GetPitchAdjFromFloorHeightDiffs

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 0.94.
Defined in soh/src/code/z_camera.c.
---
 soh/src/code/z_camera.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 436b764d1..b49e1e8b6 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -577,7 +577,8 @@ s16 Camera_XZAngle(Vec3f* to, Vec3f* from) {
 static f32 D_8015CE50;
 static f32 D_8015CE54;
 static CamColChk D_8015CE58;
-s16 func_80044ADC(Camera* camera, s16 yaw, s16 arg2) {
+// Name from zeldaret/oot (was func_80044ADC): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.94. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_camera.c]
+s16 Camera_GetPitchAdjFromFloorHeightDiffs(Camera* camera, s16 yaw, s16 arg2) {
     Vec3f playerPos;
     Vec3f rotatedPos;
     Vec3f floorNorm;
@@ -1684,7 +1685,7 @@ s32 Camera_Normal1(Camera* camera) {
     camera->fovUpdateRate = Camera_LERPCeilF(PCT(OREG(4)), camera->yOffsetUpdateRate, camera->speedRatio * 0.05f, rate);
 
     if (norm1->interfaceFlags & 1) {
-        t = func_80044ADC(camera, BINANG_ROT180(atEyeGeo.yaw), 0);
+        t = Camera_GetPitchAdjFromFloorHeightDiffs(camera, BINANG_ROT180(atEyeGeo.yaw), 0);
         sp9C = ((1.0f / norm1->unk_10) * 0.5f) * (1.0f - camera->speedRatio);
         anim->slopePitchAdj = Camera_LERPCeilS(t, anim->slopePitchAdj, ((1.0f / norm1->unk_10) * 0.5f) + sp9C, 0xF);
     } else {
@@ -2062,7 +2063,7 @@ s32 Camera_Normal3(Camera* camera) {
     camera->yOffsetUpdateRate = Camera_LERPCeilF(PCT(OREG(3)), camera->yOffsetUpdateRate, sp94, 0.1f);
     camera->fovUpdateRate = Camera_LERPCeilF(PCT(OREG(4)), camera->fovUpdateRate, sp94, 0.1f);
 
-    t2 = func_80044ADC(camera, BINANG_ROT180(sp7C.yaw), 1);
+    t2 = Camera_GetPitchAdjFromFloorHeightDiffs(camera, BINANG_ROT180(sp7C.yaw), 1);
     sp94 = ((1.0f / norm3->unk_10) * 0.5f);
     temp_f0 = (((1.0f / norm3->unk_10) * 0.5f) * (1.0f - camera->speedRatio));
     anim->curPitch = Camera_LERPCeilS(t2, anim->curPitch, sp94 + temp_f0, 0xF);
@@ -2229,7 +2230,7 @@ s32 Camera_Parallel1(Camera* camera) {
     camera->fovUpdateRate = Camera_LERPCeilF(PCT(OREG(4)), camera->fovUpdateRate, camera->speedRatio * 0.05f, 0.1f);
 
     if (para1->interfaceFlags & 1) {
-        tangle = func_80044ADC(camera, BINANG_ROT180(atToEyeDir.yaw), 1);
+        tangle = Camera_GetPitchAdjFromFloorHeightDiffs(camera, BINANG_ROT180(atToEyeDir.yaw), 1);
 
         spB8 = ((1.0f / para1->unk_0C) * 0.3f);
         pad2 = (((1.0f / para1->unk_0C) * 0.7f) * (1.0f - camera->speedRatio));
