From 39ccb5623eafe2094b5544ca2010c4720965dc33 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:52 +0000
Subject: [PATCH 0505/3799] soh: rename func_80AFD644 -> EnSkb_SetupTakeDamage

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.90.
Defined in soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c.
---
 soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
index a0d5d3cea..23bd919ef 100644
--- a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
+++ b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
@@ -369,7 +369,8 @@ void EnSkb_Stunned(EnSkb* this, PlayState* play) {
     }
 }
 
-void func_80AFD644(EnSkb* this) {
+// Name from zeldaret/oot (was func_80AFD644): adopted upstream's name for this address; body verified to match upstream at 0.90. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Skb/z_en_skb.c]
+void EnSkb_SetupTakeDamage(EnSkb* this) {
     Animation_MorphToPlayOnce(&this->skelAnime, &gStalchildDamagedAnim, -4.0f);
     if (this->actor.bgCheckFlags & BGCHECKFLAG_GROUND) {
         this->actor.speedXZ = -4.0f;
@@ -491,7 +492,7 @@ void func_80AFD968(EnSkb* this, PlayState* play) {
                             this->breakFlags = 1;
                         }
                     }
-                    func_80AFD644(this);
+                    EnSkb_SetupTakeDamage(this);
                 }
             }
         }
