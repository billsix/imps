Subject: [PATCH 3716/3799] soh: rename func_80B56DEC ->
 EnZl3_PlayOpenDoorSfxOnFrame9

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays NA_SE_VO_Z1_OPENDOOR when the once-through animation reaches frame 9
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 49188dd60..dde190651 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -1665,7 +1665,8 @@ void EnZl3_PlayPainSfx3(EnZl3* this) {
     Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_VO_Z1_PAIN);
 }
 
-void func_80B56DEC(EnZl3* this) {
+// LLM generated name (HIGH), was func_80B56DEC: plays NA_SE_VO_Z1_OPENDOOR when the once-through animation reaches frame 9
+void EnZl3_PlayOpenDoorSfxOnFrame9(EnZl3* this) {
     SkelAnime* skelAnime = &this->skelAnime;
 
     if ((skelAnime->mode == 2) && Animation_OnFrame(skelAnime, 9.0f) != 0) {
@@ -2543,7 +2544,7 @@ void func_80B592A8(EnZl3* this, PlayState* play) {
     EnZl3_UpdateBgCheckInfo(this, play);  // was func_80B5366C [LLM:HIGH]
     EnZl3_UpdateEyes(this);
     func_80B57AAC(this, EnZl3_UpdateSkelAnime(this), &gZelda2Anime2Anim_003D20);
-    func_80B56DEC(this);
+    EnZl3_PlayOpenDoorSfxOnFrame9(this);  // was func_80B56DEC [LLM:HIGH]
     func_80B58AAC(this, play);
 }
 
