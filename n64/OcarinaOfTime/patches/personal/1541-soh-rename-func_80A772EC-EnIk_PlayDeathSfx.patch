From 7eddd04ce7e80165305d478a0e81360d7785218c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:25:47 +0000
Subject: [PATCH 1541/3799] soh: rename func_80A772EC -> EnIk_PlayDeathSfx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: projects the actor's position through the view matrix and plays the death sound at that screen position; EnIk_SetupCsAction3 calls it.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index 19260ca05..9436f624f 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -1171,7 +1171,8 @@ void EnIk_PlayStaggerSfx(EnIk* this) {
                          &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
 }
 
-void func_80A772EC(EnIk* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80A772EC: projects the actor's position through the view matrix and plays the death sound at that screen position; EnIk_SetupCsAction3 calls it.
+void EnIk_PlayDeathSfx(EnIk* this, PlayState* play) {
     static Vec3f D_80A78FA0;
     s32 pad[2];
     f32 wDest;
@@ -1191,7 +1192,7 @@ void EnIk_SetupCsAction3(EnIk* this, PlayState* play) {
     this->action = 3;
     this->drawMode = 2;
     EnIk_SetStartPosRotFromCue(this, play, 4);
-    func_80A772EC(this, play);
+    EnIk_PlayDeathSfx(this, play);  // was func_80A772EC [LLM:HIGH]
     this->actor.shape.shadowAlpha = 0xFF;
 }
 
