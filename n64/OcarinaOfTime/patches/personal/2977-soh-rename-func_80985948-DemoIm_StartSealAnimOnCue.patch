Subject: [PATCH 2977/3799] soh: rename func_80985948 ->
 DemoIm_StartSealAnimOnCue

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: on cue 5 action 4, plays gImpaPrepareSealGanonAnim and starts the fade
Defined in soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
index 8844aa3ba..25ac48b58 100644
--- a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -475,7 +475,8 @@ void DemoIm_SpawnLightBall(DemoIm* this, PlayState* play) {
                        (kREG(17) + 24.0f) + this->actor.world.pos.y, this->actor.world.pos.z, 0, 0, 0, 6);
 }
 
-void func_80985948(DemoIm* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80985948: on cue 5 action 4, plays gImpaPrepareSealGanonAnim and starts the fade
+void DemoIm_StartSealAnimOnCue(DemoIm* this, PlayState* play) {
     if (DemoIm_IsCueAction(this, play, 4, 5)) {  // was func_809850E8 [LLM:HIGH]
         Animation_Change(&this->skelAnime, &gImpaPrepareSealGanonAnim, 1.0f, 0.0f,
                          Animation_GetLastFrame(&gImpaPrepareSealGanonAnim), ANIMMODE_ONCE, 0.0f);
@@ -532,7 +533,7 @@ void func_80985B34(DemoIm* this, PlayState* play) {
 }
 
 void func_80985C10(DemoIm* this, PlayState* play) {
-    func_80985948(this, play);
+    DemoIm_StartSealAnimOnCue(this, play);  // was func_80985948 [LLM:HIGH]
     DemoIm_WatchCutsceneEnd(this, play);  // was func_80984C8C [LLM:HIGH]
 }
 
