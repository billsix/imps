From f0ea543db3983e4315212c0d7cec6f902be828b5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:46:32 +0000
Subject: [PATCH 1075/3799] soh: rename D_8016F0E0 -> gUnusedAudioBuffer

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment on its declaration reads "// unused"; it is a 0xA0-byte buffer with no reader.
Defined in soh/src/code/audio_init_params.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_init_params.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/audio_init_params.c b/soh/src/code/audio_init_params.c
index 77b826ca9..b01d44a20 100644
--- a/soh/src/code/audio_init_params.c
+++ b/soh/src/code/audio_init_params.c
@@ -1,6 +1,7 @@
 #include "global.h"
 
-u8 D_8016F0E0[0xA0]; // unused
+// LLM generated name (HIGH), was D_8016F0E0: the in-tree comment on its declaration reads "// unused"; it is a 0xA0-byte buffer with no reader.
+u8 gUnusedAudioBuffer[0xA0]; // unused, was D_8016F0E0 [LLM:HIGH]
 AudioContext gAudioContext;
 void (*D_801755D0)(void);
 s32 D_801755D8[3]; // unused
-- 
2.55.0

