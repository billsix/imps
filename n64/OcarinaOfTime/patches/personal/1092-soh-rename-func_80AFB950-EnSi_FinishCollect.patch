From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:47:37 +0000
Subject: [PATCH 1092/3799] soh: rename func_80AFB950 -> EnSi_FinishCollect

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: holds the player frozen until the token textbox closes, then sets the matching GS flag and kills the actor; the draw function skips the token entirely once this action is installed.
Defined in soh/src/overlays/actors/ovl_En_Si/z_en_si.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Si/z_en_si.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Si/z_en_si.c b/soh/src/overlays/actors/ovl_En_Si/z_en_si.c
index 172045bd6..71baf3a6d 100644
--- a/soh/src/overlays/actors/ovl_En_Si/z_en_si.c
+++ b/soh/src/overlays/actors/ovl_En_Si/z_en_si.c
@@ -21,7 +21,8 @@ s32 EnSi_ClearAcHit(EnSi* this, PlayState* play);  // was func_80AFB748 [LLM:HIG
 void EnSi_Idle(EnSi* this, PlayState* play);  // was func_80AFB768 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AFB89C: keeps scaling and spinning while ACTOR_FLAG_HOOKSHOT_ATTACHED is set, and awards the token the moment the hookshot lets go.
 void EnSi_AttachedToHookshot(EnSi* this, PlayState* play);  // was func_80AFB89C [LLM:HIGH]
-void func_80AFB950(EnSi* this, PlayState* play);
+// LLM generated name (HIGH), was func_80AFB950: holds the player frozen until the token textbox closes, then sets the matching GS flag and kills the actor; the draw function skips the token entirely once this action is installed.
+void EnSi_FinishCollect(EnSi* this, PlayState* play);  // was func_80AFB950 [LLM:HIGH]
 
 static ColliderCylinderInit sCylinderInit = {
     {
@@ -106,7 +107,7 @@ void EnSi_Idle(EnSi* this, PlayState* play) {
                     Message_StartTextbox(play, TEXT_GS_NO_FREEZE, NULL);
                     Audio_PlayFanfare(NA_BGM_SMALL_ITEM_GET);
                 }
-                this->actionFunc = func_80AFB950;
+                this->actionFunc = EnSi_FinishCollect;  // was func_80AFB950 [LLM:HIGH]
             } else {
                 Collider_UpdateCylinder(&this->actor, &this->collider);
                 CollisionCheck_SetAC(play, &play->colChkCtx, &this->collider.base);
@@ -132,11 +133,11 @@ void EnSi_AttachedToHookshot(EnSi* this, PlayState* play) {
             Message_StartTextbox(play, TEXT_GS_NO_FREEZE, NULL);
             Audio_PlayFanfare(NA_BGM_SMALL_ITEM_GET);
         }
-        this->actionFunc = func_80AFB950;
+        this->actionFunc = EnSi_FinishCollect;  // was func_80AFB950 [LLM:HIGH]
     }
 }
 
-void func_80AFB950(EnSi* this, PlayState* play) {
+void EnSi_FinishCollect(EnSi* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
 
     if (Message_GetState(&play->msgCtx) != TEXT_STATE_CLOSING &&
@@ -161,7 +162,7 @@ void EnSi_Update(Actor* thisx, PlayState* play) {
 void EnSi_Draw(Actor* thisx, PlayState* play) {
     EnSi* this = (EnSi*)thisx;
 
-    if (this->actionFunc != func_80AFB950) {
+    if (this->actionFunc != EnSi_FinishCollect) {  // was func_80AFB950 [LLM:HIGH]
         func_8002ED80(&this->actor, play, 0);
         func_8002EBCC(&this->actor, play, 0);
         GetItem_Draw(play, GID_SKULL_TOKEN_2);
