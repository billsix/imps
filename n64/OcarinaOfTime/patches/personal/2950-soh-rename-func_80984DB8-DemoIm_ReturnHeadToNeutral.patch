From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:59:16 +0000
Subject: [PATCH 2950/3799] soh: rename func_80984DB8 ->
 DemoIm_ReturnHeadToNeutral

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: eases the head and torso rotations back to zero
Defined in soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
index 789ae057e..1df6cdcf4 100644
--- a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -169,7 +169,8 @@ void DemoIm_UpdateCollider(DemoIm* this, PlayState* play) {
     CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
 }
 
-void func_80984DB8(DemoIm* this) {
+// LLM generated name (HIGH), was func_80984DB8: eases the head and torso rotations back to zero
+void DemoIm_ReturnHeadToNeutral(DemoIm* this) {
     s32 pad[2];
     Vec3s* headRot = &this->interactInfo.headRot;
     Vec3s* torsoRot = &this->interactInfo.torsoRot;
@@ -556,7 +557,7 @@ void func_80985EAC(DemoIm* this, PlayState* play) {
     if ((play->csCtx.frames >= 80) && (play->csCtx.frames < 243)) {
         func_80984F10(this, play);
     } else {
-        func_80984DB8(this);
+        DemoIm_ReturnHeadToNeutral(this);  // was func_80984DB8 [LLM:HIGH]
     }
 }
 
