From 59229737704ae0ba650c23309f044b0847c707b3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:34 +0000
Subject: [PATCH 0699/3799] soh: rename func_80AEB458 ->
 EnRu1_CheckFountainCueMatchingId

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 7b220a636..6b25eb5f4 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -472,7 +472,8 @@ CsCmdActorCue* EnRu1_GetFountainCue(PlayState* play) {
     return EnRu1_GetCue(play, 3);
 }
 
-s32 func_80AEB458(PlayState* play, u16 action) {
+// Name from zeldaret/oot (was func_80AEB458): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_CheckFountainCueMatchingId(PlayState* play, u16 action) {
     return EnRu1_CheckCueMatchingId(play, action, 3);
 }
 
@@ -725,7 +726,7 @@ void EnRu1_StopTreading(EnRu1* this, PlayState* play) {
     s32 pad[2];
     f32 frameCount;
 
-    if (func_80AEB458(play, 6)) {
+    if (EnRu1_CheckFountainCueMatchingId(play, 6)) {
         frameCount = Animation_GetLastFrame(&gRutoChildTransitionToSwimOnBackAnim);
         EnRu1_MoveInWater(this, play);
         Animation_Change(&this->skelAnime, &gRutoChildTransitionToSwimOnBackAnim, 1.0f, 0, frameCount, ANIMMODE_ONCE,
@@ -764,7 +765,7 @@ void EnRu1_EndSwimBack(EnRu1* this, PlayState* play) {
 }
 
 void func_80AEC070(EnRu1* this, PlayState* play, UNK_TYPE arg2) {
-    if ((func_80AEB458(play, 8)) && (arg2 != 0)) {
+    if ((EnRu1_CheckFountainCueMatchingId(play, 8)) && (arg2 != 0)) {
         Actor_Kill(&this->actor);
     }
 }
