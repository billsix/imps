From a64b1e65c0460306c297ad955715407c29b2719a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:12:06 +0000
Subject: [PATCH 3305/3799] soh: rename D_80864658 -> sStalfosFootOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the ankle-space point Actor_SetFeetPos places each foot from; named Stalfos because sFootOffset is taken by En_Tite
Defined in soh/src/overlays/actors/ovl_En_Test/z_en_test.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Test/z_en_test.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Test/z_en_test.c b/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
index 32b2140ef..7ed4da8d3 100644
--- a/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
+++ b/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
@@ -1865,7 +1865,7 @@ s32 EnTest_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f*
 
 void EnTest_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
     static Vec3f unused1 = { 1100.0f, -700.0f, 0.0f };
-    static Vec3f D_80864658 = { 300.0f, 0.0f, 0.0f };
+    static Vec3f sStalfosFootOffset = { 300.0f, 0.0f, 0.0f };  // was D_80864658 [LLM:HIGH]
     static Vec3f D_80864664 = { 3400.0f, 0.0f, 0.0f };
     static Vec3f sLimbOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_80864670 [LLM:HIGH]
     static Vec3f sSwordQuad1Offset = { 7000.0f, 1000.0f, 0.0f };  // was D_8086467C [LLM:HIGH]
@@ -1915,12 +1915,12 @@ void EnTest_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
         this->shieldCollider.dim.pos.y = sp64.y;
         this->shieldCollider.dim.pos.z = sp64.z;
     } else {
-        Actor_SetFeetPos(&this->actor, limbIndex, STALFOS_LIMB_FOOT_L, &D_80864658, STALFOS_LIMB_ANKLE_R, &D_80864658);
+        Actor_SetFeetPos(&this->actor, limbIndex, STALFOS_LIMB_FOOT_L, &sStalfosFootOffset, STALFOS_LIMB_ANKLE_R, &sStalfosFootOffset);  // was D_80864658 [LLM:HIGH]
 
         if ((limbIndex == STALFOS_LIMB_FOOT_L) || (limbIndex == STALFOS_LIMB_ANKLE_R)) {
             if ((this->unk_7C8 == 0x15) || (this->unk_7C8 == 0x16)) {
                 if (this->actor.speedXZ != 0.0f) {
-                    Matrix_MultVec3f(&D_80864658, &sp64);
+                    Matrix_MultVec3f(&sStalfosFootOffset, &sp64);  // was D_80864658 [LLM:HIGH]
                     Actor_SpawnFloorDustRing(play, &this->actor, &sp64, 10.0f, 1, 8.0f, 100, 15, false);
                 }
             }
