From 72f31ee7092903abcc5dd9120517ef2c42402a08 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:47:36 +0000
Subject: [PATCH 1087/3799] soh: rename func_80A5057C -> EnGuest_Talk

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: holds until the textbox is finished and the player advances it, then returns to the waiting state.
Defined in soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c b/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c
index 11b346971..324686380 100644
--- a/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c
+++ b/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c
@@ -19,7 +19,8 @@ void EnGuest_Draw(Actor* thisx, PlayState* play);
 
 // LLM generated name (HIGH), was func_80A50518: offers talk inside 100 units and switches to the conversation state when the player accepts.
 void EnGuest_WaitForTalk(EnGuest* this, PlayState* play);  // was func_80A50518 [LLM:HIGH]
-void func_80A5057C(EnGuest* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A5057C: holds until the textbox is finished and the player advances it, then returns to the waiting state.
+void EnGuest_Talk(EnGuest* this, PlayState* play);  // was func_80A5057C [LLM:HIGH]
 void func_80A505CC(Actor* thisx, PlayState* play);
 
 const ActorInit En_Guest_InitVars = {
@@ -131,13 +132,13 @@ void EnGuest_Blink(EnGuest* this) {
 
 void EnGuest_WaitForTalk(EnGuest* this, PlayState* play) {
     if (Actor_ProcessTalkRequest(&this->actor, play)) {
-        this->actionFunc = func_80A5057C;
+        this->actionFunc = EnGuest_Talk;  // was func_80A5057C [LLM:HIGH]
     } else if (this->actor.xzDistToPlayer < 100.0f) {
         Actor_OfferTalk(&this->actor, play, 100.0f);
     }
 }
 
-void func_80A5057C(EnGuest* this, PlayState* play) {
+void EnGuest_Talk(EnGuest* this, PlayState* play) {
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_DONE) && Message_ShouldAdvance(play)) {
         this->actionFunc = EnGuest_WaitForTalk;  // was func_80A50518 [LLM:HIGH]
     }
