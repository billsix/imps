From 5b89be01c73f5bf030780c9d569176fc7003479a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:08:54 +0000
Subject: [PATCH 1296/3799] soh: rename D_808B1F90 -> sCollisionHeaders

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the collision header for each params variant, NULL for the one that has none; indexed directly in the setup that registers the bg actor.
Defined in soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
index 876041875..5a0f6cc1e 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
@@ -31,7 +31,8 @@ const ActorInit Bg_Spot09_Obj_InitVars = {
     NULL,
 };
 
-static CollisionHeader* D_808B1F90[] = {
+// LLM generated name (HIGH), was D_808B1F90: the collision header for each params variant, NULL for the one that has none; indexed directly in the setup that registers the bg actor.
+static CollisionHeader* sCollisionHeaders[] = {  // was D_808B1F90 [LLM:HIGH]
     NULL, &gValleyObjects1Col, &gValleyObjects2Col, &gValleyObjects3Col, &gValleyObjects4Col,
 };
 
@@ -98,9 +99,9 @@ s32 func_808B1BEC(BgSpot09Obj* this, PlayState* play) {
     CollisionHeader* colHeader = NULL;
     s32 pad2[2];
 
-    if (D_808B1F90[this->dyna.actor.params] != NULL) {
+    if (sCollisionHeaders[this->dyna.actor.params] != NULL) {  // was D_808B1F90 [LLM:HIGH]
         DynaPolyActor_Init(&this->dyna, DPM_UNK);
-        CollisionHeader_GetVirtual(D_808B1F90[this->dyna.actor.params], &colHeader);
+        CollisionHeader_GetVirtual(sCollisionHeaders[this->dyna.actor.params], &colHeader);  // was D_808B1F90 [LLM:HIGH]
         this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, &this->dyna.actor, colHeader);
     }
     return true;
