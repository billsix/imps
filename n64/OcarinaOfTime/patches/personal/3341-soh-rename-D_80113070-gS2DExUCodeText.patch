From 158992441120af02c2377cecf08d2f59b69c9e6e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:14:47 +0000
Subject: [PATCH 3341/3799] soh: rename D_80113070 -> gS2DExUCodeText

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the S2DEX microcode text segment, named in the commented-out UCodeInfo rows of both graph.c tables
Defined in soh/include/variables.h.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/variables.h | 2 +-
 soh/src/code/graph.c    | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/include/variables.h b/soh/include/variables.h
index 9d3ae4826..39682bb32 100644
--- a/soh/include/variables.h
+++ b/soh/include/variables.h
@@ -67,7 +67,7 @@ extern "C"
 	extern u32 __osTimerCounter;
 	extern DmaEntry gDmaDataTable[0x60C];
 	extern u64 gUnusedUCodeData[];  // was D_801120C0 [LLM:GUESS]
-	extern u8 D_80113070[];
+	extern u8 gS2DExUCodeText[];  // was D_80113070 [LLM:HIGH]
 	extern u64 gJpegUCode[];
 	extern EffectSsOverlay gEffectSsOverlayTable[EFFECT_SS_TYPE_MAX];
 	extern Gfx sXluRenderModeDList[];  // was D_80116280 [LLM:HIGH]
diff --git a/soh/src/code/graph.c b/soh/src/code/graph.c
index 92241f3a5..cb2125df5 100644
--- a/soh/src/code/graph.c
+++ b/soh/src/code/graph.c
@@ -35,14 +35,14 @@ void PadMgr_ThreadEntry(PadMgr* padMgr);
 UCodeInfo sUCodeInfoDisas[3] = {  // was D_8012D230 [LLM:HIGH]
     //{ UCODE_F3DZEX, D_80155F50 },
     { UCODE_UNK, NULL },
-    //{ UCODE_S2DEX, D_80113070 },
+    //{ UCODE_S2DEX, gS2DExUCodeText },, was D_80113070 [LLM:HIGH]
 };
 
 // LLM generated name (HIGH), was D_8012D248: UCodeInfo table registered with the disassembler by Graph_UCodeFaultClient.
 UCodeInfo sUCodeInfoFault[3] = {  // was D_8012D248 [LLM:HIGH]
     //{ UCODE_F3DZEX, D_80155F50 },
     { UCODE_UNK, NULL },
-    //{ UCODE_S2DEX, D_80113070 },
+    //{ UCODE_S2DEX, gS2DExUCodeText },, was D_80113070 [LLM:HIGH]
 };
 // clang-format on
 
-- 
