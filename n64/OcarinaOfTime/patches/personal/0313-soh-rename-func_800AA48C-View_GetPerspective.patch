From b441d9cb20a4544a942a51e1d69c9f6984dccdb0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:31 +0000
Subject: [PATCH 0313/3799] soh: rename func_800AA48C -> View_GetPerspective

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.94.
Defined in soh/src/code/z_view.c.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_view.c   | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 8eea03fd4..6fb2bd815 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1399,7 +1399,7 @@ void func_800AA3F0(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up);
 void View_SetScale(View* view, f32 scale);
 void View_GetScale(View* view, f32* scale);
 void func_800AA460(View* view, f32 fovy, f32 near, f32 far);
-void func_800AA48C(View* view, f32* fovy, f32* near, f32* far);
+void View_GetPerspective(View* view, f32* fovy, f32* near, f32* far);  // was func_800AA48C [oot]
 void func_800AA4A8(View* view, f32 fovy, f32 near, f32 far);
 void func_800AA4E0(View* view, f32* fovy, f32* near, f32* far);
 void View_SetViewport(View* view, Viewport* viewport);
diff --git a/soh/src/code/z_view.c b/soh/src/code/z_view.c
index 2dd05af72..107cbdb5e 100644
--- a/soh/src/code/z_view.c
+++ b/soh/src/code/z_view.c
@@ -113,7 +113,8 @@ void func_800AA460(View* view, f32 fovy, f32 near, f32 far) {
     view->flags |= 4;
 }
 
-void func_800AA48C(View* view, f32* fovy, f32* near, f32* far) {
+// Name from zeldaret/oot (was func_800AA48C): adopted upstream's name for this address; body verified to match upstream at 0.94. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_view.c]
+void View_GetPerspective(View* view, f32* fovy, f32* near, f32* far) {
     *fovy = view->fovy;
     *near = view->zNear;
     *far = view->zFar;
