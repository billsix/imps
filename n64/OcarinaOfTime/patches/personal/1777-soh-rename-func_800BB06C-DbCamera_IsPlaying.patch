From e1843745437a6527c6779204413d88ba3b1538a5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:42:37 +0000
Subject: [PATCH 1777/3799] soh: rename func_800BB06C -> DbCamera_IsPlaying

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns whether the debug camera is in playback mode and the playback flag is set.
Defined in soh/src/code/db_camera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/db_camera.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/db_camera.c b/soh/src/code/db_camera.c
index 6aab9c3ed..627b9917f 100644
--- a/soh/src/code/db_camera.c
+++ b/soh/src/code/db_camera.c
@@ -2274,6 +2274,7 @@ void DbCamera_StopPlayback(void) {
     sDbCamAnim.unk_0A = 0;
 }
 
-s32 func_800BB06C(void) {
+// LLM generated name (HIGH), was func_800BB06C: returns whether the debug camera is in playback mode and the playback flag is set.
+s32 DbCamera_IsPlaying(void) {
     return sDbCamPtr->unk_00 == 2 && sDbCamAnim.unk_0A != 0;
 }
