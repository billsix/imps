From 4312000515b115f1f4a4fa88c267e7e9743cdebf Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:08 +0000
Subject: [PATCH 1675/3799] soh: rename D_80B2EB70 -> sBeamNearLeft

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the beam quad's near left corner, fixed at the emitter.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index 1aa649bae..b77f0ed08 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -130,7 +130,8 @@ static Vec3f sEyeQuadBottomLeft = { -1000.0f, -700.0f, 1500.0f };  // was D_80B2
 // LLM generated name (HIGH), was D_80B2EB64: the beam quad's near right corner, fixed at the emitter.
 static Vec3f sBeamNearRight = { 500.0f, 0.0f, 0.0f };  // was D_80B2EB64 [LLM:HIGH]
 
-static Vec3f D_80B2EB70 = { -500.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80B2EB70: the beam quad's near left corner, fixed at the emitter.
+static Vec3f sBeamNearLeft = { -500.0f, 0.0f, 0.0f };  // was D_80B2EB70 [LLM:HIGH]
 
 static Vec3f D_80B2EB7C = { 0.4f, 0.4f, 0.4f };
 
@@ -510,7 +511,7 @@ void EnVm_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
                 }
                 sp74.z = sp68.z = Math_Vec3f_DistXYZ(&this->beamPos1, &this->beamPos3) * dist;
                 Matrix_MultVec3f(&sBeamNearRight, &this->colliderQuad1.dim.quad[3]);  // was D_80B2EB64 [LLM:HIGH]
-                Matrix_MultVec3f(&D_80B2EB70, &this->colliderQuad1.dim.quad[2]);
+                Matrix_MultVec3f(&sBeamNearLeft, &this->colliderQuad1.dim.quad[2]);  // was D_80B2EB70 [LLM:HIGH]
                 Matrix_MultVec3f(&sp74, &this->colliderQuad1.dim.quad[1]);
                 Matrix_MultVec3f(&sp68, &this->colliderQuad1.dim.quad[0]);
                 Collider_SetQuadVertices(&this->colliderQuad1, &this->colliderQuad1.dim.quad[0],
-- 
