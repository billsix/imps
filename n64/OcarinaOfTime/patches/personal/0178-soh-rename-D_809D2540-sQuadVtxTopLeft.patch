From 8f68a5aa487a8677b1f2367982405e2182339b29 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:31 +0000
Subject: [PATCH 178/784] soh: rename D_809D2540 -> sQuadVtxTopLeft

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Bx/z_en_bx.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Bx/z_en_bx.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Bx/z_en_bx.c b/soh/src/overlays/actors/ovl_En_Bx/z_en_bx.c
index 236fbd5e7..6b55b9c11 100644
--- a/soh/src/overlays/actors/ovl_En_Bx/z_en_bx.c
+++ b/soh/src/overlays/actors/ovl_En_Bx/z_en_bx.c
@@ -117,13 +117,14 @@ void EnBx_Destroy(Actor* thisx, PlayState* play) {
 void EnBx_UpdateQuadCollider(Actor* thisx, PlayState* play) {
     Vec3f sp5C = { 8000.0f, 15000.0f, 2500.0f };
     Vec3f sp50 = { 8000.0f, 10000.0f, 2500.0f };
-    static Vec3f D_809D2540 = { -8000.0f, 15000.0f, 2500.0f };
+    // LLM generated name (HIGH), was D_809D2540: top-left quad corner, MultVec3f'd into collider vertices
+    static Vec3f sQuadVtxTopLeft = { -8000.0f, 15000.0f, 2500.0f };
     static Vec3f D_809D254C = { -8000.0f, 10000.0f, 2500.0f };
     Vec3f sp44;
     Vec3f sp38;
     EnBx* this = (EnBx*)thisx;
 
-    Matrix_MultVec3f(&D_809D2540, &sp44);
+    Matrix_MultVec3f(&sQuadVtxTopLeft, &sp44);
     Matrix_MultVec3f(&D_809D254C, &sp38);
     Matrix_MultVec3f(&sp5C, &this->colliderQuad.dim.quad[1]);
     Matrix_MultVec3f(&sp50, &this->colliderQuad.dim.quad[0]);
-- 
