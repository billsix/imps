From 67a93851b4c2f7fb36ce2b68513fb2db38bdadd6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:16:32 +0000
Subject: [PATCH 1401/3799] soh: rename func_80AFD508 -> EnSkb_Recoil

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays that rewind out and returns to EnSkb_ChooseAction when it finishes.
Defined in soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
index 8a03a7435..091c20751 100644
--- a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
+++ b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
@@ -28,7 +28,8 @@ void EnSkb_SetupSwing(EnSkb* this);  // was func_80AFD33C [LLM:HIGH]
 void EnSkb_SetupAttack(EnSkb* this, PlayState* play);
 // LLM generated name (HIGH), was func_80AFD47C: rewinds the attack animation from the frame it connected on and installs the recoil action.
 void EnSkb_SetupRecoil(EnSkb* this);  // was func_80AFD47C [LLM:HIGH]
-void func_80AFD508(EnSkb* this, PlayState* play);
+// LLM generated name (HIGH), was func_80AFD508: plays that rewind out and returns to EnSkb_ChooseAction when it finishes.
+void EnSkb_Recoil(EnSkb* this, PlayState* play);  // was func_80AFD508 [LLM:HIGH]
 void EnSkb_SetupStunned(EnSkb* this);
 // Name from zeldaret/oot (was func_80AFD59C): adopted upstream's name for this address; body verified to match upstream at 0.92. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Skb/z_en_skb.c]
 void EnSkb_Stunned(EnSkb* this, PlayState* play);
@@ -344,10 +345,10 @@ void EnSkb_SetupRecoil(EnSkb* this) {
     this->collider.base.atFlags &= ~4;
     this->actionState = 5;
     this->setColliderAT = 0;
-    EnSkb_SetupAction(this, func_80AFD508);
+    EnSkb_SetupAction(this, EnSkb_Recoil);  // was func_80AFD508 [LLM:HIGH]
 }
 
-void func_80AFD508(EnSkb* this, PlayState* play) {
+void EnSkb_Recoil(EnSkb* this, PlayState* play) {
     if (SkelAnime_Update(&this->skelAnime) != 0) {
         EnSkb_ChooseAction(this);  // was func_80AFCD60 [LLM:HIGH]
     }
