From 66e8379121434eb3f722426e593f112e7d54b714 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 22 Sep 2026 16:51:06 +0000
Subject: [PATCH 32/36] code, overlays: write the search loops with their exit
 test in the header
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

`while (true) { if (!c) break; … }` where the test is the first statement
is `while (c) { … }`: audio_load.c's DMA chunk loop (`size >= 0x400`),
z_jpeg.c (`!exit`), the two map-mark walks (`markType != NONE`), the two
digit loops in z_file_choose.c (`*ones >= 100` / `>= 10` — an s16
promoted to int, so `(*ones - 100) < 0` is exactly `*ones < 100`),
Bg_Spot16_Bombstone's table walk (De Morgan on integer tests, bounds
check still first), and code_800EC960.c's `while (f()) {}`. z_eff_blure.c's
`if (c) { … } else { break; }` is the same inversion.

Verified: every file compiles to byte-identical assembly before and
after with the port's own flags (asmdiff over compile_commands.json).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 soh/src/code/z_eff_blure.c | 40 +++++++++++++++++---------------------
 1 file changed, 18 insertions(+), 22 deletions(-)

diff --git a/soh/src/code/z_eff_blure.c b/soh/src/code/z_eff_blure.c
index 53ff7ccfc..686df569e 100644
--- a/soh/src/code/z_eff_blure.c
+++ b/soh/src/code/z_eff_blure.c
@@ -332,29 +332,25 @@ s32 EffectBlure_Update(void* thisx) {
         return 0;
     }
 
-    while (true) {
-        if (this->elements[0].state == 0) {
-            for (i = 0; i < 15; i++) {
-                this->elements[i] = this->elements[i + 1];
-            }
+    while (this->elements[0].state == 0) {
+        for (i = 0; i < 15; i++) {
+            this->elements[i] = this->elements[i + 1];
+        }
 
-            this->elements[i].state = 2;
-            this->elements[i].p1.x = 0;
-            this->elements[i].p1.y = 0;
-            this->elements[i].p1.z = 0;
-            this->elements[i].p2.x = 0;
-            this->elements[i].p2.y = 0;
-            this->elements[i].p2.z = 0;
-            this->elements[i].flags = 0;
-            this->elements[i].timer = 0;
-
-            this->numElements--;
-            if (this->numElements <= 0) {
-                this->numElements = 0;
-                return 0;
-            }
-        } else {
-            break;
+        this->elements[i].state = 2;
+        this->elements[i].p1.x = 0;
+        this->elements[i].p1.y = 0;
+        this->elements[i].p1.z = 0;
+        this->elements[i].p2.x = 0;
+        this->elements[i].p2.y = 0;
+        this->elements[i].p2.z = 0;
+        this->elements[i].flags = 0;
+        this->elements[i].timer = 0;
+
+        this->numElements--;
+        if (this->numElements <= 0) {
+            this->numElements = 0;
+            return 0;
         }
     }
 
