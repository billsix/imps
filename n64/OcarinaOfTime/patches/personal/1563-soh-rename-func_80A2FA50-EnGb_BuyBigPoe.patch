From 7f5f66d205bff8b4391cd51786a925497f2fd4be Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:26:57 +0000
Subject: [PATCH 1563/3799] soh: rename func_80A2FA50 -> EnGb_BuyBigPoe

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the big-Poe purchase: empties the bottle, pays 50 rupees, adds 100 Poe points and, at exactly 1000, moves on to the bottle reward instead of returning to the idle.
Defined in soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c b/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
index d4f4d86dd..281322743 100644
--- a/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
+++ b/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
@@ -19,7 +19,8 @@ void EnGb_Draw(Actor* thisx, PlayState* play);
 // LLM generated name (HIGH), was func_80A2F83C: the resting action: counts down to the next stick swing, offers the Poe exchange within 100 units, and routes an accepted trade to the ordinary, small-Poe or big-Poe reply.
 void EnGb_Idle(EnGb* this, PlayState* play);  // was func_80A2F83C [LLM:HIGH]
 void func_80A2FC70(EnGb* this, PlayState* play);
-void func_80A2FA50(EnGb* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A2FA50: the big-Poe purchase: empties the bottle, pays 50 rupees, adds 100 Poe points and, at exactly 1000, moves on to the bottle reward instead of returning to the idle.
+void EnGb_BuyBigPoe(EnGb* this, PlayState* play);  // was func_80A2FA50 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80A2F9C0: the small-Poe purchase reply; it records the conversation and returns to the idle.
 void EnGb_BuyPoe(EnGb* this, PlayState* play);  // was func_80A2F9C0 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80A2F94C: waits out the plain greeting, records that the player has spoken to him and returns to the idle.
@@ -303,7 +304,7 @@ void EnGb_Idle(EnGb* this, PlayState* play) {
                     break;
                 case EXCH_ITEM_BIG_POE:
                     player->actor.textId = 0x70F7;
-                    this->actionFunc = func_80A2FA50;
+                    this->actionFunc = EnGb_BuyBigPoe;  // was func_80A2FA50 [LLM:HIGH]
                     break;
             }
         }
@@ -336,7 +337,7 @@ void EnGb_BuyPoe(EnGb* this, PlayState* play) {
     }
 }
 
-void func_80A2FA50(EnGb* this, PlayState* play) {
+void EnGb_BuyBigPoe(EnGb* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_DONE && Message_ShouldAdvance(play)) {
         if (!Flags_GetInfTable(INFTABLE_SPOKE_TO_POE_COLLECTOR_IN_RUINED_MARKET)) {
             Flags_SetInfTable(INFTABLE_SPOKE_TO_POE_COLLECTOR_IN_RUINED_MARKET);
