From 157853249f2d84fd591105abe9ed9abc0e9f79d9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:04 +0000
Subject: [PATCH 3193/3799] soh: rename D_8011D9F4 -> sAttentionFarKeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframes used for a distant target, scaled by the player-to-target distance
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c        | 28 ++++++++++++++--------------
 soh/src/code/z_camera_data.inc |  3 ++-
 2 files changed, 16 insertions(+), 15 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 9bbac8762..a100cb6df 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -6181,33 +6181,33 @@ s32 Camera_Demo5(Camera* camera) {
         }
     } else {
         if (playerTargetGeo.r < 200.0f) {
-            D_8011D9F4[0].eyeTargetInit.z = playerTargetGeo.r;
-            D_8011D9F4[0].atTargetInit.z = playerTargetGeo.r * 0.25f;
+            sAttentionFarKeyFrames[0].eyeTargetInit.z = playerTargetGeo.r;  // was D_8011D9F4 [LLM:HIGH]
+            sAttentionFarKeyFrames[0].atTargetInit.z = playerTargetGeo.r * 0.25f;  // was D_8011D9F4 [LLM:HIGH]
         }
         if (playerTargetGeo.r < 400.0f) {
-            D_8011D9F4[0].eyeTargetInit.x = Rand_ZeroOne() * 25.0f;
+            sAttentionFarKeyFrames[0].eyeTargetInit.x = Rand_ZeroOne() * 25.0f;  // was D_8011D9F4 [LLM:HIGH]
         }
         Player_GetHeight(camera->player);
-        D_8011D9F4[0].timerInit = camera->timer;
+        sAttentionFarKeyFrames[0].timerInit = camera->timer;  // was D_8011D9F4 [LLM:HIGH]
         Actor_GetFocus(&targethead, camera->target);
         if (Camera_BGCheck(camera, &playerhead.pos, &targethead.pos)) {
-            D_8011D9F4[1].timerInit = 4;
-            D_8011D9F4[1].actionFlags = 0x8F;
+            sAttentionFarKeyFrames[1].timerInit = 4;  // was D_8011D9F4 [LLM:HIGH]
+            sAttentionFarKeyFrames[1].actionFlags = 0x8F;  // was D_8011D9F4 [LLM:HIGH]
         } else {
             t = eyeTargetDist * 0.005f;
-            D_8011D9F4[1].timerInit = t + 8;
+            sAttentionFarKeyFrames[1].timerInit = t + 8;  // was D_8011D9F4 [LLM:HIGH]
         }
-        ONEPOINT_CS_INFO(camera)->keyFrames = D_8011D9F4;
-        ONEPOINT_CS_INFO(camera)->keyFrameCnt = ARRAY_COUNT(D_8011D9F4);
+        ONEPOINT_CS_INFO(camera)->keyFrames = sAttentionFarKeyFrames;  // was D_8011D9F4 [LLM:HIGH]
+        ONEPOINT_CS_INFO(camera)->keyFrameCnt = ARRAY_COUNT(sAttentionFarKeyFrames);  // was D_8011D9F4 [LLM:HIGH]
         if (camera->parentCamIdx != CAM_ID_MAIN) {
             if (camera->play->state.frames & 1) {
-                D_8011D9F4[0].rollTargetInit = -D_8011D9F4[0].rollTargetInit;
-                D_8011D9F4[1].rollTargetInit = -D_8011D9F4[1].rollTargetInit;
+                sAttentionFarKeyFrames[0].rollTargetInit = -sAttentionFarKeyFrames[0].rollTargetInit;  // was D_8011D9F4 [LLM:HIGH]
+                sAttentionFarKeyFrames[1].rollTargetInit = -sAttentionFarKeyFrames[1].rollTargetInit;  // was D_8011D9F4 [LLM:HIGH]
             }
             ONEPOINT_CS_INFO(camera)->keyFrameCnt -= 2;
         } else {
-            camera->timer += D_8011D9F4[1].timerInit + D_8011D9F4[2].timerInit;
-            D_8011D9F4[0].rollTargetInit = D_8011D9F4[1].rollTargetInit = 0;
+            camera->timer += sAttentionFarKeyFrames[1].timerInit + sAttentionFarKeyFrames[2].timerInit;  // was D_8011D9F4 [LLM:HIGH]
+            sAttentionFarKeyFrames[0].rollTargetInit = sAttentionFarKeyFrames[1].rollTargetInit = 0;  // was D_8011D9F4 [LLM:HIGH]
         }
     }
 
@@ -8391,7 +8391,7 @@ s16 Camera_SetFinishedFlag(Camera* camera) {
     F(sAttentionCloseAltKeyFrames)                       \
     F(sAttentionSwingKeyFrames)                       \
     F(sAttentionDoorKeyFrames)                       \
-    F(D_8011D9F4)                       \
+    F(sAttentionFarKeyFrames)                       \
     F(depthPhase)                       \
     F(screenPlanePhase)                 \
     F(sOOBTimer)                        \
diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index 4a9f54a4a..eb1ffd1e3 100644
--- a/soh/src/code/z_camera_data.inc
+++ b/soh/src/code/z_camera_data.inc
@@ -2387,7 +2387,8 @@ static OnePointCsFull sAttentionDoorKeyFrames[] = {  // was D_8011D954 [LLM:HIGH
 };
 
 // otherwise
-static OnePointCsFull D_8011D9F4[] = {
+// LLM generated name (HIGH), was D_8011D9F4: the keyframes used for a distant target, scaled by the player-to-target distance
+static OnePointCsFull sAttentionFarKeyFrames[] = {  // was D_8011D9F4 [LLM:HIGH]
     { 0x8F, 0xFF, 0x0504, 0x0014, 0x0002, 60.0f, 1.0f, { 0.0f, 5.0f, 50.0f }, { 0.0f, 20.0f, 300.0f } },
     { 0x82, 0xFF, 0x2121, 0x0005, 0x0002, 60.0f, 1.0f, { 0.0f, 10.0f, 0.0f }, { 0.0f, 20.0f, -150.0f } },
     { 0x12, 0xFF, 0x0000, 0x0001, 0x0000, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
