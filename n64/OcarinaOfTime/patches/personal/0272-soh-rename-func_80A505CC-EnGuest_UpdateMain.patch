         Collider_InitCylinder(play, &this->collider);
         Collider_SetCylinderType1(play, &this->collider, &this->actor, &sCylinderInit);
@@ -143,7 +144,7 @@ void EnGuest_Talk(EnGuest* this, PlayState* play) {
     }
 }
 
