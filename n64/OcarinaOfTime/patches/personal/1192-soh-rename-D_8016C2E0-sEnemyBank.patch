From 0e95e65799b6ec6866be0d34e1b256ad0545bb9c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:56:12 +0000
Subject: [PATCH 1192/3799] soh: rename D_8016C2E0 -> sEnemyBank

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: gSoundBanks[3]; the same comment names entry 3 "Enemy Bank size 20".
Defined in soh/src/code/audio_sfx.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_sfx.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index 2f62cfc22..c6e4fccb6 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -42,7 +42,8 @@ SoundBankEntry sPlayerBank[9];  // was D_8016BAD0 [LLM:HIGH]
 SoundBankEntry sItemBank[12];  // was D_8016BC80 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8016BEC0: gSoundBanks[2]; the same comment names entry 2 "Environment Bank size 22".
 SoundBankEntry sEnvironmentBank[22];  // was D_8016BEC0 [LLM:HIGH]
-SoundBankEntry D_8016C2E0[20];
+// LLM generated name (HIGH), was D_8016C2E0: gSoundBanks[3]; the same comment names entry 3 "Enemy Bank size 20".
+SoundBankEntry sEnemyBank[20];  // was D_8016C2E0 [LLM:HIGH]
 SoundBankEntry D_8016C6A0[8];
 SoundBankEntry D_8016C820[3];
 SoundBankEntry D_8016C8B0[5];
@@ -74,11 +75,11 @@ u8 sSoundRequestReadIndex = 0;
  * 6 : Voice Bank           size 5
  */
 SoundBankEntry* gSoundBanks[7] = {
-    sPlayerBank, sItemBank, sEnvironmentBank, D_8016C2E0, D_8016C6A0, D_8016C820, D_8016C8B0,  // was D_8016BAD0 [LLM:HIGH]
+    sPlayerBank, sItemBank, sEnvironmentBank, sEnemyBank, D_8016C6A0, D_8016C820, D_8016C8B0,  // was D_8016BAD0 [LLM:HIGH]
 };
 
 u8 sBankSizes[ARRAY_COUNT(gSoundBanks)] = {
-    ARRAY_COUNT(sPlayerBank), ARRAY_COUNT(sItemBank), ARRAY_COUNT(sEnvironmentBank), ARRAY_COUNT(D_8016C2E0),  // was D_8016BAD0 [LLM:HIGH]
+    ARRAY_COUNT(sPlayerBank), ARRAY_COUNT(sItemBank), ARRAY_COUNT(sEnvironmentBank), ARRAY_COUNT(sEnemyBank),  // was D_8016BAD0 [LLM:HIGH]
     ARRAY_COUNT(D_8016C6A0), ARRAY_COUNT(D_8016C820), ARRAY_COUNT(D_8016C8B0),
 };
 
