Subject: [PATCH 2257/3799] soh: rename func_80B0E5E0 -> EnSw_WallIdle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the ceiling skulltula's idle: picks a new random roll each time it arrives, and laughs into the chase when the player comes close
Defined in soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
index 62466cda3..8eb9c23d6 100644
--- a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
+++ b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
@@ -12,7 +12,8 @@ void EnSw_Draw(Actor* thisx, PlayState* play);
 s32 EnSw_CanKeepChasing(EnSw* this, PlayState* play);  // was func_80B0DFFC [LLM:HIGH]
 // LLM generated name (HIGH), was func_80B0D364: arms the pre-drop delay and installs the drop-in action
 void EnSw_SetupDropIn(EnSw* this, PlayState* play);  // was func_80B0D364 [LLM:HIGH]
-void func_80B0E5E0(EnSw* this, PlayState* play);
+// LLM generated name (HIGH), was func_80B0E5E0: the ceiling skulltula's idle: picks a new random roll each time it arrives, and laughs into the chase when the player comes close
+void EnSw_WallIdle(EnSw* this, PlayState* play);  // was func_80B0E5E0 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80B0D590: the resting state: grows or shrinks a night-only gold skulltula, and alternates between still frames and a scuttling wiggle across the surface
 void EnSw_Cling(EnSw* this, PlayState* play);  // was func_80B0D590 [LLM:HIGH]
 void func_80B0E90C(EnSw* this, PlayState* play);
@@ -312,7 +313,7 @@ void EnSw_Init(Actor* thisx, PlayState* play) {
         this->unk_394 = 1;
         this->actionFunc = EnSw_SetupDropIn;  // was func_80B0D364 [LLM:HIGH]
     } else if (((thisx->params & 0xE000) >> 0xD) == 0) {
-        this->actionFunc = func_80B0E5E0;
+        this->actionFunc = EnSw_WallIdle;  // was func_80B0E5E0 [LLM:HIGH]
     } else {
         this->actionFunc = EnSw_Cling;  // was func_80B0D590 [LLM:HIGH]
     }
@@ -840,7 +841,7 @@ s32 EnSw_TurnToRoll(EnSw* this, f32 arg1, s16 arg2, s32 arg3, PlayState* play) {
     return 0;
 }
 
-void func_80B0E5E0(EnSw* this, PlayState* play) {
+void EnSw_WallIdle(EnSw* this, PlayState* play) {
     s32 pad[2];
     f32 rand;
 
@@ -869,7 +870,7 @@ void func_80B0E728(EnSw* this, PlayState* play) {
             this->unk_444 = EnSw_GetRollToward(this, &this->unk_448);  // was func_80B0DE34 [LLM:HIGH]
             EnSw_TurnToRoll(this, 6.0f, (u16)0xFA0, 0, play);  // was func_80B0E430 [LLM:HIGH]
         } else {
-            this->actionFunc = func_80B0E5E0;
+            this->actionFunc = EnSw_WallIdle;  // was func_80B0E5E0 [LLM:HIGH]
         }
     } else {
         if (!EnSw_CanKeepChasing(this, play)) {  // was func_80B0DFFC [LLM:HIGH]
@@ -909,7 +910,7 @@ void func_80B0E9BC(EnSw* this, PlayState* play) {
     if (EnSw_TurnToRoll(this, 6.0f, 0x3E8, 0, play)) {  // was func_80B0E430 [LLM:HIGH]
         EnSw_MoveToward(this, this->unk_448, 2.0f);  // was func_80B0E314 [LLM:HIGH]
         if (!(Math_Vec3f_DistXYZ(&this->actor.world.pos, &this->unk_448) > 4.0f)) {
-            this->actionFunc = func_80B0E5E0;
+            this->actionFunc = EnSw_WallIdle;  // was func_80B0E5E0 [LLM:HIGH]
         }
     }
 }
