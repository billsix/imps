From ec2295012ae1687bdf29cff9d88b023ace56d853 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:59 +0000
Subject: [PATCH 3203/3799] soh: rename D_8082A0E4 -> sQuestItemG

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the current green of each quest slot
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../misc/ovl_kaleido_scope/z_kaleido_collect.c     | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
index 3be4bf10f..1890094c5 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
@@ -20,7 +20,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
         { 0, 60, 0 }, { 90, 0, 0 }, { 0, 40, 110 }, { 80, 40, 0 }, { 70, 0, 90 }, { 90, 90, 0 },
     };
     static s16 sQuestItemR[] = { 255, 255, 255, 255, 255, 255 };  // was D_8082A0D8 [LLM:HIGH]
-    static s16 D_8082A0E4[] = { 255, 255, 255, 255, 255, 255 };
+    static s16 sQuestItemG[] = { 255, 255, 255, 255, 255, 255 };  // was D_8082A0E4 [LLM:HIGH]
     static s16 D_8082A0F0[] = { 150, 150, 150, 150, 150, 150 };
     static s16 D_8082A0FC = 20;
     static s16 D_8082A100 = 0;
@@ -321,17 +321,17 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
 
             if (D_8082A0FC != 0) {
                 sp226 = ABS(sQuestItemR[sp218] - sQuestItemColorSets[phi_v1][0]) / D_8082A0FC;  // was D_8082A090 [LLM:HIGH]
-                sp224 = ABS(D_8082A0E4[sp218] - sQuestItemColorSets[phi_v1][1]) / D_8082A0FC;  // was D_8082A090 [LLM:HIGH]
+                sp224 = ABS(sQuestItemG[sp218] - sQuestItemColorSets[phi_v1][1]) / D_8082A0FC;  // was D_8082A090 [LLM:HIGH]
                 sp222 = ABS(D_8082A0F0[sp218] - sQuestItemColorSets[phi_v1][2]) / D_8082A0FC;  // was D_8082A090 [LLM:HIGH]
                 if (sQuestItemR[sp218] >= sQuestItemColorSets[phi_v1][0]) {  // was D_8082A090 [LLM:HIGH]
                     sQuestItemR[sp218] -= sp226;  // was D_8082A0D8 [LLM:HIGH]
                 } else {
                     sQuestItemR[sp218] += sp226;  // was D_8082A0D8 [LLM:HIGH]
                 }
-                if (D_8082A0E4[sp218] >= sQuestItemColorSets[phi_v1][1]) {  // was D_8082A090 [LLM:HIGH]
-                    D_8082A0E4[sp218] -= sp224;
+                if (sQuestItemG[sp218] >= sQuestItemColorSets[phi_v1][1]) {  // was D_8082A090 [LLM:HIGH]
+                    sQuestItemG[sp218] -= sp224;  // was D_8082A0E4 [LLM:HIGH]
                 } else {
-                    D_8082A0E4[sp218] += sp224;
+                    sQuestItemG[sp218] += sp224;  // was D_8082A0E4 [LLM:HIGH]
                 }
                 if (D_8082A0F0[sp218] >= sQuestItemColorSets[phi_v1][2]) {  // was D_8082A090 [LLM:HIGH]
                     D_8082A0F0[sp218] -= sp222;
@@ -340,7 +340,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
                 }
             } else {
                 sQuestItemR[sp218] = sQuestItemColorSets[phi_v1][0];  // was D_8082A090 [LLM:HIGH]
-                D_8082A0E4[sp218] = sQuestItemColorSets[phi_v1][1];  // was D_8082A090 [LLM:HIGH]
+                sQuestItemG[sp218] = sQuestItemColorSets[phi_v1][1];  // was D_8082A090 [LLM:HIGH]
                 D_8082A0F0[sp218] = sQuestItemColorSets[phi_v1][2];  // was D_8082A090 [LLM:HIGH]
             }
         }
@@ -348,7 +348,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
         if (CHECK_QUEST_ITEM(sp218)) {
             gDPPipeSync(POLY_OPA_DISP++);
             gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, 255, 255, 255, pauseCtx->alpha);
-            gDPSetEnvColor(POLY_OPA_DISP++, sQuestItemR[sp218], D_8082A0E4[sp218], D_8082A0F0[sp218], 0);  // was D_8082A0D8 [LLM:HIGH]
+            gDPSetEnvColor(POLY_OPA_DISP++, sQuestItemR[sp218], sQuestItemG[sp218], D_8082A0F0[sp218], 0);  // was D_8082A0D8 [LLM:HIGH]
             gSPVertex(POLY_OPA_DISP++, &pauseCtx->questVtx[sp21A], 4, 0);
 
             KaleidoScope_DrawQuadTextureRGBA32(gfxCtx, gItemIcons[ITEM_MEDALLION_FOREST + sp218], 24, 24, 0);
