@@ -2657,12 +2657,12 @@ void BossGanon2_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
 
     if (*dList != NULL) {
         if ((limbIndex == 7) && (this->unk_312 == 1)) {
-            Matrix_MultVec3f(&D_809070FC, &this->unk_218);
+            Matrix_MultVec3f(&sSwordTrailAnchorOffset, &this->unk_218);  // was D_809070FC [LLM:GUESS]
             func_808FD080(0, &this->unk_444, &this->unk_218);
             Matrix_MultVec3f(&D_80907120, &this->unk_200);
             Matrix_MultVec3f(&D_8090712C, &this->unk_20C);
         } else if ((limbIndex == 13) && (this->unk_312 == 2)) {
-            Matrix_MultVec3f(&D_809070FC, &this->unk_218);
+            Matrix_MultVec3f(&sSwordTrailAnchorOffset, &this->unk_218);  // was D_809070FC [LLM:GUESS]
             func_808FD080(1, &this->unk_444, &this->unk_218);
             Matrix_MultVec3f(&D_80907120, &this->unk_200);
             Matrix_MultVec3f(&D_8090712C, &this->unk_20C);
diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
