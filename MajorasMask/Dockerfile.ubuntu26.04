# Based on the 2 Ship 2 Harkinian Linux CI build environment
# (.github/workflows/main.yml: SDL/tinyxml2/libzip from source), but on Ubuntu
# 26.04 (newer than CI's ubuntu-22.04), following the billPodman 26.04 reference.
# Uses the distro-DEFAULT toolchain instead of CI's pinned gcc-12: 26.04 ships
# gcc-15 (as `gcc`/`g++`) and cmake 4.x from apt — both satisfy the project
# (cmake >= 3.26) — so there is no compiler pin, no CC/CXX env, and no Kitware
# repo (which jammy's old cmake needed). Note: this diverges from CI's gcc-12.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

# Base toolchain + AppImage tooling + the shared CI library deps.
# The library list is read straight from .github/workflows/apt-deps.txt — the
# SAME file the GitHub Linux CI installs from — via a build-time bind mount, so
# the list lives in one place (no duplication) and the file is not baked into an
# image layer. The packages listed inline are the ones a bare ubuntu:26.04 lacks
# that the GitHub runner pre-provides (toolchain, checkout/download utilities,
# AppImage packaging) plus the zip CLI tools the CI installs alongside apt-deps.
RUN --mount=type=bind,source=.github/workflows/apt-deps.txt,target=/tmp/apt-deps.txt \
    apt-get update && apt-get install -y --no-install-recommends \
        $(cat /tmp/apt-deps.txt) \
        ca-certificates wget curl git file patchelf desktop-file-utils \
        lsb-release build-essential gcc g++ cmake pkg-config python3 \
        zipcmp zipmerge ziptool \
    && rm -rf /var/lib/apt/lists/*

# SDL 2.30.3 from source (CI step "Install latest SDL").
RUN mkdir -p /deps && cd /deps \
 && wget -q https://github.com/libsdl-org/SDL/releases/download/release-2.30.3/SDL2-2.30.3.tar.gz \
 && tar -xzf SDL2-2.30.3.tar.gz \
 && cd SDL2-2.30.3 \
 && ./configure --enable-hidapi-libusb \
 && make -j"$(nproc)" \
 && make install \
 && cp -av /usr/local/lib/libSDL* /lib/x86_64-linux-gnu/ \
 && ldconfig \
 && cd / && rm -rf /deps

# tinyxml2 10.0.0 from source (CI removes the apt one first).
RUN apt-get update && apt-get remove -y libtinyxml2-dev \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /deps && cd /deps \
 && wget -q https://github.com/leethomason/tinyxml2/archive/refs/tags/10.0.0.tar.gz \
 && tar -xzf 10.0.0.tar.gz \
 && cmake -S tinyxml2-10.0.0 -B tinyxml2-10.0.0/build -DCMAKE_BUILD_TYPE=Release \
 && cmake --build tinyxml2-10.0.0/build -j"$(nproc)" \
 && cmake --install tinyxml2-10.0.0/build \
 && ldconfig \
 && cd / && rm -rf /deps

# libzip 1.10.1 without crypto backends (CI step "Install libzip without crypto").
RUN mkdir -p /deps && cd /deps \
 && wget -q https://github.com/nih-at/libzip/releases/download/v1.10.1/libzip-1.10.1.tar.gz \
 && tar -xzf libzip-1.10.1.tar.gz \
 && cmake -S libzip-1.10.1 -B libzip-1.10.1/build -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_COMMONCRYPTO=OFF -DENABLE_GNUTLS=OFF \
        -DENABLE_MBEDTLS=OFF -DENABLE_OPENSSL=OFF \
 && cmake --build libzip-1.10.1/build -j"$(nproc)" \
 && cmake --install libzip-1.10.1/build \
 && cp -av /usr/local/lib/libzip* /lib/x86_64-linux-gnu/ \
 && ldconfig \
 && cd / && rm -rf /deps

WORKDIR /src
