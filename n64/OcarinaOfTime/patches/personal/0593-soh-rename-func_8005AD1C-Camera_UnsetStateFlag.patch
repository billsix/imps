-            func_8005AD1C(play->cameraPtrs[CAM_ID_MAIN], 4);
+            Camera_UnsetStateFlag(play->cameraPtrs[CAM_ID_MAIN], 4);
             this->switchFlag = 10;
         }
     } else {
