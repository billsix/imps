+++ b/soh/include/variables.h
@@ -178,8 +178,8 @@ extern "C"
 	extern f32 triforcePieceScale;
 	extern f32 mysteryItemScale;
 	
-	extern const s16 D_8014A6C0[];
-#define gTatumsPerBeat (D_8014A6C0[1])
+	extern const s16 gAudioTatumInit[];  // was D_8014A6C0 [LLM:GUESS]
+#define gTatumsPerBeat (gAudioTatumInit[1])  // was D_8014A6C0 [LLM:GUESS]
 	extern const AudioContextInitSizes D_8014A6C4;
 	extern s16 gOcarinaSongItemMap[];
 	extern u8 D_80155F50[];
diff --git a/soh/src/code/audio_init_params.c b/soh/src/code/audio_init_params.c
index 80cf8fce5..bd6c6246a 100644
--- a/soh/src/code/audio_init_params.c
+++ b/soh/src/code/audio_init_params.c
@@ -7,7 +7,8 @@ void (*D_801755D0)(void);
 // LLM generated name (HIGH), was D_801755D8: the in-tree comment on its declaration reads "// unused"; three s32 slots with no reader.
 s32 gUnusedAudioValues[3]; // unused, was D_801755D8 [LLM:HIGH]
 
-const s16 D_8014A6C0[] = {
+// LLM generated name (GUESS), was D_8014A6C0: const s16 pair whose second element is gTatumsPerBeat (variables.h defines that macro as element 1) and whose first the file marks "// unused"; named for the one identified member because nothing else pins down what the pair is.
+const s16 gAudioTatumInit[] = {  // was D_8014A6C0 [LLM:GUESS]
     0x1C00, // unused
     0x0030, // gTatumsPerBeat
 };
