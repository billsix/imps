From aad252b04b3ece05da3e8aa469516c52d88ad0bd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:02 +0000
Subject: [PATCH 3173/3799] soh: rename D_8015CE58 -> sXZAngleColChk

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the CamColChk Camera_XZAngle reuses across calls
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c | 24 ++++++++++++------------
 1 file changed, 12 insertions(+), 12 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index c333a68d7..9657b1c0a 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -580,7 +580,7 @@ s16 Camera_XZAngle(Vec3f* to, Vec3f* from) {
 
 static f32 sXZAngleDistA;  // was D_8015CE50 [LLM:GUESS]
 static f32 sXZAngleDistB;  // was D_8015CE54 [LLM:GUESS]
-static CamColChk D_8015CE58;
+static CamColChk sXZAngleColChk;  // was D_8015CE58 [LLM:HIGH]
 // Name from zeldaret/oot (was func_80044ADC): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.94. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_camera.c]
 s16 Camera_GetPitchAdjFromFloorHeightDiffs(Camera* camera, s16 yaw, s16 arg2) {
     Vec3f playerPos;
@@ -611,24 +611,24 @@ s16 Camera_GetPitchAdjFromFloorHeightDiffs(Camera* camera, s16 yaw, s16 arg2) {
     rotatedPos.y = playerPos.y;
     rotatedPos.z = playerPos.z + (sp30 * cosYaw);
     if (arg2 || (camera->play->state.frames % 2) == 0) {
-        D_8015CE58.pos.x = playerPos.x + (sp2C * sinYaw);
-        D_8015CE58.pos.y = playerPos.y;
-        D_8015CE58.pos.z = playerPos.z + (sp2C * cosYaw);
-        Camera_BGCheckInfo(camera, &playerPos, &D_8015CE58);
+        sXZAngleColChk.pos.x = playerPos.x + (sp2C * sinYaw);  // was D_8015CE58 [LLM:HIGH]
+        sXZAngleColChk.pos.y = playerPos.y;  // was D_8015CE58 [LLM:HIGH]
+        sXZAngleColChk.pos.z = playerPos.z + (sp2C * cosYaw);  // was D_8015CE58 [LLM:HIGH]
+        Camera_BGCheckInfo(camera, &playerPos, &sXZAngleColChk);  // was D_8015CE58 [LLM:HIGH]
         if (arg2) {
             sXZAngleDistA = sXZAngleDistB = camera->playerGroundY;  // was D_8015CE50 [LLM:GUESS]
         }
     } else {
-        sp2C = OLib_Vec3fDistXZ(&playerPos, &D_8015CE58.pos);
-        D_8015CE58.pos.x += D_8015CE58.norm.x * 5.0f;
-        D_8015CE58.pos.y += D_8015CE58.norm.y * 5.0f;
-        D_8015CE58.pos.z += D_8015CE58.norm.z * 5.0f;
+        sp2C = OLib_Vec3fDistXZ(&playerPos, &sXZAngleColChk.pos);  // was D_8015CE58 [LLM:HIGH]
+        sXZAngleColChk.pos.x += sXZAngleColChk.norm.x * 5.0f;  // was D_8015CE58 [LLM:HIGH]
+        sXZAngleColChk.pos.y += sXZAngleColChk.norm.y * 5.0f;  // was D_8015CE58 [LLM:HIGH]
+        sXZAngleColChk.pos.z += sXZAngleColChk.norm.z * 5.0f;  // was D_8015CE58 [LLM:HIGH]
         if (sp2C < sp30) {
             sp30 = sp2C;
-            sXZAngleDistA = sXZAngleDistB = Camera_GetFloorYLayer(camera, &floorNorm, &D_8015CE58.pos, &bgId);  // was D_8015CE50 [LLM:GUESS]
+            sXZAngleDistA = sXZAngleDistB = Camera_GetFloorYLayer(camera, &floorNorm, &sXZAngleColChk.pos, &bgId);  // was D_8015CE50 [LLM:GUESS]
         } else {
             sXZAngleDistA = Camera_GetFloorYLayer(camera, &floorNorm, &rotatedPos, &bgId);  // was D_8015CE50 [LLM:GUESS]
-            sXZAngleDistB = Camera_GetFloorYLayer(camera, &floorNorm, &D_8015CE58.pos, &bgId);  // was D_8015CE54 [LLM:GUESS]
+            sXZAngleDistB = Camera_GetFloorYLayer(camera, &floorNorm, &sXZAngleColChk.pos, &bgId);  // was D_8015CE54 [LLM:GUESS]
         }
 
         if (sXZAngleDistA == BGCHECK_Y_MIN) {  // was D_8015CE50 [LLM:GUESS]
@@ -8397,5 +8397,5 @@ s16 Camera_SetFinishedFlag(Camera* camera) {
     F(sOOBTimer)                        \
     F(sXZAngleDistA)                       \
     F(sXZAngleDistB)                       \
-    F(D_8015CE58)
+    F(sXZAngleColChk)  // was D_8015CE58 [LLM:HIGH]
 SHIP_SAVESTATE_DEFINE(Camera, CAMERA_SHIP_SAVESTATE_FIELDS)
