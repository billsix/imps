From 083e4aa8a82a5c936c59190fb85ab5464796f25a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:15 +0000
Subject: [PATCH 197/488] soh: rename D_808B85C8 -> sPrizeStopRotations

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: binary yaw angles indexed by this->prize; the spinning basket stops the moment shape.rot.y passes the entry, then hands the matching prize over.
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Basket/z_bg_spot18_basket.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../actors/ovl_Bg_Spot18_Basket/z_bg_spot18_basket.c         | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Basket/z_bg_spot18_basket.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Basket/z_bg_spot18_basket.c
index 1f11420af..25906bde7 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Basket/z_bg_spot18_basket.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Basket/z_bg_spot18_basket.c
@@ -76,7 +76,8 @@ static ColliderJntSphInit sJntSphInit = {
     sJntSphElementsInit,
 };
 
-static s16 D_808B85C8[] = { 0x8000, 0x2AAA, 0xD555, 0x0000 };
+// LLM generated name (HIGH), was D_808B85C8: binary yaw angles indexed by this->prize; the spinning basket stops the moment shape.rot.y passes the entry, then hands the matching prize over.
+static s16 sPrizeStopRotations[] = { 0x8000, 0x2AAA, 0xD555, 0x0000 };  // was D_808B85C8 [LLM:HIGH]
 
 void BgSpot18Basket_InitColliderJntSph(Actor* thisx, PlayState* play) {
     BgSpot18Basket* this = (BgSpot18Basket*)thisx;
@@ -337,7 +338,7 @@ void BgSpot18Basket_Stopping(BgSpot18Basket* this, PlayState* play) {
     this->dyna.actor.shape.rot.y += this->spinRate;
 
     if (tempUnk214 != 0) {
-        arrayValue = D_808B85C8[this->prize];
+        arrayValue = sPrizeStopRotations[this->prize];  // was D_808B85C8 [LLM:HIGH]
 
         if ((s16)(this->dyna.actor.shape.rot.y - arrayValue) >= 0) {
             this->dyna.actor.shape.rot.y = arrayValue;
-- 
