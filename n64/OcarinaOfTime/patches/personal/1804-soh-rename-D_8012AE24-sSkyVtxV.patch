From 543e601d13edbd0a9b840d8fb89b998c17eae3c9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:17 +0000
Subject: [PATCH 1804/3799] soh: rename D_8012AE24 -> sSkyVtxV

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the five texture V coordinates for the four side faces.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 7be8608ee..7a596835d 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -125,7 +125,8 @@ s16 sSkyVtxU[5] = {  // was D_8012AE18 [LLM:HIGH]
     0x0000, 0x07C0, 0x0F80, 0x1740, 0x1F00,
 };
 
-s16 D_8012AE24[5] = {
+// LLM generated name (HIGH), was D_8012AE24: the five texture V coordinates for the four side faces.
+s16 sSkyVtxV[5] = {  // was D_8012AE24 [LLM:HIGH]
     0x0000, 0x07C0, 0x0F80, 0x1740, 0x1F00,
 };
 
@@ -340,7 +341,7 @@ s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp2B4[k] = temp2;
                     sp1EC[k] = temp1;
                     sp188[k] = sSkyVtxU[j];  // was D_8012AE18 [LLM:HIGH]
-                    sp124[k] = D_8012AE24[i];
+                    sp124[k] = sSkyVtxV[i];  // was D_8012AE24 [LLM:HIGH]
                     temp2 += arg6;
                 }
                 temp1 += arg7;
-- 
