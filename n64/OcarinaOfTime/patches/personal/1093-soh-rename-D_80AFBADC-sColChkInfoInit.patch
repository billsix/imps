From 8116b2faf7048f61c101a5753a46382dadbebdb0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:47:37 +0000
Subject: [PATCH 1093/3799] soh: rename D_80AFBADC -> sColChkInfoInit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: CollisionCheckInfoInit2 passed to CollisionCheck_SetInfo2 in EnSi_Init.
Defined in soh/src/overlays/actors/ovl_En_Si/z_en_si.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Si/z_en_si.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Si/z_en_si.c b/soh/src/overlays/actors/ovl_En_Si/z_en_si.c
index 71baf3a6d..fc6a42f41 100644
--- a/soh/src/overlays/actors/ovl_En_Si/z_en_si.c
+++ b/soh/src/overlays/actors/ovl_En_Si/z_en_si.c
@@ -44,7 +44,8 @@ static ColliderCylinderInit sCylinderInit = {
     { 20, 18, 2, { 0, 0, 0 } },
 };
 
-static CollisionCheckInfoInit2 D_80AFBADC = { 0, 0, 0, 0, MASS_IMMOVABLE };
+// LLM generated name (HIGH), was D_80AFBADC: CollisionCheckInfoInit2 passed to CollisionCheck_SetInfo2 in EnSi_Init.
+static CollisionCheckInfoInit2 sColChkInfoInit = { 0, 0, 0, 0, MASS_IMMOVABLE };  // was D_80AFBADC [LLM:HIGH]
 
 const ActorInit En_Si_InitVars = {
     ACTOR_EN_SI,
@@ -64,7 +65,7 @@ void EnSi_Init(Actor* thisx, PlayState* play) {
 
     Collider_InitCylinder(play, &this->collider);
     Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);
-    CollisionCheck_SetInfo2(&this->actor.colChkInfo, NULL, &D_80AFBADC);
+    CollisionCheck_SetInfo2(&this->actor.colChkInfo, NULL, &sColChkInfoInit);  // was D_80AFBADC [LLM:HIGH]
     Actor_SetScale(&this->actor, 0.025f);
     this->unk_19C = 0;
     this->actionFunc = EnSi_Idle;  // was func_80AFB768 [LLM:HIGH]
