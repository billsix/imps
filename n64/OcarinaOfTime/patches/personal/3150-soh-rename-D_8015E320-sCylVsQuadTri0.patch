From 3e4d6f24709f7d2f706c6f448a21c349ad9f45bd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:48 +0000
Subject: [PATCH 3150/3799] soh: rename D_8015E320 -> sCylVsQuadTri0

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the first triangle the AC quad is split into in CollisionCheck_AC_CylVsQuad
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index 5e89e57f9..dfaddbec9 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2216,7 +2216,7 @@ void CollisionCheck_AC_TrisVsCyl(PlayState* play, CollisionCheckContext* colChkC
  * AC overlap check. Calculates the center of each collider element and the point of contact.
  */
 void CollisionCheck_AC_CylVsQuad(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT, Collider* colAC) {
-    static TriNorm D_8015E320;
+    static TriNorm sCylVsQuadTri0;  // was D_8015E320 [LLM:HIGH]
     static TriNorm D_8015E358;
     static Vec3f D_8015E390;
     ColliderCylinder* at = (ColliderCylinder*)colAT;
@@ -2229,9 +2229,9 @@ void CollisionCheck_AC_CylVsQuad(PlayState* play, CollisionCheckContext* colChkC
         if (CollisionCheck_NoSharedFlags(&at->info, &ac->info) == 1) {
             return;
         }
-        Math3D_TriNorm(&D_8015E320, &ac->dim.quad[2], &ac->dim.quad[3], &ac->dim.quad[1]);
+        Math3D_TriNorm(&sCylVsQuadTri0, &ac->dim.quad[2], &ac->dim.quad[3], &ac->dim.quad[1]);  // was D_8015E320 [LLM:HIGH]
         Math3D_TriNorm(&D_8015E358, &ac->dim.quad[1], &ac->dim.quad[0], &ac->dim.quad[2]);
-        if (Math3D_CylTriVsIntersect(&at->dim, &D_8015E320, &D_8015E390) == 1) {
+        if (Math3D_CylTriVsIntersect(&at->dim, &sCylVsQuadTri0, &D_8015E390) == 1) {  // was D_8015E320 [LLM:HIGH]
             Vec3f atPos1;
             Vec3f acPos1;
 
