Subject: [PATCH 1364/3799] soh: rename func_80AFC34C -> EnSiofuki_WaitLow

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the raising type's idle at height 10: waits for its switch flag, then targets full height and arms the 300-frame timer.
Defined in soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c b/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
index 8892a5cb6..089f4383f 100644
--- a/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
+++ b/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
@@ -15,7 +15,8 @@ void EnSiofuki_Destroy(Actor* thisx, PlayState* play);
 void EnSiofuki_Update(Actor* thisx, PlayState* play);
 void EnSiofuki_Draw(Actor* thisx, PlayState* play);
 
-void func_80AFC34C(EnSiofuki* this, PlayState* play);
+// LLM generated name (HIGH), was func_80AFC34C: the raising type's idle at height 10: waits for its switch flag, then targets full height and arms the 300-frame timer.
+void EnSiofuki_WaitLow(EnSiofuki* this, PlayState* play);  // was func_80AFC34C [LLM:HIGH]
 void func_80AFC544(EnSiofuki* this, PlayState* play);
 void func_80AFC478(EnSiofuki* this, PlayState* play);
 
@@ -87,7 +88,7 @@ void EnSiofuki_Init(Actor* thisx, PlayState* play) {
     if (type == EN_SIOFUKI_RAISING) {
         this->currentHeight = 10.0f;
         this->targetHeight = 10.0f;
-        this->actionFunc = func_80AFC34C;
+        this->actionFunc = EnSiofuki_WaitLow;  // was func_80AFC34C [LLM:HIGH]
     } else if (type == EN_SIOFUKI_LOWERING) {
         if (Flags_GetTreasure(play, (u16)thisx->params & 0x3F)) {
             this->currentHeight = -45.0f;
@@ -202,7 +203,7 @@ void EnSiofuki_Active(EnSiofuki* this, PlayState* play) {
         switch (((u16)this->dyna.actor.params >> 0xC) & 0xF) {
             case EN_SIOFUKI_RAISING:
                 this->targetHeight = 10.0f;
-                this->actionFunc = func_80AFC34C;
+                this->actionFunc = EnSiofuki_WaitLow;  // was func_80AFC34C [LLM:HIGH]
                 break;
             case EN_SIOFUKI_LOWERING:
                 this->targetHeight = this->maxHeight;
@@ -222,7 +223,7 @@ void EnSiofuki_Active(EnSiofuki* this, PlayState* play) {
     }
 }
 
-void func_80AFC34C(EnSiofuki* this, PlayState* play) {
+void EnSiofuki_WaitLow(EnSiofuki* this, PlayState* play) {
     EnSiofuki_UpdateOscillation(this, play);  // was func_80AFBDC8 [LLM:HIGH]
     EnSiofuki_PushPlayer(this, play);  // was func_80AFBE8C [LLM:HIGH]
     EnSiofuki_ApproachTargetHeight(this, play);  // was func_80AFC1D0 [LLM:HIGH]
