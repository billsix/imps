From e9035fb453ab78d1b4048b599f7d4da4ff1f9239 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:35:17 +0000
Subject: [PATCH 1003/3799] soh: rename func_80B43B6C -> EnYukabyun_Fly

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: keeps the tile spinning as it flies and kills it once the player is more than 5000 units away.
Defined in soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c b/soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c
index f55c20f1f..31d054a48 100644
--- a/soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c
+++ b/soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c
@@ -19,7 +19,8 @@ void EnYukabyun_Draw(Actor* thisx, PlayState* play);
 void EnYukabyun_WaitToLaunch(EnYukabyun* this, PlayState* play);  // was func_80B43A94 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80B43AD4: accelerates the tile's yaw spin while rising 30 units above home; once the spin passes 0x2000 it aims at the player, sets speed 10 and starts flying.
 void EnYukabyun_SpinUp(EnYukabyun* this, PlayState* play);  // was func_80B43AD4 [LLM:HIGH]
-void func_80B43B6C(EnYukabyun* this, PlayState* play);
+// LLM generated name (HIGH), was func_80B43B6C: keeps the tile spinning as it flies and kills it once the player is more than 5000 units away.
+void EnYukabyun_Fly(EnYukabyun* this, PlayState* play);  // was func_80B43B6C [LLM:HIGH]
 
 const ActorInit En_Yukabyun_InitVars = {
     ACTOR_EN_YUKABYUN,
@@ -95,13 +96,13 @@ void EnYukabyun_SpinUp(EnYukabyun* this, PlayState* play) {
     if (this->unk_150 >= 0x2000) {
         this->actor.world.rot.y = this->actor.yawTowardsPlayer;
         this->actor.speedXZ = 10.0f;
-        this->actionfunc = func_80B43B6C;
+        this->actionfunc = EnYukabyun_Fly;  // was func_80B43B6C [LLM:HIGH]
     }
     Math_StepToF(&this->actor.world.pos.y, this->actor.home.pos.y + 30.0f, 1.0f);
     Actor_PlaySfx_Flagged(&this->actor, NA_SE_EN_YUKABYUN_FLY - SFX_FLAG);
 }
 
-void func_80B43B6C(EnYukabyun* this, PlayState* play) {
+void EnYukabyun_Fly(EnYukabyun* this, PlayState* play) {
     this->actor.shape.rot.y += this->unk_150;
     if (this->actor.xzDistToPlayer > 5000.0f) {
         Actor_Kill(&this->actor);
@@ -123,7 +124,7 @@ void EnYukabyun_Update(Actor* thisx, PlayState* play) {
 
     if (((this->collider.base.atFlags & AT_HIT) || (this->collider.base.acFlags & AC_HIT) ||
          ((this->collider.base.ocFlags1 & OC1_HIT) && !(this->collider.base.oc->id == ACTOR_EN_YUKABYUN))) ||
-        ((this->actionfunc == func_80B43B6C) && (this->actor.bgCheckFlags & BGCHECKFLAG_WALL))) {
+        ((this->actionfunc == EnYukabyun_Fly) && (this->actor.bgCheckFlags & BGCHECKFLAG_WALL))) {  // was func_80B43B6C [LLM:HIGH]
         this->collider.base.atFlags &= ~AT_HIT;
         this->collider.base.acFlags &= ~AC_HIT;
         this->collider.base.ocFlags1 &= ~OC1_HIT;
-- 
