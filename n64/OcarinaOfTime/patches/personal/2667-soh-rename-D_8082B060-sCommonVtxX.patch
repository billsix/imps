From 3783ece4d7bd1d8de24a3dc7c9379d284277b708 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:42 +0000
Subject: [PATCH 2667/3799] soh: rename D_8082B060 -> sCommonVtxX

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: X offsets of the quads every page draws before its own
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 26ef19c33..bf642acbd 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2726,7 +2726,8 @@ static s16* sPageVtxHeights[] = {  // was D_8082B048 [LLM:HIGH]
     sPageVtxHeights0, sPageVtxHeights1, sPageVtxHeights2, sPageVtxHeights3, sCloudTexHeights, sPageVtxHeights5,  // was D_8082AB2C [LLM:HIGH]
 };
 
-static s16 D_8082B060[] = {
+// LLM generated name (HIGH), was D_8082B060: X offsets of the quads every page draws before its own
+static s16 sCommonVtxX[] = {  // was D_8082B060 [LLM:HIGH]
     0xFFC6, 0x000B, 0x001E, 0x001E, 0x000F, 0x0026, 0xFFC2, 0x003C, 0x003D, 0xFFB2, 0xFED4,
     0xFFAA, 0xFFBF, 0xFED4, 0xFED4, 0xFFEB, 0x000E, 0x000D, 0x0014, 0xFFDE, 0xFED4, 0x0000,
 };
@@ -2947,7 +2948,7 @@ s16 KaleidoScope_SetPageVtx(PlayState* play, Vtx* vtx, s16 pageIndex, s16 arg3)
 
             colorIndex = gSaveContext.worldMapArea;
 
-            vtx[vtxIndex + 0].v.ob[0] = vtx[vtxIndex + 2].v.ob[0] = D_8082B060[colorIndex];
+            vtx[vtxIndex + 0].v.ob[0] = vtx[vtxIndex + 2].v.ob[0] = sCommonVtxX[colorIndex];  // was D_8082B060 [LLM:HIGH]
 
             if (colorIndex) {}
 
