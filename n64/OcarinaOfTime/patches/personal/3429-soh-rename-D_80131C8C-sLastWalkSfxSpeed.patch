From d9a4bb1af8b801d200e7357bd32657f245077b1c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:09 +0000
Subject: [PATCH 3429/3799] soh: rename D_80131C8C -> sLastWalkSfxSpeed

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the speed Audio_PlayWalkSfx was last called with
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 73116b869..b22f0f7a2 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -2550,7 +2550,8 @@ void AudioOcarina_ResetStaffs(void) {
     sOcarinaDropInputTimer = 0;
 }
 
-f32 D_80131C8C = 0.0f;
+// LLM generated name (HIGH), was D_80131C8C: the speed Audio_PlayWalkSfx was last called with
+f32 sLastWalkSfxSpeed = 0.0f;  // was D_80131C8C [LLM:HIGH]
 
 // === Audio Debugging ===
 
@@ -4417,7 +4418,7 @@ void Audio_PlayWalkSfx(Vec3f* pos, u16 sfxId, f32 arg2) {
     u8 phi_v0;
     u16 sfxId2;
 
-    D_80131C8C = arg2;
+    sLastWalkSfxSpeed = arg2;  // was D_80131C8C [LLM:HIGH]
     sp24 = Audio_SetSfxScalesFromSpeed(arg2);  // was func_800F3F84 [LLM:HIGH]
     Audio_PlaySfxGeneral(sfxId, pos, 4, &sSpeedFreqScale, &sSpeedVolScale, &gSfxDefaultReverb);  // was D_8016B7A8 [LLM:HIGH]
 
