From c3e9cd75119bddc40ceb5d2e016ff7d098677852 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:31 +0000
Subject: [PATCH 3325/3799] soh: rename D_801304C0 -> sResampleShifts

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the 0x40, 0x20, 0x10, 0x8 divisors that go with those four words
Defined in soh/src/code/audio_synthesis.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_synthesis.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_synthesis.c b/soh/src/code/audio_synthesis.c
index eaa50bbeb..2ee491ebc 100644
--- a/soh/src/code/audio_synthesis.c
+++ b/soh/src/code/audio_synthesis.c
@@ -45,7 +45,8 @@ u16 gUnusedSynthTable[] = {  // was D_801304B0 [LLM:GUESS]
     0x7FFF, 0xD001, 0x3FFF, 0xF001, 0x5FFF, 0x9001, 0x7FFF, 0x8001,
 };
 
-u8 D_801304C0[] = { 0x40, 0x20, 0x10, 0x8 };
+// LLM generated name (HIGH), was D_801304C0: the 0x40, 0x20, 0x10, 0x8 divisors that go with those four words
+u8 sResampleShifts[] = { 0x40, 0x20, 0x10, 0x8 };  // was D_801304C0 [LLM:HIGH]
 
 void AudioSynth_InitNextRingBuf(s32 chunkLen, s32 bufIndex, s32 reverbIndex) {
     ReverbRingBufferItem* bufItem;
@@ -1223,7 +1224,7 @@ Acmd* AudioSynth_LoadWaveSamples(Acmd* cmd, NoteSubEu* noteSubEu, NoteSynthesisS
     } else {
         aLoadBuffer(cmd++, noteSubEu->sound.samples, DMEM_UNCOMPRESSED_NOTE, 0x80);
         if (unk6 != 0) {
-            samplePosInt = (samplePosInt * D_801304C0[unk6 >> 2]) / D_801304C0[unk6 & 3];
+            samplePosInt = (samplePosInt * sResampleShifts[unk6 >> 2]) / sResampleShifts[unk6 & 3];  // was D_801304C0 [LLM:HIGH]
         }
         samplePosInt &= 0x3F;
         temp_v0 = 0x40 - samplePosInt;
-- 
