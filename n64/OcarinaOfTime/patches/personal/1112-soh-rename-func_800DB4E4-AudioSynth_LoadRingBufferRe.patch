From 3d07c4fa8739c26248a0d6691d3935df0b5ded85 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:49:08 +0000
Subject: [PATCH 1112/3799] soh: rename func_800DB4E4 ->
 AudioSynth_LoadRingBufferResampled

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loads a wet ring-buffer chunk into DMEM_WET_TEMP, handling the wrap, then resamples it into both wet channels using the reverb's stored pitch.
Defined in soh/src/code/audio_synthesis.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_synthesis.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_synthesis.c b/soh/src/code/audio_synthesis.c
index 1bd8ca6bd..ba9d35226 100644
--- a/soh/src/code/audio_synthesis.c
+++ b/soh/src/code/audio_synthesis.c
@@ -227,7 +227,8 @@ Acmd* AudioSynth_LeakReverb(Acmd* cmd, SynthesisReverb* reverb) {
     return cmd;
 }
 
-Acmd* func_800DB4E4(Acmd* cmd, s32 arg1, SynthesisReverb* reverb, s16 arg3) {
+// LLM generated name (HIGH), was func_800DB4E4: loads a wet ring-buffer chunk into DMEM_WET_TEMP, handling the wrap, then resamples it into both wet channels using the reverb's stored pitch.
+Acmd* AudioSynth_LoadRingBufferResampled(Acmd* cmd, s32 arg1, SynthesisReverb* reverb, s16 arg3) {
     ReverbRingBufferItem* item = &reverb->items[reverb->curFrame][arg3];
     s16 offsetA;
     s16 offsetB;
@@ -535,7 +536,7 @@ Acmd* AudioSynth_LoadReverbSamples(Acmd* cmd, s32 arg1, SynthesisReverb* reverb,
             cmd = AudioSynth_LoadRingBuffer1(cmd, arg1, reverb, arg3);
         }
     } else {
-        cmd = func_800DB4E4(cmd, arg1, reverb, arg3);
+        cmd = AudioSynth_LoadRingBufferResampled(cmd, arg1, reverb, arg3);  // was func_800DB4E4 [LLM:HIGH]
     }
     return cmd;
 }
