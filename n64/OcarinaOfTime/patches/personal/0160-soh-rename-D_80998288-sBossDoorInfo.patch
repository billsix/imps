From 277b47da63f438f31a92c373bde47b0733e57609 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:28 +0000
Subject: [PATCH 160/225] soh: rename D_80998288 -> sBossDoorInfo

Name source: zeldaret/oot.
Defined in soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c b/soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c
index 5f23dbe43..641975aed 100644
--- a/soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c
+++ b/soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c
@@ -163,7 +163,8 @@ typedef struct {
     u8 index;
 } BossDoorInfo;
 
-static BossDoorInfo D_80998288[] = {
+// Name from zeldaret/oot, was D_80998288: maps each dungeon/boss scene pair to its boss-door texture/style index [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c]
+static BossDoorInfo sBossDoorInfo[] = {
     { SCENE_FIRE_TEMPLE, SCENE_FIRE_TEMPLE_BOSS, 0x01 },
     { SCENE_WATER_TEMPLE, SCENE_WATER_TEMPLE_BOSS, 0x02 },
     { SCENE_SHADOW_TEMPLE, SCENE_SHADOW_TEMPLE_BOSS, 0x03 },
@@ -257,7 +258,7 @@ void DoorShutter_Init(Actor* thisx, PlayState* play2) {
     } else if (phi_a3 == 6) {
         BossDoorInfo* phi_v1_2;
 
-        for (phi_v1_2 = &D_80998288[0], i = 0; i < ARRAY_COUNT(D_80998288) - 1; i++, phi_v1_2++) {
+        for (phi_v1_2 = &sBossDoorInfo[0], i = 0; i < ARRAY_COUNT(sBossDoorInfo) - 1; i++, phi_v1_2++) {
             if (play->sceneNum == phi_v1_2->dungeonScene || play->sceneNum == phi_v1_2->bossScene) {
                 break;
             }
