+void ArrowLight_ApproachTrailPos(Vec3f* unkPos, Vec3f* lightPos, f32 scale) {
     unkPos->x += ((lightPos->x - unkPos->x) * scale);
     unkPos->y += ((lightPos->y - unkPos->y) * scale);
     unkPos->z += ((lightPos->z - unkPos->z) * scale);
@@ -159,7 +161,7 @@ void ArrowLight_Fly(ArrowLight* this, PlayState* play) {
