From e7bab12318fb03b8aa5c24331355a8ee05797bd2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:39 +0000
Subject: [PATCH 2635/3799] soh: rename D_8082AB9C -> sCursorEnvR

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: red of the pause cursor env colour
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_scope_PAL.c     | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 64d7ac791..846078d20 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -930,7 +930,8 @@ static s16 sCursorPrimB = 0;  // was D_8082AB94 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8082AB98: alpha of that same prim colour, ramped up from zero when the cursor appears
 static s16 sCursorPrimA = 255;  // was D_8082AB98 [LLM:HIGH]
 
-static s16 D_8082AB9C = 255;
+// LLM generated name (HIGH), was D_8082AB9C: red of the pause cursor env colour
+static s16 sCursorEnvR = 255;  // was D_8082AB9C [LLM:HIGH]
 static s16 D_8082ABA0 = 0;
 static s16 D_8082ABA4 = 0;
 
@@ -3473,7 +3474,7 @@ void KaleidoScope_DrawGameOver(PlayState* play) {
                       COMBINED, ENVIRONMENT, COMBINED, 0, PRIMITIVE, 0);
 
     gDPSetPrimColor(POLY_OPA_DISP++, 0, 80, sCursorPrimR, sCursorPrimG, sCursorPrimB, sCursorPrimA);  // was D_8082AB8C [LLM:HIGH]
-    gDPSetEnvColor(POLY_OPA_DISP++, D_8082AB9C, D_8082ABA0, D_8082ABA4, 255);
+    gDPSetEnvColor(POLY_OPA_DISP++, sCursorEnvR, D_8082ABA0, D_8082ABA4, 255);  // was D_8082AB9C [LLM:HIGH]
 
     VREG(89) -= 2;
 
@@ -4574,7 +4575,7 @@ void KaleidoScope_Update(PlayState* play) {
             sCursorPrimG = 130;  // was D_8082AB90 [LLM:HIGH]
             sCursorPrimB = 0;  // was D_8082AB94 [LLM:HIGH]
             sCursorPrimA = 0;  // was D_8082AB98 [LLM:HIGH]
-            D_8082AB9C = 30;
+            sCursorEnvR = 30;  // was D_8082AB9C [LLM:HIGH]
             D_8082ABA0 = 0;
             D_8082ABA4 = 0;
             D_8082B260 = 30;
@@ -4609,13 +4610,13 @@ void KaleidoScope_Update(PlayState* play) {
                 sCursorPrimA += stepA;  // was D_8082AB98 [LLM:HIGH]
             }
 
-            stepR = ABS(D_8082AB9C - 255) / D_8082B260;
+            stepR = ABS(sCursorEnvR - 255) / D_8082B260;  // was D_8082AB9C [LLM:HIGH]
             stepG = ABS(D_8082ABA0 - 130) / D_8082B260;
             stepB = ABS(D_8082ABA4) / D_8082B260;
-            if (D_8082AB9C >= 255) {
-                D_8082AB9C -= stepR;
+            if (sCursorEnvR >= 255) {  // was D_8082AB9C [LLM:HIGH]
+                sCursorEnvR -= stepR;  // was D_8082AB9C [LLM:HIGH]
             } else {
-                D_8082AB9C += stepR;
+                sCursorEnvR += stepR;  // was D_8082AB9C [LLM:HIGH]
             }
             if (D_8082ABA0 >= 130) {
                 D_8082ABA0 -= stepG;
@@ -4635,7 +4636,7 @@ void KaleidoScope_Update(PlayState* play) {
                 sCursorPrimB = 0;  // was D_8082AB94 [LLM:HIGH]
                 sCursorPrimA = 255;  // was D_8082AB98 [LLM:HIGH]
 
-                D_8082AB9C = 255;
+                sCursorEnvR = 255;  // was D_8082AB9C [LLM:HIGH]
                 D_8082ABA0 = 130;
                 D_8082ABA4 = 0;
 
-- 
2.55.0

