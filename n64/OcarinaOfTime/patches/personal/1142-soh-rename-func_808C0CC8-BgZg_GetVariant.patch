From a780aba88d68eb3cf4fc1f3249dd9a54d226a972 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:52:27 +0000
Subject: [PATCH 1142/3799] soh: rename func_808C0CC8 -> BgZg_GetVariant

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns the low byte of params; Init uses it only to scale the bars up when it is 8 or 9. What the byte actually selects is not stated anywhere in the file.
Defined in soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
index 5fda6a9f3..94ff1aede 100644
--- a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
+++ b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
@@ -19,7 +19,8 @@ void BgZg_Draw(Actor* thisx, PlayState* play);
 void BgZg_PlayOpenSfx(BgZg* this);  // was func_808C0C50 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808C0C98: returns Flags_GetSwitch for the switch index held in the high byte of params.
 s32 BgZg_IsSwitchSet(BgZg* this, PlayState* play);  // was func_808C0C98 [LLM:HIGH]
-s32 func_808C0CC8(BgZg* this);
+// LLM generated name (GUESS), was func_808C0CC8: returns the low byte of params; Init uses it only to scale the bars up when it is 8 or 9. What the byte actually selects is not stated anywhere in the file.
+s32 BgZg_GetVariant(BgZg* this);  // was func_808C0CC8 [LLM:GUESS]
 void func_808C0CD4(BgZg* this, PlayState* play);
 void func_808C0D08(BgZg* this, PlayState* play);
 void func_808C0EEC(BgZg* this, PlayState* play);
@@ -67,7 +68,7 @@ s32 BgZg_IsSwitchSet(BgZg* this, PlayState* play) {
     return Flags_GetSwitch(play, flag);
 }
 
-s32 func_808C0CC8(BgZg* this) {
+s32 BgZg_GetVariant(BgZg* this) {
     s32 flag = this->dyna.actor.params & 0xFF;
 
     return flag;
@@ -109,7 +110,7 @@ void BgZg_Init(Actor* thisx, PlayState* play) {
     colHeader = NULL;
     CollisionHeader_GetVirtual(&gTowerCollapseBarsCol, &colHeader);
     this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, &this->dyna.actor, colHeader);
-    if ((func_808C0CC8(this) == 8) || (func_808C0CC8(this) == 9)) {
+    if ((BgZg_GetVariant(this) == 8) || (BgZg_GetVariant(this) == 9)) {  // was func_808C0CC8 [LLM:GUESS]
         this->dyna.actor.scale.x = this->dyna.actor.scale.x * 1.3f;
         this->dyna.actor.scale.z = this->dyna.actor.scale.z * 1.3f;
         this->dyna.actor.scale.y = this->dyna.actor.scale.y * 1.2f;
-- 
