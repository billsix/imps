From f4c56250285cbc31a585d9f1176ebbf22d658262 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:45 +0000
Subject: [PATCH 0741/3799] soh: rename func_80AF5CD4 -> EnSa_SetAnimGroup

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c.
---
 soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c | 25 +++++++++++----------
 1 file changed, 13 insertions(+), 12 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
index 62df5d375..af8e006ea 100644
--- a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
+++ b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
@@ -355,7 +355,8 @@ void EnSa_HandToChest(EnSa* this) {
     }
 }
 
-void func_80AF5CD4(EnSa* this, u8 arg1) {
+// Name from zeldaret/oot (was func_80AF5CD4): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Sa/z_en_sa.c]
+void EnSa_SetAnimGroup(EnSa* this, u8 arg1) {
     this->unk_20B = arg1;
     this->unk_20A = 0;
 }
@@ -562,11 +563,11 @@ void func_80AF6448(EnSa* this, PlayState* play) {
             switch (this->actor.textId) {
                 case 0x1002:
                     if (this->unk_208 == 0 && this->unk_20B != 1) {
-                        func_80AF5CD4(this, 1);
+                        EnSa_SetAnimGroup(this, 1);
                         this->mouthIndex = 1;
                     }
                     if (this->unk_208 == 2 && this->unk_20B != 2) {
-                        func_80AF5CD4(this, 2);
+                        EnSa_SetAnimGroup(this, 2);
                         this->mouthIndex = 1;
                     }
                     if (this->unk_208 == 5) {
@@ -575,48 +576,48 @@ void func_80AF6448(EnSa* this, PlayState* play) {
                     break;
                 case 0x1003:
                     if (this->unk_208 == 0 && this->unk_20B != 4) {
-                        func_80AF5CD4(this, 4);
+                        EnSa_SetAnimGroup(this, 4);
                     }
                     break;
                 case 0x1031:
                     if (this->unk_208 == 0 && this->unk_20B != 4 &&
                         this->skelAnime.animation == &gSariaHandsBehindBackWaitAnim) {
-                        func_80AF5CD4(this, 4);
+                        EnSa_SetAnimGroup(this, 4);
                         this->mouthIndex = 3;
                     }
                     if (this->unk_208 == 2 && this->unk_20B != 5) {
-                        func_80AF5CD4(this, 5);
+                        EnSa_SetAnimGroup(this, 5);
                         this->mouthIndex = 2;
                     }
                     if (this->unk_208 == 4 && this->unk_20B != 6) {
-                        func_80AF5CD4(this, 6);
+                        EnSa_SetAnimGroup(this, 6);
                         this->mouthIndex = 0;
                     }
                     break;
                 case 0x1032:
                     if (this->unk_208 == 0 && this->unk_20B != 4 &&
                         this->skelAnime.animation == &gSariaHandsBehindBackWaitAnim) {
-                        func_80AF5CD4(this, 4);
+                        EnSa_SetAnimGroup(this, 4);
                     }
                     break;
                 case 0x1047:
                     if (this->unk_208 == 1 && this->unk_20B != 7) {
-                        func_80AF5CD4(this, 7);
+                        EnSa_SetAnimGroup(this, 7);
                     }
                     break;
                 case 0x1048:
                     if (this->unk_208 == 0 && this->unk_20B != 7) {
-                        func_80AF5CD4(this, 7);
+                        EnSa_SetAnimGroup(this, 7);
                     }
                     break;
             }
         } else if (!CHECK_QUEST_ITEM(QUEST_KOKIRI_EMERALD) &&
                    ((Flags_GetInfTable(INFTABLE_01)) || (Flags_GetInfTable(INFTABLE_03)))) {
             if (this->unk_20B != 3) {
-                func_80AF5CD4(this, 3);
+                EnSa_SetAnimGroup(this, 3);
             }
         } else {
-            func_80AF5CD4(this, 0);
+            EnSa_SetAnimGroup(this, 0);
         }
         func_80AF5CE4(this);
     }
-- 
