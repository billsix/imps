Subject: [PATCH 2748/3799] soh: rename func_8002E2AC -> Actor_UpdateFloor

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: raycasts the floor 50 units above the actor and updates floorHeight, floorPoly, floorBgId and the bg check flags
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index f04480819..39fb4006f 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -1628,7 +1628,8 @@ s32 Actor_HandleFloorDrop(Actor* actor, f32 arg1, s32 arg2) {
     return true;
 }
 
-s32 func_8002E2AC(PlayState* play, Actor* actor, Vec3f* arg2, s32 arg3) {
+// LLM generated name (HIGH), was func_8002E2AC: raycasts the floor 50 units above the actor and updates floorHeight, floorPoly, floorBgId and the bg check flags
+s32 Actor_UpdateFloor(PlayState* play, Actor* actor, Vec3f* arg2, s32 arg3) {
     f32 floorHeightDiff;
     s32 floorBgId;
 
@@ -1734,7 +1735,7 @@ void Actor_UpdateBgCheckInfo(PlayState* play, Actor* actor, f32 wallCheckHeight,
 
     if (flags & 4) {
         sp64.y = actor->prevPos.y;
-        func_8002E2AC(play, actor, &sp64, flags);
+        Actor_UpdateFloor(play, actor, &sp64, flags);  // was func_8002E2AC [LLM:HIGH]
         waterBoxYSurface = actor->world.pos.y;
         if (WaterBox_GetSurface1(play, &play->colCtx, actor->world.pos.x, actor->world.pos.z, &waterBoxYSurface,
                                  &waterBox)) {
