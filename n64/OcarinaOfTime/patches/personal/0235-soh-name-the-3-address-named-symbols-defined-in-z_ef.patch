+void EffectSsKiraKira_UpdateDecelerating(PlayState* play, u32 index, EffectSs* this);  // was func_809AACAC [LLM:HIGH]
+// LLM generated name (HIGH), was func_809AAD6C: the update installed when life is passed in negative; it does nothing but drive rScale through a full sine over the particle's lifespan.
+void EffectSsKiraKira_UpdatePulsingScale(PlayState* play, u32 index, EffectSs* this);  // was func_809AAD6C [LLM:HIGH]
 
