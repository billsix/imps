From 3ee9ddfc54cc0eaa86a1b524eb50f14ae98ecf1b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:46:31 +0000
Subject: [PATCH 1071/3799] soh: rename D_808124C0 -> sNameCharXOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: indexed by the character code stored in filename[], and added to the name-entry box X position to nudge each drawn glyph.
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
index f2763a225..64a28bd6f 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
@@ -7,7 +7,8 @@
 #include "soh/ResourceManagerHelpers.h"
 #include "soh/SaveManager.h"
 
-static s16 D_808124C0[] = {
+// LLM generated name (HIGH), was D_808124C0: indexed by the character code stored in filename[], and added to the name-entry box X position to nudge each drawn glyph.
+static s16 sNameCharXOffsets[] = {  // was D_808124C0 [LLM:HIGH]
     0x0002, 0x0003, 0x0002, 0x0002, 0x0002, 0x0002, 0x0002, 0x0002, 0x0002, 0x0002, 0x0001, 0x0002, 0x0000, 0x0001,
     0x0001, 0x0002, 0x0001, 0x0001, 0x0004, 0x0002, 0x0002, 0x0002, 0x0001, 0x0001, 0x0000, 0x0002, 0x0000, 0x0001,
     0x0001, 0x0001, 0x0001, 0x0001, 0x0000, 0x0001, 0x0001, 0x0001, 0x0002, 0x0002, 0x0002, 0x0002, 0x0002, 0x0003,
@@ -155,7 +156,7 @@ void FileChoose_SetNameEntryVtx(GameState* thisx) {
             temp = filename[phi_s0 - 1];
 
             this->nameEntryVtx[phi_t1].v.ob[0] = this->nameEntryVtx[phi_t1 + 2].v.ob[0] =
-                D_808125EC[phi_s0] + this->nameEntryBoxPosX + D_808124C0[temp];
+                D_808125EC[phi_s0] + this->nameEntryBoxPosX + sNameCharXOffsets[temp];  // was D_808124C0 [LLM:HIGH]
 
             this->nameEntryVtx[phi_t1 + 1].v.ob[0] = this->nameEntryVtx[phi_t1 + 3].v.ob[0] =
                 this->nameEntryVtx[phi_t1].v.ob[0] + 0xA;
