From 409cb6005709dffb8d8a0a875cc24d2806f71417 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Sun, 20 Sep 2026 03:14:59 +0000
Subject: [PATCH 1/5] docs: document BaseSimpleActivity, the shared app
 skeleton

Add KDoc explaining the base class nearly every Fossify screen extends: the
runtime theming lifecycle, the per-widget font inflater factory, the
forced-English locale wrapping, and especially the callback-style runtime
permission helpers (handlePermission / handlePartialMediaPermissions /
handleNotificationPermission) that wrap Android's split requestPermissions /
onRequestPermissionsResult flow. Comment-only.
---
 .../commons/activities/BaseSimpleActivity.kt  | 66 +++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/commons/src/main/kotlin/org/fossify/commons/activities/BaseSimpleActivity.kt b/commons/src/main/kotlin/org/fossify/commons/activities/BaseSimpleActivity.kt
index b9f640ec4..8dc3227c6 100644
--- a/commons/src/main/kotlin/org/fossify/commons/activities/BaseSimpleActivity.kt
+++ b/commons/src/main/kotlin/org/fossify/commons/activities/BaseSimpleActivity.kt
@@ -136,6 +136,27 @@ import java.io.File
 import java.io.OutputStream
 import java.util.regex.Pattern
 
+/**
+ * The base class virtually every Fossify screen extends — the shared "app
+ * skeleton" an individual app fills in.
+ *
+ * It centralizes the behavior that must be identical across the suite so that
+ * apps need not re-implement it:
+ *  - runtime theming: [onCreate]/[onResume] apply the color-derived theme (see
+ *    [getThemeId]) and edge-to-edge insets when [useDynamicTheme] is set;
+ *  - a per-widget font override installed via a `LayoutInflater.Factory2`
+ *    ([installFontInflaterFactory]) and optional forced-English locale wrapping
+ *    ([attachBaseContext]);
+ *  - callback-style runtime permission requests ([handlePermission] and kin),
+ *    which hide Android's fragmented `onRequestPermissionsResult` plumbing;
+ *  - Storage Access Framework / scoped-storage (SDK 30+) flows, file copy/move,
+ *    the app-unlock gate, and the "modified app" warning.
+ *
+ * Subclasses must supply the app's identity via [getAppIconIDs],
+ * [getAppLauncherName], and [getRepositoryName]. The `companion` holds the
+ * static callbacks that carry results back across the SAF/permission activity
+ * round-trips (they are static because the activity may be recreated meanwhile).
+ */
 abstract class BaseSimpleActivity : EdgeToEdgeActivity() {
     var copyMoveCallback: ((destinationPath: String) -> Unit)? = null
     var actionOnPermission: ((granted: Boolean) -> Unit)? = null
@@ -200,6 +221,14 @@ abstract class BaseSimpleActivity : EdgeToEdgeActivity() {
         }
     }
 
+    /**
+     * Hooks the layout inflater so that every `TextView` inflated from XML has
+     * the user's chosen font applied as it is created. It installs a
+     * `LayoutInflater.Factory2` that delegates view creation to the AppCompat
+     * delegate and then calls [applyFontToTextView] on any resulting text view.
+     * Bailing out when a factory is already set avoids the "factory already set"
+     * crash and double-wrapping.
+     */
     private fun installFontInflaterFactory() {
         val inflater = layoutInflater
         if (inflater.factory2 != null) return
@@ -253,6 +282,12 @@ abstract class BaseSimpleActivity : EdgeToEdgeActivity() {
         return true
     }
 
+    /**
+     * Applies the "force English" setting by wrapping the base context in an
+     * English locale before the activity is built. Only needed below Android 13
+     * ("Tiramisu"); from 13 on, per-app language is a platform feature and the
+     * system supplies the right context, so the wrapper is skipped.
+     */
     override fun attachBaseContext(newBase: Context) {
         if (newBase.baseConfig.useEnglish && !isTiramisuPlus()) {
             super.attachBaseContext(MyContextWrapper(newBase).wrap(newBase, "en"))
@@ -1143,6 +1178,17 @@ abstract class BaseSimpleActivity : EdgeToEdgeActivity() {
         }
     }
 
+    /**
+     * Requests a single runtime permission and reports the result through
+     * [callback] — the idiom Fossify screens use everywhere instead of Android's
+     * split `requestPermissions` / `onRequestPermissionsResult` dance.
+     *
+     * If the permission is already held, [callback] fires immediately with true.
+     * Otherwise the system prompt is shown and [callback] is stashed in
+     * [actionOnPermission], to be invoked by [onRequestPermissionsResult] once
+     * the user answers. [permissionId] is a Commons `PERMISSION_*` constant,
+     * mapped to its Android permission string by `getPermissionString`.
+     */
     fun handlePermission(
         permissionId: Int,
         callback: (granted: Boolean) -> Unit
@@ -1161,6 +1207,14 @@ abstract class BaseSimpleActivity : EdgeToEdgeActivity() {
         }
     }
 
+    /**
+     * Requests media-read permission(s), accommodating Android 14+
+     * ("UpsideDownCake plus") partial photo/video access. On 14+, holding the
+     * "user selected" visual-media permission counts as granted unless [force]
+     * asks to re-prompt (so the user can widen a partial selection); on older
+     * versions it simply requires all of [permissionIds]. Result is delivered
+     * through [callback], same mechanism as [handlePermission].
+     */
     fun handlePartialMediaPermissions(
         permissionIds: Collection<Int>,
         force: Boolean = false,
@@ -1194,6 +1248,11 @@ abstract class BaseSimpleActivity : EdgeToEdgeActivity() {
         }
     }
 
+    /**
+     * Requests the POST_NOTIFICATIONS permission on Android 13+ ("Tiramisu
+     * plus"), where it first became a runtime permission. On older versions
+     * notifications need no grant, so [callback] fires immediately with true.
+     */
     fun handleNotificationPermission(callback: (granted: Boolean) -> Unit) {
         if (!isTiramisuPlus()) {
             callback(true)
@@ -1204,6 +1263,13 @@ abstract class BaseSimpleActivity : EdgeToEdgeActivity() {
         }
     }
 
+    /**
+     * The single sink for all permission answers requested via the
+     * [handlePermission] family. It clears the "asking" flag and, for the
+     * generic request code, invokes the stashed [actionOnPermission] with
+     * whether the (first) result was granted — completing the callback-style
+     * flow those helpers set up.
+     */
     override fun onRequestPermissionsResult(
         requestCode: Int,
         permissions: Array<String>,

