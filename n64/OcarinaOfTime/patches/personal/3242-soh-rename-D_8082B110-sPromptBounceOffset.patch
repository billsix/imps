From a670e3522b5f492c864d4c180f00c3e2f30e25fe Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:50 +0000
Subject: [PATCH 3242/3799] soh: rename D_8082B110 -> sPromptBounceOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the vertical offset the page prompt quad bounces by
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 28c49f4e3..025d76973 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2791,7 +2791,7 @@ static const char* gPageVtxColorCvars[][4] = {
 
 // LLM generated name (HIGH), was func_80823A0C: fills a page of quads from the shared and per-page position tables and tints their corners from the page colour set
 s16 KaleidoScope_SetPageVtx(PlayState* play, Vtx* vtx, s16 pageIndex, s16 arg3) {
-    static s16 D_8082B110 = 0;
+    static s16 sPromptBounceOffset = 0;  // was D_8082B110 [LLM:HIGH]
     static s16 D_8082B114 = 1;
     static s16 D_8082B118 = 0;
     static const Color_RGBA8 pageColors[][4] = {
@@ -2968,11 +2968,11 @@ s16 KaleidoScope_SetPageVtx(PlayState* play, Vtx* vtx, s16 pageIndex, s16 arg3)
                     D_8082B118++;
                     switch (D_8082B118) {
                         case 1:
-                            D_8082B110 = 3;
+                            sPromptBounceOffset = 3;  // was D_8082B110 [LLM:HIGH]
                             D_8082B114 = 8;
                             break;
                         case 2:
-                            D_8082B110 = 0;
+                            sPromptBounceOffset = 0;  // was D_8082B110 [LLM:HIGH]
                             D_8082B114 = 6;
                             D_8082B118 = 0;
                             break;
@@ -2988,7 +2988,7 @@ s16 KaleidoScope_SetPageVtx(PlayState* play, Vtx* vtx, s16 pageIndex, s16 arg3)
 
                 vtx[phi_a2 + 1].v.ob[0] = vtx[phi_a2 + 3].v.ob[0] = vtx[phi_a2 + 0].v.ob[0] + 8;
 
-                vtx[phi_a2 + 0].v.ob[1] = vtx[phi_a2 + 1].v.ob[1] = vtx[colorIndex + 0].v.ob[1] - D_8082B110 + 10;
+                vtx[phi_a2 + 0].v.ob[1] = vtx[phi_a2 + 1].v.ob[1] = vtx[colorIndex + 0].v.ob[1] - sPromptBounceOffset + 10;  // was D_8082B110 [LLM:HIGH]
 
                 vtx[phi_a2 + 0].v.ob[2] = vtx[phi_a2 + 1].v.ob[2] = vtx[phi_a2 + 2].v.ob[2] = vtx[phi_a2 + 3].v.ob[2] =
                     0;
