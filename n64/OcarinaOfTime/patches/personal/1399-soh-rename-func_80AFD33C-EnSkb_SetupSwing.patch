From db1dddea9680ca7feaf178ca6f43752b1e0d907f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:16:31 +0000
Subject: [PATCH 1399/3799] soh: rename func_80AFD33C -> EnSkb_SetupSwing

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: starts the attacking animation, stops the Stalchild and installs EnSkb_SetupAttack.
Defined in soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
index 07f60d42e..34de4e87e 100644
--- a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
+++ b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
@@ -23,7 +23,8 @@ void EnSkb_Burrow(EnSkb* this, PlayState* play);  // was func_80AFCFF0 [LLM:HIGH
 // LLM generated name (HIGH), was func_80AFD0A4: starts the walking animation, clears the headless yaw wobble and sets the walk speed before installing EnSkb_Advance.
 void EnSkb_SetupAdvance(EnSkb* this);  // was func_80AFD0A4 [LLM:HIGH]
 void EnSkb_Advance(EnSkb* this, PlayState* play);
-void func_80AFD33C(EnSkb* this);
+// LLM generated name (HIGH), was func_80AFD33C: starts the attacking animation, stops the Stalchild and installs EnSkb_SetupAttack.
+void EnSkb_SetupSwing(EnSkb* this);  // was func_80AFD33C [LLM:HIGH]
 void EnSkb_SetupAttack(EnSkb* this, PlayState* play);
 void func_80AFD47C(EnSkb* this);
 void func_80AFD508(EnSkb* this, PlayState* play);
@@ -205,7 +206,7 @@ void EnSkb_ChooseAction(EnSkb* this) {
         EnSkb_SetupBurrow(this);  // was func_80AFCF48 [LLM:HIGH]
     } else if (Actor_IsFacingPlayer(&this->actor, 0x11C7) &&
                (this->actor.xzDistToPlayer < (60.0f + (this->actor.params * 6.0f)))) {
-        func_80AFD33C(this);
+        EnSkb_SetupSwing(this);  // was func_80AFD33C [LLM:HIGH]
     } else {
         EnSkb_SetupAdvance(this);  // was func_80AFD0A4 [LLM:HIGH]
     }
@@ -305,11 +306,11 @@ void EnSkb_Advance(EnSkb* this, PlayState* play) {
         EnSkb_SetupBurrow(this);  // was func_80AFCF48 [LLM:HIGH]
     } else if (Actor_IsFacingPlayer(&this->actor, 0x11C7) &&
                (this->actor.xzDistToPlayer < (60.0f + (this->actor.params * 6.0f)))) {
-        func_80AFD33C(this);
+        EnSkb_SetupSwing(this);  // was func_80AFD33C [LLM:HIGH]
     }
 }
 
-void func_80AFD33C(EnSkb* this) {
+void EnSkb_SetupSwing(EnSkb* this) {
     Animation_Change(&this->skelAnime, &gStalchildAttackingAnim, 0.6f, 0.0f,
                      Animation_GetLastFrame(&gStalchildAttackingAnim), ANIMMODE_ONCE_INTERP, 4.0f);
     this->collider.base.atFlags &= ~4;
-- 
