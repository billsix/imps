From e7112cf65a6b64a0ae89ce2e42090d9181789f8f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:54 +0000
Subject: [PATCH 3281/3799] soh: rename D_8094A9EC -> sTwinrovaBeamOriginOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the point fused Twinrova records her beam origin from
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index ed20f126d..b391f12a6 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -3870,7 +3870,7 @@ void BossTw_DrawLightPillar(BossTw* this, PlayState* play) {
 }
 
 void BossTw_TwinrovaDraw(Actor* thisx, PlayState* play2) {
-    static Vec3f D_8094A9EC = { 0.0f, 200.0f, 2000.0f };
+    static Vec3f sTwinrovaBeamOriginOffset = { 0.0f, 200.0f, 2000.0f };  // was D_8094A9EC [LLM:HIGH]
     PlayState* play = play2;
     BossTw* this = (BossTw*)thisx;
 
@@ -3889,7 +3889,7 @@ void BossTw_TwinrovaDraw(Actor* thisx, PlayState* play2) {
                                   thisx);
         Matrix_Pop();
 
-        Matrix_MultVec3f(&D_8094A9EC, &this->beamOrigin);
+        Matrix_MultVec3f(&sTwinrovaBeamOriginOffset, &this->beamOrigin);  // was D_8094A9EC [LLM:HIGH]
         POLY_OPA_DISP = Gfx_SetFog2(POLY_OPA_DISP, play->lightCtx.fogColor[0], play->lightCtx.fogColor[1],
                                     play->lightCtx.fogColor[2], 0, play->lightCtx.fogNear, 1000);
     }
