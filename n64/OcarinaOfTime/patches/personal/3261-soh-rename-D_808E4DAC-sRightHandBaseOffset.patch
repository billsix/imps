Date: Tue, 8 Sep 2026 00:10:29 +0000
Subject: [PATCH 3261/3799] soh: rename D_808E4DAC -> sRightHandBaseOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the mirrored point limb 8 records under the same poses
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index da67a184a..e27dd7a93 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -3328,7 +3328,7 @@ void BossGanon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
         -1, -1, 1, -1, 3, 4, 5, -1, 6, 7, 8, -1, -1, -1, -1, -1, -1, -1, -1, 2, 12, 13, 14, 9, 10, 11, -1, -1, -1, -1,
     };
     static Vec3f sLeftHandBaseOffset = { -500.0f, 200.0f, -300.0f };  // was D_808E4DA0 [LLM:HIGH]
-    static Vec3f D_808E4DAC = { -500.0f, 200.0f, 300.0f };
+    static Vec3f sRightHandBaseOffset = { -500.0f, 200.0f, 300.0f };  // was D_808E4DAC [LLM:HIGH]
     static Vec3f D_808E4DB8 = { 0.0f, 0.0f, 0.0f };
     static Vec3f D_808E4DC4 = { 0.0f, 0.0f, 0.0f };
     static Vec3f D_808E4DD0 = { 0.0f, 0.0f, 0.0f };
@@ -3382,7 +3382,7 @@ void BossGanon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
 
         Matrix_MultVec3f(&sp28, &this->unk_220);
     } else if (limbIndex == 8) {
-        Vec3f sp1C = D_808E4DAC;
+        Vec3f sp1C = sRightHandBaseOffset;  // was D_808E4DAC [LLM:HIGH]
 
         if (this->unk_198 == 1) {
             sp1C.x += -300.0f;
