-            GfxPrint_Printf(printer, "TOTAL  %d", D_8014A6C4.heapSize);
+            GfxPrint_Printf(printer, "TOTAL  %d", gAudioHeapInitSizes.heapSize);  // was D_8014A6C4 [LLM:HIGH]
 
