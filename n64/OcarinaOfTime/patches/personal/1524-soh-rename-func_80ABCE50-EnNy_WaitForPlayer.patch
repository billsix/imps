Subject: [PATCH 1524/3799] soh: rename func_80ABCE50 -> EnNy_WaitForPlayer

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: stays stone until the player is within 160 units, then starts the shell opening.
Defined in soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
index 51a6d23d9..cc06b7e97 100644
--- a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
+++ b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
@@ -18,7 +18,8 @@ void EnNy_UpdateSwimSpeed(EnNy* this);  // was func_80ABCD40 [LLM:HIGH]
 void func_80ABCDBC(EnNy* this);
 void EnNy_TurnToStone(EnNy* this, PlayState* play);
 void func_80ABD11C(EnNy* this, PlayState* play);
-void func_80ABCE50(EnNy* this, PlayState* play);
+// LLM generated name (HIGH), was func_80ABCE50: stays stone until the player is within 160 units, then starts the shell opening.
+void EnNy_WaitForPlayer(EnNy* this, PlayState* play);  // was func_80ABCE50 [LLM:HIGH]
 void func_80ABCE90(EnNy* this, PlayState* play);
 void func_80ABCEEC(EnNy* this, PlayState* play);
 void EnNy_UpdateDeath(Actor* thisx, PlayState* PlayState);
@@ -163,7 +164,7 @@ void EnNy_UpdateSwimSpeed(EnNy* this) {
 
 // LLM generated name (HIGH), was func_80ABCD84: installs the dormant action that waits for the player to come near.
 void EnNy_SetupWaitForPlayer(EnNy* this) {
-    this->actionFunc = func_80ABCE50;
+    this->actionFunc = EnNy_WaitForPlayer;  // was func_80ABCE50 [LLM:HIGH]
 }
 
 void func_80ABCD94(EnNy* this) {
@@ -193,7 +194,7 @@ void func_80ABCE38(EnNy* this) {
     this->actionFunc = func_80ABD11C;
 }
 
-void func_80ABCE50(EnNy* this, PlayState* play) {
+void EnNy_WaitForPlayer(EnNy* this, PlayState* play) {
     if (this->actor.xyzDistToPlayerSq <= 25600.0f) {
         func_80ABCD94(this);
     }
