From cc25531738f9c56aa7b272bbdd7c5c86fcdce257 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:16 +0000
Subject: [PATCH 1472/3799] soh: rename D_80B24380 -> sCastMagicAnims

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the spell-casting animation for each twin.
Defined in soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
index e2bc9f368..dcba01806 100644
--- a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
+++ b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
@@ -62,7 +62,8 @@ static AnimationHeader* sFlyAnims[] = {  // was D_80B24378 [LLM:HIGH]
     &gKotakeKoumeFlyAnim,
 };
 
-static AnimationHeader* D_80B24380[] = {
+// LLM generated name (HIGH), was D_80B24380: the spell-casting animation for each twin.
+static AnimationHeader* sCastMagicAnims[] = {  // was D_80B24380 [LLM:HIGH]
     &gKotakeKoumeCastMagicAnim,
     &gKotakeKoumeCastMagicAnim,
 };
@@ -159,8 +160,8 @@ void EnTr_ChooseAction2(EnTr* this, PlayState* play) {
                     break;
 
                 case 6:
-                    Animation_Change(&this->skelAnime, D_80B24380[this->actor.params], 1.0f, 0.0f,
-                                     Animation_GetLastFrame(D_80B24380[this->actor.params]), ANIMMODE_ONCE, -5.0f);
+                    Animation_Change(&this->skelAnime, sCastMagicAnims[this->actor.params], 1.0f, 0.0f,  // was D_80B24380 [LLM:HIGH]
+                                     Animation_GetLastFrame(sCastMagicAnims[this->actor.params]), ANIMMODE_ONCE, -5.0f);  // was D_80B24380 [LLM:HIGH]
                     EnTr_SetupAction(this, EnTr_CrySpellcast);
                     this->animation = sFlyAnims[this->actor.params];  // was D_80B24378 [LLM:HIGH]
                     this->timer = 39;
