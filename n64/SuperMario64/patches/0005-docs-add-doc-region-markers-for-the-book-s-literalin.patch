@@ -371,6 +376,7 @@ void geo_process_camera(struct GraphNodeCamera *node) {
     gMatStackIndex--;
     FrameInterpolation_RecordCloseChild();
 }
+// doc-region-end camera_view_matrix
 
 /**
  * Process a translation / rotation node. A transformation matrix based
@@ -378,6 +384,7 @@ void geo_process_camera(struct GraphNodeCamera *node) {
  * the float and fixed point matrix stacks.
