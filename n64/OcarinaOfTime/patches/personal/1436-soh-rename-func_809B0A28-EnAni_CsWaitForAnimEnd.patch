     if (SkelAnime_Update(&this->skelAnime)) {
         this->unk_2AA++;
     }
@@ -260,13 +261,13 @@ void EnAni_Update(Actor* thisx, PlayState* play) {
                 EnAni_CsWaitForKnockback(this, play);  // was func_809B0A6C [LLM:HIGH]
