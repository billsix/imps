From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:40 +0000
Subject: [PATCH 2648/3799] soh: rename D_8082AF10 -> sPageVtxWidths1

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the widths in slot 1 of the sPageVtxWidths table
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 963f30060..0189321cf 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2632,7 +2632,8 @@ static s16 sPageVtxWidths0[] = {  // was D_8082AF0C [LLM:HIGH]
     0x0000,
     0x0000,
 };
-static s16 D_8082AF10[] = {
+// LLM generated name (HIGH), was D_8082AF10: the widths in slot 1 of the sPageVtxWidths table
+static s16 sPageVtxWidths1[] = {  // was D_8082AF10 [LLM:HIGH]
     0x0000,
     0x0000,
 };
@@ -2696,7 +2697,7 @@ static s16* D_8082B000[] = {
 };
 
 static s16* D_8082B018[] = {
-    sPageVtxWidths0, D_8082AF10, D_8082AF14, D_8082AF38, sCloudTexWidths, D_8082AF3C,  // was D_8082AAEC [LLM:HIGH]
+    sPageVtxWidths0, sPageVtxWidths1, D_8082AF14, D_8082AF38, sCloudTexWidths, D_8082AF3C,  // was D_8082AAEC [LLM:HIGH]
 };
 
 static s16* D_8082B030[] = {
