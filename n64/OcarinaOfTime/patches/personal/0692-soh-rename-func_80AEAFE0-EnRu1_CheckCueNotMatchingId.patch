From de6acc1c02e91f582064556573dae273c38919f1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:32 +0000
Subject: [PATCH 0692/3799] soh: rename func_80AEAFE0 ->
 EnRu1_CheckCueNotMatchingId

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 5b2811120..a1fa883dc 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -311,7 +311,8 @@ s32 EnRu1_CheckCueMatchingId(PlayState* play, u16 action, s32 npcActionIdx) {
     return false;
 }
 
-s32 func_80AEAFE0(PlayState* play, u16 action, s32 npcActionIdx) {
+// Name from zeldaret/oot (was func_80AEAFE0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_CheckCueNotMatchingId(PlayState* play, u16 action, s32 npcActionIdx) {
     CsCmdActorCue* csCmdNPCAction = EnRu1_GetCue(play, npcActionIdx);
 
     if ((csCmdNPCAction != NULL) && (csCmdNPCAction->action != action)) {
@@ -470,7 +471,7 @@ s32 func_80AEB458(PlayState* play, u16 action) {
 }
 
 s32 func_80AEB480(PlayState* play, u16 action) {
-    return func_80AEAFE0(play, action, 3);
+    return EnRu1_CheckCueNotMatchingId(play, action, 3);
 }
 
 void EnRu1_SpawnRipple(EnRu1* this, PlayState* play, s16 radiusMax, s16 life) {
@@ -949,7 +950,7 @@ void func_80AEC81C(EnRu1* this, PlayState* play) {
     CsCmdActorCue* csCmdNPCAction;
     s16 newRotY;
 
-    if (func_80AEAFE0(play, 1, 3)) {
+    if (EnRu1_CheckCueNotMatchingId(play, 1, 3)) {
         csCmdNPCAction = play->csCtx.npcActions[3];
         this->actor.world.pos.x = csCmdNPCAction->startPos.x;
         this->actor.world.pos.y = csCmdNPCAction->startPos.y;
@@ -2079,7 +2080,7 @@ void EnRu1_SetupRetrievingSapphireAnimation(EnRu1* this, PlayState* play) {
     CsCmdActorCue* csCmdNPCAction2;
     s16 newRotTmp;
 
-    if (func_80AEAFE0(play, 1, 3)) {
+    if (EnRu1_CheckCueNotMatchingId(play, 1, 3)) {
         frameCount = Animation_GetLastFrame(&gRutoChildWalkToAndHoldUpSapphireAnim);
         // this weird part with the redundant variable is necessary to match for some reason
         csCmdNPCAction2 = play->csCtx.npcActions[3];
@@ -2117,7 +2118,7 @@ void EnRu1_HoldUpSapphire(EnRu1* this, UNK_TYPE arg1) {
 
 // Name from zeldaret/oot (was func_80AEF79C): adopted upstream's name for this address; body verified to match upstream at 0.83. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
 void EnRu1_BringHandsDown(EnRu1* this, PlayState* play) {
-    if (func_80AEAFE0(play, 2, 3)) {
+    if (EnRu1_CheckCueNotMatchingId(play, 2, 3)) {
         Animation_Change(&this->skelAnime, &gRutoChildBringHandsDownAnim, 1.0f, 0,
                          Animation_GetLastFrame(&gRutoChildBringHandsDownAnim), ANIMMODE_ONCE, -8.0f);
         this->action = 39;
