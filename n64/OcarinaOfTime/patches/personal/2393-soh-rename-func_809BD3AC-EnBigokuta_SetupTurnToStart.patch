From 2192705d692eeed7f54b5a68e4f45711249a3980 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:25:25 +0000
Subject: [PATCH 2393/3799] soh: rename func_809BD3AC ->
 EnBigokuta_SetupTurnToStart

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: drops the octopus onto its starting point on the ring and arms the turn
Defined in soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c b/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
index 885ea5751..c1e4e56ac 100644
--- a/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
+++ b/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
@@ -298,7 +298,8 @@ void EnBigokuta_SetupJumpIn(EnBigokuta* this) {
     this->actionFunc = func_809BD8DC;
 }
 
-void func_809BD3AC(EnBigokuta* this) {
+// LLM generated name (HIGH), was func_809BD3AC: drops the octopus onto its starting point on the ring and arms the turn
+void EnBigokuta_SetupTurnToStart(EnBigokuta* this) {
     this->actor.world.pos.x = this->actor.home.pos.x + 263.0f;
     this->unk_196 = 10;
     this->actionFunc = func_809BDAE8;
@@ -451,7 +452,7 @@ void func_809BD8DC(EnBigokuta* this, PlayState* play) {
     } else if (this->unk_196 < -1) {
         this->actor.world.pos.y = this->actor.home.pos.y - (sinf((this->unk_196 + 1) * (M_PI / 10)) * 20.0f);
         if (this->unk_196 == -10) {
-            func_809BD3AC(this);
+            EnBigokuta_SetupTurnToStart(this);  // was func_809BD3AC [LLM:HIGH]
         }
     }
 }
