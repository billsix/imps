From 89eb661c391d75069eaa5c4cce158cc2e927aae7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:12:00 +0000
Subject: [PATCH 0867/3799] soh: rename func_808AE630 -> BgSpot05Soko_Descend

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: accelerates by 1.5x per frame and steps the actor down to 120 units below its home Y, killing it on arrival.
Defined in soh/src/overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c b/soh/src/overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c
index eaef55a5f..fabb9c515 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c
@@ -17,7 +17,8 @@ void BgSpot05Soko_Draw(Actor* thisx, PlayState* play);
 void BgSpot05Soko_DoNothing(BgSpot05Soko* this, PlayState* play);  // was func_808AE5A8 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808AE5B4: waits for the switch flag; on trip it plays the metal-door sfx, points the one-point camera at itself and starts the descent at speedXZ 0.5.
 void BgSpot05Soko_WaitForSwitch(BgSpot05Soko* this, PlayState* play);  // was func_808AE5B4 [LLM:HIGH]
-void func_808AE630(BgSpot05Soko* this, PlayState* play);
+// LLM generated name (HIGH), was func_808AE630: accelerates by 1.5x per frame and steps the actor down to 120 units below its home Y, killing it on arrival.
+void BgSpot05Soko_Descend(BgSpot05Soko* this, PlayState* play);  // was func_808AE630 [LLM:HIGH]
 
 const ActorInit Bg_Spot05_Soko_InitVars = {
     ACTOR_BG_SPOT05_SOKO,
@@ -84,12 +85,12 @@ void BgSpot05Soko_WaitForSwitch(BgSpot05Soko* this, PlayState* play) {
         SoundSource_PlaySfxAtFixedWorldPos(play, &this->dyna.actor.world.pos, 30, NA_SE_EV_METALDOOR_CLOSE);
         Actor_SetFocus(&this->dyna.actor, 50.0f);
         OnePointCutscene_Attention(play, &this->dyna.actor);
-        this->actionFunc = func_808AE630;
+        this->actionFunc = BgSpot05Soko_Descend;  // was func_808AE630 [LLM:HIGH]
         this->dyna.actor.speedXZ = 0.5f;
     }
 }
 
-void func_808AE630(BgSpot05Soko* this, PlayState* play) {
+void BgSpot05Soko_Descend(BgSpot05Soko* this, PlayState* play) {
     this->dyna.actor.speedXZ *= 1.5f;
     if (Math_StepToF(&this->dyna.actor.world.pos.y, this->dyna.actor.home.pos.y - 120.0f, this->dyna.actor.speedXZ) !=
         0) {
