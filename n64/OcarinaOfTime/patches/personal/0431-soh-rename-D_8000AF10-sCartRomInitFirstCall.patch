From 09a11cd35f2d2de10ec0e6133142bfb62a4e028d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:37 +0000
Subject: [PATCH 431/488] soh: rename D_8000AF10 -> sCartRomInitFirstCall

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: cleared after osCartRomInit has run once
Defined in soh/src/libultra/io/cartrominit.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/libultra/io/cartrominit.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/libultra/io/cartrominit.c b/soh/src/libultra/io/cartrominit.c
index d7e9aef4f..d0f47efff 100644
--- a/soh/src/libultra/io/cartrominit.c
+++ b/soh/src/libultra/io/cartrominit.c
@@ -11,16 +11,16 @@ OSPiHandle* osCartRomInit(void) {
     register u32 lastRelDuration;
     register u32 lastPulse;
 
-    static u32 D_8000AF10 = 1;
+    static u32 sCartRomInitFirstCall = 1;  // was D_8000AF10 [LLM:HIGH]
 
     __osPiGetAccess();
 
-    if (!D_8000AF10) {
+    if (!sCartRomInitFirstCall) {  // was D_8000AF10 [LLM:HIGH]
         __osPiRelAccess();
         return &__CartRomHandle;
     }
 
-    D_8000AF10 = 0;
+    sCartRomInitFirstCall = 0;  // was D_8000AF10 [LLM:HIGH]
     __CartRomHandle.type = DEVICE_TYPE_CART;
     __CartRomHandle.baseAddress = 0xB0000000;
     __CartRomHandle.domain = PI_DOMAIN1;
-- 
