From d38951fd540482b2f1212b790751b64494d48653 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:10 +0000
Subject: [PATCH 2448/3799] soh: rename D_80AE1B50 -> sFlatEnvColor

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the env colour EnPoh_DrawComposer uses for Flat
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index 5f754ed21..b93b288d1 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -187,7 +187,8 @@ static EnPohInfo sPoeInfo[2] = {
 
 // LLM generated name (HIGH), was D_80AE1B4C: the env colour EnPoh_DrawComposer uses for Sharp
 static Color_RGBA8 sSharpEnvColor = { 75, 20, 25, 255 };  // was D_80AE1B4C [LLM:HIGH]
-static Color_RGBA8 D_80AE1B50 = { 80, 110, 90, 255 };
+// LLM generated name (HIGH), was D_80AE1B50: the env colour EnPoh_DrawComposer uses for Flat
+static Color_RGBA8 sFlatEnvColor = { 80, 110, 90, 255 };  // was D_80AE1B50 [LLM:HIGH]
 static Color_RGBA8 D_80AE1B54 = { 90, 85, 50, 255 };
 static Color_RGBA8 D_80AE1B58 = { 100, 90, 100, 255 };
 
@@ -1137,7 +1138,7 @@ void EnPoh_DrawComposer(Actor* thisx, PlayState* play) {
         sp90 = &sSharpEnvColor;  // was D_80AE1B4C [LLM:HIGH]
         phi_t0 = &D_80AE1B54;
     } else {
-        sp90 = &D_80AE1B50;
+        sp90 = &sFlatEnvColor;  // was D_80AE1B50 [LLM:HIGH]
         phi_t0 = &D_80AE1B58;
     }
     if (this->lightColor.a == 255 || this->lightColor.a == 0) {
@@ -1203,7 +1204,7 @@ void EnPoh_DrawSoul(Actor* thisx, PlayState* play) {
         gSPMatrix(POLY_OPA_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
         gSPDisplayList(POLY_OPA_DISP++, this->info->lanternDisplayList);
         if (this->infoIdx == EN_POH_INFO_COMPOSER) {
-            Color_RGBA8* envColor = (this->actor.params == EN_POH_SHARP) ? &sSharpEnvColor : &D_80AE1B50;  // was D_80AE1B4C [LLM:HIGH]
+            Color_RGBA8* envColor = (this->actor.params == EN_POH_SHARP) ? &sSharpEnvColor : &sFlatEnvColor;  // was D_80AE1B4C [LLM:HIGH]
             s32 pad;
 
             gSPDisplayList(POLY_OPA_DISP++, gPoeComposerLanternBottomDL);
