From 3689eb825a98e8f8613b05645c267a0303c6c054 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:45 +0000
Subject: [PATCH 048/225] soh: rename func_800F8884 ->
 Audio_RemoveSfxFromBankByPos

Name source: zeldaret/oot.
Defined in soh/src/code/audio_sfx.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h  | 2 +-
 soh/src/code/audio_sfx.c | 7 ++++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 9e59fefae..317e8284f 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -2146,7 +2146,7 @@ void Audio_ProcessSoundRequest(void);
 void Audio_ChooseActiveSounds(u8 bankId);
 void Audio_PlayActiveSounds(u8 bankId);
 void Audio_StopSfxByBank(u8 bankId);
-void func_800F8884(u8, Vec3f*);
+void Audio_RemoveSfxFromBankByPos(u8, Vec3f*);  // was func_800F8884 [oot]
 void Audio_StopSfxByPosAndBank(u8, Vec3f*);
 void Audio_StopSfxByPos(Vec3f*);
 void Audio_StartSequence(u8 playerIdx, u8 seqId, u8 arg2, u16 fadeTimer);
diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index 2c7bc0f0e..68d60730f 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -579,7 +579,8 @@ void Audio_StopSfxByBank(u8 bankId) {
     Audio_RemoveMatchingSoundRequests(0, &cmp);
 }
 
-void func_800F8884(u8 bankId, Vec3f* pos) {
+// Name from zeldaret/oot, was func_800F8884: removes sound-bank entries whose posX pointer matches the given pos [oot: https://github.com/zeldaret/oot/blob/main/src/audio/game/sfx.c]
+void Audio_RemoveSfxFromBankByPos(u8 bankId, Vec3f* pos) {
     SoundBankEntry* entry;
     u8 entryIndex = gSoundBanks[bankId][0].next;
     u8 prevEntryIndex = 0;
@@ -603,7 +604,7 @@ void func_800F8884(u8 bankId, Vec3f* pos) {
 void Audio_StopSfxByPosAndBank(u8 bankId, Vec3f* pos) {
     SoundBankEntry cmp;
 
-    func_800F8884(bankId, pos);
+    Audio_RemoveSfxFromBankByPos(bankId, pos);
     cmp.sfxId = bankId << 12;
     cmp.posX = &pos->x;
     Audio_RemoveMatchingSoundRequests(1, &cmp);
@@ -614,7 +615,7 @@ void Audio_StopSfxByPos(Vec3f* pos) {
     SoundBankEntry cmp;
 
     for (i = 0; i < ARRAY_COUNT(gSoundBanks); i++) {
-        func_800F8884(i, pos);
+        Audio_RemoveSfxFromBankByPos(i, pos);
     }
     cmp.posX = &pos->x;
     Audio_RemoveMatchingSoundRequests(2, &cmp);
-- 
2.55.0

