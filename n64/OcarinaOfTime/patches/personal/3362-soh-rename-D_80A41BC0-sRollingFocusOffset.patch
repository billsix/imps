From edce7175d3365ffcf8cb1f311767d9fafc43e113 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:00 +0000
Subject: [PATCH 3362/3799] soh: rename D_80A41BC0 -> sRollingFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same for EnGo_DrawRolling
Defined in soh/src/overlays/actors/ovl_En_Go/z_en_go.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Go/z_en_go.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Go/z_en_go.c b/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
index e5cfab72a..98b0159c8 100644
--- a/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
+++ b/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
@@ -1078,7 +1078,7 @@ void EnGo_DrawCurledUp(EnGo* this, PlayState* play) {
 }
 
 void EnGo_DrawRolling(EnGo* this, PlayState* play) {
-    Vec3f D_80A41BC0 = { 0.0f, 0.0f, 0.0f };
+    Vec3f sRollingFocusOffset = { 0.0f, 0.0f, 0.0f };  // was D_80A41BC0 [LLM:HIGH]
 
     OPEN_DISPS(play->state.gfxCtx);
 
@@ -1088,7 +1088,7 @@ void EnGo_DrawRolling(EnGo* this, PlayState* play) {
                      MTXMODE_APPLY);
     gSPMatrix(POLY_OPA_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
     gSPDisplayList(POLY_OPA_DISP++, gGoronDL_00C140);
-    Matrix_MultVec3f(&D_80A41BC0, &this->actor.focus.pos);
+    Matrix_MultVec3f(&sRollingFocusOffset, &this->actor.focus.pos);  // was D_80A41BC0 [LLM:HIGH]
     Matrix_Pop();
 
     CLOSE_DISPS(play->state.gfxCtx);
