-    if (D_8082A104 >= D_8082A070[D_8082A118][0]) {
+    sp226 = ABS(D_8082A104 - sCursorColorSets[D_8082A118][0]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
+    sp224 = ABS(D_8082A108 - sCursorColorSets[D_8082A118][1]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
+    sp222 = ABS(D_8082A10C - sCursorColorSets[D_8082A118][2]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
+    sp220 = ABS(D_8082A110 - sCursorColorSets[D_8082A118][3]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
+    if (D_8082A104 >= sCursorColorSets[D_8082A118][0]) {  // was D_8082A070 [LLM:HIGH]
         D_8082A104 -= sp226;
     } else {
         D_8082A104 += sp226;
     }
-    if (D_8082A108 >= D_8082A070[D_8082A118][1]) {
+    if (D_8082A108 >= sCursorColorSets[D_8082A118][1]) {  // was D_8082A070 [LLM:HIGH]
         D_8082A108 -= sp224;
     } else {
         D_8082A108 += sp224;
     }
-    if (D_8082A10C >= D_8082A070[D_8082A118][2]) {
