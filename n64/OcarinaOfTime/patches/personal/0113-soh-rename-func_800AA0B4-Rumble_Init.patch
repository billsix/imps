From e6d14667f2622da0ca985f0eaea554220ad59ccf Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:53 +0000
Subject: [PATCH 113/225] soh: rename func_800AA0B4 -> Rumble_Init

Name source: zeldaret/oot.
Defined in soh/src/code/z_rumble.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h | 2 +-
 soh/src/code/game.c     | 2 +-
 soh/src/code/z_rumble.c | 3 ++-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 4745d4ca5..f0f9e0aee 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1385,7 +1385,7 @@ void SsSram_ReadWrite(uintptr_t addr, void* dramAddr, size_t size, s32 direction
 void Rumble_Update(PadMgr*, s32);  // was func_800A9F30 [oot]
 void Rumble_Override(f32, u8, u8, u8);  // was func_800A9F6C [oot]
 void Rumble_Request(f32, u8, u8, u8);
-void func_800AA0B4();
+void Rumble_Init();  // was func_800AA0B4 [oot]
 void func_800AA0F0(void);
 u32 func_800AA148();
 void func_800AA15C();
diff --git a/soh/src/code/game.c b/soh/src/code/game.c
index 1ffbfcaa0..6121a4917 100644
--- a/soh/src/code/game.c
+++ b/soh/src/code/game.c
@@ -453,7 +453,7 @@ void GameState_Init(GameState* gameState, GameStateFunc init, GraphicsContext* g
         ViMode_Init(&sViMode);
     }
     SpeedMeter_Init(&sGameStateSpeedMeter);
-    func_800AA0B4();
+    Rumble_Init();
     osSendMesgPtr(&gameState->gfxCtx->queue, NULL, OS_MESG_BLOCK);
 
     endTime = osGetTime();
diff --git a/soh/src/code/z_rumble.c b/soh/src/code/z_rumble.c
index 58cbd44c0..f7162d2c7 100644
--- a/soh/src/code/z_rumble.c
+++ b/soh/src/code/z_rumble.c
@@ -61,7 +61,8 @@ void Rumble_Request(f32 a, u8 b, u8 c, u8 d) {
     }
 }
 
-void func_800AA0B4(void) {
+// Name from zeldaret/oot src/code/z_rumble.c (was func_800AA0B4): inits the manager and registers Rumble_Update retrace callback. Source: https://github.com/zeldaret/oot/blob/main/src/code/z_rumble.c
+void Rumble_Init(void) {
     RumbleMgr_Init(&sRumbleMgr);
 
     gPadMgr.retraceCallback = Rumble_Update;
