Subject: [PATCH 2781/3799] soh: rename func_80035BFC -> Actor_GetNpcTextId

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the big per-NPC switch returning the text id for the caller's index from the story flags
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 9a71b1ee4..f3c6eaf86 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -5152,7 +5152,8 @@ void Flags_UnsetRandomizerInf(RandomizerInf flag) {
     }
 }
 
-u32 func_80035BFC(PlayState* play, s16 arg1) {
+// LLM generated name (HIGH), was func_80035BFC: the big per-NPC switch returning the text id for the caller's index from the story flags
+u32 Actor_GetNpcTextId(PlayState* play, s16 arg1) {
     u16 retTextId = 0;
 
     switch (arg1) {
@@ -6363,7 +6364,7 @@ s32 func_800374E0(PlayState* play, Actor* actor, u16 textId) {
 }
 
 u16 func_80037C30(PlayState* play, s16 arg1) {
-    return func_80035BFC(play, arg1);
+    return Actor_GetNpcTextId(play, arg1);  // was func_80035BFC [LLM:HIGH]
 }
 
 s32 func_80037C5C(PlayState* play, s16 arg1, u16 textId) {
