From 1767c7971626ec3901ebc2f789e69f0f734defa4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:47:47 +0000
Subject: [PATCH 1829/3799] soh: rename D_80A6AF64 -> sAnimPlaySpeeds

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the base playback rate for each of the foal's animations, scaled by its own speed for the three moving gaits.
Defined in soh/src/overlays/actors/ovl_En_Horse_Link_Child/z_en_horse_link_child.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_En_Horse_Link_Child/z_en_horse_link_child.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Horse_Link_Child/z_en_horse_link_child.c b/soh/src/overlays/actors/ovl_En_Horse_Link_Child/z_en_horse_link_child.c
index 165e93d43..7dc934f9b 100644
--- a/soh/src/overlays/actors/ovl_En_Horse_Link_Child/z_en_horse_link_child.c
+++ b/soh/src/overlays/actors/ovl_En_Horse_Link_Child/z_en_horse_link_child.c
@@ -118,19 +118,20 @@ void func_80A6948C(EnHorseLinkChild* this) {
     }
 }
 
-static f32 D_80A6AF64[] = { 1.0f, 1.0f, 1.5f, 1.5f, 1.5f };
+// LLM generated name (HIGH), was D_80A6AF64: the base playback rate for each of the foal's animations, scaled by its own speed for the three moving gaits.
+static f32 sAnimPlaySpeeds[] = { 1.0f, 1.0f, 1.5f, 1.5f, 1.5f };  // was D_80A6AF64 [LLM:HIGH]
 
 f32 func_80A695A4(EnHorseLinkChild* this) {
     f32 result;
 
     if (this->animationIdx == 2) {
-        result = D_80A6AF64[this->animationIdx] * this->actor.speedXZ * (1.0f / 2.0f);
+        result = sAnimPlaySpeeds[this->animationIdx] * this->actor.speedXZ * (1.0f / 2.0f);  // was D_80A6AF64 [LLM:HIGH]
     } else if (this->animationIdx == 3) {
-        result = D_80A6AF64[this->animationIdx] * this->actor.speedXZ * (1.0f / 3.0f);
+        result = sAnimPlaySpeeds[this->animationIdx] * this->actor.speedXZ * (1.0f / 3.0f);  // was D_80A6AF64 [LLM:HIGH]
     } else if (this->animationIdx == 4) {
-        result = D_80A6AF64[this->animationIdx] * this->actor.speedXZ * (1.0f / 5.0f);
+        result = sAnimPlaySpeeds[this->animationIdx] * this->actor.speedXZ * (1.0f / 5.0f);  // was D_80A6AF64 [LLM:HIGH]
     } else {
-        result = D_80A6AF64[this->animationIdx];
+        result = sAnimPlaySpeeds[this->animationIdx];  // was D_80A6AF64 [LLM:HIGH]
     }
 
     return result;
@@ -459,7 +460,7 @@ void func_80A6A5A4(EnHorseLinkChild* this, PlayState* play) {
         if (SkelAnime_Update(&this->skin.skelAnime)) {
             if (Math_CosS(yawDiff) < 0.0f) {
                 this->animationIdx = 2;
-                Animation_Change(&this->skin.skelAnime, sAnimations[this->animationIdx], D_80A6AF64[this->animationIdx],
+                Animation_Change(&this->skin.skelAnime, sAnimations[this->animationIdx], sAnimPlaySpeeds[this->animationIdx],  // was D_80A6AF64 [LLM:HIGH]
                                  0.0f, Animation_GetLastFrame(sAnimations[this->animationIdx]), ANIMMODE_ONCE, -5.0f);
             } else {
                 func_80A6A4DC(this);
