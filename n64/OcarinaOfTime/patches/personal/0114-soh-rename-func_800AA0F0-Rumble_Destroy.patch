 void Rumble_Request(f32, u8, u8, u8);
 void Rumble_Init();  // was func_800AA0B4 [oot]
-void func_800AA0F0(void);
+void Rumble_Destroy(void);  // was func_800AA0F0 [oot]
 u32 func_800AA148();
 void func_800AA15C();
 void Rumble_ClearRequests();
diff --git a/soh/src/code/game.c b/soh/src/code/game.c
index 6121a4917..77bb64022 100644
--- a/soh/src/code/game.c
+++ b/soh/src/code/game.c
@@ -474,7 +474,7 @@ void GameState_Destroy(GameState* gameState) {
