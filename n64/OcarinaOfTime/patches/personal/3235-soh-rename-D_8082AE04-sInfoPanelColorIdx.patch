From 3dba6173bd8efe0f96dbc4500ea54016643eb0b4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:49 +0000
Subject: [PATCH 3235/3799] soh: rename D_8082AE04 -> sInfoPanelColorIdx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: which of those two sets the panel is easing toward
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_scope_PAL.c   | 28 +++++++++----------
 1 file changed, 14 insertions(+), 14 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 3e1696b1f..9a03b40a2 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -1962,7 +1962,7 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
         { 100, 100, 150, 220 },
     };
     static s16 sInfoPanelFadeTimer = 20;  // was D_8082AE00 [LLM:HIGH]
-    static s16 D_8082AE04 = 0;
+    static s16 sInfoPanelColorIdx = 0;  // was D_8082AE04 [LLM:HIGH]
     static s16 D_8082AE08[] = {
         10, 16, 16, 17, 12, 13, 18, 17, 17, 19, 13, 21, 20, 21, 14, 15, 15, 15, 11, 14,
     };
@@ -1991,26 +1991,26 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
 
     OPEN_DISPS(play->state.gfxCtx);
 
-    stepR = ABS(D_808321A0 - sInfoPanelColorSets[D_8082AE04][0]) / sInfoPanelFadeTimer;  // was D_8082ADF0 [LLM:HIGH]
-    stepG = ABS(D_808321A2 - sInfoPanelColorSets[D_8082AE04][1]) / sInfoPanelFadeTimer;  // was D_8082ADF0 [LLM:HIGH]
-    stepB = ABS(D_808321A4 - sInfoPanelColorSets[D_8082AE04][2]) / sInfoPanelFadeTimer;  // was D_8082ADF0 [LLM:HIGH]
-    stepA = ABS(D_808321A6 - sInfoPanelColorSets[D_8082AE04][3]) / sInfoPanelFadeTimer;  // was D_8082ADF0 [LLM:HIGH]
-    if (D_808321A0 >= sInfoPanelColorSets[D_8082AE04][0]) {  // was D_8082ADF0 [LLM:HIGH]
+    stepR = ABS(D_808321A0 - sInfoPanelColorSets[sInfoPanelColorIdx][0]) / sInfoPanelFadeTimer;  // was D_8082ADF0 [LLM:HIGH]
+    stepG = ABS(D_808321A2 - sInfoPanelColorSets[sInfoPanelColorIdx][1]) / sInfoPanelFadeTimer;  // was D_8082ADF0 [LLM:HIGH]
+    stepB = ABS(D_808321A4 - sInfoPanelColorSets[sInfoPanelColorIdx][2]) / sInfoPanelFadeTimer;  // was D_8082ADF0 [LLM:HIGH]
+    stepA = ABS(D_808321A6 - sInfoPanelColorSets[sInfoPanelColorIdx][3]) / sInfoPanelFadeTimer;  // was D_8082ADF0 [LLM:HIGH]
+    if (D_808321A0 >= sInfoPanelColorSets[sInfoPanelColorIdx][0]) {  // was D_8082ADF0 [LLM:HIGH]
         D_808321A0 -= stepR;
     } else {
         D_808321A0 += stepR;
     }
-    if (D_808321A2 >= sInfoPanelColorSets[D_8082AE04][1]) {  // was D_8082ADF0 [LLM:HIGH]
+    if (D_808321A2 >= sInfoPanelColorSets[sInfoPanelColorIdx][1]) {  // was D_8082ADF0 [LLM:HIGH]
         D_808321A2 -= stepG;
     } else {
         D_808321A2 += stepG;
     }
-    if (D_808321A4 >= sInfoPanelColorSets[D_8082AE04][2]) {  // was D_8082ADF0 [LLM:HIGH]
+    if (D_808321A4 >= sInfoPanelColorSets[sInfoPanelColorIdx][2]) {  // was D_8082ADF0 [LLM:HIGH]
         D_808321A4 -= stepB;
     } else {
         D_808321A4 += stepB;
     }
-    if (D_808321A6 >= sInfoPanelColorSets[D_8082AE04][3]) {  // was D_8082ADF0 [LLM:HIGH]
+    if (D_808321A6 >= sInfoPanelColorSets[sInfoPanelColorIdx][3]) {  // was D_8082ADF0 [LLM:HIGH]
         D_808321A6 -= stepA;
     } else {
         D_808321A6 += stepA;
@@ -2018,12 +2018,12 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
 
     sInfoPanelFadeTimer--;  // was D_8082AE00 [LLM:HIGH]
     if (sInfoPanelFadeTimer == 0) {  // was D_8082AE00 [LLM:HIGH]
-        D_808321A0 = sInfoPanelColorSets[D_8082AE04][0];  // was D_8082ADF0 [LLM:HIGH]
-        D_808321A2 = sInfoPanelColorSets[D_8082AE04][1];  // was D_8082ADF0 [LLM:HIGH]
-        D_808321A4 = sInfoPanelColorSets[D_8082AE04][2];  // was D_8082ADF0 [LLM:HIGH]
-        D_808321A6 = sInfoPanelColorSets[D_8082AE04][3];  // was D_8082ADF0 [LLM:HIGH]
+        D_808321A0 = sInfoPanelColorSets[sInfoPanelColorIdx][0];  // was D_8082ADF0 [LLM:HIGH]
+        D_808321A2 = sInfoPanelColorSets[sInfoPanelColorIdx][1];  // was D_8082ADF0 [LLM:HIGH]
+        D_808321A4 = sInfoPanelColorSets[sInfoPanelColorIdx][2];  // was D_8082ADF0 [LLM:HIGH]
+        D_808321A6 = sInfoPanelColorSets[sInfoPanelColorIdx][3];  // was D_8082ADF0 [LLM:HIGH]
         sInfoPanelFadeTimer = ZREG(28);  // was D_8082AE00 [LLM:HIGH]
-        D_8082AE04 ^= 1;
+        sInfoPanelColorIdx ^= 1;  // was D_8082AE04 [LLM:HIGH]
     }
 
     temp = pauseCtx->infoPanelOffsetY - 76;
-- 
2.55.0

