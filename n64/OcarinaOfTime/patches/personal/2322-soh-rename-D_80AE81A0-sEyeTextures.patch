From f7804b1ca127770851a4ee2c30e78d31301c821f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:22:12 +0000
Subject: [PATCH 2322/3799] soh: rename D_80AE81A0 -> sEyeTextures

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the three eye textures indexed by the blink counter
Defined in soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c b/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
index ac1e6394b..f85d36108 100644
--- a/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
+++ b/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
@@ -39,7 +39,8 @@ void EnRl_DrawOpa(EnRl* this, PlayState* play);  // was func_80AE7FDC [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AE7D94: draw config 2: draws the skeleton translucently at the current alpha
 void EnRl_DrawXlu(EnRl* this, PlayState* play);  // was func_80AE7D94 [LLM:HIGH]
 
-static void* D_80AE81A0[] = { object_rl_Tex_003620, object_rl_Tex_003960, object_rl_Tex_003B60 };
+// LLM generated name (HIGH), was D_80AE81A0: the three eye textures indexed by the blink counter
+static void* sEyeTextures[] = { object_rl_Tex_003620, object_rl_Tex_003960, object_rl_Tex_003B60 };  // was D_80AE81A0 [LLM:HIGH]
 static s32 D_80AE81AC = 0;
 
 void EnRl_Destroy(Actor* thisx, PlayState* play) {
@@ -328,7 +329,7 @@ void EnRl_Action7(EnRl* this, PlayState* play) {
 void EnRl_DrawXlu(EnRl* this, PlayState* play) {
     s32 pad[2];
     s16 temp = this->eyeTextureIndex;
-    void* tex = D_80AE81A0[temp];
+    void* tex = sEyeTextures[temp];  // was D_80AE81A0 [LLM:HIGH]
     SkelAnime* skelAnime = &this->skelAnime;
 
     OPEN_DISPS(play->state.gfxCtx);
@@ -377,7 +378,7 @@ void EnRl_DrawNothing(EnRl* this, PlayState* play) {
 void EnRl_DrawOpa(EnRl* this, PlayState* play) {
     s32 pad[2];
     s16 temp = this->eyeTextureIndex;
-    void* tex = D_80AE81A0[temp];
+    void* tex = sEyeTextures[temp];  // was D_80AE81A0 [LLM:HIGH]
     SkelAnime* skelAnime = &this->skelAnime;
 
     OPEN_DISPS(play->state.gfxCtx);
