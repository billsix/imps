Subject: [PATCH 0416/3799] soh: rename func_80AEAF58 -> EnRu1_GetCue

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.82.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 9fc8d6565..5e2f00cd6 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -253,7 +253,8 @@ s32 EnRu1_IsCsStateIdle(PlayState* play) {
     return false;
 }
 
-CsCmdActorCue* func_80AEAF58(PlayState* play, s32 npcActionIdx) {
+// Name from zeldaret/oot (was func_80AEAF58): adopted upstream's name for this address; body verified to match upstream at 0.82. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+CsCmdActorCue* EnRu1_GetCue(PlayState* play, s32 npcActionIdx) {
     s32 pad[2];
     CsCmdActorCue* ret = NULL;
 
@@ -264,7 +265,7 @@ CsCmdActorCue* func_80AEAF58(PlayState* play, s32 npcActionIdx) {
 }
 
 s32 func_80AEAFA0(PlayState* play, u16 action, s32 npcActionIdx) {
