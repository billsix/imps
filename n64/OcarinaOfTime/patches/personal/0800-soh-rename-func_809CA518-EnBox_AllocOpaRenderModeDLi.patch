From b0eee2d4f64af06959647d7ad90f4289af359d73 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:23:51 +0000
Subject: [PATCH 0800/3799] soh: rename func_809CA518 ->
 EnBox_AllocOpaRenderModeDList

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the opaque counterpart of EnBox_AllocXluRenderModeDList -- same two-command shape, but a ZMODE_OPA render mode with G_RM_AA_ZB_OPA_SURF2.
Defined in soh/src/overlays/actors/ovl_En_Box/z_en_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Box/z_en_box.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Box/z_en_box.c b/soh/src/overlays/actors/ovl_En_Box/z_en_box.c
index 11178241a..397c96ecf 100644
--- a/soh/src/overlays/actors/ovl_En_Box/z_en_box.c
+++ b/soh/src/overlays/actors/ovl_En_Box/z_en_box.c
@@ -692,7 +692,8 @@ Gfx* EnBox_AllocXluRenderModeDList(GraphicsContext* gfxCtx) {
     return dList;
 }
 
-Gfx* func_809CA518(GraphicsContext* gfxCtx) {
+// LLM generated name (HIGH), was func_809CA518: the opaque counterpart of EnBox_AllocXluRenderModeDList -- same two-command shape, but a ZMODE_OPA render mode with G_RM_AA_ZB_OPA_SURF2.
+Gfx* EnBox_AllocOpaRenderModeDList(GraphicsContext* gfxCtx) {
     Gfx* dList;
     Gfx* dListHead;
 
@@ -731,7 +732,7 @@ void EnBox_Draw(Actor* thisx, PlayState* play) {
         Gfx_SetupDL_25Xlu(play->state.gfxCtx);
         gDPSetEnvColor(POLY_XLU_DISP++, 0, 0, 0, this->alpha);
         if (this->type == ENBOX_TYPE_4 || this->type == ENBOX_TYPE_6) {
-            gSPSegment(POLY_XLU_DISP++, 0x08, func_809CA518(play->state.gfxCtx));
+            gSPSegment(POLY_XLU_DISP++, 0x08, EnBox_AllocOpaRenderModeDList(play->state.gfxCtx));  // was func_809CA518 [LLM:HIGH]
         } else {
             gSPSegment(POLY_XLU_DISP++, 0x08, EnBox_AllocXluRenderModeDList(play->state.gfxCtx));  // was func_809CA4A0 [LLM:HIGH]
         }
