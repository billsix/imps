-                func_8086DB24(this);
+                BgBdanSwitch_SetupHeavyDone(this);  // was func_8086DB24 [LLM:HIGH]
             } else {
                 BgBdanSwitch_SetupHeavyIdle(this);  // was func_8086D86C [LLM:HIGH]
             }
@@ -375,7 +376,7 @@ void BgBdanSwitch_HeavyFullPress(BgBdanSwitch* this, PlayState* play) {
     if ((Camera_GetTargetCategory() == this->dyna.actor.category) || (this->unk_1DA <= 0)) {  // was func_8005B198 [LLM:HIGH]
         this->unk_1C8 -= 0.2f;
