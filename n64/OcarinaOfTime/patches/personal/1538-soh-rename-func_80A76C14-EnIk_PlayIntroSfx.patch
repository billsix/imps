From 8f50e49e83adc1ca6c076928551218229e24973b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:25:46 +0000
Subject: [PATCH 1538/3799] soh: rename func_80A76C14 -> EnIk_PlayIntroSfx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: fires the Iron Knuckle's wake-up, footstep, armour, finger and axe-wave sounds on their fixed frames of the introduction animation.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index 13f6aa12a..deb33c218 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -1025,7 +1025,8 @@ void EnIk_StartMusic(void) {
     func_800F5ACC(NA_BGM_MINI_BOSS);
 }
 
-void func_80A76C14(EnIk* this) {
+// LLM generated name (HIGH), was func_80A76C14: fires the Iron Knuckle's wake-up, footstep, armour, finger and axe-wave sounds on their fixed frames of the introduction animation.
+void EnIk_PlayIntroSfx(EnIk* this) {
     if (Animation_OnFrame(&this->skelAnime, 1.0f)) {
         Audio_PlaySfxGeneral(NA_SE_EN_IRONNACK_WAKEUP, &this->actor.projectedPos, 4, &gSfxDefaultFreqAndVolScale,
                              &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
@@ -1349,7 +1350,7 @@ void EnIk_CsAction2(EnIk* this, PlayState* play) {
     s32 sp24;
 
     sp24 = EnIk_UpdateSkelAnime(this);
-    func_80A76C14(this);
+    EnIk_PlayIntroSfx(this);  // was func_80A76C14 [LLM:HIGH]
     EnIk_UpdateBgCheckInfo(this, play);
     EnIk_HandleCsCues(this, play);
     EnIk_HandleEnemyChange(this, play, sp24);
