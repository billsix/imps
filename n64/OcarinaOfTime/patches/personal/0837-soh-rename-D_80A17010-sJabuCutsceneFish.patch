From cc5996e32725179a2b6bc75072274fd8c6629393 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:46 +0000
Subject: [PATCH 0837/3799] soh: rename D_80A17010 -> sJabuCutsceneFish

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c.
---
 soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c b/soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c
index c48398c97..148f0293d 100644
--- a/soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c
+++ b/soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c
@@ -34,7 +34,8 @@ void EnFish_Unique_SetupSwimIdle(EnFish* this);
 void EnFish_Unique_SwimIdle(EnFish* this, PlayState* play);
 
 // Used in the cutscene functions
-static Actor* D_80A17010 = NULL;
+// Name from zeldaret/oot (was D_80A17010): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Fish/z_en_fish.c]
+static Actor* sJabuCutsceneFish = NULL;
 static f32 D_80A17014 = 0.0f;
 static f32 D_80A17018 = 0.0f;
 
@@ -108,8 +109,8 @@ void EnFish_BeginRespawn(EnFish* this) {
 void EnFish_SetCutsceneData(EnFish* this) {
     Actor* thisx = &this->actor;
 
-    if (D_80A17010 == NULL) {
-        D_80A17010 = thisx;
+    if (sJabuCutsceneFish == NULL) {
+        sJabuCutsceneFish = thisx;
         Actor_SetScale(thisx, 0.01f);
         thisx->draw = EnFish_Draw;
         thisx->shape.rot.x = 0;
@@ -124,7 +125,7 @@ void EnFish_SetCutsceneData(EnFish* this) {
 }
 
 void EnFish_ClearCutsceneData(EnFish* this) {
-    D_80A17010 = NULL;
+    sJabuCutsceneFish = NULL;
     D_80A17014 = 0.0f;
     D_80A17018 = 0.0f;
 }
@@ -743,12 +744,12 @@ void EnFish_RespawningUpdate(EnFish* this, PlayState* play) {
 void EnFish_Update(Actor* thisx, PlayState* play) {
     EnFish* this = (EnFish*)thisx;
 
-    if ((D_80A17010 == NULL) && (this->actor.params == FISH_DROPPED) && (play->csCtx.state != 0) &&
+    if ((sJabuCutsceneFish == NULL) && (this->actor.params == FISH_DROPPED) && (play->csCtx.state != 0) &&
         (play->csCtx.npcActions[1] != NULL)) {
         EnFish_SetCutsceneData(this);
     }
 
-    if ((D_80A17010 != NULL) && (&this->actor == D_80A17010)) {
+    if ((sJabuCutsceneFish != NULL) && (&this->actor == sJabuCutsceneFish)) {
         EnFish_UpdateCutscene(this, play);
     } else if (this->respawnTimer > 0) {
         this->respawnTimer--;
@@ -764,4 +765,4 @@ void EnFish_Draw(Actor* thisx, PlayState* play) {
     Gfx_SetupDL_25Opa(play->state.gfxCtx);
     SkelAnime_DrawSkeletonOpa(play, &this->skelAnime, NULL, NULL, NULL);
     Collider_UpdateSpheres(0, &this->collider);
-}
\ No newline at end of file
+}
