From 85b5ea417ebd28f00fbf87979b3907933867c032 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:08:22 +0000
Subject: [PATCH 1289/3799] soh: rename D_80889E7C -> sTravelYaws

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the binary angle added to each variant's shape.rot.y to give the direction it slides in.
Defined in soh/src/overlays/actors/ovl_Bg_Hidan_Kousi/z_bg_hidan_kousi.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Hidan_Kousi/z_bg_hidan_kousi.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Kousi/z_bg_hidan_kousi.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Kousi/z_bg_hidan_kousi.c
index 4b3638f2a..bb89cbece 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Kousi/z_bg_hidan_kousi.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Kousi/z_bg_hidan_kousi.c
@@ -47,7 +47,8 @@ static CollisionHeader* sMetalFencesCollisions[] = {
     &gFireTempleMetalFence2Col,
 };
 
-static s16 D_80889E7C[] = {
+// LLM generated name (HIGH), was D_80889E7C: the binary angle added to each variant's shape.rot.y to give the direction it slides in.
+static s16 sTravelYaws[] = {  // was D_80889E7C [LLM:HIGH]
     0x4000,
     0xC000,
     0xC000,
@@ -81,7 +82,7 @@ void BgHidanKousi_Init(Actor* thisx, PlayState* play) {
 
     CollisionHeader_GetVirtual(sMetalFencesCollisions[thisx->params & 0xFF], &colHeader);
     this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, thisx, colHeader);
-    thisx->world.rot.y = D_80889E7C[this->dyna.actor.params & 0xFF] + thisx->shape.rot.y;
+    thisx->world.rot.y = sTravelYaws[this->dyna.actor.params & 0xFF] + thisx->shape.rot.y;  // was D_80889E7C [LLM:HIGH]
     if (Flags_GetSwitch(play, (thisx->params >> 8) & 0xFF)) {
         func_80889ACC(this);
         BgHidanKousi_SetupAction(this, func_80889D28);
-- 
