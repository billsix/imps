From 3b3f6f153a1869c54647b1ea313c00099ccbed61 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:47:00 +0000
Subject: [PATCH 1813/3799] soh: rename D_809AA530 -> sDragThresholds

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-mode distance thresholds the drag falloff functions compare against before scaling the acceleration down.
Defined in soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c    | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
index eca73e011..2308e37c4 100644
--- a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
+++ b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
@@ -191,13 +191,14 @@ f32 func_809A9DD8(f32 arg0, s32 arg1) {
     return 1.0f;
 }
 
-static f32 D_809AA530[] = {
+// LLM generated name (HIGH), was D_809AA530: the per-mode distance thresholds the drag falloff functions compare against before scaling the acceleration down.
+static f32 sDragThresholds[] = {  // was D_809AA530 [LLM:HIGH]
     1.0f, 100.0f, 40.0f, 5.0f, 100.0f, 40.0f, 5.0f, 100.0f, 40.0f, 5.0f,
 };
 
 f32 func_809A9DEC(f32 arg0, s32 arg1) {
-    if (D_809AA530[arg1] < arg0) {
-        return D_809AA530[arg1] / arg0;
+    if (sDragThresholds[arg1] < arg0) {  // was D_809AA530 [LLM:HIGH]
+        return sDragThresholds[arg1] / arg0;  // was D_809AA530 [LLM:HIGH]
     } else {
         return 1.0f;
     }
@@ -206,8 +207,8 @@ f32 func_809A9DEC(f32 arg0, s32 arg1) {
 f32 func_809A9E28(f32 arg0, s32 arg1) {
     f32 temp = SQ(arg0);
 
-    if (D_809AA530[arg1] < temp) {
-        return D_809AA530[arg1] / temp;
+    if (sDragThresholds[arg1] < temp) {  // was D_809AA530 [LLM:HIGH]
+        return sDragThresholds[arg1] / temp;  // was D_809AA530 [LLM:HIGH]
     } else {
         return 1.0f;
     }
-- 
