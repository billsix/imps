# The upstream checkouts and everything the build produces are disposable;
# only the scripts, the `repos` manifest, and patches/ are versioned. fetch.sh
# clones each upstream into checkout/<name>/.
/checkout/

# Android/Gradle build outputs and caches (produced by `make build` /
# `make check-comment-only` inside the container, or a host build).
/out/
**/build/
**/.gradle/

# Podman image export tarballs (Makefile image-export) — large, never commit.
fossify-builder-*.tar
