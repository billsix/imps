From 938093e2a9738b9159b0aec0dab12b0a555373f4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:47 +0000
Subject: [PATCH 0839/3799] soh: rename D_80A17018 -> sJabuCutsceneOffsetYSpeed

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c.
---
 soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c b/soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c
index 0b61a3ee1..697c1469b 100644
--- a/soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c
+++ b/soh/src/overlays/actors/ovl_En_Fish/z_en_fish.c
@@ -38,7 +38,8 @@ void EnFish_Unique_SwimIdle(EnFish* this, PlayState* play);
 static Actor* sJabuCutsceneFish = NULL;
 // Name from zeldaret/oot (was D_80A17014): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Fish/z_en_fish.c]
 static f32 sJabuCutsceneOffsetY = 0.0f;
-static f32 D_80A17018 = 0.0f;
+// Name from zeldaret/oot (was D_80A17018): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Fish/z_en_fish.c]
+static f32 sJabuCutsceneOffsetYSpeed = 0.0f;
 
 static ColliderJntSphElementInit sJntSphElementsInit[1] = {
     {
@@ -119,7 +120,7 @@ void EnFish_SetCutsceneData(EnFish* this) {
         thisx->shape.rot.z = 0x4000;
         thisx->shape.yOffset = 600.0f;
         sJabuCutsceneOffsetY = 10.0f;
-        D_80A17018 = 0.0f;
+        sJabuCutsceneOffsetYSpeed = 0.0f;
         thisx->flags |= ACTOR_FLAG_UPDATE_CULLING_DISABLED;
         EnFish_SetOutOfWaterAnimation(this);
     }
@@ -128,7 +129,7 @@ void EnFish_SetCutsceneData(EnFish* this) {
 void EnFish_ClearCutsceneData(EnFish* this) {
     sJabuCutsceneFish = NULL;
     sJabuCutsceneOffsetY = 0.0f;
-    D_80A17018 = 0.0f;
+    sJabuCutsceneOffsetYSpeed = 0.0f;
 }
 
 void EnFish_Init(Actor* thisx, PlayState* play) {
@@ -588,19 +589,19 @@ void EnFish_Cutscene_FlopOnGround(EnFish* this, PlayState* play) {
     f32 sp24 = Math_SinS(this->slowPhase);
     f32 sp20 = Math_SinS(this->fastPhase);
 
-    sJabuCutsceneOffsetY += D_80A17018;
+    sJabuCutsceneOffsetY += sJabuCutsceneOffsetYSpeed;
 
     if (sJabuCutsceneOffsetY <= 1.0f) {
         sJabuCutsceneOffsetY = 1.0f;
 
         if (Rand_ZeroOne() < 0.1f) {
-            D_80A17018 = (Rand_ZeroOne() * 3.0f) + 2.0f;
+            sJabuCutsceneOffsetYSpeed = (Rand_ZeroOne() * 3.0f) + 2.0f;
             Audio_PlayActorSound2(&this->actor, NA_SE_EV_FISH_LEAP);
         } else {
-            D_80A17018 = 0.0f;
+            sJabuCutsceneOffsetYSpeed = 0.0f;
         }
     } else {
-        D_80A17018 -= 0.4f;
+        sJabuCutsceneOffsetYSpeed -= 0.4f;
     }
 
     this->skelAnime.playSpeed = ((sp24 + sp20) * 0.5f) + 2.0f;
-- 
2.55.0

