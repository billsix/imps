From 785b3236b5ca933f3b68b5d62e57bfbe60c58457 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:49:08 +0000
Subject: [PATCH 1114/3799] soh: rename func_800DB828 ->
 AudioSynth_LoadRingBufferResampledScaled

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same load and resample as AudioSynth_LoadRingBufferResampled, except it first derives the item's forward and reverse resample ratios from the requested sample count and uses those instead of the reverb's fixed pitch.
Defined in soh/src/code/audio_synthesis.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_synthesis.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_synthesis.c b/soh/src/code/audio_synthesis.c
index f3314e33e..bbd5a4124 100644
--- a/soh/src/code/audio_synthesis.c
+++ b/soh/src/code/audio_synthesis.c
@@ -273,7 +273,8 @@ Acmd* AudioSynth_SaveRingBufferResampled(Acmd* cmd, SynthesisReverb* reverb, s16
     return cmd;
 }
 
-Acmd* func_800DB828(Acmd* cmd, s32 arg1, SynthesisReverb* reverb, s16 arg3) {
+// LLM generated name (HIGH), was func_800DB828: the same load and resample as AudioSynth_LoadRingBufferResampled, except it first derives the item's forward and reverse resample ratios from the requested sample count and uses those instead of the reverb's fixed pitch.
+Acmd* AudioSynth_LoadRingBufferResampledScaled(Acmd* cmd, s32 arg1, SynthesisReverb* reverb, s16 arg3) {
     ReverbRingBufferItem* item = &reverb->items[reverb->curFrame][arg3];
     s16 offsetA;
     s16 offsetB;
@@ -532,7 +533,7 @@ Acmd* AudioSynth_LoadReverbSamples(Acmd* cmd, s32 arg1, SynthesisReverb* reverb,
     // Sets DMEM_WET_{LEFT,RIGHT}_CH, clobbers DMEM_TEMP
     if (reverb->downsampleRate == 1) {
         if (reverb->unk_18 != 0) {
-            cmd = func_800DB828(cmd, arg1, reverb, arg3);
+            cmd = AudioSynth_LoadRingBufferResampledScaled(cmd, arg1, reverb, arg3);  // was func_800DB828 [LLM:HIGH]
         } else {
             cmd = AudioSynth_LoadRingBuffer1(cmd, arg1, reverb, arg3);
         }
