Body verified against upstream at 0.80.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 022444c21..a82e0260d 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -2191,7 +2191,8 @@ void EnRu1_EndRetrievalCutscene(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEF930(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEF930): adopted upstream's name for this address; body verified to match upstream at 0.80. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_RespondToAbduction(EnRu1* this, PlayState* play) {
     if (EnRu1_GetPlatformCamSetting(this) == 3) {
         this->actor.flags |= ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_FRIENDLY;
         this->actor.textId = 0x4048;
@@ -2266,7 +2267,7 @@ void EnRu1_SapphireRoom_ReadyToGoHome(EnRu1* this, PlayState* play) {
     EnRu1_UpdateSkelAnime(this);
     EnRu1_UpdateEyes(this);
     EnRu1_RespondToSapphirePlatformMoving(this);
-    func_80AEF930(this, play);
+    EnRu1_RespondToAbduction(this, play);
 }
 
 void EnRu1_SapphireRoom_BeingAbducted(EnRu1* this, PlayState* play) {
