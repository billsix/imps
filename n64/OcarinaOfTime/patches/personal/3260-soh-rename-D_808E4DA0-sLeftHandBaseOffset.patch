From 17147660b3056fa33402dee9ed92d191c10a01f6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:10:28 +0000
Subject: [PATCH 3260/3799] soh: rename D_808E4DA0 -> sLeftHandBaseOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hand-space point limb 4 records, shifted further out for the two raised poses
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index 984c59855..da67a184a 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -3327,7 +3327,7 @@ void BossGanon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
     static s8 bodyPartLimbMap[] = {
         -1, -1, 1, -1, 3, 4, 5, -1, 6, 7, 8, -1, -1, -1, -1, -1, -1, -1, -1, 2, 12, 13, 14, 9, 10, 11, -1, -1, -1, -1,
     };
-    static Vec3f D_808E4DA0 = { -500.0f, 200.0f, -300.0f };
+    static Vec3f sLeftHandBaseOffset = { -500.0f, 200.0f, -300.0f };  // was D_808E4DA0 [LLM:HIGH]
     static Vec3f D_808E4DAC = { -500.0f, 200.0f, 300.0f };
     static Vec3f D_808E4DB8 = { 0.0f, 0.0f, 0.0f };
     static Vec3f D_808E4DC4 = { 0.0f, 0.0f, 0.0f };
@@ -3369,7 +3369,7 @@ void BossGanon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
             Matrix_MultVec3f(&D_808E4DE8, &this->triforcePos);
         }
     } else if (limbIndex == 4) {
-        Vec3f sp28 = D_808E4DA0;
+        Vec3f sp28 = sLeftHandBaseOffset;  // was D_808E4DA0 [LLM:HIGH]
 
         if (this->unk_198 == 1) {
             sp28.x += -300.0f;
