From 49c30c8215aeebe4a85ca6724795187f4c924136 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:01 +0000
Subject: [PATCH 3221/3799] soh: rename D_8082A194 -> sQuestSlotB

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the blue each quest slot icon is tinted with
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
index 12189d096..61debb244 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
@@ -51,7 +51,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
     static s16 sQuestSlotG[] = {  // was D_8082A17C [LLM:HIGH]
         255, 80, 150, 160, 100, 240, 255, 255, 255, 255, 255, 255,
     };
-    static s16 D_8082A194[] = {
+    static s16 sQuestSlotB[] = {  // was D_8082A194 [LLM:HIGH]
         100, 40, 255, 0, 255, 100, 255, 255, 255, 255, 255, 255,
     };
     static s8 D_8082A1AC[][4] = {
@@ -385,7 +385,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
                     pauseCtx->questVtx[sp21A + 2].v.ob[1] - 4;
             }
 
-            gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, sQuestSlotR[sp218], sQuestSlotG[sp218], D_8082A194[sp218],  // was D_8082A164 [LLM:HIGH]
+            gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, sQuestSlotR[sp218], sQuestSlotG[sp218], sQuestSlotB[sp218],  // was D_8082A164 [LLM:HIGH]
                             pauseCtx->alpha);
             gSPVertex(POLY_OPA_DISP++, &pauseCtx->questVtx[sp21A], 4, 0);
             gSP1Quadrangle(POLY_OPA_DISP++, 0, 2, 3, 1, 0);
