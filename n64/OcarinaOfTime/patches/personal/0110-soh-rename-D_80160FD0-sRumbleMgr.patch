From 2329ecb1f0c82a382a262987f4f8414c00770466 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:22 +0000
Subject: [PATCH 110/784] soh: rename D_80160FD0 -> sRumbleMgr

Name source: zeldaret/oot.
Defined in soh/src/code/z_rumble.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/z_rumble.c | 31 ++++++++++++++++---------------
 1 file changed, 16 insertions(+), 15 deletions(-)

diff --git a/soh/src/code/z_rumble.c b/soh/src/code/z_rumble.c
index 3708ecb29..d89e11afc 100644
--- a/soh/src/code/z_rumble.c
+++ b/soh/src/code/z_rumble.c
@@ -1,13 +1,14 @@
 #include "global.h"
 
-RumbleMgr D_80160FD0;
+// Name from zeldaret/oot src/code/z_rumble.c (was D_80160FD0): file-scope RumbleMgr the rumble API operates on. Source: https://github.com/zeldaret/oot/blob/main/src/code/z_rumble.c
+RumbleMgr sRumbleMgr;
 
 void func_800A9F30(PadMgr* a, s32 b) {
     // TODO: Workaround for rumble being too long. Implement os thread functions.
     // Game logic runs at 20hz but input thread runs at 60 hertz, so we call this 3 times
     for (int i = 0; i < 3; i++) {
-        RumbleMgr_Update(&D_80160FD0);
-        PadMgr_RumbleSet(a, D_80160FD0.rumbleEnable);
+        RumbleMgr_Update(&sRumbleMgr);
+        PadMgr_RumbleSet(a, sRumbleMgr.rumbleEnable);
     }
 }
 
@@ -24,9 +25,9 @@ void func_800A9F6C(f32 a, u8 b, u8 c, u8 d) {
     if ((temp1 < 1000) && (b != 0) && (d != 0)) {
         temp2 = b - (temp1 * 255) / 1000;
         if (temp2 > 0) {
-            D_80160FD0.unk_10A = temp2;
-            D_80160FD0.unk_10B = c;
-            D_80160FD0.unk_10C = d;
+            sRumbleMgr.unk_10A = temp2;
+            sRumbleMgr.unk_10B = c;
+            sRumbleMgr.unk_10C = d;
         }
     }
 }
@@ -46,11 +47,11 @@ void Rumble_Request(f32 a, u8 b, u8 c, u8 d) {
         temp2 = b - (temp1 * 255) / 1000;
 
         for (i = 0; i < 0x40; i++) {
-            if (D_80160FD0.unk_04[i] == 0) {
+            if (sRumbleMgr.unk_04[i] == 0) {
                 if (temp2 > 0) {
-                    D_80160FD0.unk_04[i] = temp2;
-                    D_80160FD0.unk_44[i] = c;
-                    D_80160FD0.unk_84[i] = d;
+                    sRumbleMgr.unk_04[i] = temp2;
+                    sRumbleMgr.unk_44[i] = c;
+                    sRumbleMgr.unk_84[i] = d;
                 }
                 break;
             }
@@ -59,7 +60,7 @@ void Rumble_Request(f32 a, u8 b, u8 c, u8 d) {
 }
 
 void func_800AA0B4(void) {
-    RumbleMgr_Init(&D_80160FD0);
+    RumbleMgr_Init(&sRumbleMgr);
 
     gPadMgr.retraceCallback = func_800A9F30;
     gPadMgr.retraceCallbackValue = 0;
@@ -73,7 +74,7 @@ void func_800AA0F0(void) {
         padmgr->retraceCallbackValue = 0;
     }
 
-    RumbleMgr_Destroy(&D_80160FD0);
+    RumbleMgr_Destroy(&sRumbleMgr);
 }
 
 u32 func_800AA148(void) {
@@ -81,13 +82,13 @@ u32 func_800AA148(void) {
 }
 
 void func_800AA15C(void) {
-    D_80160FD0.unk_104 = 2;
+    sRumbleMgr.unk_104 = 2;
 }
 
 void Rumble_ClearRequests(void) {
-    D_80160FD0.unk_104 = 0;
+    sRumbleMgr.unk_104 = 0;
 }
 
 void func_800AA178(u32 a) {
-    D_80160FD0.unk_105 = !!a;
+    sRumbleMgr.unk_105 = !!a;
 }
