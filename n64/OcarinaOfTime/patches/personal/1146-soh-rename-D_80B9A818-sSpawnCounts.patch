 static f32 sDistSquared2[] = { SQ(1705.0f), SQ(1705.0f), SQ(1705.0f) };
 
-static s16 D_80B9A818[] = { 9, 12, 8 };
+// LLM generated name (HIGH), was D_80B9A818: the number of child actors each params variant manages; every loop over actorSpawnPtrList is bounded by it.
+static s16 sSpawnCounts[] = { 9, 12, 8 };  // was D_80B9A818 [LLM:HIGH]
 
 static s16 sActorSpawnIDs[] = { ACTOR_EN_KUSA, ACTOR_EN_KUSA, ACTOR_EN_ISHI };
 
