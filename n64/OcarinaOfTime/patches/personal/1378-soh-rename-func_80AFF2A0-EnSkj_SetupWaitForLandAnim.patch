 void EnSkj_OcarinaMinigameShortStumpUpdate(Actor* thisx, PlayState* play);
 
-void func_80AFF2A0(EnSkj* this);
+// LLM generated name (HIGH), was func_80AFF2A0: recentres the actor, stops it and plays the landing animation before installing SKJ_ACTION_WAIT_FOR_LAND_ANIM.
+void EnSkj_SetupWaitForLandAnim(EnSkj* this);  // was func_80AFF2A0 [LLM:HIGH]
