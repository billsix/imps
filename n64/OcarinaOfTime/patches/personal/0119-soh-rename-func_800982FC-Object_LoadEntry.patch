 soh/soh/z_scene_otr.cpp | 2 +-
 soh/src/code/z_scene.c  | 6 ++++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/soh/soh/z_scene_otr.cpp b/soh/soh/z_scene_otr.cpp
