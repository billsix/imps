@@ -18,7 +18,8 @@ void BgSpot08Bakudankabe_Draw(Actor* thisx, PlayState* play);
 
 // LLM generated name (HIGH), was func_808B02D0: initialises and configures the wall's joint-sphere collider from sJntSphInit; called once from Init.
