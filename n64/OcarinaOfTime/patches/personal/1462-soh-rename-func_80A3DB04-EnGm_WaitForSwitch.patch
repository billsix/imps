From 5b87eed11ad13c5c0d808eaccc050fc785cc9d76 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:20:43 +0000
Subject: [PATCH 1462/3799] soh: rename func_80A3DB04 -> EnGm_WaitForSwitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Medigoron's pre-reveal idle: offers only his brush-off line until the room's switch flag is set, at which point he starts the sales pitch.
Defined in soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c b/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
index ec1e958fb..2fb84259d 100644
--- a/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
+++ b/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
@@ -22,7 +22,8 @@ void EnGm_Draw(Actor* thisx, PlayState* play);
 void EnGm_WaitForObject(EnGm* this, PlayState* play);  // was func_80A3D838 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80A3DFBC: the update installed once the object is loaded: it rebinds segment 6, runs the action function, keeps the focus rotation in step and drives the blink and skeleton updates.
 void EnGm_UpdateMain(EnGm* this, PlayState* play);  // was func_80A3DFBC [LLM:HIGH]
-void func_80A3DB04(EnGm* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A3DB04: Medigoron's pre-reveal idle: offers only his brush-off line until the room's switch flag is set, at which point he starts the sales pitch.
+void EnGm_WaitForSwitch(EnGm* this, PlayState* play);  // was func_80A3DB04 [LLM:HIGH]
 void func_80A3DC44(EnGm* this, PlayState* play);
 void func_80A3DBF4(EnGm* this, PlayState* play);
 void func_80A3DD7C(EnGm* this, PlayState* play);
@@ -127,7 +128,7 @@ void EnGm_WaitForObject(EnGm* this, PlayState* play) {
         this->blinkTimer = 20;
         this->actor.textId = 0x3049;
         this->updateFunc = EnGm_UpdateMain;  // was func_80A3DFBC [LLM:HIGH]
-        this->actionFunc = func_80A3DB04;
+        this->actionFunc = EnGm_WaitForSwitch;  // was func_80A3DB04 [LLM:HIGH]
         this->actor.speedXZ = 0.0f;
         this->actor.gravity = -1.0f;
         this->actor.velocity.y = 0.0f;
@@ -172,7 +173,7 @@ void EnGm_SetTextID(EnGm* this) {
     }
 }
 
-void func_80A3DB04(EnGm* this, PlayState* play) {
+void EnGm_WaitForSwitch(EnGm* this, PlayState* play) {
     f32 dx;
     f32 dz;
     Player* player = GET_PLAYER(play);
@@ -193,7 +194,7 @@ void func_80A3DB04(EnGm* this, PlayState* play) {
 
 void func_80A3DBF4(EnGm* this, PlayState* play) {
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_DONE) && Message_ShouldAdvance(play)) {
-        this->actionFunc = func_80A3DB04;
+        this->actionFunc = EnGm_WaitForSwitch;  // was func_80A3DB04 [LLM:HIGH]
     }
 }
 
