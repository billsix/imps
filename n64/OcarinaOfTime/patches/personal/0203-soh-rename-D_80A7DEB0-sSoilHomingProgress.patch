 void EnInsect_Dropped(EnInsect* this, PlayState* play);
 
-static f32 D_80A7DEB0 = 0.0f;
+// LLM generated name (HIGH), was D_80A7DEB0: f32 ramped by 1/300 per frame and clamped at 1.0, reset to 0 when a bug finds nearby soil; it shrinks the random wander radius around the soil actor until the bug heads straight for it.
+static f32 sSoilHomingProgress = 0.0f;  // was D_80A7DEB0 [LLM:HIGH]
 static s16 sCaughtCount = 0;
 s16 sDroppedCount = 0; // not static: read by NoBugsDespawn.cpp
 
 #define EN_INSECT_SHIP_SAVESTATE_FIELDS(F) \
-    F(D_80A7DEB0)                          \
+    F(sSoilHomingProgress)                 \
     F(sCaughtCount)                        \
     F(sDroppedCount)
 
@@ -202,7 +203,7 @@ void EnInsect_Init(Actor* thisx, PlayState* play2) {
     if (temp_s2 == 2 || temp_s2 == 3) {
         if (EnInsect_FoundNearbySoil(this, play)) {
             this->insectFlags |= 0x10;
-            D_80A7DEB0 = 0.0f;
+            sSoilHomingProgress = 0.0f;  // was D_80A7DEB0 [LLM:HIGH]
         }
 
         if (temp_s2 == 2) {
@@ -589,18 +590,18 @@ void EnInsect_Dropped(EnInsect* this, PlayState* play) {
         sp40 = 40.0f;
     }
 
-    D_80A7DEB0 += 0.99999994f / 300.0f;
-    if (D_80A7DEB0 > 1.0f) {
-        D_80A7DEB0 = 1.0f;
+    sSoilHomingProgress += 0.99999994f / 300.0f;  // was D_80A7DEB0 [LLM:HIGH]
+    if (sSoilHomingProgress > 1.0f) {  // was D_80A7DEB0 [LLM:HIGH]
+        sSoilHomingProgress = 1.0f;  // was D_80A7DEB0 [LLM:HIGH]
     }
 
-    if (D_80A7DEB0 > 0.999f) {
