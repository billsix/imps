             if (pauseCtx->ocarinaStaff->pos != 0) {
                 if (sSongNoteIdx + 1 == pauseCtx->ocarinaStaff->pos) {  // was D_8082A11C [LLM:GUESS]
                     sSongNoteIdx++;  // was D_8082A11C [LLM:GUESS]
-                    D_8082A124[pauseCtx->ocarinaStaff->pos - 1] = pauseCtx->ocarinaStaff->buttonIndex;
+                    sSongNoteGlyphs[pauseCtx->ocarinaStaff->pos - 1] = pauseCtx->ocarinaStaff->buttonIndex;  // was D_8082A124 [LLM:HIGH]
                 }
 
                 for (sp218 = 0, phi_s3 = 0; sp218 < 8; sp218++, phi_s3 += 4, sp21A += 4) {
-                    if (D_8082A124[sp218] == 0xFF) {
+                    if (sSongNoteGlyphs[sp218] == 0xFF) {  // was D_8082A124 [LLM:HIGH]
                         break;
                     }
 
@@ -557,7 +557,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
                     }
 
                     pauseCtx->questVtx[sp21A + 0].v.ob[1] = pauseCtx->questVtx[sp21A + 1].v.ob[1] =
-                        VREG(21 + D_8082A124[sp218]);
+                        VREG(21 + sSongNoteGlyphs[sp218]);  // was D_8082A124 [LLM:HIGH]
 
