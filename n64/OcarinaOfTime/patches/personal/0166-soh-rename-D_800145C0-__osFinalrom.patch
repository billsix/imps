From a2c7a98f21a37f23a568bf7aa1ca8013620a0144 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:12 +0000
Subject: [PATCH 166/488] soh: rename D_800145C0 -> __osFinalrom

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/libultra/os/initialize.c.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/libultra/os/initialize.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/libultra/os/initialize.c b/soh/src/libultra/os/initialize.c
index fb6202612..51e2a0a16 100644
--- a/soh/src/libultra/os/initialize.c
+++ b/soh/src/libultra/os/initialize.c
@@ -12,7 +12,8 @@ s32 osViClock = VI_NTSC_CLOCK;
 u32 __osShutdown = 0;
 OSHWIntr __OSGlobalIntMask = OS_IM_ALL;
 
-u32 D_800145C0;
+// Name from zeldaret/oot (was D_800145C0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/libultra/os/initialize.c]
+u32 __osFinalrom;
 
 void __createSpeedParam(void) {
     __Dom1SpeedParam.type = DEVICE_TYPE_INIT;
@@ -31,7 +32,7 @@ void __createSpeedParam(void) {
 void __osInitialize_common(void) {
     u32 sp2C;
 
-    D_800145C0 = 1;
+    __osFinalrom = 1;
     __osSetSR(__osGetSR() | SR_CU1);
     __osSetFpcCsr(FPCSR_FS | FPCSR_EV);
     __osSetWatchLo(0x4900000);
-- 
2.55.0

