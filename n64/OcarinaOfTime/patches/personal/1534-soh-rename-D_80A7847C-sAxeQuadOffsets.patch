 // LLM generated name (HIGH), was D_80A78470: the in-tree comment above it reads "// unused"; the Vec3f has no reference anywhere.
 static Vec3f sUnusedOffset = { 300.0f, 0.0f, 0.0f };  // was D_80A78470 [LLM:HIGH]
 
-static Vec3f D_80A7847C[] = {
+// LLM generated name (HIGH), was D_80A7847C: the four local-space corners of the axe's quad collider, transformed by the limb matrix each frame; the first two are also the tip and base of the blade trail.
+static Vec3f sAxeQuadOffsets[] = {  // was D_80A7847C [LLM:HIGH]
     { 800.0f, -200.0f, -5200.0f },
     { 0.0f, 0.0f, 0.0f },
     { -200.0f, -2200.0f, -200.0f },
@@ -934,14 +935,14 @@ void EnIk_PostLimbDraw3(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
         Vec3f sp9C[3];
         Vec3f sp78[3];
 
-        Matrix_MultVec3f(&D_80A7847C[0], &this->axeCollider.dim.quad[1]);
-        Matrix_MultVec3f(&D_80A7847C[1], &this->axeCollider.dim.quad[0]);
-        Matrix_MultVec3f(&D_80A7847C[2], &this->axeCollider.dim.quad[3]);
-        Matrix_MultVec3f(&D_80A7847C[3], &this->axeCollider.dim.quad[2]);
+        Matrix_MultVec3f(&sAxeQuadOffsets[0], &this->axeCollider.dim.quad[1]);  // was D_80A7847C [LLM:HIGH]
+        Matrix_MultVec3f(&sAxeQuadOffsets[1], &this->axeCollider.dim.quad[0]);  // was D_80A7847C [LLM:HIGH]
+        Matrix_MultVec3f(&sAxeQuadOffsets[2], &this->axeCollider.dim.quad[3]);  // was D_80A7847C [LLM:HIGH]
+        Matrix_MultVec3f(&sAxeQuadOffsets[3], &this->axeCollider.dim.quad[2]);  // was D_80A7847C [LLM:HIGH]
         Collider_SetQuadVertices(&this->axeCollider, &this->axeCollider.dim.quad[0], &this->axeCollider.dim.quad[1],
                                  &this->axeCollider.dim.quad[2], &this->axeCollider.dim.quad[3]);
-        Matrix_MultVec3f(&D_80A7847C[0], &spF4);
-        Matrix_MultVec3f(&D_80A7847C[1], &spE8);
+        Matrix_MultVec3f(&sAxeQuadOffsets[0], &spF4);  // was D_80A7847C [LLM:HIGH]
+        Matrix_MultVec3f(&sAxeQuadOffsets[1], &spE8);  // was D_80A7847C [LLM:HIGH]
         if (this->unk_2FE > 0) {
             EffectBlure_AddVertex(Effect_GetByIndex(this->blureIdx), &spF4, &spE8);
         } else if (this->unk_2FE == 0) {
