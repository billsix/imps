From 5a47baef60df15929b66e9cd07fb709abf0653f8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:46:32 +0000
Subject: [PATCH 1072/3799] soh: rename D_80812544 -> sKeyboardCharXOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: indexed by the keyboard cell index, and added to each cell's X when laying out the keyboard vertices and when positioning the cursor.
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../gamestates/ovl_file_choose/z_file_nameset_PAL.c      | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
index 64a28bd6f..602cc7ab1 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
@@ -16,7 +16,8 @@ static s16 sNameCharXOffsets[] = {  // was D_808124C0 [LLM:HIGH]
     0x0002, 0x0002, 0x0000, 0x0002, 0x0002, 0x0002, 0x0000, 0x0003, 0x0001, 0x0000,
 };
 
-static s16 D_80812544[] = {
+// LLM generated name (HIGH), was D_80812544: indexed by the keyboard cell index, and added to each cell's X when laying out the keyboard vertices and when positioning the cursor.
+static s16 sKeyboardCharXOffsets[] = {  // was D_80812544 [LLM:HIGH]
     0x0001, 0x0002, 0x0000, 0x0001, 0x0001, 0x0002, 0x0001, 0x0001, 0x0004, 0x0002, 0x0002, 0x0002, 0x0001,
     0x0001, 0x0000, 0x0002, 0x0000, 0x0001, 0x0001, 0x0001, 0x0001, 0x0001, 0x0000, 0x0001, 0x0001, 0x0001,
     0x0002, 0x0002, 0x0002, 0x0002, 0x0002, 0x0003, 0x0002, 0x0002, 0x0004, 0x0003, 0x0002, 0x0004, 0x0001,
@@ -52,10 +53,10 @@ void FileChoose_SetKeyboardVtx(GameState* thisx) {
         phi_t0 = -0x60;
 
         for (phi_t1 = 0; phi_t1 < 13; phi_t1++, phi_t3 += 4, phi_t2++) {
-            this->keyboardVtx[phi_t3].v.ob[0] = this->keyboardVtx[phi_t3 + 2].v.ob[0] = D_80812544[phi_t2] + phi_t0;
+            this->keyboardVtx[phi_t3].v.ob[0] = this->keyboardVtx[phi_t3 + 2].v.ob[0] = sKeyboardCharXOffsets[phi_t2] + phi_t0;  // was D_80812544 [LLM:HIGH]
 
             this->keyboardVtx[phi_t3 + 1].v.ob[0] = this->keyboardVtx[phi_t3 + 3].v.ob[0] =
-                D_80812544[phi_t2] + phi_t0 + 12;
+                sKeyboardCharXOffsets[phi_t2] + phi_t0 + 12;  // was D_80812544 [LLM:HIGH]
 
             this->keyboardVtx[phi_t3].v.ob[1] = this->keyboardVtx[phi_t3 + 1].v.ob[1] = phi_s1;
 
@@ -314,7 +315,7 @@ void FileChoose_DrawNameEntry(GameState* thisx) {
         }
 
         this->nameEntryVtx[40].v.ob[0] = this->nameEntryVtx[42].v.ob[0] =
-            this->keyboardVtx[this->charIndex * 4].v.ob[0] - D_80812544[this->charIndex] - 6;
+            this->keyboardVtx[this->charIndex * 4].v.ob[0] - sKeyboardCharXOffsets[this->charIndex] - 6;  // was D_80812544 [LLM:HIGH]
         this->nameEntryVtx[41].v.ob[0] = this->nameEntryVtx[43].v.ob[0] = this->nameEntryVtx[40].v.ob[0] + 24;
         this->nameEntryVtx[40].v.ob[1] = this->nameEntryVtx[41].v.ob[1] =
             this->keyboardVtx[this->charIndex * 4].v.ob[1] + 6;
-- 
