From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:10:30 +0000
Subject: [PATCH 3270/3799] soh: rename D_808E4E20 -> sMaskStripeWidths12

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the twelve row half-widths of the widest stripe
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index 85d9b652b..ce78bc4df 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -3696,7 +3696,7 @@ void BossGanon_DrawMaskTexPattern(BossGanon* this, u8* tex, f32 arg2) {
     static s16 sMaskStripeWidths6[] = { 1, 2, 3, 3, 2, 1 };  // was D_808E4DF4 [LLM:HIGH]
     static s16 sMaskStripeWidths7[] = { 2, 3, 4, 4, 4, 3, 2 };  // was D_808E4E00 [LLM:HIGH]
     static s16 sMaskStripeWidths8[] = { 2, 3, 4, 4, 4, 4, 3, 2 };  // was D_808E4E10 [LLM:HIGH]
-    static s16 D_808E4E20[] = { 2, 4, 5, 5, 6, 6, 6, 6, 5, 5, 4, 2 };
+    static s16 sMaskStripeWidths12[] = { 2, 4, 5, 5, 6, 6, 6, 6, 5, 5, 4, 2 };  // was D_808E4E20 [LLM:HIGH]
     static s16 D_808E4E38[] = { 1, -1, 1, 1, 3, 4, 1, 6, 7, 2, 9, 10, 2, 12, 13 };
     static u8 D_808E4E58[] = { 3, 2, 2, 1, 3, 3, 1, 3, 3, 1, 0, 3, 1, 0, 3 };
     s16 baseX;
@@ -3738,7 +3738,7 @@ void BossGanon_DrawMaskTexPattern(BossGanon* this, u8* tex, f32 arg2) {
 
             if (D_808E4E58[i] == 2) {
                 for (y = 0, addY = -0x180; y < 12; y++, addY += 0x40) {
-                    for (x = -D_808E4E20[y]; x < D_808E4E20[y]; x++) {
+                    for (x = -sMaskStripeWidths12[y]; x < sMaskStripeWidths12[y]; x++) {  // was D_808E4E20 [LLM:HIGH]
                         index = baseX + x + baseY + addY;
                         if ((index >= 0) && (index < 0x1000)) {
                             tex[index] = 255;
