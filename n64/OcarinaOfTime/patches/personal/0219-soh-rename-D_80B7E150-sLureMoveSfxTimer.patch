From 6ad1e3d077c125698124307f8038c45a741a7ac1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:36 +0000
Subject: [PATCH 219/225] soh: rename D_80B7E150 -> sLureMoveSfxTimer

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_Fishing/z_fishing.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_Fishing/z_fishing.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
index e267c0eeb..fbe523073 100644
--- a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
+++ b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
@@ -411,7 +411,8 @@ static f32 sRodLineSpooled; // 200 represents the full spool.
 // LLM generated name (GUESS), was D_80B7E148: reel line tension, set to 520 and Math_ApproachF'd while reeling
 static f32 sReelLinePull;
 static f32 sFishingLineScale;
-static s16 D_80B7E150;
+// LLM generated name (HIGH), was D_80B7E150: countdown set to 5, decremented; gates lure-move sfx playback
+static s16 sLureMoveSfxTimer;
 static f32 sReelLinePosStep;
 static Vec3f sRodTipPos;
 static Vec3f sReelLinePos[LINE_SEG_COUNT];
@@ -2183,8 +2184,8 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
         sLureBitTimer--;
     }
 
-    if (D_80B7E150 != 0) {
-        D_80B7E150--;
+    if (sLureMoveSfxTimer != 0) {
+        sLureMoveSfxTimer--;
     }
 
     if (sReelCatchTimer != 0) {
@@ -2215,7 +2216,7 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
         sRodLineSpooled = 195.0f;
 
         sRodCastState = sLureEquipped = sLureTimer = sCatchCutsceneTimer = sReelLockTimer = sRodCastTimer = sWiggleAttraction =
-            sLureBiteTimer = D_80B7E150 = 0;
+            sLureBiteTimer = sLureMoveSfxTimer = 0;
         sLure1Rotate = sReelLinePosStep = sLurePosZOffset = 0.0f;
 
         sLureLineSegPosDelta = zeroVec;
@@ -2456,7 +2457,7 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
                 if (sLurePos.y <= (spE4 + 4.0f)) {
                     wiggle = 0.0f;
 
-                    if (D_80B7E150 == 0) {
+                    if (sLureMoveSfxTimer == 0) {
                         if (fabsf(input->rel.stick_x) > 30.0f) {
                             wiggle = fabsf((input->rel.stick_x - sStickAdjXPrev) * (1.0f / 60.0f));
                         } else if (fabsf(input->rel.stick_y) > 30.0f) {
@@ -2478,7 +2479,7 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
                     }
 
                     if ((wiggle > 0.2f) && (sLureWigglePosY < 4.0f)) {
-                        D_80B7E150 = 5;
+                        sLureMoveSfxTimer = 5;
 
                         if (wiggle > 0.8f) {
                             sWiggleAttraction = 2;
