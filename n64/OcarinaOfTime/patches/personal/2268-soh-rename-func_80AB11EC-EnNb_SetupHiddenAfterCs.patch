Subject: [PATCH 2268/3799] soh: rename func_80AB11EC ->
 EnNb_SetupHiddenAfterCs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: drops to the invisible action with alpha, shadow and flag cleared
Defined in soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c b/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
index 906288a49..9994021cc 100644
--- a/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
+++ b/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
@@ -197,7 +197,8 @@ void EnNb_UpdateEyes(EnNb* this) {
     }
 }
 
-void func_80AB11EC(EnNb* this) {
+// LLM generated name (HIGH), was func_80AB11EC: drops to the invisible action with alpha, shadow and flag cleared
+void EnNb_SetupHiddenAfterCs(EnNb* this) {
     this->action = NB_ACTION_7;
     this->drawMode = NB_DRAW_NOTHING;
     this->alpha = 0;
@@ -212,7 +213,7 @@ void func_80AB1210(EnNb* this, PlayState* play) {
     if (play->csCtx.state == CS_STATE_IDLE) {
         if (D_80AB4318) {
             if (this->actor.params == NB_TYPE_DEMO02) {
-                func_80AB11EC(this);
+                EnNb_SetupHiddenAfterCs(this);  // was func_80AB11EC [LLM:HIGH]
             }
 
             D_80AB4318 = 0;
