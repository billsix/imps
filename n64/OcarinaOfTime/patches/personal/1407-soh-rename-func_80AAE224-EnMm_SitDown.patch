Subject: [PATCH 1407/3799] soh: rename func_80AAE224 -> EnMm_SitDown

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: waits for the current animation to finish, then parks the Running Man in the sitting-idle animation with his mouth closed and hands off to the sitting action.
Defined in soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c b/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
index d0bdd68fa..f5b844309 100644
--- a/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
+++ b/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
@@ -33,7 +33,8 @@ void EnMm_Draw(Actor* thisx, PlayState* play);
 void func_80AAE598(EnMm* this, PlayState* play);
 void func_80AAE294(EnMm* this, PlayState* play);
 void func_80AAE50C(EnMm* this, PlayState* play);
-void func_80AAE224(EnMm* this, PlayState* play);
+// LLM generated name (HIGH), was func_80AAE224: waits for the current animation to finish, then parks the Running Man in the sitting-idle animation with his mouth closed and hands off to the sitting action.
+void EnMm_SitDown(EnMm* this, PlayState* play);  // was func_80AAE224 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AADA70: returns whether gSaveContext.dayTime is inside the daylight window; the Running Man only runs by day.
 s32 EnMm_IsDay(void);  // was func_80AADA70 [LLM:HIGH]
 
@@ -400,7 +401,7 @@ s32 EnMm_UpdateWaypoint(EnMm* this, PlayState* play) {
     return 0;
 }
 
-void func_80AAE224(EnMm* this, PlayState* play) {
+void EnMm_SitDown(EnMm* this, PlayState* play) {
     if (SkelAnime_Update(&this->skelAnime)) {
         this->actionFunc = func_80AAE598;
         this->unk_1E8 = 0;
@@ -450,7 +451,7 @@ void func_80AAE294(EnMm* this, PlayState* play) {
                 if ((floorYNorm > 0.9848f) || (floorYNorm < -0.9848f)) {
                     if (this->sitTimer > 30) {
                         EnMm_ChangeAnim(this, RM_ANIM_SIT, &this->curAnimIndex);
-                        this->actionFunc = func_80AAE224;
+                        this->actionFunc = EnMm_SitDown;  // was func_80AAE224 [LLM:HIGH]
                     } else {
                         this->sitTimer++;
                     }
