From 839039fcaa70166a1d6fd1684b8c23b15997a677 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:24:04 +0000
Subject: [PATCH 2362/3799] soh: rename func_8086D7FC ->
 BgBdanSwitch_SetupRelease

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the rising action
Defined in soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c         | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
index 8e9d2e342..6e62bec4b 100644
--- a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
+++ b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
@@ -27,7 +27,8 @@ void BgBdanSwitch_Press(BgBdanSwitch* this, PlayState* play);  // was func_8086D
 void BgBdanSwitch_SetupPressed(BgBdanSwitch* this);  // was func_8086D730 [LLM:HIGH]
 // LLM generated name (HIGH), was func_8086D754: releases the blue switch once nothing weighs it down, or the yellow one once its flag is cleared elsewhere
 void BgBdanSwitch_Pressed(BgBdanSwitch* this, PlayState* play);  // was func_8086D754 [LLM:HIGH]
-void func_8086D7FC(BgBdanSwitch* this);
+// LLM generated name (HIGH), was func_8086D7FC: installs the rising action
+void BgBdanSwitch_SetupRelease(BgBdanSwitch* this);  // was func_8086D7FC [LLM:HIGH]
 void func_8086D80C(BgBdanSwitch* this, PlayState* play);
 void func_8086D86C(BgBdanSwitch* this);
 void func_8086D888(BgBdanSwitch* this, PlayState* play);
@@ -303,7 +304,7 @@ void BgBdanSwitch_Pressed(BgBdanSwitch* this, PlayState* play) {
         case BLUE:
             if (!DynaPolyActor_IsSwitchPressed(&this->dyna)) {
                 if (this->unk_1D8 <= 0) {
-                    func_8086D7FC(this);
+                    BgBdanSwitch_SetupRelease(this);  // was func_8086D7FC [LLM:HIGH]
                     BgBdanSwitch_ClearSwitchFlag(this, play);  // was func_8086D548 [LLM:HIGH]
                 }
             } else {
@@ -312,13 +313,13 @@ void BgBdanSwitch_Pressed(BgBdanSwitch* this, PlayState* play) {
             break;
         case YELLOW:
             if (!Flags_GetSwitch(play, (this->dyna.actor.params >> 8) & 0x3F)) {
-                func_8086D7FC(this);
+                BgBdanSwitch_SetupRelease(this);  // was func_8086D7FC [LLM:HIGH]
             }
             break;
     }
 }
 
-void func_8086D7FC(BgBdanSwitch* this) {
+void BgBdanSwitch_SetupRelease(BgBdanSwitch* this) {
     this->actionFunc = func_8086D80C;
 }
 
