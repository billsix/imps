From 863a2c1a1e836c168bc8fa7f302dae5e3f10582b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:23 +0000
Subject: [PATCH 0244/3799] soh: rename func_80041E80 ->
 SurfaceType_GetFloorProperty2

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/code/z_bgcheck.c.
---
 soh/include/functions.h                     | 2 +-
 soh/soh/Enhancements/debugger/colViewer.cpp | 4 ++--
 soh/src/code/z_bgcheck.c                    | 3 ++-
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index fb7a6ed2c..425cc33ac 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -687,7 +687,7 @@ s32 SurfaceType_GetWallFlags(CollisionContext* colCtx, CollisionPoly* poly, s32
 s32 SurfaceType_CheckWallFlag0(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041DE4 [oot]
 s32 SurfaceType_CheckWallFlag1(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041E18 [oot]
 s32 SurfaceType_CheckWallFlag2(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041E4C [oot]
-s32 func_80041E80(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
+s32 SurfaceType_GetFloorProperty2(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041E80 [oot]
 u32 func_80041EA4(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
 u32 func_80041EC8(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
 u32 SurfaceType_IsHorseBlocked(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
diff --git a/soh/soh/Enhancements/debugger/colViewer.cpp b/soh/soh/Enhancements/debugger/colViewer.cpp
index 6f34e2b83..fd9e87da4 100644
--- a/soh/soh/Enhancements/debugger/colViewer.cpp
+++ b/soh/soh/Enhancements/debugger/colViewer.cpp
@@ -393,10 +393,10 @@ void DrawDynapoly(std::vector<Gfx>& dl, CollisionHeader* col, int32_t bgId) {
             color = CVarGetColor(CVAR_DEVELOPER_TOOLS("ColViewer.ColorHookshot.Value"), { 128, 128, 255, 255 });
         } else if (SurfaceType_GetWallType(&gPlayState->colCtx, poly, bgId) > 0x01) {
             color = CVarGetColor(CVAR_DEVELOPER_TOOLS("ColViewer.ColorInteractable.Value"), { 192, 0, 192, 255 });
-        } else if (func_80041E80(&gPlayState->colCtx, poly, bgId) == 0x0C) {
+        } else if (SurfaceType_GetFloorProperty2(&gPlayState->colCtx, poly, bgId) == 0x0C) {
             color = CVarGetColor(CVAR_DEVELOPER_TOOLS("ColViewer.ColorVoid.Value"), { 255, 0, 0, 255 });
         } else if (SurfaceType_GetSceneExitIndex(&gPlayState->colCtx, poly, bgId) ||
-                   func_80041E80(&gPlayState->colCtx, poly, bgId) == 0x05) {
+                   SurfaceType_GetFloorProperty2(&gPlayState->colCtx, poly, bgId) == 0x05) {
             color = CVarGetColor(CVAR_DEVELOPER_TOOLS("ColViewer.ColorEntrance.Value"), { 0, 255, 0, 255 });
         } else if (SurfaceType_GetFloorType(&gPlayState->colCtx, poly, bgId) != 0 ||
                    SurfaceType_IsWallDamage(&gPlayState->colCtx, poly, bgId)) {
diff --git a/soh/src/code/z_bgcheck.c b/soh/src/code/z_bgcheck.c
index a6218dbb2..5ce74b2ce 100644
--- a/soh/src/code/z_bgcheck.c
+++ b/soh/src/code/z_bgcheck.c
@@ -4063,7 +4063,8 @@ s32 SurfaceType_CheckWallFlag2(CollisionContext* colCtx, CollisionPoly* poly, s3
 /**
  * unused
  */
-s32 func_80041E80(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
+// Name from zeldaret/oot (was func_80041E80): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_bgcheck.c]
+s32 SurfaceType_GetFloorProperty2(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
     return SurfaceType_GetData(colCtx, poly, bgId, 0) >> 26 & 0xF;
 }
 
