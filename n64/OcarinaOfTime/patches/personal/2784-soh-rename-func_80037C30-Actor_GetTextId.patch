From 0984e3b457b32e0ea31e259e01beed8e43c60821 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:37 +0000
Subject: [PATCH 2784/3799] soh: rename func_80037C30 -> Actor_GetTextId

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the public wrapper of Actor_GetNpcTextId
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h                               | 2 +-
 soh/src/code/z_actor.c                                | 7 ++++---
 soh/src/overlays/actors/ovl_Obj_Dekujr/z_obj_dekujr.c | 2 +-
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index f5ba4eb6b..76988d2bb 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -572,7 +572,7 @@ void Flags_UnsetEventInf(s32 flag);
 s32 Flags_GetRandomizerInf(RandomizerInf flag);
 void Flags_SetRandomizerInf(RandomizerInf flag);
 void Flags_UnsetRandomizerInf(RandomizerInf flag);
-u16 func_80037C30(PlayState* play, s16 arg1);
+u16 Actor_GetTextId(PlayState* play, s16 arg1);  // was func_80037C30 [LLM:HIGH]
 s32 func_80037D98(PlayState* play, Actor* actor, s16 arg2, s32* arg3);
 s32 Actor_TrackPlayer(PlayState* play, Actor* actor, Vec3s* arg2, Vec3s* arg3, Vec3f arg4);
 
diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 542ddd9b6..9960fe473 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -6365,7 +6365,8 @@ s32 Actor_HandleNpcChoice(PlayState* play, Actor* actor, u16 textId) {
     return ret;
 }
 
-u16 func_80037C30(PlayState* play, s16 arg1) {
+// LLM generated name (HIGH), was func_80037C30: the public wrapper of Actor_GetNpcTextId
+u16 Actor_GetTextId(PlayState* play, s16 arg1) {
     return Actor_GetNpcTextId(play, arg1);  // was func_80035BFC [LLM:HIGH]
 }
 
@@ -6438,11 +6439,11 @@ s32 func_80037D98(PlayState* play, Actor* actor, s16 arg2, s32* arg3) {
 
     if (actor->xyzDistToPlayerSq <= SQ(80.0f)) {
         if (Actor_OfferTalk(actor, play, 80.0f)) {
-            actor->textId = func_80037C30(play, arg2);
+            actor->textId = Actor_GetTextId(play, arg2);  // was func_80037C30 [LLM:HIGH]
         }
     } else {
         if (Actor_OfferTalkNearColChkInfoCylinder(actor, play)) {
-            actor->textId = func_80037C30(play, arg2);
+            actor->textId = Actor_GetTextId(play, arg2);  // was func_80037C30 [LLM:HIGH]
         }
     }
 
diff --git a/soh/src/overlays/actors/ovl_Obj_Dekujr/z_obj_dekujr.c b/soh/src/overlays/actors/ovl_Obj_Dekujr/z_obj_dekujr.c
index b04348304..76208a2b7 100644
--- a/soh/src/overlays/actors/ovl_Obj_Dekujr/z_obj_dekujr.c
+++ b/soh/src/overlays/actors/ovl_Obj_Dekujr/z_obj_dekujr.c
@@ -66,7 +66,7 @@ void ObjDekujr_Init(Actor* thisx, PlayState* play) {
         sCylinderInit.base.actor = thisx;
         Collider_SetCylinderToActor(play, &this->collider, &sCylinderInit);
         thisx->colChkInfo.mass = MASS_IMMOVABLE;
-        thisx->textId = func_80037C30(play, 0xF);
+        thisx->textId = Actor_GetTextId(play, 0xF);  // was func_80037C30 [LLM:HIGH]
         Actor_SetScale(thisx, 0.4f);
     }
 }
