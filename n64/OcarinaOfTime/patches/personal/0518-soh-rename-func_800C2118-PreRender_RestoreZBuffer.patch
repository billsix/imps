+++ b/soh/src/code/PreRender.c
@@ -289,7 +289,8 @@ void PreRender_DrawCoverage(PreRender* this, Gfx** gfxp) {
     }
 }
 
-void func_800C2118(PreRender* this, Gfx** gfxp) {
+// Name from zeldaret/oot (was func_800C2118): adopted upstream's name for this address; body verified to match upstream at 0.98. [oot: https://github.com/zeldaret/oot/blob/main/src/code/PreRender.c]
+void PreRender_RestoreZBuffer(PreRender* this, Gfx** gfxp) {
     PreRender_CopyImage(this, gfxp, this->zbufSave, this->zbuf);
 }
 
