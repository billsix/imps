From 43e854d879bbe6f65a9de1884a0acb596f7e5104 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:17:12 +0000
Subject: [PATCH 0885/3799] soh: rename D_8016B780 -> gUnusedAudioPreloadFlag

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: s32 cleared in AudioLoad_RelocateFontAndPreloadSamples when the preload sample stack is empty and never read; called a flag from that single 0-assignment.
Defined in soh/src/code/audio_load.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_load.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_load.c b/soh/src/code/audio_load.c
index 239e312f3..79d180c04 100644
--- a/soh/src/code/audio_load.c
+++ b/soh/src/code/audio_load.c
@@ -76,7 +76,8 @@ OSMesg sScriptLoadMesgBuf[0x10];
 s8* sScriptLoadDonePointers[0x10];
 s32 sAudioLoadPad1[2]; // file padding
 
-s32 D_8016B780;
+// LLM generated name (GUESS), was D_8016B780: s32 cleared in AudioLoad_RelocateFontAndPreloadSamples when the preload sample stack is empty and never read; called a flag from that single 0-assignment.
+s32 gUnusedAudioPreloadFlag;  // was D_8016B780 [LLM:GUESS]
 s32 sAudioLoadPad2[4]; // double file padding?
 
 DmaHandler sDmaHandler = osEPiStartDma;
@@ -1894,7 +1895,7 @@ void AudioLoad_RelocateFontAndPreloadSamples(s32 fontId, SoundFontData* mem, Rel
     if (gAudioContext.preloadSampleStackTop != 0) {
         preloadInProgress = true;
     } else {
-        D_8016B780 = 0;
+        gUnusedAudioPreloadFlag = 0;  // was D_8016B780 [LLM:GUESS]
     }
 
     gAudioContext.numUsedSamples = 0;
-- 
