From 0b3fe3806b72d7f76c53a0de776117acceb51ae9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:30 +0000
Subject: [PATCH 0687/3799] soh: rename D_80A7B998 -> sIsObedient

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_In/z_en_in.c.
---
 soh/src/overlays/actors/ovl_En_In/z_en_in.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_In/z_en_in.c b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
index 084d401d8..40a0c1c3c 100644
--- a/soh/src/overlays/actors/ovl_En_In/z_en_in.c
+++ b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
@@ -491,7 +491,8 @@ void EnIn_RentalTimeExpired(EnIn* this, PlayState* play) {
     Interface_ChangeHudVisibilityMode(HUD_VISIBILITY_NOTHING_ALT);
 }
 
-static s32 D_80A7B998 = 0;
+// Name from zeldaret/oot (was D_80A7B998): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_In/z_en_in.c]
+static s32 sIsObedient = 0;
 
 void EnIn_Init(Actor* thisx, PlayState* play) {
     EnIn* this = (EnIn*)thisx;
@@ -506,9 +507,9 @@ void EnIn_Init(Actor* thisx, PlayState* play) {
     }
     respawnPos = respawn->pos;
     // hardcoded coords for lon lon entrance
-    if (D_80A7B998 == 0 && respawnPos.x == 1107.0f && respawnPos.y == 0.0f && respawnPos.z == -3740.0f) {
+    if (sIsObedient == 0 && respawnPos.x == 1107.0f && respawnPos.y == 0.0f && respawnPos.z == -3740.0f) {
         gSaveContext.eventInf[0] = 0;
-        D_80A7B998 = 1;
+        sIsObedient = 1;
     }
     this->actionFunc = EnIn_WaitForObject;
 }
@@ -1029,5 +1030,5 @@ void EnIn_Draw(Actor* thisx, PlayState* play) {
 }
 
 void EnIn_Reset(void) {
-    D_80A7B998 = 0;
+    sIsObedient = 0;
 }
