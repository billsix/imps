Date: Mon, 7 Sep 2026 15:02:49 +0000
Subject: [PATCH 0479/3799] soh: rename func_80AEF4A8 -> EnRu1_PlayAbductedSfx

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.97.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 63942858e..6b777baaa 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1985,7 +1985,8 @@ void EnRu1_PlayStepSoundNearSapphire(EnRu1* this) {
     }
 }
 
-void func_80AEF4A8(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEF4A8): adopted upstream's name for this address; body verified to match upstream at 0.97. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_PlayAbductedSfx(EnRu1* this, PlayState* play) {
     SoundSource_PlaySfxAtFixedWorldPos(play, &this->actor.projectedPos, 20, NA_SE_VO_RT_FALL);
 }
 
@@ -2100,7 +2101,7 @@ void func_80AEF930(EnRu1* this, PlayState* play) {
         this->actor.flags |= ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_FRIENDLY;
         this->actor.textId = 0x4048;
         Message_ContinueTextbox(play, this->actor.textId);
-        func_80AEF4A8(this, play);
+        EnRu1_PlayAbductedSfx(this, play);
         this->action = 43;
         this->drawConfig = 0;
     }
