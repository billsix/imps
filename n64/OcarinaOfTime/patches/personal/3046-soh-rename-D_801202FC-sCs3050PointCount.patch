From 13f17d4ca6564d07747209a600fcc69c7cb2298e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:35 +0000
Subject: [PATCH 3046/3799] soh: rename D_801202FC -> sCs3050PointCount

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the number of points in those arrays, indexed from as count minus two and three
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 28 ++++++++++++++--------------
 soh/src/code/z_onepointdemo_data.inc |  3 ++-
 2 files changed, 16 insertions(+), 15 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 42160a74f..231d7760a 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -498,20 +498,20 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Player_SetCsActionWithHaltedActors(play, &player->actor, 5);
             OnePointCutscene_SetCsCamPoints(csCam, D_80120304 | 0x2000, D_80120300, sCs3050AtPoints, sCs3050EyePoints);  // was D_8012013C [LLM:HIGH]
             Sfx_PlaySfxCentered(NA_SE_SY_CORRECT_CHIME);
-            OnePointCutscene_Vec3sToVec3f(&mainCam->at, &sCs3050AtPoints[D_801202FC - 2].pos);  // was D_8012013C [LLM:HIGH]
-            OnePointCutscene_Vec3sToVec3f(&mainCam->eye, &sCs3050EyePoints[D_801202FC - 2].pos);  // was D_8012021C [LLM:HIGH]
-            sCs3050AtPoints[D_801202FC - 3].pos.x +=  // was D_8012013C [LLM:HIGH]
-                (sCs3050AtPoints[D_801202FC - 2].pos.x - sCs3050AtPoints[D_801202FC - 3].pos.x) / 2;  // was D_8012013C [LLM:HIGH]
-            sCs3050AtPoints[D_801202FC - 3].pos.y +=  // was D_8012013C [LLM:HIGH]
-                (sCs3050AtPoints[D_801202FC - 2].pos.y - sCs3050AtPoints[D_801202FC - 3].pos.y) / 2;  // was D_8012013C [LLM:HIGH]
-            sCs3050AtPoints[D_801202FC - 3].pos.z +=  // was D_8012013C [LLM:HIGH]
-                (sCs3050AtPoints[D_801202FC - 2].pos.z - sCs3050AtPoints[D_801202FC - 3].pos.z) / 2;  // was D_8012013C [LLM:HIGH]
-            sCs3050EyePoints[D_801202FC - 3].pos.x +=  // was D_8012021C [LLM:HIGH]
-                (sCs3050EyePoints[D_801202FC - 2].pos.x - sCs3050EyePoints[D_801202FC - 3].pos.x) / 2;  // was D_8012021C [LLM:HIGH]
-            sCs3050EyePoints[D_801202FC - 3].pos.y +=  // was D_8012021C [LLM:HIGH]
-                (sCs3050EyePoints[D_801202FC - 2].pos.y - sCs3050EyePoints[D_801202FC - 3].pos.y) / 2;  // was D_8012021C [LLM:HIGH]
-            sCs3050EyePoints[D_801202FC - 3].pos.z +=  // was D_8012021C [LLM:HIGH]
-                (sCs3050EyePoints[D_801202FC - 2].pos.z - sCs3050EyePoints[D_801202FC - 3].pos.z) / 2;  // was D_8012021C [LLM:HIGH]
+            OnePointCutscene_Vec3sToVec3f(&mainCam->at, &sCs3050AtPoints[sCs3050PointCount - 2].pos);  // was D_8012013C [LLM:HIGH]
+            OnePointCutscene_Vec3sToVec3f(&mainCam->eye, &sCs3050EyePoints[sCs3050PointCount - 2].pos);  // was D_8012021C [LLM:HIGH]
+            sCs3050AtPoints[sCs3050PointCount - 3].pos.x +=  // was D_8012013C [LLM:HIGH]
+                (sCs3050AtPoints[sCs3050PointCount - 2].pos.x - sCs3050AtPoints[sCs3050PointCount - 3].pos.x) / 2;  // was D_8012013C [LLM:HIGH]
+            sCs3050AtPoints[sCs3050PointCount - 3].pos.y +=  // was D_8012013C [LLM:HIGH]
+                (sCs3050AtPoints[sCs3050PointCount - 2].pos.y - sCs3050AtPoints[sCs3050PointCount - 3].pos.y) / 2;  // was D_8012013C [LLM:HIGH]
+            sCs3050AtPoints[sCs3050PointCount - 3].pos.z +=  // was D_8012013C [LLM:HIGH]
+                (sCs3050AtPoints[sCs3050PointCount - 2].pos.z - sCs3050AtPoints[sCs3050PointCount - 3].pos.z) / 2;  // was D_8012013C [LLM:HIGH]
+            sCs3050EyePoints[sCs3050PointCount - 3].pos.x +=  // was D_8012021C [LLM:HIGH]
+                (sCs3050EyePoints[sCs3050PointCount - 2].pos.x - sCs3050EyePoints[sCs3050PointCount - 3].pos.x) / 2;  // was D_8012021C [LLM:HIGH]
+            sCs3050EyePoints[sCs3050PointCount - 3].pos.y +=  // was D_8012021C [LLM:HIGH]
+                (sCs3050EyePoints[sCs3050PointCount - 2].pos.y - sCs3050EyePoints[sCs3050PointCount - 3].pos.y) / 2;  // was D_8012021C [LLM:HIGH]
+            sCs3050EyePoints[sCs3050PointCount - 3].pos.z +=  // was D_8012021C [LLM:HIGH]
+                (sCs3050EyePoints[sCs3050PointCount - 2].pos.z - sCs3050EyePoints[sCs3050PointCount - 3].pos.z) / 2;  // was D_8012021C [LLM:HIGH]
 
             i = Quake_Add(mainCam, 3);
             Quake_SetSpeed(i, 30000);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 6c4ba627c..bf1cc50eb 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -27,7 +27,8 @@ static CutsceneCameraPoint sCs3050EyePoints[14] = {  // was D_8012021C [LLM:HIGH
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { -2007, 10, -1004 } },  { CS_CMD_CONTINUE, 0, 0, 60.0f, { -2007, 10, -1004 } },
     { CS_CMD_STOP, 0, 0, 60.0f, { -2007, 10, -1004 } },      { CS_CMD_STOP, 0, 0, 60.0f, { -2007, 10, -1004 } },
 };
-static s16 D_801202FC = 13;
+// LLM generated name (HIGH), was D_801202FC: the number of points in those arrays, indexed from as count minus two and three
+static s16 sCs3050PointCount = 13;  // was D_801202FC [LLM:HIGH]
 static s16 D_80120300 = 210;
 static s16 D_80120304 = 0;
 
