From 1455ab5bc46f9f5767e6dfe41eec3721ea5a2af6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:02 +0000
Subject: [PATCH 3378/3799] soh: rename D_809AA57C -> sRepulsionParams

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the step, cap and radius EffectSsKakera_ApplyRepulsion pushes a shard away with
Defined in soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
index 39e9ad157..cf78a9a7c 100644
--- a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
+++ b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
@@ -265,7 +265,7 @@ s32 EffectSsKakera_ApplyBuoyancy(EffectSs* this, Vec3f* diff, f32 dist) {
 
 // LLM generated name (HIGH), was func_809A9F4C: the third force pass: pushes the fragment away from its origin at one of three strengths.
 s32 EffectSsKakera_ApplyRepulsion(EffectSs* this, Vec3f* diff, f32 dist) {
-    static f32 D_809AA57C[] = { 0.1f, 1.0f, 6.0f };
+    static f32 sRepulsionParams[] = { 0.1f, 1.0f, 6.0f };  // was D_809AA57C [LLM:HIGH]
     s32 temp_v0;
     f32 phi_f0;
 
@@ -279,8 +279,8 @@ s32 EffectSsKakera_ApplyRepulsion(EffectSs* this, Vec3f* diff, f32 dist) {
             phi_f0 = 1.0f;
         }
 
-        this->accel.x -= ((diff->x * D_809AA57C[temp_v0 - 1]) * phi_f0);
-        this->accel.z -= ((diff->z * D_809AA57C[temp_v0 - 1]) * phi_f0);
+        this->accel.x -= ((diff->x * sRepulsionParams[temp_v0 - 1]) * phi_f0);  // was D_809AA57C [LLM:HIGH]
+        this->accel.z -= ((diff->z * sRepulsionParams[temp_v0 - 1]) * phi_f0);  // was D_809AA57C [LLM:HIGH]
     }
 
     return 1;
-- 
