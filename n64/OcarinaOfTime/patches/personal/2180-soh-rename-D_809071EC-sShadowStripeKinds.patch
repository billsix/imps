+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -3076,7 +3076,7 @@ void func_80906538(BossGanon2* this, u8* shadowTexture, f32 arg2) {
             temp_a3 = sp64.x + 32.0f;
             temp_t0 = (s16)sp64.y * 64;
 
-            if (D_809071EC[i] == 2) {
+            if (sShadowStripeKinds[i] == 2) {  // was D_809071EC [LLM:HIGH]
                 for (j = 0, phi_a1 = -0x180; j < 12; j++, phi_a1 += 0x40) {
                     for (phi_v1 = -sShadowStripeWidths12[j]; phi_v1 < sShadowStripeWidths12[j]; phi_v1++) {  // was D_809071B4 [LLM:HIGH]
                         temp_v0 = temp_a3 + phi_v1 + temp_t0 + phi_a1;
@@ -3085,7 +3085,7 @@ void func_80906538(BossGanon2* this, u8* shadowTexture, f32 arg2) {
                         }
                     }
                 }
-            } else if (D_809071EC[i] == 1) {
+            } else if (sShadowStripeKinds[i] == 1) {  // was D_809071EC [LLM:HIGH]
                 for (j = 0, phi_a1 = -0x100; j < 8; j++, phi_a1 += 0x40) {
                     for (phi_v1 = -sShadowStripeWidths8[j]; phi_v1 < sShadowStripeWidths8[j]; phi_v1++) {  // was D_809071A4 [LLM:HIGH]
                         temp_v0 = temp_a3 + phi_v1 + temp_t0 + phi_a1;
@@ -3094,7 +3094,7 @@ void func_80906538(BossGanon2* this, u8* shadowTexture, f32 arg2) {
                         }
                     }
                 }
-            } else if (D_809071EC[i] == 0) {
+            } else if (sShadowStripeKinds[i] == 0) {  // was D_809071EC [LLM:HIGH]
                 for (j = 0, phi_a1 = -0xC0; j < 7; j++, phi_a1 += 0x40) {
                     for (phi_v1 = -sShadowStripeWidths7[j]; phi_v1 < sShadowStripeWidths7[j] - 1; phi_v1++) {  // was D_80907194 [LLM:HIGH]
                         temp_v0 = temp_a3 + phi_v1 + temp_t0 + phi_a1;
diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
