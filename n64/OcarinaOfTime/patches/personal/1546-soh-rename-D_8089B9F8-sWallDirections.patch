From b9346e3238296e400587dd927f1f511d07a2ad9e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:26:29 +0000
Subject: [PATCH 1546/3799] soh: rename D_8089B9F8 -> sWallDirections

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the direction each segment starts sliding in, alternating so neighbouring rows move opposite ways.
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c       | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c b/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
index d87900aa9..04acec391 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
@@ -40,7 +40,8 @@ const ActorInit Bg_Jya_Zurerukabe_InitVars = {
 // LLM generated name (HIGH), was D_8089B9F0: the home Y of each of the four wall segments; Init matches its own height against the list to learn which segment it is.
 static s16 sWallHeights[4] = { 943, 1043, 1243, 1343 };  // was D_8089B9F0 [LLM:HIGH]
 
-static s16 D_8089B9F8[4] = { -1, 1, -1, 1 };
+// LLM generated name (HIGH), was D_8089B9F8: the direction each segment starts sliding in, alternating so neighbouring rows move opposite ways.
+static s16 sWallDirections[4] = { -1, 1, -1, 1 };  // was D_8089B9F8 [LLM:HIGH]
 
 static s16 D_8089BA00[4] = { 48, 48, 36, 36 };
 
@@ -130,7 +131,7 @@ void BgJyaZurerukabe_Init(Actor* thisx, PlayState* play) {
         osSyncPrintf(VT_RST);
     }
 
-    this->unk_16E = D_8089B9F8[this->unk_168];
+    this->unk_16E = sWallDirections[this->unk_168];  // was D_8089B9F8 [LLM:HIGH]
     func_8089B7B4(this);
     osSyncPrintf("(jya ずれる壁)(arg_data 0x%04x)\n", this->dyna.actor.params);
 }
