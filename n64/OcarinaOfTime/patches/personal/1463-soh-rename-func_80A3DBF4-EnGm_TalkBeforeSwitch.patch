From 385bb79764b6c75f5a1311f70336914e8d2a800b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:20:43 +0000
Subject: [PATCH 1463/3799] soh: rename func_80A3DBF4 -> EnGm_TalkBeforeSwitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: waits out that brush-off textbox and returns to the pre-reveal idle.
Defined in soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c b/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
index 2fb84259d..bd607829d 100644
--- a/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
+++ b/soh/src/overlays/actors/ovl_En_Gm/z_en_gm.c
@@ -25,7 +25,8 @@ void EnGm_UpdateMain(EnGm* this, PlayState* play);  // was func_80A3DFBC [LLM:HI
 // LLM generated name (HIGH), was func_80A3DB04: Medigoron's pre-reveal idle: offers only his brush-off line until the room's switch flag is set, at which point he starts the sales pitch.
 void EnGm_WaitForSwitch(EnGm* this, PlayState* play);  // was func_80A3DB04 [LLM:HIGH]
 void func_80A3DC44(EnGm* this, PlayState* play);
-void func_80A3DBF4(EnGm* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A3DBF4: waits out that brush-off textbox and returns to the pre-reveal idle.
+void EnGm_TalkBeforeSwitch(EnGm* this, PlayState* play);  // was func_80A3DBF4 [LLM:HIGH]
 void func_80A3DD7C(EnGm* this, PlayState* play);
 void EnGm_ProcessChoiceIndex(EnGm* this, PlayState* play);
 void func_80A3DF00(EnGm* this, PlayState* play);
@@ -185,14 +186,14 @@ void EnGm_WaitForSwitch(EnGm* this, PlayState* play) {
         EnGm_SetTextID(this);
         this->actionFunc = func_80A3DC44;
     } else if (Actor_ProcessTalkRequest(&this->actor, play)) {
-        this->actionFunc = func_80A3DBF4;
+        this->actionFunc = EnGm_TalkBeforeSwitch;  // was func_80A3DBF4 [LLM:HIGH]
     } else if ((this->collider.base.ocFlags1 & OC1_HIT) || (SQ(dx) + SQ(dz)) < SQ(100.0f)) {
         this->collider.base.acFlags &= ~AC_HIT;
         Actor_OfferTalk(&this->actor, play, 415.0f);
     }
 }
 
-void func_80A3DBF4(EnGm* this, PlayState* play) {
+void EnGm_TalkBeforeSwitch(EnGm* this, PlayState* play) {
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_DONE) && Message_ShouldAdvance(play)) {
         this->actionFunc = EnGm_WaitForSwitch;  // was func_80A3DB04 [LLM:HIGH]
     }
