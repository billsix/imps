                         pauseCtx->questVtx[sp21A + 0].v.ob[1] - 12;
@@ -565,20 +565,20 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
                     gDPPipeSync(POLY_OPA_DISP++);
 
