     }
 }
 
-void func_80AECA18(EnRu1* this) {
+// Name from zeldaret/oot (was func_80AECA18): adopted upstream's name for this address; body verified to match upstream at 0.84. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_CheckStartFalling(EnRu1* this) {
     if (!(this->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) {
         this->action = 13;
         this->walkingFrame = 0.0f;
@@ -1005,7 +1006,7 @@ void func_80AECBB8(EnRu1* this, PlayState* play) {
