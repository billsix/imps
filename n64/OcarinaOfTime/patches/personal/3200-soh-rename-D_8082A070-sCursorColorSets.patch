+            gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, sCursorColorSets[0][0], sCursorColorSets[0][1], sCursorColorSets[0][2],  // was D_8082A070 [LLM:HIGH]
                             pauseCtx->alpha);
         } else {
             gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, D_8082A104, D_8082A108, D_8082A10C, D_8082A110);
