From fe77d26cb86fa2d8ccc34e20d08507d2f3c886a8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:09 +0000
Subject: [PATCH 0933/3799] soh: rename D_809A5100 -> sFlashDList

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the effect's Gfx display list, handed to the particle as this->gfx via SEGMENTED_TO_VIRTUAL.
Defined in soh/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c b/soh/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c
index cf3320f52..28f2bbf85 100644
--- a/soh/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c
+++ b/soh/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c
@@ -27,7 +27,8 @@ EffectSsInit Effect_Ss_Fhg_Flash_InitVars = {
 
 // Name from zeldaret/oot (was D_809A5178): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/effects/ovl_Effect_Ss_Fhg_Flash/z_eff_ss_fhg_flash.c]
 static UNK_TYPE sShockDL[258];
-static Gfx D_809A5100[15];
+// LLM generated name (HIGH), was D_809A5100: the effect's Gfx display list, handed to the particle as this->gfx via SEGMENTED_TO_VIRTUAL.
+static Gfx sFlashDList[15];  // was D_809A5100 [LLM:HIGH]
 
 u32 EffectSsFhgFlash_Init(PlayState* play, u32 index, EffectSs* this, void* initParamsx) {
     EffectSsFhgFlashInitParams* initParams = (EffectSsFhgFlashInitParams*)initParamsx;
@@ -71,10 +72,10 @@ u32 EffectSsFhgFlash_Init(PlayState* play, u32 index, EffectSs* this, void* init
 
         if (initParams->param != FHGFLASH_SHOCK_NO_ACTOR) {
             this->pos = sp34;
-            this->gfx = SEGMENTED_TO_VIRTUAL(D_809A5100);
+            this->gfx = SEGMENTED_TO_VIRTUAL(sFlashDList);  // was D_809A5100 [LLM:HIGH]
         } else {
             this->pos = initParams->pos;
-            this->gfx = SEGMENTED_TO_VIRTUAL(D_809A5100);
+            this->gfx = SEGMENTED_TO_VIRTUAL(sFlashDList);  // was D_809A5100 [LLM:HIGH]
         }
     }
     return 1;
@@ -207,7 +208,7 @@ static Vtx D_809A50C0[4] = {
     VTX(-10, 10, 0, 0, 0, 0xFF, 0xFF, 0xFF, 0xFF),
 };
 
-static Gfx D_809A5100[15] = {
+static Gfx sFlashDList[15] = {  // was D_809A5100 [LLM:HIGH]
     gsDPPipeSync(),
     gsDPSetTextureLUT(G_TT_NONE),
     gsSPTexture(0xFFFF, 0xFFFF, 0, G_TX_RENDERTILE, G_ON),
-- 
