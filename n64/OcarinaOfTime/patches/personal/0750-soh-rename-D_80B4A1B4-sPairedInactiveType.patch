From 9a33bf89752f7afd8a3a54c8a318ba852436c971 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:48 +0000
Subject: [PATCH 750/784] soh: rename D_80B4A1B4 -> sPairedInactiveType

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c.
---
 soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c | 37 +++++++++++----------
 1 file changed, 19 insertions(+), 18 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c b/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
index 5268097e6..de92a338a 100644
--- a/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
+++ b/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
@@ -108,11 +108,12 @@ static Vec3f sPlatformPositions[] = {
 // These seem to relate to the tagging in/out the minibosses do
 // Name from zeldaret/oot (was D_80B4A1B0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Zf/z_en_zf.c]
 static s16 sPairedActiveFleeFlag = 0;
-static s16 D_80B4A1B4 = 1;
+// Name from zeldaret/oot (was D_80B4A1B4): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Zf/z_en_zf.c]
+static s16 sPairedInactiveType = 1;
 
 #define EN_ZF_SHIP_SAVESTATE_FIELDS(F) \
     F(sPairedActiveFleeFlag)                      \
-    F(D_80B4A1B4)
+    F(sPairedInactiveType)
 
 SHIP_SAVESTATE_DEFINE(EnZf, EN_ZF_SHIP_SAVESTATE_FIELDS)
 
@@ -349,7 +350,7 @@ void EnZf_Init(Actor* thisx, PlayState* play) {
 
     if (thisx->params < ENZF_TYPE_LIZALFOS_MINIBOSS_A) { // Not minibosses
         this->homePlatform = this->curPlatform = -1;
-        D_80B4A1B4 = -1;
+        sPairedInactiveType = -1;
         this->hopAnimIndex = 1;
         if (thisx->params == ENZF_TYPE_LIZALFOS_LONE) {
             EnZf_SetupDropIn(this);
@@ -362,7 +363,7 @@ void EnZf_Init(Actor* thisx, PlayState* play) {
