From 9edc48d246101751f69e2bdbe7ed186fbc5d7a35 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:08 +0000
Subject: [PATCH 1673/3799] soh: rename D_80B2EB58 -> sEyeQuadBottomLeft

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the fourth corner of that same eye quad.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index 6f107e99f..bd31f4739 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -124,7 +124,8 @@ static Vec3f sEyeQuadBottomRight = { 1000.0f, -700.0f, 2000.0f };  // was D_80B2
 // LLM generated name (HIGH), was D_80B2EB4C: the third corner of that same eye quad.
 static Vec3f sEyeQuadTopLeft = { -1000.0f, 700.0f, 1500.0f };  // was D_80B2EB4C [LLM:HIGH]
 
-static Vec3f D_80B2EB58 = { -1000.0f, -700.0f, 1500.0f };
+// LLM generated name (HIGH), was D_80B2EB58: the fourth corner of that same eye quad.
+static Vec3f sEyeQuadBottomLeft = { -1000.0f, -700.0f, 1500.0f };  // was D_80B2EB58 [LLM:HIGH]
 
 static Vec3f D_80B2EB64 = { 500.0f, 0.0f, 0.0f };
 
@@ -519,7 +520,7 @@ void EnVm_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
         Matrix_MultVec3f(&sEyeQuadTopRight, &this->colliderQuad2.dim.quad[1]);  // was D_80B2EB34 [LLM:HIGH]
         Matrix_MultVec3f(&sEyeQuadBottomRight, &this->colliderQuad2.dim.quad[0]);  // was D_80B2EB40 [LLM:HIGH]
         Matrix_MultVec3f(&sEyeQuadTopLeft, &this->colliderQuad2.dim.quad[3]);  // was D_80B2EB4C [LLM:HIGH]
-        Matrix_MultVec3f(&D_80B2EB58, &this->colliderQuad2.dim.quad[2]);
+        Matrix_MultVec3f(&sEyeQuadBottomLeft, &this->colliderQuad2.dim.quad[2]);  // was D_80B2EB58 [LLM:HIGH]
         Collider_SetQuadVertices(&this->colliderQuad2, &this->colliderQuad2.dim.quad[0],
                                  &this->colliderQuad2.dim.quad[1], &this->colliderQuad2.dim.quad[2],
                                  &this->colliderQuad2.dim.quad[3]);
-- 
