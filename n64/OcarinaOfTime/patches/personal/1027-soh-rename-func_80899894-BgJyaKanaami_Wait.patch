-void func_80899894(BgJyaKanaami* this, PlayState* play) {
+void BgJyaKanaami_Wait(BgJyaKanaami* this, PlayState* play) {
     if (Flags_GetSwitch(play, this->dyna.actor.params & 0x3F) || this->unk_16A > 0) {
