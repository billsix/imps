From b3444d7cf67b1f5806ecbc22fa81462f80d95cd0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:48 +0000
Subject: [PATCH 073/225] soh: rename func_800D31F0 -> Debug_UpdateCtrlr2Valid

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/debug_ctrlr2.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h     | 2 +-
 soh/src/code/debug_ctrlr2.c | 3 ++-
 soh/src/code/graph.c        | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index c65502bc9..827b6435d 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1834,7 +1834,7 @@ void func_800D2E30(RumbleMgr* arg0);
 void func_800D3140(RumbleMgr* arg0);
 void func_800D3178(RumbleMgr* arg0);
 void Freeze_CurrentThread(void);  // was func_800D31A0 [oot]
-void func_800D31F0(void);
+void Debug_UpdateCtrlr2Valid(void);  // was func_800D31F0 [LLM:HIGH]
 void func_800D3210(void);
 void IrqMgr_AddClient(IrqMgr* this, IrqMgrClient* c, OSMesgQueue* msgQ);
 void IrqMgr_RemoveClient(IrqMgr* this, IrqMgrClient* c);
diff --git a/soh/src/code/debug_ctrlr2.c b/soh/src/code/debug_ctrlr2.c
index 1f0f07265..eb2fed635 100644
--- a/soh/src/code/debug_ctrlr2.c
+++ b/soh/src/code/debug_ctrlr2.c
@@ -11,7 +11,8 @@ void Freeze_CurrentThread(void) {
     }
 }
 
-void func_800D31F0(void) {
+// LLM generated name (HIGH), was func_800D31F0: sets gIsCtrlr2Valid from controller-2 bit in padMgr mask.
+void Debug_UpdateCtrlr2Valid(void) {
     gIsCtrlr2Valid = (gPadMgr.validCtrlrsMask & 2) != 0;
 }
 
diff --git a/soh/src/code/graph.c b/soh/src/code/graph.c
index 4190955a9..86d4a57f8 100644
--- a/soh/src/code/graph.c
+++ b/soh/src/code/graph.c
@@ -157,7 +157,7 @@ void Graph_Init(GraphicsContext* gfxCtx) {
     gfxCtx->xScale = gViConfigXScale;
     gfxCtx->yScale = gViConfigYScale;
     osCreateMesgQueue(&gfxCtx->queue, gfxCtx->msgBuff, ARRAY_COUNT(gfxCtx->msgBuff));
-    func_800D31F0();
+    Debug_UpdateCtrlr2Valid();
     Fault_AddClient(&sGraphFaultClient, Graph_FaultClient, 0, 0);
 }
 
