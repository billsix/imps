From 41c18da1a5ad86429fdc5a55eac82217b66ef568 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:20 +0000
Subject: [PATCH 647/784] soh: rename func_8098F5D0 -> DemoSa_Credits_LookUp

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 0b0e2b6aa..6e005d277 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -571,7 +571,8 @@ void DemoSa_Credits_LookDown(DemoSa* this) {
     this->action = 14;
 }
 
-void func_8098F5D0(DemoSa* this) {
+// Name from zeldaret/oot (was func_8098F5D0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_Credits_LookUp(DemoSa* this) {
     DemoSa_AnimationChange(this, &gSariaSitting2Anim, 2, 0.0f, 0);
     this->action = 15;
 }
@@ -600,7 +601,7 @@ void func_8098F654(DemoSa* this, PlayState* play) {
                     DemoSa_Credits_LookDown(this);
                     break;
                 case 9:
-                    func_8098F5D0(this);
+                    DemoSa_Credits_LookUp(this);
                     break;
                 default:
                     osSyncPrintf("Demo_Sa_inEnding_Check_DemoMode:そんな動作は無い!!!!!!!!\n");
