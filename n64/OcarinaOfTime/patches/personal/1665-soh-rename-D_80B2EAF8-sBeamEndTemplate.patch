From 4f46472783c852f681eb7ddfd17eee2620db7a30 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:07 +0000
Subject: [PATCH 1665/3799] soh: rename D_80B2EAF8 -> sBeamEndTemplate

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the template copied into the local that is stretched to the beam's current length to find its far end.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index e543597ba..06ba27da2 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -100,7 +100,8 @@ static ColliderQuadInit sQuadInit2 = {
 // LLM generated name (HIGH), was D_80B2EAEC: the zero velocity and acceleration handed to EffectSsDeadDd_Spawn when the Beamos dies.
 static Vec3f sZeroVec = { 0.0f, 0.0f, 0.0f };  // was D_80B2EAEC [LLM:HIGH]
 
-static Vec3f D_80B2EAF8 = { 0.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80B2EAF8: the template copied into the local that is stretched to the beam's current length to find its far end.
+static Vec3f sBeamEndTemplate = { 0.0f, 0.0f, 0.0f };  // was D_80B2EAF8 [LLM:HIGH]
 
 static Vec3f D_80B2EB04 = { 500.0f, 0.0f, 0.0f };
 
@@ -469,7 +470,7 @@ s32 EnVm_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 
 void EnVm_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
     EnVm* this = (EnVm*)thisx;
-    Vec3f sp80 = D_80B2EAF8;
+    Vec3f sp80 = sBeamEndTemplate;  // was D_80B2EAF8 [LLM:HIGH]
     Vec3f sp74 = D_80B2EB04;
     Vec3f sp68 = D_80B2EB10;
     s32 pad;
