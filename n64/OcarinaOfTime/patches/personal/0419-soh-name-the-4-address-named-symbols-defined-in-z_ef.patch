 // LLM generated name (HIGH), was func_809A9E88: the first force pass: pulls the fragment back toward its origin at one of two strengths, chosen by the low bits of the behaviour flags.
 s32 EffectSsKakera_ApplyAttraction(EffectSs* this, Vec3f* diff, f32 dist) {
-    static f32 D_809AA558[] = { 0.05f, 1.0f };
+    static f32 sAttractionParams[] = { 0.05f, 1.0f };  // was D_809AA558 [LLM:HIGH]
     s32 temp_v0;
     f32 phi_f0;
 
@@ -241,8 +241,8 @@ s32 EffectSsKakera_ApplyAttraction(EffectSs* this, Vec3f* diff, f32 dist) {
             phi_f0 = 1.0f;
         }
 
-        this->accel.x += ((D_809AA558[temp_v0 - 1] * diff->z) * phi_f0);
-        this->accel.z -= ((D_809AA558[temp_v0 - 1] * diff->x) * phi_f0);
+        this->accel.x += ((sAttractionParams[temp_v0 - 1] * diff->z) * phi_f0);  // was D_809AA558 [LLM:HIGH]
+        this->accel.z -= ((sAttractionParams[temp_v0 - 1] * diff->x) * phi_f0);  // was D_809AA558 [LLM:HIGH]
     }
 
     return 1;
@@ -250,13 +250,13 @@ s32 EffectSsKakera_ApplyAttraction(EffectSs* this, Vec3f* diff, f32 dist) {
 
 // LLM generated name (HIGH), was func_809A9F10: the second force pass: adds one of seven fixed vertical accelerations, chosen by the next bits of the behaviour flags.
 s32 EffectSsKakera_ApplyBuoyancy(EffectSs* this, Vec3f* diff, f32 dist) {
-    static f32 D_809AA560[] = { 4.0f, 0.1f, 0.3f, 0.9f, -0.1f, -0.3f, -0.9f };
+    static f32 sBuoyancyParams[] = { 4.0f, 0.1f, 0.3f, 0.9f, -0.1f, -0.3f, -0.9f };  // was D_809AA560 [LLM:HIGH]
     s32 temp_v0;
 
     temp_v0 = (this->rReg0 >> 2) & 7;
 
     if (temp_v0 != 0) {
-        this->accel.y += D_809AA560[temp_v0];
+        this->accel.y += sBuoyancyParams[temp_v0];  // was D_809AA560 [LLM:HIGH]
     }
 
     return 1;
@@ -264,7 +264,7 @@ s32 EffectSsKakera_ApplyBuoyancy(EffectSs* this, Vec3f* diff, f32 dist) {
 
 // LLM generated name (HIGH), was func_809A9F4C: the third force pass: pushes the fragment away from its origin at one of three strengths.
 s32 EffectSsKakera_ApplyRepulsion(EffectSs* this, Vec3f* diff, f32 dist) {
-    static f32 D_809AA57C[] = { 0.1f, 1.0f, 6.0f };
+    static f32 sRepulsionParams[] = { 0.1f, 1.0f, 6.0f };  // was D_809AA57C [LLM:HIGH]
     s32 temp_v0;
     f32 phi_f0;
 
@@ -278,8 +278,8 @@ s32 EffectSsKakera_ApplyRepulsion(EffectSs* this, Vec3f* diff, f32 dist) {
             phi_f0 = 1.0f;
         }
 
-        this->accel.x -= ((diff->x * D_809AA57C[temp_v0 - 1]) * phi_f0);
-        this->accel.z -= ((diff->z * D_809AA57C[temp_v0 - 1]) * phi_f0);
+        this->accel.x -= ((diff->x * sRepulsionParams[temp_v0 - 1]) * phi_f0);  // was D_809AA57C [LLM:HIGH]
+        this->accel.z -= ((diff->z * sRepulsionParams[temp_v0 - 1]) * phi_f0);  // was D_809AA57C [LLM:HIGH]
     }
 
     return 1;
@@ -360,7 +360,7 @@ s32 EffectSsKakera_UpdateAccel(EffectSs* this) {
 
 // LLM generated name (HIGH), was func_809AA230: stops the fragment dead once it has fallen below the floor, clearing its velocity, acceleration, gravity and spin.
 void EffectSsKakera_UpdateGrounded(EffectSs* this, PlayState* play) {
-    static f32 D_809AA5B0[] = { 10.0f, 20.0f, 40.0f };
+    static f32 sGroundedBounceSpeeds[] = { 10.0f, 20.0f, 40.0f };  // was D_809AA5B0 [LLM:HIGH]
     Player* player = GET_PLAYER(play);
 
     if (this->rReg8 == 0) {
@@ -386,7 +386,7 @@ void EffectSsKakera_UpdateGrounded(EffectSs* this, PlayState* play) {
                 break;
             case 1:
                 if (this->velocity.y < 0.0f) {
-                    if (BgCheck_SphVsFirstPoly(&play->colCtx, &this->pos, D_809AA5B0[(this->rReg4 >> 2) & 3])) {
+                    if (BgCheck_SphVsFirstPoly(&play->colCtx, &this->pos, sGroundedBounceSpeeds[(this->rReg4 >> 2) & 3])) {  // was D_809AA5B0 [LLM:HIGH]
                         this->velocity.x *= EffectSsKakera_RandCentered(0.9f, 0.2f);  // was func_809A9818 [LLM:HIGH]
                         this->velocity.y *= -0.8f;
                         this->velocity.z *= EffectSsKakera_RandCentered(0.9f, 0.2f);  // was func_809A9818 [LLM:HIGH]
@@ -398,7 +398,7 @@ void EffectSsKakera_UpdateGrounded(EffectSs* this, PlayState* play) {
                 }
                 break;
             case 2:
-                if (BgCheck_SphVsFirstPoly(&play->colCtx, &this->pos, D_809AA5B0[(this->rReg4 >> 2) & 3])) {}
+                if (BgCheck_SphVsFirstPoly(&play->colCtx, &this->pos, sGroundedBounceSpeeds[(this->rReg4 >> 2) & 3])) {}  // was D_809AA5B0 [LLM:HIGH]
                 break;
         }
     }
