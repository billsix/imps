From 188e354edc6a20d9c953bb41ad52c6bf0fae3bf1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:51:22 +0000
Subject: [PATCH 1133/3799] soh: rename D_80BA1B8C -> sFragmentDLists

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the matching pot-fragment display lists, indexed the same way and passed to the air and water break effects.
Defined in soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c b/soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c
index 19803aade..f5ad20ad9 100644
--- a/soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c
+++ b/soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c
@@ -59,7 +59,8 @@ static s16 sObjectIds[] = { OBJECT_GAMEPLAY_DANGEON_KEEP, OBJECT_TSUBO };
 // LLM generated name (HIGH), was D_80BA1B84: the two pot display lists, indexed by params bit 8 in the draw function.
 static Gfx* sDLists[] = { gPotDL, object_tsubo_DL_0017C0 };  // was D_80BA1B84 [LLM:HIGH]
 
-static Gfx* D_80BA1B8C[] = { gPotFragmentDL, object_tsubo_DL_001960 };
+// LLM generated name (HIGH), was D_80BA1B8C: the matching pot-fragment display lists, indexed the same way and passed to the air and water break effects.
+static Gfx* sFragmentDLists[] = { gPotFragmentDL, object_tsubo_DL_001960 };  // was D_80BA1B8C [LLM:HIGH]
 
 static ColliderCylinderInit sCylinderInit = {
     {
@@ -191,7 +192,7 @@ void ObjTsubo_AirBreak(ObjTsubo* this, PlayState* play) {
         }
         EffectSsKakera_Spawn(play, &pos, &velocity, &this->actor.world.pos, -240, arg5, 10, 10, 0,
                              (Rand_ZeroOne() * 95.0f) + 15.0f, 0, 32, 60, KAKERA_COLOR_NONE,
-                             sObjectIds[(this->actor.params >> 8) & 1], D_80BA1B8C[(this->actor.params >> 8) & 1]);
+                             sObjectIds[(this->actor.params >> 8) & 1], sFragmentDLists[(this->actor.params >> 8) & 1]);  // was D_80BA1B8C [LLM:HIGH]
     }
     func_80033480(play, &this->actor.world.pos, 30.0f, 4, 20, 50, 1);
     gSaveContext.ship.stats.count[COUNT_POTS_BROKEN]++;
@@ -221,7 +222,7 @@ void ObjTsubo_WaterBreak(ObjTsubo* this, PlayState* play) {
         phi_s0 = (Rand_ZeroOne() < .2f) ? 64 : 32;
         EffectSsKakera_Spawn(play, &pos, &velocity, &this->actor.world.pos, -180, phi_s0, 30, 30, 0,
                              (Rand_ZeroOne() * 95.0f) + 15.0f, 0, 32, 70, KAKERA_COLOR_NONE,
-                             sObjectIds[(this->actor.params >> 8) & 1], D_80BA1B8C[(this->actor.params >> 8) & 1]);
+                             sObjectIds[(this->actor.params >> 8) & 1], sFragmentDLists[(this->actor.params >> 8) & 1]);  // was D_80BA1B8C [LLM:HIGH]
     }
     gSaveContext.ship.stats.count[COUNT_POTS_BROKEN]++;
 }
