@@ -393,7 +394,7 @@ void EnNy_Update(Actor* thisx, PlayState* play) {
     this->collider.elements[0].dim.scale = 1.33f * temp_f20 + 1.0f;
     temp_f22 = (24.0f * temp_f20) + 12.0f;
