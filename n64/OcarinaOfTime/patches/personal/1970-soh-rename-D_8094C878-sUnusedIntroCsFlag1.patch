From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:06:36 +0000
Subject: [PATCH 1970/3799] soh: rename D_8094C878 -> sUnusedIntroCsFlag1

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: set to 1 then 0 during the intro cutscene and never read
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index 587d29dae..31ddd38a4 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -203,7 +203,8 @@ static s16 sShieldFlashScroll;  // was D_8094C872 [LLM:HIGH]
 static s16 sUnusedIntroCsValue1;  // was D_8094C874 [LLM:GUESS]
 // LLM generated name (GUESS), was D_8094C876: written as 10 alongside sUnusedIntroCsValue1 and never read
 static s16 sUnusedIntroCsValue2;  // was D_8094C876 [LLM:GUESS]
-static u8 D_8094C878;
+// LLM generated name (GUESS), was D_8094C878: set to 1 then 0 during the intro cutscene and never read
+static u8 sUnusedIntroCsFlag1;  // was D_8094C878 [LLM:GUESS]
 static s16 D_8094C87A;
 static s16 D_8094C87C;
 static u8 D_8094C87E;
@@ -477,7 +478,7 @@ void BossTw_Init(Actor* thisx, PlayState* play2) {
         play->envCtx.unk_BD = 1;
         play->envCtx.unk_D8 = 0.0f;
 
-        sUnusedIntroCsValue1 = sUnusedIntroCsValue2 = D_8094C878 = D_8094C87A = D_8094C87C = D_8094C87E = sShieldBlastActive = sShieldFlashTimer =  // was D_8094C86F [LLM:HIGH]
+        sUnusedIntroCsValue1 = sUnusedIntroCsValue2 = sUnusedIntroCsFlag1 = D_8094C87A = D_8094C87C = D_8094C87E = sShieldBlastActive = sShieldFlashTimer =  // was D_8094C86F [LLM:HIGH]
             sShieldFlashScroll = sBeamDivertTimer = sEnvType = sGroundBlastType = sFreezeState = sTwinrovaBlastType =  // was D_8094C872 [LLM:HIGH]
                 sFixedBlatSeq = sShieldFireCharge = sShieldIceCharge = 0;
 
@@ -2443,7 +2444,7 @@ void BossTw_DeathCSMsgSfx(BossTw* this, PlayState* play) {
     if (this->work[CS_TIMER_2] == 430) {
         koumeAnim = 4;
         sUnusedIntroCsValue1 = 435;  // was D_8094C874 [LLM:GUESS]
-        D_8094C878 = 1;
+        sUnusedIntroCsFlag1 = 1;  // was D_8094C878 [LLM:GUESS]
     }
 
     if (this->work[CS_TIMER_2] > 440 && this->work[CS_TIMER_2] < 860) {
@@ -2526,7 +2527,7 @@ void BossTw_DeathCSMsgSfx(BossTw* this, PlayState* play) {
         if (sp35) {
             sUnusedIntroCsValue2 = 10;  // was D_8094C876 [LLM:GUESS]
             sUnusedIntroCsValue1 = sp35;  // was D_8094C874 [LLM:GUESS]
-            D_8094C878 = 0;
+            sUnusedIntroCsFlag1 = 0;  // was D_8094C878 [LLM:GUESS]
         }
     }
 
