From 9055fbadcb0e0af41ef6d485485d41331d9c0ef6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:43 +0000
Subject: [PATCH 3128/3799] soh: rename D_801237CC -> sCs4022KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 4022 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 6 +++---
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 17bbd683d..5ee335cdf 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -1096,10 +1096,10 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
             break;
         case 4022:
-            csCam->timer = D_801237CC[0].timerInit + D_801237CC[3].timerInit + D_801237CC[1].timerInit +
-                           D_801237CC[2].timerInit + D_801237CC[4].timerInit;
+            csCam->timer = sCs4022KeyFrames[0].timerInit + sCs4022KeyFrames[3].timerInit + sCs4022KeyFrames[1].timerInit +  // was D_801237CC [LLM:HIGH]
+                           sCs4022KeyFrames[2].timerInit + sCs4022KeyFrames[4].timerInit;  // was D_801237CC [LLM:HIGH]
 
-            csInfo->keyFrames = D_801237CC;
+            csInfo->keyFrames = sCs4022KeyFrames;  // was D_801237CC [LLM:HIGH]
             csInfo->keyFrameCnt = 5;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 42591d427..e05f7879e 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -722,7 +722,8 @@ static OnePointCsFull sCs4021KeyFrames[4] = {  // was D_8012372C [LLM:HIGH]
     { 0x03, 0xFF, 0x4242, 60, 2, 45.0f, 0.01f, { 0.0f, 150.0f, 50.0f }, { 0.0f, 200.0f, -80.0f } },
 };
 
-static OnePointCsFull D_801237CC[5] = {
+// LLM generated name (HIGH), was D_801237CC: the keyframe set one-point cutscene 4022 installs
+static OnePointCsFull sCs4022KeyFrames[5] = {  // was D_801237CC [LLM:HIGH]
     { 0x8F, 0xFF, 0x4242, 20, 0, 50.0f, 1.0f, { 0.0f, 50.0f, -10.0f }, { 0.0f, 0.0f, 100.0f } },
     { 0x0A, 0xFF, 0x0101, 80, 0, 75.0f, 1.0f, { 2900.0f, 1300.0f, 530.0f }, { 2800.0f, 1190.0f, 540.0f } },
     { 0x0F, 0xFF, 0x0000, 10, 0, 75.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
