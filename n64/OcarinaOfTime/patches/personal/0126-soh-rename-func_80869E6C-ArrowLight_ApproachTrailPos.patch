Subject: [PATCH 0126/3799] soh: rename func_80869E6C ->
 ArrowLight_ApproachTrailPos

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_Arrow_Light/z_arrow_light.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_Arrow_Light/z_arrow_light.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Arrow_Light/z_arrow_light.c b/soh/src/overlays/actors/ovl_Arrow_Light/z_arrow_light.c
index 406aebc1d..0711db4b2 100644
--- a/soh/src/overlays/actors/ovl_Arrow_Light/z_arrow_light.c
+++ b/soh/src/overlays/actors/ovl_Arrow_Light/z_arrow_light.c
@@ -86,7 +86,9 @@ void ArrowLight_Charge(ArrowLight* this, PlayState* play) {
     }
 }
 
-void func_80869E6C(Vec3f* unkPos, Vec3f* lightPos, f32 scale) {
+// LLM generated name (HIGH), was func_80869E6C: lerps unkPos toward lightPos by scale for the light-arrow
+// trail
+void ArrowLight_ApproachTrailPos(Vec3f* unkPos, Vec3f* lightPos, f32 scale) {
     unkPos->x += ((lightPos->x - unkPos->x) * scale);
     unkPos->y += ((lightPos->y - unkPos->y) * scale);
     unkPos->z += ((lightPos->z - unkPos->z) * scale);
@@ -160,7 +162,7 @@ void ArrowLight_Fly(ArrowLight* this, PlayState* play) {
     if (distanceScaled < 1.0f) {
         this->unk_160 = 1.0f;
     }
-    func_80869E6C(&this->unkPos, &this->actor.world.pos, 0.05f);
+    ArrowLight_ApproachTrailPos(&this->unkPos, &this->actor.world.pos, 0.05f);
 
     if (arrow->hitFlags & 1) {
         Audio_PlayActorSound2(&this->actor, NA_SE_IT_EXPLOSION_LIGHT);
