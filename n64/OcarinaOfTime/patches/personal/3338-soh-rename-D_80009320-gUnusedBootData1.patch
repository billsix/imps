From fce55bef7d0c6ed778d05a2d07699428e94fe1f9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:14:46 +0000
Subject: [PATCH 3338/3799] soh: rename D_80009320 -> gUnusedBootData1

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: a boot-segment byte array declared in variables.h that nothing in the tree references; the declaration is all that survives
Defined in soh/include/variables.h.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/variables.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/soh/include/variables.h b/soh/include/variables.h
index 32006529c..94ea87a40 100644
--- a/soh/include/variables.h
+++ b/soh/include/variables.h
@@ -15,7 +15,7 @@ extern "C"
 	extern u32 osMemSize;
 	extern u8 osAppNmiBuffer[0x40];
 
-	extern u8 D_80009320[];
+	extern u8 gUnusedBootData1[];  // was D_80009320 [LLM:GUESS]
 	extern u8 D_800093F0[];
 	extern s8 gViConfigChanged;  // was D_80009430 [LLM:GUESS]
 	extern u32 gDmaMgrVerbose;  // was D_80009460 [oot]
