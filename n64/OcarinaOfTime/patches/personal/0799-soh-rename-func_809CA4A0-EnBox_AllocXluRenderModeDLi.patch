From f38c2279724e393006d149f076f3e7757999b41a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:23:51 +0000
Subject: [PATCH 0799/3799] soh: rename func_809CA4A0 ->
 EnBox_AllocXluRenderModeDList

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: allocates a two-command display list that sets a ZMODE_XLU translucent render mode and ends; bound to segment 8 of POLY_XLU_DISP when drawing the chest.
Defined in soh/src/overlays/actors/ovl_En_Box/z_en_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Box/z_en_box.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Box/z_en_box.c b/soh/src/overlays/actors/ovl_En_Box/z_en_box.c
index 3f1777aca..11178241a 100644
--- a/soh/src/overlays/actors/ovl_En_Box/z_en_box.c
+++ b/soh/src/overlays/actors/ovl_En_Box/z_en_box.c
@@ -673,7 +673,8 @@ Gfx* EnBox_EmptyDList(GraphicsContext* gfxCtx) {
 }
 
 // set render mode with a focus on transparency
-Gfx* func_809CA4A0(GraphicsContext* gfxCtx) {
+// LLM generated name (HIGH), was func_809CA4A0: allocates a two-command display list that sets a ZMODE_XLU translucent render mode and ends; bound to segment 8 of POLY_XLU_DISP when drawing the chest.
+Gfx* EnBox_AllocXluRenderModeDList(GraphicsContext* gfxCtx) {
     Gfx* dList;
     Gfx* dListHead;
 
@@ -732,7 +733,7 @@ void EnBox_Draw(Actor* thisx, PlayState* play) {
         if (this->type == ENBOX_TYPE_4 || this->type == ENBOX_TYPE_6) {
             gSPSegment(POLY_XLU_DISP++, 0x08, func_809CA518(play->state.gfxCtx));
         } else {
-            gSPSegment(POLY_XLU_DISP++, 0x08, func_809CA4A0(play->state.gfxCtx));
+            gSPSegment(POLY_XLU_DISP++, 0x08, EnBox_AllocXluRenderModeDList(play->state.gfxCtx));  // was func_809CA4A0 [LLM:HIGH]
         }
         POLY_XLU_DISP = SkelAnime_DrawSkeleton2(play, &this->skelanime, NULL, EnBox_PostLimbDraw, this, POLY_XLU_DISP);
     }
