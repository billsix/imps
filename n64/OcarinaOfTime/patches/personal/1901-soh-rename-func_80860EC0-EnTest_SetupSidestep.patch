From fa4244db51022c0f05d24a856477edb71df10c2a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:03:10 +0000
Subject: [PATCH 1901/3799] soh: rename func_80860EC0 -> EnTest_SetupSidestep

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: same gStalfosSidestepAnim as the circling pair; distinguished only by starting from rest at +/-0.5 speed and by being the variant taken when another actor is targeted
Defined in soh/src/overlays/actors/ovl_En_Test/z_en_test.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Test/z_en_test.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Test/z_en_test.c b/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
index 854379ba6..e10177936 100644
--- a/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
+++ b/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
@@ -22,7 +22,8 @@ void EnTest_SetupSlashDownEnd(EnTest* this);
 void EnTest_SetupSlashUp(EnTest* this);
 void EnTest_SetupJumpslash(EnTest* this);
 void EnTest_SetupWalkAndBlock(EnTest* this);
-void func_80860EC0(EnTest* this);
+// LLM generated name (GUESS), was func_80860EC0: same gStalfosSidestepAnim as the circling pair; distinguished only by starting from rest at +/-0.5 speed and by being the variant taken when another actor is targeted
+void EnTest_SetupSidestep(EnTest* this);  // was func_80860EC0 [LLM:GUESS]
 void EnTest_SetupSlashDown(EnTest* this);
 // LLM generated name (HIGH), was func_80860BDC: loops gStalfosSidestepAnim and hands off to the action that swings shape.rot.y onto yawTowardsPlayer with NA_SE_EN_STAL_WALK footsteps
 void EnTest_SetupTurnToPlayer(EnTest* this);  // was func_80860BDC [LLM:HIGH]
@@ -675,7 +676,7 @@ void EnTest_WalkAndBlock(EnTest* this, PlayState* play) {
 
                     EnTest_ChooseAction(this, play);
                 } else {
-                    func_80860EC0(this);
+                    EnTest_SetupSidestep(this);  // was func_80860EC0 [LLM:GUESS]
                 }
             }
         }
@@ -767,7 +768,7 @@ void EnTest_TurnToPlayer(EnTest* this, PlayState* play) {
         if (Actor_IsFacingPlayer(&this->actor, 0x71C)) {
             if (Rand_ZeroOne() > 0.8f) {
                 if ((Rand_ZeroOne() > 0.7f)) {
-                    func_80860EC0(this);
+                    EnTest_SetupSidestep(this);  // was func_80860EC0 [LLM:GUESS]
                 } else {
                     EnTest_ChooseAction(this, play);
                 }
@@ -779,7 +780,7 @@ void EnTest_TurnToPlayer(EnTest* this, PlayState* play) {
 }
 
 // a variation of sidestep
-void func_80860EC0(EnTest* this) {
+void EnTest_SetupSidestep(EnTest* this) {
     Animation_PlayLoop(&this->skelAnime, &gStalfosSidestepAnim);
     this->unk_7C8 = 0xF;
     this->actor.speedXZ = (Rand_ZeroOne() > 0.5f) ? -0.5f : 0.5f;
@@ -1348,7 +1349,7 @@ void EnTest_Stunned(EnTest* this, PlayState* play) {
 // a variation of sidestep
 void func_808627C4(EnTest* this, PlayState* play) {
     if (Actor_OtherIsTargeted(play, &this->actor)) {
-        func_80860EC0(this);
+        EnTest_SetupSidestep(this);  // was func_80860EC0 [LLM:GUESS]
         return;
     }
 
