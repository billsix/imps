From e130d01d4b6a67b04a7ee0e840f98b2eb7f1a745 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:58 +0000
Subject: [PATCH 2521/3799] soh: rename D_801305C0 -> sSfxIntervalBase

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the period at full rate, and the constant the rate-scaled part is added to
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index d00d7ffe9..8a567d38c 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -123,7 +123,8 @@ s8 sFixedReverb = 35;  // was D_801305B4 [LLM:HIGH]
 s8 sSfxIntervalCounter = 20;  // was D_801305B8 [LLM:HIGH]
 // LLM generated name (HIGH), was D_801305BC: subtracted from the base in that period formula, so the fastest period is base minus this
 s8 sSfxIntervalLimit = 30;  // was D_801305BC [LLM:HIGH]
-s8 D_801305C0 = 20;
+// LLM generated name (HIGH), was D_801305C0: the period at full rate, and the constant the rate-scaled part is added to
+s8 sSfxIntervalBase = 20;  // was D_801305C0 [LLM:HIGH]
 f32 sBehindScreenZ[2] = { -15.0f, -65.0f };
 u8 sAudioIncreasingTranspose = 0;
 u8 gMorphaTransposeTable[16] = { 0, 0, 0, 1, 1, 2, 4, 6, 8, 8, 8, 8, 8, 8, 8, 8 };
@@ -1326,7 +1327,7 @@ s32 sAudioUpdateTaskEnd;      // decomp: debug only
     F(sFixedReverb)                                      \
     F(sSfxIntervalCounter)                                      \
     F(sSfxIntervalLimit)                                      \
-    F(D_801305C0)                                      \
+    F(sSfxIntervalBase)                                      \
     F(sAudioIncreasingTranspose)                       \
     F(sPrevChargeLevel)                                \
     F(sSfxSwordChargeFreq)                             \
@@ -4493,7 +4494,7 @@ void Audio_PlaySfxAtInterval(Vec3f* pos, u16 sfxId, f32 arg2) {
         if (arg2 > 2.0f) {
             arg2 = 2.0f;
         }
-        sSfxIntervalCounter = (s8)((D_801305C0 - sSfxIntervalLimit) * (1.0f - arg2)) + D_801305C0;  // was D_801305B8 [LLM:HIGH]
+        sSfxIntervalCounter = (s8)((sSfxIntervalBase - sSfxIntervalLimit) * (1.0f - arg2)) + sSfxIntervalBase;  // was D_801305B8 [LLM:HIGH]
     }
 }
 
@@ -4501,7 +4502,7 @@ void Audio_PlaySfxAtInterval(Vec3f* pos, u16 sfxId, f32 arg2) {
 void Audio_SetSfxIntervalRange(s8 arg0, s8 arg1) {
     sSfxIntervalCounter = 1;  // was D_801305B8 [LLM:HIGH]
     sSfxIntervalLimit = arg1;  // was D_801305BC [LLM:HIGH]
-    D_801305C0 = arg0;
+    sSfxIntervalBase = arg0;  // was D_801305C0 [LLM:HIGH]
 }
 
 // LLM generated name (HIGH), was func_800F4524: plays a sound with a caller-supplied reverb and default scales
-- 
