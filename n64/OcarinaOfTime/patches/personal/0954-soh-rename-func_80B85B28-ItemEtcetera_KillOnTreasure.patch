@@ -102,7 +103,7 @@ void ItemEtcetera_Init(Actor* thisx, PlayState* play) {
         case ITEM_ETC_HEART_PIECE_CHEST_GAME:
         case ITEM_ETC_KEY_SMALL_CHEST_GAME:
             Actor_SetScale(&this->actor, 0.5f);
-            this->futureActionFunc = func_80B85B28;
+            this->futureActionFunc = ItemEtcetera_KillOnTreasureFlag;  // was func_80B85B28 [LLM:HIGH]
             this->drawFunc = ItemEtcetera_DrawThroughLens;
             this->actor.world.pos.y += 15.0f;
             break;
@@ -176,7 +177,7 @@ void ItemEtcetera_MoveFireArrowDown(ItemEtcetera* this, PlayState* play) {
     ItemEtcetera_OfferItem(this, play);  // was func_80B85824 [LLM:HIGH]
 }
 
-void func_80B85B28(ItemEtcetera* this, PlayState* play) {
+void ItemEtcetera_KillOnTreasureFlag(ItemEtcetera* this, PlayState* play) {
     if (Flags_GetTreasure(play, (this->actor.params >> 8) & 0x1F)) {
         Actor_Kill(&this->actor);
     }
