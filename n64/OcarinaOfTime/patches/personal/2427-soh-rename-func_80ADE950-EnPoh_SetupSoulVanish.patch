From aa522f00882c9ba922bff4d11f71e7c0d076bee9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:08 +0000
Subject: [PATCH 2427/3799] soh: rename func_80ADE950 -> EnPoh_SetupSoulVanish

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the fade-out action, optionally laughing as the flame goes
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index cdb9d2675..d4af6ffdd 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -451,7 +451,8 @@ void EnPoh_Talk(EnPoh* this, PlayState* play) {
     this->actionFunc = func_80ADFE80;
 }
 
-void func_80ADE950(EnPoh* this, s32 arg1) {
+// LLM generated name (HIGH), was func_80ADE950: installs the fade-out action, optionally laughing as the flame goes
+void EnPoh_SetupSoulVanish(EnPoh* this, s32 arg1) {
     if (arg1) {
         Audio_StopSfxByPosAndId(&this->actor.projectedPos, NA_SE_EN_PO_BIG_CRY - SFX_FLAG);
         Audio_PlayActorSound2(&this->actor, NA_SE_EN_PO_LAUGH);
@@ -785,7 +786,7 @@ void func_80ADFE80(EnPoh* this, PlayState* play) {
         return;
     }
     if (this->unk_198 == 0) {
-        func_80ADE950(this, 1);
+        EnPoh_SetupSoulVanish(this, 1);  // was func_80ADE950 [LLM:HIGH]
         this->actor.flags &= ~ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED;
         return;
     }
@@ -842,7 +843,7 @@ void EnPoh_TalkRegular(EnPoh* this, PlayState* play) {
             Message_ContinueTextbox(play, this->actor.textId);
         }
     } else if (Actor_TextboxIsClosing(&this->actor, play)) {
-        func_80ADE950(this, 0);
+        EnPoh_SetupSoulVanish(this, 0);  // was func_80ADE950 [LLM:HIGH]
     }
 }
 
@@ -863,14 +864,14 @@ void EnPoh_TalkComposer(EnPoh* this, PlayState* play) {
                 } else {
                     Flags_SetSwitch(play, 0xA);
                 }
-                func_80ADE950(this, 1);
+                EnPoh_SetupSoulVanish(this, 1);  // was func_80ADE950 [LLM:HIGH]
             }
         }
     } else if (Actor_TextboxIsClosing(&this->actor, play)) {
         if (this->actor.textId == 0x5000) {
             Flags_SetSwitch(play, 9);
         }
-        func_80ADE950(this, 1);
+        EnPoh_SetupSoulVanish(this, 1);  // was func_80ADE950 [LLM:HIGH]
     }
 }
 
