From 9c3665694c8f36feaa95c5225e2f820a90b573e6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:46:32 +0000
Subject: [PATCH 1073/3799] soh: rename D_808125EC -> sNameEntryBoxXPositions

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the eleven X positions of the name-entry plate's boxes, added to nameEntryBoxPosX when building nameEntryVtx.
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/gamestates/ovl_file_choose/file_choose.h  | 2 +-
 .../gamestates/ovl_file_choose/z_file_nameset_NES.c        | 2 +-
 .../gamestates/ovl_file_choose/z_file_nameset_PAL.c        | 7 ++++---
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h b/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h
index 62084c095..95bdf690d 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h
+++ b/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h
@@ -253,7 +253,7 @@ extern s16 gKeyboardCharactersAlphanumeric[];
 
 extern s16 D_808127DC_ne0[];
 
-extern s16 D_808125EC[];
+extern s16 sNameEntryBoxXPositions[];  // was D_808125EC [LLM:HIGH]
 extern s16 D_80812604[];
 
 // Port Data:
diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c
index dd01c32ba..e58a5ca16 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c
@@ -184,7 +184,7 @@ void FileChoose_SetNameEntryVtxNES(GameState* thisx) {
 
     for (var_s0 = 0, var_t2 = 0; var_t2 < 44; var_t2 += 4, var_s0++) {
         this->nameEntryVtx[var_t2].v.ob[0] = this->nameEntryVtx[var_t2 + 2].v.ob[0] =
-            D_808125EC[var_s0] + this->nameEntryBoxPosX;
+            sNameEntryBoxXPositions[var_s0] + this->nameEntryBoxPosX;  // was D_808125EC [LLM:HIGH]
 
         this->nameEntryVtx[var_t2 + 1].v.ob[0] = this->nameEntryVtx[var_t2 + 3].v.ob[0] =
             this->nameEntryVtx[var_t2].v.ob[0] + 0xA;
diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
index 602cc7ab1..201710dd9 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
@@ -101,7 +101,8 @@ static void* sBackspaceEndTextures[][2] = {
 
 static u16 sBackspaceEndWidths[] = { 28, 44 };
 
-s16 D_808125EC[] = {
+// LLM generated name (HIGH), was D_808125EC: the eleven X positions of the name-entry plate's boxes, added to nameEntryBoxPosX when building nameEntryVtx.
+s16 sNameEntryBoxXPositions[] = {  // was D_808125EC [LLM:HIGH]
     0xFFE2, 0xFFF0, 0xFFFA, 0x0004, 0x000E, 0x0018, 0x0022, 0x002C, 0x0036, 0xFFF0, 0xFFF0,
 };
 
@@ -157,13 +158,13 @@ void FileChoose_SetNameEntryVtx(GameState* thisx) {
             temp = filename[phi_s0 - 1];
 
             this->nameEntryVtx[phi_t1].v.ob[0] = this->nameEntryVtx[phi_t1 + 2].v.ob[0] =
-                D_808125EC[phi_s0] + this->nameEntryBoxPosX + sNameCharXOffsets[temp];  // was D_808124C0 [LLM:HIGH]
+                sNameEntryBoxXPositions[phi_s0] + this->nameEntryBoxPosX + sNameCharXOffsets[temp];  // was D_808124C0 [LLM:HIGH]
 
             this->nameEntryVtx[phi_t1 + 1].v.ob[0] = this->nameEntryVtx[phi_t1 + 3].v.ob[0] =
                 this->nameEntryVtx[phi_t1].v.ob[0] + 0xA;
         } else {
             this->nameEntryVtx[phi_t1].v.ob[0] = this->nameEntryVtx[phi_t1 + 2].v.ob[0] =
-                D_808125EC[phi_s0] + this->nameEntryBoxPosX;
+                sNameEntryBoxXPositions[phi_s0] + this->nameEntryBoxPosX;  // was D_808125EC [LLM:HIGH]
 
             this->nameEntryVtx[phi_t1 + 1].v.ob[0] = this->nameEntryVtx[phi_t1 + 3].v.ob[0] =
                 this->nameEntryVtx[phi_t1].v.ob[0] + 0xA;
