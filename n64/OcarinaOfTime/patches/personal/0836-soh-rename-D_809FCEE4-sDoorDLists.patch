Subject: [PATCH 0836/3799] soh: rename D_809FCEE4 -> sDoorDLists

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Door/z_en_door.c.
---
 soh/src/overlays/actors/ovl_En_Door/z_en_door.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Door/z_en_door.c b/soh/src/overlays/actors/ovl_En_Door/z_en_door.c
index c68f48e47..e51666fa3 100644
--- a/soh/src/overlays/actors/ovl_En_Door/z_en_door.c
+++ b/soh/src/overlays/actors/ovl_En_Door/z_en_door.c
@@ -73,7 +73,8 @@ static u8 sDoorAnimOpenFrames[] = { 25, 25, 25, 25 };
 
 static u8 sDoorAnimCloseFrames[] = { 60, 70, 60, 70 };
 
-static Gfx* D_809FCEE4[5][2] = {
+// Name from zeldaret/oot (was D_809FCEE4): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Door/z_en_door.c]
+static Gfx* sDoorDLists[5][2] = {
     { gDoorLeftDL, gDoorRightDL },
     { gFireTempleDoorWithHandleLeftDL, gFireTempleDoorWithHandleRightDL },
     { gWaterTempleDoorLeftDL, gWaterTempleDoorRightDL },
@@ -320,7 +321,7 @@ s32 EnDoor_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f*
     EnDoor* this = (EnDoor*)thisx;
 
     if (limbIndex == 4) {
-        temp_a2 = D_809FCEE4[this->dListIndex];
+        temp_a2 = sDoorDLists[this->dListIndex];
         transitionEntry = &play->transiActorCtx.list[(u16)this->actor.params >> 0xA];
         rot->z += this->actor.world.rot.y;
         if ((play->roomCtx.prevRoom.num >= 0) || (transitionEntry->sides[0].room == transitionEntry->sides[1].room)) {
