From 491e464e962252c873dc8ac254f28683feb0b525 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:16:31 +0000
Subject: [PATCH 1398/3799] soh: rename func_80AFD0A4 -> EnSkb_SetupAdvance

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: starts the walking animation, clears the headless yaw wobble and sets the walk speed before installing EnSkb_Advance.
Defined in soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
index a3a96a5ee..07f60d42e 100644
--- a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
+++ b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
@@ -20,7 +20,8 @@ void EnSkb_Emerge(EnSkb* this, PlayState* play);  // was func_80AFCE5C [LLM:HIGH
 void EnSkb_SetupBurrow(EnSkb* this);  // was func_80AFCF48 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AFCFF0: sinks the Stalchild back underground with debris and a shrinking shadow, then kills the actor.
 void EnSkb_Burrow(EnSkb* this, PlayState* play);  // was func_80AFCFF0 [LLM:HIGH]
-void func_80AFD0A4(EnSkb* this);
+// LLM generated name (HIGH), was func_80AFD0A4: starts the walking animation, clears the headless yaw wobble and sets the walk speed before installing EnSkb_Advance.
+void EnSkb_SetupAdvance(EnSkb* this);  // was func_80AFD0A4 [LLM:HIGH]
 void EnSkb_Advance(EnSkb* this, PlayState* play);
 void func_80AFD33C(EnSkb* this);
 void EnSkb_SetupAttack(EnSkb* this, PlayState* play);
@@ -206,7 +207,7 @@ void EnSkb_ChooseAction(EnSkb* this) {
                (this->actor.xzDistToPlayer < (60.0f + (this->actor.params * 6.0f)))) {
         func_80AFD33C(this);
     } else {
-        func_80AFD0A4(this);
+        EnSkb_SetupAdvance(this);  // was func_80AFD0A4 [LLM:HIGH]
     }
 }
 
@@ -257,7 +258,7 @@ void EnSkb_Burrow(EnSkb* this, PlayState* play) {
     }
 }
 
-void func_80AFD0A4(EnSkb* this) {
+void EnSkb_SetupAdvance(EnSkb* this) {
     Animation_Change(&this->skelAnime, &gStalchildWalkingAnim, 0.96000004f, 0.0f,
                      Animation_GetLastFrame(&gStalchildWalkingAnim), ANIMMODE_LOOP, -4.0f);
     this->actionState = 4;
