From 0f1d6e1ae71f8e30dca284900b49fbb4d6d42310 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:13:52 +0000
Subject: [PATCH 1371/3799] soh: rename func_80AAF330 -> EnMm2_StandUp

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: waits for the stand-up animation to finish, switches to the running animation and open mouth, clears the sub-timer and race flag, and hands off to EnMm2_RunAway.
Defined in soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c b/soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c
index 045db6fd4..89a2ba8de 100644
--- a/soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c
+++ b/soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c
@@ -189,7 +189,8 @@ void EnMm2_RunAway(EnMm2* this, PlayState* play) {
     Math_SmoothStepToF(&this->actor.speedXZ, 10.0f, 0.6f, 2.0f, 0.0f);
 }
 
-void func_80AAF330(EnMm2* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AAF330: waits for the stand-up animation to finish, switches to the running animation and open mouth, clears the sub-timer and race flag, and hands off to EnMm2_RunAway.
+void EnMm2_StandUp(EnMm2* this, PlayState* play) {
     if (SkelAnime_Update(&this->skelAnime)) {
         this->actionFunc = EnMm2_RunAway;  // was func_80AAF2BC [LLM:HIGH]
         EnMm2_ChangeAnim(this, RM2_ANIM_RUN, &this->previousAnimation);
@@ -261,7 +262,7 @@ void func_80AAF5EC(EnMm2* this, PlayState* play) {
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT) && Message_ShouldAdvance(play)) {
         this->unk_1F4 &= ~1;
         EnMm2_ChangeAnim(this, RM2_ANIM_STAND, &this->previousAnimation);
-        this->actionFunc = func_80AAF330;
+        this->actionFunc = EnMm2_StandUp;  // was func_80AAF330 [LLM:HIGH]
     }
 }
 
@@ -285,7 +286,7 @@ void func_80AAF668(EnMm2* this, PlayState* play) {
             this->unk_1F4 |= 2;
             this->unk_1F4 &= ~1;
             EnMm2_ChangeAnim(this, RM2_ANIM_STAND, &this->previousAnimation);
-            this->actionFunc = func_80AAF330;
+            this->actionFunc = EnMm2_StandUp;  // was func_80AAF330 [LLM:HIGH]
         }
     }
 }
