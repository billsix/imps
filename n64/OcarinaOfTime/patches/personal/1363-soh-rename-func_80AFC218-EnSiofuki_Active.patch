Subject: [PATCH 1363/3799] soh: rename func_80AFC218 -> EnSiofuki_Active

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the running state: counts the switch timer down with its warning sfx and, on expiry, clears the switch flag and returns the geyser to the per-type resting height.
Defined in soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c b/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
index 6f70a0ce3..8892a5cb6 100644
--- a/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
+++ b/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
@@ -187,7 +187,8 @@ void EnSiofuki_ApproachTargetHeight(EnSiofuki* this, PlayState* play) {
     Math_SmoothStepToF(&this->currentHeight, this->targetHeight, 0.8f, 3.0f, 0.01f);
 }
 
-void func_80AFC218(EnSiofuki* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AFC218: the running state: counts the switch timer down with its warning sfx and, on expiry, clears the switch flag and returns the geyser to the per-type resting height.
+void EnSiofuki_Active(EnSiofuki* this, PlayState* play) {
     EnSiofuki_UpdateOscillation(this, play);  // was func_80AFBDC8 [LLM:HIGH]
     EnSiofuki_PushPlayer(this, play);  // was func_80AFBE8C [LLM:HIGH]
     EnSiofuki_ApproachTargetHeight(this, play);  // was func_80AFC1D0 [LLM:HIGH]
@@ -229,7 +230,7 @@ void func_80AFC34C(EnSiofuki* this, PlayState* play) {
     if (Flags_GetSwitch(play, ((u16)this->dyna.actor.params >> 6) & 0x3F)) {
         this->targetHeight = 400.0f;
         this->timer = 300;
-        this->actionFunc = func_80AFC218;
+        this->actionFunc = EnSiofuki_Active;  // was func_80AFC218 [LLM:HIGH]
     }
 }
 
@@ -242,7 +243,7 @@ void func_80AFC3C8(EnSiofuki* this, PlayState* play) {
     if (this->timer < 0) {
         this->timer = this->activeTime * 20;
         this->targetHeight = -45.0f;
-        this->actionFunc = func_80AFC218;
+        this->actionFunc = EnSiofuki_Active;  // was func_80AFC218 [LLM:HIGH]
     }
 
     if (Flags_GetTreasure(play, (u16)this->dyna.actor.params & 0x3F)) {
