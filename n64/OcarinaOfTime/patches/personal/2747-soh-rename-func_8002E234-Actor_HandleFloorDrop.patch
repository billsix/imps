From 29d246386515940b5c6abbc7d956394f3dee8f5d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:32 +0000
Subject: [PATCH 2747/3799] soh: rename func_8002E234 -> Actor_HandleFloorDrop

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: on a floor more than 11 units below, clears the grounded flag and sets the falling one, killing downward velocity for some callers; named for the transition it performs
Defined in soh/src/code/z_actor.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index b6b66909f..f04480819 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -1612,7 +1612,8 @@ s32 Actor_ActorAIsFacingAndNearActorB(Actor* actorA, Actor* actorB, f32 range, s
     return false;
 }
 
-s32 func_8002E234(Actor* actor, f32 arg1, s32 arg2) {
+// LLM generated name (GUESS), was func_8002E234: on a floor more than 11 units below, clears the grounded flag and sets the falling one, killing downward velocity for some callers; named for the transition it performs
+s32 Actor_HandleFloorDrop(Actor* actor, f32 arg1, s32 arg2) {
     if ((actor->bgCheckFlags & 0x1) && (arg1 < -11.0f)) {
         actor->bgCheckFlags &= ~0x1;
         actor->bgCheckFlags |= 0x4;
@@ -1637,7 +1638,7 @@ s32 func_8002E2AC(PlayState* play, Actor* actor, Vec3f* arg2, s32 arg3) {
     actor->bgCheckFlags &= ~0x0086;
 
     if (actor->floorHeight <= BGCHECK_Y_MIN) {
-        return func_8002E234(actor, BGCHECK_Y_MIN, arg3);
+        return Actor_HandleFloorDrop(actor, BGCHECK_Y_MIN, arg3);  // was func_8002E234 [LLM:GUESS]
     }
 
     floorHeightDiff = actor->floorHeight - actor->world.pos.y;
@@ -1676,7 +1677,7 @@ s32 func_8002E2AC(PlayState* play, Actor* actor, Vec3f* arg2, s32 arg3) {
             DynaPolyActor_SetStandingActorFlags(&play->colCtx, actor, actor->floorBgId);
         }
 
-        return func_8002E234(actor, floorHeightDiff, arg3);
+        return Actor_HandleFloorDrop(actor, floorHeightDiff, arg3);  // was func_8002E234 [LLM:GUESS]
     }
 
     return true;
