From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:15 +0000
Subject: [PATCH 0625/3799] soh: rename D_808BCE20 -> gDekuTreeMeetingCs

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c.
---
 soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c    | 5 +++--
 .../actors/ovl_Bg_Treemouth/z_bg_treemouth_cutscene_data.c   | 2 +-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c b/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c
index 9af0b08bb..91e3376fd 100644
--- a/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c
+++ b/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c
@@ -25,7 +25,8 @@ void func_808BC8B8(BgTreemouth* this, PlayState* play);
 void func_808BC9EC(BgTreemouth* this, PlayState* play);
 void func_808BCAF0(BgTreemouth* this, PlayState* play);
 
-extern CutsceneData D_808BCE20[];
+// Name from zeldaret/oot (was D_808BCE20): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c]
+extern CutsceneData gDekuTreeMeetingCs[];
 extern CutsceneData D_808BD2A0[];
 extern CutsceneData D_808BD520[];
 extern CutsceneData D_808BD790[];
@@ -155,7 +156,7 @@ void func_808BC8B8(BgTreemouth* this, PlayState* play) {
             } else if (Actor_IsFacingAndNearPlayer(&this->dyna.actor, 1658.0f, 0x4E20)) {
                 Flags_SetEventChkInf(EVENTCHKINF_MET_DEKU_TREE);
                 if (GameInteractor_Should(VB_PLAY_DEKU_TREE_INTRO_CS, true, this)) {
-                    play->csCtx.segment = D_808BCE20;
+                    play->csCtx.segment = gDekuTreeMeetingCs;
                     gSaveContext.cutsceneTrigger = 1;
                     BgTreemouth_SetupAction(this, func_808BC9EC);
                 }
diff --git a/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth_cutscene_data.c b/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth_cutscene_data.c
