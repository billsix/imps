         thisx->params != 0xD && thisx->params != 0xE && thisx->params != 0xA) {
         thisx->velocity.y = 0.0f;
         thisx->gravity = 0.0f;
@@ -1062,7 +1063,7 @@ void EnNiw_Update(Actor* thisx, PlayState* play) {
         osSyncPrintf("\n\n");
         osSyncPrintf(VT_FGCOL(YELLOW) "☆☆☆☆☆ ぶくぶく ☆☆☆☆☆ \n" VT_RST);
         osSyncPrintf("\n\n");
-        this->actionFunc = func_80AB6F04;
+        this->actionFunc = EnNiw_Swim;  // was func_80AB6F04 [LLM:HIGH]
         return;
     }
 
