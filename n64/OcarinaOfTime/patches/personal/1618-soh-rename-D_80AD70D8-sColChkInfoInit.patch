From d5e26769d269cf4c7ada40aa0b43463a12b354e5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:31:17 +0000
Subject: [PATCH 1618/3799] soh: rename D_80AD70D8 -> sColChkInfoInit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the CollisionCheckInfoInit passed to CollisionCheck_SetInfo; the respawn path restores the health from it.
Defined in soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
index 2a1fb6d23..419bcada4 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
@@ -95,7 +95,8 @@ static ColliderCylinderInit sFlameCylinderInit = {  // was D_80AD70AC [LLM:HIGH]
     { 10, 30, 0, { 0, 0, 0 } },
 };
 
-static CollisionCheckInfoInit D_80AD70D8 = { 4, 25, 50, 40 };
+// LLM generated name (HIGH), was D_80AD70D8: the CollisionCheckInfoInit passed to CollisionCheck_SetInfo; the respawn path restores the health from it.
+static CollisionCheckInfoInit sColChkInfoInit = { 4, 25, 50, 40 };  // was D_80AD70D8 [LLM:HIGH]
 
 static DamageTable sDamageTable = {
     /* Deku nut      */ DMG_ENTRY(0, 0x0),
@@ -184,7 +185,7 @@ void EnPoField_Init(Actor* thisx, PlayState* play) {
     Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);  // was D_80AD7080 [LLM:HIGH]
     Collider_InitCylinder(play, &this->flameCollider);
     Collider_SetCylinder(play, &this->flameCollider, &this->actor, &sFlameCylinderInit);  // was D_80AD70AC [LLM:HIGH]
-    CollisionCheck_SetInfo(&this->actor.colChkInfo, &sDamageTable, &D_80AD70D8);
+    CollisionCheck_SetInfo(&this->actor.colChkInfo, &sDamageTable, &sColChkInfoInit);  // was D_80AD70D8 [LLM:HIGH]
     this->lightNode = LightContext_InsertLight(play, &play->lightCtx, &this->lightInfo);
     Lights_PointGlowSetInfo(&this->lightInfo, this->actor.home.pos.x, this->actor.home.pos.y, this->actor.home.pos.z,
                             255, 255, 255, 0);
@@ -212,7 +213,7 @@ void EnPoField_SetupWaitForSpawn(EnPoField* this, PlayState* play) {
     this->actor.flags &= ~(ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED);
     this->collider.base.acFlags &= ~AC_ON;
     this->collider.base.ocFlags1 = OC1_ON | OC1_TYPE_ALL;
-    this->actor.colChkInfo.health = D_80AD70D8.health;
+    this->actor.colChkInfo.health = sColChkInfoInit.health;  // was D_80AD70D8 [LLM:HIGH]
     this->actor.gravity = 0.0f;
     this->actor.velocity.y = 0.0f;
     this->actionFunc = EnPoField_WaitForSpawn;
-- 
