From 178c5b75a9e72de566fbc8674a531ad8911f9147 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:55 +0000
Subject: [PATCH 130/225] soh: rename D_8087D958 -> sLidRestOffset

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_Bg_Haka_Huta/z_bg_haka_huta.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 .../overlays/actors/ovl_Bg_Haka_Huta/z_bg_haka_huta.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Haka_Huta/z_bg_haka_huta.c b/soh/src/overlays/actors/ovl_Bg_Haka_Huta/z_bg_haka_huta.c
index 78b0b1a7e..a05198b2f 100644
--- a/soh/src/overlays/actors/ovl_Bg_Haka_Huta/z_bg_haka_huta.c
+++ b/soh/src/overlays/actors/ovl_Bg_Haka_Huta/z_bg_haka_huta.c
@@ -175,7 +175,8 @@ void BgHakaHuta_SlideOpen(BgHakaHuta* this, PlayState* play) {
 
 // LLM generated name (HIGH), was func_8087D720: settles the coffin lid into its final resting pose, adding a camera quake
 void BgHakaHuta_Rest(BgHakaHuta* this, PlayState* play) {
-    static Vec3f D_8087D958 = { 30.0f, 0.0f, 0.0f };
+    // LLM generated name (HIGH), was D_8087D958: lid offset vector rotated about the axis below to place the resting lid
+    static Vec3f sLidRestOffset = { 30.0f, 0.0f, 0.0f };
     static Vec3f D_8087D964 = { 0.03258f, 0.3258f, -0.9449f };
     MtxF mtx;
     Vec3f vec;
@@ -193,13 +194,13 @@ void BgHakaHuta_Rest(BgHakaHuta* this, PlayState* play) {
         this->actionFunc = BgHakaHuta_DoNothing;
     }
 
-    D_8087D958.x = this->counter + 24.0f;
-    if (D_8087D958.x > 30.0f) {
-        D_8087D958.x = 30.0f;
+    sLidRestOffset.x = this->counter + 24.0f;
+    if (sLidRestOffset.x > 30.0f) {
+        sLidRestOffset.x = 30.0f;
     }
     Matrix_RotateY(this->dyna.actor.world.rot.y * (M_PI / 0x8000), MTXMODE_NEW);
     Matrix_RotateAxis(this->counter * (191 * M_PI / 3750), &D_8087D964, MTXMODE_APPLY);
-    Matrix_MultVec3f(&D_8087D958, &vec);
+    Matrix_MultVec3f(&sLidRestOffset, &vec);
     this->dyna.actor.world.pos.x = this->dyna.actor.home.pos.x + vec.x;
     this->dyna.actor.world.pos.y = this->dyna.actor.home.pos.y + vec.y;
     this->dyna.actor.world.pos.z = this->dyna.actor.home.pos.z + vec.z;
-- 
