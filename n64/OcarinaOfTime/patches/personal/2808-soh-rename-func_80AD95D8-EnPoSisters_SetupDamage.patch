Date: Mon, 7 Sep 2026 23:53:53 +0000
Subject: [PATCH 2808/3799] soh: rename func_80AD95D8 ->
 EnPoSisters_SetupDamage

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays gPoeSistersDamagedAnim, aims the knockback away from the attacker and applies the red filter
Defined in soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
index 525570a65..2b4b81919 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
@@ -312,7 +312,8 @@ void EnPoSisters_SetupRetreat(EnPoSisters* this) {
     this->actionFunc = func_80ADA9E8;
 }
 
-void func_80AD95D8(EnPoSisters* this) {
+// LLM generated name (HIGH), was func_80AD95D8: plays gPoeSistersDamagedAnim, aims the knockback away from the attacker and applies the red filter
+void EnPoSisters_SetupDamage(EnPoSisters* this) {
     Animation_MorphToPlayOnce(&this->skelAnime, &gPoeSistersDamagedAnim, -3.0f);
     if (this->collider.base.ac != NULL) {
         this->actor.world.rot.y = (this->collider.info.acHitInfo->toucher.dmgFlags & 0x1F824)
@@ -991,7 +992,7 @@ void func_80ADB770(EnPoSisters* this, PlayState* play) {
         EnPoSisters* realMeg = (EnPoSisters*)this->actor.parent;
 
         if (realMeg->actionFunc == func_80ADAAA4) {
-            func_80AD95D8(this);
+            EnPoSisters_SetupDamage(this);  // was func_80AD95D8 [LLM:HIGH]
         }
     } else if (this->unk_19C == 0) {
         this->unk_19C = -15;
@@ -1180,7 +1181,7 @@ void func_80ADC10C(EnPoSisters* this, PlayState* play) {
                 Audio_PlayActorSound2(&this->actor, NA_SE_EN_PO_SISTER_DEAD);
                 GameInteractor_ExecuteOnEnemyDefeat(&this->actor);
             }
-            func_80AD95D8(this);
+            EnPoSisters_SetupDamage(this);  // was func_80AD95D8 [LLM:HIGH]
         }
     }
 }
