From 8c050d45ae9bb2c151c47314d91194025e19d011 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:10 +0000
Subject: [PATCH 0942/3799] soh: rename D_808987AC -> sRubbleFragmentOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the Vec3f BgJyaHaheniron_RubbleCollide passes to BgJyaHaheniron_SpawnFragments before killing the actor.
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c         | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c b/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c
index e7bafc755..8e2ab34fa 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c
@@ -76,7 +76,8 @@ static f32 sScales[] = { 0.13f, 0.1f, 0.1f };  // was D_80898794 [LLM:HIGH]
 // LLM generated name (HIGH), was D_808987A0: the Vec3f BgJyaHaheniron_PillarCrumble passes to BgJyaHaheniron_SpawnFragments before killing the actor.
 static Vec3f sPillarFragmentOffset[] = { 0.0f, 14.0f, 0.0f };  // was D_808987A0 [LLM:HIGH]
 
-static Vec3f D_808987AC[] = { 0.0f, 8.0f, 0.0f };
+// LLM generated name (HIGH), was D_808987AC: the Vec3f BgJyaHaheniron_RubbleCollide passes to BgJyaHaheniron_SpawnFragments before killing the actor.
+static Vec3f sRubbleFragmentOffset[] = { 0.0f, 8.0f, 0.0f };  // was D_808987AC [LLM:HIGH]
 
 void BgJyaHaheniron_ColliderInit(BgJyaHaheniron* this, PlayState* play) {
     s32 pad;
@@ -190,7 +191,7 @@ void BgJyaHaheniron_SetupRubbleCollide(BgJyaHaheniron* this) {
 
 void BgJyaHaheniron_RubbleCollide(BgJyaHaheniron* this, PlayState* play) {
     if (this->timer >= 17) {
-        BgJyaHaheniron_SpawnFragments(play, &this->actor.world.pos, D_808987AC);
+        BgJyaHaheniron_SpawnFragments(play, &this->actor.world.pos, sRubbleFragmentOffset);  // was D_808987AC [LLM:HIGH]
         SoundSource_PlaySfxAtFixedWorldPos(play, &this->actor.world.pos, 80, NA_SE_EN_IRONNACK_BREAK_PILLAR2);
         Actor_Kill(&this->actor);
     }
