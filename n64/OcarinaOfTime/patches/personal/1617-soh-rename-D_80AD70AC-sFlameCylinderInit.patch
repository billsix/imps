From 18000fcbcbf37c324d370e159e37ed1027d67bc9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:31:17 +0000
Subject: [PATCH 1617/3799] soh: rename D_80AD70AC -> sFlameCylinderInit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the ColliderCylinderInit installed for the Poe's flame.
Defined in soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
index 74727e371..2a1fb6d23 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Field/z_en_po_field.c
@@ -74,7 +74,8 @@ static ColliderCylinderInit sCylinderInit = {  // was D_80AD7080 [LLM:HIGH]
     { 25, 50, 20, { 0, 0, 0 } },
 };
 
-static ColliderCylinderInit D_80AD70AC = {
+// LLM generated name (HIGH), was D_80AD70AC: the ColliderCylinderInit installed for the Poe's flame.
+static ColliderCylinderInit sFlameCylinderInit = {  // was D_80AD70AC [LLM:HIGH]
     {
         COLTYPE_NONE,
         AT_ON | AT_TYPE_ENEMY,
@@ -182,7 +183,7 @@ void EnPoField_Init(Actor* thisx, PlayState* play) {
     Collider_InitCylinder(play, &this->collider);
     Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);  // was D_80AD7080 [LLM:HIGH]
     Collider_InitCylinder(play, &this->flameCollider);
-    Collider_SetCylinder(play, &this->flameCollider, &this->actor, &D_80AD70AC);
+    Collider_SetCylinder(play, &this->flameCollider, &this->actor, &sFlameCylinderInit);  // was D_80AD70AC [LLM:HIGH]
     CollisionCheck_SetInfo(&this->actor.colChkInfo, &sDamageTable, &D_80AD70D8);
     this->lightNode = LightContext_InsertLight(play, &play->lightCtx, &this->lightInfo);
     Lights_PointGlowSetInfo(&this->lightInfo, this->actor.home.pos.x, this->actor.home.pos.y, this->actor.home.pos.z,
-- 
