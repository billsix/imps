From fb3f3ac1883520ee8350cf87e8aa60036b138735 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:49:08 +0000
Subject: [PATCH 1110/3799] soh: rename func_800DB03C ->
 AudioSynth_SyncNoteSubEuFlags

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: for one update slot, walks every note and either clears needsInit on the live note or disables that slot's noteSubEu copy, so the per-update copies track the notes' enabled state.
Defined in soh/src/code/audio_synthesis.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_synthesis.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_synthesis.c b/soh/src/code/audio_synthesis.c
index b61e9050f..ecf0bf346 100644
--- a/soh/src/code/audio_synthesis.c
+++ b/soh/src/code/audio_synthesis.c
@@ -111,7 +111,8 @@ void AudioSynth_InitNextRingBuf(s32 chunkLen, s32 bufIndex, s32 reverbIndex) {
     }
 }
 
-void func_800DB03C(s32 arg0) {
+// LLM generated name (HIGH), was func_800DB03C: for one update slot, walks every note and either clears needsInit on the live note or disables that slot's noteSubEu copy, so the per-update copies track the notes' enabled state.
+void AudioSynth_SyncNoteSubEuFlags(s32 arg0) {
     NoteSubEu* subEu;
     NoteSubEu* subEu2;
     s32 baseIndex;
@@ -142,7 +143,7 @@ Acmd* AudioSynth_Update(Acmd* cmdStart, s32* cmdCnt, s16* aiStart, s32 aiBufLen)
     cmdP = cmdStart;
     for (i = gAudioContext.audioBufferParameters.updatesPerFrame; i > 0; i--) {
         AudioSeq_ProcessSequences(i - 1);
-        func_800DB03C(gAudioContext.audioBufferParameters.updatesPerFrame - i);
+        AudioSynth_SyncNoteSubEuFlags(gAudioContext.audioBufferParameters.updatesPerFrame - i);  // was func_800DB03C [LLM:HIGH]
     }
 
     aiBufP = aiStart;
-- 
2.55.0

