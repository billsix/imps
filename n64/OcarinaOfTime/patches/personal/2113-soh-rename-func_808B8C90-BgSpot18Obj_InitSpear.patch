Date: Mon, 7 Sep 2026 23:12:54 +0000
Subject: [PATCH 2113/3799] soh: rename func_808B8C90 -> BgSpot18Obj_InitSpear

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the spear's init: processes its uncull chain and installs the do-nothing action
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
index 5fb31bf95..33bd5a2b8 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
@@ -25,7 +25,8 @@ s32 BgSpot18Obj_InitDynaPoly(BgSpot18Obj* this, PlayState* play);  // was func_8
 s32 BgSpot18Obj_InitFlags(BgSpot18Obj* this, PlayState* play);  // was func_808B8B08 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808B8BB4: the statue's init: already-pushed or child Link goes straight to the settled state, otherwise the pushable state
 s32 BgSpot18Obj_InitStatue(BgSpot18Obj* this, PlayState* play);  // was func_808B8BB4 [LLM:HIGH]
-s32 func_808B8C90(BgSpot18Obj* this, PlayState* play);
+// LLM generated name (HIGH), was func_808B8C90: the spear's init: processes its uncull chain and installs the do-nothing action
+s32 BgSpot18Obj_InitSpear(BgSpot18Obj* this, PlayState* play);  // was func_808B8C90 [LLM:HIGH]
 void func_808B8DC0(BgSpot18Obj* this);
 void func_808B8DD0(BgSpot18Obj* this, PlayState* play);
 void func_808B8E64(BgSpot18Obj* this);
@@ -86,7 +87,7 @@ static InitChainEntry sInitChain2[] = {
 
 static BgSpot18ObjInitFunc D_808B913C[] = {
     BgSpot18Obj_InitStatue,  // was func_808B8BB4 [LLM:HIGH]
-    func_808B8C90,
+    BgSpot18Obj_InitSpear,  // was func_808B8C90 [LLM:HIGH]
 };
 
 static Gfx(*sDlists[]) = {
@@ -171,7 +172,7 @@ s32 BgSpot18Obj_InitStatue(BgSpot18Obj* this, PlayState* play) {
     return 1;
 }
 
-s32 func_808B8C90(BgSpot18Obj* this, PlayState* play) {
+s32 BgSpot18Obj_InitSpear(BgSpot18Obj* this, PlayState* play) {
     Actor_ProcessInitChain(&this->dyna.actor, sInitChain2);
     func_808B8DC0(this);
     return 1;
