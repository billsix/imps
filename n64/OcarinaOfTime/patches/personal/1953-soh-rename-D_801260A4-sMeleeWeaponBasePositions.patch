From 024ce3ab02e204c4f79efc90d992ecdfa64f6233 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:05:34 +0000
Subject: [PATCH 1953/3799] soh: rename D_801260A4 -> sMeleeWeaponBasePositions

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the three base points paired with the tips above by Player_UpdateMeleeWeaponQuads
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index 5d16951fd..fb3f41573 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1577,7 +1577,8 @@ Vec3f sMeleeWeaponQuad0Tip = { 5000.0f, -400.0f, 1000.0f };  // was D_8012608C [
 // LLM generated name (HIGH), was D_80126098: tip of the second sweep quad, sharing sMeleeWeaponQuad0Tip's x
 Vec3f sMeleeWeaponQuad1Tip = { 5000.0f, 1400.0f, -1000.0f };  // was D_80126098 [LLM:HIGH]
 
-Vec3f D_801260A4[3] = {
+// LLM generated name (HIGH), was D_801260A4: the three base points paired with the tips above by Player_UpdateMeleeWeaponQuads
+Vec3f sMeleeWeaponBasePositions[3] = {  // was D_801260A4 [LLM:HIGH]
     { 0.0f, 400.0f, 0.0f },
     { 0.0f, 1400.0f, -1000.0f },
     { 0.0f, -400.0f, 1000.0f },
@@ -1587,9 +1588,9 @@ Vec3f D_801260A4[3] = {
 void Player_UpdateMeleeWeaponQuads(PlayState* play, Player* this, Vec3f* newTipPos) {
     Vec3f newBasePos[3];
 
-    Matrix_MultVec3f(&D_801260A4[0], &newBasePos[0]);
-    Matrix_MultVec3f(&D_801260A4[1], &newBasePos[1]);
-    Matrix_MultVec3f(&D_801260A4[2], &newBasePos[2]);
+    Matrix_MultVec3f(&sMeleeWeaponBasePositions[0], &newBasePos[0]);  // was D_801260A4 [LLM:HIGH]
+    Matrix_MultVec3f(&sMeleeWeaponBasePositions[1], &newBasePos[1]);  // was D_801260A4 [LLM:HIGH]
+    Matrix_MultVec3f(&sMeleeWeaponBasePositions[2], &newBasePos[2]);  // was D_801260A4 [LLM:HIGH]
 
     if (Player_UpdateWeaponInfo(play, NULL, &this->meleeWeaponInfo[0], &newTipPos[0], &newBasePos[0]) &&
         !(this->stateFlags1 & PLAYER_STATE1_SHIELDING) &&
