+++ b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
@@ -35,7 +35,8 @@ void BgBdanSwitch_Release(BgBdanSwitch* this, PlayState* play);  // was func_808
 void BgBdanSwitch_SetupHeavyIdle(BgBdanSwitch* this);  // was func_8086D86C [LLM:HIGH]
 // LLM generated name (HIGH), was func_8086D888: waits for the player to stand on the heavy switch
 void BgBdanSwitch_HeavyIdle(BgBdanSwitch* this, PlayState* play);  // was func_8086D888 [LLM:HIGH]
