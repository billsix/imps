+void BgBdanSwitch_SetupHeavyHalfPress(BgBdanSwitch* this);  // was func_8086D8BC [LLM:HIGH]
 void func_8086D8CC(BgBdanSwitch* this, PlayState* play);
 void func_8086D95C(BgBdanSwitch* this, PlayState* play);
 void func_8086D9F8(BgBdanSwitch* this);
@@ -341,11 +342,11 @@ void BgBdanSwitch_SetupHeavyIdle(BgBdanSwitch* this) {
 
 void BgBdanSwitch_HeavyIdle(BgBdanSwitch* this, PlayState* play) {
     if (DynaPolyActor_IsPlayerOnTop(&this->dyna)) {
-        func_8086D8BC(this);
+        BgBdanSwitch_SetupHeavyHalfPress(this);  // was func_8086D8BC [LLM:HIGH]
     }
 }
 
-void func_8086D8BC(BgBdanSwitch* this) {
+void BgBdanSwitch_SetupHeavyHalfPress(BgBdanSwitch* this) {
     this->actionFunc = func_8086D8CC;
 }
 
