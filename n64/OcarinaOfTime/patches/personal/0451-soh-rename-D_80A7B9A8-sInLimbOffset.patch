From aa7b46fb3eb8aecf7c002e5764e5296f4d59a971 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:38 +0000
Subject: [PATCH 451/488] soh: rename D_80A7B9A8 -> sInLimbOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the point EnIn_PostLimbDraw transforms for its limb position
Defined in soh/src/overlays/actors/ovl_En_In/z_en_in.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_In/z_en_in.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_In/z_en_in.c b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
index aa049afab..6f6136d7c 100644
--- a/soh/src/overlays/actors/ovl_En_In/z_en_in.c
+++ b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
@@ -1002,12 +1002,12 @@ s32 EnIn_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 
 void EnIn_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
     EnIn* this = (EnIn*)thisx;
-    Vec3f D_80A7B9A8 = { 1600.0, 0.0f, 0.0f };
+    Vec3f sInLimbOffset = { 1600.0, 0.0f, 0.0f };  // was D_80A7B9A8 [LLM:HIGH]
 
     OPEN_DISPS(play->state.gfxCtx);
 
     if (limbIndex == INGO_HEAD_LIMB) {
-        Matrix_MultVec3f(&D_80A7B9A8, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sInLimbOffset, &this->actor.focus.pos);  // was D_80A7B9A8 [LLM:HIGH]
         this->actor.focus.rot = this->actor.world.rot;
     }
     if (limbIndex == INGO_LEFT_HAND_LIMB && this->skelAnime.animation == &object_in_Anim_014CA8) {
