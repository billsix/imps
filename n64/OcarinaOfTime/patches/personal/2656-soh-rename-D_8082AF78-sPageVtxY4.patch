From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:41 +0000
Subject: [PATCH 2656/3799] soh: rename D_8082AF78 -> sPageVtxY4

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the Y offsets in slot 4 of the sPageVtxY table
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index e35a305bb..7fe507821 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2671,7 +2671,8 @@ static s16 sPageVtxY3[] = {  // was D_8082AF74 [LLM:HIGH]
     0x0000,
     0x0000,
 };
-static s16 D_8082AF78[] = {
+// LLM generated name (HIGH), was D_8082AF78: the Y offsets in slot 4 of the sPageVtxY table
+static s16 sPageVtxY4[] = {  // was D_8082AF78 [LLM:HIGH]
     0x000F, 0x0028, 0x000B, 0x002D, 0x0034, 0x0025, 0x0024, 0x0039, 0x0036, 0x0021, 0x001F,
     0x002D, 0x0020, 0x002A, 0x0031, 0xFFF6, 0x001F, 0x001B, 0x000F, 0xFFCF, 0x0008, 0x0026,
     0x0007, 0x002F, 0x001E, 0x0001, 0xFFF7, 0x0019, 0x0000, 0x0001, 0xFFE0, 0xFFE6,
@@ -2708,7 +2709,7 @@ static s16* D_8082B018[] = {
 };
 
 static s16* D_8082B030[] = {
-    sPageVtxY0, sPageVtxY1, sPageVtxY2, sPageVtxY3, D_8082AF78, D_8082AFB8,  // was D_8082AF48 [LLM:HIGH]
+    sPageVtxY0, sPageVtxY1, sPageVtxY2, sPageVtxY3, sPageVtxY4, D_8082AFB8,  // was D_8082AF48 [LLM:HIGH]
 };
 
 static s16* D_8082B048[] = {
