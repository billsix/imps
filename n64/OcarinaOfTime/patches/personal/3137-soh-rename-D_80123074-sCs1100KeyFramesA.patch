From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:44 +0000
Subject: [PATCH 3137/3799] soh: rename D_80123074 -> sCs1100KeyFramesA

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the first keyframe set cutscene 1100 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index cd850063e..d95f6bc5d 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -984,7 +984,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             s32 tempDiff = play->state.frames - sPrevFrameCs1100;
 
             if ((tempDiff > 3600) || (tempDiff < -3600)) {
-                csInfo->keyFrames = D_80123074;
+                csInfo->keyFrames = sCs1100KeyFramesA;  // was D_80123074 [LLM:HIGH]
                 csInfo->keyFrameCnt = 5;
             } else {
                 if (play->state.frames & 1) {
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index a45a149bc..ee4985c41 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -635,7 +635,8 @@ static OnePointCsFull sCs8700KeyFrames[2][7] = {  // was D_80122E44 [LLM:HIGH]
     },
 };
 
-static OnePointCsFull D_80123074[5] = {
+// LLM generated name (HIGH), was D_80123074: the first keyframe set cutscene 1100 installs
+static OnePointCsFull sCs1100KeyFramesA[5] = {  // was D_80123074 [LLM:HIGH]
     { 0x8F, 0xFF, 0xA2A2, 2, 8, 70.0f, 1.0f, { -27.0f, -96.0f, 25.0f }, { 37.0f, -5.0f, 100.0f } },
     { 0x81, 0xFF, 0xA2A2, 38, 4, 60.0f, 1.0f, { 64.0f, -109.0f, 55.0f }, { 37.0f, 150.0f, 155.0f } },
     { 0x8F, 0xFF, 0xA2A2, 2, 8, 70.0f, 1.0f, { 45.0f, 123.0f, 45.0f }, { 70.0f, 5.0f, 125.0f } },
