 };
@@ -193,8 +194,8 @@ s32 BgSpot18Obj_InitSpear(BgSpot18Obj* this, PlayState* play) {
 
 // LLM generated name (HIGH), was func_808B8CC8: runs this type's entry of sTypeInitFuncs if there is one
 s32 BgSpot18Obj_RunTypeInit(BgSpot18Obj* this, PlayState* play) {
-    if ((D_808B913C[this->dyna.actor.params & 0xF] != NULL) &&
-        (!D_808B913C[this->dyna.actor.params & 0xF](this, play))) {
+    if ((sTypeInitFuncs[this->dyna.actor.params & 0xF] != NULL) &&  // was D_808B913C [LLM:HIGH]
+        (!sTypeInitFuncs[this->dyna.actor.params & 0xF](this, play))) {  // was D_808B913C [LLM:HIGH]
         return 0;
     }
     return 1;
