From c11023552ca9f2d7264f0b7fd6c1ac484a625243 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:28 +0000
Subject: [PATCH 3319/3799] soh: rename D_8012A3A0 -> sJabuJabuScrollB

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the second such angle
Defined in soh/src/code/z_scene_table.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_scene_table.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_scene_table.c b/soh/src/code/z_scene_table.c
index 6bb7a5dac..1a2c7134e 100644
--- a/soh/src/code/z_scene_table.c
+++ b/soh/src/code/z_scene_table.c
@@ -1598,7 +1598,7 @@ f32 sJabuJabuWobblePhase = 0.0f;  // was D_8012A398 [LLM:HIGH]
 // Name from zeldaret/oot (was func_8009FE58): adopted upstream's name for this address; body verified to match upstream at 0.89. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_scene_table.c]
 void Scene_DrawConfigJabuJabu(PlayState* play) {
     static s16 sJabuJabuScrollA = 538;  // was D_8012A39C [LLM:HIGH]
-    static s16 D_8012A3A0 = 4272;
+    static s16 sJabuJabuScrollB = 4272;  // was D_8012A3A0 [LLM:HIGH]
     u32 gameplayFrames;
     f32 temp;
 
@@ -1628,7 +1628,7 @@ void Scene_DrawConfigJabuJabu(PlayState* play) {
 
         if (GameInteractor_Should(VB_JABU_WOBBLE, true)) {
             sJabuJabuScrollA += 1820;  // was D_8012A39C [LLM:HIGH]
-            D_8012A3A0 += 1820;
+            sJabuJabuScrollB += 1820;  // was D_8012A3A0 [LLM:HIGH]
         }
 
         temp = 0.020000001f;
@@ -1637,9 +1637,9 @@ void Scene_DrawConfigJabuJabu(PlayState* play) {
             View_SetDistortionOrientation(&play->view,
                                           ((360.00018f / 65535.0f) * (M_PI / 180.0f)) * temp * Math_CosS(sJabuJabuScrollA),  // was D_8012A39C [LLM:HIGH]
                                           ((360.00018f / 65535.0f) * (M_PI / 180.0f)) * temp * Math_SinS(sJabuJabuScrollA),  // was D_8012A39C [LLM:HIGH]
-                                          ((360.00018f / 65535.0f) * (M_PI / 180.0f)) * temp * Math_SinS(D_8012A3A0));
-            View_SetDistortionScale(&play->view, 1.f + (0.79999995f * temp * Math_SinS(D_8012A3A0)),
-                                    1.f + (0.39999998f * temp * Math_CosS(D_8012A3A0)),
+                                          ((360.00018f / 65535.0f) * (M_PI / 180.0f)) * temp * Math_SinS(sJabuJabuScrollB));  // was D_8012A3A0 [LLM:HIGH]
+            View_SetDistortionScale(&play->view, 1.f + (0.79999995f * temp * Math_SinS(sJabuJabuScrollB)),  // was D_8012A3A0 [LLM:HIGH]
+                                    1.f + (0.39999998f * temp * Math_CosS(sJabuJabuScrollB)),  // was D_8012A3A0 [LLM:HIGH]
                                     1.f + (1 * temp * Math_CosS(sJabuJabuScrollA)));  // was D_8012A39C [LLM:HIGH]
             View_SetDistortionSpeed(&play->view, 0.95f);
         }
