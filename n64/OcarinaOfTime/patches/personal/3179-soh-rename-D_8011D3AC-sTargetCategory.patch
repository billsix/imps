From 56b9a5c6f5d6268549f70e2d1a5d72802faf56df Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:03 +0000
Subject: [PATCH 3179/3799] soh: rename D_8011D3AC -> sTargetCategory

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the actor category of the camera's current target, published for Camera_GetTargetCategory
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../Enhancements/TimeSavers/timesaver_hook_handlers.cpp   | 8 ++++----
 soh/src/code/z_camera.c                                   | 8 ++++----
 soh/src/code/z_camera_data.inc                            | 3 ++-
 3 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/soh/Enhancements/TimeSavers/timesaver_hook_handlers.cpp b/soh/soh/Enhancements/TimeSavers/timesaver_hook_handlers.cpp
index 5d07abfeb..c3cba4d61 100644
--- a/soh/soh/Enhancements/TimeSavers/timesaver_hook_handlers.cpp
+++ b/soh/soh/Enhancements/TimeSavers/timesaver_hook_handlers.cpp
@@ -37,7 +37,7 @@ extern "C" {
 #include <objects/object_gnd/object_gnd.h>
 extern SaveContext gSaveContext;
 extern PlayState* gPlayState;
-extern int32_t D_8011D3AC;
+extern int32_t sTargetCategory;  // was D_8011D3AC [LLM:HIGH]
 
 extern void BgSpot03Taki_HandleWaterfallState(BgSpot03Taki* bgSpot03Taki, PlayState* play);
 extern void BgSpot03Taki_ApplyOpeningAlpha(BgSpot03Taki* bgSpot03Taki, s32 bufferIndex);
@@ -268,9 +268,9 @@ void TimeSaverOnVanillaBehaviorHandler(GIVanillaBehavior id, bool* should, va_li
 
                 // there are a few checks throughout the game (such as chest spawns) that rely on this
                 // the checks are for Camera_GetTargetCategory() == this->dyna.actor.category, was func_8005B198 [LLM:HIGH]
-                // Camera_GetTargetCategory just returns D_8011D3AC, was func_8005B198 [LLM:HIGH]
-                // D_8011D3AC is set to camera->target->category in Camera_Demo5
-                D_8011D3AC = actor->category;
+                // Camera_GetTargetCategory just returns sTargetCategory, was func_8005B198 [LLM:HIGH]
+                // sTargetCategory is set to camera->target->category in Camera_Demo5, was D_8011D3AC [LLM:HIGH]
+                sTargetCategory = actor->category;  // was D_8011D3AC [LLM:HIGH]
 
                 switch (actor->category) {
                     case ACTORCAT_BG:
diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 9b92990a3..d35436e8b 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -5278,7 +5278,7 @@ s32 Camera_Unique9(Camera* camera) {
 
             if (anim->curKeyFrame->unk_01 != 0xFF) {
                 if ((anim->curKeyFrame->unk_01 & 0xF0) == 0x80) {
-                    D_8011D3AC = anim->curKeyFrame->unk_01 & 0xF;
+                    sTargetCategory = anim->curKeyFrame->unk_01 & 0xF;  // was D_8011D3AC [LLM:HIGH]
                 } else if ((anim->curKeyFrame->unk_01 & 0xF0) == 0xC0) {
                     Camera_UpdateInterface(0xF000 | ((anim->curKeyFrame->unk_01 & 0xF) << 8));
                 } else if (camera->player->stateFlags1 & PLAYER_STATE1_IN_WATER &&
@@ -6050,7 +6050,7 @@ s32 Camera_Demo5(Camera* camera) {
     }
     Actor_GetFocus(&camera->targetPosRot, camera->target);
     OLib_Vec3fDiffToVecSphGeo(&playerTargetGeo, &camera->targetPosRot.pos, &camera->playerPosRot.pos);
-    D_8011D3AC = camera->target->category;
+    sTargetCategory = camera->target->category;  // was D_8011D3AC [LLM:HIGH]
     Actor_GetScreenPos(camera->play, camera->target, &sp78.yaw, &sp78.pitch);
     eyeTargetDist = OLib_Vec3fDist(&camera->targetPosRot.pos, &camera->eye);
     OLib_Vec3fDiffToVecSphGeo(&eyePlayerGeo, &playerhead.pos, &camera->eyeNext);
@@ -8357,7 +8357,7 @@ s32 Camera_QRegInit() {
 
 // LLM generated name (HIGH), was func_8005B198: returns the actor category the camera last locked onto; Bg_Bdan_Switch compares it against its own category to tell whether the camera is watching it.
 s32 Camera_GetTargetCategory() {
-    return D_8011D3AC;
+    return sTargetCategory;  // was D_8011D3AC [LLM:HIGH]
 }
 
 // Name from zeldaret/oot (was func_8005B1A4): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_camera.c]
@@ -8380,7 +8380,7 @@ s16 Camera_SetFinishedFlag(Camera* camera) {
     F(sCameraInterfaceFlags)            \
     F(sCameraInterfaceAlpha)            \
     F(sCameraShrinkWindowVal)           \
-    F(D_8011D3AC)                       \
+    F(sTargetCategory)                       \
     F(sDemo5PrevAction12Frame)          \
     F(sDemo5PrevSfxFrame)               \
     F(D_8011D3F0)                       \
diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index 13d41925e..162e68afa 100644
--- a/soh/src/code/z_camera_data.inc
+++ b/soh/src/code/z_camera_data.inc
@@ -2230,7 +2230,8 @@ static s32 sCameraInterfaceFlags = 1;
 
 static s32 sCameraInterfaceAlpha = 0x02;
 static s32 sCameraShrinkWindowVal = 0x20;
-s32 D_8011D3AC = -1;
+// LLM generated name (HIGH), was D_8011D3AC: the actor category of the camera's current target, published for Camera_GetTargetCategory
+s32 sTargetCategory = -1;  // was D_8011D3AC [LLM:HIGH]
 
 s16 D_8011D3B0[] = {
     0x0AAA, 0xF556, 0x1555, 0xEAAB, 0x2AAA, 0xD556, 0x3FFF, 0xC001, 0x5555, 0xAAAB, 0x6AAA, 0x9556, 0x7FFF, 0x0000,
