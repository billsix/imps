From e433a0b41dff6470726a03e79081ebf2f89c32c9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:29 +0000
Subject: [PATCH 0682/3799] soh: rename func_80A79690 -> EnIn_Stagger

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 0.98.
Defined in soh/src/overlays/actors/ovl_En_In/z_en_in.c.
---
 soh/src/overlays/actors/ovl_En_In/z_en_in.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_In/z_en_in.c b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
index a0407bf85..9607245d9 100644
--- a/soh/src/overlays/actors/ovl_En_In/z_en_in.c
+++ b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
@@ -347,7 +347,8 @@ void EnIn_UpdateTracking(EnIn* this, PlayState* play) {
     Npc_TrackPoint(&this->actor, &this->interactInfo, 1, npcTrackingMode);
 }
 
-void func_80A79690(SkelAnime* skelAnime, EnIn* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80A79690): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.98. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_In/z_en_in.c]
+void EnIn_Stagger(SkelAnime* skelAnime, EnIn* this, PlayState* play) {
     if (skelAnime->baseTransl.y < skelAnime->jointTable[0].y) {
         skelAnime->movementFlags |= 3;
         AnimationContext_SetMoveActor(play, &this->actor, skelAnime, 1.0f);
@@ -936,7 +937,7 @@ void EnIn_Update(Actor* thisx, PlayState* play) {
     if (this->actionFunc != func_80A7A304) {
         SkelAnime_Update(&this->skelAnime);
         if (this->skelAnime.animation == &object_in_Anim_001BE0 && ((gSaveContext.eventInf[0] & 0xF) != 6)) {
-            func_80A79690(&this->skelAnime, this, play);
+            EnIn_Stagger(&this->skelAnime, this, play);
         }
         Actor_UpdateBgCheckInfo(play, &this->actor, 0.0f, 0.0f, 0.0f, 4);
     }
-- 
