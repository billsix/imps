From 6c4ac50aada5b5333ca95ac006212bd20c359b02 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:39:20 +0000
Subject: [PATCH 1719/3799] soh: rename D_808B4590 -> sNextSpawnIndex

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: which entry of sSpawnPositions the next crate takes; it is bumped on each spawn and reset when the scene reloads.
Defined in soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c       | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c b/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
index bc7fdd115..eed04e494 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
@@ -23,7 +23,8 @@ void func_808B44B8(BgSpot15Rrbox* this, PlayState* play);
 void func_808B4178(BgSpot15Rrbox* this, PlayState* play);
 void func_808B44CC(BgSpot15Rrbox* this, PlayState* play);
 
-static s16 D_808B4590 = 0;
+// LLM generated name (HIGH), was D_808B4590: which entry of sSpawnPositions the next crate takes; it is bumped on each spawn and reset when the scene reloads.
+static s16 sNextSpawnIndex = 0;  // was D_808B4590 [LLM:HIGH]
 
 const ActorInit Bg_Spot15_Rrbox_InitVars = {
     ACTOR_BG_SPOT15_RRBOX,
@@ -128,8 +129,8 @@ void BgSpot15Rrbox_Init(Actor* thisx, PlayState* play) {
     func_808B3A34(this);
     if (Flags_GetSwitch(play, (this->dyna.actor.params & 0x3F))) {
         func_808B44B8(this, play);
-        this->dyna.actor.world.pos = sSpawnPositions[D_808B4590];  // was D_808B45C4 [LLM:HIGH]
-        D_808B4590++;
+        this->dyna.actor.world.pos = sSpawnPositions[sNextSpawnIndex];  // was D_808B45C4 [LLM:HIGH]
+        sNextSpawnIndex++;  // was D_808B4590 [LLM:HIGH]
     } else {
         func_808B4084(this, play);
     }
@@ -140,7 +141,7 @@ void BgSpot15Rrbox_Destroy(Actor* thisx, PlayState* play) {
     BgSpot15Rrbox* this = (BgSpot15Rrbox*)thisx;
 
     DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
-    D_808B4590 = 0;
+    sNextSpawnIndex = 0;  // was D_808B4590 [LLM:HIGH]
 }
 
 s32 BgSpot15Rrbox_TrySnapToCheckedPoint(BgSpot15Rrbox* this, PlayState* play, s32 arg2) {
