From 0b38b5580a06ee8e15814c7abb0a179f95f8f5b7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:15:37 +0000
Subject: [PATCH 2179/3799] soh: rename D_809071CC -> sShadowLimbParents

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-limb index of the limb its shadow position is interpolated toward, -1 where there is none
Defined in soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c      | 2 +-
 soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
index 91dd09bc5..7e510b8fe 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -3055,7 +3055,7 @@ void func_80906538(BossGanon2* this, u8* shadowTexture, f32 arg2) {
     Vec3f sp64;
 
     for (i = 0; i < 15; i++) {
-        if ((arg2 == 0.0f) || ((j = D_809071CC[i]) >= 0)) {
+        if ((arg2 == 0.0f) || ((j = sShadowLimbParents[i]) >= 0)) {  // was D_809071CC [LLM:HIGH]
             if (arg2 > 0.0f) {
                 lerpx = this->unk_234[i].x + (this->unk_234[j].x - this->unk_234[i].x) * arg2;
                 lerpy = this->unk_234[i].y + (this->unk_234[j].y - this->unk_234[i].y) * arg2;
diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
index 0ea594a15..95b422caf 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
@@ -329,7 +329,8 @@ static s16 sShadowStripeWidths8[] = { 2, 3, 4, 4, 4, 4, 3, 2 };  // was D_809071
 // LLM generated name (HIGH), was D_809071B4: the twelve row half-widths of the widest limb stripe
 static s16 sShadowStripeWidths12[] = { 2, 4, 5, 5, 6, 6, 6, 6, 5, 5, 4, 2 };  // was D_809071B4 [LLM:HIGH]
 
-static s16 D_809071CC[] = { 1, -1, 1, 1, 3, 4, 1, 6, 7, 2, 9, 10, 2, 12, 13 };
+// LLM generated name (HIGH), was D_809071CC: per-limb index of the limb its shadow position is interpolated toward, -1 where there is none
+static s16 sShadowLimbParents[] = { 1, -1, 1, 1, 3, 4, 1, 6, 7, 2, 9, 10, 2, 12, 13 };  // was D_809071CC [LLM:HIGH]
 
 static u8 D_809071EC[] = { 3, 2, 2, 1, 3, 3, 1, 3, 3, 1, 0, 3, 1, 0, 3 };
 
