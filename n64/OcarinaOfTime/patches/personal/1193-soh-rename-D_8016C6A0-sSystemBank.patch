From 6a638a9bf5d03c3bb8ad8b47b6c4dfa2389fce60 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:56:12 +0000
Subject: [PATCH 1193/3799] soh: rename D_8016C6A0 -> sSystemBank

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: gSoundBanks[4]; the same comment names entry 4 "System Bank size 8".
Defined in soh/src/code/audio_sfx.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_sfx.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index c6e4fccb6..b263ec6c6 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -44,7 +44,8 @@ SoundBankEntry sItemBank[12];  // was D_8016BC80 [LLM:HIGH]
 SoundBankEntry sEnvironmentBank[22];  // was D_8016BEC0 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8016C2E0: gSoundBanks[3]; the same comment names entry 3 "Enemy Bank size 20".
 SoundBankEntry sEnemyBank[20];  // was D_8016C2E0 [LLM:HIGH]
-SoundBankEntry D_8016C6A0[8];
+// LLM generated name (HIGH), was D_8016C6A0: gSoundBanks[4]; the same comment names entry 4 "System Bank size 8".
+SoundBankEntry sSystemBank[8];  // was D_8016C6A0 [LLM:HIGH]
 SoundBankEntry D_8016C820[3];
 SoundBankEntry D_8016C8B0[5];
 SoundRequest sSoundRequests[0x100];
@@ -75,12 +76,12 @@ u8 sSoundRequestReadIndex = 0;
  * 6 : Voice Bank           size 5
  */
 SoundBankEntry* gSoundBanks[7] = {
-    sPlayerBank, sItemBank, sEnvironmentBank, sEnemyBank, D_8016C6A0, D_8016C820, D_8016C8B0,  // was D_8016BAD0 [LLM:HIGH]
+    sPlayerBank, sItemBank, sEnvironmentBank, sEnemyBank, sSystemBank, D_8016C820, D_8016C8B0,  // was D_8016BAD0 [LLM:HIGH]
 };
 
 u8 sBankSizes[ARRAY_COUNT(gSoundBanks)] = {
     ARRAY_COUNT(sPlayerBank), ARRAY_COUNT(sItemBank), ARRAY_COUNT(sEnvironmentBank), ARRAY_COUNT(sEnemyBank),  // was D_8016BAD0 [LLM:HIGH]
-    ARRAY_COUNT(D_8016C6A0), ARRAY_COUNT(D_8016C820), ARRAY_COUNT(D_8016C8B0),
+    ARRAY_COUNT(sSystemBank), ARRAY_COUNT(D_8016C820), ARRAY_COUNT(D_8016C8B0),  // was D_8016C6A0 [LLM:HIGH]
 };
 
 u8 gSfxChannelLayout = 0;
-- 
