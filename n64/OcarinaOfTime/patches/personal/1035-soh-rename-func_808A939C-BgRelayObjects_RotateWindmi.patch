From c15d43e676e7b685466a4d902ec5a726ccff1ee9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:37:34 +0000
Subject: [PATCH 1035/3799] soh: rename func_808A939C ->
 BgRelayObjects_RotateWindmill

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the WINDMILL_ROTATING_GEAR action: eases world.rot.y toward the slow or fast rate depending on whether the Song of Storms has been played, spins the gear and pitches the wooden-gear sfx with it.
Defined in soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c       | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c b/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c
index e6bbfb803..c176dee6a 100644
--- a/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c
+++ b/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c
@@ -31,7 +31,8 @@ void BgRelayObjects_CloseDoor(BgRelayObjects* this, PlayState* play);  // was fu
 void BgRelayObjects_DoNothing(BgRelayObjects* this, PlayState* play);
 // LLM generated name (HIGH), was func_808A932C: after the five-frame failure delay, plays the abyss sfx and calls Play_TriggerRespawn to boot the player out of the race.
 void BgRelayObjects_TriggerRespawn(BgRelayObjects* this, PlayState* play);  // was func_808A932C [LLM:HIGH]
-void func_808A939C(BgRelayObjects* this, PlayState* play);
+// LLM generated name (HIGH), was func_808A939C: the WINDMILL_ROTATING_GEAR action: eases world.rot.y toward the slow or fast rate depending on whether the Song of Storms has been played, spins the gear and pitches the wooden-gear sfx with it.
+void BgRelayObjects_RotateWindmill(BgRelayObjects* this, PlayState* play);  // was func_808A939C [LLM:HIGH]
 
 const ActorInit Bg_Relay_Objects_InitVars = {
     ACTOR_BG_RELAY_OBJECTS,
@@ -81,7 +82,7 @@ void BgRelayObjects_Init(Actor* thisx, PlayState* play) {
             Actor_Kill(thisx);
         } else {
             D_808A9508 |= 2;
-            this->actionFunc = func_808A939C;
+            this->actionFunc = BgRelayObjects_RotateWindmill;  // was func_808A939C [LLM:HIGH]
         }
     } else {
         CollisionHeader_GetVirtual(&gDampeRaceDoorCol, &colHeader);
@@ -191,7 +192,7 @@ void BgRelayObjects_TriggerRespawn(BgRelayObjects* this, PlayState* play) {
     }
 }
 
-void func_808A939C(BgRelayObjects* this, PlayState* play) {
+void BgRelayObjects_RotateWindmill(BgRelayObjects* this, PlayState* play) {
     if (Flags_GetEnv(play, 5)) {
         Flags_SetEventChkInf(EVENTCHKINF_PLAYED_SONG_OF_STORMS_IN_WINDMILL);
     }
