 soh/soh/Enhancements/randomizer/hook_handlers.cpp       | 4 ++--
 soh/src/overlays/actors/ovl_Door_Gerudo/z_door_gerudo.c | 9 +++++----
 2 files changed, 7 insertions(+), 6 deletions(-)

