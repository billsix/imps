From 61a59ddb6a208e154a10ea9a8ae81fc501d8396e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:12:56 +0000
Subject: [PATCH 2128/3799] soh: rename D_808B9104 -> sExtraFlags

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-type actor flags ORed in by BgSpot18Obj_InitFlags, both zero as shipped
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
index 2b85a4b95..9b60d8a00 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
@@ -72,7 +72,8 @@ static CollisionHeader* sColHeaders[] = {  // was D_808B90FC [LLM:HIGH]
     &gGoronCityStatueSpearCol,
 };
 
-static u32 D_808B9104[] = {
+// LLM generated name (HIGH), was D_808B9104: per-type actor flags ORed in by BgSpot18Obj_InitFlags, both zero as shipped
+static u32 sExtraFlags[] = {  // was D_808B9104 [LLM:HIGH]
     0,
     0,
 };
@@ -152,7 +153,7 @@ s32 BgSpot18Obj_InitDynaPoly(BgSpot18Obj* this, PlayState* play) {
 }
 
 s32 BgSpot18Obj_InitFlags(BgSpot18Obj* this, PlayState* play) {
-    this->dyna.actor.flags |= D_808B9104[this->dyna.actor.params & 0xF];
+    this->dyna.actor.flags |= sExtraFlags[this->dyna.actor.params & 0xF];  // was D_808B9104 [LLM:HIGH]
     return 1;
 }
 
