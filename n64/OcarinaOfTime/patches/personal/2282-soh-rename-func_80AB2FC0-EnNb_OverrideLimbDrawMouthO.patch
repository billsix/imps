 }
 
-s32 func_80AB2FC0(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s* rot, void* thisx) {
+// LLM generated name (HIGH), was func_80AB2FC0: swaps the head limb for gNabooruHeadMouthOpenDL
+s32 EnNb_OverrideLimbDrawMouthOpen(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s* rot, void* thisx) {
