From 4155e8e185353a5cc8c7fda7782b36ed7f6bf119 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:49:15 +0000
Subject: [PATCH 1870/3799] soh: rename func_809CFBA8 -> EnBw_SetupFlipOver

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: starts the flailing animation with the reverse sfx and installs the upside-down action.
Defined in soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c b/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c
index 057ce773f..9106369f9 100644
--- a/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c
+++ b/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c
@@ -32,7 +32,8 @@ void EnBw_RearUp(EnBw* this, PlayState* play);  // was func_809CF7AC [LLM:HIGH]
 void EnBw_SetupLunge(EnBw* this);  // was func_809CF8F0 [LLM:HIGH]
 // LLM generated name (HIGH), was func_809CF984: carries the lunge through, bouncing the slug back off the player on a hit and stretching its body along the arc.
 void EnBw_Lunge(EnBw* this, PlayState* play);  // was func_809CF984 [LLM:HIGH]
-void func_809CFBA8(EnBw* this);
+// LLM generated name (HIGH), was func_809CFBA8: starts the flailing animation with the reverse sfx and installs the upside-down action.
+void EnBw_SetupFlipOver(EnBw* this);  // was func_809CFBA8 [LLM:HIGH]
 void func_809CFC4C(EnBw* this, PlayState* play);
 void func_809CFF10(EnBw* this);
 void func_809CFF98(EnBw* this, PlayState* play);
@@ -481,7 +482,7 @@ void EnBw_Lunge(EnBw* this, PlayState* play) {
     }
 }
 
-void func_809CFBA8(EnBw* this) {
+void EnBw_SetupFlipOver(EnBw* this) {
     Animation_MorphToLoop(&this->skelAnime, &gTorchSlugEyestalkFlailAnim, -1.0f);
     this->unk_220 = 5;
     this->unk_222 = 1000;
@@ -746,7 +747,7 @@ void func_809D0584(EnBw* this, PlayState* play) {
                 func_809CFF10(this);
             } else if (this->unk_220 != 0) {
                 this->unk_23C = 0;
-                func_809CFBA8(this);
+                EnBw_SetupFlipOver(this);  // was func_809CFBA8 [LLM:HIGH]
             }
         }
     }
