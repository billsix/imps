Date: Mon, 7 Sep 2026 21:22:01 +0000
Subject: [PATCH 0919/3799] soh: rename func_8009BEEC ->
 Scene_AddGanonsTowerCollapseQuake

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment above it reads "Screen Shake for Ganon's Tower Collapse"; it periodically adds two Quake instances to the active camera, and its three callers are the collapse draw configs.
Defined in soh/src/code/z_scene_table.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_scene_table.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_scene_table.c b/soh/src/code/z_scene_table.c
index c83bac329..f808d4004 100644
--- a/soh/src/code/z_scene_table.c
+++ b/soh/src/code/z_scene_table.c
@@ -641,7 +641,8 @@ void Scene_DrawConfigOutsideGanonsCastle(PlayState* play) {
 }
 
 // Screen Shake for Ganon's Tower Collapse
-void func_8009BEEC(PlayState* play) {
+// LLM generated name (HIGH), was func_8009BEEC: the in-tree comment above it reads "Screen Shake for Ganon's Tower Collapse"; it periodically adds two Quake instances to the active camera, and its three callers are the collapse draw configs.
+void Scene_AddGanonsTowerCollapseQuake(PlayState* play) {
     s32 var;
 
     if (play->gameplayFrames % 128 == 13) {
@@ -696,7 +697,7 @@ void Scene_DrawConfigGanonsTowerCollapseExterior(PlayState* play) {
         if ((play->sceneNum == SCENE_GANON_BOSS) || (play->sceneNum == SCENE_GANONS_TOWER_COLLAPSE_EXTERIOR) ||
             (play->sceneNum == SCENE_GANONS_TOWER_COLLAPSE_INTERIOR) ||
             (play->sceneNum == SCENE_INSIDE_GANONS_CASTLE_COLLAPSE)) {
-            func_8009BEEC(play);
+            Scene_AddGanonsTowerCollapseQuake(play);  // was func_8009BEEC [LLM:HIGH]
         }
     }
 }
@@ -1705,13 +1706,13 @@ void Scene_DrawConfigInsideGanonsCastle(PlayState* play) {
 // Scene Draw Config 52
 // Name from zeldaret/oot (was func_800A055C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_scene_table.c]
 void Scene_DrawConfigInsideGanonsCastleCollapse(PlayState* play) {
-    func_8009BEEC(play);
+    Scene_AddGanonsTowerCollapseQuake(play);  // was func_8009BEEC [LLM:HIGH]
 }
 
 // Scene Draw Config 51
 // Name from zeldaret/oot (was func_800A057C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_scene_table.c]
 void Scene_DrawConfigGanonsTowerCollapseInterior(PlayState* play) {
-    func_8009BEEC(play);
+    Scene_AddGanonsTowerCollapseQuake(play);  // was func_8009BEEC [LLM:HIGH]
 }
 
