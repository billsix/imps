Subject: [PATCH 1727/3799] soh: rename func_808B4178 ->
 BgSpot15Rrbox_SetupSlide

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the sliding action and turns gravity off for the slide.
Defined in soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c         | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c b/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
index c72799924..e022efa06 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
@@ -22,7 +22,8 @@ void func_808B4194(BgSpot15Rrbox* this, PlayState* play);
 void func_808B4380(BgSpot15Rrbox* this, PlayState* play);
 void func_808B43D0(BgSpot15Rrbox* this, PlayState* play);
 void func_808B44B8(BgSpot15Rrbox* this, PlayState* play);
-void func_808B4178(BgSpot15Rrbox* this, PlayState* play);
+// LLM generated name (HIGH), was func_808B4178: installs the sliding action and turns gravity off for the slide.
+void BgSpot15Rrbox_SetupSlide(BgSpot15Rrbox* this, PlayState* play);  // was func_808B4178 [LLM:HIGH]
 void func_808B44CC(BgSpot15Rrbox* this, PlayState* play);
 
 // LLM generated name (HIGH), was D_808B4590: which entry of sSpawnPositions the next crate takes; it is bumped on each spawn and reset when the scene reloads.
@@ -247,7 +248,7 @@ void BgSpot15Rrbox_Idle(BgSpot15Rrbox* this, PlayState* play) {
     if (this->unk_168 <= 0 && fabsf(this->dyna.unk_150) > 0.001f) {
         if (BgSpot15Rrbox_CanBePushed(this, play) && !BgSpot15Rrbox_IsPathBlocked(this, play)) {  // was func_808B3AAC [LLM:HIGH]
             this->unk_17C = this->dyna.unk_150;
-            func_808B4178(this, play);
+            BgSpot15Rrbox_SetupSlide(this, play);  // was func_808B4178 [LLM:HIGH]
         } else {
             player->stateFlags2 &= ~PLAYER_STATE2_MOVING_DYNAPOLY;
             this->dyna.unk_150 = 0.0f;
@@ -258,7 +259,7 @@ void BgSpot15Rrbox_Idle(BgSpot15Rrbox* this, PlayState* play) {
     }
 }
 
-void func_808B4178(BgSpot15Rrbox* this, PlayState* play) {
+void BgSpot15Rrbox_SetupSlide(BgSpot15Rrbox* this, PlayState* play) {
     this->actionFunc = func_808B4194;
     this->dyna.actor.gravity = 0.0f;
 }
