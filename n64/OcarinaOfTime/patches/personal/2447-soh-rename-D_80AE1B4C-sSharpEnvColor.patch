From 47eef41c84f27a3c1e628569113af40c1bd5b035 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:10 +0000
Subject: [PATCH 2447/3799] soh: rename D_80AE1B4C -> sSharpEnvColor

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the env colour EnPoh_DrawComposer uses for Sharp
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index 23ee84d01..5f754ed21 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -185,7 +185,8 @@ static EnPohInfo sPoeInfo[2] = {
     },
 };
 
-static Color_RGBA8 D_80AE1B4C = { 75, 20, 25, 255 };
+// LLM generated name (HIGH), was D_80AE1B4C: the env colour EnPoh_DrawComposer uses for Sharp
+static Color_RGBA8 sSharpEnvColor = { 75, 20, 25, 255 };  // was D_80AE1B4C [LLM:HIGH]
 static Color_RGBA8 D_80AE1B50 = { 80, 110, 90, 255 };
 static Color_RGBA8 D_80AE1B54 = { 90, 85, 50, 255 };
 static Color_RGBA8 D_80AE1B58 = { 100, 90, 100, 255 };
@@ -1133,7 +1134,7 @@ void EnPoh_DrawComposer(Actor* thisx, PlayState* play) {
     OPEN_DISPS(play->state.gfxCtx);
     EnPoh_UpdateLightColor(this);  // was func_80AE067C [LLM:HIGH]
     if (this->actor.params == EN_POH_SHARP) {
-        sp90 = &D_80AE1B4C;
+        sp90 = &sSharpEnvColor;  // was D_80AE1B4C [LLM:HIGH]
         phi_t0 = &D_80AE1B54;
     } else {
         sp90 = &D_80AE1B50;
@@ -1202,7 +1203,7 @@ void EnPoh_DrawSoul(Actor* thisx, PlayState* play) {
         gSPMatrix(POLY_OPA_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
         gSPDisplayList(POLY_OPA_DISP++, this->info->lanternDisplayList);
         if (this->infoIdx == EN_POH_INFO_COMPOSER) {
-            Color_RGBA8* envColor = (this->actor.params == EN_POH_SHARP) ? &D_80AE1B4C : &D_80AE1B50;
+            Color_RGBA8* envColor = (this->actor.params == EN_POH_SHARP) ? &sSharpEnvColor : &D_80AE1B50;  // was D_80AE1B4C [LLM:HIGH]
             s32 pad;
 
             gSPDisplayList(POLY_OPA_DISP++, gPoeComposerLanternBottomDL);
-- 
