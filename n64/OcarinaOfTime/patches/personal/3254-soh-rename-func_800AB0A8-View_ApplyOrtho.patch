From e2f1a18ac875a3d43ae4ec768404113ac40f7f89 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:09:39 +0000
Subject: [PATCH 3254/3799] soh: rename func_800AB0A8 -> View_ApplyOrtho

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: builds the viewport and a guOrtho projection and binds them
Defined in soh/src/code/z_view.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_view.c   | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 28312307b..5e647bee1 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1413,7 +1413,7 @@ void View_SetDistortion(View* view, Vec3f orientation, Vec3f scale, f32 speed);
 s32 View_StepDistortion(View* view, Mtx* projectionMtx);
 void View_Apply(View* view, s32 arg1);  // was func_800AAA50 [LLM:HIGH]
 s32 View_ApplyPerspective(View* view);  // was func_800AAA9C [LLM:HIGH]
-s32 func_800AB0A8(View* view);
+s32 View_ApplyOrtho(View* view);  // was func_800AB0A8 [LLM:HIGH]
 s32 func_800AB2C4(View* view);
 s32 func_800AB560(View* view);
 s32 func_800AB944(View* view);
diff --git a/soh/src/code/z_view.c b/soh/src/code/z_view.c
index 029b57d37..42e52e3a6 100644
--- a/soh/src/code/z_view.c
+++ b/soh/src/code/z_view.c
@@ -287,7 +287,7 @@ void View_Apply(View* view, s32 arg1) {
     arg1 = (view->flags & arg1) | (arg1 >> 4);
 
     if (arg1 & 8) {
-        func_800AB0A8(view);
+        View_ApplyOrtho(view);  // was func_800AB0A8 [LLM:HIGH]
     } else {
         View_ApplyPerspective(view);  // was func_800AAA9C [LLM:HIGH]
     }
@@ -492,7 +492,8 @@ s32 View_ApplyPerspective(View* view) {
     return 1;
 }
 
-s32 func_800AB0A8(View* view) {
+// LLM generated name (HIGH), was func_800AB0A8: builds the viewport and a guOrtho projection and binds them
+s32 View_ApplyOrtho(View* view) {
     Vp* vp;
     Mtx* projection;
     GraphicsContext* gfxCtx = view->gfxCtx;
-- 
