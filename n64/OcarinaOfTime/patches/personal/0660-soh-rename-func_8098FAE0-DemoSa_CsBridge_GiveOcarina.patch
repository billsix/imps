Subject: [PATCH 660/784] soh: rename func_8098FAE0 ->
 DemoSa_CsBridge_GiveOcarina

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 18f3509ad..13e94c0a7 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -728,7 +728,8 @@ void DemoSa_CsBridge_ClutchOcarina(DemoSa* this) {
     DemoSa_SetEyeIndex(this, SARIA_EYE_CLOSED);
 }
 
-void func_8098FAE0(DemoSa* this) {
+// Name from zeldaret/oot (was func_8098FAE0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_CsBridge_GiveOcarina(DemoSa* this) {
     DemoSa_AnimationChange(this, &gSariaGiveLinkOcarinaAnim, 2, -8.0f, 0);
     this->action = 20;
     this->drawConfig = 1;
@@ -762,7 +763,7 @@ void func_8098FB68(DemoSa* this, PlayState* play) {
                     DemoSa_CsBridge_ClutchOcarina(this);
                     break;
                 case 14:
-                    func_8098FAE0(this);
+                    DemoSa_CsBridge_GiveOcarina(this);
                     break;
                 default:
                     osSyncPrintf("Demo_Sa_inPresent_Check_DemoMode:そんな動作は無い!!!!!!!!\n");
