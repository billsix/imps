From 7b770ab3b77cc29fd28e228bd9c8efec0371d8e1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:37:33 +0000
Subject: [PATCH 1034/3799] soh: rename func_808A932C ->
 BgRelayObjects_TriggerRespawn

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: after the five-frame failure delay, plays the abyss sfx and calls Play_TriggerRespawn to boot the player out of the race.
Defined in soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c       | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c b/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c
index 854b944ac..e6bbfb803 100644
--- a/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c
+++ b/soh/src/overlays/actors/ovl_Bg_Relay_Objects/z_bg_relay_objects.c
@@ -29,7 +29,8 @@ void BgRelayObjects_WaitToClose(BgRelayObjects* this, PlayState* play);  // was
 // LLM generated name (HIGH), was func_808A9234: drops the door back to home.pos.y under gravity with rumble and the stone-bound sfx, then either ends the race or starts the failure countdown.
 void BgRelayObjects_CloseDoor(BgRelayObjects* this, PlayState* play);  // was func_808A9234 [LLM:HIGH]
 void BgRelayObjects_DoNothing(BgRelayObjects* this, PlayState* play);
-void func_808A932C(BgRelayObjects* this, PlayState* play);
+// LLM generated name (HIGH), was func_808A932C: after the five-frame failure delay, plays the abyss sfx and calls Play_TriggerRespawn to boot the player out of the race.
+void BgRelayObjects_TriggerRespawn(BgRelayObjects* this, PlayState* play);  // was func_808A932C [LLM:HIGH]
 void func_808A939C(BgRelayObjects* this, PlayState* play);
 
 const ActorInit Bg_Relay_Objects_InitVars = {
@@ -162,7 +163,7 @@ void BgRelayObjects_CloseDoor(BgRelayObjects* this, PlayState* play) {
         if (this->unk_169 != play->roomCtx.curRoom.num) {
             Sfx_PlaySfxCentered2(NA_SE_EN_PO_LAUGH);
             this->timer = 5;
-            this->actionFunc = func_808A932C;
+            this->actionFunc = BgRelayObjects_TriggerRespawn;  // was func_808A932C [LLM:HIGH]
             return;
         }
         Flags_UnsetSwitch(play, this->switchFlag);
@@ -177,7 +178,7 @@ void BgRelayObjects_CloseDoor(BgRelayObjects* this, PlayState* play) {
 void BgRelayObjects_DoNothing(BgRelayObjects* this, PlayState* play) {
 }
 
-void func_808A932C(BgRelayObjects* this, PlayState* play) {
+void BgRelayObjects_TriggerRespawn(BgRelayObjects* this, PlayState* play) {
     if (GameInteractor_Should(VB_SWITCH_TIMER_TICK, this->timer != 0, this, &this->timer)) {
         this->timer--;
     }
-- 
