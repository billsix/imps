Body verified against upstream at 0.98.
Defined in soh/src/code/PreRender.c.
---
 soh/include/functions.h  | 2 +-
 soh/src/code/PreRender.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 6592d339a..70f5522df 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1587,7 +1587,7 @@ void PreRender_SaveZBuffer(PreRender* this, Gfx** gfxp);  // was func_800C1E9C [
 void PreRender_SaveFramebuffer(PreRender* this, Gfx** gfxp);  // was func_800C1F20 [oot]
 void PreRender_FetchFbufCoverage(PreRender* this, Gfx** gfxp);  // was func_800C1FA4 [oot]
 void PreRender_DrawCoverage(PreRender* this, Gfx** gfxp);  // was func_800C20B4 [oot]
-void func_800C2118(PreRender* this, Gfx** gfxp);
+void PreRender_RestoreZBuffer(PreRender* this, Gfx** gfxp);  // was func_800C2118 [oot]
 void func_800C213C(PreRender* this, Gfx** gfxp);
 void func_800C24BC(PreRender* this, Gfx** gfxp);
 void func_800C24E0(PreRender* this, Gfx** gfxp);
diff --git a/soh/src/code/PreRender.c b/soh/src/code/PreRender.c
