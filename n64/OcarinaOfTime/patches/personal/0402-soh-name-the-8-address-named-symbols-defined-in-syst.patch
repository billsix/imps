     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x7F, 0x80, 0x00, 0x00,
     0xFF, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x00, 0x00, 0x00,
 };
@@ -97,7 +98,8 @@ s32 Overlay_Load(uintptr_t vRomStart, uintptr_t vRomEnd, void* vRamStart, void*
 }
 
 // possibly some kind of new() function
-void* func_800FC800(size_t size) {
+// LLM generated name (HIGH), was func_800FC800: allocates from the system arena tagged with the file's "new" string, forcing a minimum of one byte
+void* SystemHeap_New(size_t size) {
     if (size == 0) {
         size = 1;
     }
@@ -106,13 +108,15 @@ void* func_800FC800(size_t size) {
 }
 
 // possible some kind of delete() function
-void func_800FC83C(void* ptr) {
+// LLM generated name (HIGH), was func_800FC83C: frees a system arena block, tolerating NULL
+void SystemHeap_Delete(void* ptr) {
     if (ptr != NULL) {
         __osFree(&gSystemArena, ptr);
     }
 }
 
-void func_800FC868(void* blk, u32 nBlk, u32 blkSize, arg3_800FC868 arg3) {
+// LLM generated name (HIGH), was func_800FC868: walks an array of blocks calling the caller's one-argument function on each
+void SystemHeap_ConstructArray(void* blk, u32 nBlk, u32 blkSize, arg3_800FC868 arg3) {
     uintptr_t pos;
 
     for (pos = (uintptr_t)blk; pos < (uintptr_t)blk + (nBlk * blkSize); pos = (uintptr_t)pos + (blkSize & ~0)) {
@@ -120,7 +124,8 @@ void func_800FC868(void* blk, u32 nBlk, u32 blkSize, arg3_800FC868 arg3) {
     }
 }
 
-void func_800FC8D8(void* blk, u32 nBlk, s32 blkSize, arg3_800FC8D8 arg3) {
+// LLM generated name (HIGH), was func_800FC8D8: the same walk calling a two-argument function with 2, the destructor flag
+void SystemHeap_DestructArray(void* blk, u32 nBlk, s32 blkSize, arg3_800FC8D8 arg3) {
     uintptr_t pos;
 
     for (pos = (uintptr_t)blk; pos < (uintptr_t)blk + (nBlk * blkSize); pos = (uintptr_t)pos + (blkSize & ~0)) {
@@ -128,11 +133,12 @@ void func_800FC8D8(void* blk, u32 nBlk, s32 blkSize, arg3_800FC8D8 arg3) {
     }
 }
 
-void* func_800FC948(void* blk, u32 nBlk, u32 blkSize, arg3_800FC948 arg3) {
+// LLM generated name (HIGH), was func_800FC948: allocates the array when the caller passes NULL, then constructs every element
+void* SystemHeap_NewArray(void* blk, u32 nBlk, u32 blkSize, arg3_800FC948 arg3) {
     uintptr_t pos;
 
     if (blk == NULL) {
-        blk = func_800FC800(nBlk * blkSize);
+        blk = SystemHeap_New(nBlk * blkSize);  // was func_800FC800 [LLM:HIGH]
     }
 
     if (blk != NULL && arg3 != NULL) {
@@ -145,7 +151,8 @@ void* func_800FC948(void* blk, u32 nBlk, u32 blkSize, arg3_800FC948 arg3) {
