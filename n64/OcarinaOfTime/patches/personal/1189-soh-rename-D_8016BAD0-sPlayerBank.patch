From 4ed9587b126fba57307020d27a340162916509db Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:56:12 +0000
Subject: [PATCH 1189/3799] soh: rename D_8016BAD0 -> sPlayerBank

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: gSoundBanks[0]; the doc comment above that array names entry 0 "Player Bank size 9", matching this array's length.
Defined in soh/src/code/audio_sfx.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_sfx.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index ab66d4122..17cd30d13 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -36,7 +36,8 @@ s32 D_8013338C = 0;
 char D_80133390[] = "SEQ H";
 char D_80133398[] = "    L";
 
-SoundBankEntry D_8016BAD0[9];
+// LLM generated name (HIGH), was D_8016BAD0: gSoundBanks[0]; the doc comment above that array names entry 0 "Player Bank size 9", matching this array's length.
+SoundBankEntry sPlayerBank[9];  // was D_8016BAD0 [LLM:HIGH]
 SoundBankEntry D_8016BC80[12];
 SoundBankEntry D_8016BEC0[22];
 SoundBankEntry D_8016C2E0[20];
@@ -71,11 +72,11 @@ u8 sSoundRequestReadIndex = 0;
  * 6 : Voice Bank           size 5
  */
 SoundBankEntry* gSoundBanks[7] = {
-    D_8016BAD0, D_8016BC80, D_8016BEC0, D_8016C2E0, D_8016C6A0, D_8016C820, D_8016C8B0,
+    sPlayerBank, D_8016BC80, D_8016BEC0, D_8016C2E0, D_8016C6A0, D_8016C820, D_8016C8B0,  // was D_8016BAD0 [LLM:HIGH]
 };
 
 u8 sBankSizes[ARRAY_COUNT(gSoundBanks)] = {
-    ARRAY_COUNT(D_8016BAD0), ARRAY_COUNT(D_8016BC80), ARRAY_COUNT(D_8016BEC0), ARRAY_COUNT(D_8016C2E0),
+    ARRAY_COUNT(sPlayerBank), ARRAY_COUNT(D_8016BC80), ARRAY_COUNT(D_8016BEC0), ARRAY_COUNT(D_8016C2E0),  // was D_8016BAD0 [LLM:HIGH]
     ARRAY_COUNT(D_8016C6A0), ARRAY_COUNT(D_8016C820), ARRAY_COUNT(D_8016C8B0),
 };
 
