+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -617,7 +617,8 @@ void DemoIm_SetupIdleOnCue(DemoIm* this, PlayState* play) {
     this->drawConfig = 1;
 }
 
-void func_80985FE8(DemoIm* this, s32 arg1) {
+// LLM generated name (HIGH), was func_80985FE8: loops gImpaWhistlingAnim once the lead-in ends
+void DemoIm_StartWhistleLoopWhenAnimDone(DemoIm* this, s32 arg1) {
     if (arg1 != 0) {
         Animation_Change(&this->skelAnime, &gImpaWhistlingAnim, 1.0f, 0.0f, Animation_GetLastFrame(&gImpaWhistlingAnim),
                          ANIMMODE_LOOP, -8.0f);
@@ -737,7 +738,7 @@ void func_80986430(DemoIm* this, PlayState* play) {
     sp24 = DemoIm_UpdateSkelAnime(this);
     DemoIm_TrackPlayerDuringCs(this, play);  // was func_80985EAC [LLM:HIGH]
     DemoIm_UpdateEyes(this);  // was func_80984BE0 [LLM:HIGH]
-    func_80985FE8(this, sp24);
+    DemoIm_StartWhistleLoopWhenAnimDone(this, sp24);  // was func_80985FE8 [LLM:HIGH]
     func_809862E0(this, play);
 }
 
