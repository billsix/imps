From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:40 +0000
Subject: [PATCH 3626/3799] soh: rename func_80B54DB4 ->
 EnZl3_GetSwitchFlagIndex

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: (params >> 8) & 0xFF -- the value handed to Flags_SetSwitch/Flags_GetSwitch and compared against the per-scene spawn table
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index cb7905183..c1c219e92 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -758,7 +758,8 @@ void EnZl3_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
     }
 }
 
-s32 func_80B54DB4(EnZl3* this) {
+// LLM generated name (HIGH), was func_80B54DB4: (params >> 8) & 0xFF -- the value handed to Flags_SetSwitch/Flags_GetSwitch and compared against the per-scene spawn table
+s32 EnZl3_GetSwitchFlagIndex(EnZl3* this) {
     s32 params = this->actor.params >> 8;
 
     return params & 0xFF;
@@ -1597,11 +1598,11 @@ void func_80B56E38(EnZl3* this, PlayState* play) {
 }
 
 void func_80B56EB8(EnZl3* this, PlayState* play) {
-    Flags_SetSwitch(play, func_80B54DB4(this));
+    Flags_SetSwitch(play, EnZl3_GetSwitchFlagIndex(this));  // was func_80B54DB4 [LLM:HIGH]
 }
 
 s32 func_80B56EE4(EnZl3* this, PlayState* play) {
-    return Flags_GetSwitch(play, func_80B54DB4(this));
+    return Flags_GetSwitch(play, EnZl3_GetSwitchFlagIndex(this));  // was func_80B54DB4 [LLM:HIGH]
 }
 
 void func_80B56F10(EnZl3* this, PlayState* play) {
@@ -1803,7 +1804,7 @@ s32 func_80B575D0(EnZl3* this, PlayState* play) {
 s32 func_80B575F0(EnZl3* this, PlayState* play) {
     s16 sceneNum = play->sceneNum;
 
-    if ((sceneNum == SCENE_GANONS_TOWER_COLLAPSE_INTERIOR) && (func_80B54DB4(this) == 0x26)) {
+    if ((sceneNum == SCENE_GANONS_TOWER_COLLAPSE_INTERIOR) && (EnZl3_GetSwitchFlagIndex(this) == 0x26)) {  // was func_80B54DB4 [LLM:HIGH]
         s32 unk_314 = this->unk_314;
 
         if (unk_314 == 1) {
@@ -1816,7 +1817,7 @@ s32 func_80B575F0(EnZl3* this, PlayState* play) {
 void func_80B5764C(EnZl3* this, PlayState* play) {
     s16 sceneNum = play->sceneNum;
 
-    if ((sceneNum == SCENE_GANONS_TOWER_COLLAPSE_INTERIOR) && (func_80B54DB4(this) == 0x26)) {
+    if ((sceneNum == SCENE_GANONS_TOWER_COLLAPSE_INTERIOR) && (EnZl3_GetSwitchFlagIndex(this) == 0x26)) {  // was func_80B54DB4 [LLM:HIGH]
         s32 unk_314 = this->unk_314 + 1;
 
         if ((unk_314 == 1) && !Play_InCsMode(play)) {
@@ -1875,7 +1876,7 @@ s32 func_80B57890(EnZl3* this, PlayState* play) {
     s8 pad[2];
     u8 curSpawn = play->curSpawn;
     s16 sceneNum = play->sceneNum;
-    s32 result = func_80B54DB4(this);
+    s32 result = EnZl3_GetSwitchFlagIndex(this);  // was func_80B54DB4 [LLM:HIGH]
 
     if (play) {} // Needed to match, this if can be almost anywhere and it still matches
 
@@ -2529,7 +2530,7 @@ s32 func_80B59698(EnZl3* this, PlayState* play) {
     if (cond) {
         u8 curSpawn = play->curSpawn;
 
-        if ((func_80B54DB4(this) == 0x20) && (curSpawn == 0) &&
+        if ((EnZl3_GetSwitchFlagIndex(this) == 0x20) && (curSpawn == 0) &&  // was func_80B54DB4 [LLM:HIGH]
             ((gSaveContext.subTimerSeconds <= 0) || (gSaveContext.subTimerState == SUBTIMER_STATE_OFF))) {
             return 1;
         }
@@ -2546,7 +2547,7 @@ s32 func_80B59768(EnZl3* this, PlayState* play) {
     if (cond) {
         u8 curSpawn = play->curSpawn;
 
-        if ((func_80B54DB4(this) == 0x20) && (curSpawn == 0) && (gSaveContext.subTimerSeconds <= 0)) {
+        if ((EnZl3_GetSwitchFlagIndex(this) == 0x20) && (curSpawn == 0) && (gSaveContext.subTimerSeconds <= 0)) {  // was func_80B54DB4 [LLM:HIGH]
             return 1;
         }
     }
@@ -2593,7 +2594,7 @@ void func_80B59828(EnZl3* this, PlayState* play) {
         Flags_UnsetSwitch(play, 0x2A);
     }
 
-    if (func_80B54DB4(this) == 0x20) {
+    if (EnZl3_GetSwitchFlagIndex(this) == 0x20) {  // was func_80B54DB4 [LLM:HIGH]
         s32 cond;
 
         func_80B54EA4(this, play);
