From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:34 +0000
Subject: [PATCH 701/784] soh: rename func_80AEB7E0 -> EnRu1_GetSwimLerpFactor

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 320aca6b3..ac8f0dfee 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -544,7 +544,8 @@ void func_80AEB7D0(EnRu1* this) {
     this->skelAnime.movementFlags &= ~0x3;
 }
 
-f32 func_80AEB7E0(CsCmdActorCue* csCmdNPCAction, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEB7E0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+f32 EnRu1_GetSwimLerpFactor(CsCmdActorCue* csCmdNPCAction, PlayState* play) {
     s32 csCtxFrames = play->csCtx.frames;
 
     if ((csCtxFrames < csCmdNPCAction->endFrame) && (csCmdNPCAction->endFrame - csCmdNPCAction->startFrame > 0)) {
@@ -595,7 +596,7 @@ void func_80AEB974(EnRu1* this, PlayState* play) {
     s32 pad;
 
     if (csCmdNPCAction != NULL) {
-        sp30 = func_80AEB7E0(csCmdNPCAction, play);
+        sp30 = EnRu1_GetSwimLerpFactor(csCmdNPCAction, play);
         thisPos = &this->actor.world.pos;
         thisPos->x = func_80AEB87C(sp30, csCmdNPCAction->startPos.x, csCmdNPCAction->endPos.x);
         thisPos->y = func_80AEB87C(sp30, csCmdNPCAction->startPos.y, csCmdNPCAction->endPos.y);
@@ -617,7 +618,7 @@ void func_80AEBA2C(EnRu1* this, PlayState* play) {
     s32 pad2;
 
     if (csCmdNPCAction != NULL) {
-        temp_ret_2 = func_80AEB7E0(csCmdNPCAction, play);
+        temp_ret_2 = EnRu1_GetSwimLerpFactor(csCmdNPCAction, play);
         thisPos = &this->actor.world.pos;
         thisPos->x = func_80AEB87C(temp_ret_2, unk_364->x, csCmdNPCAction->endPos.x);
         thisPos->y = func_80AEB87C(temp_ret_2, unk_364->y, csCmdNPCAction->endPos.y);
