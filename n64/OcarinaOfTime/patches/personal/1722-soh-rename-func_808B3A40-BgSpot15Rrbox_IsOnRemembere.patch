Date: Mon, 7 Sep 2026 22:39:21 +0000
Subject: [PATCH 1722/3799] soh: rename func_808B3A40 ->
 BgSpot15Rrbox_IsOnRememberedBg

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns whether the crate is still sitting on the bg actor it remembered, by comparing their XZ positions.
Defined in soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c         | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c b/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
index ae231d804..9044a075c 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot15_Rrbox/z_bg_spot15_rrbox.c
@@ -86,7 +86,8 @@ void BgSpot15Rrbox_ClearRiddenBgId(BgSpot15Rrbox* this) {
     this->bgId = BG_ACTOR_MAX;
 }
 
-s32 func_808B3A40(BgSpot15Rrbox* this, PlayState* play) {
+// LLM generated name (HIGH), was func_808B3A40: returns whether the crate is still sitting on the bg actor it remembered, by comparing their XZ positions.
+s32 BgSpot15Rrbox_IsOnRememberedBg(BgSpot15Rrbox* this, PlayState* play) {
     DynaPolyActor* dynaPolyActor = DynaPoly_GetActor(&play->colCtx, this->bgId);
 
     if ((dynaPolyActor != NULL) &&
@@ -103,7 +104,7 @@ s32 func_808B3AAC(BgSpot15Rrbox* this, PlayState* play) {
 
     if (play->sceneNum == SCENE_LON_LON_BUILDINGS) {
         return true;
-    } else if (func_808B3A40(this, play)) {
+    } else if (BgSpot15Rrbox_IsOnRememberedBg(this, play)) {  // was func_808B3A40 [LLM:HIGH]
         return false;
     }
 
@@ -290,7 +291,7 @@ void func_808B4194(BgSpot15Rrbox* this, PlayState* play) {
         if (func_808B4010(this, play)) {
             Audio_PlayActorSound2(actor, NA_SE_EV_WOOD_BOUND);
         }
-        if (func_808B3A40(this, play)) {
+        if (BgSpot15Rrbox_IsOnRememberedBg(this, play)) {  // was func_808B3A40 [LLM:HIGH]
             Sfx_PlaySfxCentered(NA_SE_SY_CORRECT_CHIME);
         }
         actor->home.pos.x = actor->world.pos.x;
