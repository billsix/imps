From 9b5ed6a777d3c09e468c78921e801d1f0712cff9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:03:17 +0000
Subject: [PATCH 1242/3799] soh: rename D_80127060 -> sUnusedBlackFillDL

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same shape immediately below it, likewise marked "// unused?", filling the screen black in fill-cycle mode.
Defined in soh/src/code/z_rcp.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_rcp.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/z_rcp.c b/soh/src/code/z_rcp.c
index 7a43a447e..b0199fb6e 100644
--- a/soh/src/code/z_rcp.c
+++ b/soh/src/code/z_rcp.c
@@ -836,7 +836,8 @@ Gfx sUnusedWhiteFillDL[] = {  // was D_80127030 [LLM:HIGH]
 };
 
 // unused?
-Gfx D_80127060[] = {
+// LLM generated name (HIGH), was D_80127060: the same shape immediately below it, likewise marked "// unused?", filling the screen black in fill-cycle mode.
+Gfx sUnusedBlackFillDL[] = {  // was D_80127060 [LLM:HIGH]
     gsDPPipeSync(),
     gsDPSetCycleType(G_CYC_FILL),
     gsDPSetRenderMode(G_RM_NOOP, G_RM_NOOP2),
-- 
2.55.0

