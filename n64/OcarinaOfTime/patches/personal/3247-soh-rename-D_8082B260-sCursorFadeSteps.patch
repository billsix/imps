From 2df70896dd0db3ce478878cd966c1b9fbad768b6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:50 +0000
Subject: [PATCH 3247/3799] soh: rename D_8082B260 -> sCursorFadeSteps

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the number of steps the game-over cursor colour fade is divided into
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_scope_PAL.c   | 28 +++++++++----------
 1 file changed, 14 insertions(+), 14 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index c1845a650..203efcb7b 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -3884,7 +3884,7 @@ void KaleidoScope_UpdateDungeonMap(PlayState* play) {
 void KaleidoScope_Update(PlayState* play) {
     static s16 sNextPauseState = 0;  // was D_8082B258 [LLM:HIGH]
     static s16 sPauseStateTimer = 10;  // was D_8082B25C [LLM:HIGH]
-    static s16 D_8082B260 = 0;
+    static s16 sCursorFadeSteps = 0;  // was D_8082B260 [LLM:HIGH]
     PauseContext* pauseCtx = &play->pauseCtx;
     InterfaceContext* interfaceCtx = &play->interfaceCtx;
     GameOverContext* gameOverCtx = &play->gameOverCtx;
@@ -4619,17 +4619,17 @@ void KaleidoScope_Update(PlayState* play) {
             sCursorEnvR = 30;  // was D_8082AB9C [LLM:HIGH]
             sCursorEnvG = 0;  // was D_8082ABA0 [LLM:HIGH]
             sCursorEnvB = 0;  // was D_8082ABA4 [LLM:HIGH]
-            D_8082B260 = 30;
+            sCursorFadeSteps = 30;  // was D_8082B260 [LLM:HIGH]
             VREG(88) = 98;
             pauseCtx->promptChoice = 0;
             pauseCtx->state++;
             break;
 
         case 0xB:
-            stepR = ABS(sCursorPrimR - 30) / D_8082B260;  // was D_8082AB8C [LLM:HIGH]
-            stepG = ABS(sCursorPrimG) / D_8082B260;  // was D_8082AB90 [LLM:HIGH]
-            stepB = ABS(sCursorPrimB) / D_8082B260;  // was D_8082AB94 [LLM:HIGH]
-            stepA = ABS(sCursorPrimA - 255) / D_8082B260;  // was D_8082AB98 [LLM:HIGH]
+            stepR = ABS(sCursorPrimR - 30) / sCursorFadeSteps;  // was D_8082AB8C [LLM:HIGH]
+            stepG = ABS(sCursorPrimG) / sCursorFadeSteps;  // was D_8082AB90 [LLM:HIGH]
+            stepB = ABS(sCursorPrimB) / sCursorFadeSteps;  // was D_8082AB94 [LLM:HIGH]
+            stepA = ABS(sCursorPrimA - 255) / sCursorFadeSteps;  // was D_8082AB98 [LLM:HIGH]
             if (sCursorPrimR >= 30) {  // was D_8082AB8C [LLM:HIGH]
                 sCursorPrimR -= stepR;  // was D_8082AB8C [LLM:HIGH]
             } else {
@@ -4651,9 +4651,9 @@ void KaleidoScope_Update(PlayState* play) {
                 sCursorPrimA += stepA;  // was D_8082AB98 [LLM:HIGH]
             }
 
-            stepR = ABS(sCursorEnvR - 255) / D_8082B260;  // was D_8082AB9C [LLM:HIGH]
-            stepG = ABS(sCursorEnvG - 130) / D_8082B260;  // was D_8082ABA0 [LLM:HIGH]
-            stepB = ABS(sCursorEnvB) / D_8082B260;  // was D_8082ABA4 [LLM:HIGH]
+            stepR = ABS(sCursorEnvR - 255) / sCursorFadeSteps;  // was D_8082AB9C [LLM:HIGH]
+            stepG = ABS(sCursorEnvG - 130) / sCursorFadeSteps;  // was D_8082ABA0 [LLM:HIGH]
+            stepB = ABS(sCursorEnvB) / sCursorFadeSteps;  // was D_8082ABA4 [LLM:HIGH]
             if (sCursorEnvR >= 255) {  // was D_8082AB9C [LLM:HIGH]
                 sCursorEnvR -= stepR;  // was D_8082AB9C [LLM:HIGH]
             } else {
@@ -4670,8 +4670,8 @@ void KaleidoScope_Update(PlayState* play) {
                 sCursorEnvB += stepB;  // was D_8082ABA4 [LLM:HIGH]
             }
 
-            D_8082B260--;
-            if (D_8082B260 == 0) {
+            sCursorFadeSteps--;  // was D_8082B260 [LLM:HIGH]
+            if (sCursorFadeSteps == 0) {  // was D_8082B260 [LLM:HIGH]
                 sCursorPrimR = 30;  // was D_8082AB8C [LLM:HIGH]
                 sCursorPrimG = 0;  // was D_8082AB90 [LLM:HIGH]
                 sCursorPrimB = 0;  // was D_8082AB94 [LLM:HIGH]
@@ -4682,13 +4682,13 @@ void KaleidoScope_Update(PlayState* play) {
                 sCursorEnvB = 0;  // was D_8082ABA4 [LLM:HIGH]
 
                 pauseCtx->state++;
-                D_8082B260 = 40;
+                sCursorFadeSteps = 40;  // was D_8082B260 [LLM:HIGH]
             }
             break;
 
         case 0xC:
-            D_8082B260--;
-            if (D_8082B260 == 0) {
+            sCursorFadeSteps--;  // was D_8082B260 [LLM:HIGH]
+            if (sCursorFadeSteps == 0) {  // was D_8082B260 [LLM:HIGH]
                 pauseCtx->state = 0xD;
             }
             break;
-- 
