From 4fc828c6c513de4685066667bdbff119209811b8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:53:59 +0000
Subject: [PATCH 2866/3799] soh: rename D_80ADD7F8 -> sLanternOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hand-space point the lantern position is transformed from
Defined in soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
index 8e9a3fffc..38f960082 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
@@ -215,7 +215,8 @@ static Color_RGBA8 sLanternColors[4] = {  // was D_80ADD7E8 [LLM:HIGH]
     { 70, 70, 0, 0 },
 };
 
-static Vec3f D_80ADD7F8 = { 1000.0f, -1700.0f, 0.0f };
+// LLM generated name (HIGH), was D_80ADD7F8: the hand-space point the lantern position is transformed from
+static Vec3f sLanternOffset = { 1000.0f, -1700.0f, 0.0f };  // was D_80ADD7F8 [LLM:HIGH]
 
 void EnPoSisters_Init(Actor* thisx, PlayState* play) {
     EnPoSisters* this = (EnPoSisters*)thisx;
@@ -1381,9 +1382,9 @@ void EnPoSisters_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s
             for (i = this->unk_198 - 1; i > 0; i--) {
                 this->unk_234[i] = this->unk_234[i - 1];
             }
-            Matrix_MultVec3f(&D_80ADD7F8, &this->unk_234[0]);
+            Matrix_MultVec3f(&sLanternOffset, &this->unk_234[0]);  // was D_80ADD7F8 [LLM:HIGH]
         } else if (this->actionFunc == EnPoSisters_FormUp) {  // was func_80ADBD8C [LLM:HIGH]
-            Matrix_MultVec3f(&D_80ADD7F8, &this->actor.home.pos);
+            Matrix_MultVec3f(&sLanternOffset, &this->actor.home.pos);  // was D_80ADD7F8 [LLM:HIGH]
         }
         if (this->unk_198 > 0) {
             Color_RGBA8* color = &sPrimColors[this->unk_194];  // was D_80ADD6F0 [LLM:HIGH]
-- 
2.55.0

