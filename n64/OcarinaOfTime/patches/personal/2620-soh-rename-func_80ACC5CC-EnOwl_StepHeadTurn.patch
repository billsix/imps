From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:41:12 +0000
Subject: [PATCH 2620/3799] soh: rename func_80ACC5CC -> EnOwl_StepHeadTurn

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: steps the head angle four units a frame toward its target and reports arrival
Defined in soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
index 44149e74a..94348f2f0 100644
--- a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
+++ b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
@@ -1089,7 +1089,8 @@ void EnOwl_AnimLoopOnce(EnOwl* this) {
     }
 }
 
-s32 func_80ACC5CC(EnOwl* this) {
+// LLM generated name (HIGH), was func_80ACC5CC: steps the head angle four units a frame toward its target and reports arrival
+s32 EnOwl_StepHeadTurn(EnOwl* this) {
     s32 phi_v1 = (this->actionFlags & 2) ? 0x20 : 0;
 
     if (phi_v1 == (this->unk_3EE & 0x3F)) {
@@ -1199,7 +1200,7 @@ void EnOwl_Update(Actor* thisx, PlayState* play) {
                     }
                     break;
                 case 2:
-                    if (func_80ACC5CC(this)) {
+                    if (EnOwl_StepHeadTurn(this)) {  // was func_80ACC5CC [LLM:HIGH]
                         this->actionFlags &= ~0x10;
                         this->unk_406 = (s32)Rand_ZeroFloat(20.0f) + 0x3C;
                         this->unk_404 = 0;
