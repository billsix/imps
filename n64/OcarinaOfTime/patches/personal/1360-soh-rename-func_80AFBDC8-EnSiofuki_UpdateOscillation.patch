     DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
 }
 
-void func_80AFBDC8(EnSiofuki* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AFBDC8: drives the geyser's small vertical wobble from a sine over the gameplay frame counter and applies it to both the actor's Y and the draw offset.
+void EnSiofuki_UpdateOscillation(EnSiofuki* this, PlayState* play) {
     this->oscillation = sinf((play->gameplayFrames & 0x1F) / 32.0f * M_PI * 2.0f) * 4.0f;
     this->unk_170 = this->unk_174 * 10.0f + -6058.0f - this->oscillation * 10.0f;
     this->unk_174 = 35.0f;
@@ -185,7 +186,7 @@ void func_80AFC1D0(EnSiofuki* this, PlayState* play) {
 }
 
