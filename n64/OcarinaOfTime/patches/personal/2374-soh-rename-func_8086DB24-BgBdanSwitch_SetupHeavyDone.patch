-            func_8086DB24(this);
+            BgBdanSwitch_SetupHeavyDone(this);  // was func_8086DB24 [LLM:HIGH]
             Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_FOOT_SWITCH);
             Rumble_Request(this->dyna.actor.xyzDistToPlayerSq, 0x78, 0x14, 0xA);
         }
@@ -419,7 +420,7 @@ void BgBdanSwitch_HeavyRelease(BgBdanSwitch* this, PlayState* play) {
     }
 }
 
-void func_8086DB24(BgBdanSwitch* this) {
+void BgBdanSwitch_SetupHeavyDone(BgBdanSwitch* this) {
     this->unk_1C8 = 0.1f;
     this->actionFunc = func_8086DB40;
 }
