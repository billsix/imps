-    func_8096D64C(this, play);
+    DemoEc_MoveActor2(this, play);  // was func_8096D64C [LLM:HIGH]
     ActorShape_Init(&this->actor.shape, 0.0f, ActorShadow_DrawCircle, 30.0f);
