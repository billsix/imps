From b80326b2491e81a5fe202dca455aa1f56bb91e64 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:55 +0000
Subject: [PATCH 2495/3799] soh: rename func_800F3F84 ->
 Audio_SetSfxScalesFromSpeed

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: turns a speed into the shared frequency and volume scales, saturating above 6
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 7de748d44..85eb4faee 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -4379,7 +4379,8 @@ void Audio_PlayCutsceneEffectsSequence(u8 arg0) {
     }
 }
 
-f32 func_800F3F84(f32 arg0) {
+// LLM generated name (HIGH), was func_800F3F84: turns a speed into the shared frequency and volume scales, saturating above 6
+f32 Audio_SetSfxScalesFromSpeed(f32 arg0) {
     f32 ret = 1.0f;
 
     if (arg0 > 6.0f) {
@@ -4400,7 +4401,7 @@ void func_800F4010(Vec3f* pos, u16 sfxId, f32 arg2) {
     u16 sfxId2;
 
     D_80131C8C = arg2;
-    sp24 = func_800F3F84(arg2);
+    sp24 = Audio_SetSfxScalesFromSpeed(arg2);  // was func_800F3F84 [LLM:HIGH]
     Audio_PlaySfxGeneral(sfxId, pos, 4, &D_8016B7B0, &D_8016B7A8, &gSfxDefaultReverb);
 
     if ((sfxId & 0xF0) == 0xB0) {
@@ -4424,7 +4425,7 @@ void func_800F4010(Vec3f* pos, u16 sfxId, f32 arg2) {
 }
 
 void func_800F4138(Vec3f* pos, u16 sfxId, f32 arg2) {
-    func_800F3F84(arg2);
+    Audio_SetSfxScalesFromSpeed(arg2);  // was func_800F3F84 [LLM:HIGH]
     Audio_PlaySfxGeneral(sfxId, pos, 4, &D_8016B7B0, &D_8016B7A8, &gSfxDefaultReverb);
 }
 
