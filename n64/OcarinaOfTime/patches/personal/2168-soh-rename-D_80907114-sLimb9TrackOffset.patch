From 9cbde2529879a79a1c3697c93ccf26fd1ed38c39 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:15:36 +0000
Subject: [PATCH 2168/3799] soh: rename D_80907114 -> sLimb9TrackOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the offset whose transformed position limb 9 records
Defined in soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c      | 2 +-
 soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
index 93bf4c17c..0355a9256 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -2626,7 +2626,7 @@ void BossGanon2_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
     } else if (limbIndex == 3) {
         Matrix_MultVec3f(&sLimb3TrackOffset, &this->unk_1F4);  // was D_80907108 [LLM:HIGH]
     } else if (limbIndex == 9) {
-        Matrix_MultVec3f(&D_80907114, &this->unk_1E8);
+        Matrix_MultVec3f(&sLimb9TrackOffset, &this->unk_1E8);  // was D_80907114 [LLM:HIGH]
     } else if (limbIndex == 38) {
         Matrix_MultVec3f(&sOrigin, &this->unk_1DC);  // was D_80906D60 [LLM:HIGH]
     } else if (limbIndex == 41) {
diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
index 17b43d12b..97b68b856 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
@@ -287,7 +287,8 @@ static Vec3f sSwordTrailAnchorOffset = { 0.0f, 0.0f, 5000.0f };  // was D_809070
 // LLM generated name (HIGH), was D_80907108: the offset whose transformed position limb 3 records
 static Vec3f sLimb3TrackOffset = { 0.0f, 2000.0f, 0.0f };  // was D_80907108 [LLM:HIGH]
 
-static Vec3f D_80907114 = { 0.0f, 2000.0f, 0.0f };
+// LLM generated name (HIGH), was D_80907114: the offset whose transformed position limb 9 records
+static Vec3f sLimb9TrackOffset = { 0.0f, 2000.0f, 0.0f };  // was D_80907114 [LLM:HIGH]
 
 static Vec3f D_80907120 = { 0.0f, 0.0f, 17000.0f };
 
