From 27f9622b04118d0128d04d3d0f9e1bb65a6113a6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:30:48 +0000
Subject: [PATCH 0966/3799] soh: rename D_8089B15C -> sDebrisLifetimes

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: feeds the life parameter (13th argument) of the same EffectSsKakera_Spawn call.
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c b/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c
index 23be17ff4..55537db07 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c
@@ -84,7 +84,8 @@ static s16 sDebrisScales[] = {  // was D_8089B14C [LLM:HIGH]
     0x0005, 0x0008, 0x000B, 0x000E, 0x0011, 0x0014, 0x0017, 0x001A,
 };
 
-static s16 D_8089B15C[] = {
+// LLM generated name (HIGH), was D_8089B15C: feeds the life parameter (13th argument) of the same EffectSsKakera_Spawn call.
+static s16 sDebrisLifetimes[] = {  // was D_8089B15C [LLM:HIGH]
     0x0012, 0x001A, 0x0022, 0x002A, 0x0032, 0x003C, 0x0046, 0x0050,
 };
 
@@ -131,7 +132,7 @@ void BgJyaMegami_SpawnEffect(PlayState* play, Vec3f* pos, Vec3f* velocity, s32 n
         s32 idx = ((s16)(Rand_ZeroOne() * 8.0f)) & D_8089B17C[arg4];
         s16 arg5 = ((idx < 5) && (Rand_ZeroOne() < 0.7f)) ? 0x40 : 0x20;
         EffectSsKakera_Spawn(play, pos, velocity, pos, -90, arg5, D_8089B16C[idx], 4, 0, sDebrisScales[idx], 0, 5,  // was D_8089B14C [LLM:HIGH]
-                             D_8089B15C[idx], KAKERA_COLOR_NONE, OBJECT_JYA_OBJ, gMegami2DL);
+                             sDebrisLifetimes[idx], KAKERA_COLOR_NONE, OBJECT_JYA_OBJ, gMegami2DL);  // was D_8089B15C [LLM:HIGH]
         if (Rand_ZeroOne() < 0.45f) {
             Math_Vec3f_Copy(&spB4, pos);
             spB4.z += 25.0f;
-- 
