From 6f100162ed1716e81a187be3cc04d6acd51ba112 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:43 +0000
Subject: [PATCH 036/225] soh: rename func_800F9474 -> Audio_StopSequence

Name source: zeldaret/oot.
Defined in soh/src/code/audio_seq.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h      | 2 +-
 soh/src/code/audio_general.c | 2 +-
 soh/src/code/audio_seq.c     | 7 ++++---
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 2a3ccadea..288b29f27 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -2159,7 +2159,7 @@ void Audio_ProcessSoundRequests(void);
 void func_800F8F88(void);
 u8 Audio_IsSfxPlaying(u32 sfxId);
 void Audio_ResetSounds(void);
-void func_800F9474(u8, u16);
+void Audio_StopSequence(u8, u16);  // was func_800F9474 [oot]
 void func_800F94FC(u32);
 void Audio_ProcessSeqCmd(u32);
 void Audio_ProcessSeqCmds(void);
diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index fc0d0b9b3..5692e509e 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -4841,7 +4841,7 @@ void Audio_PlaySceneSequence(u16 seqId) {
 
     if (func_800FA0B4(SEQ_PLAYER_BGM_MAIN) != NA_BGM_WINDMILL) {
         if (func_800FA0B4(SEQ_PLAYER_BGM_SUB) == NA_BGM_LONLON) {
-            func_800F9474(SEQ_PLAYER_BGM_SUB, 0);
+            Audio_StopSequence(SEQ_PLAYER_BGM_SUB, 0);
             Audio_QueueCmdS32(0xF8000000, 0);
         }
 
diff --git a/soh/src/code/audio_seq.c b/soh/src/code/audio_seq.c
index bb1d20cca..1c4183aaf 100644
--- a/soh/src/code/audio_seq.c
+++ b/soh/src/code/audio_seq.c
@@ -92,7 +92,8 @@ void Audio_StartSequence(u8 playerIdx, u8 seqId, u8 arg2, u16 fadeTimer) {
     }
 }
 
-void func_800F9474(u8 playerIdx, u16 arg1) {
+// Name from zeldaret/oot, was func_800F9474: queues a stop command and disables the player's active seqId. [oot: https://github.com/zeldaret/oot/blob/main/src/audio/game/sequence.c]
+void Audio_StopSequence(u8 playerIdx, u16 arg1) {
     Audio_QueueCmdS32(0x83000000 | ((u8)playerIdx << 16),
                       (arg1 * (u16)gAudioContext.audioBufferParameters.updatesPerFrame) / 4);
     gActiveSeqs[playerIdx].seqId = NA_BGM_DISABLED;
@@ -159,7 +160,7 @@ void Audio_ProcessSeqCmd(u32 cmd) {
         case 0x1:
             // disable seq player
             fadeTimer = (cmd & 0xFF0000) >> 13;
-            func_800F9474(playerIdx, fadeTimer);
+            Audio_StopSequence(playerIdx, fadeTimer);
             break;
 
         case 0x2:
@@ -222,7 +223,7 @@ void Audio_ProcessSeqCmd(u32 cmd) {
             }
 
             if (found == 0) {
-                func_800F9474(playerIdx, fadeTimer);
+                Audio_StopSequence(playerIdx, fadeTimer);
                 if (sNumSeqRequests[playerIdx] != 0) {
                     Audio_StartSequence(playerIdx, sSeqRequests[playerIdx][0].unk_0, sSeqRequests[playerIdx][0].unk_1,
                                         fadeTimer);
-- 
2.55.0

