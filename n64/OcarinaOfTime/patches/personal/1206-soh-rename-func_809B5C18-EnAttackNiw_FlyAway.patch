+void EnAttackNiw_FlyAway(EnAttackNiw* this, PlayState* play) {
     if (!EnAttackNiw_IsOnScreen(this, play)) {  // was func_809B55EC [LLM:HIGH]
         Actor_Kill(&this->actor);
         return;
@@ -350,7 +351,7 @@ void EnAttackNiw_Update(Actor* thisx, PlayState* play) {
         return;
     }
 
