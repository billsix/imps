From 55f2dc012b9b8441e966d298798b1eed71a04103 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:10:54 +0000
Subject: [PATCH 1331/3799] soh: rename func_80B93DB0 ->
 ObjHsblock_SetupWaitForSwitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sinks the block 105 units below home, disables update culling and installs the waiting action.
Defined in soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c b/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
index 6fa1f06cc..780da9681 100644
--- a/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
+++ b/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
@@ -19,7 +19,8 @@ void func_80B93E5C(ObjHsblock* this, PlayState* play);
 
 // LLM generated name (HIGH), was func_80B93D90: clears actionFunc so the block just sits there; the terminal state for every variant.
 void ObjHsblock_SetupIdle(ObjHsblock* this);  // was func_80B93D90 [LLM:HIGH]
-void func_80B93DB0(ObjHsblock* this);
+// LLM generated name (HIGH), was func_80B93DB0: sinks the block 105 units below home, disables update culling and installs the waiting action.
+void ObjHsblock_SetupWaitForSwitch(ObjHsblock* this);  // was func_80B93DB0 [LLM:HIGH]
 void func_80B93E38(ObjHsblock* this);
 
 const ActorInit Obj_Hsblock_InitVars = {
@@ -94,7 +95,7 @@ void ObjHsblock_Init(Actor* thisx, PlayState* play) {
             if (Flags_GetSwitch(play, (thisx->params >> 8) & 0x3F)) {
                 ObjHsblock_SetupIdle(this);  // was func_80B93D90 [LLM:HIGH]
             } else {
-                func_80B93DB0(this);
+                ObjHsblock_SetupWaitForSwitch(this);  // was func_80B93DB0 [LLM:HIGH]
             }
     }
 
@@ -113,7 +114,7 @@ void ObjHsblock_SetupIdle(ObjHsblock* this) {
     ObjHsblock_SetupAction(this, NULL);
 }
 
-void func_80B93DB0(ObjHsblock* this) {
+void ObjHsblock_SetupWaitForSwitch(ObjHsblock* this) {
     this->dyna.actor.flags |= ACTOR_FLAG_UPDATE_CULLING_DISABLED;
     this->dyna.actor.world.pos.y = this->dyna.actor.home.pos.y - 105.0f;
     ObjHsblock_SetupAction(this, func_80B93DF4);
-- 
