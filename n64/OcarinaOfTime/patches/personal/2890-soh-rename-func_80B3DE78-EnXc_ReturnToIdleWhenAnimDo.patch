From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:42 +0000
Subject: [PATCH 2890/3799] soh: rename func_80B3DE78 ->
 EnXc_ReturnToIdleWhenAnimDone

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns to gSheikIdleAnim and the default draw once the animation ends
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index cf001db3b..d455ab0c8 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -861,7 +861,8 @@ void EnXc_PutHarpAwayWhenAnimDone(EnXc* this, s32 animFinished) {
     }
 }
 
-void func_80B3DE78(EnXc* this, s32 animFinished) {
+// LLM generated name (HIGH), was func_80B3DE78: returns to gSheikIdleAnim and the default draw once the animation ends
+void EnXc_ReturnToIdleWhenAnimDone(EnXc* this, s32 animFinished) {
     if (animFinished) {
         Animation_Change(&this->skelAnime, &gSheikIdleAnim, 1.0f, 0.0f, Animation_GetLastFrame(&gSheikIdleAnim),
                          ANIMMODE_LOOP, 0.0f);
@@ -1042,7 +1043,7 @@ void EnXc_ActionFunc12(EnXc* this, PlayState* play) {
 
     EnXc_BgCheck(this, play);
     EnXc_SetEyePattern(this);
-    func_80B3DE78(this, animFinished);
+    EnXc_ReturnToIdleWhenAnimDone(this, animFinished);  // was func_80B3DE78 [LLM:HIGH]
 }
 
 void EnXc_ActionFunc13(EnXc* this, PlayState* play) {
