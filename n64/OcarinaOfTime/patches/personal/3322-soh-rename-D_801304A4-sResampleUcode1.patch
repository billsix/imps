From c6b479f4ea360abbe990396fb80f726a45d70574 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:29 +0000
Subject: [PATCH 3322/3799] soh: rename D_801304A4 -> sResampleUcode1

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the second such word
Defined in soh/src/code/audio_synthesis.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_synthesis.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_synthesis.c b/soh/src/code/audio_synthesis.c
index f6665532b..74432d4b0 100644
--- a/soh/src/code/audio_synthesis.c
+++ b/soh/src/code/audio_synthesis.c
@@ -33,7 +33,8 @@ Acmd* AudioSynth_FinalResample(Acmd* cmd, NoteSynthesisState* synthState, s32 co
 
 // LLM generated name (GUESS), was D_801304A0: one of four u32 words AudioSynth_FinalResample selects between; they read as packed RSP command words, which the body does not confirm
 u32 sResampleUcode0 = 0x13000000;  // was D_801304A0 [LLM:GUESS]
-u32 D_801304A4 = 0x5CAEC8E2;
+// LLM generated name (GUESS), was D_801304A4: the second such word
+u32 sResampleUcode1 = 0x5CAEC8E2;  // was D_801304A4 [LLM:GUESS]
 u32 D_801304A8 = 0x945CC8E2;
 u32 D_801304AC = 0x94AEC8E2;
 
@@ -1186,7 +1187,7 @@ Acmd* AudioSynth_ProcessEnvelope(Acmd* cmd, NoteSubEu* noteSubEu, NoteSynthesisS
         AudioSynth_EnvSetup2(cmd++, curVolLeft, curVolRight);
         switch (headsetPanSettings) {
             case 1:
-                phi_a1 = D_801304A4;
+                phi_a1 = sResampleUcode1;  // was D_801304A4 [LLM:GUESS]
                 break;
             case 2:
                 phi_a1 = D_801304A8;
