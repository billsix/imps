             sShieldFlashScroll = sBeamDivertTimer = sEnvType = sGroundBlastType = sFreezeState = sTwinrovaBlastType =  // was D_8094C872 [LLM:HIGH]
                 sFixedBlatSeq = sShieldFireCharge = sShieldIceCharge = 0;
 
@@ -2474,7 +2475,7 @@ void BossTw_DeathCSMsgSfx(BossTw* this, PlayState* play) {
