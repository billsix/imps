Subject: [PATCH 1324/3799] soh: rename func_80983FDC ->
 DemoIk_Type2SetupHidden

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the type 2 cue-1 handler: action mode 3 with the invisible draw mode.
Defined in soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c b/soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c
index 1a5b73ec5..a3d65f73e 100644
--- a/soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c
+++ b/soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c
@@ -342,7 +342,8 @@ void DemoIk_Type2PlaySound(DemoIk* this) {
     }
 }
 
-void func_80983FDC(DemoIk* this) {
+// LLM generated name (HIGH), was func_80983FDC: the type 2 cue-1 handler: action mode 3 with the invisible draw mode.
+void DemoIk_Type2SetupHidden(DemoIk* this) {
     this->actionMode = 3;
     this->drawMode = 0;
 }
@@ -370,7 +371,7 @@ void func_80984048(DemoIk* this, PlayState* play) {
         if (nextCsAction != csAction) {
             switch (nextCsAction) {
                 case 1:
-                    func_80983FDC(this);
+                    DemoIk_Type2SetupHidden(this);  // was func_80983FDC [LLM:HIGH]
                     break;
                 case 5:
                     func_80983FEC(this, play);
