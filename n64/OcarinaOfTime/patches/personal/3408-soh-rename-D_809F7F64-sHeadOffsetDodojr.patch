From 076d580742515e453887fb0af200390d5190fc47 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:06 +0000
Subject: [PATCH 3408/3799] soh: rename D_809F7F64 -> sHeadOffsetDodojr

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point EnDodojr_OverrideLimbDraw transforms
Defined in soh/src/overlays/actors/ovl_En_Dodojr/z_en_dodojr.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Dodojr/z_en_dodojr.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Dodojr/z_en_dodojr.c b/soh/src/overlays/actors/ovl_En_Dodojr/z_en_dodojr.c
index 67f81968a..6516990e1 100644
--- a/soh/src/overlays/actors/ovl_En_Dodojr/z_en_dodojr.c
+++ b/soh/src/overlays/actors/ovl_En_Dodojr/z_en_dodojr.c
@@ -624,7 +624,7 @@ void EnDodojr_Update(Actor* thisx, PlayState* play) {
 
 s32 EnDodojr_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s* rot, void* thisx) {
     EnDodojr* this = (EnDodojr*)thisx;
-    Vec3f D_809F7F64 = { 480.0f, 620.0f, 0.0f };
+    Vec3f sHeadOffsetDodojr = { 480.0f, 620.0f, 0.0f };  // was D_809F7F64 [LLM:HIGH]
 
     if (limbIndex == 1) {
         Matrix_Scale((this->rootScale * 0.5f) + 1.0f, this->rootScale + 1.0f, (this->rootScale * 0.5f) + 1.0f,
@@ -632,7 +632,7 @@ s32 EnDodojr_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f
     }
 
     if (limbIndex == 4) {
-        Matrix_MultVec3f(&D_809F7F64, &this->headPos);
+        Matrix_MultVec3f(&sHeadOffsetDodojr, &this->headPos);  // was D_809F7F64 [LLM:HIGH]
     }
 
     return false;
-- 
