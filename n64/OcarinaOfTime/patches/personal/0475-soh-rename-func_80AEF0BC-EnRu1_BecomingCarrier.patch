+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1888,7 +1888,8 @@ void EnRu1_PlaySittingSfx(EnRu1* this) {
     }
 }
 
-s32 func_80AEF0BC(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEF0BC): adopted upstream's name for this address; body verified to match upstream at 0.86. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_BecomingCarrier(EnRu1* this, PlayState* play) {
     s32 frameCount;
 
     if (Flags_GetInfTable(INFTABLE_RUTO_IN_JJ_TALK_FIRST_TIME)) {
@@ -1909,7 +1910,7 @@ void func_80AEF170(EnRu1* this, PlayState* play, s32 cond) {
 }
 
 void func_80AEF188(EnRu1* this, PlayState* play) {
-    if (EnRu1_MessageShouldAdvance(play) && !func_80AEF0BC(this, play)) {
