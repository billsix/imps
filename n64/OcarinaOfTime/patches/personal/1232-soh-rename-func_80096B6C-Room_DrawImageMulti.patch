From 3e5899e01aafae6648e8187282ac075e11827192 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:02:28 +0000
Subject: [PATCH 1232/3799] soh: rename func_80096B6C -> Room_DrawImageMulti

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment above it reads "Room Draw Polygon Type 1 - Multi Format".
Defined in soh/src/code/z_room.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_room.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_room.c b/soh/src/code/z_room.c
index 80a238c40..351dd61cc 100644
--- a/soh/src/code/z_room.c
+++ b/soh/src/code/z_room.c
@@ -446,7 +446,8 @@ BgImage* func_80096A74(PolygonType1* polygon1, PlayState* play) {
 }
 
 // Room Draw Polygon Type 1 - Multi Format
-void func_80096B6C(PlayState* play, Room* room, u32 flags) {
+// LLM generated name (HIGH), was func_80096B6C: the in-tree comment above it reads "Room Draw Polygon Type 1 - Multi Format".
+void Room_DrawImageMulti(PlayState* play, Room* room, u32 flags) {
     Camera* camera;
     Gfx* spA8;
     PolygonType1* polygon1;
@@ -512,7 +513,7 @@ void Room_DrawImage(PlayState* play, Room* room, u32 flags) {
     if (polygon1->format == 1) {
         Room_DrawImageSingle(play, room, flags);  // was func_80096680 [LLM:HIGH]
     } else if (polygon1->format == 2) {
-        func_80096B6C(play, room, flags);
+        Room_DrawImageMulti(play, room, flags);  // was func_80096B6C [LLM:HIGH]
     } else {
         LOG_HUNGUP_THREAD();
     }
