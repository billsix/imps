From eee63bcbf4d2a17e7bf007159397739f331fc390 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:19:19 +0000
Subject: [PATCH 2261/3799] soh: rename D_80B0F074 -> sColChkInfoInit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the CollisionCheckInfoInit2 handed to CollisionCheck_SetInfo2 in Init
Defined in soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
index d17402818..d30d5b806 100644
--- a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
+++ b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
@@ -59,7 +59,8 @@ static ColliderJntSphInit sJntSphInit = {
     sJntSphItemsInit,
 };
 
-static CollisionCheckInfoInit2 D_80B0F074 = { 1, 2, 25, 25, MASS_IMMOVABLE };
+// LLM generated name (HIGH), was D_80B0F074: the CollisionCheckInfoInit2 handed to CollisionCheck_SetInfo2 in Init
+static CollisionCheckInfoInit2 sColChkInfoInit = { 1, 2, 25, 25, MASS_IMMOVABLE };  // was D_80B0F074 [LLM:HIGH]
 
 typedef enum {
     /* 0 */ ENSW_ANIM_0,
@@ -255,7 +256,7 @@ void EnSw_Init(Actor* thisx, PlayState* play) {
     ActorShape_Init(&thisx->shape, 0.0f, NULL, 0.0f);
     Collider_InitJntSph(play, &this->collider);
     Collider_SetJntSph(play, &this->collider, &this->actor, &sJntSphInit, this->sphs);
-    CollisionCheck_SetInfo2(&this->actor.colChkInfo, DamageTable_Get(0xE), &D_80B0F074);
+    CollisionCheck_SetInfo2(&this->actor.colChkInfo, DamageTable_Get(0xE), &sColChkInfoInit);  // was D_80B0F074 [LLM:HIGH]
     this->actor.scale.x = 0.02f;
 
     if (((thisx->params & 0xE000) >> 0xD) == 0) {
