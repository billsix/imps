From 9fb4690c752a2f37f68547b2a8383a2aef471b37 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:34 +0000
Subject: [PATCH 399/488] soh: rename D_8094A9A4 -> sTwinBeamOriginOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hand-space point the beam origin is recorded from; named Twin because sBeamOriginOffset is taken by En_Vm
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index d1987926b..60bacb808 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -3476,7 +3476,7 @@ static void* sEyeTextures[] = {
 };
 
 void BossTw_Draw(Actor* thisx, PlayState* play2) {
-    static Vec3f D_8094A9A4 = { 0.0f, 200.0f, 2000.0f };
+    static Vec3f sTwinBeamOriginOffset = { 0.0f, 200.0f, 2000.0f };  // was D_8094A9A4 [LLM:HIGH]
     PlayState* play = play2;
     BossTw* this = (BossTw*)thisx;
     Player* player = GET_PLAYER(play);
@@ -3550,7 +3550,7 @@ void BossTw_Draw(Actor* thisx, PlayState* play2) {
             BossTw_DrawHalo(&this->actor, play);  // was func_80943028 [LLM:HIGH]
         } else {
             BossTw_DrawSpawnPortal(this, play);  // was func_809426F0 [LLM:HIGH]
-            Matrix_MultVec3f(&D_8094A9A4, &this->beamOrigin);
+            Matrix_MultVec3f(&sTwinBeamOriginOffset, &this->beamOrigin);  // was D_8094A9A4 [LLM:HIGH]
             BossTw_DrawBeam(&this->actor, play);  // was func_80942C70 [LLM:HIGH]
         }
     }
