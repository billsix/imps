Date: Mon, 7 Sep 2026 23:12:55 +0000
Subject: [PATCH 2121/3799] soh: rename func_808B8EE0 -> BgSpot18Obj_SetupSlide

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: zeroes the statue's rotation and velocity and installs the sliding action
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
index eebc640af..04a58bd46 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
@@ -35,7 +35,8 @@ void BgSpot18Obj_DoNothing(BgSpot18Obj* this, PlayState* play);  // was func_808
 void BgSpot18Obj_SetupWaitForPush(BgSpot18Obj* this);  // was func_808B8E64 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808B8E7C: requires 20 uninterrupted frames of the player pushing before the statue starts sliding
 void BgSpot18Obj_WaitForPush(BgSpot18Obj* this, PlayState* play);  // was func_808B8E7C [LLM:HIGH]
-void func_808B8EE0(BgSpot18Obj* this);
+// LLM generated name (HIGH), was func_808B8EE0: zeroes the statue's rotation and velocity and installs the sliding action
+void BgSpot18Obj_SetupSlide(BgSpot18Obj* this);  // was func_808B8EE0 [LLM:HIGH]
 void func_808B8F08(BgSpot18Obj* this, PlayState* play);
 void func_808B9030(BgSpot18Obj* this);
 void func_808B9040(BgSpot18Obj* this, PlayState* play);
@@ -238,7 +239,7 @@ void BgSpot18Obj_SetupWaitForPush(BgSpot18Obj* this) {
 void BgSpot18Obj_WaitForPush(BgSpot18Obj* this, PlayState* play) {
     if (this->dyna.unk_150 < -0.001f) {
         if (this->unk_168 <= 0) {
-            func_808B8EE0(this);
+            BgSpot18Obj_SetupSlide(this);  // was func_808B8EE0 [LLM:HIGH]
         }
     } else {
         this->unk_168 = 20;
@@ -246,7 +247,7 @@ void BgSpot18Obj_WaitForPush(BgSpot18Obj* this, PlayState* play) {
     BgSpot18Obj_StopPlayerPush(this, play);  // was func_808B8E20 [LLM:HIGH]
 }
 
-void func_808B8EE0(BgSpot18Obj* this) {
+void BgSpot18Obj_SetupSlide(BgSpot18Obj* this) {
     this->actionFunc = func_808B8F08;
     this->dyna.actor.world.rot.y = 0;
     this->dyna.actor.speedXZ = 0.0f;
