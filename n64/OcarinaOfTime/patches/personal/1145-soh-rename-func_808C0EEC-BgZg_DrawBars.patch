From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:52:28 +0000
Subject: [PATCH 1145/3799] soh: rename func_808C0EEC -> BgZg_DrawBars

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sDrawFuncs[0]: draws gTowerCollapseBarsDL opaquely.
Defined in soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
index 7b6c32e46..05713c184 100644
--- a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
+++ b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
@@ -25,7 +25,8 @@ s32 BgZg_GetVariant(BgZg* this);  // was func_808C0CC8 [LLM:GUESS]
 void BgZg_WaitForSwitch(BgZg* this, PlayState* play);  // was func_808C0CD4 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808C0D08: sActionFuncs[1]: lifts the bars at a fixed rate and kills the actor once they are about 240 units above home.
 void BgZg_Rise(BgZg* this, PlayState* play);  // was func_808C0D08 [LLM:HIGH]
-void func_808C0EEC(BgZg* this, PlayState* play);
+// LLM generated name (HIGH), was func_808C0EEC: sDrawFuncs[0]: draws gTowerCollapseBarsDL opaquely.
+void BgZg_DrawBars(BgZg* this, PlayState* play);  // was func_808C0EEC [LLM:HIGH]
 
 static BgZgActionFunc sActionFuncs[] = {
     BgZg_WaitForSwitch,  // was func_808C0CD4 [LLM:HIGH]
@@ -37,7 +38,7 @@ static InitChainEntry sInitChain[] = {
 };
 
 static BgZgDrawFunc sDrawFuncs[] = {
-    func_808C0EEC,
+    BgZg_DrawBars,  // was func_808C0EEC [LLM:HIGH]
 };
 
 const ActorInit Bg_Zg_InitVars = {
@@ -125,7 +126,7 @@ void BgZg_Init(Actor* thisx, PlayState* play) {
     }
 }
 
-void func_808C0EEC(BgZg* this, PlayState* play) {
+void BgZg_DrawBars(BgZg* this, PlayState* play) {
     GraphicsContext* localGfxCtx = play->state.gfxCtx;
 
     OPEN_DISPS(localGfxCtx);
