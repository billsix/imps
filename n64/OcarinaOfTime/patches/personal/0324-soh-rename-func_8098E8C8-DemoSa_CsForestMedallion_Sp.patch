From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:32 +0000
Subject: [PATCH 324/784] soh: rename func_8098E8C8 ->
 DemoSa_CsForestMedallion_SpawnMedallion

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.90.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 677edf19c..2faf85388 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -236,7 +236,8 @@ void DemoSa_CsForestMedallion_SpawnDoorWarp(DemoSa* this, PlayState* play) {
     Actor_SpawnAsChild(&play->actorCtx, &this->actor, play, ACTOR_DOOR_WARP1, posX, posY, posZ, 0, 0, 0, WARP_SAGES);
 }
 
-void func_8098E8C8(DemoSa* this, PlayState* play) {
+// Name from zeldaret/oot (was func_8098E8C8): adopted upstream's name for this address; body verified to match upstream at 0.90. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_CsForestMedallion_SpawnMedallion(DemoSa* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
     f32 posX = player->actor.world.pos.x;
     f32 posY = player->actor.world.pos.y + 80.0f;
@@ -316,7 +317,7 @@ void func_8098EB6C(DemoSa* this, PlayState* play) {
         npcAction = play->csCtx.npcActions[6];
         if ((npcAction != NULL) && (npcAction->action == 2)) {
             this->action = 6;
-            func_8098E8C8(this, play);
+            DemoSa_CsForestMedallion_SpawnMedallion(this, play);
         }
     }
 }
