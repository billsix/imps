Subject: [PATCH 2623/3799] soh: rename func_80ACD1C4 -> EnOwl_GetCueWeight

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns the cue's progress from 0 to 1
Defined in soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
index 0431543ec..27f7e3dfe 100644
--- a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
+++ b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
@@ -1394,7 +1394,8 @@ void EnOwl_SetPosFromCue(EnOwl* this, PlayState* play, s32 idx) {
     this->actor.shape.rot.z = play->csCtx.npcActions[idx]->urot.z;
 }
 
-f32 func_80ACD1C4(PlayState* play, s32 idx) {
+// LLM generated name (HIGH), was func_80ACD1C4: returns the cue's progress from 0 to 1
+f32 EnOwl_GetCueWeight(PlayState* play, s32 idx) {
     f32 ret = Environment_LerpWeight(play->csCtx.npcActions[idx]->endFrame, play->csCtx.npcActions[idx]->startFrame,
                                      play->csCtx.frames);
 
@@ -1418,7 +1419,7 @@ void func_80ACD220(EnOwl* this, Vec3f* arg1, f32 arg2) {
 void func_80ACD2CC(EnOwl* this, PlayState* play) {
     Vec3f pos;
     s32 angle;
-    f32 t = func_80ACD1C4(play, 7);
+    f32 t = EnOwl_GetCueWeight(play, 7);  // was func_80ACD1C4 [LLM:HIGH]
 
     pos.x = play->csCtx.npcActions[7]->startPos.x;
     pos.y = play->csCtx.npcActions[7]->startPos.y;
@@ -1453,7 +1454,7 @@ void func_80ACD2CC(EnOwl* this, PlayState* play) {
 void func_80ACD4D4(EnOwl* this, PlayState* play) {
     Vec3f pos;
     Vec3f endPosf;
-    f32 temp_ret = func_80ACD1C4(play, 7);
+    f32 temp_ret = EnOwl_GetCueWeight(play, 7);  // was func_80ACD1C4 [LLM:HIGH]
 
     pos.x = play->csCtx.npcActions[7]->startPos.x;
     pos.y = play->csCtx.npcActions[7]->startPos.y;
