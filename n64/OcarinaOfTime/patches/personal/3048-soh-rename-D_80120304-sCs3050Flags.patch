From 37d4ade8619e5b7994c275c25f5ab180e06ca2d3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:35 +0000
Subject: [PATCH 3048/3799] soh: rename D_80120304 -> sCs3050Flags

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the flags argument, ORed with 0x2000 at the call
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 121ef26fa..7452bb957 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -496,7 +496,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
         case 3050:
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Player_SetCsActionWithHaltedActors(play, &player->actor, 5);
-            OnePointCutscene_SetCsCamPoints(csCam, D_80120304 | 0x2000, sCs3050Duration, sCs3050AtPoints, sCs3050EyePoints);  // was D_8012013C [LLM:HIGH]
+            OnePointCutscene_SetCsCamPoints(csCam, sCs3050Flags | 0x2000, sCs3050Duration, sCs3050AtPoints, sCs3050EyePoints);  // was D_8012013C [LLM:HIGH]
             Sfx_PlaySfxCentered(NA_SE_SY_CORRECT_CHIME);
             OnePointCutscene_Vec3sToVec3f(&mainCam->at, &sCs3050AtPoints[sCs3050PointCount - 2].pos);  // was D_8012013C [LLM:HIGH]
             OnePointCutscene_Vec3sToVec3f(&mainCam->eye, &sCs3050EyePoints[sCs3050PointCount - 2].pos);  // was D_8012021C [LLM:HIGH]
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 8b9a85c22..73729dcae 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -31,7 +31,8 @@ static CutsceneCameraPoint sCs3050EyePoints[14] = {  // was D_8012021C [LLM:HIGH
 static s16 sCs3050PointCount = 13;  // was D_801202FC [LLM:HIGH]
 // LLM generated name (HIGH), was D_80120300: the duration argument of that same call
 static s16 sCs3050Duration = 210;  // was D_80120300 [LLM:HIGH]
-static s16 D_80120304 = 0;
+// LLM generated name (HIGH), was D_80120304: the flags argument, ORed with 0x2000 at the call
+static s16 sCs3050Flags = 0;  // was D_80120304 [LLM:HIGH]
 
 static CutsceneCameraPoint D_80120308[9] = {
     { CS_CMD_CONTINUE, 0, 10, 40.0f, { 0, 4, 0 } },  { CS_CMD_CONTINUE, 0, 10, 40.000004f, { 0, 4, 0 } },
-- 
2.55.0

