From b8f760774583fee152b76a5aa1be5bd62f8e252d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:37 +0000
Subject: [PATCH 3073/3799] soh: rename D_80120E64 -> sCs2220KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 2220 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 9cd701ac1..0d4b39e5f 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -224,7 +224,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Quake_SetCountdown(i, 9999);
             break;
         case 2220:
-            csInfo->keyFrames = D_80120E64;
+            csInfo->keyFrames = sCs2220KeyFrames;  // was D_80120E64 [LLM:HIGH]
             csInfo->keyFrameCnt = 8;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 3f3658c46..c35337725 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -203,7 +203,8 @@ static OnePointCsFull sCs2280KeyFrames[7] = {  // was D_80120D4C [LLM:HIGH]
     { 0x98, 0xFF, 0x0000, 1, 0, 50.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80120E64[8] = {
+// LLM generated name (HIGH), was D_80120E64: the keyframe set one-point cutscene 2220 installs
+static OnePointCsFull sCs2220KeyFrames[8] = {  // was D_80120E64 [LLM:HIGH]
     { 0x41, 0x01, 0x2142, 20, 0, 50.0f, 1.0f, { -25.0f, 20.0f, 0.0f }, { 0.0f, 0.0f, 5.0f } },
     { 0x4F, 0xFF, 0x0000, 80, 0, 50.0f, 1.0f, { -25.0f, 20.0f, 0.0f }, { 0.0f, 0.0f, 5.0f } },
     { 0x4B, 0xFF, 0x4242, 8, 0, 60.0f, 0.1f, { -25.0f, 20.0f, 0.0f }, { 0.0f, 0.0f, 5.0f } },
-- 
