From 964ff071cb97b35561edf145e62e295541931303 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:38 +0000
Subject: [PATCH 2794/3799] soh: rename D_8015BBF0 -> sNearestTargetDistSq

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the best weighted distance found so far while searching for a Z-target
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 89dcee30a..49ffd65d8 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -3579,7 +3579,8 @@ s32 Attention_ActorOnScreen(PlayState* play, Actor* actor) {
 
 Actor* D_8015BBE8;
 Actor* D_8015BBEC;
-f32 D_8015BBF0;
+// LLM generated name (HIGH), was D_8015BBF0: the best weighted distance found so far while searching for a Z-target
+f32 sNearestTargetDistSq;  // was D_8015BBF0 [LLM:HIGH]
 f32 sbgmEnemyDistSq;
 s32 D_8015BBF8;
 s16 D_8015BBFC;
@@ -3613,7 +3614,7 @@ void Attention_FindActorInCategory(PlayState* play, ActorContext* actorCtx, Play
 
             if (actor != sp84) {
                 var = Attention_WeightedDistToPlayerSq(actor, player, D_8015BBFC);
-                if ((var < D_8015BBF0) && Attention_ActorIsInRange(actor, var) &&
+                if ((var < sNearestTargetDistSq) && Attention_ActorIsInRange(actor, var) &&  // was D_8015BBF0 [LLM:HIGH]
                     Attention_ActorOnScreen(play, actor) &&
                     (!BgCheck_CameraLineTest1(&play->colCtx, &player->actor.focus.pos, &actor->focus.pos, &sp70, &sp80,
                                               1, 1, 1, 1, &sp7C) ||
@@ -3625,7 +3626,7 @@ void Attention_FindActorInCategory(PlayState* play, ActorContext* actorCtx, Play
                         }
                     } else {
                         D_8015BBE8 = actor;
-                        D_8015BBF0 = var;
+                        sNearestTargetDistSq = var;  // was D_8015BBF0 [LLM:HIGH]
                     }
                 }
             }
@@ -3645,7 +3646,7 @@ Actor* Attention_FindActor(PlayState* play, ActorContext* actorCtx, Actor** acto
     u8* entry;
 
     D_8015BBE8 = D_8015BBEC = NULL;
-    D_8015BBF0 = sbgmEnemyDistSq = FLT_MAX;
+    sNearestTargetDistSq = sbgmEnemyDistSq = FLT_MAX;  // was D_8015BBF0 [LLM:HIGH]
     D_8015BBF8 = 0x7FFFFFFF;
 
     if (!Player_InCsMode(play)) {
