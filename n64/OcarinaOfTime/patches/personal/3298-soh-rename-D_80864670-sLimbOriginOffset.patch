From 073331b62d390477d26d3c36dcff80d22644a303 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:56 +0000
Subject: [PATCH 3298/3799] soh: rename D_80864670 -> sLimbOriginOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the zero vector several limbs record their own positions from
Defined in soh/src/overlays/actors/ovl_En_Test/z_en_test.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Test/z_en_test.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Test/z_en_test.c b/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
index ec92a4e8b..974e4279a 100644
--- a/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
+++ b/soh/src/overlays/actors/ovl_En_Test/z_en_test.c
@@ -1867,7 +1867,7 @@ void EnTest_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
     static Vec3f unused1 = { 1100.0f, -700.0f, 0.0f };
     static Vec3f D_80864658 = { 300.0f, 0.0f, 0.0f };
     static Vec3f D_80864664 = { 3400.0f, 0.0f, 0.0f };
-    static Vec3f D_80864670 = { 0.0f, 0.0f, 0.0f };
+    static Vec3f sLimbOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_80864670 [LLM:HIGH]
     static Vec3f D_8086467C = { 7000.0f, 1000.0f, 0.0f };
     static Vec3f D_80864688 = { 3000.0f, -2000.0f, -1000.0f };
     static Vec3f D_80864694 = { 3000.0f, -2000.0f, 1000.0f };
@@ -1898,7 +1898,7 @@ void EnTest_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
                                  &this->swordCollider.dim.quad[3]);
 
         Matrix_MultVec3f(&D_80864664, &sp70);
-        Matrix_MultVec3f(&D_80864670, &sp64);
+        Matrix_MultVec3f(&sLimbOriginOffset, &sp64);  // was D_80864670 [LLM:HIGH]
 
         if ((this->meleeWeaponState >= 1) &&
             ((this->actor.params != STALFOS_TYPE_INVISIBLE) || play->actorCtx.lensActive)) {
@@ -1909,7 +1909,7 @@ void EnTest_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
         }
 
     } else if ((limbIndex == STALFOS_LIMB_SHIELD) && (this->unk_7DE != 0)) {
-        Matrix_MultVec3f(&D_80864670, &sp64);
+        Matrix_MultVec3f(&sLimbOriginOffset, &sp64);  // was D_80864670 [LLM:HIGH]
 
         this->shieldCollider.dim.pos.x = sp64.x;
         this->shieldCollider.dim.pos.y = sp64.y;
@@ -1959,7 +1959,7 @@ void EnTest_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
         }
 
         if (bodyPart >= 0) {
-            Matrix_MultVec3f(&D_80864670, &sp50);
+            Matrix_MultVec3f(&sLimbOriginOffset, &sp50);  // was D_80864670 [LLM:HIGH]
 
             this->bodyPartsPos[bodyPart].x = sp50.x;
             this->bodyPartsPos[bodyPart].y = sp50.y;
-- 
