Subject: [PATCH 2733/3799] soh: rename func_80981D20 -> DemoGt_SpinUpParams23

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: accelerates the params 23 piece's spin up to its kREG-tunable cap
Defined in soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c b/soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c
index b276ee4b6..820748316 100644
--- a/soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c
+++ b/soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c
@@ -1580,7 +1580,8 @@ void DemoGt_PlayBreakSfxParams23(DemoGt* this, PlayState* play) {
     }
 }
 
-void func_80981D20(DemoGt* this) {
+// LLM generated name (HIGH), was func_80981D20: accelerates the params 23 piece's spin up to its kREG-tunable cap
+void DemoGt_SpinUpParams23(DemoGt* this) {
     f32 temp = this->unk_172;
 
     this->unk_174 = temp * ((kREG(64) * 0.001f) + 0.048f) + (kREG(76) + 100.0f);
@@ -1604,7 +1605,7 @@ void DemoGt_Update6(DemoGt* this, PlayState* play) {
 }
 
 void DemoGt_Update14(DemoGt* this, PlayState* play) {
-    func_80981D20(this);
+    DemoGt_SpinUpParams23(this);  // was func_80981D20 [LLM:HIGH]
     DemoGt_MoveAndShake(this, play, 7);  // was func_8097ED64 [LLM:HIGH]
     DemoGt_PlayBreakSfxParams23(this, play);  // was func_80981CEC [LLM:HIGH]
 }
