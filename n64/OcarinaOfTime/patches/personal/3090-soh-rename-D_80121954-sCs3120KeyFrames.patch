From 8c35c97e5be99da3ceeb4f8a942638b278d7f497 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:39 +0000
Subject: [PATCH 3090/3799] soh: rename D_80121954 -> sCs3120KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 3120 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 7ad79f755..c9724f407 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -519,7 +519,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Quake_SetCountdown(i, 200);
             break;
         case 3120:
-            csInfo->keyFrames = D_80121954[-(timer + 101)];
+            csInfo->keyFrames = sCs3120KeyFrames[-(timer + 101)];  // was D_80121954 [LLM:HIGH]
             csCam->timer = 100;
             csCam->unk_14C |= 2;
             csInfo->keyFrameCnt = 2;
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index ec492fe82..8f509f563 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -347,7 +347,8 @@ static OnePointCsFull sCs3060KeyFrames[2] = {  // was D_80121904 [LLM:HIGH]
     { 0x11, 0xFF, 0x0000, 1, -1, -1.0f, -1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80121954[3][2] = {
+// LLM generated name (HIGH), was D_80121954: the keyframe set one-point cutscene 3120 installs
+static OnePointCsFull sCs3120KeyFrames[3][2] = {  // was D_80121954 [LLM:HIGH]
     {
         { 0x0F, 0xFF, 0x0101, 20, 5, 60.0f, 1.0f, { -700.0f, 940.0f, 300.0f }, { -765.0f, 1000.0f, 335.0f } },
         { 0x03, 0xFF, 0x0101, 80, -10, 70.0f, 0.1f, { -540.0f, 875.0f, 245.0f }, { -585.0f, 900.0f, 335.0f } },
-- 
