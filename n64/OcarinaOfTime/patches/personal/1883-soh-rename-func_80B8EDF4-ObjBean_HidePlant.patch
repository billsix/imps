Date: Mon, 7 Sep 2026 22:50:06 +0000
Subject: [PATCH 1883/3799] soh: rename func_80B8EDF4 -> ObjBean_HidePlant

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: zeroes the growth angles and scales the plant away entirely.
Defined in soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
index cfd9a8b7e..c38403df9 100644
--- a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
+++ b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
@@ -193,7 +193,8 @@ void ObjBean_UpdatePosition(ObjBean* this) {
         (Math_SinS((s16)(this->unk_1B6.z * 2)) * 2100.0f) + ((f32)this->dyna.actor.home.rot.y + (temp_f20 * 1000.0f));
 }
 
-void func_80B8EDF4(ObjBean* this) {
+// LLM generated name (HIGH), was func_80B8EDF4: zeroes the growth angles and scales the plant away entirely.
+void ObjBean_HidePlant(ObjBean* this) {
     this->unk_1B6.x = this->unk_1B6.y = this->unk_1B6.z = 0;
 
     Actor_SetScale(&this->dyna.actor, 0.0f);
@@ -841,7 +842,7 @@ void func_80B90970(ObjBean* this) {
     this->actionFunc = func_80B909B0;
     ObjBean_SetDrawMode(this, 0);
     this->timer = 100;
-    func_80B8EDF4(this);
+    ObjBean_HidePlant(this);  // was func_80B8EDF4 [LLM:HIGH]
 }
 
 void func_80B909B0(ObjBean* this, PlayState* play) {
