From 7db1fcb4292fd0e913124b1f7f3d6caead8fa4e4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:40 +0000
Subject: [PATCH 3104/3799] soh: rename D_801225D4 -> sCs4100KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 4100 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 4 ++--
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 2c1e12d2e..22455fede 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -836,8 +836,8 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Quake_SetCountdown(i, 20);
             break;
         case 4100:
-            csInfo->keyFrames = D_801225D4;
-            csInfo->keyFrameCnt = ARRAY_COUNT(D_801225D4);
+            csInfo->keyFrames = sCs4100KeyFrames;  // was D_801225D4 [LLM:HIGH]
+            csInfo->keyFrameCnt = ARRAY_COUNT(sCs4100KeyFrames);  // was D_801225D4 [LLM:HIGH]
 
             player->actor.shape.rot.y = player->actor.world.rot.y = player->yaw = 0x3FFC;
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index a1d8c80a8..0adf449ef 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -489,7 +489,8 @@ static OnePointCsFull sCs3430KeyFrames[7] = {  // was D_801224BC [LLM:HIGH]
     { 0x12, 0xFF, 0x0000, 1, -1, -1.0f, -1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_801225D4[5] = {
+// LLM generated name (HIGH), was D_801225D4: the keyframe set one-point cutscene 4100 installs
+static OnePointCsFull sCs4100KeyFrames[5] = {  // was D_801225D4 [LLM:HIGH]
     { 0x0F, 0x08, 0x0101, 1, 0, 50.0f, 1.0f, { 4100.0f, 1200.0f, -1400.0f }, { 3900.0f, 1100.0f, -1400.0f } },
     { 0x01, 0x3B, 0x0101, 60, 4, 50.0f, 0.94f, { 4100.0f, 965.0f, -1385.0f }, { 3790.0f, 825.0f, -1325.0f } },
     { 0x03, 0xFF, 0x0101, 90, -5, 130.0f, 0.02f, { 4100.0f, 975.0f, -1375.0f }, { 3735.0f, 715.0f, -1325.0f } },
-- 
