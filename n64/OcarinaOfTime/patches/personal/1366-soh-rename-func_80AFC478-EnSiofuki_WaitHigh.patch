From 07bb098d87a14d7fb9031787e046a5bff707ab6d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:13:14 +0000
Subject: [PATCH 1366/3799] soh: rename func_80AFC478 -> EnSiofuki_WaitHigh

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the lowering type's idle at full height: waits for its switch flag, then starts the pause and the one-point cutscene that shows the water dropping.
Defined in soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c b/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
index 5a2db8af0..3ae2f6004 100644
--- a/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
+++ b/soh/src/overlays/actors/ovl_En_Siofuki/z_en_siofuki.c
@@ -18,7 +18,8 @@ void EnSiofuki_Draw(Actor* thisx, PlayState* play);
 // LLM generated name (HIGH), was func_80AFC34C: the raising type's idle at height 10: waits for its switch flag, then targets full height and arms the 300-frame timer.
 void EnSiofuki_WaitLow(EnSiofuki* this, PlayState* play);  // was func_80AFC34C [LLM:HIGH]
 void func_80AFC544(EnSiofuki* this, PlayState* play);
-void func_80AFC478(EnSiofuki* this, PlayState* play);
+// LLM generated name (HIGH), was func_80AFC478: the lowering type's idle at full height: waits for its switch flag, then starts the pause and the one-point cutscene that shows the water dropping.
+void EnSiofuki_WaitHigh(EnSiofuki* this, PlayState* play);  // was func_80AFC478 [LLM:HIGH]
 
 const ActorInit En_Siofuki_InitVars = {
     ACTOR_EN_SIOFUKI,
@@ -96,7 +97,7 @@ void EnSiofuki_Init(Actor* thisx, PlayState* play) {
             this->actionFunc = func_80AFC544;
         } else {
             this->targetHeight = this->currentHeight;
-            this->actionFunc = func_80AFC478;
+            this->actionFunc = EnSiofuki_WaitHigh;  // was func_80AFC478 [LLM:HIGH]
         }
     }
 }
@@ -207,7 +208,7 @@ void EnSiofuki_Active(EnSiofuki* this, PlayState* play) {
                 break;
             case EN_SIOFUKI_LOWERING:
                 this->targetHeight = this->maxHeight;
-                this->actionFunc = func_80AFC478;
+                this->actionFunc = EnSiofuki_WaitHigh;  // was func_80AFC478 [LLM:HIGH]
                 break;
         }
     } else {
@@ -255,7 +256,7 @@ void EnSiofuki_Delay(EnSiofuki* this, PlayState* play) {
     }
 }
 
-void func_80AFC478(EnSiofuki* this, PlayState* play) {
+void EnSiofuki_WaitHigh(EnSiofuki* this, PlayState* play) {
     EnSiofuki_UpdateOscillation(this, play);  // was func_80AFBDC8 [LLM:HIGH]
     EnSiofuki_PushPlayer(this, play);  // was func_80AFBE8C [LLM:HIGH]
     EnSiofuki_ApproachTargetHeight(this, play);  // was func_80AFC1D0 [LLM:HIGH]
