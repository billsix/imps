Subject: [PATCH 2694/3799] soh: rename func_8097F1D8 -> DemoGt_SpinUpParams0

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: accelerates the params 0 piece's spin up to its kREG-tunable cap
Defined in soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c b/soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c
index 26c5661cd..14b58b9c8 100644
--- a/soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c
+++ b/soh/src/overlays/actors/ovl_Demo_Gt/z_demo_gt.c
@@ -562,7 +562,8 @@ void DemoGt_SpawnEffectsParams0(DemoGt* this, PlayState* play) {
     DemoGt_SpawnDustParams0B(this, play);  // was func_8097F0AC [LLM:HIGH]
 }
 
-void func_8097F1D8(DemoGt* this) {
+// LLM generated name (HIGH), was func_8097F1D8: accelerates the params 0 piece's spin up to its kREG-tunable cap
+void DemoGt_SpinUpParams0(DemoGt* this) {
     f32 temp_v0 = this->unk_172;
 
     this->unk_174 = (temp_v0 * ((kREG(64) * 0.001f) + 0.048f)) + (kREG(72) + 10.0f);
@@ -629,7 +630,7 @@ void DemoGt_Update0(DemoGt* this, PlayState* play) {
 
 void DemoGt_Update8(DemoGt* this, PlayState* play) {
     func_8097F280(this, play);
-    func_8097F1D8(this);
+    DemoGt_SpinUpParams0(this);  // was func_8097F1D8 [LLM:HIGH]
     DemoGt_MoveAndShake(this, play, 1);  // was func_8097ED64 [LLM:HIGH]
     DemoGt_SpawnEffectsParams0(this, play);  // was func_8097F19C [LLM:HIGH]
     DemoGt_PlayEarthquakeSfx();
