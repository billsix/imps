From 37c22f905a0819eaab5491ce7dde7105ff491949 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:33:25 +0000
Subject: [PATCH 1657/3799] soh: rename func_80082850 ->
 Interface_ApplyHudVisibility

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: applies the queued HUD visibility mode, raising or clamping each button, heart, magic and minimap alpha to match it.
Defined in soh/src/code/z_parameter.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_parameter.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_parameter.c b/soh/src/code/z_parameter.c
index 4bcbc9f96..e7e69d320 100644
--- a/soh/src/code/z_parameter.c
+++ b/soh/src/code/z_parameter.c
@@ -358,7 +358,8 @@ void Interface_ClampButtonAlphas(PlayState* play, s16 maxAlpha, s16 alpha) {
     }
 }
 
-void func_80082850(PlayState* play, s16 maxAlpha) {
+// LLM generated name (HIGH), was func_80082850: applies the queued HUD visibility mode, raising or clamping each button, heart, magic and minimap alpha to match it.
+void Interface_ApplyHudVisibility(PlayState* play, s16 maxAlpha) {
     InterfaceContext* interfaceCtx = &play->interfaceCtx;
     s16 alpha = 255 - maxAlpha;
 
@@ -6577,7 +6578,7 @@ void Interface_Update(PlayState* play) {
                 alpha = 0;
             }
 
-            func_80082850(play, alpha);
+            Interface_ApplyHudVisibility(play, alpha);  // was func_80082850 [LLM:HIGH]
             gSaveContext.hudVisibilityModeTimer++;
 
             if (alpha == 0) {
@@ -6648,7 +6649,7 @@ void Interface_Update(PlayState* play) {
             break;
         case 52:
             gSaveContext.nextHudVisibilityMode = 1;
-            func_80082850(play, 0);
+            Interface_ApplyHudVisibility(play, 0);  // was func_80082850 [LLM:HIGH]
             gSaveContext.nextHudVisibilityMode = 0;
         default:
             break;
