From 15ae3a79dc4602edc7a87dadbf760f320e3ac106 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:17 +0000
Subject: [PATCH 218/488] soh: rename D_808123F0 -> gKeyboardCharactersPal

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: s16 table mapping the name-entry grid index to a character code; read only by z_file_nameset_PAL.c, both to index font->fontBuf and to store into filename[]. Sits alongside SoH's gKeyboardCharacters{Hiragana,Katakana,Alphanumeric}.
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_data.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../overlays/gamestates/ovl_file_choose/file_choose.h  |  2 +-
 .../gamestates/ovl_file_choose/z_file_nameset_NES.c    |  2 +-
 .../gamestates/ovl_file_choose/z_file_nameset_PAL.c    | 10 +++++-----
 .../gamestates/ovl_file_choose/z_file_nameset_data.c   |  3 ++-
 4 files changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h b/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h
index 5f6e3f202..62084c095 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h
+++ b/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h
@@ -233,7 +233,7 @@ u8 HandleMouseCursor(FileChooseContext* thisx, Input* input, int minx, int miny,
 Vec2f HandleMouseCursorSplit(FileChooseContext* thisx, Input* input, int minx, int miny, int maxx, int maxy, int countx,
                              int county);
 
-extern s16 D_808123F0[];
+extern s16 gKeyboardCharactersPal[];  // was D_808123F0 [LLM:HIGH]
 
 // #region SOH [NTSC]
 
diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c
index 9598dabbb..dd01c32ba 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c
@@ -958,7 +958,7 @@ void FileChoose_UpdateKeyboardCursorNES(GameState* thisx) {
                 }
             } else if (sLastCharIndex != this->charIndex && this->charIndex < 65) {
                 // NTSC TODO: Figure out japanese TTS
-                // GameInteractor_ExecuteOnUpdateFileNameSelection(D_808123F0[this->charIndex]);
+                // GameInteractor_ExecuteOnUpdateFileNameSelection(gKeyboardCharactersPal[this->charIndex]);, was D_808123F0 [LLM:HIGH]
                 sLastCharIndex = this->charIndex;
                 sLastKbdX = -1;
             }
diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
index 37b71ea4e..f2763a225 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
