From 412a7c385c7500a2c45df376d3f59a90a7e514d3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:02:02 +0000
Subject: [PATCH 191/225] soh: rename D_80A7FA20 -> sRockYOffsets

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c b/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c
index a2c1524c4..282714a0a 100644
--- a/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c
+++ b/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c
@@ -55,7 +55,8 @@ const ActorInit En_Ishi_InitVars = {
 };
 
 static f32 sRockScales[] = { 0.1f, 0.4f };
-static f32 D_80A7FA20[] = { 58.0f, 80.0f };
+// LLM generated name (HIGH), was D_80A7FA20: per-type rock Y offsets applied to actor.shape.yOffset.
+static f32 sRockYOffsets[] = { 58.0f, 80.0f };
 static f32 D_80A7FA28[] = { 0.0f, 0.005f };
 
 // the sizes of these arrays are very large and take up way more space than it needs to.
@@ -334,7 +335,7 @@ void EnIshi_Init(Actor* thisx, PlayState* play) {
         return;
     }
     CollisionCheck_SetInfo(&this->actor.colChkInfo, NULL, &sColChkInfoInit);
-    this->actor.shape.yOffset = D_80A7FA20[type];
+    this->actor.shape.yOffset = sRockYOffsets[type];
     if (!((this->actor.params >> 5) & 1) && !EnIshi_SnapToFloor(this, play, 0.0f)) {
         Actor_Kill(&this->actor);
         return;
-- 
