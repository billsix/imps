From 575d3c94a622ce461ada78e5286b4367e5d26a00 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:38:30 +0000
Subject: [PATCH 1041/3799] soh: rename func_808AC22C ->
 BgSpot01Objects2_GetPathPoint

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: copies the requested waypoint of the requested path into a Vec3f; used to place the spawned carpenter.
Defined in soh/src/overlays/actors/ovl_Bg_Spot01_Objects2/z_bg_spot01_objects2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot01_Objects2/z_bg_spot01_objects2.c     | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot01_Objects2/z_bg_spot01_objects2.c b/soh/src/overlays/actors/ovl_Bg_Spot01_Objects2/z_bg_spot01_objects2.c
index c72be812e..1dce46570 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot01_Objects2/z_bg_spot01_objects2.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot01_Objects2/z_bg_spot01_objects2.c
@@ -77,7 +77,8 @@ void BgSpot01Objects2_Init(Actor* thisx, PlayState* play) {
 void BgSpot01Objects2_Destroy(Actor* thisx, PlayState* play) {
 }
 
-s32 func_808AC22C(Path* pathList, Vec3f* pos, s32 path, s32 waypoint) {
+// LLM generated name (HIGH), was func_808AC22C: copies the requested waypoint of the requested path into a Vec3f; used to place the spawned carpenter.
+s32 BgSpot01Objects2_GetPathPoint(Path* pathList, Vec3f* pos, s32 path, s32 waypoint) {
     Vec3s* pointPos = &((Vec3s*)SEGMENTED_TO_VIRTUAL((pathList + path)->points))[waypoint];
 
     pos->x = pointPos->x;
@@ -109,7 +110,7 @@ void func_808AC2BC(BgSpot01Objects2* this, PlayState* play) {
                 CollisionHeader_GetVirtual(&object_spot01_matoyab_col, &colHeader);
                 this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, thisx, colHeader);
                 if (IS_DAY) {
-                    func_808AC22C(play->setupPathList, &position, ((s32)thisx->params >> 8) & 0xFF, 0);
+                    BgSpot01Objects2_GetPathPoint(play->setupPathList, &position, ((s32)thisx->params >> 8) & 0xFF, 0);  // was func_808AC22C [LLM:HIGH]
                     Actor_SpawnAsChild(&play->actorCtx, thisx, play, ACTOR_EN_DAIKU_KAKARIKO, position.x, position.y,
                                        position.z, thisx->world.rot.x, thisx->world.rot.y, thisx->world.rot.z,
                                        ((((s32)thisx->params >> 8) & 0xFF) << 8) + 1);
