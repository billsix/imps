--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2696,7 +2696,8 @@ static s16 sPageVtxHeights2[] = {  // was D_8082AFCC [LLM:HIGH]
     0x0055, 0x0055, 0x0010, 0x0018, 0x0018, 0x0018, 0x0010, 0x0010, 0x0010,
     0x0010, 0x0010, 0x0010, 0x0010, 0x0010, 0x0010, 0x0010, 0x0018, 0x0000,
 };
-static s16 D_8082AFF0[] = {
+// LLM generated name (HIGH), was D_8082AFF0: the heights in slot 3 of the sPageVtxHeights table
+static s16 sPageVtxHeights3[] = {  // was D_8082AFF0 [LLM:HIGH]
     0x0000,
     0x0000,
 };
@@ -2717,7 +2718,7 @@ static s16* D_8082B030[] = {
 };
 
