From ad16718774db5bb973f384ec55791d383ec6a9b5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:12 +0000
Subject: [PATCH 3448/3799] soh: rename D_80B28970 -> sValiTentacleOffsetA

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the first point EnVali_PostLimbDraw transforms for its tentacles
Defined in soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c b/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c
index d62118a65..19630f8fe 100644
--- a/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c
+++ b/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c
@@ -700,7 +700,7 @@ s32 EnVali_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f*
 }
 
 void EnVali_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx, Gfx** gfx) {
-    static Vec3f D_80B28970 = { 3000.0f, 0.0f, 0.0f };
+    static Vec3f sValiTentacleOffsetA = { 3000.0f, 0.0f, 0.0f };  // was D_80B28970 [LLM:HIGH]
     static Vec3f D_80B2897C = { -1000.0f, 0.0f, 0.0f };
     Vec3f sp3C;
     Vec3f sp30;
@@ -708,7 +708,7 @@ void EnVali_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
 
     if (this->actionFunc == EnVali_FloatIdle) {
         if ((limbIndex == EN_VALI_LIMB_LEFT_FOREARM_BASE) || (limbIndex == EN_VALI_LIMB_RIGHT_FOREARM_BASE)) {
-            Matrix_MultVec3f(&D_80B28970, &sp3C);
+            Matrix_MultVec3f(&sValiTentacleOffsetA, &sp3C);  // was D_80B28970 [LLM:HIGH]
             Matrix_MultVec3f(&D_80B2897C, &sp30);
 
             if (limbIndex == EN_VALI_LIMB_LEFT_FOREARM_BASE) {
