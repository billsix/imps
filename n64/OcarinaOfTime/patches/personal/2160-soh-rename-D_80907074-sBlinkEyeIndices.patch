From 4b4c5296d6b1f20eb2d42a71df0868d8cde7dbdd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:15:35 +0000
Subject: [PATCH 2160/3799] soh: rename D_80907074 -> sBlinkEyeIndices

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the 0-1-2-2-1-0 eye texture ramp walked by the blink counter
Defined in soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c      | 2 +-
 soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
index 079365052..b09c2c3df 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -2082,7 +2082,7 @@ void BossGanon2_Update(Actor* thisx, PlayState* play) {
     if (((this->unk_19C & 0x1F) == 0) && (Rand_ZeroOne() < 0.3f)) {
         this->unk_318 = 4;
     }
-    this->unk_310 = D_80907074[this->unk_318];
+    this->unk_310 = sBlinkEyeIndices[this->unk_318];  // was D_80907074 [LLM:HIGH]
     if (this->unk_318 != 0) {
         this->unk_318--;
     }
diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
index 4919fb2b2..ffd2928f2 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
@@ -255,7 +255,8 @@ static Vec3f sSubCamAtOffsets[] = {  // was D_80907050 [LLM:HIGH]
     { -16.0f, -12.0f, 40.0f },
 };
 
-static s16 D_80907074[] = { 0, 1, 2, 2, 1, 0 };
+// LLM generated name (HIGH), was D_80907074: the 0-1-2-2-1-0 eye texture ramp walked by the blink counter
+static s16 sBlinkEyeIndices[] = { 0, 1, 2, 2, 1, 0 };  // was D_80907074 [LLM:HIGH]
 
 static s16 D_80907080 = 0;
 
