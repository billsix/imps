From b6d7ee4f8ec792c678f2773e42be608c105743d2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:02:28 +0000
Subject: [PATCH 1233/3799] soh: rename func_80096A74 -> Room_GetBgImage

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: picks the BgImage entry matching the active camera's data index out of the multi-format polygon, for Room_DrawImageMulti to load.
Defined in soh/src/code/z_room.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_room.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_room.c b/soh/src/code/z_room.c
index 351dd61cc..aaa356417 100644
--- a/soh/src/code/z_room.c
+++ b/soh/src/code/z_room.c
@@ -409,7 +409,8 @@ void Room_DrawImageSingle(PlayState* play, Room* room, u32 flags) {
     CLOSE_DISPS(play->state.gfxCtx);
 }
 
-BgImage* func_80096A74(PolygonType1* polygon1, PlayState* play) {
+// LLM generated name (HIGH), was func_80096A74: picks the BgImage entry matching the active camera's data index out of the multi-format polygon, for Room_DrawImageMulti to load.
+BgImage* Room_GetBgImage(PolygonType1* polygon1, PlayState* play) {
     Camera* camera;
     s32 camId;
     s16 camId2;
@@ -464,7 +465,7 @@ void Room_DrawImageMulti(PlayState* play, Room* room, u32 flags) {
     sp98 = (camera->setting == CAM_SET_PREREND_FIXED);
     polygon1 = &room->meshHeader->polygon1;
     polygonDlist = SEGMENTED_TO_VIRTUAL(polygon1->dlist);
-    bgImage = func_80096A74(polygon1, play);
+    bgImage = Room_GetBgImage(polygon1, play);  // was func_80096A74 [LLM:HIGH]
     sp94 = (flags & 1) && sp98 && bgImage->source && !(SREG(25) & 1);
     sp90 = (flags & 1) && polygonDlist->opa && !(SREG(25) & 2);
     sp8C = (flags & 2) && polygonDlist->xlu && !(SREG(25) & 4);
-- 
