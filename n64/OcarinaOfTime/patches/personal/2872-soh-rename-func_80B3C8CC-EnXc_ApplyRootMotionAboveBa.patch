From 865323a94aec30e1bb44bb1d711a05211176f0de Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:40 +0000
Subject: [PATCH 2872/3799] soh: rename func_80B3C8CC ->
 EnXc_ApplyRootMotionAboveBase

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: queues the animation's root motion, but only while the root joint is above its base height
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index f84479e6c..968f725c0 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -247,7 +247,8 @@ void EnXc_IdleWhenNoCutscene(EnXc* this, PlayState* play) {
     }
 }
 
-void func_80B3C8CC(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B3C8CC: queues the animation's root motion, but only while the root joint is above its base height
+void EnXc_ApplyRootMotionAboveBase(EnXc* this, PlayState* play) {
     SkelAnime* skelAnime = &this->skelAnime;
 
     if (skelAnime->jointTable[0].y >= skelAnime->baseTransl.y) {
@@ -721,7 +722,7 @@ void func_80B3D8A4(EnXc* this, PlayState* play, s32 animFinished) {
         this->actor.gravity = -((kREG(1) * 0.01f) + 13.0f);
         this->actor.minVelocityY = -((kREG(1) * 0.01f) + 13.0f);
     } else {
-        func_80B3C8CC(this, play);
+        EnXc_ApplyRootMotionAboveBase(this, play);  // was func_80B3C8CC [LLM:HIGH]
     }
 }
 
@@ -2081,7 +2082,7 @@ void EnXc_FallInNocturne(EnXc* this, PlayState* play) {
     EnXc_SetEyePattern(this);
     EnXc_SetThrownAroundSFX(this);
     if (!EnXc_SetupNocturneState(&this->actor, play)) {
-        func_80B3C8CC(this, play);
+        EnXc_ApplyRootMotionAboveBase(this, play);  // was func_80B3C8CC [LLM:HIGH]
         EnXc_BgCheck(this, play);
     }
 }
