+s16 sCloudTexWidths[] = {  // was D_8082AAEC [LLM:HIGH]
     32, 112, 32, 48, 32, 32, 32, 48, 32, 64, 32, 48, 48, 48, 48, 64, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 80, 64,
 };
 
@@ -2675,7 +2676,7 @@ static s16* D_8082B000[] = {
 };
 
 static s16* D_8082B018[] = {
-    D_8082AF0C, D_8082AF10, D_8082AF14, D_8082AF38, D_8082AAEC, D_8082AF3C,
+    D_8082AF0C, D_8082AF10, D_8082AF14, D_8082AF38, sCloudTexWidths, D_8082AF3C,  // was D_8082AAEC [LLM:HIGH]
 };
 
