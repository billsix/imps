From becb7dee7e6ee311fc735ca050289f1d3efe71b7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:03:17 +0000
Subject: [PATCH 1239/3799] soh: rename func_80094E78 -> Gfx_TexScrollNoSize

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the non-branching twin: forwards to Gfx_TexScroll with width and height 0.
Defined in soh/src/code/z_rcp.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h                         | 2 +-
 soh/src/code/z_rcp.c                            | 3 ++-
 soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c | 2 +-
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c     | 2 +-
 4 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index a7b9c67bc..3785d66ef 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1224,7 +1224,7 @@ void Gfx_SetupDL_60NoCDXlu(GraphicsContext* gfxCtx);
 void Gfx_SetupDL_61Xlu(GraphicsContext* gfxCtx);
 void Gfx_SetupDL_56Ptr(Gfx** gfxp);
 Gfx* Gfx_BranchTexScroll(Gfx** gfxp, u32 x, u32 y, s32 width, s32 height);
-Gfx* func_80094E78(GraphicsContext* gfxCtx, u32 x, u32 y);
+Gfx* Gfx_TexScrollNoSize(GraphicsContext* gfxCtx, u32 x, u32 y);  // was func_80094E78 [LLM:HIGH]
 Gfx* Gfx_TexScroll(GraphicsContext* gfxCtx, u32 x, u32 y, s32 width, s32 height);
 Gfx* Gfx_TexScrollEx(GraphicsContext* gfxCtx, u32 x, u32 y, s32 width, s32 height, s32 xStep, s32 yStep);
 Gfx* Gfx_TwoTexScroll(GraphicsContext* gfxCtx, s32 tile1, u32 x1, u32 y1, s32 width1, s32 height1, s32 tile2, u32 x2,
diff --git a/soh/src/code/z_rcp.c b/soh/src/code/z_rcp.c
index b584ad5f2..fab9cc8e9 100644
--- a/soh/src/code/z_rcp.c
+++ b/soh/src/code/z_rcp.c
@@ -1380,7 +1380,8 @@ Gfx* Gfx_BranchTexScrollNoSize(Gfx** gfxp, u32 x, u32 y) {
     return Gfx_BranchTexScroll(gfxp, x, y, 0, 0);
 }
 
-Gfx* func_80094E78(GraphicsContext* gfxCtx, u32 x, u32 y) {
+// LLM generated name (HIGH), was func_80094E78: the non-branching twin: forwards to Gfx_TexScroll with width and height 0.
+Gfx* Gfx_TexScrollNoSize(GraphicsContext* gfxCtx, u32 x, u32 y) {
     return Gfx_TexScroll(gfxCtx, x, y, 0, 0);
 }
 
diff --git a/soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c b/soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c
index fde161f82..f93ab068f 100644
--- a/soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c
+++ b/soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c
@@ -819,7 +819,7 @@ void EnGoma_Draw(Actor* thisx, PlayState* play) {
             this->actor.naviEnemyId = 0x02;
             y = (s16)(sinf((this->eggTimer * 5.0f * 3.1415f) / 180.0f) * 31.9f);
             y = (s16)(y + 31);
-            gSPSegment(POLY_OPA_DISP++, 0x08, func_80094E78(play->state.gfxCtx, 0, y));
+            gSPSegment(POLY_OPA_DISP++, 0x08, Gfx_TexScrollNoSize(play->state.gfxCtx, 0, y));  // was func_80094E78 [LLM:HIGH]
             Matrix_Push();
             Matrix_Scale(this->eggScale, 1.0f / this->eggScale, this->eggScale, MTXMODE_APPLY);
             Matrix_RotateY(this->eggSquishAngle * 0.15f, MTXMODE_APPLY);
diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index 5a66cf5c3..6601334c7 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -544,7 +544,7 @@ void EnVm_Draw(Actor* thisx, PlayState* play2) {
         gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_80B2EB88[(play->gameplayFrames + 4) % 8]));
         gSPDisplayList(POLY_XLU_DISP++, gEffEnemyDeathFlameDL);
     }
-    gSPSegment(POLY_OPA_DISP++, 0x08, func_80094E78(play->state.gfxCtx, 0, this->beamTexScroll));
+    gSPSegment(POLY_OPA_DISP++, 0x08, Gfx_TexScrollNoSize(play->state.gfxCtx, 0, this->beamTexScroll));  // was func_80094E78 [LLM:HIGH]
     Matrix_Translate(this->beamPos1.x, this->beamPos1.y, this->beamPos1.z, MTXMODE_NEW);
     Matrix_RotateZYX(this->beamRot.x, this->beamRot.y, this->beamRot.z, MTXMODE_APPLY);
     Matrix_Scale(this->beamScale.x * 0.1f, this->beamScale.x * 0.1f, this->beamScale.z * 0.0015f, MTXMODE_APPLY);
