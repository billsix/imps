From 4062dfceb7599bc61855a91a86f3db9abc69950c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:09:39 +0000
Subject: [PATCH 3257/3799] soh: rename func_800AB944 ->
 View_UpdateViewingMatrix

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: rebuilds the viewing matrix from the current eye, look-at and up
Defined in soh/src/code/z_view.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_play.c   | 2 +-
 soh/src/code/z_view.c   | 3 ++-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index bbae171ad..dc8db5ebb 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1416,7 +1416,7 @@ s32 View_ApplyPerspective(View* view);  // was func_800AAA9C [LLM:HIGH]
 s32 View_ApplyOrtho(View* view);  // was func_800AB0A8 [LLM:HIGH]
 s32 View_ApplyOrthoToOverlay(View* view);  // was func_800AB2C4 [LLM:HIGH]
 s32 View_ApplyPerspectiveToOverlay(View* view);  // was func_800AB560 [LLM:HIGH]
-s32 func_800AB944(View* view);
+s32 View_UpdateViewingMatrix(View* view);  // was func_800AB944 [LLM:HIGH]
 s32 func_800AB9EC(View* view, s32 arg1, Gfx** p);
 s32 func_800ABE74(f32 eyeX, f32 eyeY, f32 eyeZ);
 void ViMode_LogPrint(OSViMode* viMode);
diff --git a/soh/src/code/z_play.c b/soh/src/code/z_play.c
index cd7c7ac90..ffe294fd8 100644
--- a/soh/src/code/z_play.c
+++ b/soh/src/code/z_play.c
@@ -1626,7 +1626,7 @@ Play_Draw_skip:
 
     if (play->view.unk_124 != 0) {
         Camera_Update(GET_ACTIVE_CAM(play));
-        func_800AB944(&play->view);
+        View_UpdateViewingMatrix(&play->view);  // was func_800AB944 [LLM:HIGH]
         play->view.unk_124 = 0;
         if (play->skyboxId && (play->skyboxId != SKYBOX_UNSET_1D) && !play->envCtx.skyboxDisabled) {
             SkyboxDraw_UpdateMatrix(&play->skyboxCtx, play->view.eye.x, play->view.eye.y, play->view.eye.z);
diff --git a/soh/src/code/z_view.c b/soh/src/code/z_view.c
index 345b43f8e..6cd8b7194 100644
--- a/soh/src/code/z_view.c
+++ b/soh/src/code/z_view.c
@@ -640,7 +640,8 @@ s32 View_ApplyPerspectiveToOverlay(View* view) {
     return 1;
 }
 
-s32 func_800AB944(View* view) {
+// LLM generated name (HIGH), was func_800AB944: rebuilds the viewing matrix from the current eye, look-at and up
+s32 View_UpdateViewingMatrix(View* view) {
     OPEN_DISPS(view->gfxCtx);
 
     func_800ABE74(view->eye.x, view->eye.y, view->eye.z);
-- 
2.55.0

