From ef79a738be91bb99498d8ad0da646f2faf5c1d21 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:48 +0000
Subject: [PATCH 3152/3799] soh: rename D_8015E390 -> sCylVsQuadHitPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hit position that check reports
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index bdfd672dc..82f5ce1bc 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2218,7 +2218,7 @@ void CollisionCheck_AC_TrisVsCyl(PlayState* play, CollisionCheckContext* colChkC
 void CollisionCheck_AC_CylVsQuad(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT, Collider* colAC) {
     static TriNorm sCylVsQuadTri0;  // was D_8015E320 [LLM:HIGH]
     static TriNorm sCylVsQuadTri1;  // was D_8015E358 [LLM:HIGH]
-    static Vec3f D_8015E390;
+    static Vec3f sCylVsQuadHitPos;  // was D_8015E390 [LLM:HIGH]
     ColliderCylinder* at = (ColliderCylinder*)colAT;
     ColliderQuad* ac = (ColliderQuad*)colAC;
 
@@ -2231,7 +2231,7 @@ void CollisionCheck_AC_CylVsQuad(PlayState* play, CollisionCheckContext* colChkC
         }
         Math3D_TriNorm(&sCylVsQuadTri0, &ac->dim.quad[2], &ac->dim.quad[3], &ac->dim.quad[1]);  // was D_8015E320 [LLM:HIGH]
         Math3D_TriNorm(&sCylVsQuadTri1, &ac->dim.quad[1], &ac->dim.quad[0], &ac->dim.quad[2]);  // was D_8015E358 [LLM:HIGH]
-        if (Math3D_CylTriVsIntersect(&at->dim, &sCylVsQuadTri0, &D_8015E390) == 1) {  // was D_8015E320 [LLM:HIGH]
+        if (Math3D_CylTriVsIntersect(&at->dim, &sCylVsQuadTri0, &sCylVsQuadHitPos) == 1) {  // was D_8015E320 [LLM:HIGH]
             Vec3f atPos1;
             Vec3f acPos1;
 
@@ -2239,8 +2239,8 @@ void CollisionCheck_AC_CylVsQuad(PlayState* play, CollisionCheckContext* colChkC
             acPos1.x = (ac->dim.quad[0].x + (ac->dim.quad[1].x + (ac->dim.quad[3].x + ac->dim.quad[2].x))) / 4.0f;
             acPos1.y = (ac->dim.quad[0].y + (ac->dim.quad[1].y + (ac->dim.quad[3].y + ac->dim.quad[2].y))) / 4.0f;
             acPos1.z = (ac->dim.quad[0].z + (ac->dim.quad[1].z + (ac->dim.quad[3].z + ac->dim.quad[2].z))) / 4.0f;
-            CollisionCheck_SetATvsAC(play, &at->base, &at->info, &atPos1, &ac->base, &ac->info, &acPos1, &D_8015E390);
-        } else if (Math3D_CylTriVsIntersect(&at->dim, &sCylVsQuadTri1, &D_8015E390) == 1) {  // was D_8015E358 [LLM:HIGH]
+            CollisionCheck_SetATvsAC(play, &at->base, &at->info, &atPos1, &ac->base, &ac->info, &acPos1, &sCylVsQuadHitPos);  // was D_8015E390 [LLM:HIGH]
+        } else if (Math3D_CylTriVsIntersect(&at->dim, &sCylVsQuadTri1, &sCylVsQuadHitPos) == 1) {  // was D_8015E358 [LLM:HIGH]
             Vec3f atPos2;
             Vec3f acPos2;
 
@@ -2248,7 +2248,7 @@ void CollisionCheck_AC_CylVsQuad(PlayState* play, CollisionCheckContext* colChkC
             acPos2.x = (ac->dim.quad[0].x + (ac->dim.quad[1].x + (ac->dim.quad[3].x + ac->dim.quad[2].x))) / 4.0f;
             acPos2.y = (ac->dim.quad[0].y + (ac->dim.quad[1].y + (ac->dim.quad[3].y + ac->dim.quad[2].y))) / 4.0f;
             acPos2.z = (ac->dim.quad[0].z + (ac->dim.quad[1].z + (ac->dim.quad[3].z + ac->dim.quad[2].z))) / 4.0f;
-            CollisionCheck_SetATvsAC(play, &at->base, &at->info, &atPos2, &ac->base, &ac->info, &acPos2, &D_8015E390);
+            CollisionCheck_SetATvsAC(play, &at->base, &at->info, &atPos2, &ac->base, &ac->info, &acPos2, &sCylVsQuadHitPos);  // was D_8015E390 [LLM:HIGH]
         }
     }
 }
