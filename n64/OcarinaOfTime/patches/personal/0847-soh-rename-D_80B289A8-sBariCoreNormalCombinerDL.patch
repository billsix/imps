From 24504c9dbddac7ef299cebb71bf03e40683f211e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:47 +0000
Subject: [PATCH 0847/3799] soh: rename D_80B289A8 -> sBariCoreNormalCombinerDL

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c.
---
 soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c b/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c
index 2ee085520..d62118a65 100644
--- a/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c
+++ b/soh/src/overlays/actors/ovl_En_Vali/z_en_vali.c
@@ -780,7 +780,8 @@ static Gfx sBariCoreInvertTexCombinerDL[] = {
     gsSPEndDisplayList(),
 };
 
-static Gfx D_80B289A8[] = {
+// Name from zeldaret/oot (was D_80B289A8): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Vali/z_en_vali.c]
+static Gfx sBariCoreNormalCombinerDL[] = {
     gsDPSetCombineLERP(TEXEL0, 0, SHADE, 0, TEXEL0, 0, PRIMITIVE, 0, COMBINED, 0, PRIMITIVE, 0, TEXEL1, 0,
                        PRIM_LOD_FRAC, COMBINED),
     gsSPEndDisplayList(),
@@ -799,7 +800,7 @@ void EnVali_Draw(Actor* thisx, PlayState* play) {
     if ((this->lightningTimer % 2) != 0) {
         gSPSegment(POLY_XLU_DISP++, 0x09, sBariCoreInvertTexCombinerDL);
     } else {
-        gSPSegment(POLY_XLU_DISP++, 0x09, D_80B289A8);
+        gSPSegment(POLY_XLU_DISP++, 0x09, sBariCoreNormalCombinerDL);
     }
 
     EnVali_DrawBody(this, play);
-- 
2.55.0

