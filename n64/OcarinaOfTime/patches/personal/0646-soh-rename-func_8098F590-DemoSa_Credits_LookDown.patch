Subject: [PATCH 0646/3799] soh: rename func_8098F590 ->
 DemoSa_Credits_LookDown

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index ec07b1c0c..0b0e2b6aa 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -565,7 +565,8 @@ void DemoSa_Credits_CheckVisibility(DemoSa* this) {
     }
 }
 
-void func_8098F590(DemoSa* this) {
+// Name from zeldaret/oot (was func_8098F590): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_Credits_LookDown(DemoSa* this) {
     DemoSa_AnimationChange(this, &gSariaSitting1Anim, 2, -8.0f, 0);
     this->action = 14;
 }
@@ -596,7 +597,7 @@ void func_8098F654(DemoSa* this, PlayState* play) {
                     DemoSa_Credits_InitPosition(this, play);
                     break;
                 case 8:
-                    func_8098F590(this);
+                    DemoSa_Credits_LookDown(this);
                     break;
                 case 9:
                     func_8098F5D0(this);
