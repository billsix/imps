From 6d09e03cdcde83f1ae60a5352d951d69162f6fd1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:52 +0000
Subject: [PATCH 111/225] soh: rename func_800A9F30 -> Rumble_Update

Name source: zeldaret/oot.
Defined in soh/src/code/z_rumble.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_rumble.c | 7 ++++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index c47f9b48a..44be0f265 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1382,7 +1382,7 @@ void Sram_OpenSave();
 void Sram_InitSave(FileChooseContext* fileChoose);
 void Sram_InitSram(GameState* gameState);
 void SsSram_ReadWrite(uintptr_t addr, void* dramAddr, size_t size, s32 direction);
-void func_800A9F30(PadMgr*, s32);
+void Rumble_Update(PadMgr*, s32);  // was func_800A9F30 [oot]
 void func_800A9F6C(f32, u8, u8, u8);
 void Rumble_Request(f32, u8, u8, u8);
 void func_800AA0B4();
diff --git a/soh/src/code/z_rumble.c b/soh/src/code/z_rumble.c
index d89e11afc..e55707ddd 100644
--- a/soh/src/code/z_rumble.c
+++ b/soh/src/code/z_rumble.c
@@ -3,7 +3,8 @@
 // Name from zeldaret/oot src/code/z_rumble.c (was D_80160FD0): file-scope RumbleMgr the rumble API operates on. Source: https://github.com/zeldaret/oot/blob/main/src/code/z_rumble.c
 RumbleMgr sRumbleMgr;
 
-void func_800A9F30(PadMgr* a, s32 b) {
+// Name from zeldaret/oot src/code/z_rumble.c (was func_800A9F30): retrace callback ticking RumbleMgr_Update and pushing state to PadMgr. Source: https://github.com/zeldaret/oot/blob/main/src/code/z_rumble.c
+void Rumble_Update(PadMgr* a, s32 b) {
     // TODO: Workaround for rumble being too long. Implement os thread functions.
     // Game logic runs at 20hz but input thread runs at 60 hertz, so we call this 3 times
     for (int i = 0; i < 3; i++) {
@@ -62,14 +63,14 @@ void Rumble_Request(f32 a, u8 b, u8 c, u8 d) {
 void func_800AA0B4(void) {
     RumbleMgr_Init(&sRumbleMgr);
 
-    gPadMgr.retraceCallback = func_800A9F30;
+    gPadMgr.retraceCallback = Rumble_Update;
     gPadMgr.retraceCallbackValue = 0;
 }
 
 void func_800AA0F0(void) {
     PadMgr* padmgr = &gPadMgr;
 
-    if ((padmgr->retraceCallback == func_800A9F30) && (padmgr->retraceCallbackValue == 0)) {
+    if ((padmgr->retraceCallback == Rumble_Update) && (padmgr->retraceCallbackValue == 0)) {
         padmgr->retraceCallback = NULL;
         padmgr->retraceCallbackValue = 0;
     }
-- 
