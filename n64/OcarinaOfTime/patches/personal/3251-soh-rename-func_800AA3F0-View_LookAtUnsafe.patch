From 53fdf6d0db4952c06c3fe9312c5fbc6a197ca9d9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:09:39 +0000
Subject: [PATCH 3251/3799] soh: rename func_800AA3F0 -> View_LookAtUnsafe

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same store without that nudge
Defined in soh/src/code/z_view.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_view.c   | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 0e548117d..458e53080 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1395,7 +1395,7 @@ View* View_New(GraphicsContext* gfxCtx);
 void View_Free(View* view);
 void View_Init(View*, GraphicsContext*);
 void View_LookAt(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up);  // was func_800AA358 [LLM:HIGH]
-void func_800AA3F0(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up);
+void View_LookAtUnsafe(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up);  // was func_800AA3F0 [LLM:HIGH]
 void View_SetScale(View* view, f32 scale);
 void View_GetScale(View* view, f32* scale);
 void View_SetPerspective(View* view, f32 fovy, f32 near, f32 far);  // was func_800AA460 [oot]
diff --git a/soh/src/code/z_view.c b/soh/src/code/z_view.c
index 017f765d6..49b9a2150 100644
--- a/soh/src/code/z_view.c
+++ b/soh/src/code/z_view.c
@@ -92,7 +92,8 @@ void View_LookAt(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up) {
     view->flags |= 1;
 }
 
-void func_800AA3F0(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up) {
+// LLM generated name (HIGH), was func_800AA3F0: the same store without that nudge
+void View_LookAtUnsafe(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up) {
     view->eye = *eye;
     view->lookAt = *lookAt;
     view->up = *up;
