Date: Mon, 7 Sep 2026 22:14:19 +0000
Subject: [PATCH 1377/3799] soh: rename func_80AFF1F0 ->
 EnSkj_SetupPickNextFightAction

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays the hit animation and installs SKJ_ACTION_PICK_NEXT_FIHGT_ACTION, matching the file's other EnSkj_Setup* wrappers.
Defined in soh/src/overlays/actors/ovl_En_Skj/z_en_skj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Skj/z_en_skj.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Skj/z_en_skj.c b/soh/src/overlays/actors/ovl_En_Skj/z_en_skj.c
index 1ff5ec967..097faab5a 100644
--- a/soh/src/overlays/actors/ovl_En_Skj/z_en_skj.c
+++ b/soh/src/overlays/actors/ovl_En_Skj/z_en_skj.c
@@ -41,7 +41,8 @@ void EnSkj_SetupWalkToPlayer(EnSkj* this);
 void EnSkj_SetupWaitForMaskTextClear(EnSkj* this);
 void EnSkj_SetupWaitForTextClear(EnSkj* this);
 void EnSkj_SetupDie(EnSkj* this);
-void func_80AFF1F0(EnSkj* this);
+// LLM generated name (HIGH), was func_80AFF1F0: plays the hit animation and installs SKJ_ACTION_PICK_NEXT_FIHGT_ACTION, matching the file's other EnSkj_Setup* wrappers.
+void EnSkj_SetupPickNextFightAction(EnSkj* this);  // was func_80AFF1F0 [LLM:HIGH]
 void EnSkj_OfferNextRound(EnSkj* this, PlayState* play);
 void EnSkj_SetupAskForMask(EnSkj* this, PlayState* play);
 f32 EnSkj_GetItemXzRange(EnSkj* this);
@@ -615,7 +616,7 @@ s32 EnSkj_CollisionCheck(EnSkj* this, PlayState* play) {
                     if (this->dodgeResetTimer == 0) {
                         this->dodgeResetTimer = 60;
                     }
-                    func_80AFF1F0(this);
+                    EnSkj_SetupPickNextFightAction(this);  // was func_80AFF1F0 [LLM:HIGH]
                     return 1;
                 }
                 EnSkj_SetupDie(this);
@@ -751,7 +752,7 @@ void EnSkj_WaitForDeathAnim(EnSkj* this, PlayState* play) {
     }
 }
 
-void func_80AFF1F0(EnSkj* this) {
+void EnSkj_SetupPickNextFightAction(EnSkj* this) {
     EnSkj_ChangeAnim(this, SKJ_ANIM_HIT);
     EnSkj_SetupAction(this, SKJ_ACTION_PICK_NEXT_FIHGT_ACTION);
 }
