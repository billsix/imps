From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:22:09 +0000
Subject: [PATCH 2298/3799] soh: rename func_80AE74B4 -> EnRl_IsCueAction

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: true when the given cue channel is live and sitting on the caller's action id
Defined in soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c b/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
index d5e7e6ba8..cbd10cc70 100644
--- a/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
+++ b/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
@@ -89,7 +89,8 @@ s32 EnRl_UpdateSkelAnime(EnRl* this) {
     return SkelAnime_Update(&this->skelAnime);
 }
 
-s32 func_80AE74B4(EnRl* this, PlayState* play, u16 arg2, s32 arg3) {
+// LLM generated name (HIGH), was func_80AE74B4: true when the given cue channel is live and sitting on the caller's action id
+s32 EnRl_IsCueAction(EnRl* this, PlayState* play, u16 arg2, s32 arg3) {
     CsCmdActorCue* csCmdActorAction;
 
     if (play->csCtx.state != CS_STATE_IDLE) {
@@ -205,7 +206,7 @@ void func_80AE78D4(EnRl* this, PlayState* play) {
 }
 
 void func_80AE7954(EnRl* this, PlayState* play) {
-    if (func_80AE74B4(this, play, 4, 0)) {
+    if (EnRl_IsCueAction(this, play, 4, 0)) {  // was func_80AE74B4 [LLM:HIGH]
         this->action = 5;
         this->drawConfig = 2;
         this->alpha = 0;
@@ -218,7 +219,7 @@ void func_80AE79A4(EnRl* this, PlayState* play) {
     f32* unk_19C = &this->unk_19C;
     s32 alpha = 255;
 
-    if (func_80AE74B4(this, play, 4, 0)) {
+    if (EnRl_IsCueAction(this, play, 4, 0)) {  // was func_80AE74B4 [LLM:HIGH]
         *unk_19C += 1.0f;
         if (*unk_19C >= kREG(5) + 10.0f) {
             this->action = 7;
@@ -245,7 +246,7 @@ void func_80AE79A4(EnRl* this, PlayState* play) {
 }
 
 void func_80AE7AF8(EnRl* this, PlayState* play) {
-    if (func_80AE74B4(this, play, 3, 0)) {
+    if (EnRl_IsCueAction(this, play, 3, 0)) {  // was func_80AE74B4 [LLM:HIGH]
         Animation_Change(&this->skelAnime, &object_rl_Anim_00040C, 1.0f, 0.0f,
                          Animation_GetLastFrame(&object_rl_Anim_00040C), ANIMMODE_ONCE, -8.0f);
         this->action = 6;
