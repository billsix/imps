-                Sfx_PlaySfxAtPos(&D_80906D6C, NA_SE_EV_STONE_BOUND);
+                Sfx_PlaySfxAtPos(&sStoneBoundSfxPos, NA_SE_EV_STONE_BOUND);  // was D_80906D6C [LLM:HIGH]
             }
             if (this->csTimer == 20) {
                 Sfx_PlaySfxCentered(NA_SE_EV_STONE_BOUND);
