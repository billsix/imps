From 6016acf8ed5067bd1bea5e0a3b3c9048c250e87b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:33 +0000
Subject: [PATCH 3331/3799] soh: rename D_801333F0 -> sSfxDebugEnabled

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: a u8 flag beside those debug strings; read as the switch that shows the display
Defined in soh/src/code/audio_sfx.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/variables.h             | 4 ++--
 soh/soh/Enhancements/savestates.cpp | 6 +++---
 soh/src/code/audio_general.c        | 2 +-
 soh/src/code/audio_sfx.c            | 5 +++--
 4 files changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/include/variables.h b/soh/include/variables.h
index 9cc9e7e75..32006529c 100644
--- a/soh/include/variables.h
+++ b/soh/include/variables.h
@@ -162,7 +162,7 @@ extern "C"
 	extern Vec3f gSfxDefaultPos;
 	extern f32 gSfxDefaultFreqAndVolScale;
 	extern s8 gSfxDefaultReverb;
-	extern u8 D_801333F0;
+	extern u8 sSfxDebugEnabled;  // was D_801333F0 [LLM:GUESS]
 	extern u8 gAudioSfxSwapOff;
 	extern u8 gStartSeqDisabled;  // was D_80133408 [oot]
 	extern u8 gAudioDebugPrintSeqCmd;  // was D_8013340C [oot]
@@ -224,7 +224,7 @@ extern "C"
 
 	extern ActiveSound gActiveSounds[7][MAX_CHANNELS_PER_BANK]; // total size = 0xA8
 	extern u8 gSoundBankMuted[];
-	extern u8 D_801333F0;
+	extern u8 sSfxDebugEnabled;  // was D_801333F0 [LLM:GUESS]
 	extern u8 gAudioSfxSwapOff;
 	extern u16 gAudioSfxSwapSource[10];
 	extern u16 gAudioSfxSwapTarget[10];
diff --git a/soh/soh/Enhancements/savestates.cpp b/soh/soh/Enhancements/savestates.cpp
index d099d3453..713ec3f45 100644
--- a/soh/soh/Enhancements/savestates.cpp
+++ b/soh/soh/Enhancements/savestates.cpp
@@ -433,7 +433,7 @@ void SaveState::Save(void) {
     memcpy(info->gActiveSoundsCopy, gActiveSounds, sizeof(gActiveSounds));
     memcpy(&info->gSoundBankMutedCopy, gSoundBankMuted, sizeof(info->gSoundBankMutedCopy));
 
-    info->D_801333F0_copy = D_801333F0;
+    info->D_801333F0_copy = sSfxDebugEnabled;  // was D_801333F0 [LLM:GUESS]
     info->gAudioSfxSwapOff_copy = gAudioSfxSwapOff;
 
     memcpy(&info->gAudioSfxSwapSource_copy, gAudioSfxSwapSource, sizeof(info->gAudioSfxSwapSource_copy));
@@ -466,7 +466,7 @@ void SaveState::Load(void) {
 
     memcpy(gActiveSounds, info->gActiveSoundsCopy, sizeof(gActiveSounds));
     memcpy(gSoundBankMuted, &info->gSoundBankMutedCopy, sizeof(info->gSoundBankMutedCopy));
-    D_801333F0 = info->D_801333F0_copy;
+    sSfxDebugEnabled = info->D_801333F0_copy;  // was D_801333F0 [LLM:GUESS]
     gAudioSfxSwapOff = info->gAudioSfxSwapOff_copy;
 
     memcpy(gAudioSfxSwapSource, &info->gAudioSfxSwapSource_copy, sizeof(info->gAudioSfxSwapSource_copy));
@@ -477,4 +477,4 @@ void SaveState::Load(void) {
     D_801755D0 = info->D_801755D0_copy;
     LoadOverlayStaticData();
     LoadTransitionActors();
-}
\ No newline at end of file
+}
diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index eb52d4484..73116b869 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -3557,7 +3557,7 @@ void AudioDebug_ProcessInput_ScrPrt(void) {
         }
     }
 
-    D_801333F0 = sAudioScrPrtWork[3] + (sAudioScrPrtWork[4] * 2) + (sAudioScrPrtWork[5] * 4) +
+    sSfxDebugEnabled = sAudioScrPrtWork[3] + (sAudioScrPrtWork[4] * 2) + (sAudioScrPrtWork[5] * 4) +  // was D_801333F0 [LLM:GUESS]
                  (sAudioScrPrtWork[6] * 8) + (sAudioScrPrtWork[7] * 0x10) + (sAudioScrPrtWork[8] * 0x20);
 }
 
diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index 1f5b8d043..2ec229031 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -106,7 +106,8 @@ s8 gSfxDefaultReverb = 0; // default reverbAdd
 // LLM generated name (GUESS), was D_801333EC: the second such unused s32
 s32 sUnusedSfxValue2 = 0; // unused, was D_801333EC [LLM:GUESS]
 
-u8 D_801333F0 = 0;
+// LLM generated name (GUESS), was D_801333F0: a u8 flag beside those debug strings; read as the switch that shows the display
+u8 sSfxDebugEnabled = 0;  // was D_801333F0 [LLM:GUESS]
 
 u8 gAudioSfxSwapOff = 0;
 
@@ -243,7 +244,7 @@ void Audio_ProcessSoundRequest(void) {
         req->sfxId = newSfxId;
     }
     bankId = SFX_BANK(req->sfxId);
-    if ((1 << bankId) & D_801333F0) {
+    if ((1 << bankId) & sSfxDebugEnabled) {  // was D_801333F0 [LLM:GUESS]
         AudioDebug_ScrPrt((const s8*)sSfxDebugName, req->sfxId);
         bankId = SFX_BANK(req->sfxId);
     }
