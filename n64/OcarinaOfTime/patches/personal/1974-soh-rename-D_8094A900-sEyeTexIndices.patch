From 4b0ebb761b6740caaa46ebc0f3f517b2bea021f1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:06:36 +0000
Subject: [PATCH 1974/3799] soh: rename D_8094A900 -> sEyeTexIndices

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: blink table indexed by work[BLINK_IDX] to pick Kotake's and Koume's eye texture
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index 0deb95d40..7d1425821 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -2843,7 +2843,8 @@ void BossTw_TwinrovaDeathCS(BossTw* this, PlayState* play) {
     }
 }
 
-static s16 D_8094A900[] = {
+// LLM generated name (HIGH), was D_8094A900: blink table indexed by work[BLINK_IDX] to pick Kotake's and Koume's eye texture
+static s16 sEyeTexIndices[] = {  // was D_8094A900 [LLM:HIGH]
     0, 1, 2, 2, 1,
 };
 
@@ -2932,7 +2933,7 @@ void BossTw_Update(Actor* thisx, PlayState* play) {
             this->work[BLINK_IDX] = 4;
         }
 
-        this->eyeTexIdx = D_8094A900[this->work[BLINK_IDX]];
+        this->eyeTexIdx = sEyeTexIndices[this->work[BLINK_IDX]];  // was D_8094A900 [LLM:HIGH]
 
         if (this->work[BLINK_IDX] != 0) {
             this->work[BLINK_IDX]--;
@@ -3014,7 +3015,7 @@ void BossTw_TwinrovaUpdate(Actor* thisx, PlayState* play2) {
         BossTw_TwinrovaSetupSpin(this, play);
     }
 
-    this->eyeTexIdx = D_8094A900[this->work[BLINK_IDX]];
+    this->eyeTexIdx = sEyeTexIndices[this->work[BLINK_IDX]];  // was D_8094A900 [LLM:HIGH]
     if (this->work[BLINK_IDX] != 0) {
         this->work[BLINK_IDX]--;
     }
