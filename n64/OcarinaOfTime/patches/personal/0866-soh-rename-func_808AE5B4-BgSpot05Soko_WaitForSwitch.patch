From ff64c8236941fb7151bd5dd5f92dfbd33cbb8ca1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:12:00 +0000
Subject: [PATCH 0866/3799] soh: rename func_808AE5B4 ->
 BgSpot05Soko_WaitForSwitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: waits for the switch flag; on trip it plays the metal-door sfx, points the one-point camera at itself and starts the descent at speedXZ 0.5.
Defined in soh/src/overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c b/soh/src/overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c
index d940d7b01..eaef55a5f 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot05_Soko/z_bg_spot05_soko.c
@@ -15,7 +15,8 @@ void BgSpot05Soko_Update(Actor* thisx, PlayState* play);
 void BgSpot05Soko_Draw(Actor* thisx, PlayState* play);
 // LLM generated name (HIGH), was func_808AE5A8: empty action, installed for the params branch where the grotto crate never moves.
 void BgSpot05Soko_DoNothing(BgSpot05Soko* this, PlayState* play);  // was func_808AE5A8 [LLM:HIGH]
-void func_808AE5B4(BgSpot05Soko* this, PlayState* play);
+// LLM generated name (HIGH), was func_808AE5B4: waits for the switch flag; on trip it plays the metal-door sfx, points the one-point camera at itself and starts the descent at speedXZ 0.5.
+void BgSpot05Soko_WaitForSwitch(BgSpot05Soko* this, PlayState* play);  // was func_808AE5B4 [LLM:HIGH]
 void func_808AE630(BgSpot05Soko* this, PlayState* play);
 
 const ActorInit Bg_Spot05_Soko_InitVars = {
@@ -62,7 +63,7 @@ void BgSpot05Soko_Init(Actor* thisx, PlayState* play) {
         if (Flags_GetSwitch(play, this->switchFlag) != 0) {
             Actor_Kill(thisx);
         } else {
-            this->actionFunc = func_808AE5B4;
+            this->actionFunc = BgSpot05Soko_WaitForSwitch;  // was func_808AE5B4 [LLM:HIGH]
             thisx->flags |= ACTOR_FLAG_UPDATE_CULLING_DISABLED;
         }
     }
@@ -78,7 +79,7 @@ void BgSpot05Soko_Destroy(Actor* thisx, PlayState* play) {
 void BgSpot05Soko_DoNothing(BgSpot05Soko* this, PlayState* play) {
 }
 
-void func_808AE5B4(BgSpot05Soko* this, PlayState* play) {
+void BgSpot05Soko_WaitForSwitch(BgSpot05Soko* this, PlayState* play) {
     if (Flags_GetSwitch(play, this->switchFlag)) {
         SoundSource_PlaySfxAtFixedWorldPos(play, &this->dyna.actor.world.pos, 30, NA_SE_EV_METALDOOR_CLOSE);
         Actor_SetFocus(&this->dyna.actor, 50.0f);
