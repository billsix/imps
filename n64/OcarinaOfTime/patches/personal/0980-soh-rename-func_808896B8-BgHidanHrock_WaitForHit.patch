+void BgHidanHrock_WaitForHit(BgHidanHrock* this, PlayState* play);  // was func_808896B8 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808894A4: empty action, installed once the pillar has finished falling or when it starts already lowered.
 void BgHidanHrock_DoNothing(BgHidanHrock* this, PlayState* play);  // was func_808894A4 [LLM:HIGH]
 
