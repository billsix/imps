 static s16 sShieldFlashScroll;  // was D_8094C872 [LLM:HIGH]
-static s16 D_8094C874;
+// LLM generated name (GUESS), was D_8094C874: written during the intro cutscene (30, 435, and the message index) and never read anywhere in the overlay; the name records that check, not an intent
+static s16 sUnusedIntroCsValue1;  // was D_8094C874 [LLM:GUESS]
