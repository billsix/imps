From a2f150bdedf334a271373ba87a0b3586e67780e8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:04 +0000
Subject: [PATCH 079/488] soh: rename func_800746DC -> Environment_RandCentered

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/code/z_kankyo.c.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/code/z_kankyo.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_kankyo.c b/soh/src/code/z_kankyo.c
index daa3947ff..3ee0d61fe 100644
--- a/soh/src/code/z_kankyo.c
+++ b/soh/src/code/z_kankyo.c
@@ -1625,7 +1625,8 @@ void Environment_DrawLensFlare(PlayState* play, EnvironmentContext* envCtx, View
     CLOSE_DISPS(gfxCtx);
 }
 
-f32 func_800746DC(void) {
+// Name from zeldaret/oot (was func_800746DC): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_kankyo.c]
+f32 Environment_RandCentered(void) {
     return Rand_ZeroOne() - 0.5f;
 }
 
@@ -1720,8 +1721,8 @@ void Environment_DrawRain(PlayState* play, View* view, GraphicsContext* gfxCtx)
                     firstDone++;
                 }
 
-                Matrix_Translate(func_800746DC() * 280.0f + x280, player->actor.world.pos.y + 2.0f,
-                                 func_800746DC() * 280.0f + z280, MTXMODE_NEW);
+                Matrix_Translate(Environment_RandCentered() * 280.0f + x280, player->actor.world.pos.y + 2.0f,
+                                 Environment_RandCentered() * 280.0f + z280, MTXMODE_NEW);
 
                 if ((LINK_IS_ADULT && ((player->actor.world.pos.y + 2.0f - view->eye.y) > -48.0f)) ||
                     (!LINK_IS_ADULT && ((player->actor.world.pos.y + 2.0f - view->eye.y) > -30.0f))) {
