From 7924e71c48f575a214c3813306e4d737607acbe2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:36 +0000
Subject: [PATCH 428/488] soh: rename D_80134D00 -> sDegToRad

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the degrees-to-radians constant guPositionF multiplies by
Defined in soh/src/libultra/gu/guPosition.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/libultra/gu/guPosition.c | 8 ++++----
 soh/src/libultra/gu/position.c   | 8 ++++----
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/soh/src/libultra/gu/guPosition.c b/soh/src/libultra/gu/guPosition.c
index 2233a72f3..2fa68612b 100644
--- a/soh/src/libultra/gu/guPosition.c
+++ b/soh/src/libultra/gu/guPosition.c
@@ -5,13 +5,13 @@
  * Creates a rotation/parallel translation modeling matrix (floating point)
  */
 void guPositionF(f32 mf[4][4], f32 rot, f32 pitch, f32 yaw, f32 scale, f32 x, f32 y, f32 z) {
-    static f32 D_80134D00 = M_PI / 180.0;
+    static f32 sDegToRad = M_PI / 180.0;  // was D_80134D00 [LLM:HIGH]
     f32 sinr, sinp, sinh;
     f32 cosr, cosp, cosh;
 
-    rot *= D_80134D00;
-    pitch *= D_80134D00;
-    yaw *= D_80134D00;
+    rot *= sDegToRad;  // was D_80134D00 [LLM:HIGH]
+    pitch *= sDegToRad;  // was D_80134D00 [LLM:HIGH]
+    yaw *= sDegToRad;  // was D_80134D00 [LLM:HIGH]
 
     sinr = sinf(rot);
     cosr = cosf(rot);
diff --git a/soh/src/libultra/gu/position.c b/soh/src/libultra/gu/position.c
index 65517139d..5c74b4951 100644
--- a/soh/src/libultra/gu/position.c
+++ b/soh/src/libultra/gu/position.c
@@ -5,13 +5,13 @@
  * Creates a rotation/parallel translation modeling matrix (floating point)
  */
 void guPositionF(f32 mf[4][4], f32 rot, f32 pitch, f32 yaw, f32 scale, f32 x, f32 y, f32 z) {
-    static f32 D_80134D00 = M_PI / 180.0;
+    static f32 sDegToRad = M_PI / 180.0;  // was D_80134D00 [LLM:HIGH]
     f32 sinr, sinp, sinh;
     f32 cosr, cosp, cosh;
 
-    rot *= D_80134D00;
-    pitch *= D_80134D00;
-    yaw *= D_80134D00;
+    rot *= sDegToRad;  // was D_80134D00 [LLM:HIGH]
+    pitch *= sDegToRad;  // was D_80134D00 [LLM:HIGH]
+    yaw *= sDegToRad;  // was D_80134D00 [LLM:HIGH]
 
     sinr = sinf(rot);
     cosr = cosf(rot);
-- 
2.55.0

