 #include "soh/Enhancements/savestate_serialize.h"
 
-// TODO: can these macros be shared between files? code_800F9280 seems to use
+// TODO: can these macros be shared between files? audio_seq.c (was code_800F9280) seems to use
 // versions without any casts...
 #define Audio_DisableSeq(playerIdx, fadeOut) Audio_QueueCmdS32(0x83000000 | ((u8)playerIdx << 16), fadeOut)
 #define Audio_StartSeq(playerIdx, fadeTimer, seqId) \
diff --git a/soh/src/code/code_800F9280.c b/soh/src/code/audio_seq.c
similarity index 100%
rename from soh/src/code/code_800F9280.c
rename to soh/src/code/audio_seq.c
