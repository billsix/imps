@@ -35,7 +35,8 @@ static InitChainEntry sInitChain[] = {
     ICHAIN_VEC3F_DIV1000(scale, 100, ICHAIN_STOP),
 };
 
-void func_80891AC0(BgIceShutter* this) {
+// LLM generated name (HIGH), was func_80891AC0: places world.pos at distance velocity.y from home.pos along the axis given by shape.rot.x and shape.rot.y; called every frame by the opening action.
+void BgIceShutter_UpdatePos(BgIceShutter* this) {
     f32 sp24;
 
     sp24 = Math_SinS(this->dyna.actor.shape.rot.x) * this->dyna.actor.velocity.y;
@@ -121,7 +122,7 @@ void func_80891DD4(BgIceShutter* this, PlayState* play) {
