From 37be22c37ef431291f09025a77058c05bb74d36d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:11:24 +0000
Subject: [PATCH 1338/3799] soh: rename func_80BA228C ->
 ObjWarp2block_CheckSongOfTime

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the second ocarina sub-state: returns 1 once the Song of Time has been played and its short countdown has elapsed, and drops back to waiting when the ocarina closes.
Defined in soh/src/overlays/actors/ovl_Obj_Warp2block/z_obj_warp2block.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Obj_Warp2block/z_obj_warp2block.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Warp2block/z_obj_warp2block.c b/soh/src/overlays/actors/ovl_Obj_Warp2block/z_obj_warp2block.c
index ecd004261..a7bad7d26 100644
--- a/soh/src/overlays/actors/ovl_Obj_Warp2block/z_obj_warp2block.c
+++ b/soh/src/overlays/actors/ovl_Obj_Warp2block/z_obj_warp2block.c
@@ -24,7 +24,8 @@ s32 ObjWarp2block_IsPlayerInRange(ObjWarp2block* this, PlayState* play);  // was
 void ObjWarp2block_SwapWithChild(ObjWarp2block* this, PlayState* play);
 // LLM generated name (HIGH), was func_80BA2218: the first of the two ocarina sub-states: while the player is in range it flags them as near an ocarina actor and, once they start playing, opens free play and moves to the song check.
 s32 ObjWarp2block_WaitForOcarina(ObjWarp2block* this, PlayState* play);  // was func_80BA2218 [LLM:HIGH]
-s32 func_80BA228C(ObjWarp2block* this, PlayState* play);
+// LLM generated name (HIGH), was func_80BA228C: the second ocarina sub-state: returns 1 once the Song of Time has been played and its short countdown has elapsed, and drops back to waiting when the ocarina closes.
+s32 ObjWarp2block_CheckSongOfTime(ObjWarp2block* this, PlayState* play);  // was func_80BA228C [LLM:HIGH]
 s32 func_80BA2304(ObjWarp2block* this, PlayState* play);
 void ObjWarp2block_SetInactive(ObjWarp2block* this);
 void ObjWarp2block_DoNothing(ObjWarp2block* this, PlayState* play);
@@ -165,7 +166,7 @@ s32 ObjWarp2block_WaitForOcarina(ObjWarp2block* this, PlayState* play) {
     if (ObjWarp2block_IsPlayerInRange(this, play)) {  // was func_80BA1ECC [LLM:HIGH]
         if (player->stateFlags2 & PLAYER_STATE2_ATTEMPT_PLAY_FOR_ACTOR) {
             Message_StartOcarinaSunsSongEnabled(play, OCARINA_ACTION_FREE_PLAY);
-            this->func_168 = func_80BA228C;
+            this->func_168 = ObjWarp2block_CheckSongOfTime;  // was func_80BA228C [LLM:HIGH]
         } else {
             player->stateFlags2 |= PLAYER_STATE2_NEAR_OCARINA_ACTOR;
         }
@@ -174,7 +175,7 @@ s32 ObjWarp2block_WaitForOcarina(ObjWarp2block* this, PlayState* play) {
     return 0;
 }
 
-s32 func_80BA228C(ObjWarp2block* this, PlayState* play) {
+s32 ObjWarp2block_CheckSongOfTime(ObjWarp2block* this, PlayState* play) {
     if (play->msgCtx.ocarinaMode == OCARINA_MODE_04) {
         this->func_168 = ObjWarp2block_WaitForOcarina;  // was func_80BA2218 [LLM:HIGH]
     }
