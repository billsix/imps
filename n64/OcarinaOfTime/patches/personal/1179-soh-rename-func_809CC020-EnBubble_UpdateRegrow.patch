From 6a4fdc9f36c494dff8bb4a05bcdc1faf14dfcc6d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:55:04 +0000
Subject: [PATCH 1179/3799] soh: rename func_809CC020 -> EnBubble_UpdateRegrow

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the unused EnBubble_Regrow action's helper: expands the bubble a twelfth of a unit per frame and returns true once the countdown expires.
Defined in soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c b/soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c
index 513536345..d7fc07af0 100644
--- a/soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c
+++ b/soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c
@@ -165,7 +165,8 @@ u32 EnBubble_UpdateDisappear(EnBubble* this) {
 }
 
 // only called in an unused actionFunc
-s32 func_809CC020(EnBubble* this) {
+// LLM generated name (HIGH), was func_809CC020: the unused EnBubble_Regrow action's helper: expands the bubble a twelfth of a unit per frame and returns true once the countdown expires.
+s32 EnBubble_UpdateRegrow(EnBubble* this) {
     this->expansionWidth += 1.0f / 12.0f;
     this->expansionHeight += 1.0f / 12.0f;
 
@@ -394,7 +395,7 @@ void EnBubble_Disappear(EnBubble* this, PlayState* play) {
 
 // unused
 void EnBubble_Regrow(EnBubble* this, PlayState* play) {
-    if (func_809CC020(this)) {
+    if (EnBubble_UpdateRegrow(this)) {  // was func_809CC020 [LLM:HIGH]
         this->actionFunc = EnBubble_Wait;
     }
     CollisionCheck_SetAC(play, &play->colChkCtx, &this->colliderSphere.base);
