 // LLM generated name (HIGH), was D_809071CC: per-limb index of the limb its shadow position is interpolated toward, -1 where there is none
 static s16 sShadowLimbParents[] = { 1, -1, 1, 1, 3, 4, 1, 6, 7, 2, 9, 10, 2, 12, 13 };  // was D_809071CC [LLM:HIGH]
 
-static u8 D_809071EC[] = { 3, 2, 2, 1, 3, 3, 1, 3, 3, 1, 0, 3, 1, 0, 3 };
+// LLM generated name (HIGH), was D_809071EC: per-limb selector, 0-3, choosing which of the four stripe width tables stamps that limb
