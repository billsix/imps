Date: Mon, 7 Sep 2026 13:35:33 +0000
Subject: [PATCH 201/225] soh: rename func_80B1D200 -> EnTk_DrawShovel

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Tk/z_en_tk.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Tk/z_en_tk.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tk/z_en_tk.c b/soh/src/overlays/actors/ovl_En_Tk/z_en_tk.c
index 0ee4f3ec9..cd5d4a882 100644
--- a/soh/src/overlays/actors/ovl_En_Tk/z_en_tk.c
+++ b/soh/src/overlays/actors/ovl_En_Tk/z_en_tk.c
@@ -684,7 +684,8 @@ void EnTk_Update(Actor* thisx, PlayState* play) {
     EnTk_UpdateEyes(this);
 }
 
-void func_80B1D200(PlayState* play) {
+// LLM generated name (HIGH), was func_80B1D200: draws the gDampeShovelDL display list for the gravedigger
+void EnTk_DrawShovel(PlayState* play) {
     OPEN_DISPS(play->state.gfxCtx);
 
     gSPDisplayList(POLY_OPA_DISP++, gDampeShovelDL);
@@ -723,7 +724,7 @@ void EnTk_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
     /* Limb 14 - Neck */
     if (limbIndex == 14) {
         Matrix_MultVec3f(&sp28, &this->v3f_304);
-        func_80B1D200(play);
+        EnTk_DrawShovel(play);
     }
 }
 
