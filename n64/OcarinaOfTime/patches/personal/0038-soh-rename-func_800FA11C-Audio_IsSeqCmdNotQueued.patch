From 21f65f555f6ca14d6b25b5d87505e4cc65d4cd0f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:14 +0000
Subject: [PATCH 038/784] soh: rename func_800FA11C -> Audio_IsSeqCmdNotQueued

Name source: zeldaret/oot.
Defined in soh/src/code/audio_seq.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h      | 2 +-
 soh/src/code/audio_general.c | 4 ++--
 soh/src/code/audio_seq.c     | 5 +++--
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 03292f585..9aa0e139c 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -2164,7 +2164,7 @@ void func_800F94FC(u32);
 void Audio_ProcessSeqCmd(u32);
 void Audio_ProcessSeqCmds(void);
 u16 Audio_GetActiveSeqId(u8 a0);  // was func_800FA0B4 [oot]
-s32 func_800FA11C(u32 arg0, u32 arg1);
+s32 Audio_IsSeqCmdNotQueued(u32 arg0, u32 arg1);  // was func_800FA11C [oot]
 void func_800FA174(u8);
 void func_800FA18C(u8, u8);
 void Audio_SetVolScale(u8 playerIdx, u8 scaleIdx, u8 targetVol, u8 volFadeTimer);
diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 57b930c74..cebe5c80d 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -4896,7 +4896,7 @@ void Audio_SetMainBgmTempoFreqAfterFanfare(f32 arg0, u8 arg2) {
 }
 
 void Audio_SetFastTempoForTimedMinigame(void) {
-    if (Audio_GetActiveSeqId(SEQ_PLAYER_BGM_MAIN) == NA_BGM_TIMED_MINI_GAME && func_800FA11C(0, 0xF0000000)) {
+    if (Audio_GetActiveSeqId(SEQ_PLAYER_BGM_MAIN) == NA_BGM_TIMED_MINI_GAME && Audio_IsSeqCmdNotQueued(0, 0xF0000000)) {
         Audio_SeqCmdB(SEQ_PLAYER_BGM_MAIN, 5, 0, 0xD2);
     }
 }
@@ -5470,7 +5470,7 @@ void Audio_SetNatureAmbienceChannelIO(u8 channelIdxRange, u8 port, u8 val) {
     u8 lastChannelIdx;
     u8 channelIdx;
 
-    if ((gActiveSeqs[SEQ_PLAYER_BGM_MAIN].seqId != NA_BGM_NATURE_AMBIENCE) && func_800FA11C(1, 0xF00000FF)) {
+    if ((gActiveSeqs[SEQ_PLAYER_BGM_MAIN].seqId != NA_BGM_NATURE_AMBIENCE) && Audio_IsSeqCmdNotQueued(1, 0xF00000FF)) {
         sAudioNatureFailed = true;
         return;
     }
diff --git a/soh/src/code/audio_seq.c b/soh/src/code/audio_seq.c
index a8bb6138f..bf30feebf 100644
--- a/soh/src/code/audio_seq.c
+++ b/soh/src/code/audio_seq.c
@@ -413,7 +413,8 @@ u16 Audio_GetActiveSeqId(u8 playerIdx) {
     return gActiveSeqs[playerIdx].seqId;
 }
 
-s32 func_800FA11C(u32 arg0, u32 arg1) {
+// Name from zeldaret/oot, was func_800FA11C: scans the cmd ring, returns false if a matching cmd is queued. [oot: https://github.com/zeldaret/oot/blob/main/src/audio/game/sequence.c]
+s32 Audio_IsSeqCmdNotQueued(u32 arg0, u32 arg1) {
     u8 i;
 
     for (i = sSeqCmdRdPos; i != sSeqCmdWrPos; i++) {
@@ -608,7 +609,7 @@ void func_800FA3DC(void) {
         }
 
         if (gActiveSeqs[playerIdx].setupCmdNum != 0) {
-            if (func_800FA11C(0xF0000000, 0xF0000000) == 0) {
+            if (Audio_IsSeqCmdNotQueued(0xF0000000, 0xF0000000) == 0) {
                 gActiveSeqs[playerIdx].setupCmdNum = 0;
                 return;
             }
-- 
2.55.0

