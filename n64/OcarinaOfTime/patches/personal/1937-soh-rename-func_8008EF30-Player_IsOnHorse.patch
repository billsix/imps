 }
 
-s32 func_8008EF30(PlayState* play) {
+// LLM generated name (HIGH), was func_8008EF30: returns stateFlags1 & PLAYER_STATE1_ON_HORSE
+s32 Player_IsOnHorse(PlayState* play) {
     Player* this = GET_PLAYER(play);
 
     return (this->stateFlags1 & PLAYER_STATE1_ON_HORSE);
