From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:53 +0000
Subject: [PATCH 3276/3799] soh: rename D_8094A9B0 -> sTwinrovaEyeTextures

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the open, half and closed eye textures fused Twinrova draws
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index c4d10f6fd..f1872f7ba 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -3573,7 +3573,8 @@ void BossTw_Draw(Actor* thisx, PlayState* play2) {
     CLOSE_DISPS(play->state.gfxCtx);
 }
 
-void* D_8094A9B0[] = {
+// LLM generated name (HIGH), was D_8094A9B0: the open, half and closed eye textures fused Twinrova draws
+void* sTwinrovaEyeTextures[] = {  // was D_8094A9B0 [LLM:HIGH]
     gTwinrovaEyeOpenTex,
     gTwinrovaEyeHalfTex,
     gTwinrovaEyeClosedTex,
@@ -3588,8 +3589,8 @@ s32 BossTw_TwinrovaOverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList,
         case 21:
             gSPSegment(POLY_OPA_DISP++, 0xC,
                        Gfx_TexScrollEx(play->state.gfxCtx, 0, (s16)(f32)this->work[CS_TIMER_1], 8, 8, 0, 1));
-            gSPSegment(POLY_OPA_DISP++, 8, SEGMENTED_TO_VIRTUAL(D_8094A9B0[this->eyeTexIdx]));
-            gSPSegment(POLY_OPA_DISP++, 9, SEGMENTED_TO_VIRTUAL(D_8094A9B0[this->leftEyeTexIdx]));
+            gSPSegment(POLY_OPA_DISP++, 8, SEGMENTED_TO_VIRTUAL(sTwinrovaEyeTextures[this->eyeTexIdx]));  // was D_8094A9B0 [LLM:HIGH]
+            gSPSegment(POLY_OPA_DISP++, 9, SEGMENTED_TO_VIRTUAL(sTwinrovaEyeTextures[this->leftEyeTexIdx]));  // was D_8094A9B0 [LLM:HIGH]
             gDPSetEnvColor(POLY_OPA_DISP++, 255, 255, 255, this->work[UNK_S8]);
             break;
         case 17:
