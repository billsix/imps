From b3e131d3e23f3c63f756073326da7866a4124dfe Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:19 +0000
Subject: [PATCH 082/225] soh: rename func_800D2E30 -> RumbleMgr_Update

Name source: zeldaret/oot.
Defined in soh/src/code/sys_rumble.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h   | 2 +-
 soh/src/code/sys_rumble.c | 3 ++-
 soh/src/code/z_rumble.c   | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 46c4424aa..294124592 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1830,7 +1830,7 @@ uintptr_t SysUcode_GetUCodeBoot(void);
 size_t SysUcode_GetUCodeBootSize(void);
 uint32_t SysUcode_GetUCode(void);
 uintptr_t SysUcode_GetUCodeData(void);
-void func_800D2E30(RumbleMgr* arg0);
+void RumbleMgr_Update(RumbleMgr* arg0);  // was func_800D2E30 [oot]
 void func_800D3140(RumbleMgr* arg0);
 void func_800D3178(RumbleMgr* arg0);
 void Freeze_CurrentThread(void);  // was func_800D31A0 [oot]
diff --git a/soh/src/code/sys_rumble.c b/soh/src/code/sys_rumble.c
index 71bb80499..28120b47d 100644
--- a/soh/src/code/sys_rumble.c
+++ b/soh/src/code/sys_rumble.c
@@ -1,7 +1,8 @@
 #include "global.h"
 #include <string.h>
 
-void func_800D2E30(RumbleMgr* arg0) {
+// Name from zeldaret/oot src/code/sys_rumble.c (was func_800D2E30): decrements rumble slot timers and sets rumbleEnable each tick. Source: https://github.com/zeldaret/oot/blob/main/src/code/sys_rumble.c
+void RumbleMgr_Update(RumbleMgr* arg0) {
     static u8 D_8012DBB0 = 1;
     s32 i;
     s32 unk_a3;
diff --git a/soh/src/code/z_rumble.c b/soh/src/code/z_rumble.c
index 750cea330..e9d1da263 100644
--- a/soh/src/code/z_rumble.c
+++ b/soh/src/code/z_rumble.c
@@ -6,7 +6,7 @@ void func_800A9F30(PadMgr* a, s32 b) {
     // TODO: Workaround for rumble being too long. Implement os thread functions.
     // Game logic runs at 20hz but input thread runs at 60 hertz, so we call this 3 times
     for (int i = 0; i < 3; i++) {
-        func_800D2E30(&D_80160FD0);
+        RumbleMgr_Update(&D_80160FD0);
         PadMgr_RumbleSet(a, D_80160FD0.rumbleEnable);
     }
 }
