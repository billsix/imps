From 15cd11e913456f8901a70e018bd3e1bce048b7a0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:37 +0000
Subject: [PATCH 3069/3799] soh: rename D_80120A54 -> sCs9500KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 9500 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 753731690..b638bf3a7 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -164,7 +164,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             csCam->roll = 0;
             break;
         case 9500:
-            csInfo->keyFrames = D_80120A54;
+            csInfo->keyFrames = sCs9500KeyFrames;  // was D_80120A54 [LLM:HIGH]
             csInfo->keyFrameCnt = 3;
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
             break;
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index a553f5ecc..365adde17 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -161,7 +161,8 @@ static OnePointCsFull sCs5000KeyFrames[4] = {  // was D_801209B4 [LLM:HIGH]
     { 0x12, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80120A54[3] = {
+// LLM generated name (HIGH), was D_80120A54: the keyframe set one-point cutscene 9500 installs
+static OnePointCsFull sCs9500KeyFrames[3] = {  // was D_80120A54 [LLM:HIGH]
     { 0x8F, 0xFF, 0x2525, 1, 0, 75.0f, 0.1f, { 0.0f, 20.0f, -10.0f }, { 0.0f, 10.0f, -40.0f } },
     { 0x8F, 0xFF, 0x0000, 9, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
     { 0x8B, 0xFF, 0x0022, 5000, 0, 75.0f, 0.005f, { 0.0f, 0.0f, -10.0f }, { -1.0f, -1.0f, -1.0f } },
-- 
