Subject: [PATCH 0719/3799] soh: rename func_80AECDA0 -> EnRu1_InitInBossRoom

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index eda3c5f15..5186045ed 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1113,7 +1113,8 @@ void EnRu1_SpawnBlueWarp(EnRu1* this, PlayState* play) {
                                                     spawnY, spawnZ, 0, yawTowardsPlayer, 0, WARP_BLUE_RUTO);
 }
 
-void func_80AECDA0(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AECDA0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_InitInBossRoom(EnRu1* this, PlayState* play) {
     EnRu1_AnimationChange(this, &gRutoChildWaitHandsOnHipsAnim, 0, 0, 0);
     this->action = 15;
     this->actor.shape.yOffset = -10000.0f;
@@ -2393,7 +2394,7 @@ void EnRu1_Init(Actor* thisx, PlayState* play) {
     EnRu1_InitColliders(&this->actor, play);
     switch (func_80AEADF0(this)) {
         case 0:
-            func_80AECDA0(this, play);
+            EnRu1_InitInBossRoom(this, play);
             break;
         case 1:
             EnRu1_InitOutsideJabuJabu(this, play);
