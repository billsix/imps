From faf27d85ec67cd60887cfa9daeb91d3844b2c9ad Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:37 +0000
Subject: [PATCH 2790/3799] soh: rename D_8015BBA8 -> sHiliteLookAtMtx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the matrix guLookAtHilite writes when a specular highlight is set up
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 62461137b..ed7fb898d 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -1766,7 +1766,8 @@ void Actor_UpdateBgCheckInfo(PlayState* play, Actor* actor, f32 wallCheckHeight,
     GameInteractor_Should(VB_AFTER_ACTOR_UPDATE_BGCHECKINFO, true, actor);
 }
 
-Mtx D_8015BBA8;
+// LLM generated name (HIGH), was D_8015BBA8: the matrix guLookAtHilite writes when a specular highlight is set up
+Mtx sHiliteLookAtMtx;  // was D_8015BBA8 [LLM:HIGH]
 
 // LLM generated name (HIGH), was func_8002E830: allocates the LookAt and Hilite for a specular highlight and writes them into the caller's display list
 Gfx* Actor_SetupHilite(Vec3f* object, Vec3f* eye, Vec3f* lightDir, GraphicsContext* gfxCtx, Gfx* gfx, Hilite** hilite) {
@@ -1785,7 +1786,7 @@ Gfx* Actor_SetupHilite(Vec3f* object, Vec3f* eye, Vec3f* lightDir, GraphicsConte
     }
 
     func_800ABE74(correctedEyeX, eye->y, eye->z);
-    guLookAtHilite(&D_8015BBA8, lookAt, *hilite, correctedEyeX, eye->y, eye->z, object->x, object->y, object->z, 0.0f,
+    guLookAtHilite(&sHiliteLookAtMtx, lookAt, *hilite, correctedEyeX, eye->y, eye->z, object->x, object->y, object->z, 0.0f,  // was D_8015BBA8 [LLM:HIGH]
                    1.0f, 0.0f, lightDir->x, lightDir->y, lightDir->z, lightDir->x, lightDir->y, lightDir->z, 0x10,
                    0x10);
 
