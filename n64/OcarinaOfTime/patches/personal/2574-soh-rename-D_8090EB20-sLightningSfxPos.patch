From a2b6dead3ed35b3d8e9e6c7ea1e9a6de9dccea6b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:35:39 +0000
Subject: [PATCH 2574/3799] soh: rename D_8090EB20 -> sLightningSfxPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the randomised position NA_SE_EV_LIGHTNING is played at
Defined in soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Boss_Ganon2/z_boss_ganon2.c    | 21 ++++++++++---------
 1 file changed, 11 insertions(+), 10 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
index eade4486d..78acc4bb6 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -70,7 +70,8 @@ const ActorInit Boss_Ganon2_InitVars = {
 
 #include "z_boss_ganon2_data.c"
 
-static Vec3f D_8090EB20;
+// LLM generated name (HIGH), was D_8090EB20: the randomised position NA_SE_EV_LIGHTNING is played at
+static Vec3f sLightningSfxPos;  // was D_8090EB20 [LLM:HIGH]
 
 static EnZl3* sZelda;
 
@@ -89,7 +90,7 @@ static Vec3f D_80910608[4];
 static s8 D_80910638;
 
 #define BOSS_GANON2_SHIP_SAVESTATE_FIELDS(F) \
-    F(D_8090EB20)                            \
+    F(sLightningSfxPos)                            \
     F(D_80910638)                            \
     F(sZelda)                                \
     F(D_8090EB30)                            \
@@ -2184,13 +2185,13 @@ void BossGanon2_Update(Actor* thisx, PlayState* play) {
         play->envCtx.unk_BE = 0;
         play->envCtx.unk_BD = (s8)Rand_ZeroFloat(1.9f) + 1;
         play->envCtx.unk_D8 = 1.0f;
-        D_8090EB20.y = 0.0f;
-        D_8090EB20.x = D_8090EB20.y;
-        D_8090EB20.z = D_8090EB20.x;
+        sLightningSfxPos.y = 0.0f;  // was D_8090EB20 [LLM:HIGH]
+        sLightningSfxPos.x = sLightningSfxPos.y;  // was D_8090EB20 [LLM:HIGH]
+        sLightningSfxPos.z = sLightningSfxPos.x;  // was D_8090EB20 [LLM:HIGH]
         if (Rand_ZeroOne() < 0.5f) {
-            D_8090EB20.z = Rand_ZeroFloat(1000.0f);
+            sLightningSfxPos.z = Rand_ZeroFloat(1000.0f);  // was D_8090EB20 [LLM:HIGH]
         }
-        Sfx_PlaySfxAtPos(&D_8090EB20, NA_SE_EV_LIGHTNING);
+        Sfx_PlaySfxAtPos(&sLightningSfxPos, NA_SE_EV_LIGHTNING);  // was D_8090EB20 [LLM:HIGH]
         this->unk_328 = 0xFF;
         this->unk_330 = 5;
         this->unk_32C = 0.0f;
@@ -3201,9 +3202,9 @@ void BossGanon2_DrawShadowTexture(void* shadowTexture, BossGanon2* this, PlaySta
 }
 
 void BossGanon2_Reset(void) {
-    D_8090EB20.x = 0;
-    D_8090EB20.y = 0;
-    D_8090EB20.z = 0;
+    sLightningSfxPos.x = 0;  // was D_8090EB20 [LLM:HIGH]
+    sLightningSfxPos.y = 0;  // was D_8090EB20 [LLM:HIGH]
+    sLightningSfxPos.z = 0;  // was D_8090EB20 [LLM:HIGH]
     D_80910638 = 0;
     sZelda = NULL;
     D_8090EB30 = NULL;
