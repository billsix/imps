From dea91431a1a8cc3dd475c72534939843e40cada8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:33:07 +0000
Subject: [PATCH 2533/3799] soh: rename D_8016B7E4 -> sUnusedAudioDebugValue

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: a u16 already commented as debug-only that nothing in the tree reads or writes; z_debug.c already owns the plain sUnusedDebugValue
Defined in soh/src/code/audio_general.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 3b39ff04a..eb52d4484 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -1277,7 +1277,8 @@ f32 sRateVolScale;  // was D_8016B7D8 [LLM:HIGH]
 s8 sSfxReverbArg;  // was D_8016B7DC [LLM:HIGH]
 // LLM generated name (HIGH), was D_8016B7E0: holds the caller's volume for the duration of Audio_PlaySfxWithVolume
 f32 sSfxVolArg;  // was D_8016B7E0 [LLM:HIGH]
-u16 D_8016B7E4; // decomp: debug only
+// LLM generated name (GUESS), was D_8016B7E4: a u16 already commented as debug-only that nothing in the tree reads or writes; z_debug.c already owns the plain sUnusedDebugValue
+u16 sUnusedAudioDebugValue; // decomp: debug only, was D_8016B7E4 [LLM:GUESS]
 struct {
     s8 str[5];
     u16 num;
-- 
2.55.0

