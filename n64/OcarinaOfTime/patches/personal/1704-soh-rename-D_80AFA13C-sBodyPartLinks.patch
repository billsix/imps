From a45a1f4c526bd72d975617c080d8a740f9e4e9bb Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:38:46 +0000
Subject: [PATCH 1704/3799] soh: rename D_80AFA13C -> sBodyPartLinks

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: for each slot, the slot it is joined to; the stamping pass interpolates between the pair so limbs cast a continuous shadow.
Defined in soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
index 7c73ed7b8..019291f9b 100644
--- a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
+++ b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
@@ -52,7 +52,8 @@ static s16 D_80AFA120[] = {
     2, 4, 5, 6, 7, 8, 8, 8, 8, 7, 6, 5, 4, 2,
 };
 
-static s16 D_80AFA13C[] = {
+// LLM generated name (HIGH), was D_80AFA13C: for each slot, the slot it is joined to; the stamping pass interpolates between the pair so limbs cast a continuous shadow.
+static s16 sBodyPartLinks[] = {  // was D_80AFA13C [LLM:HIGH]
     1, -1, 1, 1, 3, 4, 1, 6, 7, 2, 9, 10, 2, 12, 13, 0,
 };
 
@@ -152,7 +153,7 @@ void func_80AF8F60(Player* player, u8* shadowTexture, f32 arg2) {
     Vec3f sp7C;
 
     for (i = 0; i < 16; i++) {
-        if ((arg2 == 0.0f) || ((j = D_80AFA13C[i]) >= 0)) {
+        if ((arg2 == 0.0f) || ((j = sBodyPartLinks[i]) >= 0)) {  // was D_80AFA13C [LLM:HIGH]
             if (arg2 > 0.0f) {
                 lerp.x = sBodyPartPos[i].x + (sBodyPartPos[j].x - sBodyPartPos[i].x) * arg2;  // was D_80AFA660 [LLM:HIGH]
                 lerp.y = sBodyPartPos[i].y + (sBodyPartPos[j].y - sBodyPartPos[i].y) * arg2;  // was D_80AFA660 [LLM:HIGH]
