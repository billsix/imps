From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:02 +0000
Subject: [PATCH 3376/3799] soh: rename D_809AA558 -> sAttractionParams

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the step and cap EffectSsKakera_ApplyAttraction pulls a shard toward its attractor with
Defined in soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
index a2b82a770..decae86a6 100644
--- a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
+++ b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
@@ -228,7 +228,7 @@ f32 EffectSsKakera_DragSquared2(f32 arg0, s32 arg1) {
 
 // LLM generated name (HIGH), was func_809A9E88: the first force pass: pulls the fragment back toward its origin at one of two strengths, chosen by the low bits of the behaviour flags.
 s32 EffectSsKakera_ApplyAttraction(EffectSs* this, Vec3f* diff, f32 dist) {
-    static f32 D_809AA558[] = { 0.05f, 1.0f };
+    static f32 sAttractionParams[] = { 0.05f, 1.0f };  // was D_809AA558 [LLM:HIGH]
     s32 temp_v0;
     f32 phi_f0;
 
@@ -242,8 +242,8 @@ s32 EffectSsKakera_ApplyAttraction(EffectSs* this, Vec3f* diff, f32 dist) {
             phi_f0 = 1.0f;
         }
 
-        this->accel.x += ((D_809AA558[temp_v0 - 1] * diff->z) * phi_f0);
-        this->accel.z -= ((D_809AA558[temp_v0 - 1] * diff->x) * phi_f0);
+        this->accel.x += ((sAttractionParams[temp_v0 - 1] * diff->z) * phi_f0);  // was D_809AA558 [LLM:HIGH]
+        this->accel.z -= ((sAttractionParams[temp_v0 - 1] * diff->x) * phi_f0);  // was D_809AA558 [LLM:HIGH]
     }
 
     return 1;
