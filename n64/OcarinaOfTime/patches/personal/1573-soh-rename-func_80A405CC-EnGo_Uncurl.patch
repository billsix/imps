 void EnGo_CurlUp(EnGo* this, PlayState* play);  // was func_80A40494 [LLM:HIGH]
-void func_80A405CC(EnGo* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A405CC: plays the uncurl animation forward to its last frame, then installs either the standing idle or the Goron-City-doors variant.
+void EnGo_Uncurl(EnGo* this, PlayState* play);  // was func_80A405CC [LLM:HIGH]
 void EnGo_BiggoronActionFunc(EnGo* this, PlayState* play);
