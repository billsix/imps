From 693328f7f26674aee42115b9fd58caed9e924978 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:10 +0000
Subject: [PATCH 0002/3799] soh: rename code_800EC960.c -> audio_general.c

The file was named after its ROM address; name it for what it contains.
Part of the decomp renaming effort -- see tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/{code_800EC960.c => audio_general.c} | 0
 soh/src/code/code_800F9280.c                      | 2 +-
 2 files changed, 1 insertion(+), 1 deletion(-)
 rename soh/src/code/{code_800EC960.c => audio_general.c} (100%)

diff --git a/soh/src/code/code_800EC960.c b/soh/src/code/audio_general.c
similarity index 100%
rename from soh/src/code/code_800EC960.c
rename to soh/src/code/audio_general.c
diff --git a/soh/src/code/code_800F9280.c b/soh/src/code/code_800F9280.c
index 5cf462299..cb6a7d0ca 100644
--- a/soh/src/code/code_800F9280.c
+++ b/soh/src/code/code_800F9280.c
@@ -24,7 +24,7 @@ u8 D_80133410[] = { 0, 1, 2, 3 };
 u8 gAudioSpecId = 0;
 u8 D_80133418 = 0;
 
-// TODO: clean up these macros. They are similar to ones in code_800EC960.c but without casts.
+// TODO: clean up these macros. They are similar to ones in audio_general.c (was code_800EC960.c) but without casts.
 #define Audio_StartSeq(playerIdx, fadeTimer, seqId) \
     Audio_QueueSeqCmd(0x00000000 | ((playerIdx) << 24) | ((fadeTimer) << 16) | (seqId))
 #define Audio_SeqCmdA(playerIdx, a) Audio_QueueSeqCmd(0xA0000000 | ((playerIdx) << 24) | (a))
