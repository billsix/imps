+++ b/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
@@ -18,7 +18,8 @@ void BgSpot09Obj_Draw(Actor* thisx, PlayState* play);
 s32 BgSpot09Obj_ShouldSpawn(BgSpot09Obj* this, PlayState* play);  // was func_808B1AE0 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808B1BA0: one of the three setup steps: scales the tent-entrance variant down to 0.1 and leaves the others at 1.0.
 s32 BgSpot09Obj_SetScale(BgSpot09Obj* this, PlayState* play);  // was func_808B1BA0 [LLM:HIGH]
-s32 func_808B1BEC(BgSpot09Obj* this, PlayState* play);
+// LLM generated name (HIGH), was func_808B1BEC: one of the three setup steps: registers the variant's collision header as a bg actor when it has one.
+s32 BgSpot09Obj_InitCollision(BgSpot09Obj* this, PlayState* play);  // was func_808B1BEC [LLM:HIGH]
 
 const ActorInit Bg_Spot09_Obj_InitVars = {
     ACTOR_BG_SPOT09_OBJ,
@@ -39,7 +40,7 @@ static CollisionHeader* sCollisionHeaders[] = {  // was D_808B1F90 [LLM:HIGH]
 };
 
 static s32 (*D_808B1FA4[])(BgSpot09Obj* this, PlayState* play) = {
-    func_808B1BEC,
+    BgSpot09Obj_InitCollision,  // was func_808B1BEC [LLM:HIGH]
     BgSpot09Obj_ShouldSpawn,  // was func_808B1AE0 [LLM:HIGH]
     BgSpot09Obj_SetScale,  // was func_808B1BA0 [LLM:HIGH]
 };
@@ -96,7 +97,7 @@ s32 BgSpot09Obj_SetScale(BgSpot09Obj* this, PlayState* play) {
     return 1;
 }
 
-s32 func_808B1BEC(BgSpot09Obj* this, PlayState* play) {
