Date: Mon, 7 Sep 2026 23:05:33 +0000
Subject: [PATCH 1942/3799] soh: rename func_800906D4 ->
 Player_UpdateMeleeWeaponQuads

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: pairs the three tip positions with sMeleeWeaponBasePositions to update meleeWeaponInfo and the sword trail and quads
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index 4ac57ac52..65f0cdcaf 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1574,7 +1574,8 @@ Vec3f D_801260A4[3] = {
     { 0.0f, -400.0f, 1000.0f },
 };
 
-void func_800906D4(PlayState* play, Player* this, Vec3f* newTipPos) {
+// LLM generated name (HIGH), was func_800906D4: pairs the three tip positions with sMeleeWeaponBasePositions to update meleeWeaponInfo and the sword trail and quads
+void Player_UpdateMeleeWeaponQuads(PlayState* play, Player* this, Vec3f* newTipPos) {
     Vec3f newBasePos[3];
 
     Matrix_MultVec3f(&D_801260A4[0], &newBasePos[0]);
@@ -1816,7 +1817,7 @@ void Player_PostLimbDrawGameplay(PlayState* play, s32 limbIndex, Gfx** dList, Ve
                 Player_CalcMeleeWeaponTipPositions(this, sp124);
                 if (this->meleeWeaponState != 0) {
                     EffectBlureShip_ChangeType(Effect_GetByIndex(this->meleeWeaponEffectIndex), TRAIL_TYPE_STICK);
-                    func_800906D4(play, this, sp124);
+                    Player_UpdateMeleeWeaponQuads(play, this, sp124);  // was func_800906D4 [LLM:HIGH]
                 } else {
                     Math_Vec3f_Copy(&this->meleeWeaponInfo[0].tip, &sp124[0]);
                 }
@@ -1842,7 +1843,7 @@ void Player_PostLimbDrawGameplay(PlayState* play, s32 limbIndex, Gfx** dList, Ve
             }
 
             Player_CalcMeleeWeaponTipPositions(this, spE4);
-            func_800906D4(play, this, spE4);
+            Player_UpdateMeleeWeaponQuads(play, this, spE4);  // was func_800906D4 [LLM:HIGH]
         } else if ((*dList != NULL) && (this->leftHandType == PLAYER_MODELTYPE_LH_BOTTLE)) {
             Color_RGB8* bottleColor = &sBottleColors[Player_ActionToBottle(this, this->itemAction)];
 
