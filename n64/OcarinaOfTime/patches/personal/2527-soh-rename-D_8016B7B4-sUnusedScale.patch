From a4b23b496c29b0fd67db789fda3dd0fbe91d6158 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:59 +0000
Subject: [PATCH 2527/3799] soh: rename D_8016B7B4 -> sUnusedScale

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: an f32 declared beside the other scale variables that nothing in the tree reads or writes
Defined in soh/src/code/audio_general.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 17c323555..81b78173a 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -1267,7 +1267,8 @@ f32 sSpeedVolScale;  // was D_8016B7A8 [LLM:HIGH]
 f32 sSecondSfxVolScale;  // was D_8016B7AC [LLM:HIGH]
 // LLM generated name (HIGH), was D_8016B7B0: the frequency scale Audio_SetSfxScalesFromSpeed writes, 0.9 to 1.1
 f32 sSpeedFreqScale;  // was D_8016B7B0 [LLM:HIGH]
-f32 D_8016B7B4;
+// LLM generated name (GUESS), was D_8016B7B4: an f32 declared beside the other scale variables that nothing in the tree reads or writes
+f32 sUnusedScale;  // was D_8016B7B4 [LLM:GUESS]
 FreqLerp sRiverFreqScaleLerp;
 FreqLerp sWaterfallFreqScaleLerp;
 f32 D_8016B7D8;
@@ -1359,7 +1360,7 @@ s32 sAudioUpdateTaskEnd;      // decomp: debug only
     F(sSpeedVolScale)                                      \
     F(sSecondSfxVolScale)                                      \
     F(sSpeedFreqScale)                                      \
-    F(D_8016B7B4)                                      \
+    F(sUnusedScale)                                      \
     F(sRiverFreqScaleLerp)                             \
     F(sWaterfallFreqScaleLerp)                         \
     F(D_8016B7D8)                                      \
-- 
2.55.0

