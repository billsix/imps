From b992853ab009149340c9e2cf48f7acdf29abd919 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:02:02 +0000
Subject: [PATCH 193/225] soh: rename func_80A7ED94 -> EnIshi_ApplyDrag

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c b/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c
index bcafbdd85..0700ae5a5 100644
--- a/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c
+++ b/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c
@@ -57,7 +57,7 @@ const ActorInit En_Ishi_InitVars = {
 static f32 sRockScales[] = { 0.1f, 0.4f };
 // LLM generated name (HIGH), was D_80A7FA20: per-type rock Y offsets applied to actor.shape.yOffset.
 static f32 sRockYOffsets[] = { 58.0f, 80.0f };
-// LLM generated name (HIGH), was D_80A7FA28: per-type drag factors passed to func_80A7ED94.
+// LLM generated name (HIGH), was D_80A7FA28: per-type drag factors passed to EnIshi_ApplyDrag.
 static f32 sRockDragValues[] = { 0.0f, 0.005f };
 
 // the sizes of these arrays are very large and take up way more space than it needs to.
@@ -280,7 +280,8 @@ void EnIshi_Fall(EnIshi* this) {
     }
 }
 
-void func_80A7ED94(Vec3f* arg0, f32 arg1) {
+// LLM generated name (HIGH), was func_80A7ED94: scales down a velocity vector by a randomized drag factor.
+void EnIshi_ApplyDrag(Vec3f* arg0, f32 arg1) {
     arg1 += ((Rand_ZeroOne() * 0.2f) - 0.1f) * arg1;
     arg0->x -= arg0->x * arg1;
     arg0->y -= arg0->y * arg1;
@@ -413,7 +414,7 @@ void EnIshi_LiftedUp(EnIshi* this, PlayState* play) {
         }
         EnIshi_SetupFly(this);
         EnIshi_Fall(this);
-        func_80A7ED94(&this->actor.velocity, sRockDragValues[this->actor.params & 1]);
+        EnIshi_ApplyDrag(&this->actor.velocity, sRockDragValues[this->actor.params & 1]);
         Actor_UpdatePos(&this->actor);
         Actor_UpdateBgCheckInfo(play, &this->actor, 7.5f, 35.0f, 0.0f, 0xC5);
     }
@@ -480,7 +481,7 @@ void EnIshi_Fly(EnIshi* this, PlayState* play) {
     }
     Math_StepToF(&this->actor.shape.yOffset, 0.0f, 2.0f);
     EnIshi_Fall(this);
-    func_80A7ED94(&this->actor.velocity, sRockDragValues[type]);
+    EnIshi_ApplyDrag(&this->actor.velocity, sRockDragValues[type]);
     Actor_UpdatePos(&this->actor);
     this->actor.shape.rot.x += sRotSpeedX;
     this->actor.shape.rot.y += sRotSpeedY;
-- 
