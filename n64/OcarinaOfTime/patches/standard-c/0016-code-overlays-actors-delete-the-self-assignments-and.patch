+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Hamstep/z_bg_hidan_hamstep.c
@@ -103,7 +103,6 @@ s32 BgHidanHamstep_SpawnChildren(BgHidanHamstep* this, PlayState* play2) {
     s16 params;
     PlayState* play = play2;
 
-    pos = pos; // Required to match
     pos.y = this->dyna.actor.home.pos.y - 100.0f;
     sin = Math_SinS(this->dyna.actor.shape.rot.y + 0x8000);
     cos = Math_CosS(this->dyna.actor.shape.rot.y + 0x8000);
diff --git a/soh/src/overlays/actors/ovl_Mir_Ray/z_mir_ray.c b/soh/src/overlays/actors/ovl_Mir_Ray/z_mir_ray.c
index ae1b130bd..bef3ba625 100644
