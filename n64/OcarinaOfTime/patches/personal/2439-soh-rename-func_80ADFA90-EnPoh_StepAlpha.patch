From 746f094d4bfa0944861f8e0d26fb1aa1b521b670 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:10 +0000
Subject: [PATCH 2439/3799] soh: rename func_80ADFA90 -> EnPoh_StepAlpha

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: steps the soul flame's alpha by the caller's amount and rescales, repositions and relights it to match
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index f878fd3a3..5951cf38f 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -755,7 +755,8 @@ void EnPoh_Death(EnPoh* this, PlayState* play) {
     Actor_UpdateBgCheckInfo(play, &this->actor, 10.0f, 10.0f, 10.0f, 4);
 }
 
-void func_80ADFA90(EnPoh* this, s32 arg1) {
+// LLM generated name (HIGH), was func_80ADFA90: steps the soul flame's alpha by the caller's amount and rescales, repositions and relights it to match
+void EnPoh_StepAlpha(EnPoh* this, s32 arg1) {
     f32 multiplier;
 
     this->lightColor.a = CLAMP(this->lightColor.a + arg1, 0, 255);
@@ -778,7 +779,7 @@ void func_80ADFA90(EnPoh* this, s32 arg1) {
 
 void func_80ADFE28(EnPoh* this, PlayState* play) {
     this->actor.home.pos.y += 2.0f;
-    func_80ADFA90(this, 20);
+    EnPoh_StepAlpha(this, 20);  // was func_80ADFA90 [LLM:HIGH]
     if (this->lightColor.a == 255) {
         EnPoh_Talk(this, play);
     }
@@ -823,7 +824,7 @@ void func_80ADFE80(EnPoh* this, PlayState* play) {
 }
 
 void func_80AE009C(EnPoh* this, PlayState* play) {
-    func_80ADFA90(this, -13);
+    EnPoh_StepAlpha(this, -13);  // was func_80ADFA90 [LLM:HIGH]
     if (this->lightColor.a == 0) {
         Actor_Kill(&this->actor);
     }
@@ -831,7 +832,7 @@ void func_80AE009C(EnPoh* this, PlayState* play) {
 
 void EnPoh_TalkRegular(EnPoh* this, PlayState* play) {
     if (this->actor.textId != 0x5005) {
-        func_80ADFA90(this, -13);
+        EnPoh_StepAlpha(this, -13);  // was func_80ADFA90 [LLM:HIGH]
     } else {
         Actor_PlaySfx_Flagged(&this->actor, NA_SE_EN_PO_BIG_CRY - SFX_FLAG);
     }
