From a40a29e939acb7a797f40943d3e120767ff77d85 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:01 +0000
Subject: [PATCH 3371/3799] soh: rename D_80854A40 -> sBombSpawnOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the offset in front of the partner a bomb is placed at
Defined in soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c | 3 ++-
 soh/src/overlays/actors/ovl_player_actor/z_player.c   | 4 ++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c b/soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c
index a8fc5f367..8fce84399 100644
--- a/soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c
+++ b/soh/src/overlays/actors/ovl_En_Partner/z_en_partner.c
@@ -306,7 +306,8 @@ void UseBombs(Actor* thisx, PlayState* play, u8 started) {
     }
 }
 
-static Vec3f D_80854A40 = { 0.0f, 40.0f, 45.0f };
+// LLM generated name (HIGH), was D_80854A40: the offset in front of the partner a bomb is placed at
+static Vec3f sBombSpawnOffset = { 0.0f, 40.0f, 45.0f };  // was D_80854A40 [LLM:HIGH]
 
 void UseHammer(Actor* thisx, PlayState* play, u8 started) {
     EnPartner* this = (EnPartner*)thisx;
diff --git a/soh/src/overlays/actors/ovl_player_actor/z_player.c b/soh/src/overlays/actors/ovl_player_actor/z_player.c
index af0a9d2c8..1f1318ca0 100644
--- a/soh/src/overlays/actors/ovl_player_actor/z_player.c
+++ b/soh/src/overlays/actors/ovl_player_actor/z_player.c
@@ -15057,7 +15057,7 @@ s32 Player_ActionHandler_7(Player* this, PlayState* play) {
     return 1;
 }
 
-static Vec3f D_80854A40 = { 0.0f, 40.0f, 45.0f };
+static Vec3f sBombSpawnOffset = { 0.0f, 40.0f, 45.0f };  // was D_80854A40 [LLM:HIGH]
 
 void Player_Action_808502D0(Player* this, PlayState* play) {
     struct_80854190* sp44 = &D_80854190[this->meleeWeaponAnimation];
@@ -15111,7 +15111,7 @@ void Player_Action_808502D0(Player* this, PlayState* play) {
                 Vec3f shockwavePos;
                 f32 sp2C;
 
-                shockwavePos.y = func_8083973C(play, this, &D_80854A40, &shockwavePos);
+                shockwavePos.y = func_8083973C(play, this, &sBombSpawnOffset, &shockwavePos);  // was D_80854A40 [LLM:HIGH]
                 sp2C = this->actor.world.pos.y - shockwavePos.y;
 
                 Math_ScaledStepToS(&this->actor.focus.rot.x, Math_Atan2S(45.0f, sp2C), 800);
