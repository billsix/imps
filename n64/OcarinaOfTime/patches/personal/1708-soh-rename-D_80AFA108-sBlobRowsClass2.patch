From 4a21975b6ea2b84ebd9b28d26a53aca9c8264b62 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:38:47 +0000
Subject: [PATCH 1708/3799] soh: rename D_80AFA108 -> sBlobRowsClass2

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-row half-widths of the brush used for size class 2.
Defined in soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
index fd1120102..69d73aacc 100644
--- a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
+++ b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
@@ -46,7 +46,8 @@ static s16 sBlobRowsClass1[] = {  // was D_80AFA0F8 [LLM:HIGH]
     2, 3, 4, 4, 4, 4, 3, 2,
 };
 
-static s16 D_80AFA108[] = {
+// LLM generated name (HIGH), was D_80AFA108: the per-row half-widths of the brush used for size class 2.
+static s16 sBlobRowsClass2[] = {  // was D_80AFA108 [LLM:HIGH]
     2, 4, 5, 5, 6, 6, 6, 6, 5, 5, 4, 2,
 };
 
@@ -178,7 +179,7 @@ void func_80AF8F60(Player* player, u8* shadowTexture, f32 arg2) {
 
             if (sBlobSizeClass[i] == 2) {  // was D_80AFA15C [LLM:HIGH]
                 for (j = 0, phi_a3 = -0x180; j < 12; j++, phi_a3 += 0x40) {
-                    for (phi_a0 = -D_80AFA108[j]; phi_a0 < D_80AFA108[j]; phi_a0++) {
+                    for (phi_a0 = -sBlobRowsClass2[j]; phi_a0 < sBlobRowsClass2[j]; phi_a0++) {  // was D_80AFA108 [LLM:HIGH]
                         temp_v1 = temp_t0 + phi_a0;
                         if ((temp_v1 >= 0) && (temp_v1 < 0x40)) {
                             temp_v0 = temp_t1 + phi_a3;
