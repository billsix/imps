From a3a64eb2283544163870393db46c7b9e599bfed0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:12:56 +0000
Subject: [PATCH 2129/3799] soh: rename D_808B910C -> sCommonInitFuncs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the four init steps every type runs, in order
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
index 9b60d8a00..86681cbe2 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
@@ -78,7 +78,8 @@ static u32 sExtraFlags[] = {  // was D_808B9104 [LLM:HIGH]
     0,
 };
 
-static BgSpot18ObjInitFunc D_808B910C[] = {
+// LLM generated name (HIGH), was D_808B910C: the four init steps every type runs, in order
+static BgSpot18ObjInitFunc sCommonInitFuncs[] = {  // was D_808B910C [LLM:HIGH]
     BgSpot18Obj_InitDynaPoly,  // was func_808B8A98 [LLM:HIGH]
     BgSpot18Obj_ShouldSpawn,  // was func_808B8910 [LLM:HIGH]
     BgSpot18Obj_InitScale,  // was func_808B8A5C [LLM:HIGH]
@@ -161,8 +162,8 @@ s32 BgSpot18Obj_InitFlags(BgSpot18Obj* this, PlayState* play) {
 s32 BgSpot18Obj_RunCommonInit(BgSpot18Obj* this, PlayState* play) {
     s32 i;
 
-    for (i = 0; i < ARRAY_COUNT(D_808B910C); i++) {
-        if (D_808B910C[i](this, play) == 0) {
+    for (i = 0; i < ARRAY_COUNT(sCommonInitFuncs); i++) {  // was D_808B910C [LLM:HIGH]
+        if (sCommonInitFuncs[i](this, play) == 0) {  // was D_808B910C [LLM:HIGH]
             return 0;
         }
     }
