From 1bed1bcfa4bdde28ebf591d35cd66bfe8d033802 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:41 +0000
Subject: [PATCH 482/488] soh: rename Struct_8012AF0C -> VrBoxFaceParams

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the face parameter struct sRoomFaceParams and sSkyFaceParams are arrays of
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/code/z_vr_box.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 56104e4e7..c58578b4d 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -149,10 +149,10 @@ typedef struct {
     /* 0x008 */ s32 unk_8;
     /* 0x00C */ s32 unk_C;
     /* 0x010 */ s32 unk_10;
-} Struct_8012AF0C; // size = 0x14
+} VrBoxFaceParams; // size = 0x14, was Struct_8012AF0C [LLM:HIGH]
 
 // LLM generated name (HIGH), was D_8012AEBC: the four room-skybox faces, each carrying the five parameters the room face builder needs.
-Struct_8012AF0C sRoomFaceParams[4] = {  // was D_8012AEBC [LLM:HIGH]
+VrBoxFaceParams sRoomFaceParams[4] = {  // was D_8012AEBC [LLM:HIGH]
     { -0x7E, 0x7C, -0x7E, 0x3F, -0x1F },
     { 0x7E, 0x7C, -0x7E, 0x3F, -0x1F },
     { 0x7E, 0x7C, 0x7E, -0x3F, -0x1F },
@@ -160,7 +160,7 @@ Struct_8012AF0C sRoomFaceParams[4] = {  // was D_8012AEBC [LLM:HIGH]
 };
 
 // LLM generated name (HIGH), was D_8012AF0C: the six outdoor-skybox faces, each carrying the five parameters the sky face builder needs.
-Struct_8012AF0C sSkyFaceParams[6] = {  // was D_8012AF0C [LLM:HIGH]
+VrBoxFaceParams sSkyFaceParams[6] = {  // was D_8012AF0C [LLM:HIGH]
     { -0x40, 0x40, -0x40, 0x20, -0x20 }, { 0x40, 0x40, 0x40, -0x20, -0x20 }, { -0x40, 0x40, 0x40, -0x20, -0x20 },
     { 0x40, 0x40, -0x40, 0x20, -0x20 },  { -0x40, 0x40, 0x40, 0x20, -0x20 }, { -0x40, -0x40, -0x40, 0x20, 0x20 },
 };
