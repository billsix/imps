From 0deff80ac066a6f29af92b93d654623966a30536 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:36 +0000
Subject: [PATCH 3060/3799] soh: rename D_801206A0 -> sCs6001AtPoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the at points for one-point cutscene 6001
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 4 ++--
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 65026f84a..d7508dda4 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -678,9 +678,9 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
             Actor_GetWorld(&spA0, actor);
             if (spA0.pos.z > -750.0f) {
-                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, D_801206A0, D_80120820);
+                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, sCs6001AtPoints, D_80120820);  // was D_801206A0 [LLM:HIGH]
             } else {
-                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, D_801206A0, D_80120760);
+                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, sCs6001AtPoints, D_80120760);  // was D_801206A0 [LLM:HIGH]
             }
 
             i = Quake_Add(csCam, 1);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 8bacaf5de..bec4cca90 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -106,7 +106,8 @@ static s16 sCs3400Duration = 190;  // was D_80120698 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8012069C: the flags argument for 3400, ORed with 0x2000 at the call
 static s16 sCs3400Flags = 8;  // was D_8012069C [LLM:HIGH]
 
-static CutsceneCameraPoint D_801206A0[12] = {
+// LLM generated name (HIGH), was D_801206A0: the at points for one-point cutscene 6001
+static CutsceneCameraPoint sCs6001AtPoints[12] = {  // was D_801206A0 [LLM:HIGH]
     { CS_CMD_CONTINUE, 6, 20, 80.0f, { -96, 40, 170 } }, { CS_CMD_CONTINUE, 6, 20, 80.0f, { -96, 40, 170 } },
     { CS_CMD_CONTINUE, 6, 20, 70.0f, { -70, 35, 150 } }, { CS_CMD_CONTINUE, 5, 10, 60.0f, { -57, 34, 133 } },
     { CS_CMD_CONTINUE, 4, 25, 65.0f, { -22, 32, 110 } }, { CS_CMD_CONTINUE, 3, 12, 60.0f, { -9, 33, 98 } },
-- 
