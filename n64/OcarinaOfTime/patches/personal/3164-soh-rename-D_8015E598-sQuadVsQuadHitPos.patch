From af82573fd459e70f4e5facc5f3d62fa19bc1ddc7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:50 +0000
Subject: [PATCH 3164/3799] soh: rename D_8015E598 -> sQuadVsQuadHitPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the hit position that check reports
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index d4683fa07..2482ed75b 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2452,7 +2452,7 @@ void CollisionCheck_AC_QuadVsTris(PlayState* play, CollisionCheckContext* colChk
  */
 void CollisionCheck_AC_QuadVsQuad(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT, Collider* colAC) {
     static TriNorm sQuadVsQuadAcTris[2];  // was D_8015E530 [LLM:HIGH]
-    static Vec3f D_8015E598;
+    static Vec3f sQuadVsQuadHitPos;  // was D_8015E598 [LLM:HIGH]
     static TriNorm D_8015E5A8[2];
     ColliderQuad* at = (ColliderQuad*)colAT;
     ColliderQuad* ac = (ColliderQuad*)colAC;
@@ -2476,8 +2476,8 @@ void CollisionCheck_AC_QuadVsQuad(PlayState* play, CollisionCheckContext* colChk
 
     for (i = 0; i < 2; i++) {
         for (j = 0; j < 2; j++) {
-            if (Math3D_TriVsTriIntersect(&D_8015E5A8[j], &sQuadVsQuadAcTris[i], &D_8015E598) == 1) {  // was D_8015E530 [LLM:HIGH]
-                if (Collider_QuadSetNearestAC(play, at, &D_8015E598)) {
+            if (Math3D_TriVsTriIntersect(&D_8015E5A8[j], &sQuadVsQuadAcTris[i], &sQuadVsQuadHitPos) == 1) {  // was D_8015E530 [LLM:HIGH]
+                if (Collider_QuadSetNearestAC(play, at, &sQuadVsQuadHitPos)) {  // was D_8015E598 [LLM:HIGH]
                     Vec3f atPos;
                     Vec3f acPos;
 
@@ -2494,7 +2494,7 @@ void CollisionCheck_AC_QuadVsQuad(PlayState* play, CollisionCheckContext* colChk
                     acPos.z =
                         (ac->dim.quad[0].z + (ac->dim.quad[1].z + (ac->dim.quad[3].z + ac->dim.quad[2].z))) / 4.0f;
                     CollisionCheck_SetATvsAC(play, &at->base, &at->info, &atPos, &ac->base, &ac->info, &acPos,
-                                             &D_8015E598);
+                                             &sQuadVsQuadHitPos);  // was D_8015E598 [LLM:HIGH]
                     return;
                 }
             }
