From 3c7724d6bdddc45772b43f01b3092c98b409eb5b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:55 +0000
Subject: [PATCH 3293/3799] soh: rename D_808CA474 -> sMouthOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the point the mouth position is recorded from
Defined in soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c b/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
index 6ce89b87a..8b0b66113 100644
--- a/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
+++ b/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
@@ -1348,7 +1348,7 @@ void BossDodongo_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s
     static Vec3f D_808CA450 = { 5000.0f, -2500.0f, 0.0f };
     static Vec3f sHeadOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_808CA45C [LLM:HIGH]
     static Vec3f sFireOffset = { 11500.0f, -3000.0f, 0.0f };  // was D_808CA468 [LLM:HIGH]
-    static Vec3f D_808CA474 = { 5000.0f, -2000.0f, 0.0f };
+    static Vec3f sMouthOffset = { 5000.0f, -2000.0f, 0.0f };  // was D_808CA474 [LLM:HIGH]
     static Vec3f D_808CA480 = { 8000.0f, 0.0f, 0.0f };
     static Vec3f D_808CA48C = { 8000.0f, 0.0f, 0.0f };
     BossDodongo* this = (BossDodongo*)thisx;
@@ -1357,7 +1357,7 @@ void BossDodongo_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s
         Matrix_MultVec3f(&sHeadOriginOffset, &this->vec);  // was D_808CA45C [LLM:HIGH]
         Matrix_MultVec3f(&D_808CA450, &this->actor.focus.pos);
         Matrix_MultVec3f(&sFireOffset, &this->firePos);  // was D_808CA468 [LLM:HIGH]
-        Matrix_MultVec3f(&D_808CA474, &this->mouthPos);
+        Matrix_MultVec3f(&sMouthOffset, &this->mouthPos);  // was D_808CA474 [LLM:HIGH]
     } else if (limbIndex == 39) {
         Matrix_MultVec3f(&D_808CA480, &this->unk_410);
     } else if (limbIndex == 46) {
