From cf290289e0396df5c311f384985032fcdc736fb4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:08:00 +0000
Subject: [PATCH 1280/3799] soh: rename func_808B30C0 ->
 BgSpot12Gate_SetupWaitForSwitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: snaps the gate down to home height and installs the waiting action.
Defined in soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c b/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
index b1f541666..26bdbb582 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot12_Gate/z_bg_spot12_gate.c
@@ -14,7 +14,8 @@ void BgSpot12Gate_Destroy(Actor* thisx, PlayState* play);
 void BgSpot12Gate_Update(Actor* thisx, PlayState* play);
 void BgSpot12Gate_Draw(Actor* thisx, PlayState* play);
 
-void func_808B30C0(BgSpot12Gate* this);
+// LLM generated name (HIGH), was func_808B30C0: snaps the gate down to home height and installs the waiting action.
+void BgSpot12Gate_SetupWaitForSwitch(BgSpot12Gate* this);  // was func_808B30C0 [LLM:HIGH]
 void func_808B30D8(BgSpot12Gate* this, PlayState* play);
 void func_808B3134(BgSpot12Gate* this);
 void func_808B314C(BgSpot12Gate* this, PlayState* play);
@@ -66,7 +67,7 @@ void BgSpot12Gate_Init(Actor* thisx, PlayState* play) {
     if (Flags_GetSwitch(play, this->dyna.actor.params & 0x3F)) {
         func_808B3274(this);
     } else {
-        func_808B30C0(this);
+        BgSpot12Gate_SetupWaitForSwitch(this);  // was func_808B30C0 [LLM:HIGH]
     }
 }
 
@@ -76,7 +77,7 @@ void BgSpot12Gate_Destroy(Actor* thisx, PlayState* play) {
     DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
 }
 
-void func_808B30C0(BgSpot12Gate* this) {
+void BgSpot12Gate_SetupWaitForSwitch(BgSpot12Gate* this) {
     this->actionFunc = func_808B30D8;
     this->dyna.actor.world.pos.y = this->dyna.actor.home.pos.y;
 }
