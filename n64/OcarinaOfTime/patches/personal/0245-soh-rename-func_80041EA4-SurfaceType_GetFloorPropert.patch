 u32 func_80041F10(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
diff --git a/soh/soh/Enhancements/ExtraModes/EnemyRandomizer.cpp b/soh/soh/Enhancements/ExtraModes/EnemyRandomizer.cpp
index f4a3dd5a3..613710111 100644
--- a/soh/soh/Enhancements/ExtraModes/EnemyRandomizer.cpp
+++ b/soh/soh/Enhancements/ExtraModes/EnemyRandomizer.cpp
@@ -1000,7 +1000,7 @@ void RegisterEnemyRandomizer() {
              IsTimedRoom(ResourceMgr_IsSceneMasterQuest(gPlayState->sceneNum), gPlayState->sceneNum,
                          gPlayState->roomCtx.curRoom.num)) &&
             enemy->id != ACTOR_EN_FIREFLY && enemy->id != ACTOR_EN_CROW) {
-            u32 floorProperty = func_80041EA4(&gPlayState->colCtx, enemy->floorPoly, enemy->floorBgId);
+            u32 floorProperty = SurfaceType_GetFloorProperty(&gPlayState->colCtx, enemy->floorPoly, enemy->floorBgId);
 
             // Let ground enemies air walk above voidout floor in clear/timed rooms
             // and move them up if setting is enabled after they're fallen down
diff --git a/soh/src/code/z_bgcheck.c b/soh/src/code/z_bgcheck.c
index 5ce74b2ce..ed8c672c8 100644
--- a/soh/src/code/z_bgcheck.c
+++ b/soh/src/code/z_bgcheck.c
@@ -4071,7 +4071,8 @@ s32 SurfaceType_GetFloorProperty2(CollisionContext* colCtx, CollisionPoly* poly,
 /**
  * SurfaceType Get Floor Property
  */
-u32 func_80041EA4(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
+// Name from zeldaret/oot (was func_80041EA4): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_bgcheck.c]
+u32 SurfaceType_GetFloorProperty(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
     return SurfaceType_GetData(colCtx, poly, bgId, 0) >> 26 & 0xF;
 }
 
