     EnRu1_SetPlatformCamSetting(this, 0);
 }
 
-void func_80AEB220(EnRu1* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AEB220: waits for the cutscene to go idle before putting the params 0xA Ruto onto the boss platform.
+void EnRu1_WaitForBossPlatform(EnRu1* this, PlayState* play) {
     if ((EnRu1_IsCsStateIdle(play)) && (this->actor.params == 0xA)) {
         EnRu1_SetupRideBossPlatform(this);  // was func_80AEB1D8 [LLM:HIGH]
     }
@@ -2220,7 +2221,7 @@ void EnRu1_SapphireRoom_ThrownOntoPlatform(EnRu1* this, PlayState* play) {
     EnRu1_UpdateSkelAnime(this);
     EnRu1_UpdateEyes(this);
