+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2701,7 +2701,8 @@ static s16 sPageVtxHeights3[] = {  // was D_8082AFF0 [LLM:HIGH]
     0x0000,
     0x0000,
 };
-static s16 D_8082AFF4[] = {
+// LLM generated name (HIGH), was D_8082AFF4: the heights in slot 5 of the sPageVtxHeights table
+static s16 sPageVtxHeights5[] = {  // was D_8082AFF4 [LLM:HIGH]
     0x0010, 0x0030, 0x0030, 0x0010, 0x0010, 0x0000,
 };
 
@@ -2718,7 +2719,7 @@ static s16* D_8082B030[] = {
 };
 
