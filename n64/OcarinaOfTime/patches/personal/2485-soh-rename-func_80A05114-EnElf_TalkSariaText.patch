 void EnElf_TalkSariaAgain(Actor* thisx, PlayState* play);  // was func_80A05040 [LLM:HIGH]
 
@@ -1297,7 +1298,7 @@ void EnElf_TalkSariaAgain(Actor* thisx, PlayState* play) {
         switch (play->msgCtx.choiceIndex) {
             case 0: // yes
                 Message_ContinueTextbox(play, ElfMessage_GetSariaText(play));
-                this->actor.update = func_80A05114;
+                this->actor.update = EnElf_TalkSariaText;  // was func_80A05114 [LLM:HIGH]
                 break;
             case 1: // no
                 Message_CloseTextbox(play);
@@ -1311,7 +1312,7 @@ void EnElf_TalkSariaAgain(Actor* thisx, PlayState* play) {
     EnElf_UpdateAfterTalk(this, play);  // was func_80A04F94 [LLM:HIGH]
 }
 
-void func_80A05114(Actor* thisx, PlayState* play) {
+void EnElf_TalkSariaText(Actor* thisx, PlayState* play) {
     EnElf* this = (EnElf*)thisx;
 
     EnElf_MoveToTalkPos(this, play);  // was func_80A04DE4 [LLM:HIGH]
@@ -1331,7 +1332,7 @@ void func_80A05188(Actor* thisx, PlayState* play) {
 
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT) && Message_ShouldAdvance(play)) {
         Message_ContinueTextbox(play, ElfMessage_GetSariaText(play));
-        this->actor.update = func_80A05114;
+        this->actor.update = EnElf_TalkSariaText;  // was func_80A05114 [LLM:HIGH]
     }
 
     EnElf_UpdateAfterTalk(this, play);  // was func_80A04F94 [LLM:HIGH]
