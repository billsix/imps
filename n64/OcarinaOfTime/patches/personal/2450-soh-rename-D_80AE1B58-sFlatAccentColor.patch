From fbc58aae6488a1d30e8146bf9af3e9660dd03a6b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:11 +0000
Subject: [PATCH 2450/3799] soh: rename D_80AE1B58 -> sFlatAccentColor

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Flat's second colour, bound to the other segment in the same draw
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index 2b750bdfc..a58d75c77 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -191,7 +191,8 @@ static Color_RGBA8 sSharpEnvColor = { 75, 20, 25, 255 };  // was D_80AE1B4C [LLM
 static Color_RGBA8 sFlatEnvColor = { 80, 110, 90, 255 };  // was D_80AE1B50 [LLM:HIGH]
 // LLM generated name (HIGH), was D_80AE1B54: Sharp's second colour, bound to the other segment in the same draw
 static Color_RGBA8 sSharpAccentColor = { 90, 85, 50, 255 };  // was D_80AE1B54 [LLM:HIGH]
-static Color_RGBA8 D_80AE1B58 = { 100, 90, 100, 255 };
+// LLM generated name (HIGH), was D_80AE1B58: Flat's second colour, bound to the other segment in the same draw
+static Color_RGBA8 sFlatAccentColor = { 100, 90, 100, 255 };  // was D_80AE1B58 [LLM:HIGH]
 
 static InitChainEntry sInitChain[] = {
     ICHAIN_F32(targetArrowOffset, 3200, ICHAIN_STOP),
@@ -1140,7 +1141,7 @@ void EnPoh_DrawComposer(Actor* thisx, PlayState* play) {
         phi_t0 = &sSharpAccentColor;  // was D_80AE1B54 [LLM:HIGH]
     } else {
         sp90 = &sFlatEnvColor;  // was D_80AE1B50 [LLM:HIGH]
-        phi_t0 = &D_80AE1B58;
+        phi_t0 = &sFlatAccentColor;  // was D_80AE1B58 [LLM:HIGH]
     }
     if (this->lightColor.a == 255 || this->lightColor.a == 0) {
         Gfx_SetupDL_25Opa(play->state.gfxCtx);
-- 
