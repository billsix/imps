From 0cc0ed04c031b656d1ab27154cc4acab32fc9033 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:56:12 +0000
Subject: [PATCH 1190/3799] soh: rename D_8016BC80 -> sItemBank

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: gSoundBanks[1]; the same comment names entry 1 "Item Bank size 12".
Defined in soh/src/code/audio_sfx.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_sfx.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index 17cd30d13..45d8af6e7 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -38,7 +38,8 @@ char D_80133398[] = "    L";
 
 // LLM generated name (HIGH), was D_8016BAD0: gSoundBanks[0]; the doc comment above that array names entry 0 "Player Bank size 9", matching this array's length.
 SoundBankEntry sPlayerBank[9];  // was D_8016BAD0 [LLM:HIGH]
-SoundBankEntry D_8016BC80[12];
+// LLM generated name (HIGH), was D_8016BC80: gSoundBanks[1]; the same comment names entry 1 "Item Bank size 12".
+SoundBankEntry sItemBank[12];  // was D_8016BC80 [LLM:HIGH]
 SoundBankEntry D_8016BEC0[22];
 SoundBankEntry D_8016C2E0[20];
 SoundBankEntry D_8016C6A0[8];
@@ -72,11 +73,11 @@ u8 sSoundRequestReadIndex = 0;
  * 6 : Voice Bank           size 5
  */
 SoundBankEntry* gSoundBanks[7] = {
-    sPlayerBank, D_8016BC80, D_8016BEC0, D_8016C2E0, D_8016C6A0, D_8016C820, D_8016C8B0,  // was D_8016BAD0 [LLM:HIGH]
+    sPlayerBank, sItemBank, D_8016BEC0, D_8016C2E0, D_8016C6A0, D_8016C820, D_8016C8B0,  // was D_8016BAD0 [LLM:HIGH]
 };
 
 u8 sBankSizes[ARRAY_COUNT(gSoundBanks)] = {
-    ARRAY_COUNT(sPlayerBank), ARRAY_COUNT(D_8016BC80), ARRAY_COUNT(D_8016BEC0), ARRAY_COUNT(D_8016C2E0),  // was D_8016BAD0 [LLM:HIGH]
+    ARRAY_COUNT(sPlayerBank), ARRAY_COUNT(sItemBank), ARRAY_COUNT(D_8016BEC0), ARRAY_COUNT(D_8016C2E0),  // was D_8016BAD0 [LLM:HIGH]
     ARRAY_COUNT(D_8016C6A0), ARRAY_COUNT(D_8016C820), ARRAY_COUNT(D_8016C8B0),
 };
 
