 void EnNy_UpdateDeath(Actor* thisx, PlayState* PlayState);
 void EnNy_SetupDie(EnNy* this, PlayState* play);
 void EnNy_DrawDeathEffect(Actor* thisx, PlayState* PlayState);
-void func_80ABD3B8(EnNy* this, f32, f32);
+// LLM generated name (HIGH), was func_80ABD3B8: turns gravity off and eases the vertical velocity toward the swim target while the actor is between the two given water depths, and restores normal gravity otherwise.
+void EnNy_UpdateBuoyancy(EnNy* this, f32, f32);  // was func_80ABD3B8 [LLM:HIGH]
 
