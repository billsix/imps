From a3d6b890608790b66618d2ddc42af57d7e000415 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:06:36 +0000
Subject: [PATCH 1967/3799] soh: rename D_8094C872 -> sShieldFlashScroll

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: texture scroll rate of the shield flash, +7 for the reflected beam and -7 for the charge, also selecting the 1.3x scale
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Boss_Tw/z_boss_tw.c   | 23 ++++++++++---------
 1 file changed, 12 insertions(+), 11 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index ec9536b29..e1f3c68c8 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -197,7 +197,8 @@ static u8 sBeamDivertTimer;
 static u8 sShieldFlashTimer;  // was D_8094C86F [LLM:HIGH]
 // LLM generated name (HIGH), was D_8094C870: set while a TWEFF_SHLD_BLST effect lives; BossTw_TwinrovaDoneBlastShoot waits for it to clear
 static u8 sShieldBlastActive;  // was D_8094C870 [LLM:HIGH]
-static s16 D_8094C872;
+// LLM generated name (HIGH), was D_8094C872: texture scroll rate of the shield flash, +7 for the reflected beam and -7 for the charge, also selecting the 1.3x scale
+static s16 sShieldFlashScroll;  // was D_8094C872 [LLM:HIGH]
 static s16 D_8094C874;
 static s16 D_8094C876;
 static u8 D_8094C878;
@@ -475,7 +476,7 @@ void BossTw_Init(Actor* thisx, PlayState* play2) {
         play->envCtx.unk_D8 = 0.0f;
 
         D_8094C874 = D_8094C876 = D_8094C878 = D_8094C87A = D_8094C87C = D_8094C87E = sShieldBlastActive = sShieldFlashTimer =  // was D_8094C86F [LLM:HIGH]
-            D_8094C872 = sBeamDivertTimer = sEnvType = sGroundBlastType = sFreezeState = sTwinrovaBlastType =
+            sShieldFlashScroll = sBeamDivertTimer = sEnvType = sGroundBlastType = sFreezeState = sTwinrovaBlastType =  // was D_8094C872 [LLM:HIGH]
                 sFixedBlatSeq = sShieldFireCharge = sShieldIceCharge = 0;
 
         sShieldFlashAlpha = sShieldChargeAlpha = 0.0f;  // was D_8094C854 [LLM:HIGH]
@@ -3738,18 +3739,18 @@ void BossTw_ShieldChargeDraw(BossTw* this, PlayState* play) {
     }
 
     if (sShieldFlashTimer != 0) {  // was D_8094C86F [LLM:HIGH]
-        f32 step = D_8094C872 > 0 ? 100.0f : 60.0f;
+        f32 step = sShieldFlashScroll > 0 ? 100.0f : 60.0f;  // was D_8094C872 [LLM:HIGH]
 
         sShieldFlashTimer--;  // was D_8094C86F [LLM:HIGH]
         Math_ApproachF(&sShieldFlashAlpha, 255.0f, 1.0f, step);  // was D_8094C858 [LLM:HIGH]
     } else {
-        f32 step = D_8094C872 > 0 ? 40.0f : 20.0f;
+        f32 step = sShieldFlashScroll > 0 ? 40.0f : 20.0f;  // was D_8094C872 [LLM:HIGH]
 
         Math_ApproachF(&sShieldFlashAlpha, 0.0f, 1.0f, step);  // was D_8094C858 [LLM:HIGH]
     }
 
     if (Player_HasMirrorShieldEquipped(play) && sShieldFlashAlpha > 0.0f) {  // was D_8094C858 [LLM:HIGH]
-        f32 scale = D_8094C872 > 0 ? 1.3f : 1.0f;
+        f32 scale = sShieldFlashScroll > 0 ? 1.3f : 1.0f;  // was D_8094C872 [LLM:HIGH]
 
         Matrix_Mult(&player->shieldMf, MTXMODE_NEW);
         Matrix_RotateX(M_PI / 2.0f, MTXMODE_APPLY);
@@ -3764,8 +3765,8 @@ void BossTw_ShieldChargeDraw(BossTw* this, PlayState* play) {
         }
 
         gSPSegment(POLY_XLU_DISP++, 8,
-                   Gfx_TwoTexScrollEx(play->state.gfxCtx, 0, 0, this->work[CS_TIMER_1] * D_8094C872, 0x20, 0x40, 1, 0,
-                                      this->work[CS_TIMER_1] * D_8094C872, 0x20, 0x20, 0, D_8094C872, 0, D_8094C872));
+                   Gfx_TwoTexScrollEx(play->state.gfxCtx, 0, 0, this->work[CS_TIMER_1] * sShieldFlashScroll, 0x20, 0x40, 1, 0,  // was D_8094C872 [LLM:HIGH]
+                                      this->work[CS_TIMER_1] * sShieldFlashScroll, 0x20, 0x20, 0, sShieldFlashScroll, 0, sShieldFlashScroll));  // was D_8094C872 [LLM:HIGH]
         gSPDisplayList(POLY_XLU_DISP++, SEGMENTED_TO_VIRTUAL(gTwinrovaShieldAbsorbAndReflectEffectDL));
     }
 
@@ -3951,7 +3952,7 @@ void BossTw_BlastFire(BossTw* this, PlayState* play) {
 
                         if (this->timers[0] == 50) {
                             sShieldFlashTimer = 10;  // was D_8094C86F [LLM:HIGH]
-                            D_8094C872 = 7;
+                            sShieldFlashScroll = 7;  // was D_8094C872 [LLM:HIGH]
                             play->envCtx.unk_D8 = 1.0f;
                         }
 
@@ -4140,7 +4141,7 @@ void BossTw_BlastIce(BossTw* this, PlayState* play) {
 
                         if (this->timers[0] == 50) {
                             sShieldFlashTimer = 10;  // was D_8094C86F [LLM:HIGH]
-                            D_8094C872 = 7;
+                            sShieldFlashScroll = 7;  // was D_8094C872 [LLM:HIGH]
                             play->envCtx.unk_D8 = 1.0f;
                         }
 
@@ -4334,7 +4335,7 @@ s32 BossTw_BlastShieldCheck(BossTw* this, PlayState* play) {
                             BossTw_AddShieldHitEffect(play, 10.0f, 1);
                             sShieldFireCharge++;
                             sShieldFlashTimer = (sShieldFireCharge * 2) + 8;  // was D_8094C86F [LLM:HIGH]
-                            D_8094C872 = -7;
+                            sShieldFlashScroll = -7;  // was D_8094C872 [LLM:HIGH]
                         }
                     } else {
                         if (sShieldFireCharge != 0) {
@@ -4344,7 +4345,7 @@ s32 BossTw_BlastShieldCheck(BossTw* this, PlayState* play) {
                             BossTw_AddShieldHitEffect(play, 10.0f, 0);
                             sShieldIceCharge++;
                             sShieldFlashTimer = (sShieldIceCharge * 2) + 8;  // was D_8094C86F [LLM:HIGH]
-                            D_8094C872 = -7;
+                            sShieldFlashScroll = -7;  // was D_8094C872 [LLM:HIGH]
                         }
                     }
 
