From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:59:20 +0000
Subject: [PATCH 2992/3799] soh: rename func_80986148 ->
 DemoIm_SetupStopWhistling

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays gImpaStartWhistlingAnim backwards and enters action 14
Defined in soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
index 7a17338a6..6975f3904 100644
--- a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -650,7 +650,8 @@ void DemoIm_ReturnToIdleWhenAnimDone(DemoIm* this, s32 arg1) {
     }
 }
 
-void func_80986148(DemoIm* this) {
+// LLM generated name (HIGH), was func_80986148: plays gImpaStartWhistlingAnim backwards and enters action 14
+void DemoIm_SetupStopWhistling(DemoIm* this) {
     Animation_Change(&this->skelAnime, &gImpaStartWhistlingAnim, -1.0f,
                      Animation_GetLastFrame(&gImpaStartWhistlingAnim), 0.0f, ANIMMODE_ONCE, -8.0f);
     this->action = 14;
@@ -667,7 +668,7 @@ void func_809861C4(DemoIm* this, PlayState* play) {
         if (action != unk_274) {
             switch (action) {
                 case 9:
-                    func_80986148(this);
+                    DemoIm_SetupStopWhistling(this);  // was func_80986148 [LLM:HIGH]
                     break;
                 case 7:
                     Animation_Change(&this->skelAnime, &gImpaWhistlingAnim, 1.0f, 0.0f,
@@ -712,7 +713,7 @@ void func_809862E0(DemoIm* this, PlayState* play) {
                     DemoIm_SetupWhistling(this);  // was func_809860C8 [LLM:HIGH]
                     break;
                 case 9:
-                    func_80986148(this);
+                    DemoIm_SetupStopWhistling(this);  // was func_80986148 [LLM:HIGH]
                     break;
                 default:
                     osSyncPrintf("Demo_Im_Ocarina_Check_DemoMode:そんな動作は無い!!!!!!!!\n");
