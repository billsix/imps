Date: Tue, 8 Sep 2026 00:07:03 +0000
Subject: [PATCH 3186/3799] soh: rename D_8011D6AC ->
 sAttentionPlayerFarKeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the attention keyframes used when the target is the player and the eye is more than 30 units away
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c        | 14 +++++++-------
 soh/src/code/z_camera_data.inc |  3 ++-
 2 files changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 72d8e0b5a..685fa0f6a 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -6058,15 +6058,15 @@ s32 Camera_Demo5(Camera* camera) {
     if (camera->target->category == ACTORCAT_PLAYER) {
         // camera is targeting a(the) player actor
         if (eyePlayerGeo.r > 30.0f) {
-            D_8011D6AC[1].timerInit = camera->timer - 1;
-            D_8011D6AC[1].atTargetInit.z = Rand_ZeroOne() * 10.0f;
-            D_8011D6AC[1].eyeTargetInit.x = Rand_ZeroOne() * 10.0f;
-            ONEPOINT_CS_INFO(camera)->keyFrames = D_8011D6AC;
-            ONEPOINT_CS_INFO(camera)->keyFrameCnt = ARRAY_COUNT(D_8011D6AC);
+            sAttentionPlayerFarKeyFrames[1].timerInit = camera->timer - 1;  // was D_8011D6AC [LLM:HIGH]
+            sAttentionPlayerFarKeyFrames[1].atTargetInit.z = Rand_ZeroOne() * 10.0f;  // was D_8011D6AC [LLM:HIGH]
+            sAttentionPlayerFarKeyFrames[1].eyeTargetInit.x = Rand_ZeroOne() * 10.0f;  // was D_8011D6AC [LLM:HIGH]
+            ONEPOINT_CS_INFO(camera)->keyFrames = sAttentionPlayerFarKeyFrames;  // was D_8011D6AC [LLM:HIGH]
+            ONEPOINT_CS_INFO(camera)->keyFrameCnt = ARRAY_COUNT(sAttentionPlayerFarKeyFrames);  // was D_8011D6AC [LLM:HIGH]
             if (camera->parentCamIdx != CAM_ID_MAIN) {
                 ONEPOINT_CS_INFO(camera)->keyFrameCnt--;
             } else {
-                camera->timer += D_8011D6AC[2].timerInit;
+                camera->timer += sAttentionPlayerFarKeyFrames[2].timerInit;  // was D_8011D6AC [LLM:HIGH]
             }
         } else {
             D_8011D724[1].eyeTargetInit.x = Rand_ZeroOne() * 10.0f;
@@ -8384,7 +8384,7 @@ s16 Camera_SetFinishedFlag(Camera* camera) {
     F(sDemo5PrevAction12Frame)          \
     F(sDemo5PrevSfxFrame)               \
     F(sCameraSkipFrames)                       \
-    F(D_8011D6AC)                       \
+    F(sAttentionPlayerFarKeyFrames)                       \
     F(D_8011D724)                       \
     F(D_8011D79C)                       \
     F(D_8011D83C)                       \
diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index 45490a3f8..245b1c844 100644
