From 45c5c5aadb45aa33cf6f8f85c258c92262360801 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:55:35 +0000
Subject: [PATCH 1182/3799] soh: rename func_80065134 ->
 Cutscene_Command_SetTime

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment above it reads "Command 0x8C: Set Time of Day & Environment Time"; it writes gSaveContext.dayTime and skyboxTime from the command's hour and minute. Named to match the file's other Cutscene_Command_* handlers.
Defined in soh/src/code/z_demo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_demo.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_demo.c b/soh/src/code/z_demo.c
index 886f85936..737671d87 100644
--- a/soh/src/code/z_demo.c
+++ b/soh/src/code/z_demo.c
@@ -498,7 +498,8 @@ void Cutscene_Command_09(PlayState* play, CutsceneContext* csCtx, CsCmdUnknown9*
 }
 
 // Command 0x8C: Set Time of Day & Environment Time
-void func_80065134(PlayState* play, CutsceneContext* csCtx, CsCmdDayTime* cmd) {
+// LLM generated name (HIGH), was func_80065134: the in-tree comment above it reads "Command 0x8C: Set Time of Day & Environment Time"; it writes gSaveContext.dayTime and skyboxTime from the command's hour and minute. Named to match the file's other Cutscene_Command_* handlers.
+void Cutscene_Command_SetTime(PlayState* play, CutsceneContext* csCtx, CsCmdDayTime* cmd) {
     s16 temp1;
     s16 temp2;
 
@@ -1817,7 +1818,7 @@ void Cutscene_ProcessCommands(PlayState* play, CutsceneContext* csCtx, u8* cutsc
                 memcpy(&cmdEntries, cutscenePtr, sizeof(CutsceneData));
                 cutscenePtr += sizeof(CutsceneData);
                 for (j = 0; j < cmdEntries; j++) {
-                    func_80065134(play, csCtx, (void*)cutscenePtr);
+                    Cutscene_Command_SetTime(play, csCtx, (void*)cutscenePtr);  // was func_80065134 [LLM:HIGH]
                     cutscenePtr += sizeof(CutsceneData) * 3;
                 }
                 break;
