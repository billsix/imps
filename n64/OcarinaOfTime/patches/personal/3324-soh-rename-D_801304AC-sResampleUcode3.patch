From cc9c05fd6e51590ff9eab2631ad5d694ab6aac98 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:31 +0000
Subject: [PATCH 3324/3799] soh: rename D_801304AC -> sResampleUcode3

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the fourth such word
Defined in soh/src/code/audio_synthesis.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_synthesis.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_synthesis.c b/soh/src/code/audio_synthesis.c
index 3532c9688..eaa50bbeb 100644
--- a/soh/src/code/audio_synthesis.c
+++ b/soh/src/code/audio_synthesis.c
@@ -37,7 +37,8 @@ u32 sResampleUcode0 = 0x13000000;  // was D_801304A0 [LLM:GUESS]
 u32 sResampleUcode1 = 0x5CAEC8E2;  // was D_801304A4 [LLM:GUESS]
 // LLM generated name (GUESS), was D_801304A8: the third such word
 u32 sResampleUcode2 = 0x945CC8E2;  // was D_801304A8 [LLM:GUESS]
-u32 D_801304AC = 0x94AEC8E2;
+// LLM generated name (GUESS), was D_801304AC: the fourth such word
+u32 sResampleUcode3 = 0x94AEC8E2;  // was D_801304AC [LLM:GUESS]
 
 // LLM generated name (GUESS), was D_801304B0: u16[8] of alternating near-extreme values with no reader anywhere in the tree; the shape suggests a mixing or envelope table, but nothing uses it to confirm.
 u16 gUnusedSynthTable[] = {  // was D_801304B0 [LLM:GUESS]
@@ -1194,13 +1195,13 @@ Acmd* AudioSynth_ProcessEnvelope(Acmd* cmd, NoteSubEu* noteSubEu, NoteSynthesisS
                 phi_a1 = sResampleUcode2;  // was D_801304A8 [LLM:GUESS]
                 break;
             default:
-                phi_a1 = D_801304AC;
+                phi_a1 = sResampleUcode3;  // was D_801304AC [LLM:GUESS]
                 break;
         }
     } else {
         aEnvSetup1(cmd++, phi_t1 * 2, rampReverb, rampLeft, rampRight);
         aEnvSetup2(cmd++, curVolLeft, curVolRight);
-        phi_a1 = D_801304AC;
+        phi_a1 = sResampleUcode3;  // was D_801304AC [LLM:GUESS]
     }
 
     aEnvMixer(cmd++, inBuf, aiBufLen, (sourceReverbVol & 0x80) >> 7, noteSubEu->bitField0.stereoHeadsetEffects,
-- 
