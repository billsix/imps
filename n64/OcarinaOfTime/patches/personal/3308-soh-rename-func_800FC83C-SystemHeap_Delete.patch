From c2ff41035167363d10cfd6fa8b47423f58697376 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:24 +0000
Subject: [PATCH 3308/3799] soh: rename func_800FC83C -> SystemHeap_Delete

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: frees a system arena block, tolerating NULL
Defined in soh/src/code/system_heap.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h    | 2 +-
 soh/src/code/system_heap.c | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 9af21c2f7..3b8a14240 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -2189,7 +2189,7 @@ void MtxConv_L2F(MtxF* m1, Mtx* m2);
 void Overlay_Relocate(void* allocatedVRamAddress, OverlayRelocationSection* overlayInfo, void* vRamAddress);
 s32 Overlay_Load(uintptr_t vRomStart, uintptr_t vRomEnd, void* vRamStart, void* vRamEnd, void* allocatedVRamAddress);
 // ? SystemHeap_New(?);, was func_800FC800 [LLM:HIGH]
-// ? func_800FC83C(?);
+// ? SystemHeap_Delete(?);, was func_800FC83C [LLM:HIGH]
 // ? func_800FCAB4(?);
 void SystemHeap_Init(void* start, size_t size);
 void PadUtils_Init(Input* input);
diff --git a/soh/src/code/system_heap.c b/soh/src/code/system_heap.c
index c9c45f18d..ec77ace09 100644
--- a/soh/src/code/system_heap.c
+++ b/soh/src/code/system_heap.c
@@ -107,7 +107,8 @@ void* SystemHeap_New(size_t size) {
 }
 
 // possible some kind of delete() function
-void func_800FC83C(void* ptr) {
+// LLM generated name (HIGH), was func_800FC83C: frees a system arena block, tolerating NULL
+void SystemHeap_Delete(void* ptr) {
     if (ptr != NULL) {
         __osFree(&gSystemArena, ptr);
     }
@@ -170,7 +171,7 @@ void func_800FCA18(void* blk, u32 nBlk, u32 blkSize, arg3_800FCA18 arg3, s32 arg
     }
 
     if (arg4 != 0) {
-        func_800FC83C(blk);
+        SystemHeap_Delete(blk);  // was func_800FC83C [LLM:HIGH]
     }
 }
 
