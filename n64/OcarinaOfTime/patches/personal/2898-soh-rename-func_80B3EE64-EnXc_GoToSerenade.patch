     this->action = SHEIK_ACTION_SERENADE;
 }
 
@@ -2399,7 +2400,7 @@ void EnXc_Init(Actor* thisx, PlayState* play) {
             EnXc_GoToAction20(this, play);  // was func_80B3EBF0 [LLM:HIGH]
