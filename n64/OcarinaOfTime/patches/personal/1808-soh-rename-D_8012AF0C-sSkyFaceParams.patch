From 5c40805da54f34acdf3ccc27b580501ee4eb2211 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:17 +0000
Subject: [PATCH 1808/3799] soh: rename D_8012AF0C -> sSkyFaceParams

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the six outdoor-skybox faces, each carrying the five parameters the sky face builder needs.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 90e11f8ce..138168639 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -159,7 +159,8 @@ Struct_8012AF0C sRoomFaceParams[4] = {  // was D_8012AEBC [LLM:HIGH]
     { -0x7E, 0x7C, 0x7E, -0x3F, -0x1F },
 };
 
-Struct_8012AF0C D_8012AF0C[6] = {
+// LLM generated name (HIGH), was D_8012AF0C: the six outdoor-skybox faces, each carrying the five parameters the sky face builder needs.
+Struct_8012AF0C sSkyFaceParams[6] = {  // was D_8012AF0C [LLM:HIGH]
     { -0x40, 0x40, -0x40, 0x20, -0x20 }, { 0x40, 0x40, 0x40, -0x20, -0x20 }, { -0x40, 0x40, 0x40, -0x20, -0x20 },
     { 0x40, 0x40, -0x40, 0x20, -0x20 },  { -0x40, 0x40, 0x40, 0x20, -0x20 }, { -0x40, -0x40, -0x40, 0x20, 0x20 },
 };
@@ -458,8 +459,8 @@ void func_800AF178(SkyboxContext* skyboxCtx, s32 arg1) {
     s32 i;
 
     for (i = 0; i < arg1; i++) {
-        phi_s2 = func_800AE2C0(skyboxCtx, skyboxCtx->roomVtx, phi_s2, D_8012AF0C[i].unk_0, D_8012AF0C[i].unk_4,
-                               D_8012AF0C[i].unk_8, D_8012AF0C[i].unk_C, D_8012AF0C[i].unk_10, i);
+        phi_s2 = func_800AE2C0(skyboxCtx, skyboxCtx->roomVtx, phi_s2, sSkyFaceParams[i].unk_0, sSkyFaceParams[i].unk_4,  // was D_8012AF0C [LLM:HIGH]
+                               sSkyFaceParams[i].unk_8, sSkyFaceParams[i].unk_C, sSkyFaceParams[i].unk_10, i);  // was D_8012AF0C [LLM:HIGH]
     }
 }
 
