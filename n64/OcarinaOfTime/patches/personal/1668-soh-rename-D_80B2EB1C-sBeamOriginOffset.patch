From 3739b223b09c250ef38852812f7777bc6d10c05e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:08 +0000
Subject: [PATCH 1668/3799] soh: rename D_80B2EB1C -> sBeamOriginOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the local-space point the beam is emitted from, transformed by the eye limb's matrix.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index 22f137cb9..dd8b7ed83 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -109,7 +109,8 @@ static Vec3f sBeamFarRightTemplate = { 500.0f, 0.0f, 0.0f };  // was D_80B2EB04
 // LLM generated name (HIGH), was D_80B2EB10: the matching template for the beam quad's far left corner.
 static Vec3f sBeamFarLeftTemplate = { -500.0f, 0.0f, 0.0f };  // was D_80B2EB10 [LLM:HIGH]
 
-static Vec3f D_80B2EB1C = { 0.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80B2EB1C: the local-space point the beam is emitted from, transformed by the eye limb's matrix.
+static Vec3f sBeamOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_80B2EB1C [LLM:HIGH]
 
 static Vec3f D_80B2EB28 = { 0.0f, 0.0f, 1600.0f };
 
@@ -482,7 +483,7 @@ void EnVm_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
     f32 dist;
 
     if (limbIndex == 2) {
-        Matrix_MultVec3f(&D_80B2EB1C, &this->beamPos1);
+        Matrix_MultVec3f(&sBeamOriginOffset, &this->beamPos1);  // was D_80B2EB1C [LLM:HIGH]
         Matrix_MultVec3f(&D_80B2EB28, &this->beamPos2);
 
         if (this->unk_260 >= 3) {
-- 
