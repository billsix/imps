From 256d03f32c61db5ce2eb43a24fea7735aff8eccd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:38 +0000
Subject: [PATCH 3074/3799] soh: rename D_80120FA4 -> sCs2230KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 2230 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 8 ++++----
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 0d4b39e5f..7e3b5f65a 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -22,7 +22,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs2260KeyFrames)                                   \
     F(sCs2270KeyFrames)                                   \
     F(sCs2280KeyFrames)                                   \
-    F(D_80120FA4)                                   \
+    F(sCs2230KeyFrames)                                   \
     F(D_80121184)                                   \
     F(D_801211D4)                                   \
     F(D_8012133C)                                   \
@@ -236,11 +236,11 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             break;
         case 2230:
             if (player->actor.world.pos.z < 1000.0f) {
-                D_80120FA4[0].eyeTargetInit.x = -D_80120FA4[0].eyeTargetInit.x;
-                D_80120FA4[2].eyeTargetInit.x = -D_80120FA4[2].eyeTargetInit.x;
+                sCs2230KeyFrames[0].eyeTargetInit.x = -sCs2230KeyFrames[0].eyeTargetInit.x;  // was D_80120FA4 [LLM:HIGH]
+                sCs2230KeyFrames[2].eyeTargetInit.x = -sCs2230KeyFrames[2].eyeTargetInit.x;  // was D_80120FA4 [LLM:HIGH]
             }
 
-            csInfo->keyFrames = D_80120FA4;
+            csInfo->keyFrames = sCs2230KeyFrames;  // was D_80120FA4 [LLM:HIGH]
             csInfo->keyFrameCnt = 6;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index c35337725..d65b668ba 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -215,7 +215,8 @@ static OnePointCsFull sCs2220KeyFrames[8] = {  // was D_80120E64 [LLM:HIGH]
     { 0x12, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80120FA4[6] = {
+// LLM generated name (HIGH), was D_80120FA4: the keyframe set one-point cutscene 2230 installs
+static OnePointCsFull sCs2230KeyFrames[6] = {  // was D_80120FA4 [LLM:HIGH]
     { 0x8F, 0x01, 0x2143, 30, 0, 70.0f, 0.4f, { 0.0f, 40.0f, 50.0f }, { 30.0f, 10.0f, -50.0f } },
     { 0x95, 0xFF, 0x0000, 1, 0, 50.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
     { 0x8F, 0xFF, 0x2222, 10, 0, 42.0f, 1.0f, { 0.0f, 40.0f, 0.0f }, { 0.0f, 85.0f, 45.0f } },
