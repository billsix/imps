From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:38:31 +0000
Subject: [PATCH 1047/3799] soh: rename func_808B95B8 ->
 BgSpot18Shutter_WaitForSwitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the child-Link idle: waits for the switch flag, then aims the attention camera and starts the upward slide.
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c     | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c
index 6946a39e9..c352f9a5b 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Shutter/z_bg_spot18_shutter.c
@@ -16,7 +16,8 @@ void BgSpot18Shutter_Draw(Actor* thisx, PlayState* play);
 
 // LLM generated name (HIGH), was func_808B95AC: empty action installed once the door has finished opening, and at Init when it is already open.
 void BgSpot18Shutter_DoNothing(BgSpot18Shutter* this, PlayState* play);  // was func_808B95AC [LLM:HIGH]
-void func_808B95B8(BgSpot18Shutter* this, PlayState* play);
+// LLM generated name (HIGH), was func_808B95B8: the child-Link idle: waits for the switch flag, then aims the attention camera and starts the upward slide.
+void BgSpot18Shutter_WaitForSwitch(BgSpot18Shutter* this, PlayState* play);  // was func_808B95B8 [LLM:HIGH]
 void func_808B9618(BgSpot18Shutter* this, PlayState* play);
 void func_808B9698(BgSpot18Shutter* this, PlayState* play);
 void func_808B971C(BgSpot18Shutter* this, PlayState* play);
@@ -60,7 +61,7 @@ void BgSpot18Shutter_Init(Actor* thisx, PlayState* play) {
                 this->actionFunc = BgSpot18Shutter_DoNothing;  // was func_808B95AC [LLM:HIGH]
                 this->dyna.actor.world.pos.y += 180.0f;
             } else {
-                this->actionFunc = func_808B95B8;
+                this->actionFunc = BgSpot18Shutter_WaitForSwitch;  // was func_808B95B8 [LLM:HIGH]
             }
         }
     } else {
@@ -86,7 +87,7 @@ void BgSpot18Shutter_Destroy(Actor* thisx, PlayState* play) {
 void BgSpot18Shutter_DoNothing(BgSpot18Shutter* this, PlayState* play) {
 }
 
-void func_808B95B8(BgSpot18Shutter* this, PlayState* play) {
+void BgSpot18Shutter_WaitForSwitch(BgSpot18Shutter* this, PlayState* play) {
     if (Flags_GetSwitch(play, this->dyna.actor.params & 0x3F)) {
         Actor_SetFocus(&this->dyna.actor, 70.0f);
         OnePointCutscene_Attention(play, &this->dyna.actor);
