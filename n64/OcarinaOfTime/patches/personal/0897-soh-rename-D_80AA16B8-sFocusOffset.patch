From 85acfc765f8b8fb17aca52da030eb2db9eec06b9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:19:10 +0000
Subject: [PATCH 0897/3799] soh: rename D_80AA16B8 -> sFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Vec3f { 800, 0, 0 } fed to Matrix_MultVec3f from EnMa1_PostLimbDraw at limb 15 to place actor.focus.pos.
Defined in soh/src/overlays/actors/ovl_En_Ma1/z_en_ma1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ma1/z_en_ma1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ma1/z_en_ma1.c b/soh/src/overlays/actors/ovl_En_Ma1/z_en_ma1.c
index 0ede49646..6559ee619 100644
--- a/soh/src/overlays/actors/ovl_En_Ma1/z_en_ma1.c
+++ b/soh/src/overlays/actors/ovl_En_Ma1/z_en_ma1.c
@@ -78,7 +78,8 @@ static AnimationFrameCountInfo sAnimationInfo[] = {
     { &gMalonChildSingAnim, 1.0f, ANIMMODE_LOOP, -10.0f },
 };
 
-static Vec3f D_80AA16B8 = { 800.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80AA16B8: Vec3f { 800, 0, 0 } fed to Matrix_MultVec3f from EnMa1_PostLimbDraw at limb 15 to place actor.focus.pos.
+static Vec3f sFocusOffset = { 800.0f, 0.0f, 0.0f };  // was D_80AA16B8 [LLM:HIGH]
 
 static void* sMouthTextures[] = {
     gMalonChildNeutralMouthTex,
@@ -463,7 +464,7 @@ s32 EnMa1_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* p
 
 void EnMa1_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
     EnMa1* this = (EnMa1*)thisx;
-    Vec3f vec = D_80AA16B8;
+    Vec3f vec = sFocusOffset;  // was D_80AA16B8 [LLM:HIGH]
 
     if (limbIndex == 15) {
         Matrix_MultVec3f(&vec, &this->actor.focus.pos);
