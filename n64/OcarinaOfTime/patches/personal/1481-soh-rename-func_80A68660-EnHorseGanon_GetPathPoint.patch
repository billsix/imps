From 60a333aec630dcd76e830b1bf49f4b7fc7eec172 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:44 +0000
Subject: [PATCH 1481/3799] soh: rename func_80A68660 ->
 EnHorseGanon_GetPathPoint

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: copies one sPathPoints entry's position into a Vec3f.
Defined in soh/src/overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c b/soh/src/overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c
index 975af2dbf..12ad2a4eb 100644
--- a/soh/src/overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c
+++ b/soh/src/overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c
@@ -110,7 +110,8 @@ static InitChainEntry sInitChain[] = {
 
 static EnHorseGanonActionFunc sActionFuncs[] = { func_80A68AF0, func_80A68DB0 };
 
-void func_80A68660(unk_D_80A69248* data, s32 index, Vec3f* vec) {
+// LLM generated name (HIGH), was func_80A68660: copies one sPathPoints entry's position into a Vec3f.
+void EnHorseGanon_GetPathPoint(unk_D_80A69248* data, s32 index, Vec3f* vec) {
     vec->x = data[index].unk_0.x;
     vec->y = data[index].unk_0.y;
     vec->z = data[index].unk_0.z;
@@ -121,12 +122,12 @@ void func_80A686A8(EnHorseGanon* this, PlayState* play) {
     Vec3f vec;
     s16 y;
 
-    func_80A68660(sPathPoints, this->unk_1EC, &vec);  // was D_80A69248 [LLM:HIGH]
+    EnHorseGanon_GetPathPoint(sPathPoints, this->unk_1EC, &vec);  // was D_80A69248 [LLM:HIGH]
     if (Math3D_Vec3f_DistXYZ(&vec, &this->actor.world.pos) <= 400.0f) {
         this->unk_1EC += 1;
         if (this->unk_1EC >= 14) {
             this->unk_1EC = 0;
-            func_80A68660(sPathPoints, 0, &vec);  // was D_80A69248 [LLM:HIGH]
+            EnHorseGanon_GetPathPoint(sPathPoints, 0, &vec);  // was D_80A69248 [LLM:HIGH]
         }
     }
 
