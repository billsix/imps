From 4503adfb687868d7fae8d359cf5670d1e4f9f20c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:12 +0000
Subject: [PATCH 0615/3799] soh: rename D_8015FD7E -> sSunDepthTestX

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/z_kankyo.c.
---
 soh/src/code/z_kankyo.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_kankyo.c b/soh/src/code/z_kankyo.c
index da8216663..2f2b71e65 100644
--- a/soh/src/code/z_kankyo.c
+++ b/soh/src/code/z_kankyo.c
@@ -217,7 +217,8 @@ s16 gLensFlareScreenFillAlpha;
 LightningBolt sLightningBolts[3];
 LightningStrike gLightningStrike;
 s16 sLightningFlashAlpha;
-s16 D_8015FD7E;
+// Name from zeldaret/oot (was D_8015FD7E): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_kankyo.c]
+s16 sSunDepthTestX;
 s16 D_8015FD80;
 LightNode* sNGameOverLightNode;
 LightInfo sNGameOverLightInfo;
@@ -244,10 +245,10 @@ u16 Environment_GetPixelDepth(s32 x, s32 y) {
 void Environment_GraphCallback(GraphicsContext* gfxCtx, void* param) {
     PlayState* play = (PlayState*)param;
 
-    OTRGetPixelDepthPrepare(D_8015FD7E, D_8015FD80);
+    OTRGetPixelDepthPrepare(sSunDepthTestX, D_8015FD80);
     Lights_GlowCheckPrepare(play);
 
-    D_8011FB44 = Environment_GetPixelDepth(D_8015FD7E, D_8015FD80);
+    D_8011FB44 = Environment_GetPixelDepth(sSunDepthTestX, D_8015FD80);
     Lights_GlowCheck(play);
 }
 
@@ -1523,7 +1524,7 @@ void Environment_DrawLensFlare(PlayState* play, EnvironmentContext* envCtx, View
         if (arg9) {
             u32 shrink = ShrinkWindow_GetCurrentVal();
             Play_GetScreenPos(play, &pos, &screenPos);
-            D_8015FD7E = (s16)screenPos.x;
+            sSunDepthTestX = (s16)screenPos.x;
             D_8015FD80 = (s16)screenPos.y - 5.0f;
             if (D_8011FB44 != 0xFFFC || screenPos.x < 0.0f || screenPos.y < shrink || screenPos.x > SCREEN_WIDTH ||
                 screenPos.y > (SCREEN_HEIGHT - shrink)) {
-- 
2.55.0

