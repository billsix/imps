From b8e4bf83e2ea9595325df4e665306f3e16118784 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:39 +0000
Subject: [PATCH 457/488] soh: rename D_80AE81AC -> sRlCsRunning

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the latch that a cutscene was running, so its end can be detected next update
Defined in soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c b/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
index eb45a414f..4a9fdc33f 100644
--- a/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
+++ b/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
@@ -41,11 +41,12 @@ void EnRl_DrawXlu(EnRl* this, PlayState* play);  // was func_80AE7D94 [LLM:HIGH]
 
 // LLM generated name (HIGH), was D_80AE81A0: the three eye textures indexed by the blink counter
 static void* sEyeTextures[] = { object_rl_Tex_003620, object_rl_Tex_003960, object_rl_Tex_003B60 };  // was D_80AE81A0 [LLM:HIGH]
-static s32 D_80AE81AC = 0;
+// LLM generated name (HIGH), was D_80AE81AC: the latch that a cutscene was running, so its end can be detected next update
+static s32 sRlCsRunning = 0;  // was D_80AE81AC [LLM:HIGH]
 
 void EnRl_Destroy(Actor* thisx, PlayState* play) {
     EnRl* this = (EnRl*)thisx;
-    D_80AE81AC = 0;
+    sRlCsRunning = 0;  // was D_80AE81AC [LLM:HIGH]
     SkelAnime_Free(&this->skelAnime, play);
 }
 
@@ -81,14 +82,14 @@ void EnRl_SetupFadedOut(EnRl* this) {
 void EnRl_WatchCutsceneEnd(EnRl* this, PlayState* play) {
 
     if (play->csCtx.state == CS_STATE_IDLE) {
-        if (D_80AE81AC) {
+        if (sRlCsRunning) {  // was D_80AE81AC [LLM:HIGH]
             if (this->actor.params == 2) {
                 EnRl_SetupFadedOut(this);  // was func_80AE7358 [LLM:HIGH]
             }
-            D_80AE81AC = 0;
+            sRlCsRunning = 0;  // was D_80AE81AC [LLM:HIGH]
         }
-    } else if (!D_80AE81AC) {
-        D_80AE81AC = 1;
+    } else if (!sRlCsRunning) {  // was D_80AE81AC [LLM:HIGH]
+        sRlCsRunning = 1;  // was D_80AE81AC [LLM:HIGH]
     }
 }
 
