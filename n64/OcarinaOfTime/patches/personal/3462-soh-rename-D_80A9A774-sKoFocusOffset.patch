From 191517557d4e48579e1b929e8ebaefa3176e1ab7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:14 +0000
Subject: [PATCH 3462/3799] soh: rename D_80A9A774 -> sKoFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the zero vector EnKo_PostLimbDraw records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
index b42298169..5cbdeafaf 100644
--- a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
+++ b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
@@ -1364,14 +1364,14 @@ s32 EnKo_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 void EnKo_PostLimbDraw(PlayState* play2, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx, Gfx** gfx) {
     PlayState* play = play2;
     EnKo* this = (EnKo*)thisx;
-    Vec3f D_80A9A774 = { 0.0f, 0.0f, 0.0f };
+    Vec3f sKoFocusOffset = { 0.0f, 0.0f, 0.0f };  // was D_80A9A774 [LLM:HIGH]
 
     if (limbIndex == 7) {
         gSPSegment((*gfx)++, 0x06, play->objectCtx.status[this->bodyObjectBankIdx].segment);
         gSegments[6] = VIRTUAL_TO_PHYSICAL(play->objectCtx.status[this->bodyObjectBankIdx].segment);
     }
     if (limbIndex == 15) {
-        Matrix_MultVec3f(&D_80A9A774, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sKoFocusOffset, &this->actor.focus.pos);  // was D_80A9A774 [LLM:HIGH]
     }
 }
 
