From 6782f620597f1aae7f57476ba00d8163b77880fd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:30 +0000
Subject: [PATCH 0169/3799] soh: rename D_809CE3C4 -> sTransformEffectOffset

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c b/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
index 8344aed17..9ff24b319 100644
--- a/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
+++ b/soh/src/overlays/actors/ovl_En_Butte/z_en_butte.c
@@ -111,7 +111,9 @@ void EnButte_UpdateTransformationEffect(void) {
 }
 
 void EnButte_DrawTransformationEffect(EnButte* this, PlayState* play) {
-    static Vec3f D_809CE3C4 = { 0.0f, 0.0f, -3.0f };
+    // LLM generated name (HIGH), was D_809CE3C4: Vec3f offset fed to Matrix_MultVec3f to place the transformation
+    // flash effect.
+    static Vec3f sTransformEffectOffset = { 0.0f, 0.0f, -3.0f };
     Vec3f sp5C;
     s32 alpha;
     Vec3s camDir;
@@ -127,7 +129,7 @@ void EnButte_DrawTransformationEffect(EnButte* this, PlayState* play) {
     Matrix_RotateY(camDir.y * (M_PI / 0x8000), MTXMODE_NEW);
     Matrix_RotateX(camDir.x * (M_PI / 0x8000), MTXMODE_APPLY);
     Matrix_RotateZ(camDir.z * (M_PI / 0x8000), MTXMODE_APPLY);
-    Matrix_MultVec3f(&D_809CE3C4, &sp5C);
+    Matrix_MultVec3f(&sTransformEffectOffset, &sp5C);
     Matrix_SetTranslateRotateYXZ(this->actor.focus.pos.x + sp5C.x, this->actor.focus.pos.y + sp5C.y,
                                  this->actor.focus.pos.z + sp5C.z, &camDir);
     Matrix_Scale(sTransformationEffectScale, sTransformationEffectScale, sTransformationEffectScale, MTXMODE_APPLY);
-- 
