From 7683c914ce65b4df12ce68cc70fccedc5d7ca2d3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:16:31 +0000
Subject: [PATCH 1394/3799] soh: rename func_80AFCDF8 -> EnSkb_SetupEmerge

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: starts the uncurling animation with the appearing sfx, hides the actor from targeting and installs the emerging action.
Defined in soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
index 607236977..10b550039 100644
--- a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
+++ b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
@@ -12,7 +12,8 @@ void EnSkb_Draw(Actor* thisx, PlayState* play);
 
 // LLM generated name (HIGH), was func_80AFCD60: the shared dispatch every finished action returns to: it burrows away in daylight, attacks when the player is close and in front, and otherwise walks.
 void EnSkb_ChooseAction(EnSkb* this);  // was func_80AFCD60 [LLM:HIGH]
-void func_80AFCDF8(EnSkb* this);
+// LLM generated name (HIGH), was func_80AFCDF8: starts the uncurling animation with the appearing sfx, hides the actor from targeting and installs the emerging action.
+void EnSkb_SetupEmerge(EnSkb* this);  // was func_80AFCDF8 [LLM:HIGH]
 void func_80AFCE5C(EnSkb* this, PlayState* play);
 void func_80AFCF48(EnSkb* this);
 void func_80AFCFF0(EnSkb* this, PlayState* play);
@@ -176,7 +177,7 @@ void EnSkb_Init(Actor* thisx, PlayState* play) {
     this->collider.elements[1].dim.modelSphere.radius = paramOffsetArm;
     this->actor.home.pos = this->actor.world.pos;
     this->actor.floorHeight = this->actor.world.pos.y;
-    func_80AFCDF8(this);
+    EnSkb_SetupEmerge(this);  // was func_80AFCDF8 [LLM:HIGH]
 }
 
 void EnSkb_Destroy(Actor* thisx, PlayState* play) {
@@ -206,7 +207,7 @@ void EnSkb_ChooseAction(EnSkb* this) {
     }
 }
 
-void func_80AFCDF8(EnSkb* this) {
+void EnSkb_SetupEmerge(EnSkb* this) {
     Animation_PlayOnceSetSpeed(&this->skelAnime, &gStalchildUncurlingAnim, 1.0f);
     this->actionState = 0;
     this->actor.flags &= ~ACTOR_FLAG_ATTENTION_ENABLED;
