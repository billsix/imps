Subject: [PATCH 2746/3799] soh: rename func_8002DFA4 -> DynaPolyActor_AddPush

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: adds to the push accumulator and records the pushing direction
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h                             | 2 +-
 soh/src/code/z_actor.c                              | 3 ++-
 soh/src/overlays/actors/ovl_player_actor/z_player.c | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 6a014e511..4cde13077 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -431,7 +431,7 @@ void Actor_InitPlayerHorse(PlayState* play, Player* player);
 s32 Player_SetCsAction(PlayState* play, Actor* actor, u8 csMode);
 s32 Player_SetCsActionWithHaltedActors(PlayState* play, Actor* actor, u8 arg2);
 void DynaPolyActor_ClearPush(DynaPolyActor* dynaActor);  // was func_8002DF90 [LLM:HIGH]
-void func_8002DFA4(DynaPolyActor* dynaActor, f32 arg1, s16 arg2);
+void DynaPolyActor_AddPush(DynaPolyActor* dynaActor, f32 arg1, s16 arg2);  // was func_8002DFA4 [LLM:HIGH]
 s32 Player_IsFacingActor(Actor* actor, s16 angle, PlayState* play);
 s32 Actor_ActorBIsFacingActorA(Actor* actorA, Actor* actorB, s16 angle);
 s32 Actor_IsFacingPlayer(Actor* actor, s16 angle);
diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 61b89ad52..b6b66909f 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -1509,7 +1509,8 @@ void DynaPolyActor_ClearPush(DynaPolyActor* dynaActor) {
     dynaActor->unk_150 = 0.0f;
 }
 
-void func_8002DFA4(DynaPolyActor* dynaActor, f32 arg1, s16 arg2) {
+// LLM generated name (HIGH), was func_8002DFA4: adds to the push accumulator and records the pushing direction
+void DynaPolyActor_AddPush(DynaPolyActor* dynaActor, f32 arg1, s16 arg2) {
     dynaActor->unk_150 += arg1;
     dynaActor->unk_158 = arg2;
 }
diff --git a/soh/src/overlays/actors/ovl_player_actor/z_player.c b/soh/src/overlays/actors/ovl_player_actor/z_player.c
index 193824261..2b1e34b93 100644
--- a/soh/src/overlays/actors/ovl_player_actor/z_player.c
+++ b/soh/src/overlays/actors/ovl_player_actor/z_player.c
@@ -12966,7 +12966,7 @@ void func_8084B840(PlayState* play, Player* this, f32 arg2) {
         DynaPolyActor* dynaPolyActor = DynaPoly_GetActor(&play->colCtx, this->actor.wallBgId);
 
         if (dynaPolyActor != NULL) {
-            func_8002DFA4(dynaPolyActor, arg2, this->actor.world.rot.y);
+            DynaPolyActor_AddPush(dynaPolyActor, arg2, this->actor.world.rot.y);  // was func_8002DFA4 [LLM:HIGH]
         }
     }
 }
