From 539e57d77429e9291aa8cb19558b73447d1a13f2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:25:46 +0000
Subject: [PATCH 1536/3799] soh: rename D_80A784D0 -> sShieldTri1Offsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the three corners of the shield collider's second triangle, completing the quad.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index fc9826cb1..d61fa4527 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -908,7 +908,8 @@ static Vec3f sShieldTri0Offsets[] = {  // was D_80A784AC [LLM:HIGH]
     { 4000.0, -700.0, 2000.0 },
 };
 
-static Vec3f D_80A784D0[] = {
+// LLM generated name (HIGH), was D_80A784D0: the three corners of the shield collider's second triangle, completing the quad.
+static Vec3f sShieldTri1Offsets[] = {  // was D_80A784D0 [LLM:HIGH]
     { 4000.0, -700.0, 2000.0 },
     { 4000.0, -700.0, -5000.0 },
     { -3000.0, -700.0, -5000.0 },
@@ -953,7 +954,7 @@ void EnIk_PostLimbDraw3(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
         if (this->unk_2F8 == 9) {
             for (i = 0; i < ARRAY_COUNT(sp78); i++) {
                 Matrix_MultVec3f(&sShieldTri0Offsets[i], &sp9C[i]);  // was D_80A784AC [LLM:HIGH]
-                Matrix_MultVec3f(&D_80A784D0[i], &sp78[i]);
+                Matrix_MultVec3f(&sShieldTri1Offsets[i], &sp78[i]);  // was D_80A784D0 [LLM:HIGH]
             }
 
             Collider_SetTrisVertices(&this->shieldCollider, 0, &sp9C[0], &sp9C[1], &sp9C[2]);
-- 
