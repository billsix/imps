Subject: [PATCH 030/488] soh: rename func_80865ECC ->
 ArrowFire_ApproachTrailPos

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_Arrow_Fire/z_arrow_fire.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_Arrow_Fire/z_arrow_fire.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Arrow_Fire/z_arrow_fire.c b/soh/src/overlays/actors/ovl_Arrow_Fire/z_arrow_fire.c
index 507366950..a4460ba0d 100644
--- a/soh/src/overlays/actors/ovl_Arrow_Fire/z_arrow_fire.c
+++ b/soh/src/overlays/actors/ovl_Arrow_Fire/z_arrow_fire.c
@@ -86,7 +86,8 @@ void ArrowFire_Charge(ArrowFire* this, PlayState* play) {
     }
 }
 
-void func_80865ECC(Vec3f* unkPos, Vec3f* firePos, f32 scale) {
+// LLM generated name (HIGH), was func_80865ECC: lerps a trail position toward the fire position by scale.
+void ArrowFire_ApproachTrailPos(Vec3f* unkPos, Vec3f* firePos, f32 scale) {
     unkPos->x += ((firePos->x - unkPos->x) * scale);
     unkPos->y += ((firePos->y - unkPos->y) * scale);
     unkPos->z += ((firePos->z - unkPos->z) * scale);
@@ -161,7 +162,7 @@ void ArrowFire_Fly(ArrowFire* this, PlayState* play) {
     if (distanceScaled < 1.0f) {
         this->unk_158 = 1.0f;
     }
-    func_80865ECC(&this->unkPos, &this->actor.world.pos, 0.05f);
+    ArrowFire_ApproachTrailPos(&this->unkPos, &this->actor.world.pos, 0.05f);
 
     if (arrow->hitFlags & 1) {
         Audio_PlayActorSound2(&this->actor, NA_SE_IT_EXPLOSION_FRAME);
