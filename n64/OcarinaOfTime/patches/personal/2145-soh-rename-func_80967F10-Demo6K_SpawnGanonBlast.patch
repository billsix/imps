Date: Mon, 7 Sep 2026 23:14:11 +0000
Subject: [PATCH 2145/3799] soh: rename func_80967F10 -> Demo6K_SpawnGanonBlast

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the params 12 update: spawns the params 13 blast on its first frame and shrinks away over 60
Defined in soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c b/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
index 09a108adf..9de0e4e9b 100644
--- a/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
+++ b/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
@@ -43,7 +43,8 @@ void Demo6K_InitStreak(Demo6K* this, s32 i);  // was func_80967A04 [LLM:HIGH]
 void Demo6K_UpdateStreaks(Demo6K* this, PlayState* play);  // was func_80967AD0 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80967DBC: the params 13 update: swells with NA_SE_EN_GANON_ATTACK_DEMO and NA_SE_EN_GANON_FIRE_DEMO, then bursts sparkles on the player and dies
 void Demo6K_GanonLightBlast(Demo6K* this, PlayState* play);  // was func_80967DBC [LLM:HIGH]
-void func_80967F10(Demo6K* this, PlayState* play);
+// LLM generated name (HIGH), was func_80967F10: the params 12 update: spawns the params 13 blast on its first frame and shrinks away over 60
+void Demo6K_SpawnGanonBlast(Demo6K* this, PlayState* play);  // was func_80967F10 [LLM:HIGH]
 void func_80967FFC(Actor* thisx, PlayState* play);
 void func_80968298(Actor* thisx, PlayState* play);
 void func_8096865C(Actor* thisx, PlayState* play);
@@ -162,7 +163,7 @@ void Demo6K_Init(Actor* thisx, PlayState* play) {
             break;
         case 12:
             Actor_SetScale(&this->actor, 0.0f);
-            this->initActionFunc = func_80967F10;
+            this->initActionFunc = Demo6K_SpawnGanonBlast;  // was func_80967F10 [LLM:HIGH]
             this->drawFunc = func_80968B70;
             Actor_ChangeCategory(play, &play->actorCtx, &this->actor, ACTORCAT_ITEMACTION);
             break;
@@ -559,7 +560,7 @@ void Demo6K_GanonLightBlast(Demo6K* this, PlayState* play) {
     }
 }
 
-void func_80967F10(Demo6K* this, PlayState* play) {
+void Demo6K_SpawnGanonBlast(Demo6K* this, PlayState* play) {
     if (this->timer2 == 0) {
         Actor_Spawn(&play->actorCtx, play, ACTOR_DEMO_6K, this->actor.world.pos.x, this->actor.world.pos.y,
                     this->actor.world.pos.z, 0, 0, 0, 13);
