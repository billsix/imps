From c7979636ac0147a04b7c5a8ab75a0d9534a7ae54 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:38 +0000
Subject: [PATCH 3606/3799] soh: rename D_80B5A4BC -> sReactingToPlayerHurt

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: latch in EnZl3_WaitForStalfosDefeated: set when the player takes damage (invincibilityTimer > 0) so Zelda swaps to the cowering animation, cleared when the player recovers. Reset by EnZl3_Reset and listed in EN_ZL3_SHIP_SAVESTATE_FIELDS
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 35317f72e..4a6bdf9f1 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -74,12 +74,13 @@ static Vec3f sStalfosSpawnPos1 = { -12.0f, 260.0f, -147.0f };  // was D_80B5A4A4
 // LLM generated name (GUESS), was D_80B5A4B0: a third ambush position of the same shape as sStalfosSpawnPos0 and sStalfosSpawnPos1, sharing their y of 260. Unreferenced -- a cut third Stalfos
 static Vec3f sStalfosSpawnPos2 = { 42.0f, 260.0f, 13.0f };  // was D_80B5A4B0 [LLM:GUESS]
 
-static u32 D_80B5A4BC = 0;
+// LLM generated name (GUESS), was D_80B5A4BC: latch in EnZl3_WaitForStalfosDefeated: set when the player takes damage (invincibilityTimer > 0) so Zelda swaps to the cowering animation, cleared when the player recovers. Reset by EnZl3_Reset and listed in EN_ZL3_SHIP_SAVESTATE_FIELDS
+static u32 sReactingToPlayerHurt = 0;  // was D_80B5A4BC [LLM:GUESS]
 
 #define EN_ZL3_SHIP_SAVESTATE_FIELDS(F) \
     F(sTurningToPlayer)                       \
     F(sCueDelayTimer)                       \
-    F(D_80B5A4BC)
+    F(sReactingToPlayerHurt)  // was D_80B5A4BC [LLM:GUESS]
 
 SHIP_SAVESTATE_DEFINE(EnZl3, EN_ZL3_SHIP_SAVESTATE_FIELDS)
 
@@ -2132,24 +2133,24 @@ void func_80B584B4(EnZl3* this, PlayState* play) {
     s8 invincibilityTimer = player->invincibilityTimer;
     Actor* nearbyEnTest = Actor_FindNearby(play, &this->actor, -1, ACTORCAT_ENEMY, 8000.0f);
 
-    if (D_80B5A4BC == 0) {
+    if (sReactingToPlayerHurt == 0) {  // was D_80B5A4BC [LLM:GUESS]
         if ((nearbyEnTest == NULL) && (!Play_InCsMode(play))) {
             this->action = 33;
             OnePointCutscene_Init(play, 4011, -99, &this->actor, CAM_ID_MAIN);
         } else if (invincibilityTimer > 0) {
             func_80B54E14(this, &gZelda2Anime2Anim_003FF8, 0, -12.0f, 0);
-            D_80B5A4BC = 1;
+            sReactingToPlayerHurt = 1;  // was D_80B5A4BC [LLM:GUESS]
             func_80B56DC8(this);
         }
     } else {
         if ((nearbyEnTest == NULL) && (!Play_InCsMode(play))) {
             func_80B54E14(this, &gZelda2Anime2Anim_007664, 0, -12.0f, 0);
-            D_80B5A4BC = 0;
+            sReactingToPlayerHurt = 0;  // was D_80B5A4BC [LLM:GUESS]
             this->action = 33;
             OnePointCutscene_Init(play, 4011, -99, &this->actor, CAM_ID_MAIN);
         } else if (invincibilityTimer <= 0) {
             func_80B54E14(this, &gZelda2Anime2Anim_007664, 0, -12.0f, 0);
-            D_80B5A4BC = 0;
+            sReactingToPlayerHurt = 0;  // was D_80B5A4BC [LLM:GUESS]
         }
     }
 }
@@ -2799,5 +2800,5 @@ const ActorInit En_Zl3_InitVars = {
 void EnZl3_Reset(void) {
     sTurningToPlayer = 0;  // was D_80B5A468 [LLM:GUESS]
     sCueDelayTimer = -1;  // was D_80B5A494 [LLM:GUESS]
-    D_80B5A4BC = 0;
+    sReactingToPlayerHurt = 0;  // was D_80B5A4BC [LLM:GUESS]
 }
