From b1fe6b1bbda876c679b6308bbaf4031c4937dcce Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:38 +0000
Subject: [PATCH 443/490] soh: rename D_809FF40C -> sDuLimbOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the point EnDu_PostLimbDraw transforms for its limb position
Defined in soh/src/overlays/actors/ovl_En_Du/z_en_du.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Du/z_en_du.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Du/z_en_du.c b/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
index 79adbf5f4..f27c8931b 100644
--- a/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
+++ b/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
@@ -667,10 +667,10 @@ s32 EnDu_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 
 void EnDu_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx, Gfx** gfx) {
     EnDu* this = (EnDu*)thisx;
-    Vec3f D_809FF40C = { 0.0f, -1000.0f, 0.0f };
+    Vec3f sDuLimbOffset = { 0.0f, -1000.0f, 0.0f };  // was D_809FF40C [LLM:HIGH]
 
     if (limbIndex == 16) {
-        Matrix_MultVec3f(&D_809FF40C, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sDuLimbOffset, &this->actor.focus.pos);  // was D_809FF40C [LLM:HIGH]
     }
 }
 
