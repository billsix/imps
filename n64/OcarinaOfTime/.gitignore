# The upstream checkout and everything build/run produce are disposable;
# only the scripts (and, later, patches/) are versioned.  runDir/ also
# holds ROM-derived and personal state (oot.o2r, saves) that must never
# be committed.
/Shipwright/
/build-cmake/
/bldInstall/
/runDir/

# Python bytecode from tools/, and personal .sav copies held at this level
__pycache__/
/*.sav

# Podman/AppImage build outputs (Makefile) — large, never commit
/out/
soh-builder-*.tar

# Regenerable output of tools/oot_oracle.py (the zeldaret/oot name census and
# its fetch cache) -- large, and reproduced by re-running the tool.
/oracle.tsv
/.oot-oracle-cache/
