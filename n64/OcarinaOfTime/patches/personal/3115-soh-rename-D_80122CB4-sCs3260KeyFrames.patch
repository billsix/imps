From 3d86e5559fccee82f820f9dacab07ecc54fb26ba Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:41 +0000
Subject: [PATCH 3115/3799] soh: rename D_80122CB4 -> sCs3260KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 3260 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 6 +++---
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 799c57cb0..17eb9c731 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -36,7 +36,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs3340KeyFrames)                                   \
     F(sCs3350KeyFrames)                                   \
     F(sCs4120KeyFrames)                                   \
-    F(D_80122CB4)                                   \
+    F(sCs3260KeyFrames)                                   \
     F(D_80122D04)                                   \
     F(D_80122E44)                                   \
     F(D_8012313C)                                   \
@@ -941,9 +941,9 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             break;
         case 3260:
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
-            D_80122CB4[1].timerInit = timer - 5;
+            sCs3260KeyFrames[1].timerInit = timer - 5;  // was D_80122CB4 [LLM:HIGH]
 
-            csInfo->keyFrames = D_80122CB4;
+            csInfo->keyFrames = sCs3260KeyFrames;  // was D_80122CB4 [LLM:HIGH]
             csInfo->keyFrameCnt = 2;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 5c978badc..d4e8d7f8d 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -583,7 +583,8 @@ static OnePointCsFull sCs4221KeyFrames[1] = {  // was D_80122C8C [LLM:HIGH]
     { 0x0F, 0xFF, 0x0101, 999, 5, 60.0f, 1.0f, { -70.0f, 140.0f, 25.0f }, { 10.0f, 180.0f, 195.0f } },
 };
 
-static OnePointCsFull D_80122CB4[2] = {
+// LLM generated name (HIGH), was D_80122CB4: the keyframe set one-point cutscene 3260 installs
+static OnePointCsFull sCs3260KeyFrames[2] = {  // was D_80122CB4 [LLM:HIGH]
     { 0x0F, 0xFF, 0x4242, 5, 0, 60.0f, 1.0f, { 0.0f, 0.0f, 1000.0f }, { 0.0f, 0.0f, 1100.0f } },
     { 0x02, 0xFF, 0x4242, -1, 0, 60.0f, 1.0f, { 0.0f, 0.0f, -100.0f }, { 0.0f, 0.0f, 0.0f } },
 };
