From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:12:13 +0000
Subject: [PATCH 0582/3799] soh: rename func_80A780D0 -> EnIk_CsInit

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.82.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index 74ffc5709..b82786106 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -1442,7 +1442,8 @@ void EnIk_Draw(Actor* thisx, PlayState* play) {
     sDrawFuncs[this->drawMode](this, play);
 }
 
-void func_80A780D0(EnIk* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80A780D0): adopted upstream's name for this address; body verified to match upstream at 0.82. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ik/z_en_ik.c]
+void EnIk_CsInit(EnIk* this, PlayState* play) {
     if (this->actor.params == 0) {
         if (!Flags_GetEventChkInf(EVENTCHKINF_BEGAN_NABOORU_BATTLE)) {
             this->actor.update = EnIk_Update;
@@ -1494,7 +1495,7 @@ void EnIk_Init(Actor* thisx, PlayState* play) {
         SkelAnime_InitFlex(play, &this->skelAnime, &gIronKnuckleSkel, &gIronKnuckleNabooruSummonAxeAnim,
                            this->jointTable, this->morphTable, 30);
         EnIk_InitImpl(&this->actor, play);
-        func_80A780D0(this, play);
+        EnIk_CsInit(this, play);
     }
 
     // Immediately trigger Iron Knuckle for Enemy Rando and Crowd Control
