From 8e8dbe423bbc8ad7980d295827b6391e9184f9c5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:44 +0000
Subject: [PATCH 0820/3799] soh: rename D_8016A528 ->
 gGfxTaskSentToNextReadyMinusAudioThreadUpdateTime

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/speed_meter.c.
---
 soh/include/variables.h    | 2 +-
 soh/src/code/graph.c       | 2 +-
 soh/src/code/speed_meter.c | 5 +++--
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/variables.h b/soh/include/variables.h
index 85b7b16a2..3e1f79540 100644
--- a/soh/include/variables.h
+++ b/soh/include/variables.h
@@ -209,7 +209,7 @@ extern "C"
 	extern PadMgr gPadMgr;
 	extern uintptr_t gSegments[NUM_SEGMENTS];
 	extern volatile OSTime gAudioThreadUpdateTimeTotalPerGfxTask;  // was D_8016A520 [oot]
-	extern volatile OSTime D_8016A528;
+	extern volatile OSTime gGfxTaskSentToNextReadyMinusAudioThreadUpdateTime;  // was D_8016A528 [oot]
 	extern volatile OSTime D_8016A530;
 	extern volatile OSTime D_8016A538;
 	extern volatile OSTime D_8016A540;
diff --git a/soh/src/code/graph.c b/soh/src/code/graph.c
index 4ce999e56..e9365a04f 100644
--- a/soh/src/code/graph.c
+++ b/soh/src/code/graph.c
@@ -178,7 +178,7 @@ void Graph_TaskSet00(GraphicsContext* gfxCtx) {
     CfbInfo* cfb;
     s32 pad1;
 
-    D_8016A528 = osGetTime() - sGraphSetTaskTime - gAudioThreadUpdateTimeAcc;
+    gGfxTaskSentToNextReadyMinusAudioThreadUpdateTime = osGetTime() - sGraphSetTaskTime - gAudioThreadUpdateTimeAcc;
 
     osSetTimer(&timer, OS_USEC_TO_CYCLES(3000000), 0, &gfxCtx->queue, OS_MESG_32(666));
 
diff --git a/soh/src/code/speed_meter.c b/soh/src/code/speed_meter.c
index d6f80bc72..e8952d983 100644
--- a/soh/src/code/speed_meter.c
+++ b/soh/src/code/speed_meter.c
@@ -4,7 +4,8 @@
 // Name from zeldaret/oot, was D_8016A520: OSTime measuring audio thread update duration; drawn as [oot: https://github.com/zeldaret/oot/blob/main/src/code/speed_meter.c]
 // speed-meter red bar
 volatile OSTime gAudioThreadUpdateTimeTotalPerGfxTask;
-volatile OSTime D_8016A528;
+// Name from zeldaret/oot (was D_8016A528): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/speed_meter.c]
+volatile OSTime gGfxTaskSentToNextReadyMinusAudioThreadUpdateTime;
 volatile OSTime D_8016A530;
 volatile OSTime D_8016A538;
 volatile OSTime D_8016A540;
@@ -21,7 +22,7 @@ volatile OSTime gRDPTotalTime;
 SpeedMeterTimeEntry* sSpeedMeterTimeEntryPtr;
 
 SpeedMeterTimeEntry sSpeedMeterTimeEntryArray[] = {
-    { &gAudioThreadUpdateTimeTotalPerGfxTask, 0, 0, GPACK_RGBA5551(255, 0, 0, 1) }, { &D_8016A528, 0, 2, GPACK_RGBA5551(255, 255, 0, 1) },
+    { &gAudioThreadUpdateTimeTotalPerGfxTask, 0, 0, GPACK_RGBA5551(255, 0, 0, 1) }, { &gGfxTaskSentToNextReadyMinusAudioThreadUpdateTime, 0, 2, GPACK_RGBA5551(255, 255, 0, 1) },
     { &D_8016A530, 0, 4, GPACK_RGBA5551(0, 0, 255, 1) }, { &D_8016A538, 0, 6, GPACK_RGBA5551(255, 128, 128, 1) },
     { &D_8016A540, 0, 8, GPACK_RGBA5551(0, 255, 0, 1) }, { &D_8016A548, 0, 10, GPACK_RGBA5551(255, 0, 255, 1) },
 };
