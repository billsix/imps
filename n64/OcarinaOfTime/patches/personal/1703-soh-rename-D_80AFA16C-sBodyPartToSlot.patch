From 4c69526dc26d23c46dd271a7e9d30f2bf755f8ba Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:38:46 +0000
Subject: [PATCH 1703/3799] soh: rename D_80AFA16C -> sBodyPartToSlot

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: maps each player body-part index to its slot in sBodyPartPos, with -1 for the parts that are not used.
Defined in soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
index 6ed701b64..7c73ed7b8 100644
--- a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
+++ b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
@@ -60,7 +60,8 @@ static u8 D_80AFA15C[] = {
     2, 2, 2, 3, 3, 3, 3, 3, 3, 0, 0, 0, 0, 0, 0, 3,
 };
 
-static s8 D_80AFA16C[] = {
+// LLM generated name (HIGH), was D_80AFA16C: maps each player body-part index to its slot in sBodyPartPos, with -1 for the parts that are not used.
+static s8 sBodyPartToSlot[] = {  // was D_80AFA16C [LLM:HIGH]
     2, 9, 10, 11, 12, 13, 14, 0, 15, -1, 3, 4, 5, 6, 7, 8, -1, 1, 0, 0,
 };
 
@@ -269,8 +270,8 @@ void func_80AF95C4(EnSda* this, u8* shadowTexture, Player* player, PlayState* pl
     }
     Matrix_RotateX((BREG(50) + 70) / 100.0f, MTXMODE_NEW);
     for (i = 0; i < 18; i++) {
-        if (D_80AFA16C[i] >= 0) {
-            sBodyPartPos[D_80AFA16C[i]] = player->bodyPartsPos[i];  // was D_80AFA660 [LLM:HIGH]
+        if (sBodyPartToSlot[i] >= 0) {  // was D_80AFA16C [LLM:HIGH]
+            sBodyPartPos[sBodyPartToSlot[i]] = player->bodyPartsPos[i];  // was D_80AFA660 [LLM:HIGH]
         }
     }
     osSyncPrintf("SDA CONT 2\n");
-- 
