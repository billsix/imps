From d75729556af1c2134fe15080f0d19be0fa63785f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:13 +0000
Subject: [PATCH 3455/3799] soh: rename D_8015BBE8 -> sNearestTargetActor

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the best Z-target candidate found so far in the search
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 1238b7bfd..6d8fec8e0 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -3578,7 +3578,8 @@ s32 Attention_ActorOnScreen(PlayState* play, Actor* actor) {
     return (sp1E > -20) && (sp1E < 340) && (sp1C > -160) && (sp1C < 400);
 }
 
-Actor* D_8015BBE8;
+// LLM generated name (HIGH), was D_8015BBE8: the best Z-target candidate found so far in the search
+Actor* sNearestTargetActor;  // was D_8015BBE8 [LLM:HIGH]
 Actor* D_8015BBEC;
 // LLM generated name (HIGH), was D_8015BBF0: the best weighted distance found so far while searching for a Z-target
 f32 sNearestTargetDistSq;  // was D_8015BBF0 [LLM:HIGH]
@@ -3628,7 +3629,7 @@ void Attention_FindActorInCategory(PlayState* play, ActorContext* actorCtx, Play
                             sBestTargetPriority = actor->targetPriority;  // was D_8015BBF8 [LLM:HIGH]
                         }
                     } else {
-                        D_8015BBE8 = actor;
+                        sNearestTargetActor = actor;  // was D_8015BBE8 [LLM:HIGH]
                         sNearestTargetDistSq = var;  // was D_8015BBF0 [LLM:HIGH]
                     }
                 }
@@ -3649,7 +3650,7 @@ Actor* Attention_FindActor(PlayState* play, ActorContext* actorCtx, Actor** acto
     s32 i;
     u8* entry;
 
-    D_8015BBE8 = D_8015BBEC = NULL;
+    sNearestTargetActor = D_8015BBEC = NULL;  // was D_8015BBE8 [LLM:HIGH]
     sNearestTargetDistSq = sbgmEnemyDistSq = FLT_MAX;  // was D_8015BBF0 [LLM:HIGH]
     sBestTargetPriority = 0x7FFFFFFF;  // was D_8015BBF8 [LLM:HIGH]
 
@@ -3664,7 +3665,7 @@ Actor* Attention_FindActor(PlayState* play, ActorContext* actorCtx, Actor** acto
             entry++;
         }
 
-        if (D_8015BBE8 == NULL) {
+        if (sNearestTargetActor == NULL) {  // was D_8015BBE8 [LLM:HIGH]
             for (; i < ARRAY_COUNT(sTargetCategorySearchOrder); i++) {  // was D_801160A0 [LLM:HIGH]
                 Attention_FindActorInCategory(play, actorCtx, player, *entry);
                 entry++;
@@ -3672,10 +3673,10 @@ Actor* Attention_FindActor(PlayState* play, ActorContext* actorCtx, Actor** acto
         }
     }
 
-    if (D_8015BBE8 == 0) {
+    if (sNearestTargetActor == 0) {  // was D_8015BBE8 [LLM:HIGH]
         *actorPtr = D_8015BBEC;
     } else {
-        *actorPtr = D_8015BBE8;
+        *actorPtr = sNearestTargetActor;  // was D_8015BBE8 [LLM:HIGH]
     }
 
     return *actorPtr;
