From 93cc1845cff4f784adb49af6dcf0aec47d84781a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:03:17 +0000
Subject: [PATCH 1240/3799] soh: rename func_80095974 -> Gfx_SetupFramebuffer

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: emits the fill setup display list and points the RDP at the screen-sized scissor, gZBuffer as the depth image and the context's current frame buffer as the colour image.
Defined in soh/src/code/z_rcp.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_rcp.c    | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 3785d66ef..51da2ede9 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1237,7 +1237,7 @@ Gfx* Gfx_TwoTexScrollEnvColorEx(GraphicsContext* gfxCtx, s32 tile1, u32 x1, u32
                               u32 x2, u32 y2, s32 width2, s32 height2, s32 r, s32 g, s32 b, s32 a, s32 xStep1, s32 yStep1, s32 xStep2, s32 yStep2);
 Gfx* Gfx_EnvColor(GraphicsContext* gfxCtx, s32 r, s32 g, s32 b, s32 a);
 void Gfx_SetupFrame(GraphicsContext* gfxCtx, u8 r, u8 g, u8 b);
-void func_80095974(GraphicsContext* gfxCtx);
+void Gfx_SetupFramebuffer(GraphicsContext* gfxCtx);  // was func_80095974 [LLM:HIGH]
 void Room_HandleDebugInput(PlayState* play, Room* room, Input* arg2, UNK_TYPE arg3);  // was func_80095AA0 [LLM:GUESS]
 void Room_DrawBackground2D(Gfx** gfxP, void* tex, void* tlut, u16 width, u16 height, u8 fmt, u8 siz, u16 tlutMode,
                            u16 tlutCount, f32 offsetX, f32 offsetY);
diff --git a/soh/src/code/z_rcp.c b/soh/src/code/z_rcp.c
index fab9cc8e9..221cac952 100644
--- a/soh/src/code/z_rcp.c
+++ b/soh/src/code/z_rcp.c
@@ -1622,7 +1622,8 @@ void Gfx_SetupFrame(GraphicsContext* gfxCtx, u8 r, u8 g, u8 b) {
     CLOSE_DISPS(gfxCtx);
 }
 
-void func_80095974(GraphicsContext* gfxCtx) {
+// LLM generated name (HIGH), was func_80095974: emits the fill setup display list and points the RDP at the screen-sized scissor, gZBuffer as the depth image and the context's current frame buffer as the colour image.
+void Gfx_SetupFramebuffer(GraphicsContext* gfxCtx) {
     OPEN_DISPS(gfxCtx);
 
     gSPDisplayList(POLY_OPA_DISP++, sFillSetupDL);
-- 
