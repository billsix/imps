From 5d948a052e19fe4ab6f3af29a9f2ba2f19d6098f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:05:34 +0000
Subject: [PATCH 1949/3799] soh: rename D_80126070 -> sFootprintOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: {0, -300, 0} in foot space, the point raycast down to place the footprint effect
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index eabd94710..ba3e4c35f 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1165,7 +1165,8 @@ f32 sLegIkLimbLengthSqDiff[] = { 10.019104f, -19.925102f };  // was D_80126060 [
 // LLM generated name (HIGH), was D_80126068: per-age height added to the raycast floor Y before the leg is bent onto it
 f32 sLegIkFootHeightOffsets[] = { 5.0f, 3.0f };  // was D_80126068 [LLM:HIGH]
 
-Vec3f D_80126070 = { 0.0f, -300.0f, 0.0f };
+// LLM generated name (HIGH), was D_80126070: {0, -300, 0} in foot space, the point raycast down to place the footprint effect
+Vec3f sFootprintOffset = { 0.0f, -300.0f, 0.0f };  // was D_80126070 [LLM:HIGH]
 
 // LLM generated name (HIGH), was func_8008F87C: two-bone IK: raycasts the floor under the foot and bends the thigh, shin and foot joints onto it, spawning EffectSsGFire on hot floor types
 void Player_AdjustLegToFloor(PlayState* play, Player* this, SkelAnime* skelAnime, Vec3f* pos, Vec3s* rot, s32 thighLimbIndex,
@@ -1206,7 +1207,7 @@ void Player_AdjustLegToFloor(PlayState* play, Player* this, SkelAnime* skelAnime
         Matrix_TranslateRotateZYX(&sLegIkThighOffsets[gSaveContext.linkAge], &skelAnime->jointTable[shinLimbIndex]);  // was D_80126038 [LLM:HIGH]
         Matrix_Translate(sLegIkShinLengths[gSaveContext.linkAge], 0.0f, 0.0f, MTXMODE_APPLY);  // was D_80126050 [LLM:HIGH]
         Matrix_MultVec3f(&sZeroVec, &sp98);
-        Matrix_MultVec3f(&D_80126070, &footprintPos);
+        Matrix_MultVec3f(&sFootprintOffset, &footprintPos);  // was D_80126070 [LLM:HIGH]
         Matrix_Pop();
 
         footprintPos.y += 15.0f;
-- 
2.55.0

