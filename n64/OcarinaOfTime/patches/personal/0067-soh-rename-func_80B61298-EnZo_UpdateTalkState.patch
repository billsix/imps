From 6122945dad356703f0b5362330b361f4ca8dab84 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:03 +0000
Subject: [PATCH 067/488] soh: rename func_80B61298 -> EnZo_UpdateTalkState

Name source: zeldaret/oot.
Defined in soh/src/overlays/actors/ovl_En_Zo/z_en_zo.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Zo/z_en_zo.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zo/z_en_zo.c b/soh/src/overlays/actors/ovl_En_Zo/z_en_zo.c
index 1d1776f54..c527f59d0 100644
--- a/soh/src/overlays/actors/ovl_En_Zo/z_en_zo.c
+++ b/soh/src/overlays/actors/ovl_En_Zo/z_en_zo.c
@@ -446,7 +446,8 @@ u16 EnZo_GetTextId(PlayState* play, Actor* thisx) {
     return 0x4006;
 }
 
-s16 func_80B61298(PlayState* play, Actor* thisx) {
+// Name from zeldaret/oot, was func_80B61298: NpcInteract callback returning next talk state from message state. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Zo/z_en_zo.c]
+s16 EnZo_UpdateTalkState(PlayState* play, Actor* thisx) {
     switch (Message_GetState(&play->msgCtx)) {
         case TEXT_STATE_NONE:
         case TEXT_STATE_DONE_HAS_NEXT:
@@ -520,7 +521,7 @@ void EnZo_Dialog(EnZo* this, PlayState* play) {
     Npc_TrackPoint(&this->actor, &this->interactInfo, 11, this->trackingMode);
     if (this->canSpeak == true) {
         Npc_UpdateTalking(play, &this->actor, &this->interactInfo.talkState, this->dialogRadius, EnZo_GetTextId,
-                          func_80B61298);
+                          EnZo_UpdateTalkState);
     }
 }
 
