From 62bad92afcee800bec19cc9c5ac317dd64a3ba09 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:30:48 +0000
Subject: [PATCH 0968/3799] soh: rename D_8089B17C -> sIndexMasks

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: indexed by the caller's size selector and ANDed with a random 0-7 to bound which debris entry is picked, so 1, 3 and 7 give two, four and eight choices.
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c b/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c
index 98c054668..1af396c26 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c
@@ -94,7 +94,8 @@ static s16 sDebrisArg6[] = {  // was D_8089B16C [LLM:GUESS]
     0x0030, 0x002A, 0x0024, 0x0020, 0x001C, 0x0018, 0x0014, 0x0010,
 };
 
-static s16 D_8089B17C[] = {
+// LLM generated name (HIGH), was D_8089B17C: indexed by the caller's size selector and ANDed with a random 0-7 to bound which debris entry is picked, so 1, 3 and 7 give two, four and eight choices.
+static s16 sIndexMasks[] = {  // was D_8089B17C [LLM:HIGH]
     0x0001,
     0x0003,
     0x0007,
@@ -130,7 +131,7 @@ void BgJyaMegami_SpawnEffect(PlayState* play, Vec3f* pos, Vec3f* velocity, s32 n
     s32 i;
 
     for (i = 0; i < num; i++) {
-        s32 idx = ((s16)(Rand_ZeroOne() * 8.0f)) & D_8089B17C[arg4];
+        s32 idx = ((s16)(Rand_ZeroOne() * 8.0f)) & sIndexMasks[arg4];  // was D_8089B17C [LLM:HIGH]
         s16 arg5 = ((idx < 5) && (Rand_ZeroOne() < 0.7f)) ? 0x40 : 0x20;
         EffectSsKakera_Spawn(play, pos, velocity, pos, -90, arg5, sDebrisArg6[idx], 4, 0, sDebrisScales[idx], 0, 5,  // was D_8089B14C [LLM:HIGH]
                              sDebrisLifetimes[idx], KAKERA_COLOR_NONE, OBJECT_JYA_OBJ, gMegami2DL);  // was D_8089B15C [LLM:HIGH]
-- 
