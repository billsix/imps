From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:50 +0000
Subject: [PATCH 486/784] soh: rename func_80AEFDC0 ->
 EnRu1_ThroneRoomTalkOfferAccepted

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.89.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index c51bdfdac..3d8f2011b 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -2216,7 +2216,8 @@ void func_80AEFD38(EnRu1* this, PlayState* play) {
     }
 }
 
-s32 func_80AEFDC0(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEFDC0): adopted upstream's name for this address; body verified to match upstream at 0.89. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_ThroneRoomTalkOfferAccepted(EnRu1* this, PlayState* play) {
     if (!Actor_ProcessTalkRequest(&this->actor, play)) {
         this->actor.flags |= ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_FRIENDLY;
         this->actor.textId = Text_GetFaceReaction(play, 0x1F);
@@ -2255,7 +2256,7 @@ void func_80AEFECC(EnRu1* this, PlayState* play) {
     EnRu1_UpdateEyes(this);
     EnRu1_UpdateStandingOC(this, play);
     EnRu1_UpdateBgCheckInfo(this, play);
-    func_80AEFE84(this, play, func_80AEFDC0(this, play));
+    func_80AEFE84(this, play, EnRu1_ThroneRoomTalkOfferAccepted(this, play));
 }
 
 void func_80AEFF40(EnRu1* this, PlayState* play) {
