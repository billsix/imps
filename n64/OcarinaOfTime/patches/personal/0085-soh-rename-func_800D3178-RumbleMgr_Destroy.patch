From 0042d489c6196466b949ac2bcef12a8e9fe5c64c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:19 +0000
Subject: [PATCH 085/225] soh: rename func_800D3178 -> RumbleMgr_Destroy

Name source: zeldaret/oot.
Defined in soh/src/code/sys_rumble.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h   | 2 +-
 soh/src/code/sys_rumble.c | 3 ++-
 soh/src/code/z_rumble.c   | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 4b6428440..97c495701 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1832,7 +1832,7 @@ uint32_t SysUcode_GetUCode(void);
 uintptr_t SysUcode_GetUCodeData(void);
 void RumbleMgr_Update(RumbleMgr* arg0);  // was func_800D2E30 [oot]
 void RumbleMgr_Init(RumbleMgr* arg0);  // was func_800D3140 [oot]
-void func_800D3178(RumbleMgr* arg0);
+void RumbleMgr_Destroy(RumbleMgr* arg0);  // was func_800D3178 [oot]
 void Freeze_CurrentThread(void);  // was func_800D31A0 [oot]
 void Debug_UpdateCtrlr2Valid(void);  // was func_800D31F0 [LLM:HIGH]
 void Debug_ClearCtrlr2Valid(void);  // was func_800D3210 [LLM:HIGH]
diff --git a/soh/src/code/sys_rumble.c b/soh/src/code/sys_rumble.c
index 9c51992bf..99660e81f 100644
--- a/soh/src/code/sys_rumble.c
+++ b/soh/src/code/sys_rumble.c
@@ -118,6 +118,7 @@ void RumbleMgr_Init(RumbleMgr* arg0) {
     arg0->unk_105 = 1;
 }
 
-void func_800D3178(RumbleMgr* arg0) {
+// Name from zeldaret/oot src/code/sys_rumble.c (was func_800D3178): zeroes the entire RumbleMgr struct via memset. Source: https://github.com/zeldaret/oot/blob/main/src/code/sys_rumble.c
+void RumbleMgr_Destroy(RumbleMgr* arg0) {
     memset(arg0, 0, sizeof(RumbleMgr));
 }
diff --git a/soh/src/code/z_rumble.c b/soh/src/code/z_rumble.c
index e74043fab..3708ecb29 100644
--- a/soh/src/code/z_rumble.c
+++ b/soh/src/code/z_rumble.c
@@ -73,7 +73,7 @@ void func_800AA0F0(void) {
         padmgr->retraceCallbackValue = 0;
     }
 
-    func_800D3178(&D_80160FD0);
+    RumbleMgr_Destroy(&D_80160FD0);
 }
 
 u32 func_800AA148(void) {
