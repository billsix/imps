From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:58:38 +0000
Subject: [PATCH 1218/3799] soh: rename func_8088E760 ->
 BgHidanSima_WaitToSlide

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the params 1 platform's pause between passes: on expiry it flips world.rot.y by 180 degrees and arms the 60-frame slide.
Defined in soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c  | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
index 5f224ff24..f1a89c0b3 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
@@ -20,7 +20,8 @@ void BgHidanSima_Rise(BgHidanSima* this, PlayState* play);  // was func_8088E518
 void BgHidanSima_Shake(BgHidanSima* this, PlayState* play);  // was func_8088E5D0 [LLM:HIGH]
 // LLM generated name (HIGH), was func_8088E6D0: lowers the platform 100 units below home, re-arming the timer while the player is still standing on it, and returns to the rise once it expires.
 void BgHidanSima_Sink(BgHidanSima* this, PlayState* play);  // was func_8088E6D0 [LLM:HIGH]
-void func_8088E760(BgHidanSima* this, PlayState* play);
+// LLM generated name (HIGH), was func_8088E760: the params 1 platform's pause between passes: on expiry it flips world.rot.y by 180 degrees and arms the 60-frame slide.
+void BgHidanSima_WaitToSlide(BgHidanSima* this, PlayState* play);  // was func_8088E760 [LLM:HIGH]
 void func_8088E7A8(BgHidanSima* this, PlayState* play);
 void func_8088E90C(BgHidanSima* this);
 
@@ -106,7 +107,7 @@ void BgHidanSima_Init(Actor* thisx, PlayState* play) {
     if (this->dyna.actor.params == 0) {
         this->actionFunc = BgHidanSima_Rise;  // was func_8088E518 [LLM:HIGH]
     } else {
-        this->actionFunc = func_8088E760;
+        this->actionFunc = BgHidanSima_WaitToSlide;  // was func_8088E760 [LLM:HIGH]
     }
 }
 
@@ -165,7 +166,7 @@ void BgHidanSima_Sink(BgHidanSima* this, PlayState* play) {
     }
 }
 
-void func_8088E760(BgHidanSima* this, PlayState* play) {
+void BgHidanSima_WaitToSlide(BgHidanSima* this, PlayState* play) {
     if (this->timer != 0) {
         this->timer--;
     }
@@ -191,7 +192,7 @@ void func_8088E7A8(BgHidanSima* this, PlayState* play) {
     this->dyna.actor.world.pos.z = Math_CosS(this->dyna.actor.world.rot.y) * temp + this->dyna.actor.home.pos.z;
     if (this->timer == 0) {
         this->timer = 20;
-        this->actionFunc = func_8088E760;
+        this->actionFunc = BgHidanSima_WaitToSlide;  // was func_8088E760 [LLM:HIGH]
     }
     Actor_PlaySfx_Flagged(&this->dyna.actor, NA_SE_EV_FIRE_PILLAR - SFX_FLAG);
 }
