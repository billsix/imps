From 427c4f38422bd4831f2acfa893b4087aa6ea666f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:09 +0000
Subject: [PATCH 3428/3799] soh: rename D_80130514 -> sVibratoState

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the state that goes with it
Defined in soh/src/code/audio_effects.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_effects.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_effects.c b/soh/src/code/audio_effects.c
index 64c7eaf88..358c2988d 100644
--- a/soh/src/code/audio_effects.c
+++ b/soh/src/code/audio_effects.c
@@ -110,7 +110,7 @@ s16 Audio_GetVibratoPitchChange(VibratoState* vib) {
 
 f32 Audio_GetVibratoFreqScale(VibratoState* vib) {
     static f32 sVibratoFreqScale = 0.0f;  // was D_80130510 [LLM:HIGH]
-    static s32 D_80130514 = 0;
+    static s32 sVibratoState = 0;  // was D_80130514 [LLM:HIGH]
     f32 pitchChange;
     f32 extent;
     f32 invExtent;
@@ -167,7 +167,7 @@ f32 Audio_GetVibratoFreqScale(VibratoState* vib) {
     result = 1.0f / ((extent - invExtent) * pitchChange / 65536.0f + invExtent);
 
     sVibratoFreqScale += result;  // was D_80130510 [LLM:HIGH]
-    D_80130514++;
+    sVibratoState++;  // was D_80130514 [LLM:HIGH]
 
     return result;
 }
