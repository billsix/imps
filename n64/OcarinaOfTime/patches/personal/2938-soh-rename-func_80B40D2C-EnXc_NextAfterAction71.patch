 }
 
-void func_80B40D2C(EnXc* this) {
+// LLM generated name (HIGH), was func_80B40D2C: the same guard from action 71 to 72
+void EnXc_NextAfterAction71(EnXc* this) {
     EnXc_CheckAndSetAction(this, SHEIK_ACTION_71, SHEIK_ACTION_72);
 }
 
