@@ -259,20 +260,20 @@ void BgBdanSwitch_Idle(BgBdanSwitch* this, PlayState* play) {
     switch (this->dyna.actor.params & 0xFF) {
         case BLUE:
             if (DynaPolyActor_IsSwitchPressed(&this->dyna)) {
-                func_8086D67C(this);
+                BgBdanSwitch_SetupPress(this);  // was func_8086D67C [LLM:HIGH]
                 BgBdanSwitch_SetSwitchFlag(this, play);  // was func_8086D4B4 [LLM:HIGH]
             }
             break;
         case YELLOW:
             if (DynaPolyActor_IsPlayerOnTop(&this->dyna)) {
-                func_8086D67C(this);
+                BgBdanSwitch_SetupPress(this);  // was func_8086D67C [LLM:HIGH]
                 BgBdanSwitch_SetSwitchFlag(this, play);  // was func_8086D4B4 [LLM:HIGH]
             }
             break;
     }
 }
 
-void func_8086D67C(BgBdanSwitch* this) {
+void BgBdanSwitch_SetupPress(BgBdanSwitch* this) {
     this->actionFunc = func_8086D694;
     this->unk_1DA = 0x64;
 }
