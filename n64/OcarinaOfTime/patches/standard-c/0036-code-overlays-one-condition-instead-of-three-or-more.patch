+    if ((left->base.ocFlags1 & OC1_ON) && (right->base.ocFlags1 & OC1_ON) && (left->info.ocElemFlags & OCELEM_ON) && (right->info.ocElemFlags & OCELEM_ON) && Math3D_CylOutsideCyl(&left->dim, &right->dim, &deadSpace) == 1) {
+        Vec3f leftPos;
+        Vec3f rightPos;
