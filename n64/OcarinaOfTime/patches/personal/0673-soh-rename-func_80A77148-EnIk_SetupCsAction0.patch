From fb717a52c175a85cbec94c0e44b6cf315ca63334 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:27 +0000
Subject: [PATCH 0673/3799] soh: rename func_80A77148 -> EnIk_SetupCsAction0

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index 6bf506035..b36e9d49b 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -1118,7 +1118,8 @@ f32 EnIk_curFrame(Actor* thisx) {
     return this->skelAnime.curFrame;
 }
 
-void func_80A77148(EnIk* this) {
+// Name from zeldaret/oot (was func_80A77148): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ik/z_en_ik.c]
+void EnIk_SetupCsAction0(EnIk* this) {
     this->action = 0;
     this->drawMode = 0;
     this->actor.shape.shadowAlpha = 0;
@@ -1293,7 +1294,7 @@ void func_80A779DC(EnIk* this, PlayState* play) {
         if (action != currentNpcAction) {
             switch (action) {
                 case 1:
-                    func_80A77148(this);
+                    EnIk_SetupCsAction0(this);
                     break;
                 case 2:
                     EnIk_SetupCsAction1(this, play);
