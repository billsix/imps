From 3e12fd7f4e5f44cf297e7479eba6dcc2d0860211 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:26 +0000
Subject: [PATCH 671/784] soh: rename func_80A6F1A4 -> EnHs2_Idle

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 0.97.
Defined in soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c.
---
 soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c b/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c
index 7add36cb9..533e6fdaf 100644
--- a/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c
+++ b/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c
@@ -14,7 +14,8 @@ void EnHs2_Init(Actor* thisx, PlayState* play);
 void EnHs2_Destroy(Actor* thisx, PlayState* play);
 void EnHs2_Update(Actor* thisx, PlayState* play);
 void EnHs2_Draw(Actor* thisx, PlayState* play);
-void func_80A6F1A4(EnHs2* this, PlayState* play);
+// Name from zeldaret/oot (was func_80A6F1A4): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.97. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c]
+void EnHs2_Idle(EnHs2* this, PlayState* play);
 
 const ActorInit En_Hs2_InitVars = {
     ACTOR_EN_HS2,
@@ -62,7 +63,7 @@ void EnHs2_Init(Actor* thisx, PlayState* play) {
     this->actor.colChkInfo.mass = MASS_IMMOVABLE;
     Actor_SetScale(&this->actor, 0.01f);
     osSyncPrintf(VT_FGCOL(CYAN) " ヒヨコの店(子人の時) \n" VT_RST);
-    this->actionFunc = func_80A6F1A4;
+    this->actionFunc = EnHs2_Idle;
     this->unk_2A8 = 0;
     this->actor.targetMode = 6;
 }
@@ -92,12 +93,12 @@ s32 EnHs2_Interact(EnHs2* this, PlayState* play, u16 textId, EnHs2ActionFunc act
 // Name from zeldaret/oot (was func_80A6F164): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c]
 void EnHs2_Talking(EnHs2* this, PlayState* play) {
     if (Actor_TextboxIsClosing(&this->actor, play)) {
-        this->actionFunc = func_80A6F1A4;
+        this->actionFunc = EnHs2_Idle;
     }
     this->unk_2A8 |= 0x1;
 }
 
-void func_80A6F1A4(EnHs2* this, PlayState* play) {
+void EnHs2_Idle(EnHs2* this, PlayState* play) {
     u16 textId;
 
     textId = Text_GetFaceReaction(play, 9);
