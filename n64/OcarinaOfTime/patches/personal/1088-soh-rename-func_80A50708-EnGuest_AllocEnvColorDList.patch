From 8011ee62f834e9f87ab81b9fdfd696e46b88d83e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:47:36 +0000
Subject: [PATCH 1088/3799] soh: rename func_80A50708 ->
 EnGuest_AllocEnvColorDList

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: allocates a two-instruction display list holding a gDPSetEnvColor and an end marker, bound to segments 8 and 9 by the draw function.
Defined in soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c b/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c
index 324686380..8f0ff481b 100644
--- a/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c
+++ b/soh/src/overlays/actors/ovl_En_Guest/z_en_guest.c
@@ -174,7 +174,8 @@ void func_80A505CC(Actor* thisx, PlayState* play) {
     CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
 }
 
-Gfx* func_80A50708(GraphicsContext* gfxCtx, u8 r, u8 g, u8 b, u8 a) {
+// LLM generated name (HIGH), was func_80A50708: allocates a two-instruction display list holding a gDPSetEnvColor and an end marker, bound to segments 8 and 9 by the draw function.
+Gfx* EnGuest_AllocEnvColorDList(GraphicsContext* gfxCtx, u8 r, u8 g, u8 b, u8 a) {
     Gfx* dlist;
 
     dlist = Graph_Alloc(gfxCtx, 2 * sizeof(Gfx));
@@ -228,8 +229,8 @@ void EnGuest_Draw(Actor* thisx, PlayState* play) {
 
     Gfx_SetupDL_25Opa(play->state.gfxCtx);
 
-    gSPSegment(POLY_OPA_DISP++, 0x08, func_80A50708(play->state.gfxCtx, 255, 255, 255, 255));
-    gSPSegment(POLY_OPA_DISP++, 0x09, func_80A50708(play->state.gfxCtx, 160, 60, 220, 255));
+    gSPSegment(POLY_OPA_DISP++, 0x08, EnGuest_AllocEnvColorDList(play->state.gfxCtx, 255, 255, 255, 255));  // was func_80A50708 [LLM:HIGH]
+    gSPSegment(POLY_OPA_DISP++, 0x09, EnGuest_AllocEnvColorDList(play->state.gfxCtx, 160, 60, 220, 255));  // was func_80A50708 [LLM:HIGH]
     gSPSegment(POLY_OPA_DISP++, 0x0A, SEGMENTED_TO_VIRTUAL(D_80A50BA4[this->unk_30E]));
 
     SkelAnime_DrawSkeletonOpa(play, &this->skelAnime, EnGuest_OverrideLimbDraw, NULL, this);
