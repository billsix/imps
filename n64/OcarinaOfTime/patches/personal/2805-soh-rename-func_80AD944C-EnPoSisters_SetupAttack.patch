@@ -274,7 +274,8 @@ void EnPoSisters_SetupCircle(EnPoSisters* this) {
     this->actionFunc = func_80ADA6A0;
 }
 
-void func_80AD944C(EnPoSisters* this) {
+// LLM generated name (HIGH), was func_80AD944C: morphs to gPoeSistersAttackAnim, hardens the collider for the lit sister and arms the swing
+void EnPoSisters_SetupAttack(EnPoSisters* this) {
     if (this->unk_22E.a != 0) {
         this->collider.base.colType = COLTYPE_METAL;
         this->collider.base.acFlags |= AC_HARD;
@@ -652,7 +653,7 @@ void func_80ADA6A0(EnPoSisters* this, PlayState* play) {
         Math_ScaledStepToS(&this->actor.world.rot.y, this->actor.yawTowardsPlayer, 0x71C);
     }
     if (this->actor.xzDistToPlayer < 160.0f && fabsf(this->actor.yDistToPlayer + 5.0f) < 30.0f) {
-        func_80AD944C(this);
+        EnPoSisters_SetupAttack(this);  // was func_80AD944C [LLM:HIGH]
     } else if (this->actor.xzDistToPlayer > 240.0f) {
         EnPoSisters_SetupFloat(this);  // was func_80AD93C4 [LLM:HIGH]
     }
