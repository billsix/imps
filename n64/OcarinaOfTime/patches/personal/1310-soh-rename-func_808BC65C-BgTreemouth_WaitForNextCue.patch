From 5063bd21b1464aeda8974258ba638af127b2ca8e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:09:30 +0000
Subject: [PATCH 1310/3799] soh: rename func_808BC65C ->
 BgTreemouth_WaitForNextCue

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the copy of BgTreemouth_WaitForCue that a completed wobble returns to; the two have identical bodies at different addresses.
Defined in soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c b/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c
index 28869578f..4ed66742b 100644
--- a/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c
+++ b/soh/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c
@@ -16,7 +16,8 @@ void BgTreemouth_Destroy(Actor* thisx, PlayState* play);
 void BgTreemouth_Update(Actor* thisx, PlayState* play);
 void BgTreemouth_Draw(Actor* thisx, PlayState* play);
 
-void func_808BC65C(BgTreemouth* this, PlayState* play);
+// LLM generated name (HIGH), was func_808BC65C: the copy of BgTreemouth_WaitForCue that a completed wobble returns to; the two have identical bodies at different addresses.
+void BgTreemouth_WaitForNextCue(BgTreemouth* this, PlayState* play);  // was func_808BC65C [LLM:HIGH]
 void func_808BC6F8(BgTreemouth* this, PlayState* play);
 // LLM generated name (HIGH), was func_808BC80C: raises the mouth-open amount to 0.8, then hands off to the closing half of the wobble.
 void BgTreemouth_WobbleOpen(BgTreemouth* this, PlayState* play);  // was func_808BC80C [LLM:HIGH]
@@ -101,7 +102,7 @@ void BgTreemouth_Destroy(Actor* thisx, PlayState* play) {
     DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
 }
 
-void func_808BC65C(BgTreemouth* this, PlayState* play) {
+void BgTreemouth_WaitForNextCue(BgTreemouth* this, PlayState* play) {
     CsCmdActorCue* npcAction;
 
     if ((play->csCtx.state != CS_STATE_IDLE)) {
@@ -145,7 +146,7 @@ void BgTreemouth_WobbleOpen(BgTreemouth* this, PlayState* play) {
 void BgTreemouth_WobbleClose(BgTreemouth* this, PlayState* play) {
     this->unk_168 -= 0.03f;
     if (this->unk_168 <= 0.0f) {
-        BgTreemouth_SetupAction(this, func_808BC65C);
+        BgTreemouth_SetupAction(this, BgTreemouth_WaitForNextCue);  // was func_808BC65C [LLM:HIGH]
     }
 }
 
