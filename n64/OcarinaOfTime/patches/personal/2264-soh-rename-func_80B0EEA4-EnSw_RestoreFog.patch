From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:19:42 +0000
Subject: [PATCH 2264/3799] soh: rename func_80B0EEA4 -> EnSw_RestoreFog

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: puts the scene's own fog settings back after the override
Defined in soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
index ea30248b6..88f019dbb 100644
--- a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
+++ b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
@@ -1018,7 +1018,8 @@ void EnSw_SetFogForDraw(PlayState* play, Color_RGBA8* arg1, s16 arg2, s16 arg3)
     CLOSE_DISPS(play->state.gfxCtx);
 }
 
-void func_80B0EEA4(PlayState* play) {
+// LLM generated name (HIGH), was func_80B0EEA4: puts the scene's own fog settings back after the override
+void EnSw_RestoreFog(PlayState* play) {
     s32 pad;
 
     OPEN_DISPS(play->state.gfxCtx);
@@ -1045,6 +1046,6 @@ void EnSw_Draw(Actor* thisx, PlayState* play) {
     Gfx_SetupDL_25Opa(play->state.gfxCtx);
     SkelAnime_DrawSkeletonOpa(play, &this->skelAnime, EnSw_OverrideLimbDraw, EnSw_PostLimbDraw, this);
     if (this->actionFunc == EnSw_Chase) {  // was func_80B0E728 [LLM:HIGH]
-        func_80B0EEA4(play);
+        EnSw_RestoreFog(play);  // was func_80B0EEA4 [LLM:HIGH]
     }
 }
