+// LLM generated name (HIGH), was D_80AF0880: CutsceneData installed into csCtx.segment by the VB_PLAY_CHILD_RUTO_INTRO branch, which fires when the player first comes within range of child Ruto.
+static CutsceneData sFirstEncounterCs[] = {  // was D_80AF0880 [LLM:HIGH]
     CS_BEGIN_CUTSCENE(15, 1306),
     CS_PLAYER_ACTION_LIST(10),
         CS_PLAYER_ACTION(0x0027, 0, 50, 0x0000, 0x6C16, 0x0000, 12, -340, -2810, 12, -340, -2810, 1.1393037E-29f, 0.0f, 1.4E-45f),
