Date: Mon, 7 Sep 2026 23:19:17 +0000
Subject: [PATCH 2243/3799] soh: rename func_80B0CEA8 -> EnSw_PlayScuttleSfx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays the gold or wall skulltula roll sound, only when the skulltula is grown and near the camera
Defined in soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
index 251942c3d..55c723f15 100644
--- a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
+++ b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
@@ -442,7 +442,8 @@ s32 EnSw_RotateOnSurface(EnSw* this, f32* arg1) {
     return true;
 }
 
-void func_80B0CEA8(EnSw* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B0CEA8: plays the gold or wall skulltula roll sound, only when the skulltula is grown and near the camera
+void EnSw_PlayScuttleSfx(EnSw* this, PlayState* play) {
     if (!(this->actor.scale.x < 0.0139999995f)) {
         Camera* activeCam = GET_ACTIVE_CAM(play);
 
@@ -567,7 +568,7 @@ void func_80B0D590(EnSw* this, PlayState* play) {
     if (this->unk_38E != 0) {
         this->unk_38E--;
         if (this->unk_38E == 0) {
-            func_80B0CEA8(this, play);
+            EnSw_PlayScuttleSfx(this, play);  // was func_80B0CEA8 [LLM:HIGH]
             this->unk_420 = ((play->state.frames % 2) == 0) ? 0.1f : -0.1f;
             this->unk_38A = 1;
             this->unk_38C = Rand_S16Offset(30, 60);
@@ -590,7 +591,7 @@ void func_80B0D590(EnSw* this, PlayState* play) {
             this->skelAnime.playSpeed = (this->unk_38A == 0) ? 4.0f : 0.0f;
 
             if (this->skelAnime.playSpeed > 0.0f) {
-                func_80B0CEA8(this, play);
+                EnSw_PlayScuttleSfx(this, play);  // was func_80B0CEA8 [LLM:HIGH]
             }
             if (((this->actor.params & 0xE000) >> 0xD) != 0) {
                 this->skelAnime.playSpeed *= 2.0f;
@@ -617,7 +618,7 @@ void func_80B0D878(EnSw* this, PlayState* play) {
     f32 z;
 
     if (Animation_OnFrame(&this->skelAnime, this->skelAnime.endFrame) == 1) {
-        func_80B0CEA8(this, play);
+        EnSw_PlayScuttleSfx(this, play);  // was func_80B0CEA8 [LLM:HIGH]
     }
 
     EnSw_RotateOnSurface(this, &this->unk_420);  // was func_80B0CCF4 [LLM:HIGH]
