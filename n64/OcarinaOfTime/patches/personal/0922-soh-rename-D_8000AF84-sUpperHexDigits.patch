From de1771ecb3c5074c195ab743d8ce411fdee6b20e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:27:07 +0000
Subject: [PATCH 0922/3799] soh: rename D_8000AF84 -> sUpperHexDigits

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: u8 string "0123456789ABCDEF" selected as numMap for the uppercase integer-to-string conversion.
Defined in soh/src/libultra/rmon/xlitob.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/libultra/rmon/xlitob.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/libultra/rmon/xlitob.c b/soh/src/libultra/rmon/xlitob.c
index d19966b13..76777c890 100644
--- a/soh/src/libultra/rmon/xlitob.c
+++ b/soh/src/libultra/rmon/xlitob.c
@@ -4,7 +4,8 @@
 
 // LLM generated name (HIGH), was D_8000AF70: u8 string "0123456789abcdef" selected as numMap for the lowercase integer-to-string conversion.
 u8 sLowerHexDigits[] = "0123456789abcdef";  // was D_8000AF70 [LLM:HIGH]
-u8 D_8000AF84[] = "0123456789ABCDEF";
+// LLM generated name (HIGH), was D_8000AF84: u8 string "0123456789ABCDEF" selected as numMap for the uppercase integer-to-string conversion.
+u8 sUpperHexDigits[] = "0123456789ABCDEF";  // was D_8000AF84 [LLM:HIGH]
 
 void _Litob(_Pft* args, u8 type) {
     u8 buff[BUFF_LEN];
@@ -15,7 +16,7 @@ void _Litob(_Pft* args, u8 type) {
     lldiv_t quotrem;
 
     if (type == 'X') {
-        numMap = D_8000AF84;
+        numMap = sUpperHexDigits;  // was D_8000AF84 [LLM:HIGH]
     } else {
         numMap = sLowerHexDigits;  // was D_8000AF70 [LLM:HIGH]
     }
