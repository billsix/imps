From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:37:34 +0000
Subject: [PATCH 1037/3799] soh: rename func_808A18FC ->
 BgMoriElevator_PlayMoveSfx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays the looping elevator-movement sfx with its volume scaled by the distance still to travel.
Defined in soh/src/overlays/actors/ovl_Bg_Mori_Elevator/z_bg_mori_elevator.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Mori_Elevator/z_bg_mori_elevator.c     | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Mori_Elevator/z_bg_mori_elevator.c b/soh/src/overlays/actors/ovl_Bg_Mori_Elevator/z_bg_mori_elevator.c
index 1c27b25bf..a6782faef 100644
--- a/soh/src/overlays/actors/ovl_Bg_Mori_Elevator/z_bg_mori_elevator.c
+++ b/soh/src/overlays/actors/ovl_Bg_Mori_Elevator/z_bg_mori_elevator.c
@@ -76,7 +76,8 @@ f32 BgMoriElevator_StepToward(f32* pValue, f32 target, f32 scale, f32 maxStep, f
     return var;
 }
 
-void func_808A18FC(BgMoriElevator* this, f32 distTo) {
+// LLM generated name (HIGH), was func_808A18FC: plays the looping elevator-movement sfx with its volume scaled by the distance still to travel.
+void BgMoriElevator_PlayMoveSfx(BgMoriElevator* this, f32 distTo) {
     f32 temp;
 
     temp = fabsf(distTo) * 0.09f;
@@ -165,7 +166,7 @@ void BgMoriElevator_MoveIntoGround(BgMoriElevator* this, PlayState* play) {
         BgMoriElevator_SetupSetPosition(this);
         Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_ELEVATOR_STOP);
     } else {
-        func_808A18FC(this, distToTarget);
+        BgMoriElevator_PlayMoveSfx(this, distToTarget);  // was func_808A18FC [LLM:HIGH]
     }
 }
 
@@ -184,7 +185,7 @@ void BgMoriElevator_MoveAboveGround(BgMoriElevator* this, PlayState* play) {
         BgMoriElevator_SetupSetPosition(this);
         Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_ELEVATOR_STOP);
     } else {
-        func_808A18FC(this, distToTarget);
+        BgMoriElevator_PlayMoveSfx(this, distToTarget);  // was func_808A18FC [LLM:HIGH]
     }
 }
 
@@ -238,7 +239,7 @@ void func_808A2008(BgMoriElevator* this, PlayState* play) {
         Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_ELEVATOR_STOP);
 
     } else {
-        func_808A18FC(this, distTo);
+        BgMoriElevator_PlayMoveSfx(this, distTo);  // was func_808A18FC [LLM:HIGH]
     }
 }
 
