From 385cdcd9a4688432f1a964e96ef7fe235033024b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:05:35 +0000
Subject: [PATCH 1955/3799] soh: rename D_80126190 -> sHookshotHeadOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: hand-space point the held hookshot head actor is placed at while aiming
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index e5f61308a..eafd3643a 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1788,7 +1788,8 @@ Vec3f sRightHandLimbModelShieldQuadVertices[] = {
 
 // LLM generated name (GUESS), was D_80126184: hand-space point transformed into Player.unk_3C8 while the hookshot or longshot is drawn; the field's meaning is not established, so the aim reading is inferred from the reticle branch it sits in
 Vec3f sHookshotAimOffset = { 100.0f, 1500.0f, 0.0f };  // was D_80126184 [LLM:GUESS]
-Vec3f D_80126190 = { 100.0f, 1640.0f, 0.0f };
+// LLM generated name (HIGH), was D_80126190: hand-space point the held hookshot head actor is placed at while aiming
+Vec3f sHookshotHeadOffset = { 100.0f, 1640.0f, 0.0f };  // was D_80126190 [LLM:HIGH]
 
 Vec3f sSheathLimbModelShieldQuadVertices[] = {
     { -3000.0f, -3000.0f, -900.0f },
@@ -1961,7 +1962,7 @@ void Player_PostLimbDrawGameplay(PlayState* play, s32 limbIndex, Gfx** dList, Ve
                     MtxF sp44;
                     s32 pad;
 
-                    Matrix_MultVec3f(&D_80126190, &heldActor->world.pos);
+                    Matrix_MultVec3f(&sHookshotHeadOffset, &heldActor->world.pos);  // was D_80126190 [LLM:HIGH]
                     Matrix_RotateZYX(0, -0x4000, -0x4000, MTXMODE_APPLY);
                     Matrix_Get(&sp44);
                     Matrix_MtxFToYXZRotS(&sp44, &heldActor->world.rot, 0);
-- 
