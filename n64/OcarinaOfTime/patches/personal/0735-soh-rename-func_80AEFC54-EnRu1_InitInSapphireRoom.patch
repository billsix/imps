Subject: [PATCH 0735/3799] soh: rename func_80AEFC54 ->
 EnRu1_InitInSapphireRoom

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 0.97.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 421dd227e..578e13588 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -2272,7 +2272,8 @@ void EnRu1_SapphireRoom_BeingAbducted(EnRu1* this, PlayState* play) {
     EnRu1_RemoveInAbduction(this, play);
 }
 
-void func_80AEFC54(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEFC54): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.97. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_InitInSapphireRoom(EnRu1* this, PlayState* play) {
     if ((Flags_GetInfTable(INFTABLE_145)) && !Flags_GetInfTable(INFTABLE_146)) {
         EnRu1_AnimationChange(this, &gRutoChildWait2Anim, 0, 0, 0);
         this->action = 41;
@@ -2421,7 +2422,7 @@ void EnRu1_Init(Actor* thisx, PlayState* play) {
             EnRu1_InitInJabuJabuBasement(this, play);
             break;
         case 4:
-            func_80AEFC54(this, play);
+            EnRu1_InitInSapphireRoom(this, play);
             break;
         case 5:
             func_80AEFD38(this, play);
