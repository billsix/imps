+++ b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
@@ -700,7 +700,8 @@ void EnSw_Burn(EnSw* this, PlayState* play) {
     }
 }
 
-s16 func_80B0DE34(EnSw* this, Vec3f* arg1) {
+// LLM generated name (HIGH), was func_80B0DE34: returns the roll angle, in the wall's plane, that would face the skulltula at the given point
+s16 EnSw_GetRollToward(EnSw* this, Vec3f* arg1) {
     s16 pitch;
     s16 yaw;
 
@@ -719,7 +720,7 @@ s32 func_80B0DEA8(EnSw* this, PlayState* play, s32 arg2) {
