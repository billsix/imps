+// LLM generated name (HIGH), was func_80969FB4: raises shape.yOffset by a fixed step each frame, lifting Darunia during the chamber cutscene.
+void DemoDu_Rise(DemoDu* this, PlayState* play) {
     this->actor.shape.yOffset += 250.0f / 3.0f;
 }
 
@@ -278,7 +279,7 @@ void DemoDu_UpdateCs_FM_01(DemoDu* this, PlayState* play) {
