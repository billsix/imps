From 632a4b46d45317991a494246567bbed24ea6c629 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:23:58 +0000
Subject: [PATCH 1509/3799] soh: rename func_8088B90C -> BgHidanRock_Settle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: eases the type 1 block the last few units back to home height and returns it to waiting for the player.
Defined in soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
index 6fc3fd3c4..65cd50c3e 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
@@ -29,7 +29,8 @@ void BgHidanRock_WaitForPlayer(BgHidanRock* this, PlayState* play);  // was func
 void BgHidanRock_Shake(BgHidanRock* this, PlayState* play);  // was func_8088B69C [LLM:HIGH]
 // LLM generated name (HIGH), was func_8088B79C: falls under gravity, fading the flame out on the way, and on landing plays the impact and surface sfx before either restarting the cycle or settling.
 void BgHidanRock_Fall(BgHidanRock* this, PlayState* play);  // was func_8088B79C [LLM:HIGH]
-void func_8088B90C(BgHidanRock* this, PlayState* play);
+// LLM generated name (HIGH), was func_8088B90C: eases the type 1 block the last few units back to home height and returns it to waiting for the player.
+void BgHidanRock_Settle(BgHidanRock* this, PlayState* play);  // was func_8088B90C [LLM:HIGH]
 // LLM generated name (HIGH), was func_8088B954: holds the block at the top for twenty frames, then zeroes its vertical velocity and lets it fall.
 void BgHidanRock_HangAtTop(BgHidanRock* this, PlayState* play);  // was func_8088B954 [LLM:HIGH]
 // LLM generated name (HIGH), was func_8088B990: eases the block up to its per-type height, fading the flame column in as it goes, and on arrival arms the pause before it drops.
@@ -265,7 +266,7 @@ void BgHidanRock_Fall(BgHidanRock* this, PlayState* play) {
             this->actionFunc = BgHidanRock_Delay;  // was func_8088B5F4 [LLM:HIGH]
         } else {
             this->dyna.actor.world.pos.y = this->dyna.actor.home.pos.y - 15.0f;
-            this->actionFunc = func_8088B90C;
+            this->actionFunc = BgHidanRock_Settle;  // was func_8088B90C [LLM:HIGH]
             this->dyna.actor.flags &= ~(ACTOR_FLAG_UPDATE_CULLING_DISABLED | ACTOR_FLAG_DRAW_CULLING_DISABLED);
         }
 
@@ -293,7 +294,7 @@ void BgHidanRock_Fall(BgHidanRock* this, PlayState* play) {
     }
 }
 
-void func_8088B90C(BgHidanRock* this, PlayState* play) {
+void BgHidanRock_Settle(BgHidanRock* this, PlayState* play) {
     if (Math_StepToF(&this->dyna.actor.world.pos.y, this->dyna.actor.home.pos.y, 1.0f)) {
         this->actionFunc = BgHidanRock_WaitForPlayer;  // was func_8088B634 [LLM:HIGH]
     }
