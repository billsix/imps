From 1d3dc3a28571bdeabd997d3b13f4d2a64566d205 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:12 +0000
Subject: [PATCH 0023/3799] soh: rename func_800F483C -> Audio_SetMainBgmVolume

Name source: zeldaret/oot.
Defined in soh/src/code/audio_general.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h                       | 2 +-
 soh/src/code/audio_general.c                  | 3 ++-
 soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c | 4 ++--
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index a77d31fec..43eadf327 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -2086,7 +2086,7 @@ void Audio_PlaySoundRiver(Vec3f* pos, f32 freqScale);
 void Audio_PlaySoundWaterfall(Vec3f* pos, f32 freqScale);
 void Audio_SetBgmVolumeOffDuringFanfare(void);
 void Audio_SetBgmVolumeOnDuringFanfare(void);
-void func_800F483C(u8 targetVol, u8 volFadeTimer);
+void Audio_SetMainBgmVolume(u8 targetVol, u8 volFadeTimer);  // was func_800F483C [oot]
 void func_800F4870(u8);
 void func_800F4A54(u8);
 void Audio_PlaySoundIncreasinglyTransposed(Vec3f* pos, s16 sfxId, u8* semitones);
diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 26a0f8818..ea64770b6 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -4548,7 +4548,8 @@ void Audio_SetBgmVolumeOnDuringFanfare(void) {
     Audio_SetVolScale(SEQ_PLAYER_BGM_SUB, 1, 0x7F, 3);
 }
 
-void func_800F483C(u8 targetVol, u8 volFadeTimer) {
+// Name from zeldaret/oot src/audio/game/general.c (was func_800F483C): sets main BGM volume scale over a fade timer. Source: https://github.com/zeldaret/oot/blob/main/src/audio/game/general.c
+void Audio_SetMainBgmVolume(u8 targetVol, u8 volFadeTimer) {
     Audio_SetVolScale(SEQ_PLAYER_BGM_MAIN, 0, targetVol, volFadeTimer);
 }
 
diff --git a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
index be31dbed8..e4e15b764 100644
--- a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
+++ b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
@@ -1854,7 +1854,7 @@ void EnGo2_BiggoronEyedrops(EnGo2* this, PlayState* play) {
             this->eyeMouthTexState = 2;
             this->unk_20C = 0;
             this->goronState++;
-            func_800F483C(0x28, 5);
+            Audio_SetMainBgmVolume(0x28, 5);
             if (GameInteractor_Should(VB_PLAY_EYEDROPS_CS, true)) {
                 OnePointCutscene_Init(play, 4190, -99, &this->actor, CAM_ID_MAIN);
             }
@@ -1871,7 +1871,7 @@ void EnGo2_BiggoronEyedrops(EnGo2* this, PlayState* play) {
                 Message_ContinueTextbox(play, 0x305A);
                 this->eyeMouthTexState = 3;
                 this->goronState++;
-                func_800F483C(0x7F, 5);
+                Audio_SetMainBgmVolume(0x7F, 5);
             }
             break;
         case 2:
-- 
