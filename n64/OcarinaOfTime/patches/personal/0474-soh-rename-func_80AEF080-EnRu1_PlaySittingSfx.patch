From 0c29f236f00c8a5f0f134d9fbbf1e2654d536523 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:49 +0000
Subject: [PATCH 474/784] soh: rename func_80AEF080 -> EnRu1_PlaySittingSfx

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 5cb2310d0..a414eed75 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1881,7 +1881,8 @@ void EnRu1_TurnFullBodyTowardPlayer(EnRu1* this, PlayState* play) {
     this->actor.world.rot.y = this->actor.shape.rot.y;
 }
 
-void func_80AEF080(EnRu1* this) {
+// Name from zeldaret/oot (was func_80AEF080): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_PlaySittingSfx(EnRu1* this) {
     if (Animation_OnFrame(&this->skelAnime, 11.0f)) {
         Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_EV_LAND_DIRT);
     }
@@ -1964,7 +1965,7 @@ void func_80AEF3A8(EnRu1* this, PlayState* play) {
 
     EnRu1_TurnUpperBodyForward(this);
     something = EnRu1_UpdateSkelAnime(this);
-    func_80AEF080(this);
+    EnRu1_PlaySittingSfx(this);
     EnRu1_UpdateEyes(this);
     EnRu1_UpdateBgCheckInfo(this, play);
     func_80AEF1F0(this, play, something);
-- 
