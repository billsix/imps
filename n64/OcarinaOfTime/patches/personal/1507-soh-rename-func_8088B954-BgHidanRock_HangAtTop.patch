     if (this->timer != 0) {
         this->timer--;
     }
@@ -325,7 +326,7 @@ void BgHidanRock_Rise(BgHidanRock* this, PlayState* play) {
             Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_BLOCK_BOUND);
         }
