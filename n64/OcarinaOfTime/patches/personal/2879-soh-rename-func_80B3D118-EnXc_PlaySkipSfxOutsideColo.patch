Subject: [PATCH 2879/3799] soh: rename func_80B3D118 ->
 EnXc_PlaySkipSfxOutsideColossus

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays NA_SE_PL_SKIP everywhere except the Desert Colossus cutscene layer
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 7bb538656..bdb726d4d 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -491,7 +491,8 @@ void EnXc_SetColossusAppearSFX(EnXc* this, PlayState* play) {
     }
 }
 
-void func_80B3D118(PlayState* play) {
+// LLM generated name (HIGH), was func_80B3D118: plays NA_SE_PL_SKIP everywhere except the Desert Colossus cutscene layer
+void EnXc_PlaySkipSfxOutsideColossus(PlayState* play) {
     s16 sceneNum;
 
     if ((gSaveContext.sceneLayer != 4) || (sceneNum = play->sceneNum, sceneNum != SCENE_DESERT_COLOSSUS)) {
@@ -709,7 +710,7 @@ void EnXc_SetupFallFromSkyAction(EnXc* this, PlayState* play) {
             func_80B3D48C(this, play);
             EnXc_ResetAndApplyRootMotion(this, play);  // was func_80B3C964 [LLM:HIGH]
             Animation_Change(skelAnime, &gSheikFallingFromSkyAnim, 1.0f, 0.0f, frameCount, ANIMMODE_ONCE, 0.0f);
-            func_80B3D118(play);
+            EnXc_PlaySkipSfxOutsideColossus(play);  // was func_80B3D118 [LLM:HIGH]
         }
     }
 }
