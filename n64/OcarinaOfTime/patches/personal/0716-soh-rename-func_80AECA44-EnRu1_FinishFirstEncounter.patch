Subject: [PATCH 716/784] soh: rename func_80AECA44 ->
 EnRu1_FinishFirstEncounter

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index cde247506..a6c71ce30 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1025,7 +1025,8 @@ void EnRu1_CheckStartFalling(EnRu1* this) {
     }
 }
 
-void func_80AECA44(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AECA44): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_FinishFirstEncounter(EnRu1* this, PlayState* play) {
     if (EnRu1_CheckCueMatchingId(play, 5, 3)) {
         Flags_SetInfTable(INFTABLE_RUTO_IN_JJ_MEET_RUTO);
         this->action = 14;
@@ -1082,7 +1083,7 @@ void EnRu1_Meeting_FallingDownHole(EnRu1* this, PlayState* play) {
     EnRu1_UpdateEyes(this);
     EnRu1_UpdateBgCheckInfo(this, play);
     EnRu1_PlayStepSfx(this);
-    func_80AECA44(this, play);
+    EnRu1_FinishFirstEncounter(this, play);
 }
 
 void EnRu1_Meeting_End(EnRu1* this, PlayState* play) {
