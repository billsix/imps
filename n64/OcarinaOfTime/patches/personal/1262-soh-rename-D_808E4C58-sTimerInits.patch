From 84933a4a2bdbeadb70398c53d2a5a472fb4d17ce Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:05:51 +0000
Subject: [PATCH 1262/3799] soh: rename D_808E4C58 -> sTimerInits

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: eighteen starting values copied wholesale into the boss's unk_4E4 timer array at three separate points; the array is only ever counted down, and what its eighteen timers each drive is not identified.
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index d1d367571..c47b5867e 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -114,7 +114,8 @@ static ColliderCylinderInit sLightBallCylinderInit = {
     { 20, 30, -15, { 0, 0, 0 } },
 };
 
-static u8 D_808E4C58[] = { 0, 12, 10, 12, 14, 16, 12, 14, 16, 12, 14, 16, 12, 14, 16, 10, 16, 14 };
+// LLM generated name (GUESS), was D_808E4C58: eighteen starting values copied wholesale into the boss's unk_4E4 timer array at three separate points; the array is only ever counted down, and what its eighteen timers each drive is not identified.
+static u8 sTimerInits[] = { 0, 12, 10, 12, 14, 16, 12, 14, 16, 12, 14, 16, 12, 14, 16, 10, 16, 14 };  // was D_808E4C58 [LLM:GUESS]
 static Vec3f sZeroVec = { 0.0f, 0.0f, 0.0f };
 
 static EnGanonMant* sCape;
@@ -2498,7 +2499,7 @@ void BossGanon_SetupHitByLightBall(BossGanon* this, PlayState* play) {
     sCape->attachRightArmTimer = sCape->attachLeftArmTimer = 0;
 
     for (i = 1; i < 15; i++) {
-        this->unk_4E4[i] = D_808E4C58[i];
+        this->unk_4E4[i] = sTimerInits[i];  // was D_808E4C58 [LLM:GUESS]
     }
 
     this->unk_2E6 = 80;
@@ -4079,7 +4080,7 @@ void BossGanon_LightBall_Update(Actor* thisx, PlayState* play2) {
                         ganondorf->timers[2] = 20;
 
                         for (i = 0; i < ARRAY_COUNT(ganondorf->unk_4E4); i++) {
-                            ganondorf->unk_4E4[i] = D_808E4C58[i];
+                            ganondorf->unk_4E4[i] = sTimerInits[i];  // was D_808E4C58 [LLM:GUESS]
                         }
 
                         ganondorf->unk_2E6 = 0;
@@ -4554,7 +4555,7 @@ void BossGanon_BigLightBall_Update(Actor* thisx, PlayState* play) {
                     dorf->timers[2] = 20;
 
                     for (i = 0; i < ARRAY_COUNT(this->unk_4E4); i++) {
-                        dorf->unk_4E4[i] = D_808E4C58[i];
+                        dorf->unk_4E4[i] = sTimerInits[i];  // was D_808E4C58 [LLM:GUESS]
                     }
 
                     dorf->unk_2E6 = 0;
