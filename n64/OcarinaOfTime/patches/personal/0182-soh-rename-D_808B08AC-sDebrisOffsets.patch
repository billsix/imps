From b9b96fbfe70e56585b50ae6c579e1063c3cd7f57 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:13 +0000
Subject: [PATCH 182/488] soh: rename D_808B08AC -> sDebrisOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: local-space Vec3f offsets rotated by the wall's yaw and added to its position to place each shard of the destruction burst.
Defined in soh/src/overlays/actors/ovl_Bg_Spot08_Bakudankabe/z_bg_spot08_bakudankabe.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../z_bg_spot08_bakudankabe.c                         | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot08_Bakudankabe/z_bg_spot08_bakudankabe.c b/soh/src/overlays/actors/ovl_Bg_Spot08_Bakudankabe/z_bg_spot08_bakudankabe.c
index 1176c939c..ebc569fdc 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot08_Bakudankabe/z_bg_spot08_bakudankabe.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot08_Bakudankabe/z_bg_spot08_bakudankabe.c
@@ -83,7 +83,8 @@ static ColliderJntSphInit sJntSphInit = {
     sJntSphElementsInit,
 };
 
-static Vec3f D_808B08AC[] = {
+// LLM generated name (HIGH), was D_808B08AC: local-space Vec3f offsets rotated by the wall's yaw and added to its position to place each shard of the destruction burst.
+static Vec3f sDebrisOffsets[] = {  // was D_808B08AC [LLM:HIGH]
     { 0.0f, 116.65f, 50.0f },
     { 115.0f, 95.0f, 10.0f },
     { -115.0f, 95.0f, 10.0f },
@@ -149,10 +150,10 @@ void BgSpot08Bakudankabe_SpawnDebris(BgSpot08Bakudankabe* this, PlayState* play)
                              0, scale, 1, 3, 80, KAKERA_COLOR_NONE, OBJECT_GAMEPLAY_FIELD_KEEP, gFieldKakeraDL);
     }
 
-    for (i = 0; i < ARRAY_COUNT(D_808B08AC); i++) {
-        burstDepthY.x = this->dyna.actor.world.pos.x + D_808B08AC[i].z * sinY + D_808B08AC[i].x * cosY;
-        burstDepthY.y = this->dyna.actor.world.pos.y + D_808B08AC[i].y;
-        burstDepthY.z = this->dyna.actor.world.pos.z + D_808B08AC[i].z * cosY - (D_808B08AC[i].x * sinY);
+    for (i = 0; i < ARRAY_COUNT(sDebrisOffsets); i++) {  // was D_808B08AC [LLM:HIGH]
+        burstDepthY.x = this->dyna.actor.world.pos.x + sDebrisOffsets[i].z * sinY + sDebrisOffsets[i].x * cosY;  // was D_808B08AC [LLM:HIGH]
+        burstDepthY.y = this->dyna.actor.world.pos.y + sDebrisOffsets[i].y;  // was D_808B08AC [LLM:HIGH]
+        burstDepthY.z = this->dyna.actor.world.pos.z + sDebrisOffsets[i].z * cosY - (sDebrisOffsets[i].x * sinY);  // was D_808B08AC [LLM:HIGH]
         func_80033480(play, &burstDepthY, 120.0f, 4, 0x78, 0xA0, 1);
     }
 }
