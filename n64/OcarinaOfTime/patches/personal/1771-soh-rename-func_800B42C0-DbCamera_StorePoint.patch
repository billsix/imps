Subject: [PATCH 1771/3799] soh: rename func_800B42C0 -> DbCamera_StorePoint

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the inverse: writes the debug camera's current eye and at into the selected spline point, in player-relative coordinates for the relative mode.
Defined in soh/src/code/db_camera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h  | 2 +-
 soh/src/code/db_camera.c | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index d602d2f9c..f5fda757a 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1492,7 +1492,7 @@ void ShrinkWindow_Update(s32 updateRate);
 // ? DbCamera_PlayerRelSToWorld(?);, was func_800B404C [LLM:HIGH]
 // ? DbCamera_EndCut(?);, was func_800B4088 [LLM:HIGH]
 // ? DbCamera_LoadPoint(?);, was func_800B41DC [LLM:HIGH]
-// ? func_800B42C0(?);
+// ? DbCamera_StorePoint(?);, was func_800B42C0 [LLM:HIGH]
 // ? func_800B4370(?);
 // ? func_800B44E0(?);
 // ? DbCamera_PrintPoints(?);
diff --git a/soh/src/code/db_camera.c b/soh/src/code/db_camera.c
index e8478056e..501eaeec3 100644
--- a/soh/src/code/db_camera.c
+++ b/soh/src/code/db_camera.c
@@ -233,7 +233,8 @@ s16 DbCamera_LoadPoint(DbCamera* dbCamera, s16 idx, Camera* cameraPtr) {
     return idx;
 }
 
-s32 func_800B42C0(DbCamera* dbCamera, Camera* cameraPtr) {
+// LLM generated name (HIGH), was func_800B42C0: the inverse: writes the debug camera's current eye and at into the selected spline point, in player-relative coordinates for the relative mode.
+s32 DbCamera_StorePoint(DbCamera* dbCamera, Camera* cameraPtr) {
 
     CutsceneCameraPoint* position = &dbCamera->sub.position[dbCamera->sub.unkIdx];
     CutsceneCameraPoint* lookAt = &dbCamera->sub.lookAt[dbCamera->sub.unkIdx];
@@ -883,7 +884,7 @@ void DbCamera_Update(DbCamera* dbCamera, Camera* cam) {
                 } else {
                     Audio_PlaySfxGeneral(NA_SE_IT_SWORD_PUTAWAY, &gSfxDefaultPos, 4, &gSfxDefaultFreqAndVolScale,
                                          &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
-                    func_800B42C0(dbCamera, cam);
+                    DbCamera_StorePoint(dbCamera, cam);  // was func_800B42C0 [LLM:HIGH]
                     if (dbCamera->sub.unkIdx == (dbCamera->sub.nPoints - 1)) {
                         dbCamera->sub.unkIdx++;
                         dbCamera->sub.nPoints++;
