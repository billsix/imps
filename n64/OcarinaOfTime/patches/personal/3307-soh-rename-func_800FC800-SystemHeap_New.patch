From 5228a7e8de00e120f055c0406c9a7775e44cce91 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:24 +0000
Subject: [PATCH 3307/3799] soh: rename func_800FC800 -> SystemHeap_New

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: allocates from the system arena tagged with the file's "new" string, forcing a minimum of one byte
Defined in soh/src/code/system_heap.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h    | 2 +-
 soh/src/code/system_heap.c | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index b99ade68e..9af21c2f7 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -2188,7 +2188,7 @@ void MtxConv_F2L(Mtx* m1, MtxF* m2);
 void MtxConv_L2F(MtxF* m1, Mtx* m2);
 void Overlay_Relocate(void* allocatedVRamAddress, OverlayRelocationSection* overlayInfo, void* vRamAddress);
 s32 Overlay_Load(uintptr_t vRomStart, uintptr_t vRomEnd, void* vRamStart, void* vRamEnd, void* allocatedVRamAddress);
-// ? func_800FC800(?);
+// ? SystemHeap_New(?);, was func_800FC800 [LLM:HIGH]
 // ? func_800FC83C(?);
 // ? func_800FCAB4(?);
 void SystemHeap_Init(void* start, size_t size);
diff --git a/soh/src/code/system_heap.c b/soh/src/code/system_heap.c
index 32197b417..c9c45f18d 100644
--- a/soh/src/code/system_heap.c
+++ b/soh/src/code/system_heap.c
@@ -97,7 +97,8 @@ s32 Overlay_Load(uintptr_t vRomStart, uintptr_t vRomEnd, void* vRamStart, void*
 }
 
 // possibly some kind of new() function
-void* func_800FC800(size_t size) {
+// LLM generated name (HIGH), was func_800FC800: allocates from the system arena tagged with the file's "new" string, forcing a minimum of one byte
+void* SystemHeap_New(size_t size) {
     if (size == 0) {
         size = 1;
     }
@@ -132,7 +133,7 @@ void* func_800FC948(void* blk, u32 nBlk, u32 blkSize, arg3_800FC948 arg3) {
     uintptr_t pos;
 
     if (blk == NULL) {
-        blk = func_800FC800(nBlk * blkSize);
+        blk = SystemHeap_New(nBlk * blkSize);  // was func_800FC800 [LLM:HIGH]
     }
 
     if (blk != NULL && arg3 != NULL) {
-- 
2.55.0

