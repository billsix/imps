From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:24:03 +0000
Subject: [PATCH 2355/3799] soh: rename func_8086D548 ->
 BgBdanSwitch_ClearSwitchFlag

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: clears this switch's flag, playing the chest sound for the YELLOW_TALL_2 type
Defined in soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
index 2e1fcc310..e07de88bb 100644
--- a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
+++ b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
@@ -236,7 +236,8 @@ void BgBdanSwitch_SetSwitchFlag(BgBdanSwitch* this, PlayState* play) {
     }
 }
 
-void func_8086D548(BgBdanSwitch* this, PlayState* play) {
+// LLM generated name (HIGH), was func_8086D548: clears this switch's flag, playing the chest sound for the YELLOW_TALL_2 type
+void BgBdanSwitch_ClearSwitchFlag(BgBdanSwitch* this, PlayState* play) {
     if (Flags_GetSwitch(play, (this->dyna.actor.params >> 8) & 0x3F)) {
         Flags_UnsetSwitch(play, (this->dyna.actor.params >> 8) & 0x3F);
         if ((this->dyna.actor.params & 0xFF) == YELLOW_TALL_2) {
@@ -297,7 +298,7 @@ void func_8086D754(BgBdanSwitch* this, PlayState* play) {
             if (!DynaPolyActor_IsSwitchPressed(&this->dyna)) {
                 if (this->unk_1D8 <= 0) {
                     func_8086D7FC(this);
-                    func_8086D548(this, play);
+                    BgBdanSwitch_ClearSwitchFlag(this, play);  // was func_8086D548 [LLM:HIGH]
                 }
             } else {
                 this->unk_1D8 = 6;
@@ -465,7 +466,7 @@ void func_8086DCE8(BgBdanSwitch* this, PlayState* play) {
             if (((this->collider.base.acFlags & AC_HIT) != 0) && ((this->unk_1DC & 2) == 0) && (this->unk_1D8 <= 0)) {
                 this->unk_1D8 = 0xA;
                 func_8086DDA8(this);
-                func_8086D548(this, play);
+                BgBdanSwitch_ClearSwitchFlag(this, play);  // was func_8086D548 [LLM:HIGH]
             }
             break;
     }
