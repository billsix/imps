 // LLM generated name (HIGH), was func_808BC9EC: on the cutscene's unskippable init it repositions the player, and then either starts gDekuTreeMouthOpeningCs and sets the opened-mouth flag, or falls back to gDekuTreeAskAgainCs and returns to waiting.
 void BgTreemouth_HandleChoice(BgTreemouth* this, PlayState* play);  // was func_808BC9EC [LLM:HIGH]
-void func_808BCAF0(BgTreemouth* this, PlayState* play);
+// LLM generated name (HIGH), was func_808BCAF0: watches the cutscene's first actor cue: cue 2 starts a wobble, cue 3 plays the wooden-door sfx and opens the mouth fully. BgTreemouth_WaitForNextCue further down is a byte-identical second copy at its own address.
+void BgTreemouth_WaitForCue(BgTreemouth* this, PlayState* play);  // was func_808BCAF0 [LLM:HIGH]
 
 // Name from zeldaret/oot (was D_808BCE20): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c]
 extern CutsceneData gDekuTreeMeetingCs[];
@@ -195,7 +196,7 @@ void BgTreemouth_HandleChoice(BgTreemouth* this, PlayState* play) {
         if (play->msgCtx.choiceIndex == 0) {
             play->csCtx.segment = gDekuTreeMouthOpeningCs;
             Flags_SetEventChkInf(EVENTCHKINF_DEKU_TREE_OPENED_MOUTH);
-            BgTreemouth_SetupAction(this, func_808BCAF0);
+            BgTreemouth_SetupAction(this, BgTreemouth_WaitForCue);  // was func_808BCAF0 [LLM:HIGH]
         } else {
             play->csCtx.segment = gDekuTreeAskAgainCs;
             play->csCtx.frames = 0;
@@ -204,7 +205,7 @@ void BgTreemouth_HandleChoice(BgTreemouth* this, PlayState* play) {
     }
 }
 
-void func_808BCAF0(BgTreemouth* this, PlayState* play) {
+void BgTreemouth_WaitForCue(BgTreemouth* this, PlayState* play) {
     CsCmdActorCue* npcAction;
 
