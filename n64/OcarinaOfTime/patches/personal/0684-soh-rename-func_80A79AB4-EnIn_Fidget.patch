Subject: [PATCH 0684/3799] soh: rename func_80A79AB4 -> EnIn_Fidget

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_In/z_en_in.c.
---
 soh/src/overlays/actors/ovl_En_In/z_en_in.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_In/z_en_in.c b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
index 1992f7911..974397af1 100644
--- a/soh/src/overlays/actors/ovl_En_In/z_en_in.c
+++ b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
@@ -422,7 +422,8 @@ void EnIn_UpdateEyes(EnIn* this) {
     }
 }
 
-void func_80A79AB4(EnIn* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80A79AB4): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_In/z_en_in.c]
+void EnIn_Fidget(EnIn* this, PlayState* play) {
     s32 i;
     u32 f = 0;
 
@@ -945,7 +946,7 @@ void EnIn_Update(Actor* thisx, PlayState* play) {
     EnIn_UpdateEyes(this);
     this->actionFunc(this, play);
     if (this->actionFunc != func_80A7A304) {
-        func_80A79AB4(this, play);
+        EnIn_Fidget(this, play);
         if (gSaveContext.subTimerSeconds < 6 && gSaveContext.subTimerState != SUBTIMER_STATE_OFF &&
             this->interactInfo.talkState == NPC_TALK_STATE_IDLE) {
             if (Actor_ProcessTalkRequest(&this->actor, play)) {}
