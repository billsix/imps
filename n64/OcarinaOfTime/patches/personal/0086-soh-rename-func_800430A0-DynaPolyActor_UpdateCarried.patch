From 7bbcd4dd3473febf447baf0815647caf6e2eb1ca Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:49 +0000
Subject: [PATCH 086/225] soh: rename func_800430A0 ->
 DynaPolyActor_UpdateCarriedActorPos

Name source: zeldaret/oot.
Defined in soh/src/code/z_bg_collect.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/z_bg_collect.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_bg_collect.c b/soh/src/code/z_bg_collect.c
index d1ccacc0d..cbde66863 100644
--- a/soh/src/code/z_bg_collect.c
+++ b/soh/src/code/z_bg_collect.c
@@ -1,7 +1,10 @@
 #include "global.h"
 #include "vt.h"
 
-void func_800430A0(CollisionContext* colCtx, s32 bgId, Actor* actor) {
+// Name from zeldaret/oot src/code/z_bg_collect.c (was func_800430A0): transforms carried actor world
+// pos through bg actor's prev-inverse then current transform matrices.
+// Source: https://github.com/zeldaret/oot/blob/main/src/code/z_bg_collect.c
+void DynaPolyActor_UpdateCarriedActorPos(CollisionContext* colCtx, s32 bgId, Actor* actor) {
     MtxF prevTransform;
     MtxF prevTransformInv;
     MtxF curTransform;
@@ -92,7 +95,7 @@ s32 func_800433A4(CollisionContext* colCtx, s32 bgId, Actor* actor) {
     }
 
     if (dynaActor->transformFlags & 1) {
-        func_800430A0(colCtx, bgId, actor);
+        DynaPolyActor_UpdateCarriedActorPos(colCtx, bgId, actor);
         result = true;
     }
 
