     up.y = 1.0f;
 
-    func_800AA358(&this->view, &eye, &lookAt, &up);
+    View_LookAt(&this->view, &eye, &lookAt, &up);  // was func_800AA358 [LLM:HIGH]
     func_800AAA50(&this->view, 0x7F);
 }
 
