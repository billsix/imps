From 33c1b7e18aa09db9d7a5e39a6da3d28dda9a2922 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:09:37 +0000
Subject: [PATCH 2037/3799] soh: rename D_808B6088 -> sDebrisParams

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the params values BgSpot16Bombstone_SpawnDebris passes to each spawned piece
Defined in soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c b/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
index 4dfb51f5d..1be71f09e 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot16_Bombstone/z_bg_spot16_bombstone.c
@@ -152,7 +152,8 @@ static Vec3f sAcceleration = { 0.0f, 0.4f, 0.0f };
 // LLM generated name (HIGH), was D_808B6074: per-fragment scale factors for the EffectSsKakera shards
 static f32 sFragmentScales[] = { 66.0f, 51.0f, 48.0f, 36.0f, 21.0f };  // was D_808B6074 [LLM:HIGH]
 
-static s16 D_808B6088[] = { 0, 1, 2, 3, 4 };
+// LLM generated name (HIGH), was D_808B6088: the params values BgSpot16Bombstone_SpawnDebris passes to each spawned piece
+static s16 sDebrisParams[] = { 0, 1, 2, 3, 4 };  // was D_808B6088 [LLM:HIGH]
 
 // LLM generated name (HIGH), was func_808B4C30: pulls the switch flag out of the high byte of params and leaves the type in the low byte
 void BgSpot16Bombstone_SplitParams(BgSpot16Bombstone* this) {
@@ -370,9 +371,9 @@ void BgSpot16Bombstone_SpawnDebris(BgSpot16Bombstone* this, PlayState* play) {
     PosRot* world;
 
     world = &this->actor.world;
-    for (index = 0; index < ARRAY_COUNT(D_808B6088); index++) {
+    for (index = 0; index < ARRAY_COUNT(sDebrisParams); index++) {  // was D_808B6088 [LLM:HIGH]
         if (Actor_Spawn(&play->actorCtx, play, ACTOR_BG_SPOT16_BOMBSTONE, world->pos.x, world->pos.y, world->pos.z, 0,
-                        0, 0, D_808B6088[index]) == NULL) {
+                        0, 0, sDebrisParams[index]) == NULL) {  // was D_808B6088 [LLM:HIGH]
             break;
         }
     }
