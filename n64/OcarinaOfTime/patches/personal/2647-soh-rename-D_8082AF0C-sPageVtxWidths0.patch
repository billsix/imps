From 21b7885ebf96647757614509256370873c3a055c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:40 +0000
Subject: [PATCH 2647/3799] soh: rename D_8082AF0C -> sPageVtxWidths0

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the widths in slot 0 of the sPageVtxWidths table
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index a38d5cda7..963f30060 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2627,7 +2627,8 @@ static s16 sPageVtxX4[] = {  // was D_8082AEC0 [LLM:HIGH]
 static s16 sPageVtxX5[] = {  // was D_8082AF00 [LLM:HIGH]
     0xFFB4, 0xFFC6, 0x000A, 0xFFC6, 0x000A, 0x0000,
 };
-static s16 D_8082AF0C[] = {
+// LLM generated name (HIGH), was D_8082AF0C: the widths in slot 0 of the sPageVtxWidths table
+static s16 sPageVtxWidths0[] = {  // was D_8082AF0C [LLM:HIGH]
     0x0000,
     0x0000,
 };
@@ -2695,7 +2696,7 @@ static s16* D_8082B000[] = {
 };
 
 static s16* D_8082B018[] = {
-    D_8082AF0C, D_8082AF10, D_8082AF14, D_8082AF38, sCloudTexWidths, D_8082AF3C,  // was D_8082AAEC [LLM:HIGH]
+    sPageVtxWidths0, D_8082AF10, D_8082AF14, D_8082AF38, sCloudTexWidths, D_8082AF3C,  // was D_8082AAEC [LLM:HIGH]
 };
 
 static s16* D_8082B030[] = {
