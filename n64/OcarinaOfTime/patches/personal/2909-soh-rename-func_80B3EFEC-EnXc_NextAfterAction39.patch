From 15fb703a601190625eb00f54b5135c16c16ea530 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:44 +0000
Subject: [PATCH 2909/3799] soh: rename func_80B3EFEC -> EnXc_NextAfterAction39

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same guard from action 39 to 40
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index efd6459c1..f58fbb8c3 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -1331,7 +1331,8 @@ void EnXc_NextAfterAction38(EnXc* this) {
     EnXc_CheckAndSetAction(this, SHEIK_ACTION_38, SHEIK_ACTION_39);
 }
 
-void func_80B3EFEC(EnXc* this) {
+// LLM generated name (HIGH), was func_80B3EFEC: the same guard from action 39 to 40
+void EnXc_NextAfterAction39(EnXc* this) {
     EnXc_CheckAndSetAction(this, SHEIK_ACTION_39, SHEIK_ACTION_40);
 }
 
@@ -1410,7 +1411,7 @@ void EnXc_ActionFunc38(EnXc* this, PlayState* play) {
 
 void EnXc_ActionFunc39(EnXc* this, PlayState* play) {
     EnXc_ReverseAccelerate(this, play);
-    func_80B3EFEC(this);
+    EnXc_NextAfterAction39(this);  // was func_80B3EFEC [LLM:HIGH]
 }
 
 void EnXc_ActionFunc40(EnXc* this, PlayState* play) {
