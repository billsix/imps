Subject: [PATCH 0593/3799] soh: rename func_8005AD1C -> Camera_UnsetStateFlag

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/z_camera.c.
---
 soh/include/functions.h                                        | 2 +-
 soh/src/code/z_camera.c                                        | 3 ++-
 .../overlays/actors/ovl_Bg_Bdan_Objects/z_bg_bdan_objects.c    | 2 +-
 soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c        | 2 +-
 soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c                  | 2 +-
 5 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index cf94dbb2b..cecdef4f0 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -746,7 +746,7 @@ s32 Camera_AddQuake(Camera* camera, s32 arg1, s16 y, s32 countdown);
 s32 Camera_SetParam(Camera* camera, s32 param, void* value);
 s32 Camera_OverwriteStateFlags(Camera* camera, s16 arg1);  // was func_8005AC48 [oot]
 s16 Camera_SetStateFlag(Camera* camera, s16 arg1);  // was func_8005ACFC [oot]
-s16 func_8005AD1C(Camera* camera, s16 arg1);
+s16 Camera_UnsetStateFlag(Camera* camera, s16 arg1);  // was func_8005AD1C [oot]
 s32 Camera_ResetAnim(Camera* camera);
 s32 Camera_SetCSParams(Camera* camera, CutsceneCameraPoint* atPoints, CutsceneCameraPoint* eyePoints, Player* player,
                        s16 relativeToPlayer);
diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index ba18c3c1e..2559f9aa6 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -8206,7 +8206,8 @@ s16 Camera_SetStateFlag(Camera* camera, s16 arg1) {
     return camera->unk_14C;
 }
 
-s16 func_8005AD1C(Camera* camera, s16 arg1) {
+// Name from zeldaret/oot (was func_8005AD1C): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_camera.c]
+s16 Camera_UnsetStateFlag(Camera* camera, s16 arg1) {
     camera->unk_14C &= ~arg1;
     return camera->unk_14C;
 }
