+    BgMoriElevator_StepToward(&this->dyna.actor.velocity.y, 2.0f, 0.05f, 1.0f, 0.0f);  // was func_808A1800 [LLM:HIGH]
+    distToTarget = BgMoriElevator_StepToward(&this->dyna.actor.world.pos.y, 73.0f, 0.08f, this->dyna.actor.velocity.y, 1.5f);  // was func_808A1800 [LLM:HIGH]
     if (fabsf(distToTarget) < 0.001f) {
         BgMoriElevator_SetupSetPosition(this);
         Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_ELEVATOR_STOP);
