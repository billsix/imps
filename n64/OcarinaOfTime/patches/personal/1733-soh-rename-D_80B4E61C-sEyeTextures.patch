From df36546e2b2ee4b934207c382f917d917f6a26e3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:40:07 +0000
Subject: [PATCH 1733/3799] soh: rename D_80B4E61C -> sEyeTextures

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the eye textures Zelda's blink cycles through, indexed by the blink frame.
Defined in soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c b/soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c
index 1130f9e09..0f30bd57b 100644
--- a/soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c
+++ b/soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c
@@ -61,7 +61,8 @@ static ColliderCylinderInit sCylinderInit = {
     { 20, 46, 0, { 0, 0, 0 } },
 };
 
-static void* D_80B4E61C[] = {
+// LLM generated name (HIGH), was D_80B4E61C: the eye textures Zelda's blink cycles through, indexed by the blink frame.
+static void* sEyeTextures[] = {  // was D_80B4E61C [LLM:HIGH]
     gChildZelda1EyeOpenLookingUpRightTex,
     gChildZelda1EyeHalf2Tex,
     gChildZelda1EyeClosedTex,
@@ -135,8 +136,8 @@ void func_80B4AE18(EnZl1* this) {
         }
         this->unk_1FE = (this->unk_1FC < 4) ? this->unk_1FC : 0;
 
-        this->unk_1F4 = D_80B4E61C[this->unk_1FE];
-        this->unk_1F8 = D_80B4E61C[this->unk_1FE];
+        this->unk_1F4 = sEyeTextures[this->unk_1FE];  // was D_80B4E61C [LLM:HIGH]
+        this->unk_1F8 = sEyeTextures[this->unk_1FE];  // was D_80B4E61C [LLM:HIGH]
         this->unk_1EC = D_80B4E62C[this->unk_1F2];
     }
 }
