     gSaveContext.retainWeatherMode = 0;
     R_ENV_LIGHT1_DIR(0) = 80;
@@ -585,7 +586,7 @@ void Environment_UpdateStorm(EnvironmentContext* envCtx, u8 unused) {
                     envCtx->unk_21 = 1;
                     envCtx->unk_1F = 0;
                     envCtx->unk_20 = 2;
