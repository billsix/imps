From 198b969cdd66735dba3fb0640bd5909e63ad85eb Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:51:21 +0000
Subject: [PATCH 1132/3799] soh: rename D_80BA1B84 -> sDLists

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the two pot display lists, indexed by params bit 8 in the draw function.
Defined in soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c b/soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c
index a571c8a3f..19803aade 100644
--- a/soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c
+++ b/soh/src/overlays/actors/ovl_Obj_Tsubo/z_obj_tsubo.c
@@ -56,7 +56,8 @@ const ActorInit Obj_Tsubo_InitVars = {
 
 static s16 sObjectIds[] = { OBJECT_GAMEPLAY_DANGEON_KEEP, OBJECT_TSUBO };
 
-static Gfx* D_80BA1B84[] = { gPotDL, object_tsubo_DL_0017C0 };
+// LLM generated name (HIGH), was D_80BA1B84: the two pot display lists, indexed by params bit 8 in the draw function.
+static Gfx* sDLists[] = { gPotDL, object_tsubo_DL_0017C0 };  // was D_80BA1B84 [LLM:HIGH]
 
 static Gfx* D_80BA1B8C[] = { gPotFragmentDL, object_tsubo_DL_001960 };
 
@@ -344,5 +345,5 @@ void ObjTsubo_Update(Actor* thisx, PlayState* play) {
 }
 
 void ObjTsubo_Draw(Actor* thisx, PlayState* play) {
-    Gfx_DrawDListOpa(play, D_80BA1B84[(thisx->params >> 8) & 1]);
+    Gfx_DrawDListOpa(play, sDLists[(thisx->params >> 8) & 1]);  // was D_80BA1B84 [LLM:HIGH]
 }
