+++ b/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
@@ -331,7 +331,7 @@ void EnNb_SetupChamberCsImpl(EnNb* this, PlayState* play) {
     if ((gSaveContext.chamberCutsceneNum == 3) && (gSaveContext.sceneLayer < 4)) {
         player = GET_PLAYER(play);
         this->action = NB_CHAMBER_UNDERGROUND;
-        play->csCtx.segment = &D_80AB431C;
+        play->csCtx.segment = &sSpiritMedallionCs;  // was D_80AB431C [LLM:HIGH]
         gSaveContext.cutsceneTrigger = 2;
         if (GameInteractor_Should(VB_GIVE_ITEM_SPIRIT_MEDALLION, true)) {
             Item_Give(play, ITEM_MEDALLION_SPIRIT);
