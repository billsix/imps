From f479b53f9a1842ee7d0f2434ee47215e452c8767 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:55 +0000
Subject: [PATCH 2494/3799] soh: rename func_800F3990 ->
 Audio_ComputeSoundHeightParam

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: maps a sound's Y position onto 0-127 with the low bit forced, and the result goes out as a per-channel parameter in surround mode; what the receiving channel does with it is not established
Defined in soh/src/code/audio_general.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 28877bfad..7de748d44 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -4182,7 +4182,8 @@ u8 Audio_ComputeSoundFilter(f32 behindScreenZ, SoundBankEntry* arg1, s8 arg2) {
     return (phi_v1 * 0x10) + (u8)((phi_f0 * phi_f12) / (10000.0f / 5.2f));
 }
 
-s8 func_800F3990(f32 arg0, u16 sfxParams) {
+// LLM generated name (GUESS), was func_800F3990: maps a sound's Y position onto 0-127 with the low bit forced, and the result goes out as a per-channel parameter in surround mode; what the receiving channel does with it is not established
+s8 Audio_ComputeSoundHeightParam(f32 arg0, u16 sfxParams) {
     s8 ret = 0;
 
     if (arg0 >= 0.0f) {
@@ -4215,7 +4216,7 @@ void Audio_SetSfxProperties(u8 bankId, u8 entryIdx, u8 channelIdx) {
         case BANK_ENEMY:
         case BANK_VOICE:
             if (sSoundOutputMode == 2) {
-                sp38 = func_800F3990(*entry->posY, entry->sfxParams);
+                sp38 = Audio_ComputeSoundHeightParam(*entry->posY, entry->sfxParams);  // was func_800F3990 [LLM:GUESS]
             }
             // fallthrough
         case BANK_OCARINA:
