From 505a7ed132c4976b6affa411074cdbba82296bfc Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:41:10 +0000
Subject: [PATCH 2593/3799] soh: rename func_80ACADF0 -> EnOwl_GerudoAdvance

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: continues the Gerudo Valley message into its choice
Defined in soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
index 23461a37a..dcdbfd9bb 100644
--- a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
+++ b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
@@ -40,7 +40,8 @@ void func_80ACD2CC(EnOwl* this, PlayState* play);
 void EnOwl_HyruleCastleAdvance(EnOwl* this, PlayState* play);  // was func_80ACAA54 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80ACAC6C: continues into text 0x206A and hands over to that choice
 void EnOwl_KakarikoAdvance(EnOwl* this, PlayState* play);  // was func_80ACAC6C [LLM:HIGH]
-void func_80ACADF0(EnOwl* this, PlayState* play);
+// LLM generated name (HIGH), was func_80ACADF0: continues the Gerudo Valley message into its choice
+void EnOwl_GerudoAdvance(EnOwl* this, PlayState* play);  // was func_80ACADF0 [LLM:HIGH]
 void func_80ACAF74(EnOwl* this, PlayState* play);
 void func_80ACC30C(EnOwl* this, PlayState* play);
 void func_80ACB4FC(EnOwl* this, PlayState* play);
@@ -499,7 +500,7 @@ void EnOwl_GerudoChoice(EnOwl* this, PlayState* play) {
         switch (play->msgCtx.choiceIndex) {
             case OWL_REPEAT:
                 Message_ContinueTextbox(play, 0x206F);
-                this->actionFunc = func_80ACADF0;
+                this->actionFunc = EnOwl_GerudoAdvance;  // was func_80ACADF0 [LLM:HIGH]
                 break;
             case OWL_OK:
                 Message_ContinueTextbox(play, 0x2070);
@@ -512,7 +513,7 @@ void EnOwl_GerudoChoice(EnOwl* this, PlayState* play) {
     }
 }
 
-void func_80ACADF0(EnOwl* this, PlayState* play) {
+void EnOwl_GerudoAdvance(EnOwl* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT && Message_ShouldAdvance(play)) {
         Message_ContinueTextbox(play, 0x206A);
         this->actionFunc = EnOwl_GerudoChoice;  // was func_80ACAD34 [LLM:HIGH]
@@ -526,7 +527,7 @@ void EnOwl_WaitGerudo(EnOwl* this, PlayState* play) {
 
     if (EnOwl_CheckInitTalk(this, play, 0x206F, 360.0f, 0)) {
         Audio_PlayFanfare(NA_BGM_OWL);
-        this->actionFunc = func_80ACADF0;
+        this->actionFunc = EnOwl_GerudoAdvance;  // was func_80ACADF0 [LLM:HIGH]
     }
 }
 
