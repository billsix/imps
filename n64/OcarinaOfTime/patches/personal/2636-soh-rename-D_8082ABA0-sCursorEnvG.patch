From 414741f0071709e78a9182fb6c3da435b7034b22 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:39 +0000
Subject: [PATCH 2636/3799] soh: rename D_8082ABA0 -> sCursorEnvG

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: green of that env colour
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_scope_PAL.c     | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 846078d20..aa689045d 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -932,7 +932,8 @@ static s16 sCursorPrimA = 255;  // was D_8082AB98 [LLM:HIGH]
 
 // LLM generated name (HIGH), was D_8082AB9C: red of the pause cursor env colour
 static s16 sCursorEnvR = 255;  // was D_8082AB9C [LLM:HIGH]
-static s16 D_8082ABA0 = 0;
+// LLM generated name (HIGH), was D_8082ABA0: green of that env colour
+static s16 sCursorEnvG = 0;  // was D_8082ABA0 [LLM:HIGH]
 static s16 D_8082ABA4 = 0;
 
 static s16 sInDungeonScene = false;
@@ -3474,7 +3475,7 @@ void KaleidoScope_DrawGameOver(PlayState* play) {
                       COMBINED, ENVIRONMENT, COMBINED, 0, PRIMITIVE, 0);
 
     gDPSetPrimColor(POLY_OPA_DISP++, 0, 80, sCursorPrimR, sCursorPrimG, sCursorPrimB, sCursorPrimA);  // was D_8082AB8C [LLM:HIGH]
-    gDPSetEnvColor(POLY_OPA_DISP++, sCursorEnvR, D_8082ABA0, D_8082ABA4, 255);  // was D_8082AB9C [LLM:HIGH]
+    gDPSetEnvColor(POLY_OPA_DISP++, sCursorEnvR, sCursorEnvG, D_8082ABA4, 255);  // was D_8082AB9C [LLM:HIGH]
 
     VREG(89) -= 2;
 
@@ -4576,7 +4577,7 @@ void KaleidoScope_Update(PlayState* play) {
             sCursorPrimB = 0;  // was D_8082AB94 [LLM:HIGH]
             sCursorPrimA = 0;  // was D_8082AB98 [LLM:HIGH]
             sCursorEnvR = 30;  // was D_8082AB9C [LLM:HIGH]
-            D_8082ABA0 = 0;
+            sCursorEnvG = 0;  // was D_8082ABA0 [LLM:HIGH]
             D_8082ABA4 = 0;
             D_8082B260 = 30;
             VREG(88) = 98;
@@ -4611,17 +4612,17 @@ void KaleidoScope_Update(PlayState* play) {
             }
 
             stepR = ABS(sCursorEnvR - 255) / D_8082B260;  // was D_8082AB9C [LLM:HIGH]
-            stepG = ABS(D_8082ABA0 - 130) / D_8082B260;
+            stepG = ABS(sCursorEnvG - 130) / D_8082B260;  // was D_8082ABA0 [LLM:HIGH]
             stepB = ABS(D_8082ABA4) / D_8082B260;
             if (sCursorEnvR >= 255) {  // was D_8082AB9C [LLM:HIGH]
                 sCursorEnvR -= stepR;  // was D_8082AB9C [LLM:HIGH]
             } else {
                 sCursorEnvR += stepR;  // was D_8082AB9C [LLM:HIGH]
             }
-            if (D_8082ABA0 >= 130) {
-                D_8082ABA0 -= stepG;
+            if (sCursorEnvG >= 130) {  // was D_8082ABA0 [LLM:HIGH]
+                sCursorEnvG -= stepG;  // was D_8082ABA0 [LLM:HIGH]
             } else {
-                D_8082ABA0 += stepG;
+                sCursorEnvG += stepG;  // was D_8082ABA0 [LLM:HIGH]
             }
             if (D_8082ABA4 >= 0) {
                 D_8082ABA4 -= stepB;
@@ -4637,7 +4638,7 @@ void KaleidoScope_Update(PlayState* play) {
                 sCursorPrimA = 255;  // was D_8082AB98 [LLM:HIGH]
 
                 sCursorEnvR = 255;  // was D_8082AB9C [LLM:HIGH]
-                D_8082ABA0 = 130;
+                sCursorEnvG = 130;  // was D_8082ABA0 [LLM:HIGH]
                 D_8082ABA4 = 0;
 
                 pauseCtx->state++;
-- 
2.55.0

