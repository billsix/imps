From c23e50240e59d7ff34e50f65229d070a36667149 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:41:13 +0000
Subject: [PATCH 2624/3799] soh: rename func_80ACD220 -> EnOwl_FlyToward

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sets the speed and heading to close on a point by the caller's weight
Defined in soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
index 27f7e3dfe..82d246144 100644
--- a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
+++ b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
@@ -1403,7 +1403,8 @@ f32 EnOwl_GetCueWeight(PlayState* play, s32 idx) {
     return ret;
 }
 
-void func_80ACD220(EnOwl* this, Vec3f* arg1, f32 arg2) {
+// LLM generated name (HIGH), was func_80ACD220: sets the speed and heading to close on a point by the caller's weight
+void EnOwl_FlyToward(EnOwl* this, Vec3f* arg1, f32 arg2) {
     Vec3f rpy;
 
     rpy.x = (arg1->x - this->actor.world.pos.x) * arg2;
@@ -1447,7 +1448,7 @@ void func_80ACD2CC(EnOwl* this, PlayState* play) {
     } else {
         pos.x -= Math_SinS(angle) * this->unk_3F8;
         pos.z += Math_CosS(angle) * this->unk_3F8;
-        func_80ACD220(this, &pos, 1.0f);
+        EnOwl_FlyToward(this, &pos, 1.0f);  // was func_80ACD220 [LLM:HIGH]
     }
 }
 
@@ -1465,5 +1466,5 @@ void func_80ACD4D4(EnOwl* this, PlayState* play) {
     pos.x = (endPosf.x - pos.x) * temp_ret + pos.x;
     pos.y = (endPosf.y - pos.y) * temp_ret + pos.y;
     pos.z = (endPosf.z - pos.z) * temp_ret + pos.z;
-    func_80ACD220(this, &pos, 1.0f);
+    EnOwl_FlyToward(this, &pos, 1.0f);  // was func_80ACD220 [LLM:HIGH]
 }
