From 208c446c04936a7df315e4a39c2349001ac5e088 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:07:16 +0000
Subject: [PATCH 1274/3799] soh: rename func_80041D70 ->
 SurfaceType_GetUnkProperty

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: its doc comment reads "SurfaceType Get ? Property (& 0x001C 0000)"; it extracts bits 18 to 20 of the surface type word, and the question mark in that comment is the whole of what is known about the field. Nothing calls it.
Defined in soh/src/code/z_bgcheck.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h  | 2 +-
 soh/src/code/z_bgcheck.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 716ae5495..bda6aa7c3 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -681,7 +681,7 @@ Vec3s* BgCheck_GetBgCamFuncDataImpl(CollisionContext* colCtx, s32 bgCamIndex, s3
 Vec3s* SurfaceType_GetCamPosData(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
 u32 SurfaceType_GetSceneExitIndex(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
 u32 SurfaceType_GetFloorType(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
-u32 func_80041D70(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
+u32 SurfaceType_GetUnkProperty(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041D70 [LLM:GUESS]
 u32 SurfaceType_GetWallType(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041D94 [oot]
 s32 SurfaceType_GetWallFlags(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
 s32 SurfaceType_CheckWallFlag0(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041DE4 [oot]
diff --git a/soh/src/code/z_bgcheck.c b/soh/src/code/z_bgcheck.c
index f6884e842..389a71afd 100644
--- a/soh/src/code/z_bgcheck.c
+++ b/soh/src/code/z_bgcheck.c
@@ -4016,7 +4016,8 @@ u32 SurfaceType_GetFloorType(CollisionContext* colCtx, CollisionPoly* poly, s32
 /**
  * SurfaceType Get ? Property (& 0x001C 0000)
  */
-u32 func_80041D70(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
+// LLM generated name (GUESS), was func_80041D70: its doc comment reads "SurfaceType Get ? Property (& 0x001C 0000)"; it extracts bits 18 to 20 of the surface type word, and the question mark in that comment is the whole of what is known about the field. Nothing calls it.
+u32 SurfaceType_GetUnkProperty(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
     return SurfaceType_GetData(colCtx, poly, bgId, 0) >> 18 & 7;
 }
 
