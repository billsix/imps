-    a0[0][2] = a1[0][0] * a2[2][0] + a1[0][1] * a2[2][1] + a1[0][2] * a2[2][2];
+    dst[0][0] = mtx[0][0] * camMtx[0][0] + mtx[0][1] * camMtx[0][1] + mtx[0][2] * camMtx[0][2];
+    dst[0][1] = mtx[0][0] * camMtx[1][0] + mtx[0][1] * camMtx[1][1] + mtx[0][2] * camMtx[1][2];
+    dst[0][2] = mtx[0][0] * camMtx[2][0] + mtx[0][1] * camMtx[2][1] + mtx[0][2] * camMtx[2][2];
 
-    a0[1][0] = a1[1][0] * a2[0][0] + a1[1][1] * a2[0][1] + a1[1][2] * a2[0][2];
-    a0[1][1] = a1[1][0] * a2[1][0] + a1[1][1] * a2[1][1] + a1[1][2] * a2[1][2];
-    a0[1][2] = a1[1][0] * a2[2][0] + a1[1][1] * a2[2][1] + a1[1][2] * a2[2][2];
+    dst[1][0] = mtx[1][0] * camMtx[0][0] + mtx[1][1] * camMtx[0][1] + mtx[1][2] * camMtx[0][2];
+    dst[1][1] = mtx[1][0] * camMtx[1][0] + mtx[1][1] * camMtx[1][1] + mtx[1][2] * camMtx[1][2];
+    dst[1][2] = mtx[1][0] * camMtx[2][0] + mtx[1][1] * camMtx[2][1] + mtx[1][2] * camMtx[2][2];
 
-    a0[2][0] = a1[2][0] * a2[0][0] + a1[2][1] * a2[0][1] + a1[2][2] * a2[0][2];
-    a0[2][1] = a1[2][0] * a2[1][0] + a1[2][1] * a2[1][1] + a1[2][2] * a2[1][2];
-    a0[2][2] = a1[2][0] * a2[2][0] + a1[2][1] * a2[2][1] + a1[2][2] * a2[2][2];
+    dst[2][0] = mtx[2][0] * camMtx[0][0] + mtx[2][1] * camMtx[0][1] + mtx[2][2] * camMtx[0][2];
+    dst[2][1] = mtx[2][0] * camMtx[1][0] + mtx[2][1] * camMtx[1][1] + mtx[2][2] * camMtx[1][2];
+    dst[2][2] = mtx[2][0] * camMtx[2][0] + mtx[2][1] * camMtx[2][1] + mtx[2][2] * camMtx[2][2];
 
-    a0[3][0] = a1[3][0] * a2[0][0] + a1[3][1] * a2[0][1] + a1[3][2] * a2[0][2] - spC;
-    a0[3][1] = a1[3][0] * a2[1][0] + a1[3][1] * a2[1][1] + a1[3][2] * a2[1][2] - sp8;
-    a0[3][2] = a1[3][0] * a2[2][0] + a1[3][1] * a2[2][1] + a1[3][2] * a2[2][2] - sp4;
+    dst[3][0] = mtx[3][0] * camMtx[0][0] + mtx[3][1] * camMtx[0][1] + mtx[3][2] * camMtx[0][2] - transX;
+    dst[3][1] = mtx[3][0] * camMtx[1][0] + mtx[3][1] * camMtx[1][1] + mtx[3][2] * camMtx[1][2] - transY;
+    dst[3][2] = mtx[3][0] * camMtx[2][0] + mtx[3][1] * camMtx[2][1] + mtx[3][2] * camMtx[2][2] - transZ;
 
-    a0[0][3] = 0;
-    a0[1][3] = 0;
-    a0[2][3] = 0;
-    a0[3][3] = 1.0f;
+    dst[0][3] = 0;
+    dst[1][3] = 0;
+    dst[2][3] = 0;
+    dst[3][3] = 1.0f;
 }
 
