From 7db9d949a534b90d48f09101006ac353aa23056b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:35:18 +0000
Subject: [PATCH 1004/3799] soh: rename D_80B43F64 -> sTextures

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the top and bottom floor-tile textures, bound to segment 0x08 by the draw function.
Defined in soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c b/soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c
index 31d054a48..8701cf2e5 100644
--- a/soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c
+++ b/soh/src/overlays/actors/ovl_En_Yukabyun/z_en_yukabyun.c
@@ -60,7 +60,8 @@ static InitChainEntry sInitChain[] = {
     ICHAIN_F32(targetArrowOffset, 16, ICHAIN_STOP),
 };
 
-static void* D_80B43F64[] = { gFloorTileEnemyTopTex, gFloorTileEnemyBottomTex };
+// LLM generated name (HIGH), was D_80B43F64: the top and bottom floor-tile textures, bound to segment 0x08 by the draw function.
+static void* sTextures[] = { gFloorTileEnemyTopTex, gFloorTileEnemyBottomTex };  // was D_80B43F64 [LLM:HIGH]
 
 void EnYukabyun_Init(Actor* thisx, PlayState* play) {
     EnYukabyun* this = (EnYukabyun*)thisx;
@@ -155,7 +156,7 @@ void EnYukabyun_Draw(Actor* thisx, PlayState* play) {
     OPEN_DISPS(play->state.gfxCtx);
 
     Gfx_SetupDL_25Opa(play->state.gfxCtx);
-    gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_80B43F64[this->unk_152]));
+    gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(sTextures[this->unk_152]));  // was D_80B43F64 [LLM:HIGH]
     gSPMatrix(POLY_OPA_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
     gSPDisplayList(POLY_OPA_DISP++, gFloorTileEnemyDL);
 
-- 
