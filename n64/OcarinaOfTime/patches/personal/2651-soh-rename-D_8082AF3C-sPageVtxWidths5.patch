Date: Mon, 7 Sep 2026 23:43:40 +0000
Subject: [PATCH 2651/3799] soh: rename D_8082AF3C -> sPageVtxWidths5

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the widths in slot 5 of the sPageVtxWidths table
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 87401bb66..e939902e6 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2647,7 +2647,8 @@ static s16 sPageVtxWidths3[] = {  // was D_8082AF38 [LLM:HIGH]
     0x0000,
     0x0000,
 };
-static s16 D_8082AF3C[] = {
+// LLM generated name (HIGH), was D_8082AF3C: the widths in slot 5 of the sPageVtxWidths table
+static s16 sPageVtxWidths5[] = {  // was D_8082AF3C [LLM:HIGH]
     0x0098, 0x0030, 0x0030, 0x0030, 0x0030, 0x0000,
 };
 static s16 D_8082AF48[] = {
@@ -2699,7 +2700,7 @@ static s16* D_8082B000[] = {
 };
 
 static s16* D_8082B018[] = {
-    sPageVtxWidths0, sPageVtxWidths1, sPageVtxWidths2, sPageVtxWidths3, sCloudTexWidths, D_8082AF3C,  // was D_8082AAEC [LLM:HIGH]
+    sPageVtxWidths0, sPageVtxWidths1, sPageVtxWidths2, sPageVtxWidths3, sCloudTexWidths, sPageVtxWidths5,  // was D_8082AAEC [LLM:HIGH]
 };
 
 static s16* D_8082B030[] = {
