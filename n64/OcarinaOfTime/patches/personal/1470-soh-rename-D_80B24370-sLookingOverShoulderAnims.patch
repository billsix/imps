From f8f5faf7d03545990d9917bb79e60f8bcf88642d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:16 +0000
Subject: [PATCH 1470/3799] soh: rename D_80B24370 -> sLookingOverShoulderAnims

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the held pose each twin settles into after that turn, installed as this->animation on the same frame.
Defined in soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
index a6807cfd7..e99cb4e2b 100644
--- a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
+++ b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
@@ -50,7 +50,8 @@ static AnimationHeader* sLookOverShoulderAnims[] = {  // was D_80B24368 [LLM:HIG
     &gKotakeKoumeLookOverRightShoulderAnim,
 };
 
-static AnimationHeader* D_80B24370[] = {
+// LLM generated name (HIGH), was D_80B24370: the held pose each twin settles into after that turn, installed as this->animation on the same frame.
+static AnimationHeader* sLookingOverShoulderAnims[] = {  // was D_80B24370 [LLM:HIGH]
     &gKotakeKoumeLookingOverLeftShoulderAnim,
     &gKotakeKoumeLookingOverRightShoulderAnim,
 };
@@ -333,7 +334,7 @@ void EnTr_TurnLookOverShoulder(EnTr* this, PlayState* play) {
             (play->csCtx.npcActions[this->actionIndex]->action == 2)) {
             Animation_Change(&this->skelAnime, sLookOverShoulderAnims[this->actor.params], 1.0f, 0.0f, lastFrame, ANIMMODE_ONCE,  // was D_80B24368 [LLM:HIGH]
                              -4.0f);
-            this->animation = D_80B24370[this->actor.params];
+            this->animation = sLookingOverShoulderAnims[this->actor.params];  // was D_80B24370 [LLM:HIGH]
             EnTr_SetupAction(this, EnTr_TakeOff);
         }
     }
