From 15a11d760077a3ed9a1b790002d6278560732ae5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:38:46 +0000
Subject: [PATCH 1702/3799] soh: rename D_80AFA660 -> sBodyPartPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the sixteen body-part positions copied out of the player each frame and used as the centres of the shadow blobs.
Defined in soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c | 25 ++++++++++---------
 1 file changed, 13 insertions(+), 12 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
index 496447d49..6ed701b64 100644
--- a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
+++ b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
@@ -87,7 +87,8 @@ static u32 D_80AFA390[] = { 0, 0 };
 
 #include "overlays/ovl_En_Sda/ovl_En_Sda.h"
 
-static Vec3f D_80AFA660[16];
+// LLM generated name (HIGH), was D_80AFA660: the sixteen body-part positions copied out of the player each frame and used as the centres of the shadow blobs.
+static Vec3f sBodyPartPos[16];  // was D_80AFA660 [LLM:HIGH]
 
 void EnSda_Init(Actor* thisx, PlayState* play) {
 }
@@ -152,17 +153,17 @@ void func_80AF8F60(Player* player, u8* shadowTexture, f32 arg2) {
     for (i = 0; i < 16; i++) {
         if ((arg2 == 0.0f) || ((j = D_80AFA13C[i]) >= 0)) {
             if (arg2 > 0.0f) {
-                lerp.x = D_80AFA660[i].x + (D_80AFA660[j].x - D_80AFA660[i].x) * arg2;
-                lerp.y = D_80AFA660[i].y + (D_80AFA660[j].y - D_80AFA660[i].y) * arg2;
-                lerp.z = D_80AFA660[i].z + (D_80AFA660[j].z - D_80AFA660[i].z) * arg2;
+                lerp.x = sBodyPartPos[i].x + (sBodyPartPos[j].x - sBodyPartPos[i].x) * arg2;  // was D_80AFA660 [LLM:HIGH]
+                lerp.y = sBodyPartPos[i].y + (sBodyPartPos[j].y - sBodyPartPos[i].y) * arg2;  // was D_80AFA660 [LLM:HIGH]
+                lerp.z = sBodyPartPos[i].z + (sBodyPartPos[j].z - sBodyPartPos[i].z) * arg2;  // was D_80AFA660 [LLM:HIGH]
 
                 sp88.x = lerp.x - player->actor.world.pos.x;
                 sp88.y = lerp.y - player->actor.world.pos.y + BREG(48) + 76.0f + 30.0f - 105.0f + 15.0f;
                 sp88.z = lerp.z - player->actor.world.pos.z;
             } else {
-                sp88.x = D_80AFA660[i].x - player->actor.world.pos.x;
-                sp88.y = D_80AFA660[i].y - player->actor.world.pos.y + BREG(48) + 76.0f + 30.0f - 105.0f + 15.0f;
-                sp88.z = D_80AFA660[i].z - player->actor.world.pos.z;
+                sp88.x = sBodyPartPos[i].x - player->actor.world.pos.x;  // was D_80AFA660 [LLM:HIGH]
+                sp88.y = sBodyPartPos[i].y - player->actor.world.pos.y + BREG(48) + 76.0f + 30.0f - 105.0f + 15.0f;  // was D_80AFA660 [LLM:HIGH]
+                sp88.z = sBodyPartPos[i].z - player->actor.world.pos.z;  // was D_80AFA660 [LLM:HIGH]
             }
             Matrix_MultVec3f(&sp88, &sp7C);
             sp7C.x *= (1.0f + (BREG(49) / 100.0f));
@@ -269,14 +270,14 @@ void func_80AF95C4(EnSda* this, u8* shadowTexture, Player* player, PlayState* pl
     Matrix_RotateX((BREG(50) + 70) / 100.0f, MTXMODE_NEW);
     for (i = 0; i < 18; i++) {
         if (D_80AFA16C[i] >= 0) {
-            D_80AFA660[D_80AFA16C[i]] = player->bodyPartsPos[i];
+            sBodyPartPos[D_80AFA16C[i]] = player->bodyPartsPos[i];  // was D_80AFA660 [LLM:HIGH]
         }
     }
     osSyncPrintf("SDA CONT 2\n");
-    D_80AFA660[0].y += 3.0f;
-    D_80AFA660[15].x = D_80AFA660[0].x + ((D_80AFA660[15].x - D_80AFA660[0].x) * 1.2f);
-    D_80AFA660[15].y = D_80AFA660[0].y + ((D_80AFA660[15].y - D_80AFA660[0].y) * -1.2f);
-    D_80AFA660[15].z = D_80AFA660[0].z + ((D_80AFA660[15].z - D_80AFA660[0].z) * 1.2f);
+    sBodyPartPos[0].y += 3.0f;  // was D_80AFA660 [LLM:HIGH]
+    sBodyPartPos[15].x = sBodyPartPos[0].x + ((sBodyPartPos[15].x - sBodyPartPos[0].x) * 1.2f);  // was D_80AFA660 [LLM:HIGH]
+    sBodyPartPos[15].y = sBodyPartPos[0].y + ((sBodyPartPos[15].y - sBodyPartPos[0].y) * -1.2f);  // was D_80AFA660 [LLM:HIGH]
+    sBodyPartPos[15].z = sBodyPartPos[0].z + ((sBodyPartPos[15].z - sBodyPartPos[0].z) * 1.2f);  // was D_80AFA660 [LLM:HIGH]
     for (i = 0; i < 6; i++) {
         func_80AF8F60(player, shadowTexture, i / 5.0f);
     }
