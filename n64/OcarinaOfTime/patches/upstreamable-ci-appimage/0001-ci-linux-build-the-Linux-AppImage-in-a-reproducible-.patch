diff --git a/docker/Dockerfile b/docker/Dockerfile
new file mode 100644
index 000000000..7cf7d0399
--- /dev/null
+++ b/docker/Dockerfile
@@ -0,0 +1,91 @@
+# Reproducible Linux build environment for Ship of Harkinian's CI AppImage.
+#
+# Mirrors the Linux job of .github/workflows/generate-builds.yml: ubuntu-22.04
+# with gcc-12, the apt list from linux-build-deps/apt.txt, and SDL2 / SDL2_net /
+# tinyxml2 / libzip built from source at the same versions and flags the job
+# uses (its local install-sdl2-net / install-tinyxml2 composite actions). The
+# one deliberate difference from CI is the point of this image: those
+# from-source library steps and the runner image are frozen into layers, so the
+# build is reproducible and a developer can run the identical build locally.
+#
+# Arch-generic: `ubuntu:22.04` is a multi-arch manifest, so this builds natively
+# on both the x86_64 and the aarch64 runner of the CI matrix; the multiarch
+# library copies below use $(uname -m) rather than a hardcoded triplet.
+#
+# Build context is the repository root (see docker/Makefile), so the COPY reads
+# linux-build-deps/apt.txt — the SAME file CI installs from.
+FROM ubuntu:22.04
+
+ENV DEBIAN_FRONTEND=noninteractive \
+    LANG=C.UTF-8
+
+# The CI apt list (linux-build-deps/apt.txt) plus the packages a bare
+# ubuntu:22.04 lacks that a GitHub runner pre-provides: toolchain, download
+# utilities, python3 for the asset extractor, imagemagick (the cmake configure
+# runs `convert` on sohIcon.png and fails without it), and AppImage packaging.
+COPY linux-build-deps/apt.txt /tmp/apt.txt
+RUN apt-get update && apt-get install -y --no-install-recommends \
+        $(cat /tmp/apt.txt) \
+        ca-certificates wget curl gnupg git file patchelf desktop-file-utils \
+        build-essential gcc g++ pkg-config python3 imagemagick \
+ && rm -rf /var/lib/apt/lists/*
+
+# The project requires CMake >= 3.26; jammy ships 3.22 (the GitHub runner
+# pre-provides a newer cmake, so CI never hits this). Install Kitware's build.
+RUN wget -O /tmp/kitware-archive.sh https://apt.kitware.com/kitware-archive.sh \
+ && bash /tmp/kitware-archive.sh \
+ && apt-get install -y --no-install-recommends cmake \
+ && rm -rf /tmp/kitware-archive.sh /var/lib/apt/lists/*
+
+# SDL 2.30.3 from source (CI step "Install latest SDL").
+RUN mkdir -p /deps && cd /deps \
+ && wget -q https://github.com/libsdl-org/SDL/releases/download/release-2.30.3/SDL2-2.30.3.tar.gz \
+ && tar -xzf SDL2-2.30.3.tar.gz \
+ && cd SDL2-2.30.3 \
+ && ./configure --enable-hidapi-libusb \
+ && make -j"$(nproc)" \
+ && make install \
+ && cp -av /usr/local/lib/libSDL* /lib/"$(uname -m)"-linux-gnu/ \
+ && ldconfig \
+ && cd / && rm -rf /deps
+
+# SDL2_net 2.2.0 from source (CI's install-sdl2-net composite action).
+RUN mkdir -p /deps && cd /deps \
+ && curl -fsSL https://www.libsdl.org/projects/SDL_net/release/SDL2_net-2.2.0.tar.gz | tar xz \
+ && cd SDL2_net-2.2.0 \
+ && ./configure \
+ && make -j"$(nproc)" \
+ && make install \
+ && cp -av /usr/local/lib/libSDL* /lib/"$(uname -m)"-linux-gnu/ \
+ && ldconfig \
+ && cd / && rm -rf /deps
+
+# tinyxml2 10.0.0 from source, shadowing the apt one (CI removes it first).
+RUN apt-get update && apt-get remove -y libtinyxml2-dev \
+ && rm -rf /var/lib/apt/lists/* \
+ && mkdir -p /deps && cd /deps \
+ && wget -q https://github.com/leethomason/tinyxml2/archive/refs/tags/10.0.0.tar.gz \
+ && tar -xzf 10.0.0.tar.gz \
+ && cmake -S tinyxml2-10.0.0 -B tinyxml2-10.0.0/build -DCMAKE_BUILD_TYPE=Release \
+ && cmake --build tinyxml2-10.0.0/build -j"$(nproc)" \
+ && cmake --install tinyxml2-10.0.0/build \
+ && ldconfig \
+ && cd / && rm -rf /deps
+
+# libzip 1.10.1 without crypto backends, shadowing the apt one (CI step
+# "Install libzip without crypto" removes libzip-dev first).
+RUN apt-get update && apt-get remove -y libzip-dev \
+ && rm -rf /var/lib/apt/lists/* \
+ && mkdir -p /deps && cd /deps \
+ && wget -q https://github.com/nih-at/libzip/releases/download/v1.10.1/libzip-1.10.1.tar.gz \
+ && tar -xzf libzip-1.10.1.tar.gz \
+ && cmake -S libzip-1.10.1 -B libzip-1.10.1/build -DCMAKE_BUILD_TYPE=Release \
+        -DENABLE_COMMONCRYPTO=OFF -DENABLE_GNUTLS=OFF \
+        -DENABLE_MBEDTLS=OFF -DENABLE_OPENSSL=OFF \
+ && cmake --build libzip-1.10.1/build -j"$(nproc)" \
+ && cmake --install libzip-1.10.1/build \
+ && cp -av /usr/local/lib/libzip* /lib/"$(uname -m)"-linux-gnu/ \
+ && ldconfig \
+ && cd / && rm -rf /deps
+
+WORKDIR /src
diff --git a/docker/Makefile b/docker/Makefile
new file mode 100644
index 000000000..ce3fd5a27
--- /dev/null
+++ b/docker/Makefile
@@ -0,0 +1,86 @@
+SHELL := /bin/bash
+
+# Containerized, reproducible Linux AppImage build for Ship of Harkinian.
+#
+# `make appimage` builds the repository (as checked out) inside the image
+# defined by docker/Dockerfile and emits out/soh.appimage — the same artifact
+# the Linux CI job produces, from one path CI and developers share. The image is
+# arch-generic, so the same target builds on both the x86_64 and the aarch64 CI
+# runner. The build CONTEXT is the repository root (the parent of this dir), so
+# the Dockerfile can read linux-build-deps/apt.txt and the container sees the
+# whole source tree.
+
+# Repo root = parent of this docker/ directory, regardless of the caller's cwd.
+ROOT   := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
+
+# podman on developer machines, docker on CI runners — pick whichever is on PATH.
+CONTAINER_CMD ?= $(shell command -v podman >/dev/null 2>&1 && echo podman || echo docker)
+
+IMAGE  := soh-ci-builder:latest
+OUT    := $(ROOT)/out
+NPROC  := $(shell nproc)
+
+# The port asset archive. The CI `generate-soh-otr` job builds soh.o2r and the
+# Linux job downloads it to build-cmake/soh before calling `make appimage`; the
+# build bundles it into the AppImage. (Generating it inside the container is a
+# planned follow-up; for now this target consumes the supplied archive.)
+O2R    ?= build-cmake/soh/soh.o2r
+
+# Extra flags for container `run` (not `build`): --cgroups=disabled lets the
+# build run inside an unprivileged nested container. Empty on a normal host/CI.
+PODMAN_RUN_FLAGS ?= $(if $(filter 1,$(NESTED_PODMAN)),--cgroups=disabled)
+
+RUN = $(CONTAINER_CMD) run --rm $(PODMAN_RUN_FLAGS) \
+        -v $(ROOT):/src:z -v $(OUT):/out:z -e HOME=/tmp $(IMAGE)
+
+.PHONY: help image build appimage run shell clean
+
+help:
+	@echo "Targets:"
+	@echo "  make image     - build the Linux build-environment image"
+	@echo "  make build     - compile SoH inside the container"
+	@echo "  make appimage  - produce out/soh.appimage (needs a port o2r; see O2R)"
+	@echo "  make run       - run out/soh.appimage"
+	@echo "  make shell     - interactive shell in the build container"
+	@echo "  make clean     - remove the container build dir and out/"
+
+image:
+	$(CONTAINER_CMD) build -t $(IMAGE) -f $(ROOT)/docker/Dockerfile $(ROOT)
+
+$(OUT):
+	mkdir -p $(OUT)
+
+build: image | $(OUT)
+	$(RUN) bash -c '\
+		set -euxo pipefail; \
+		cmake --no-warn-unused-cli -S /src -B /src/build-cmake -GNinja \
+		      -DCMAKE_BUILD_TYPE=Release -DBUILD_REMOTE_CONTROL=1; \
+		cmake --build /src/build-cmake --config Release -j$(NPROC); \
+	'
+
+appimage: build
+	@test -f $(ROOT)/$(O2R) || { \
+	  echo "ERROR: port asset archive '$(O2R)' not found under the repo root." >&2; \
+	  echo "       CI's generate-soh-otr job supplies it; pass O2R=<path> otherwise." >&2; \
+	  exit 1; }
+	$(RUN) bash -c '\
+		set -euxo pipefail; \
+		cd /src/build-cmake && cpack -G External; \
+		shopt -s nullglob; \
+		artifacts=(/src/build-cmake/*.appimage /src/_packages/*.appimage); \
+		if [ $${#artifacts[@]} -eq 0 ]; then echo "ERROR: no .appimage produced" >&2; exit 1; fi; \
+		cp "$${artifacts[0]}" /out/soh.appimage; \
+		chmod +x /out/soh.appimage; \
+	'
+	@echo "==> AppImage: $(OUT)/soh.appimage"
+
+run:
+	@test -x $(OUT)/soh.appimage || { echo "no AppImage at $(OUT)/soh.appimage -- run 'make appimage' first" >&2; exit 1; }
+	$(OUT)/soh.appimage $(ARGS)
+
+shell: image | $(OUT)
+	$(CONTAINER_CMD) run --rm -it $(PODMAN_RUN_FLAGS) \
+	    -v $(ROOT):/src:z -v $(OUT):/out:z -e HOME=/tmp $(IMAGE) bash
+
+clean:
+	rm -rf $(ROOT)/build-cmake $(ROOT)/_packages $(OUT)

