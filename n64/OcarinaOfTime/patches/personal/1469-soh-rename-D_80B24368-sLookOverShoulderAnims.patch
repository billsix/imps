From eaf6e20c3df2968d758edd8717e9e48e97e0e071 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:16 +0000
Subject: [PATCH 1469/3799] soh: rename D_80B24368 -> sLookOverShoulderAnims

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the look-over-shoulder animation for each twin, chosen by params; Kotake looks left and Koume right.
Defined in soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
index 0c0de53c1..a6807cfd7 100644
--- a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
+++ b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
@@ -44,7 +44,8 @@ static AnimationHeader* unused[] = {
     &gKotakeKoumeStandingBroomOverLeftShoulderAnim,
 };
 
-static AnimationHeader* D_80B24368[] = {
+// LLM generated name (HIGH), was D_80B24368: the look-over-shoulder animation for each twin, chosen by params; Kotake looks left and Koume right.
+static AnimationHeader* sLookOverShoulderAnims[] = {  // was D_80B24368 [LLM:HIGH]
     &gKotakeKoumeLookOverLeftShoulderAnim,
     &gKotakeKoumeLookOverRightShoulderAnim,
 };
@@ -325,12 +326,12 @@ void EnTr_TakeOff(EnTr* this, PlayState* play) {
 }
 
 void EnTr_TurnLookOverShoulder(EnTr* this, PlayState* play) {
-    f32 lastFrame = Animation_GetLastFrame(D_80B24368[this->actor.params]);
+    f32 lastFrame = Animation_GetLastFrame(sLookOverShoulderAnims[this->actor.params]);  // was D_80B24368 [LLM:HIGH]
 
     if (play->csCtx.state != CS_STATE_IDLE) {
         if ((play->csCtx.npcActions[this->actionIndex] != NULL) &&
             (play->csCtx.npcActions[this->actionIndex]->action == 2)) {
-            Animation_Change(&this->skelAnime, D_80B24368[this->actor.params], 1.0f, 0.0f, lastFrame, ANIMMODE_ONCE,
+            Animation_Change(&this->skelAnime, sLookOverShoulderAnims[this->actor.params], 1.0f, 0.0f, lastFrame, ANIMMODE_ONCE,  // was D_80B24368 [LLM:HIGH]
                              -4.0f);
             this->animation = D_80B24370[this->actor.params];
             EnTr_SetupAction(this, EnTr_TakeOff);
