From 842b93c95c9ea03439594c14677c0b46bd002d38 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:38 +0000
Subject: [PATCH 3078/3799] soh: rename D_80121314 -> sCs5120KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 5120 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 66c8046c7..906233ef1 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -314,7 +314,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
         case 5120:
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
 
-            csInfo->keyFrames = D_80121314;
+            csInfo->keyFrames = sCs5120KeyFrames;  // was D_80121314 [LLM:HIGH]
             csInfo->keyFrameCnt = 1;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index a761e0e9b..53cf74ba2 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -259,7 +259,8 @@ static OnePointCsFull sCs2290KeyFrames[6] = {  // was D_80121224 [LLM:HIGH]
     { 0x11, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_80121314[1] = {
+// LLM generated name (HIGH), was D_80121314: the keyframe set one-point cutscene 5120 installs
+static OnePointCsFull sCs5120KeyFrames[1] = {  // was D_80121314 [LLM:HIGH]
     { 0x8F, 0x08, 0x4141, 1000, 0, 75.0f, 0.6f, { 0.0f, 0.0f, 10.0f }, { 0.0f, 0.0f, 100.0f } },
 };
 
