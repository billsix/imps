From c16a1882de71e96cb5654f2c8c493403f218c43b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:37 +0000
Subject: [PATCH 3600/3799] soh: rename D_80B5A484 -> sEyeOpenPhase

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: counter stepped 0-to-4 by EnZl3_OpenEyesOnWake: eye texture 2 (shut) for the first two frames, 1 (half) for the next two, then normal blinking. A wake-up ramp, not a timer anything else reads
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 4bc78f80f..96d293c14 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -56,7 +56,8 @@ static Vec3f sLimb13Offset = { 0.0f, 0.0f, 0.0f };  // was D_80B5A46C [LLM:GUESS
 // LLM generated name (GUESS), was D_80B5A478: the {0,10,0} vector Matrix_MultVec3f-ed at limb 14 (the head) in EnZl3_PostLimbDraw to place actor.focus.pos, i.e. the point the camera and Z-target aim at
 static Vec3f sZl3FocusOffset = { 0.0f, 10.0f, 0.0f };  // was D_80B5A478 [LLM:GUESS]
 
-static f32 D_80B5A484 = 0.0f;
+// LLM generated name (GUESS), was D_80B5A484: counter stepped 0-to-4 by EnZl3_OpenEyesOnWake: eye texture 2 (shut) for the first two frames, 1 (half) for the next two, then normal blinking. A wake-up ramp, not a timer anything else reads
+static f32 sEyeOpenPhase = 0.0f;  // was D_80B5A484 [LLM:GUESS]
 
 static Vec3f D_80B5A488 = { 0.0f, 0.0f, 0.0f };
 
@@ -843,7 +844,7 @@ void func_80B550F0(EnZl3* this) {
 }
 
 void func_80B55144(EnZl3* this) {
-    f32* fl = &D_80B5A484;
+    f32* fl = &sEyeOpenPhase;  // was D_80B5A484 [LLM:GUESS]
 
     if (*fl < 2.0f) {
         *fl += 1.0f;
