 // Name from zeldaret/oot (was func_800A057C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_scene_table.c]
 void Scene_DrawConfigGanonsTowerCollapseInterior(PlayState* play) {
-    func_8009BEEC(play);
+    Scene_AddGanonsTowerCollapseQuake(play);  // was func_8009BEEC [LLM:HIGH]
 }
 
