             this->homePlatform = this->curPlatform = EnZf_FindPlatform(&thisx->world.pos, 0);
             EnZf_SetupDropIn(this);
-            D_80B4A1B4 = 1;
+            sPairedInactiveType = 1;
         } else {
             Actor_Kill(thisx);
         }
@@ -1337,7 +1338,7 @@ void EnZf_Stunned(EnZf* this, PlayState* play) {
