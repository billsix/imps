From 13b27144f4f59ee8a29d9268c45f675b382125c7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:51:18 +0000
Subject: [PATCH 1122/3799] soh: rename D_80865B70 -> sStowedHookOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the local-space offset used for the hook's drawn position while the hookshot is not in flight; its extended counterpart sits 900 units forward.
Defined in soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c b/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
index e30c5d571..2351ba6e8 100644
--- a/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
+++ b/soh/src/overlays/actors/ovl_Arms_Hook/z_arms_hook.c
@@ -54,7 +54,8 @@ static Color_RGB8 sUnusedColors[] = {
     { 255, 255, 50 },
 };
 
-static Vec3f D_80865B70 = { 0.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80865B70: the local-space offset used for the hook's drawn position while the hookshot is not in flight; its extended counterpart sits 900 units forward.
+static Vec3f sStowedHookOffset = { 0.0f, 0.0f, 0.0f };  // was D_80865B70 [LLM:HIGH]
 static Vec3f D_80865B7C = { 0.0f, 0.0f, 900.0f };
 static Vec3f D_80865B88 = { 0.0f, 500.0f, -3000.0f };
 static Vec3f D_80865B94 = { 0.0f, -500.0f, -3000.0f };
@@ -316,7 +317,7 @@ void ArmsHook_Draw(Actor* thisx, PlayState* play) {
         OPEN_DISPS(play->state.gfxCtx);
 
         if ((ArmsHook_Shoot != this->actionFunc) || (this->timer <= 0)) {
-            Matrix_MultVec3f(&D_80865B70, &this->unk_1E8);
+            Matrix_MultVec3f(&sStowedHookOffset, &this->unk_1E8);  // was D_80865B70 [LLM:HIGH]
             Matrix_MultVec3f(&D_80865B88, &sp6C);
             Matrix_MultVec3f(&D_80865B94, &sp60);
             this->hookInfo.active = 0;
-- 
