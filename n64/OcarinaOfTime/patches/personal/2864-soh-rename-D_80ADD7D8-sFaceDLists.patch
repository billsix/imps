+++ b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
@@ -199,7 +199,8 @@ static Gfx* sBodyDLists[4] = {  // was D_80ADD7C8 [LLM:HIGH]
     gPoeSistersAmyBodyDL,
 };
 
-static Gfx* D_80ADD7D8[4] = {
+// LLM generated name (HIGH), was D_80ADD7D8: the four sisters' face display lists
+static Gfx* sFaceDLists[4] = {  // was D_80ADD7D8 [LLM:HIGH]
     gPoeSistersMegFaceDL,
     gPoeSistersJoelleFaceDL,
     gPoeSistersBethFaceDL,
@@ -1354,7 +1355,7 @@ s32 EnPoSisters_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Ve
     } else if (limbIndex == 9) {
         *dList = sBodyDLists[this->unk_194];  // was D_80ADD7C8 [LLM:HIGH]
     } else if (limbIndex == 10) {
-        *dList = D_80ADD7D8[this->unk_194];
+        *dList = sFaceDLists[this->unk_194];  // was D_80ADD7D8 [LLM:HIGH]
         gDPPipeSync((*gfxP)++);
         gDPSetEnvColor((*gfxP)++, this->unk_22E.r, this->unk_22E.g, this->unk_22E.b, this->unk_22E.a);
     } else if (limbIndex == 11) {
