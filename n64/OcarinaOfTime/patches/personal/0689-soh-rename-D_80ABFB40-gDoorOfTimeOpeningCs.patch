From d57b8f71f2e7bb670ec445bd2f75fe827304ca8e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:31 +0000
Subject: [PATCH 0689/3799] soh: rename D_80ABFB40 -> gDoorOfTimeOpeningCs

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag.c.
---
 .../overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag.c    | 5 +++--
 .../ovl_En_Okarina_Tag/z_en_okarina_tag_cutscene_data.c      | 2 +-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag.c b/soh/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag.c
index 365765a11..5c6f0d52c 100644
--- a/soh/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag.c
+++ b/soh/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag.c
@@ -38,7 +38,8 @@ const ActorInit En_Okarina_Tag_InitVars = {
 
 // Name from zeldaret/oot (was D_80ABF9D0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag.c]
 extern CutsceneData gWindmillSpinningFasterCs[];
-extern CutsceneData D_80ABFB40[];
+// Name from zeldaret/oot (was D_80ABFB40): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag.c]
+extern CutsceneData gDoorOfTimeOpeningCs[];
 
 void EnOkarinaTag_Destroy(Actor* thisx, PlayState* play) {
 }
@@ -257,7 +258,7 @@ void func_80ABF4C8(EnOkarinaTag* this, PlayState* play) {
                 break;
             case 4: // Door of Time
                 if (GameInteractor_Should(VB_PLAY_DOOR_OF_TIME_CS, true, this)) {
-                    play->csCtx.segment = D_80ABFB40;
+                    play->csCtx.segment = gDoorOfTimeOpeningCs;
                     gSaveContext.cutsceneTrigger = 1;
                 }
                 break;
diff --git a/soh/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag_cutscene_data.c b/soh/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag_cutscene_data.c
index 0d513c5b8..0545a8502 100644
--- a/soh/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag_cutscene_data.c
+++ b/soh/src/overlays/actors/ovl_En_Okarina_Tag/z_en_okarina_tag_cutscene_data.c
@@ -28,7 +28,7 @@ CutsceneData gWindmillSpinningFasterCs[] = {
     CS_END(),
 };
 
-CutsceneData D_80ABFB40[] = {
+CutsceneData gDoorOfTimeOpeningCs[] = {
     CS_BEGIN_CUTSCENE(18, 3000),
     CS_UNK_DATA_LIST(0x00000021, 1),
         CS_UNK_DATA(0x00010000, 0x0BB80000, 0x00000000, 0x00000000, 0xFFFFFFAA, 0xFFFFFFAE, 0x00000000, 0xFFFFFFAA, 0xFFFFFFAE, 0x00000000, 0x00000000, 0x00000000),
