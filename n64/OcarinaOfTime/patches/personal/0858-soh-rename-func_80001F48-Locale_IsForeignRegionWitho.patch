From 2c8701613a5c9eaabd0fbfcef55eba0e14ba1e7e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 20:20:57 +0000
Subject: [PATCH 0858/3799] soh: rename func_80001F48 ->
 Locale_IsForeignRegionWithoutCtrlr3

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns true only when the console region is not REGION_NATIVE and no controller is present in port 3. Unused, so the purpose behind the pairing of region and port 3 is inference; the name states only the test performed.
Defined in soh/src/boot/z_locale.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/boot/z_locale.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 472c15e71..61cd9f284 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -56,7 +56,7 @@ void Yaz0_DecompressImpl(Yaz0Header* hdr, u8* dst);
 void Yaz0_Decompress(uintptr_t romStart, void* dst, size_t size);
 void Locale_Init(void);
 void Locale_ResetRegion(void);
-u32 func_80001F48(void);
+u32 Locale_IsForeignRegionWithoutCtrlr3(void);  // was func_80001F48 [LLM:GUESS]
 u32 func_80001F8C(void);
 u32 Locale_IsRegionNative(void);
 #ifdef __WIIU__
diff --git a/soh/src/boot/z_locale.c b/soh/src/boot/z_locale.c
index 8ee57ba83..a828cf30c 100644
--- a/soh/src/boot/z_locale.c
+++ b/soh/src/boot/z_locale.c
@@ -33,7 +33,8 @@ void Locale_ResetRegion(void) {
     gCurrentRegion = REGION_NULL;
 }
 
-u32 func_80001F48(void) {
+// LLM generated name (GUESS), was func_80001F48: returns true only when the console region is not REGION_NATIVE and no controller is present in port 3. Unused, so the purpose behind the pairing of region and port 3 is inference; the name states only the test performed.
+u32 Locale_IsForeignRegionWithoutCtrlr3(void) {
     if (gCurrentRegion == REGION_NATIVE) {
         return 0;
     }
