@@ -4047,7 +4047,8 @@ s32 SurfaceType_CheckWallFlag0(CollisionContext* colCtx, CollisionPoly* poly, s3
 /**
  * SurfaceType Is Wall Flag (1 << 1) Set
  */
-s32 func_80041E18(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
+// Name from zeldaret/oot (was func_80041E18): adopted upstream's name for this address; body verified to match upstream at 0.95. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_bgcheck.c]
+s32 SurfaceType_CheckWallFlag1(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
     return (SurfaceType_GetWallFlags(colCtx, poly, bgId) & WALL_FLAG_LADDER) ? true : false;
 }
 
