From 48d146f56391e28457ce86f9cf5adc19695605bd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:12:13 +0000
Subject: [PATCH 585/784] soh: rename func_80AEEB24 -> EnRu1_CheckSinkingState

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.87.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 88bf11fa4..c84ac7265 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1800,7 +1800,8 @@ s32 EnRu1_CheckHitBottomUnderwater(EnRu1* this, PlayState* play) {
     return false;
 }
 
-void func_80AEEB24(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEEB24): adopted upstream's name for this address; body verified to match upstream at 0.87. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_CheckSinkingState(EnRu1* this, PlayState* play) {
     if ((EnRu1_CheckHitBottomUnderwater(this, play) == 0) && (this->waterState == 3)) {
         this->action = 30;
         EnRu1_StopMoving(this);
@@ -1845,7 +1846,7 @@ void EnRu1_Sitting_EnteringWater(EnRu1* this, PlayState* play) {
     EnRu1_UpdateWaterState(this);
     EnRu1_UpdateSkelAnime(this);
     EnRu1_UpdateEyes(this);
-    func_80AEEB24(this, play);
+    EnRu1_CheckSinkingState(this, play);
     func_80AED624(this, play);
 }
 
