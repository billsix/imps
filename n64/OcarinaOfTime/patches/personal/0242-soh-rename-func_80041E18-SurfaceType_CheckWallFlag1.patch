                                                  &sInteractWallCheckResult) &&
                         (wallYawDiff = this->actor.wallYaw - Math_Atan2S(poly->normal.z, poly->normal.x),
                          ABS(wallYawDiff) < 0x4000) &&
-                        !func_80041E18(&play->colCtx, poly, bgId)) {
+                        !SurfaceType_CheckWallFlag1(&play->colCtx, poly, bgId)) {
