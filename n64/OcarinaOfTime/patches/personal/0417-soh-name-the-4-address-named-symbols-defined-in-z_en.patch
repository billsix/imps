+    Matrix_MultVec3f(&sSwordQuadOffset2, &this->hitCollider.dim.quad[3]);  // was D_809B008C [LLM:HIGH]
+    Matrix_MultVec3f(&sSwordQuadOffset3, &this->hitCollider.dim.quad[2]);  // was D_809B0098 [LLM:HIGH]
 
     Collider_SetQuadVertices(&this->hitCollider, &this->hitCollider.dim.quad[0], &this->hitCollider.dim.quad[1],
