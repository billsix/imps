 };
 
-f32 func_808A1800(f32* pValue, f32 target, f32 scale, f32 maxStep, f32 minStep) {
+// LLM generated name (HIGH), was func_808A1800: steps *pValue toward target by a fraction of the remaining distance, clamped between minStep and maxStep and never overshooting; returns the step actually taken.
+f32 BgMoriElevator_StepToward(f32* pValue, f32 target, f32 scale, f32 maxStep, f32 minStep) {
     f32 var = (target - *pValue) * scale;
 
     if (*pValue < target) {
