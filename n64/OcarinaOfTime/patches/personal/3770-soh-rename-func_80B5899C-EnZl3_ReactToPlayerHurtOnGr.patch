@@ -2379,7 +2379,8 @@ s32 EnZl3_ReturnToIdleAtPathTarget(EnZl3* this, PlayState* play) {
     return 0;
 }
 
-s32 func_80B5899C(EnZl3* this, PlayState* play) {
+// LLM generated name (GUESS), was func_80B5899C: while grounded, an invincible or hard-falling player swaps in the reaction animation at action 35
+s32 EnZl3_ReactToPlayerHurtOnGround(EnZl3* this, PlayState* play) {
     if ((this->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) {
         Player* player = GET_PLAYER(play);
         s8 invincibilityTimer = player->invincibilityTimer;
@@ -2396,7 +2397,7 @@ s32 func_80B5899C(EnZl3* this, PlayState* play) {
 
 void func_80B58A1C(EnZl3* this, PlayState* play) {
     if (!EnZl3_ReturnToIdleAtPathTarget(this, play)) {  // was func_80B58938 [LLM:GUESS]
-        func_80B5899C(this, play);
+        EnZl3_ReactToPlayerHurtOnGround(this, play);  // was func_80B5899C [LLM:GUESS]
     }
 }
 
