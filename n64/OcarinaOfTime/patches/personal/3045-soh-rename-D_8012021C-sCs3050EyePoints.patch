From 0607acaa50dfb321455260ac61f492ccf0847ff8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:35 +0000
Subject: [PATCH 3045/3799] soh: rename D_8012021C -> sCs3050EyePoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the eye points of that same call
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 18 +++++++++---------
 soh/src/code/z_onepointdemo_data.inc |  3 ++-
 2 files changed, 11 insertions(+), 10 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 5ce9f2198..42160a74f 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -13,7 +13,7 @@ static s32 sPrevFrameCs1100 = -4096;
 #define ONE_POINT_CUTSCENE_SHIP_SAVESTATE_FIELDS(F) \
     F(sPrevFrameCs1100)                             \
     F(sCs3050AtPoints)                                   \
-    F(D_8012021C)                                   \
+    F(sCs3050EyePoints)                                   \
     F(D_801204D4)                                   \
     F(D_801205B4)                                   \
     F(D_801208EC)                                   \
@@ -496,22 +496,22 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
         case 3050:
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Player_SetCsActionWithHaltedActors(play, &player->actor, 5);
-            OnePointCutscene_SetCsCamPoints(csCam, D_80120304 | 0x2000, D_80120300, sCs3050AtPoints, D_8012021C);  // was D_8012013C [LLM:HIGH]
+            OnePointCutscene_SetCsCamPoints(csCam, D_80120304 | 0x2000, D_80120300, sCs3050AtPoints, sCs3050EyePoints);  // was D_8012013C [LLM:HIGH]
             Sfx_PlaySfxCentered(NA_SE_SY_CORRECT_CHIME);
             OnePointCutscene_Vec3sToVec3f(&mainCam->at, &sCs3050AtPoints[D_801202FC - 2].pos);  // was D_8012013C [LLM:HIGH]
-            OnePointCutscene_Vec3sToVec3f(&mainCam->eye, &D_8012021C[D_801202FC - 2].pos);
+            OnePointCutscene_Vec3sToVec3f(&mainCam->eye, &sCs3050EyePoints[D_801202FC - 2].pos);  // was D_8012021C [LLM:HIGH]
             sCs3050AtPoints[D_801202FC - 3].pos.x +=  // was D_8012013C [LLM:HIGH]
                 (sCs3050AtPoints[D_801202FC - 2].pos.x - sCs3050AtPoints[D_801202FC - 3].pos.x) / 2;  // was D_8012013C [LLM:HIGH]
             sCs3050AtPoints[D_801202FC - 3].pos.y +=  // was D_8012013C [LLM:HIGH]
                 (sCs3050AtPoints[D_801202FC - 2].pos.y - sCs3050AtPoints[D_801202FC - 3].pos.y) / 2;  // was D_8012013C [LLM:HIGH]
             sCs3050AtPoints[D_801202FC - 3].pos.z +=  // was D_8012013C [LLM:HIGH]
                 (sCs3050AtPoints[D_801202FC - 2].pos.z - sCs3050AtPoints[D_801202FC - 3].pos.z) / 2;  // was D_8012013C [LLM:HIGH]
-            D_8012021C[D_801202FC - 3].pos.x +=
-                (D_8012021C[D_801202FC - 2].pos.x - D_8012021C[D_801202FC - 3].pos.x) / 2;
-            D_8012021C[D_801202FC - 3].pos.y +=
-                (D_8012021C[D_801202FC - 2].pos.y - D_8012021C[D_801202FC - 3].pos.y) / 2;
-            D_8012021C[D_801202FC - 3].pos.z +=
-                (D_8012021C[D_801202FC - 2].pos.z - D_8012021C[D_801202FC - 3].pos.z) / 2;
+            sCs3050EyePoints[D_801202FC - 3].pos.x +=  // was D_8012021C [LLM:HIGH]
+                (sCs3050EyePoints[D_801202FC - 2].pos.x - sCs3050EyePoints[D_801202FC - 3].pos.x) / 2;  // was D_8012021C [LLM:HIGH]
+            sCs3050EyePoints[D_801202FC - 3].pos.y +=  // was D_8012021C [LLM:HIGH]
+                (sCs3050EyePoints[D_801202FC - 2].pos.y - sCs3050EyePoints[D_801202FC - 3].pos.y) / 2;  // was D_8012021C [LLM:HIGH]
+            sCs3050EyePoints[D_801202FC - 3].pos.z +=  // was D_8012021C [LLM:HIGH]
+                (sCs3050EyePoints[D_801202FC - 2].pos.z - sCs3050EyePoints[D_801202FC - 3].pos.z) / 2;  // was D_8012021C [LLM:HIGH]
 
             i = Quake_Add(mainCam, 3);
             Quake_SetSpeed(i, 30000);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 2a29a427c..6c4ba627c 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -17,7 +17,8 @@ static CutsceneCameraPoint sCs3050AtPoints[14] = {  // was D_8012013C [LLM:HIGH]
     { CS_CMD_STOP, 0, 50, 60.0f, { -1974, 12, -1179 } },
     { CS_CMD_STOP, 0, 30, 60.0f, { -1974, 12, -1179 } },
 };
-static CutsceneCameraPoint D_8012021C[14] = {
+// LLM generated name (HIGH), was D_8012021C: the eye points of that same call
+static CutsceneCameraPoint sCs3050EyePoints[14] = {  // was D_8012021C [LLM:HIGH]
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { -1751, 604, -1233 } }, { CS_CMD_CONTINUE, 0, 0, 60.0f, { -1752, 516, -1233 } },
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { -1751, 417, -1233 } }, { CS_CMD_CONTINUE, 0, 0, 60.0f, { -1767, 306, -1219 } },
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { -1776, 257, -1205 } }, { CS_CMD_CONTINUE, 0, 0, 60.0f, { -1881, 147, -1149 } },
-- 
