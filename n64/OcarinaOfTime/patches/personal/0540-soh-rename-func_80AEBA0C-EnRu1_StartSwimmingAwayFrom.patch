Date: Mon, 7 Sep 2026 15:12:06 +0000
Subject: [PATCH 540/784] soh: rename func_80AEBA0C ->
 EnRu1_StartSwimmingAwayFromLink

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 96fb0e881..7bc58de30 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -560,7 +560,8 @@ void func_80AEB974(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEBA0C(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEBA0C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_StartSwimmingAwayFromLink(EnRu1* this, PlayState* play) {
     EnRu1_StartMovingInWater(this, play);
 }
 
@@ -697,7 +698,7 @@ void func_80AEBF60(EnRu1* this, PlayState* play) {
         this->action = 5;
         this->treadStartPos = this->actor.world.pos;
     } else {
-        func_80AEBA0C(this, play);
+        EnRu1_StartSwimmingAwayFromLink(this, play);
     }
 }
 
