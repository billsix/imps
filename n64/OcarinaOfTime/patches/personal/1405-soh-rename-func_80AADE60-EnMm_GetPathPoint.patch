From 033d6897144461a99629ce7d01600895fd7e3127 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:17:02 +0000
Subject: [PATCH 1405/3799] soh: rename func_80AADE60 -> EnMm_GetPathPoint

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: copies the requested waypoint of the requested path into a Vec3f.
Defined in soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c b/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
index ae195d37f..d6ad3ded1 100644
--- a/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
+++ b/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
@@ -317,7 +317,8 @@ s32 EnMm_GetPointCount(Path* pathList, s32 pathNum) {
     return (pathList + pathNum)->count;
 }
 
-s32 func_80AADE60(Path* pathList, Vec3f* pos, s32 pathNum, s32 waypoint) {
+// LLM generated name (HIGH), was func_80AADE60: copies the requested waypoint of the requested path into a Vec3f.
+s32 EnMm_GetPathPoint(Path* pathList, Vec3f* pos, s32 pathNum, s32 waypoint) {
     Vec3s* pointPos;
     pointPos = &((Vec3s*)SEGMENTED_TO_VIRTUAL((pathList + pathNum)->points))[waypoint];
 
@@ -335,7 +336,7 @@ s32 func_80AADEF0(EnMm* this, PlayState* play) {
     s32 phi_a2;
     s32 phi_v1;
 
-    func_80AADE60(play->setupPathList, &waypointPos, this->path, this->waypoint);
+    EnMm_GetPathPoint(play->setupPathList, &waypointPos, this->path, this->waypoint);  // was func_80AADE60 [LLM:HIGH]
 
     xDiff = waypointPos.x - this->actor.world.pos.x;
     zDiff = waypointPos.z - this->actor.world.pos.z;
@@ -380,7 +381,7 @@ s32 func_80AADEF0(EnMm* this, PlayState* play) {
             this->waypoint = sPathInfo[this->unk_1E8].unk_08;
         }
 
-        func_80AADE60(play->setupPathList, &waypointPos, this->path, this->waypoint);
+        EnMm_GetPathPoint(play->setupPathList, &waypointPos, this->path, this->waypoint);  // was func_80AADE60 [LLM:HIGH]
 
         xDiff = waypointPos.x - this->actor.world.pos.x;
         zDiff = waypointPos.z - this->actor.world.pos.z;
-- 
