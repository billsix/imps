From c7d88778e7051e442f4750a837a1560c693b861a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:37:35 +0000
Subject: [PATCH 1696/3799] soh: rename func_800458D4 -> Camera_CalcAtForNormal

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: computes the at point for the normal camera settings, offsetting it by the player's height, adjusting for the floor slope and easing it toward the player as they climb or fall. Named for the family of Camera_CalcAt* helpers around it; the file does not name it.
Defined in soh/src/code/z_camera.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 5729e4170..14abd9e68 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -940,7 +940,8 @@ s32 Camera_CalcAtDefault(Camera* camera, VecSph* eyeAtDir, f32 extraYOffset, s16
     return true;
 }
 
-s32 func_800458D4(Camera* camera, VecSph* eyeAtDir, f32 arg2, f32* arg3, s16 arg4) {
+// LLM generated name (GUESS), was func_800458D4: computes the at point for the normal camera settings, offsetting it by the player's height, adjusting for the floor slope and easing it toward the player as they climb or fall. Named for the family of Camera_CalcAt* helpers around it; the file does not name it.
+s32 Camera_CalcAtForNormal(Camera* camera, VecSph* eyeAtDir, f32 arg2, f32* arg3, s16 arg4) {
     f32 phi_f2;
     Vec3f posOffsetTarget;
     Vec3f atTarget;
@@ -1704,7 +1705,7 @@ s32 Camera_Normal1(Camera* camera) {
                : norm1->yOffset;
 
     if (norm1->interfaceFlags & 0x80) {
-        func_800458D4(camera, &atEyeNextGeo, spA0, &anim->yOffset, norm1->interfaceFlags & 1);
+        Camera_CalcAtForNormal(camera, &atEyeNextGeo, spA0, &anim->yOffset, norm1->interfaceFlags & 1);  // was func_800458D4 [LLM:GUESS]
     } else if (norm1->interfaceFlags & 0x20) {
         func_80045B08(camera, &atEyeNextGeo, spA0, anim->slopePitchAdj);
     } else {
@@ -1913,7 +1914,7 @@ s32 Camera_Normal2(Camera* camera) {
     if (!(norm2->interfaceFlags & 0x80)) {
         Camera_CalcAtDefault(camera, &atToEyeNextDir, norm2->unk_00, norm2->interfaceFlags & 1);
     } else {
-        func_800458D4(camera, &atToEyeNextDir, norm2->unk_00, &anim->unk_24, norm2->interfaceFlags & 1);
+        Camera_CalcAtForNormal(camera, &atToEyeNextDir, norm2->unk_00, &anim->unk_24, norm2->interfaceFlags & 1);  // was func_800458D4 [LLM:GUESS]
     }
 
     if (norm2->interfaceFlags & 4) {
@@ -2254,7 +2255,7 @@ s32 Camera_Parallel1(Camera* camera) {
     if (!(para1->interfaceFlags & 0x80) && !sp6A) {
         Camera_CalcAtForParallel(camera, &atToEyeNextDir, para1->yOffset, &anim->yTarget, para1->interfaceFlags & 1);
     } else {
-        func_800458D4(camera, &atToEyeNextDir, para1->unk_18, &anim->yTarget, para1->interfaceFlags & 1);
+        Camera_CalcAtForNormal(camera, &atToEyeNextDir, para1->unk_18, &anim->yTarget, para1->interfaceFlags & 1);  // was func_800458D4 [LLM:GUESS]
     }
 
     if (anim->animTimer != 0) {
@@ -2425,7 +2426,7 @@ s32 Camera_Jump1(Camera* camera) {
     camera->yOffsetUpdateRate = Camera_LERPCeilF(PCT(OREG(3)), camera->yOffsetUpdateRate, PCT(OREG(26)), 0.1f);
     camera->fovUpdateRate = Camera_LERPCeilF(PCT(OREG(4)), camera->yOffsetUpdateRate, 0.05f, 0.1f);
 
-    func_800458D4(camera, &eyeNextAtOffset, jump1->atYOffset, &anim->unk_1C, 0);
+    Camera_CalcAtForNormal(camera, &eyeNextAtOffset, jump1->atYOffset, &anim->unk_1C, 0);  // was func_800458D4 [LLM:GUESS]
 
     eyeDiffSph = eyeAtOffset;
 
