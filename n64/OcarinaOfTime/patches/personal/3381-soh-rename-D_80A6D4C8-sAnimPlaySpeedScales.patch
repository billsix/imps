From c67c977962b2e19b1f69fa97926bb63719366b79 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:03 +0000
Subject: [PATCH 3381/3799] soh: rename D_80A6D4C8 -> sAnimPlaySpeedScales

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-animation multiplier EnHorseNormal_GetAnimPlaySpeed scales the horse speed by
Defined in soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_En_Horse_Normal/z_en_horse_normal.c     | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c b/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c
index a07bc3b29..47e6bc890 100644
--- a/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c
+++ b/soh/src/overlays/actors/ovl_En_Horse_Normal/z_en_horse_normal.c
@@ -172,17 +172,17 @@ void EnHorseNormal_PlayWalkSfx(EnHorseNormal* this) {
 
 // LLM generated name (HIGH), was func_80A6B30C: returns the playback rate for the current animation, scaling the three moving gaits by the horse's own speed.
 f32 EnHorseNormal_GetAnimPlaySpeed(EnHorseNormal* this) {
-    static f32 D_80A6D4C8[] = { 1.0f, 1.0f, 1.0f, 1.0f, 1.5f, 1.5f, 1.5f, 1.5f, 1.0f };
+    static f32 sAnimPlaySpeedScales[] = { 1.0f, 1.0f, 1.0f, 1.0f, 1.5f, 1.5f, 1.5f, 1.5f, 1.0f };  // was D_80A6D4C8 [LLM:HIGH]
     f32 result;
 
     if (this->animationIdx == 4) {
-        result = D_80A6D4C8[this->animationIdx] * this->actor.speedXZ * (1 / 2.0f);
+        result = sAnimPlaySpeedScales[this->animationIdx] * this->actor.speedXZ * (1 / 2.0f);  // was D_80A6D4C8 [LLM:HIGH]
     } else if (this->animationIdx == 5) {
-        result = D_80A6D4C8[this->animationIdx] * this->actor.speedXZ * (1 / 3.0f);
+        result = sAnimPlaySpeedScales[this->animationIdx] * this->actor.speedXZ * (1 / 3.0f);  // was D_80A6D4C8 [LLM:HIGH]
     } else if (this->animationIdx == 6) {
-        result = D_80A6D4C8[this->animationIdx] * this->actor.speedXZ * (1 / 5.0f);
+        result = sAnimPlaySpeedScales[this->animationIdx] * this->actor.speedXZ * (1 / 5.0f);  // was D_80A6D4C8 [LLM:HIGH]
     } else {
-        result = D_80A6D4C8[this->animationIdx];
+        result = sAnimPlaySpeedScales[this->animationIdx];  // was D_80A6D4C8 [LLM:HIGH]
     }
 
     return result;
-- 
