From 395d01fdf72527453b3146153d5cdba2d12ab987 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:14 +0000
Subject: [PATCH 3467/3799] soh: rename D_808124AC -> sEraseConfirmOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same for the erase confirmation window
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../gamestates/ovl_file_choose/z_file_copy_erase.c        | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c
index 9e977afec..4f436b69c 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c
@@ -775,7 +775,7 @@ void FileChoose_EraseSelect(GameState* thisx) {
  * Update function for `CM_SETUP_ERASE_CONFIRM_1`
  */
 void FileChoose_SetupEraseConfirm1(GameState* thisx) {
-    static s16 D_808124AC[] = { 0, 16, 32 };
+    static s16 sEraseConfirmOffsets[] = { 0, 16, 32 };  // was D_808124AC [LLM:HIGH]
     FileChooseContext* this = (FileChooseContext*)thisx;
     s16 i;
     s16 yStep;
@@ -795,9 +795,9 @@ void FileChoose_SetupEraseConfirm1(GameState* thisx) {
     this->titleAlpha[0] -= 15;
     this->titleAlpha[1] += 15;
 
-    yStep = ABS(this->buttonYOffsets[this->buttonIndex] - D_808124AC[this->buttonIndex]) / this->actionTimer;
+    yStep = ABS(this->buttonYOffsets[this->buttonIndex] - sEraseConfirmOffsets[this->buttonIndex]) / this->actionTimer;  // was D_808124AC [LLM:HIGH]
 
-    if (this->buttonYOffsets[this->buttonIndex] >= D_808124AC[this->buttonIndex]) {
+    if (this->buttonYOffsets[this->buttonIndex] >= sEraseConfirmOffsets[this->buttonIndex]) {  // was D_808124AC [LLM:HIGH]
         this->buttonYOffsets[this->buttonIndex] -= yStep;
     } else {
         this->buttonYOffsets[this->buttonIndex] += yStep;
@@ -819,7 +819,7 @@ void FileChoose_SetupEraseConfirm1(GameState* thisx) {
             }
         }
 
-        this->buttonYOffsets[this->buttonIndex] = D_808124AC[this->buttonIndex];
+        this->buttonYOffsets[this->buttonIndex] = sEraseConfirmOffsets[this->buttonIndex];  // was D_808124AC [LLM:HIGH]
         this->actionTimer = 8;
         this->configMode++;
     }
