Subject: [PATCH 1314/3799] soh: rename func_80888694 ->
 BgHidanHamstep_ClampToNeighbours

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: keeps a step's height between its parent's and its children's, so the staircase can never invert or stretch more than 100 units per step.
Defined in soh/src/overlays/actors/ovl_Bg_Hidan_Hamstep/z_bg_hidan_hamstep.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Hidan_Hamstep/z_bg_hidan_hamstep.c       | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Hamstep/z_bg_hidan_hamstep.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Hamstep/z_bg_hidan_hamstep.c
index 24e01bbb9..993b9ac1e 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Hamstep/z_bg_hidan_hamstep.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Hamstep/z_bg_hidan_hamstep.c
@@ -241,7 +241,8 @@ void BgHidanHamstep_SpawnDustForChildren(BgHidanHamstep* this, PlayState* play)
     }
 }
 
-void func_80888694(BgHidanHamstep* this, BgHidanHamstep* parent) {
+// LLM generated name (HIGH), was func_80888694: keeps a step's height between its parent's and its children's, so the staircase can never invert or stretch more than 100 units per step.
+void BgHidanHamstep_ClampToNeighbours(BgHidanHamstep* this, BgHidanHamstep* parent) {
     BgHidanHamstep* child;
 
     if ((this->dyna.actor.params & 0xFF) >= 2) {
@@ -275,7 +276,7 @@ void func_80888734(BgHidanHamstep* this) {
             this->dyna.actor.world.pos.y += (this->dyna.actor.velocity.y * frameDivisor);
         }
 
-        func_80888694(this, parent);
+        BgHidanHamstep_ClampToNeighbours(this, parent);  // was func_80888694 [LLM:HIGH]
     }
 }
 
@@ -345,7 +346,7 @@ void func_80888A58(BgHidanHamstep* this, PlayState* play) {
     s32 quakeIndex;
 
     Actor_MoveXZGravity(&this->dyna.actor);
-    func_80888694(this, (BgHidanHamstep*)this->dyna.actor.parent);
+    BgHidanHamstep_ClampToNeighbours(this, (BgHidanHamstep*)this->dyna.actor.parent);  // was func_80888694 [LLM:HIGH]
 
     if (((this->dyna.actor.params & 0xFF) <= 0) || ((this->dyna.actor.params & 0xFF) >= 6)) {
         // "[Hammer Step] arg_data strange (arg_data = %d)"
