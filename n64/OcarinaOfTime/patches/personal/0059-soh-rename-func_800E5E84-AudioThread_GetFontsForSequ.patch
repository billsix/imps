From 3d00b2966dfc6ab096c330f05693c210a6b68641 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:16 +0000
Subject: [PATCH 059/784] soh: rename func_800E5E84 ->
 AudioThread_GetFontsForSequence

Name source: zeldaret/oot.
Defined in soh/src/code/audio_thread.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h      | 2 +-
 soh/src/code/audio_general.c | 4 ++--
 soh/src/code/audio_thread.c  | 3 ++-
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index bd3fd66cb..a082edb43 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1995,7 +1995,7 @@ void Audio_QueueCmdS8(u32 arg0, s8 arg1);
 void Audio_QueueCmdU16(u32 arg0, u16 arg1);
 s32 Audio_ScheduleProcessCmds(void);
 u32 AudioThread_GetExternalLoadQueueMsg(u32* arg0);  // was func_800E5E20 [LLM:HIGH]
-u8* func_800E5E84(s32 arg0, u32* arg1);
+u8* AudioThread_GetFontsForSequence(s32 arg0, u32* arg1);  // was func_800E5E84 [oot]
 s32 func_800E5EDC(void);
 s32 func_800E5F88(s32 arg0);
 void Audio_PreNMIInternal(void);
diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 925f2adf9..4ec708d26 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -5030,8 +5030,8 @@ void Audio_PlayFanfare(u16 seqId) {
     // Sometimes the game will add 0x900 to a requested fanfare ID
     // The `& 0xFF` here is to strip off this 0x900 and get the original fanfare ID
     // when getting the sound font data for the sequence
-    curFontId = func_800E5E84(curSeqId & 0xFF, &outNumFonts);
-    requestedFontId = func_800E5E84(seqId & 0xFF, &outNumFonts);
+    curFontId = AudioThread_GetFontsForSequence(curSeqId & 0xFF, &outNumFonts);
+    requestedFontId = AudioThread_GetFontsForSequence(seqId & 0xFF, &outNumFonts);
 
     if (!curFontId || !requestedFontId) {
         // disable BGM, we're about to null deref!
diff --git a/soh/src/code/audio_thread.c b/soh/src/code/audio_thread.c
index 29d75e3c2..c84b40280 100644
--- a/soh/src/code/audio_thread.c
+++ b/soh/src/code/audio_thread.c
@@ -533,7 +533,8 @@ u32 AudioThread_GetExternalLoadQueueMsg(u32* out) {
     return sp1C >> 0x18;
 }
 
-u8* func_800E5E84(s32 arg0, u32* arg1) {
+// Name from zeldaret/oot, was func_800E5E84: forwards to AudioLoad_GetFontsForSequence [oot: https://github.com/zeldaret/oot/blob/main/src/audio/internal/thread.c]
+u8* AudioThread_GetFontsForSequence(s32 arg0, u32* arg1) {
     return AudioLoad_GetFontsForSequence(arg0, arg1);
 }
 
-- 
2.55.0

