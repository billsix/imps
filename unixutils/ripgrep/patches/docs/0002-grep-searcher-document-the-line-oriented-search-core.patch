From abb1d93df899c2748632afb08ca641058a661fdf Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Sun, 20 Sep 2026 03:24:50 +0000
Subject: [PATCH 2/3] grep-searcher: document the line-oriented search core

core.rs holds Core, the state machine shared by every non-multi-line
search strategy, but had no module or item documentation. Add:

* a module overview explaining Core's role and the fast-vs-slow
  line-search distinction (find_candidate_line prefilter vs testing
  every line);
* doc comments on the Core struct and each of its fields, which track
  search position, absolute offsets, lazy line numbering and the context
  windows;
* doc comments on the non-trivial methods (roll, match_by_line and its
  fast/slow variants, find_by_line_fast, the context emitters, binary
  detection, lazy line counting, and is_line_by_line_fast).

Comment-only: no code changes.
---
 crates/searcher/src/searcher/core.rs | 157 +++++++++++++++++++++++++++
 1 file changed, 157 insertions(+)

diff --git a/crates/searcher/src/searcher/core.rs b/crates/searcher/src/searcher/core.rs
index 7d7e5cd..ec6d188 100644
--- a/crates/searcher/src/searcher/core.rs
+++ b/crates/searcher/src/searcher/core.rs
@@ -1,3 +1,33 @@
+/*!
+The line-oriented search core shared by every non-multi-line search strategy.
+
+The three strategies in `glue.rs` (`ReadByLine`, `SliceByLine` and `MultiLine`)
+differ only in *where the bytes come from* and *how matches are found*; the
+bookkeeping that turns raw matches into the events a [`Sink`] expects — line
+numbering, before/after/passthru context windows, context-break separators,
+binary detection and absolute byte offsets — is identical, and lives here in
+[`Core`]. A strategy owns a `Core`, feeds it one buffer at a time, and lets it
+drive the sink.
+
+# Fast vs. slow line search
+
+For a non-inverted, non-passthru search, `Core` can run in one of two modes,
+chosen once by [`Core::is_line_by_line_fast`]:
+
+* The **slow** path ([`Core::match_by_line_slow`]) walks every line in the
+  buffer and asks the matcher whether that line matches. It is always correct.
+* The **fast** path ([`Core::match_by_line_fast`]) instead calls
+  [`Matcher::find_candidate_line`], which may use a highly optimized substring
+  prefilter (e.g. `memmem`) to *skip whole runs of non-matching lines* and only
+  land on lines that could match. It is usable only when the matcher's notion
+  of a line terminator is compatible with the searcher's (see
+  `is_line_by_line_fast` for the exact conditions); otherwise `Core` falls back
+  to the slow path.
+
+The fast path is what makes ripgrep fast on the common case of a literal or
+literal-prefixed pattern over large files.
+*/
+
 use bstr::ByteSlice;
 
 use grep_matcher::{LineMatchKind, Matcher};
@@ -11,27 +41,61 @@ use crate::{
     },
 };
 
+/// The outcome of one run of the fast line matcher over a buffer.
 enum FastMatchResult {
+    /// The fast matcher exhausted the buffer; keep going with the next buffer.
     Continue,
+    /// The sink asked to stop (or a quit condition was hit); end the search.
     Stop,
+    /// The fast path can no longer be used for the rest of this buffer (e.g.
+    /// `stop_on_nonmatch` fired after a match), so finish it on the slow path.
     SwitchToSlow,
 }
 
+/// The mutable state and bookkeeping of a single line-oriented search.
+///
+/// A `Core` is created once per file/stream searched (by one of the strategies
+/// in `glue.rs`) and is then fed buffers to search. It owns the matcher and the
+/// sink, and tracks everything needed to translate byte ranges into the
+/// context-aware, line-numbered events a [`Sink`] consumes.
 #[derive(Debug)]
 pub(crate) struct Core<'s, M: 's, S> {
+    /// The searcher's configuration (line terminator, context sizes, invert,
+    /// passthru, binary detection, ...). Borrowed from the owning `Searcher`.
     config: &'s Config,
+    /// The matcher used to find matches within a line (or candidate line).
     matcher: M,
+    /// The searcher this core belongs to, passed back to the sink on each event.
     searcher: &'s Searcher,
+    /// Where search results and context lines are reported.
     sink: S,
+    /// Whether binary detection is active for this search.
     binary: bool,
+    /// The current search offset into the buffer being searched. Everything
+    /// before `pos` has already been searched (in the current buffer).
     pos: usize,
+    /// The number of bytes that preceded the current buffer, i.e. the bytes
+    /// already rolled off the front. Added to in-buffer offsets to recover the
+    /// absolute offset into the whole stream (see `roll`).
     absolute_byte_offset: u64,
+    /// If binary data was detected, the *absolute* offset at which it was seen.
     binary_byte_offset: Option<usize>,
+    /// The current line number, tracked only when line numbering is enabled.
     line_number: Option<u64>,
+    /// High-water mark for lazy line counting: the buffer offset up to which
+    /// `line_number` has already counted terminators (avoids recounting).
     last_line_counted: usize,
+    /// The end offset of the last line handed to the sink. Used to detect gaps
+    /// between reported lines (for context-break separators) and as the start
+    /// of the next context window.
     last_line_visited: usize,
+    /// How many "after context" lines still remain to be emitted following the
+    /// most recent match.
     after_context_left: usize,
+    /// Whether anything at all has been sent to the sink yet. A context break
+    /// is only meaningful once something has been reported.
     has_sunk: bool,
+    /// Whether any match has occurred so far (drives `stop_on_nonmatch`).
     has_matched: bool,
 }
 
