Date: Tue, 8 Sep 2026 02:01:52 +0000
Subject: [PATCH 3738/3799] soh: rename func_80B575F0 ->
 EnZl3_IsAtStalfosWaypoint

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: true for switch flag 0x26 in the tower interior at waypoint 1 -- the one spot where the Stalfos ambush is staged
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 814cd215a..2392a46ac 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -1912,7 +1912,8 @@ s32 EnZl3_IsPlayerWithin50(EnZl3* this, PlayState* play) {
     return EnZl3_IsPlayerWithin(this, play, 50.0f);  // was func_80B573FC [LLM:HIGH]
 }
 
-s32 func_80B575F0(EnZl3* this, PlayState* play) {
+// LLM generated name (GUESS), was func_80B575F0: true for switch flag 0x26 in the tower interior at waypoint 1 -- the one spot where the Stalfos ambush is staged
+s32 EnZl3_IsAtStalfosWaypoint(EnZl3* this, PlayState* play) {
     s16 sceneNum = play->sceneNum;
 
     if ((sceneNum == SCENE_GANONS_TOWER_COLLAPSE_INTERIOR) && (EnZl3_GetSwitchFlagIndex(this) == 0x26)) {  // was func_80B54DB4 [LLM:HIGH]
@@ -1938,7 +1939,7 @@ void func_80B5764C(EnZl3* this, PlayState* play) {
 }
 
 s32 func_80B576C8(EnZl3* this, PlayState* play) {
-    if (func_80B575F0(this, play) && (this->unk_3D8 == 0)) {
+    if (EnZl3_IsAtStalfosWaypoint(this, play) && (this->unk_3D8 == 0)) {  // was func_80B575F0 [LLM:GUESS]
         return 1;
     }
     return 0;
