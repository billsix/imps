From 633f8a5f6817f096ea8791286c9bc483063c34ec Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:10:29 +0000
Subject: [PATCH 3264/3799] soh: rename D_808E4DD0 -> sLimb10Offset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the offset limb 10 records its transformed position from
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index 1bfe71f76..de38787b0 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -3331,7 +3331,7 @@ void BossGanon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
     static Vec3f sRightHandBaseOffset = { -500.0f, 200.0f, 300.0f };  // was D_808E4DAC [LLM:HIGH]
     static Vec3f sLimbOrigin = { 0.0f, 0.0f, 0.0f };  // was D_808E4DB8 [LLM:HIGH]
     static Vec3f sLimb6Offset = { 0.0f, 0.0f, 0.0f };  // was D_808E4DC4 [LLM:HIGH]
-    static Vec3f D_808E4DD0 = { 0.0f, 0.0f, 0.0f };
+    static Vec3f sLimb10Offset = { 0.0f, 0.0f, 0.0f };  // was D_808E4DD0 [LLM:HIGH]
     static Vec3f D_808E4DDC = { 1300.0f, 0.0f, 0.0f };
     static Vec3f D_808E4DE8 = { 600.0f, 420.0f, 100.0f };
     s8 bodyPart;
@@ -3357,7 +3357,7 @@ void BossGanon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
     } else if (limbIndex == 6) {
         Matrix_MultVec3f(&sLimb6Offset, &this->unk_238);  // was D_808E4DC4 [LLM:HIGH]
     } else if (limbIndex == 10) {
-        Matrix_MultVec3f(&D_808E4DD0, &this->unk_22C);
+        Matrix_MultVec3f(&sLimb10Offset, &this->unk_22C);  // was D_808E4DD0 [LLM:HIGH]
 
         if (this->unk_25C == 0) {
             Matrix_MultVec3f(&D_808E4DDC, &this->unk_260);
