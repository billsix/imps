@@ -499,7 +500,7 @@ void func_80082850(PlayState* play, s16 maxAlpha) {
 
             break;
         case 5:
-            func_8008277C(play, maxAlpha, alpha);
+            Interface_ClampButtonAlphas(play, maxAlpha, alpha);  // was func_8008277C [LLM:HIGH]
 
             if ((interfaceCtx->minimapAlpha != 0) && (interfaceCtx->minimapAlpha > maxAlpha)) {
                 interfaceCtx->minimapAlpha = maxAlpha;
@@ -519,7 +520,7 @@ void func_80082850(PlayState* play, s16 maxAlpha) {
 
             break;
         case 6:
-            func_8008277C(play, maxAlpha, alpha);
+            Interface_ClampButtonAlphas(play, maxAlpha, alpha);  // was func_8008277C [LLM:HIGH]
 
             if (interfaceCtx->aAlpha != 255) {
