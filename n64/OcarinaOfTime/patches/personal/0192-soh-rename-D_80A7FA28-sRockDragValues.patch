From 42801b889fe7d8b54a1e0d9e7789504c21e29071 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:32 +0000
Subject: [PATCH 192/225] soh: rename D_80A7FA28 -> sRockDragValues

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c b/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c
index 282714a0a..bcafbdd85 100644
--- a/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c
+++ b/soh/src/overlays/actors/ovl_En_Ishi/z_en_ishi.c
@@ -57,7 +57,8 @@ const ActorInit En_Ishi_InitVars = {
 static f32 sRockScales[] = { 0.1f, 0.4f };
 // LLM generated name (HIGH), was D_80A7FA20: per-type rock Y offsets applied to actor.shape.yOffset.
 static f32 sRockYOffsets[] = { 58.0f, 80.0f };
-static f32 D_80A7FA28[] = { 0.0f, 0.005f };
+// LLM generated name (HIGH), was D_80A7FA28: per-type drag factors passed to func_80A7ED94.
+static f32 sRockDragValues[] = { 0.0f, 0.005f };
 
 // the sizes of these arrays are very large and take up way more space than it needs to.
 // coincidentally the sizes are the same as the ID for NA_SE_EV_ROCK_BROKEN, which may explain a mistake that could
@@ -412,7 +413,7 @@ void EnIshi_LiftedUp(EnIshi* this, PlayState* play) {
         }
         EnIshi_SetupFly(this);
         EnIshi_Fall(this);
-        func_80A7ED94(&this->actor.velocity, D_80A7FA28[this->actor.params & 1]);
+        func_80A7ED94(&this->actor.velocity, sRockDragValues[this->actor.params & 1]);
         Actor_UpdatePos(&this->actor);
         Actor_UpdateBgCheckInfo(play, &this->actor, 7.5f, 35.0f, 0.0f, 0xC5);
     }
@@ -479,7 +480,7 @@ void EnIshi_Fly(EnIshi* this, PlayState* play) {
     }
     Math_StepToF(&this->actor.shape.yOffset, 0.0f, 2.0f);
     EnIshi_Fall(this);
-    func_80A7ED94(&this->actor.velocity, D_80A7FA28[type]);
+    func_80A7ED94(&this->actor.velocity, sRockDragValues[type]);
     Actor_UpdatePos(&this->actor);
     this->actor.shape.rot.x += sRotSpeedX;
     this->actor.shape.rot.y += sRotSpeedY;
-- 
2.55.0

