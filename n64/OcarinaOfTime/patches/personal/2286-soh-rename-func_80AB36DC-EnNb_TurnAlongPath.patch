     }
 }
 
-void func_80AB36DC(EnNb* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AB36DC: turns onto the path yaw at the start of that window and back onto the home yaw at its end
+void EnNb_TurnAlongPath(EnNb* this, PlayState* play) {
     u16 moveTime = this->movementTimer;
 
     if ((((u16)((u16)(kREG(17) + 25) - 4))) > moveTime) {
@@ -1373,7 +1374,7 @@ void EnNb_FollowPath(EnNb* this, PlayState* play) {
