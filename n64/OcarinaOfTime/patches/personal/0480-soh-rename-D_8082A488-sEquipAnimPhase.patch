From faf9153b098776c7ee9c344f442a8a8e1208cdf3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:41 +0000
Subject: [PATCH 480/488] soh: rename D_8082A488 -> sEquipAnimPhase

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: an s16 KaleidoScope_UpdateItemEquip keeps across frames; named Phase because sEquipAnimTimer is already taken in the same file
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_item.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_item.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_item.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_item.c
index 2209a1e77..38beb933c 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_item.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_item.c
@@ -862,7 +862,7 @@ static s16 sCButtonPosX[] = { 66, 90, 114, 110, 110, 86, 134 };
 static s16 sCButtonPosY[] = { 110, 92, 110, 76, 44, 62, 62 };
 
 void KaleidoScope_UpdateItemEquip(PlayState* play) {
-    static s16 D_8082A488 = 0;
+    static s16 sEquipAnimPhase = 0;  // was D_8082A488 [LLM:GUESS]
     PauseContext* pauseCtx = &play->pauseCtx;
     Vtx* bowItemVtx;
     u16 offsetX;
@@ -1085,9 +1085,9 @@ void KaleidoScope_UpdateItemEquip(PlayState* play) {
     }
 
     if (sEquipState == 2) {
-        D_8082A488--;
+        sEquipAnimPhase--;  // was D_8082A488 [LLM:GUESS]
 
-        if (D_8082A488 == 0) {
+        if (sEquipAnimPhase == 0) {  // was D_8082A488 [LLM:GUESS]
             pauseCtx->equipTargetItem -= 0xBF - ITEM_BOW_ARROW_FIRE;
             if (!CVarGetInteger(CVAR_ENHANCEMENT("SeparateArrows"), 0)) {
                 pauseCtx->equipTargetSlot = SLOT_BOW;
@@ -1155,7 +1155,7 @@ void KaleidoScope_UpdateItemEquip(PlayState* play) {
         if (sEquipMoveTimer == 0) {
             if (sEquipState == 1) {
                 sEquipState++;
-                D_8082A488 = 4;
+                sEquipAnimPhase = 4;  // was D_8082A488 [LLM:GUESS]
                 return;
             }
 
