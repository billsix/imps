Date: Mon, 7 Sep 2026 22:50:07 +0000
Subject: [PATCH 1886/3799] soh: rename func_80B8FE3C -> ObjBean_SproutDelay

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: waits out that pause.
Defined in soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
index 060aec489..64905431e 100644
--- a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
+++ b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
@@ -36,7 +36,8 @@ void ObjBean_SetupShakeLeaves(ObjBean* this);
 void ObjBean_ShakeLeaves(ObjBean* this);
 void ObjBean_SetupWaitForBean(ObjBean* this);
 void ObjBean_WaitForBean(ObjBean* this, PlayState* play);
-void func_80B8FE3C(ObjBean* this, PlayState* play);
+// LLM generated name (HIGH), was func_80B8FE3C: waits out that pause.
+void ObjBean_SproutDelay(ObjBean* this, PlayState* play);  // was func_80B8FE3C [LLM:HIGH]
 // LLM generated name (HIGH), was func_80B8FE00: shows the leaves and arms the 60-frame pause before the plant sprouts.
 void ObjBean_SetupSproutDelay(ObjBean* this);  // was func_80B8FE00 [LLM:HIGH]
 void func_80B8FE6C(ObjBean* this);
@@ -554,7 +555,7 @@ void ObjBean_WaitForBean(ObjBean* this, PlayState* play) {
 }
 
 void ObjBean_SetupSproutDelay(ObjBean* this) {
-    this->actionFunc = func_80B8FE3C;
+    this->actionFunc = ObjBean_SproutDelay;  // was func_80B8FE3C [LLM:HIGH]
     ObjBean_SetDrawMode(this, BEAN_STATE_DRAW_LEAVES);
     if (GameInteractor_Should(VB_PLAY_BEAN_PLANTING_CS, true)) {
         this->timer = 60;
@@ -562,7 +563,7 @@ void ObjBean_SetupSproutDelay(ObjBean* this) {
 }
 
 // Link is looking at the soft soil
-void func_80B8FE3C(ObjBean* this, PlayState* play) {
+void ObjBean_SproutDelay(ObjBean* this, PlayState* play) {
     if (this->timer <= 0) {
         func_80B8FE6C(this);
     }
