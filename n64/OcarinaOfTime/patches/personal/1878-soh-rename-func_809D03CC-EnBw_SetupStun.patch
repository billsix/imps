From 0fdada4e9cf79b389910f5e1cccd954988481521 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:49:15 +0000
Subject: [PATCH 1878/3799] soh: rename func_809D03CC -> EnBw_SetupStun

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: stops the slug, arms the ice timer for an ice hit, plays the freeze sfx and installs the stunned action.
Defined in soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c b/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c
index c460f07af..95eb7d9fd 100644
--- a/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c
+++ b/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c
@@ -48,7 +48,8 @@ void EnBw_Die(EnBw* this, PlayState* play);  // was func_809D014C [LLM:HIGH]
 void EnBw_SetupFreeze(EnBw* this);  // was func_809D01CC [LLM:HIGH]
 // LLM generated name (HIGH), was func_809D0268: shifts the slug's colour toward blue while it is frozen and shivers it on a random cycle.
 void EnBw_Frozen(EnBw* this, PlayState* play);  // was func_809D0268 [LLM:HIGH]
-void func_809D03CC(EnBw* this);
+// LLM generated name (HIGH), was func_809D03CC: stops the slug, arms the ice timer for an ice hit, plays the freeze sfx and installs the stunned action.
+void EnBw_SetupStun(EnBw* this);  // was func_809D03CC [LLM:HIGH]
 void func_809D0424(EnBw* this, PlayState* play);
 
 const ActorInit En_Bw_InitVars = {
@@ -657,7 +658,7 @@ void EnBw_Frozen(EnBw* this, PlayState* play) {
     }
 }
 
-void func_809D03CC(EnBw* this) {
+void EnBw_SetupStun(EnBw* this) {
     this->actor.speedXZ = 0.0f;
     if (this->damageEffect == 0xE) {
         this->iceTimer = 32;
@@ -716,7 +717,7 @@ void func_809D0584(EnBw* this, PlayState* play) {
                 if (this->unk_23C == 0) {
                     Actor_ApplyDamage(&this->actor);
                     Actor_SetColorFilter(&this->actor, 0, 0x78, 0, 0x50);
-                    func_809D03CC(this);
+                    EnBw_SetupStun(this);  // was func_809D03CC [LLM:HIGH]
                     this->unk_248 = 0.0f;
                 }
                 return;
