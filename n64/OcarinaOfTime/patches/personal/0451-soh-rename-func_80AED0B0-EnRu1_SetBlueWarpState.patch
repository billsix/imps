From e8f1784ac86f8fa7d1066d01529655c515a63605 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:46 +0000
Subject: [PATCH 451/784] soh: rename func_80AED0B0 -> EnRu1_SetBlueWarpState

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 71eebd5e4..5e9dde431 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1123,7 +1123,8 @@ s32 EnRu1_CheckBlueWarpState(EnRu1* this, s32 state) {
     return false;
 }
 
-void func_80AED0B0(EnRu1* this, s32 state) {
+// Name from zeldaret/oot (was func_80AED0B0): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_SetBlueWarpState(EnRu1* this, s32 state) {
     if (this->blueWarp != NULL) {
         this->blueWarp->rutoWarpState = state;
     }
@@ -1145,7 +1146,7 @@ void func_80AED110(EnRu1* this) {
     if (this->actor.shape.yOffset >= 0.0f) {
         this->action = 18;
         this->actor.shape.yOffset = 0.0f;
-        func_80AED0B0(this, WARP_BLUE_RUTO_STATE_READY);
+        EnRu1_SetBlueWarpState(this, WARP_BLUE_RUTO_STATE_READY);
     }
 }
 
@@ -1163,7 +1164,7 @@ void func_80AED19C(EnRu1* this, s32 cond) {
                          Animation_GetLastFrame(&gRutoChildTransitionHandsOnHipToCrossArmsAndLegsAnim), ANIMMODE_ONCE,
                          -8.0f);
         this->action = 20;
-        func_80AED0B0(this, WARP_BLUE_RUTO_STATE_3);
+        EnRu1_SetBlueWarpState(this, WARP_BLUE_RUTO_STATE_3);
     }
 }
 
