From 35ee884285059a109a8f6c16d866be785f378992 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:30:03 +0000
Subject: [PATCH 1601/3799] soh: rename func_80A4F700 -> EnGs_CountdownToDeath

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: counts its timer down and kills the actor at zero.
Defined in soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c b/soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c
index 81e9852c6..8be73eada 100644
--- a/soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c
+++ b/soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c
@@ -18,7 +18,8 @@ void EnGs_Update(Actor* thisx, PlayState* play);
 void EnGs_Draw(Actor* thisx, PlayState* play);
 
 void func_80A4F734(EnGs* this, PlayState* play);
-void func_80A4F700(EnGs* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A4F700: counts its timer down and kills the actor at zero.
+void EnGs_CountdownToDeath(EnGs* this, PlayState* play);  // was func_80A4F700 [LLM:HIGH]
 
 void func_80A4F77C(EnGs* this);
 
@@ -383,7 +384,7 @@ void EnGs_Explode(EnGs* this, PlayState* play) {
             EffectSsBomb2_SpawnLayered(play, &bomb2Pos, &bomb2Velocity, &bomb2Accel, 100, 20);
             this->unk_200 = 10;
             this->unk_19E |= 8;
-            this->actionFunc = func_80A4F700;
+            this->actionFunc = EnGs_CountdownToDeath;  // was func_80A4F700 [LLM:HIGH]
         } else {
             Actor_PlaySfx_Flagged(&this->actor, NA_SE_EV_STONE_LAUNCH - SFX_FLAG);
         }
@@ -498,7 +499,7 @@ void EnGs_SpinAndRise(EnGs* this, PlayState* play) {
     }
 }
 
-void func_80A4F700(EnGs* this, PlayState* play) {
+void EnGs_CountdownToDeath(EnGs* this, PlayState* play) {
     if (this->unk_200-- <= 0) {
         Actor_Kill(&this->actor);
     }
