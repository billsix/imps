Subject: [PATCH 2975/3799] soh: rename func_80985860 -> DemoIm_SetupHiddenIdle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loops the idle animation with no shadow at action 7
Defined in soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
index 713663d6f..429fcf186 100644
--- a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -458,7 +458,8 @@ void DemoIm_Action6(DemoIm* this, PlayState* play) {
     DemoIm_UpdateEyes(this);  // was func_80984BE0 [LLM:HIGH]
 }
 
-void func_80985860(DemoIm* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80985860: loops the idle animation with no shadow at action 7
+void DemoIm_SetupHiddenIdle(DemoIm* this, PlayState* play) {
     DemoIm_ChangeAnim(this, &gImpaIdleAnim, ANIMMODE_LOOP, 0.0f, false);
     this->action = 7;
     this->actor.shape.shadowAlpha = 0;
@@ -1154,7 +1155,7 @@ void DemoIm_Init(Actor* thisx, PlayState* play) {
 
     switch (this->actor.params) {
         case 2:
-            func_80985860(this, play);
+            DemoIm_SetupHiddenIdle(this, play);  // was func_80985860 [LLM:HIGH]
             break;
         case 3:
             func_80985E60(this, play);
