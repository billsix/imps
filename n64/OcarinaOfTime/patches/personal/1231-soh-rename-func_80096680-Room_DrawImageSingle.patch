Subject: [PATCH 1231/3799] soh: rename func_80096680 -> Room_DrawImageSingle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment above it reads "Room Draw Polygon Type 1 - Single Format".
Defined in soh/src/code/z_room.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_room.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_room.c b/soh/src/code/z_room.c
index ee5370a4c..80a238c40 100644
--- a/soh/src/code/z_room.c
+++ b/soh/src/code/z_room.c
@@ -350,7 +350,8 @@ void Room_DrawBackground2D(Gfx** gfxP, void* tex, void* tlut, u16 width, u16 hei
 }
 
 // Room Draw Polygon Type 1 - Single Format
-void func_80096680(PlayState* play, Room* room, u32 flags) {
+// LLM generated name (HIGH), was func_80096680: the in-tree comment above it reads "Room Draw Polygon Type 1 - Single Format".
+void Room_DrawImageSingle(PlayState* play, Room* room, u32 flags) {
     Camera* camera;
     Gfx* spA8;
     PolygonType1* polygon1;
@@ -509,7 +510,7 @@ void Room_DrawImage(PlayState* play, Room* room, u32 flags) {
     PolygonType1* polygon1 = &room->meshHeader->polygon1;
 
     if (polygon1->format == 1) {
-        func_80096680(play, room, flags);
+        Room_DrawImageSingle(play, room, flags);  // was func_80096680 [LLM:HIGH]
     } else if (polygon1->format == 2) {
         func_80096B6C(play, room, flags);
     } else {
