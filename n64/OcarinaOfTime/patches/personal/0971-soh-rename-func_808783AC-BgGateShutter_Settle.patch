 const ActorInit Bg_Gate_Shutter_InitVars = {
@@ -90,12 +91,12 @@ void BgGateShutter_Open(BgGateShutter* this, PlayState* play) {
         if (thisx->world.pos.x < -89.0f) {
             Audio_PlayActorSound2(thisx, NA_SE_EV_BRIDGE_OPEN_STOP);
             this->unk_178 = 0x1E;
-            this->actionFunc = func_808783AC;
+            this->actionFunc = BgGateShutter_Settle;  // was func_808783AC [LLM:HIGH]
         }
     }
 }
 
-void func_808783AC(BgGateShutter* this, PlayState* play) {
+void BgGateShutter_Settle(BgGateShutter* this, PlayState* play) {
     if (this->unk_178 == 0) {
         this->openingState = 0;
         this->actionFunc = BgGateShutter_WaitToMove;  // was func_8087828C [LLM:HIGH]
@@ -113,7 +114,7 @@ void func_808783D4(BgGateShutter* this, PlayState* play) {
             thisx->world.pos.x = 91.0f;
             Audio_PlayActorSound2(thisx, NA_SE_EV_BRIDGE_OPEN_STOP);
             this->unk_178 = 30;
-            this->actionFunc = func_808783AC;
+            this->actionFunc = BgGateShutter_Settle;  // was func_808783AC [LLM:HIGH]
         }
     }
 }
