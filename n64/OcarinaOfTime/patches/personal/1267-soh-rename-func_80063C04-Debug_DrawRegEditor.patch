From 9bac526c395c45d4823b60a4ea546ac04b3fb22d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:06:42 +0000
Subject: [PATCH 1267/3799] soh: rename func_80063C04 -> Debug_DrawRegEditor

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: prints the current page of the register editor, one line per register, highlighting the selected one.
Defined in soh/src/code/z_debug.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_debug.c  | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 5fbe7c022..e5bb2fdc0 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -855,7 +855,7 @@ void DebugCamera_ScreenText(s32 arg0, s32 arg1, const char* text);  // was func_
 void DebugCamera_CopyText(u8 x, u8 y, u8 colorId, const char* text);  // was func_8006376C [LLM:HIGH]
 // ? DebugCamera_DrawText(?);, was func_80063828 [LLM:HIGH]
 void Debug_EditRegs(Input* input);  // was func_8006390C [LLM:HIGH]
-// ? func_80063C04(?);
+// ? Debug_DrawRegEditor(?);, was func_80063C04 [LLM:HIGH]
 void func_80063D7C(GraphicsContext* gfxCtx);
 void DebugDisplay_Init(void);
 DebugDispObject* DebugDisplay_AddObject(f32 posX, f32 posY, f32 posZ, s16 rotX, s16 rotY, s16 rotZ, f32 scaleX,
diff --git a/soh/src/code/z_debug.c b/soh/src/code/z_debug.c
index 7b8a45071..d47109396 100644
--- a/soh/src/code/z_debug.c
+++ b/soh/src/code/z_debug.c
@@ -214,7 +214,8 @@ void Debug_EditRegs(Input* input) {
 }
 
 // Draw Memory Viewer
-void func_80063C04(GfxPrint* printer) {
+// LLM generated name (HIGH), was func_80063C04: prints the current page of the register editor, one line per register, highlighting the selected one.
+void Debug_DrawRegEditor(GfxPrint* printer) {
     s32 i;
     s32 page = (gGameInfo->regPage * REG_PER_PAGE) - REG_PER_PAGE;
     s32 regGroup = (gGameInfo->regGroup * REG_PAGES + gGameInfo->regPage) * REG_PER_PAGE - REG_PER_PAGE;
@@ -265,7 +266,7 @@ void func_80063D7C(GraphicsContext* gfxCtx) {
     }
 
     if (gGameInfo->regPage != 0) {
-        func_80063C04(&printer);
+        Debug_DrawRegEditor(&printer);  // was func_80063C04 [LLM:HIGH]
     }
 
     D_8011E0B0 = 0;
