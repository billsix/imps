From 6e5e287c71308ad434d1ebfbec4f02bb6e57f674 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:46:32 +0000
Subject: [PATCH 1074/3799] soh: rename D_80812604 -> sNameEntryBoxYPositions

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the matching eleven Y positions for the same nameEntryVtx quads.
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/gamestates/ovl_file_choose/file_choose.h    | 2 +-
 .../overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c | 2 +-
 .../overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c | 5 +++--
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h b/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h
index 95bdf690d..de6244602 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h
+++ b/soh/src/overlays/gamestates/ovl_file_choose/file_choose.h
@@ -254,7 +254,7 @@ extern s16 gKeyboardCharactersAlphanumeric[];
 extern s16 D_808127DC_ne0[];
 
 extern s16 sNameEntryBoxXPositions[];  // was D_808125EC [LLM:HIGH]
-extern s16 D_80812604[];
+extern s16 sNameEntryBoxYPositions[];  // was D_80812604 [LLM:HIGH]
 
 // Port Data:
 extern s16 sLastCharIndex;
diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c
index e58a5ca16..19376b3a6 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_NES.c
@@ -189,7 +189,7 @@ void FileChoose_SetNameEntryVtxNES(GameState* thisx) {
         this->nameEntryVtx[var_t2 + 1].v.ob[0] = this->nameEntryVtx[var_t2 + 3].v.ob[0] =
             this->nameEntryVtx[var_t2].v.ob[0] + 0xA;
 
-        this->nameEntryVtx[var_t2].v.ob[1] = this->nameEntryVtx[var_t2 + 1].v.ob[1] = D_80812604[var_s0];
+        this->nameEntryVtx[var_t2].v.ob[1] = this->nameEntryVtx[var_t2 + 1].v.ob[1] = sNameEntryBoxYPositions[var_s0];  // was D_80812604 [LLM:HIGH]
 
         this->nameEntryVtx[var_t2 + 2].v.ob[1] = this->nameEntryVtx[var_t2 + 3].v.ob[1] =
             this->nameEntryVtx[var_t2].v.ob[1] - 0xA;
diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
index 201710dd9..e6de5a185 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_nameset_PAL.c
@@ -106,7 +106,8 @@ s16 sNameEntryBoxXPositions[] = {  // was D_808125EC [LLM:HIGH]
     0xFFE2, 0xFFF0, 0xFFFA, 0x0004, 0x000E, 0x0018, 0x0022, 0x002C, 0x0036, 0xFFF0, 0xFFF0,
 };
 
-s16 D_80812604[] = {
+// LLM generated name (HIGH), was D_80812604: the matching eleven Y positions for the same nameEntryVtx quads.
+s16 sNameEntryBoxYPositions[] = {  // was D_80812604 [LLM:HIGH]
     0x0048, 0x0045, 0x0045, 0x0045, 0x0045, 0x0045, 0x0045, 0x0045, 0x0045, 0x0045, 0x0045,
 };
 
@@ -170,7 +171,7 @@ void FileChoose_SetNameEntryVtx(GameState* thisx) {
                 this->nameEntryVtx[phi_t1].v.ob[0] + 0xA;
         }
 
-        this->nameEntryVtx[phi_t1].v.ob[1] = this->nameEntryVtx[phi_t1 + 1].v.ob[1] = D_80812604[phi_s0];
+        this->nameEntryVtx[phi_t1].v.ob[1] = this->nameEntryVtx[phi_t1 + 1].v.ob[1] = sNameEntryBoxYPositions[phi_s0];  // was D_80812604 [LLM:HIGH]
 
         this->nameEntryVtx[phi_t1 + 2].v.ob[1] = this->nameEntryVtx[phi_t1 + 3].v.ob[1] =
             this->nameEntryVtx[phi_t1].v.ob[1] - 0xA;
