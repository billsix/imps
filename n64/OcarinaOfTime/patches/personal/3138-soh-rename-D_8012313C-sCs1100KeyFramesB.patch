From b6321ebb61ec4d557430d87ecf540913a01ae92c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:44 +0000
Subject: [PATCH 3138/3799] soh: rename D_8012313C -> sCs1100KeyFramesB

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the second, whose roll it mirrors
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 12 ++++++------
 soh/src/code/z_onepointdemo_data.inc |  3 ++-
 2 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index d95f6bc5d..73f5f9bc9 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -39,7 +39,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs3260KeyFrames)                                   \
     F(sCs3261KeyFrames)                                   \
     F(sCs8700KeyFrames)                                   \
-    F(D_8012313C)                                   \
+    F(sCs1100KeyFramesB)                                   \
     F(D_801231B4)                                   \
     F(D_80123254)                                   \
     F(sCs1000KeyFrames)                                   \
@@ -988,12 +988,12 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
                 csInfo->keyFrameCnt = 5;
             } else {
                 if (play->state.frames & 1) {
-                    D_8012313C[0].rollTargetInit = -D_8012313C[0].rollTargetInit;
-                    D_8012313C[0].atTargetInit.y = -D_8012313C[0].atTargetInit.y;
-                    D_8012313C[0].eyeTargetInit.y = -D_8012313C[0].eyeTargetInit.y;
-                    D_8012313C[1].atTargetInit.y = -D_8012313C[1].atTargetInit.y;
+                    sCs1100KeyFramesB[0].rollTargetInit = -sCs1100KeyFramesB[0].rollTargetInit;  // was D_8012313C [LLM:HIGH]
+                    sCs1100KeyFramesB[0].atTargetInit.y = -sCs1100KeyFramesB[0].atTargetInit.y;  // was D_8012313C [LLM:HIGH]
+                    sCs1100KeyFramesB[0].eyeTargetInit.y = -sCs1100KeyFramesB[0].eyeTargetInit.y;  // was D_8012313C [LLM:HIGH]
+                    sCs1100KeyFramesB[1].atTargetInit.y = -sCs1100KeyFramesB[1].atTargetInit.y;  // was D_8012313C [LLM:HIGH]
                 }
-                csInfo->keyFrames = D_8012313C;
+                csInfo->keyFrames = sCs1100KeyFramesB;  // was D_8012313C [LLM:HIGH]
                 csInfo->keyFrameCnt = 3;
             }
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index ee4985c41..ed4d7125d 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -644,7 +644,8 @@ static OnePointCsFull sCs1100KeyFramesA[5] = {  // was D_80123074 [LLM:HIGH]
     { 0x92, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_8012313C[3] = {
+// LLM generated name (HIGH), was D_8012313C: the second, whose roll it mirrors
+static OnePointCsFull sCs1100KeyFramesB[3] = {  // was D_8012313C [LLM:HIGH]
     { 0x8F, 0xFF, 0xA2A2, 20, 8, 70.0f, 1.0f, { 65.0f, -150.0f, 50.0f }, { 30.0f, 10.0f, 90.0f } },
     { 0x81, 0xFF, 0xA2A2, 100, 0, 60.0f, 1.0f, { 70.0f, -160.0f, 50.0f }, { 25.0f, 180.0f, 180.0f } },
     { 0x92, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
