Subject: [PATCH 1772/3799] soh: rename func_800B4370 -> DbCamera_LookAtPoint

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: points the debug camera at one recorded spline point, choosing the position or look-at half according to the editor's toggle.
Defined in soh/src/code/db_camera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h  | 2 +-
 soh/src/code/db_camera.c | 7 ++++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index f5fda757a..18b6eb923 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1493,7 +1493,7 @@ void ShrinkWindow_Update(s32 updateRate);
 // ? DbCamera_EndCut(?);, was func_800B4088 [LLM:HIGH]
 // ? DbCamera_LoadPoint(?);, was func_800B41DC [LLM:HIGH]
 // ? DbCamera_StorePoint(?);, was func_800B42C0 [LLM:HIGH]
-// ? func_800B4370(?);
+// ? DbCamera_LookAtPoint(?);, was func_800B4370 [LLM:HIGH]
 // ? func_800B44E0(?);
 // ? DbCamera_PrintPoints(?);
 // ? DbCamera_PrintF32Bytes(?);
diff --git a/soh/src/code/db_camera.c b/soh/src/code/db_camera.c
index 501eaeec3..8ed04daec 100644
--- a/soh/src/code/db_camera.c
+++ b/soh/src/code/db_camera.c
@@ -252,7 +252,8 @@ s32 DbCamera_StorePoint(DbCamera* dbCamera, Camera* cameraPtr) {
     return dbCamera->sub.unkIdx;
 }
 
-s32 func_800B4370(DbCamera* dbCamera, s16 idx, Camera* cam) {
+// LLM generated name (HIGH), was func_800B4370: points the debug camera at one recorded spline point, choosing the position or look-at half according to the editor's toggle.
+s32 DbCamera_LookAtPoint(DbCamera* dbCamera, s16 idx, Camera* cam) {
     CutsceneCameraPoint* lookAt = &dbCamera->sub.lookAt[idx];
     CutsceneCameraPoint* position = &dbCamera->sub.position[idx];
     VecSph sph;
@@ -969,7 +970,7 @@ void DbCamera_Update(DbCamera* dbCamera, Camera* cam) {
                         dbCamera->sub.unkIdx = dbCamera->sub.nPoints - 1;
                     }
                     if ((dbCamera->sub.unk_08 == 2) && (dbCamera->sub.unkIdx != (dbCamera->sub.nPoints - 1))) {
-                        func_800B4370(dbCamera, dbCamera->sub.unkIdx, cam);
+                        DbCamera_LookAtPoint(dbCamera, dbCamera->sub.unkIdx, cam);  // was func_800B4370 [LLM:HIGH]
                         dbCamera->roll = 0;
                         dbCamera->fov = 60.0f;
                         dbCamera->rollDegrees = 0;
@@ -1001,7 +1002,7 @@ void DbCamera_Update(DbCamera* dbCamera, Camera* cam) {
                     }
 
                     if ((dbCamera->sub.unk_08 == 2) && (dbCamera->sub.unkIdx != (dbCamera->sub.nPoints - 1))) {
-                        func_800B4370(dbCamera, dbCamera->sub.unkIdx, cam);
+                        DbCamera_LookAtPoint(dbCamera, dbCamera->sub.unkIdx, cam);  // was func_800B4370 [LLM:HIGH]
                         dbCamera->roll = 0;
                         dbCamera->fov = 60.0f;
                         dbCamera->rollDegrees = 0;
