 void func_800F6BDC(void) {
diff --git a/soh/src/code/audio_thread.c b/soh/src/code/audio_thread.c
index 088b34f71..4fac342a2 100644
--- a/soh/src/code/audio_thread.c
+++ b/soh/src/code/audio_thread.c
@@ -829,7 +829,8 @@ s32 AudioThread_GetLayerSamplesRemaining(s32 playerIdx, s32 arg1, s32 arg2) {
     return 0;
 }
 
-s32 func_800E6680(void) {
+// LLM generated name (HIGH), was func_800E6680: returns CountAndReleaseNotes(0), i.e. count active notes only
+s32 AudioThread_GetActiveNoteCount(void) {
     return func_800E66C0(0);
 }
 
