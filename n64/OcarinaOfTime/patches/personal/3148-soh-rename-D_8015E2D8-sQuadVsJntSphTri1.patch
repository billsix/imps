+        Math3D_TriNorm(&sQuadVsJntSphTri1, &at->dim.quad[2], &at->dim.quad[1], &at->dim.quad[0]);  // was D_8015E2D8 [LLM:HIGH]
         for (acElem = ac->elements; acElem < ac->elements + ac->count; acElem++) {
             if (CollisionCheck_SkipBump(&acElem->info) == 1) {
                 continue;
@@ -2074,7 +2074,7 @@ void CollisionCheck_AC_QuadVsJntSph(PlayState* play, CollisionCheckContext* colC
