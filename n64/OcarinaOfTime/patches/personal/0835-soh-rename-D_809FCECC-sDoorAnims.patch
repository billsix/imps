From 0063d71ea2968b4f2009b06f419de8678e8e9fcc Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:46 +0000
Subject: [PATCH 0835/3799] soh: rename D_809FCECC -> sDoorAnims

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Door/z_en_door.c.
---
 soh/src/overlays/actors/ovl_En_Door/z_en_door.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Door/z_en_door.c b/soh/src/overlays/actors/ovl_En_Door/z_en_door.c
index b4881ff10..c68f48e47 100644
--- a/soh/src/overlays/actors/ovl_En_Door/z_en_door.c
+++ b/soh/src/overlays/actors/ovl_En_Door/z_en_door.c
@@ -65,7 +65,8 @@ static InitChainEntry sInitChain[] = {
     ICHAIN_F32(uncullZoneForward, 4000, ICHAIN_STOP),
 };
 
-static AnimationHeader* D_809FCECC[] = { &gDoorAdultOpeningLeftAnim, &gDoorChildOpeningLeftAnim,
+// Name from zeldaret/oot (was D_809FCECC): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Door/z_en_door.c]
+static AnimationHeader* sDoorAnims[] = { &gDoorAdultOpeningLeftAnim, &gDoorChildOpeningLeftAnim,
                                          &gDoorAdultOpeningRightAnim, &gDoorChildOpeningRightAnim };
 
 static u8 sDoorAnimOpenFrames[] = { 25, 25, 25, 25 };
@@ -198,7 +199,7 @@ void EnDoor_Idle(EnDoor* this, PlayState* play) {
     Actor_WorldToActorCoords(&this->actor, &playerPosRelToDoor, &player->actor.world.pos);
     if (this->playerIsOpening != 0) {
         this->actionFunc = EnDoor_Open;
-        Animation_PlayOnceSetSpeed(&this->skelAnime, D_809FCECC[this->animStyle],
+        Animation_PlayOnceSetSpeed(&this->skelAnime, sDoorAnims[this->animStyle],
                                    (player->stateFlags1 & PLAYER_STATE1_IN_WATER) ? 0.75f : 1.5f);
         if (this->lockTimer != 0) {
             if (GameInteractor_Should(VB_CONSUME_SMALL_KEY, true, this)) {
