From 80011791e84af6d4b9cb65af6f2ab3dd7125d9bb Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:49 +0000
Subject: [PATCH 3162/3799] soh: rename D_8015E4F8 -> sQuadVsTrisTri1

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the second triangle of that same split
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index 64a159785..39ecafcae 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2405,7 +2405,7 @@ void CollisionCheck_AC_TrisVsQuad(PlayState* play, CollisionCheckContext* colChk
 void CollisionCheck_AC_QuadVsTris(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT, Collider* colAC) {
     static Vec3f sQuadVsTrisHitPos;  // was D_8015E4B0 [LLM:HIGH]
     static TriNorm sQuadVsTrisTri0;  // was D_8015E4C0 [LLM:HIGH]
-    static TriNorm D_8015E4F8;
+    static TriNorm sQuadVsTrisTri1;  // was D_8015E4F8 [LLM:HIGH]
     ColliderQuad* at = (ColliderQuad*)colAT;
     ColliderTris* ac = (ColliderTris*)colAC;
     ColliderTrisElement* acElem;
@@ -2415,7 +2415,7 @@ void CollisionCheck_AC_QuadVsTris(PlayState* play, CollisionCheckContext* colChk
             return;
         }
         Math3D_TriNorm(&sQuadVsTrisTri0, &at->dim.quad[2], &at->dim.quad[3], &at->dim.quad[1]);  // was D_8015E4C0 [LLM:HIGH]
-        Math3D_TriNorm(&D_8015E4F8, &at->dim.quad[1], &at->dim.quad[0], &at->dim.quad[2]);
+        Math3D_TriNorm(&sQuadVsTrisTri1, &at->dim.quad[1], &at->dim.quad[0], &at->dim.quad[2]);  // was D_8015E4F8 [LLM:HIGH]
         for (acElem = ac->elements; acElem < ac->elements + ac->count; acElem++) {
             if (CollisionCheck_SkipBump(&acElem->info) == 1) {
                 continue;
@@ -2424,7 +2424,7 @@ void CollisionCheck_AC_QuadVsTris(PlayState* play, CollisionCheckContext* colChk
                 continue;
             }
             if (Math3D_TriVsTriIntersect(&sQuadVsTrisTri0, &acElem->dim, &sQuadVsTrisHitPos) == 1 ||  // was D_8015E4B0 [LLM:HIGH]
-                Math3D_TriVsTriIntersect(&D_8015E4F8, &acElem->dim, &sQuadVsTrisHitPos) == 1) {  // was D_8015E4B0 [LLM:HIGH]
+                Math3D_TriVsTriIntersect(&sQuadVsTrisTri1, &acElem->dim, &sQuadVsTrisHitPos) == 1) {  // was D_8015E4B0 [LLM:HIGH]
                 if (Collider_QuadSetNearestAC(play, at, &sQuadVsTrisHitPos)) {  // was D_8015E4B0 [LLM:HIGH]
                     Vec3f atPos;
                     Vec3f acPos;
