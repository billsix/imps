Subject: [PATCH 2930/3799] soh: rename func_80B406F8 ->
 EnXc_SetupNocturneHidden

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: enters the Nocturne init action with nothing drawn and no shadow
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 88321b511..7e7a2307a 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -1886,7 +1886,8 @@ void EnXc_SetCrySFX(EnXc* this, PlayState* play) {
     }
 }
 
-void func_80B406F8(Actor* thisx) {
+// LLM generated name (HIGH), was func_80B406F8: enters the Nocturne init action with nothing drawn and no shadow
+void EnXc_SetupNocturneHidden(Actor* thisx) {
     EnXc* this = (EnXc*)thisx;
 
     this->action = SHEIK_ACTION_NOCTURNE_INIT;
@@ -2065,7 +2066,7 @@ s32 EnXc_SetupNocturneState(Actor* thisx, PlayState* play) {
         if (action != prevAction) {
             switch (action) {
                 case 1:
-                    func_80B406F8(thisx);
+                    EnXc_SetupNocturneHidden(thisx);  // was func_80B406F8 [LLM:HIGH]
                     break;
                 case 6:
                     EnXc_SetupIdleInNocturne(this, play);
