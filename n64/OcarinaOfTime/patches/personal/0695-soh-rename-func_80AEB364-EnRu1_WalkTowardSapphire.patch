Date: Mon, 7 Sep 2026 15:21:33 +0000
Subject: [PATCH 695/784] soh: rename func_80AEB364 -> EnRu1_WalkTowardSapphire

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 019498ed5..bee0c0fa0 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -441,14 +441,15 @@ s32 EnRu1_UpdateSkelAnime(EnRu1* this) {
     }
 }
 
-void func_80AEB364(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEB364): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_WalkTowardSapphire(EnRu1* this, PlayState* play) {
     this->skelAnime.movementFlags |= 1;
     AnimationContext_SetMoveActor(play, &this->actor, &this->skelAnime, 1.0f);
 }
 
 void func_80AEB3A4(EnRu1* this, PlayState* play) {
     this->skelAnime.movementFlags |= 1;
-    func_80AEB364(this, play);
+    EnRu1_WalkTowardSapphire(this, play);
 }
 
 void func_80AEB3CC(EnRu1* this) {
@@ -2180,7 +2181,7 @@ void func_80AEFA2C(EnRu1* this, PlayState* play) {
     s32 something;
 
     EnRu1_TurnUpperBodyForward(this);
-    func_80AEB364(this, play);
+    EnRu1_WalkTowardSapphire(this, play);
     EnRu1_UpdateBgCheckInfo(this, play);
     something = EnRu1_UpdateSkelAnime(this);
     EnRu1_PlayLaughingSfx(this);
