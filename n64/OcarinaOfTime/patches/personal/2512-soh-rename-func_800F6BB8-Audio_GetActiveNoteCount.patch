From b7850300cece1d5ce8afbb1f8647749283d66ee7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:57 +0000
Subject: [PATCH 2512/3799] soh: rename func_800F6BB8 ->
 Audio_GetActiveNoteCount

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: forwards AudioThread_GetActiveNoteCount
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h      | 2 +-
 soh/src/code/audio_general.c | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index c5ba8abe4..560901af3 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -2129,7 +2129,7 @@ void Audio_PlaySfxIfNotInCutscene(u16 sfxId);
 void Audio_FadeOutAllPlayers(u16);  // was func_800F6964 [LLM:HIGH]
 void Audio_StopBgmAndFanfare(u16);
 // ? Audio_DisableAllSeq(?);
-// ? func_800F6BB8(?);
+// ? Audio_GetActiveNoteCount(?);, was func_800F6BB8 [LLM:HIGH]
 void Audio_PreNMI();
 // ? Audio_ResetData(?);
 void Audio_SetNatureAmbienceChannelIO(u8 channelIdxRange, u8 port, u8 val);
diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index e18e1f7e1..2559f1a97 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -5438,7 +5438,8 @@ void Audio_DisableAllSeq(void) {
     Audio_ScheduleProcessCmds();
 }
 
-s8 func_800F6BB8(void) {
+// LLM generated name (HIGH), was func_800F6BB8: forwards AudioThread_GetActiveNoteCount
+s8 Audio_GetActiveNoteCount(void) {
     return AudioThread_GetActiveNoteCount();
 }
 
@@ -5446,7 +5447,7 @@ void func_800F6BDC(void) {
     Audio_DisableAllSeq();
     Audio_ScheduleProcessCmds();
     while (true) {
-        if (!func_800F6BB8()) {
+        if (!Audio_GetActiveNoteCount()) {  // was func_800F6BB8 [LLM:HIGH]
             return;
         }
     }
