From 0c56611b439ab3831e2863f341e2f87c9f6ae07d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:36 +0000
Subject: [PATCH 3063/3799] soh: rename D_801208E0 -> sCs6001PointCount

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the number of points in those arrays
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 1bed9fd42..af07d62f0 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -133,7 +133,8 @@ static CutsceneCameraPoint sCs6001EyePoints[12] = {  // was D_80120820 [LLM:HIGH
     { CS_CMD_CONTINUE, 1, 0, 65.0f, { 75, 18, 123 } }, { CS_CMD_CONTINUE, 1, 0, 65.0f, { 75, 10, 123 } },
     { CS_CMD_STOP, 0, 0, 65.0f, { 75, 10, 122 } },     { CS_CMD_STOP, 0, 0, 65.0f, { 75, 10, 122 } },
 };
-static s16 D_801208E0 = 12;
+// LLM generated name (HIGH), was D_801208E0: the number of points in those arrays
+static s16 sCs6001PointCount = 12;  // was D_801208E0 [LLM:HIGH]
 static s16 D_801208E4 = 90;
 static s16 D_801208E8 = 8;
 
