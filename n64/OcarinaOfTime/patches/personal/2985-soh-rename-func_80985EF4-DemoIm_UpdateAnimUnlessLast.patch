+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -595,7 +595,8 @@ void DemoIm_TrackPlayerDuringCs(DemoIm* this, PlayState* play) {
     }
 }
 
-void func_80985EF4(DemoIm* this) {
+// LLM generated name (HIGH), was func_80985EF4: advances the animation except on the whistling animation's final frame, holding the pose
+void DemoIm_UpdateAnimUnlessLastFrame(DemoIm* this) {
     if (!Animation_OnFrame(&this->skelAnime, Animation_GetLastFrame(&gImpaWhistlingAnim) - 1.0f)) {
         DemoIm_UpdateSkelAnime(this);
     }
@@ -740,7 +741,7 @@ void func_80986430(DemoIm* this, PlayState* play) {
 
 void func_80986494(DemoIm* this, PlayState* play) {
     DemoIm_UpdateBgCheckInfo(this, play);
