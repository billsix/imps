Subject: [PATCH 737/784] soh: rename func_80AEFD38 -> EnRu1_InitBesideKingZora

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 0.99.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index c39aa0d34..632648851 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -2295,7 +2295,8 @@ void EnRu1_SapphireRoom_Waiting(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEFD38(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEFD38): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.99. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_InitBesideKingZora(EnRu1* this, PlayState* play) {
     if ((Flags_GetEventChkInf(EVENTCHKINF_USED_JABU_JABUS_BELLY_BLUE_WARP)) && LINK_IS_CHILD) {
         EnRu1_AnimationChange(this, &gRutoChildWait2Anim, 0, 0, 0);
         this->actor.flags &= ~ACTOR_FLAG_UPDATE_CULLING_DISABLED;
@@ -2426,7 +2427,7 @@ void EnRu1_Init(Actor* thisx, PlayState* play) {
             EnRu1_InitInSapphireRoom(this, play);
             break;
         case 5:
-            func_80AEFD38(this, play);
+            EnRu1_InitBesideKingZora(this, play);
             break;
         case 6:
             func_80AEFF94(this, play);
