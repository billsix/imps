From 93a4cda47a55c9f65815fcff857aa7ee6b8a4fda Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:26:56 +0000
Subject: [PATCH 1556/3799] soh: rename func_80A2F180 -> EnGb_UpdateTextId

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: picks the Poe collector's greeting depending on whether the player has spoken to him before.
Defined in soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c b/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
index c8d499ab0..05a649591 100644
--- a/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
+++ b/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
@@ -143,7 +143,8 @@ static Vec3f sBottlesPositions[] = {
     { -48.0f, 0.0f, 60.0f },
 };
 
-void func_80A2F180(EnGb* this) {
+// LLM generated name (HIGH), was func_80A2F180: picks the Poe collector's greeting depending on whether the player has spoken to him before.
+void EnGb_UpdateTextId(EnGb* this) {
     if (Flags_GetInfTable(INFTABLE_SPOKE_TO_POE_COLLECTOR_IN_RUINED_MARKET)) {
         this->textId = 0x70F5;
     } else {
@@ -215,7 +216,7 @@ void EnGb_Init(Actor* thisx, PlayState* play) {
     focusOffset.z = 44.0f;
     Matrix_MultVec3f(&focusOffset, &this->dyna.actor.focus.pos);
     this->dyna.actor.focus.pos.y += 62.5f;
-    func_80A2F180(this);
+    EnGb_UpdateTextId(this);  // was func_80A2F180 [LLM:HIGH]
     this->actionFunc = func_80A2F83C;
 }
 
@@ -287,7 +288,7 @@ void func_80A2F83C(EnGb* this, PlayState* play) {
         if (GameInteractor_Should(VB_SELL_POES_TO_POE_COLLECTOR, true, this)) {
             switch (Actor_GetPlayerExchangeItemId(play)) {
                 case EXCH_ITEM_NONE:
-                    func_80A2F180(this);
+                    EnGb_UpdateTextId(this);  // was func_80A2F180 [LLM:HIGH]
                     this->actionFunc = func_80A2F94C;
                     break;
                 case EXCH_ITEM_POE:
@@ -312,7 +313,7 @@ void func_80A2F94C(EnGb* this, PlayState* play) {
         if (!Flags_GetInfTable(INFTABLE_SPOKE_TO_POE_COLLECTOR_IN_RUINED_MARKET)) {
             Flags_SetInfTable(INFTABLE_SPOKE_TO_POE_COLLECTOR_IN_RUINED_MARKET);
         }
-        func_80A2F180(this);
+        EnGb_UpdateTextId(this);  // was func_80A2F180 [LLM:HIGH]
         this->actionFunc = func_80A2F83C;
     }
 }
@@ -322,7 +323,7 @@ void func_80A2F9C0(EnGb* this, PlayState* play) {
         if (!Flags_GetInfTable(INFTABLE_SPOKE_TO_POE_COLLECTOR_IN_RUINED_MARKET)) {
             Flags_SetInfTable(INFTABLE_SPOKE_TO_POE_COLLECTOR_IN_RUINED_MARKET);
         }
-        func_80A2F180(this);
+        EnGb_UpdateTextId(this);  // was func_80A2F180 [LLM:HIGH]
         Player_UpdateBottleHeld(play, GET_PLAYER(play), ITEM_BOTTLE, PLAYER_IA_BOTTLE);
         Rupees_ChangeBy(10);
         this->actionFunc = func_80A2F83C;
@@ -334,7 +335,7 @@ void func_80A2FA50(EnGb* this, PlayState* play) {
         if (!Flags_GetInfTable(INFTABLE_SPOKE_TO_POE_COLLECTOR_IN_RUINED_MARKET)) {
             Flags_SetInfTable(INFTABLE_SPOKE_TO_POE_COLLECTOR_IN_RUINED_MARKET);
         }
-        func_80A2F180(this);
+        EnGb_UpdateTextId(this);  // was func_80A2F180 [LLM:HIGH]
         Player_UpdateBottleHeld(play, GET_PLAYER(play), ITEM_BOTTLE, PLAYER_IA_BOTTLE);
         Rupees_ChangeBy(50);
         HIGH_SCORE(HS_POE_POINTS) += 100;
@@ -375,7 +376,7 @@ void func_80A2FBB0(EnGb* this, PlayState* play) {
 void func_80A2FC0C(EnGb* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_DONE && Message_ShouldAdvance(play)) {
         Actor_ProcessTalkRequest(&this->dyna.actor, play);
-        func_80A2F180(this);
+        EnGb_UpdateTextId(this);  // was func_80A2F180 [LLM:HIGH]
         this->actionFunc = func_80A2F83C;
     }
 }
