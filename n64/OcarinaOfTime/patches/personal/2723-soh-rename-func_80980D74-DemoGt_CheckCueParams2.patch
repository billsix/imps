 }
 
-void func_80980D74(DemoGt* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80980D74: switches the params 2 piece to update mode 10 when its cue reaches action 2
+void DemoGt_CheckCueParams2(DemoGt* this, PlayState* play) {
     if (DemoGt_IsCueAction(play, 2, 3)) {  // was func_8097E704 [LLM:HIGH]
         this->updateMode = 10;
     }
@@ -1201,7 +1202,7 @@ void func_80980D74(DemoGt* this, PlayState* play) {
