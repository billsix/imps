From 015472ab9e5d49ebbfdeee6ce5b2f873111c27f5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:43 +0000
Subject: [PATCH 2893/3799] soh: rename func_80B3EBF0 -> EnXc_GoToAction20

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sets action 20
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index fa444b9e3..ebf213648 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -1179,7 +1179,8 @@ void EnXc_DrawHarp(Actor* thisx, PlayState* play) {
     CLOSE_DISPS(gfxCtx);
 }
 
-void func_80B3EBF0(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B3EBF0: sets action 20
+void EnXc_GoToAction20(EnXc* this, PlayState* play) {
     this->action = SHEIK_ACTION_20;
 }
 
@@ -2222,7 +2223,7 @@ void EnXc_InitTempleOfTime(EnXc* this, PlayState* play) {
                 play->csCtx.segment = SEGMENTED_TO_VIRTUAL(gTempleOfTimeFirstAdultCs);
                 gSaveContext.cutsceneTrigger = 1;
             }
-            func_80B3EBF0(this, play);
+            EnXc_GoToAction20(this, play);  // was func_80B3EBF0 [LLM:HIGH]
         } else if (GameInteractor_Should(VB_BE_ELIGIBLE_FOR_PRELUDE_OF_LIGHT,
                                          !Flags_GetEventChkInf(EVENTCHKINF_LEARNED_PRELUDE_OF_LIGHT) &&
                                              Flags_GetEventChkInf(EVENTCHKINF_USED_FOREST_TEMPLE_BLUE_WARP))) {
@@ -2391,7 +2392,7 @@ void EnXc_Init(Actor* thisx, PlayState* play) {
 
     switch (this->actor.params) {
         case SHEIK_TYPE_1:
-            func_80B3EBF0(this, play);
+            EnXc_GoToAction20(this, play);  // was func_80B3EBF0 [LLM:HIGH]
             break;
         case SHEIK_TYPE_2: // Beta Serenade Cutscene or Learning Prelude
             func_80B3EE64(this, play);
