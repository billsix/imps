From aa4617a775e01b15bf966cd388a9a3534d2fb7a2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:35 +0000
Subject: [PATCH 0702/3799] soh: rename func_80AEB87C -> EnRu1_Lerp

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index ac8f0dfee..0e85cbe9f 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -558,7 +558,8 @@ f32 EnRu1_GetSwimLerpFactor(CsCmdActorCue* csCmdNPCAction, PlayState* play) {
     return 1.0f;
 }
 
-f32 func_80AEB87C(f32 arg0, s32 arg1, s32 arg2) {
+// Name from zeldaret/oot (was func_80AEB87C): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+f32 EnRu1_Lerp(f32 arg0, s32 arg1, s32 arg2) {
     return (((f32)arg2 - arg1) * arg0) + arg1;
 }
 
@@ -598,9 +599,9 @@ void func_80AEB974(EnRu1* this, PlayState* play) {
     if (csCmdNPCAction != NULL) {
         sp30 = EnRu1_GetSwimLerpFactor(csCmdNPCAction, play);
         thisPos = &this->actor.world.pos;
-        thisPos->x = func_80AEB87C(sp30, csCmdNPCAction->startPos.x, csCmdNPCAction->endPos.x);
-        thisPos->y = func_80AEB87C(sp30, csCmdNPCAction->startPos.y, csCmdNPCAction->endPos.y);
-        thisPos->z = func_80AEB87C(sp30, csCmdNPCAction->startPos.z, csCmdNPCAction->endPos.z);
+        thisPos->x = EnRu1_Lerp(sp30, csCmdNPCAction->startPos.x, csCmdNPCAction->endPos.x);
+        thisPos->y = EnRu1_Lerp(sp30, csCmdNPCAction->startPos.y, csCmdNPCAction->endPos.y);
+        thisPos->z = EnRu1_Lerp(sp30, csCmdNPCAction->startPos.z, csCmdNPCAction->endPos.z);
     }
 }
 
@@ -620,9 +621,9 @@ void func_80AEBA2C(EnRu1* this, PlayState* play) {
     if (csCmdNPCAction != NULL) {
         temp_ret_2 = EnRu1_GetSwimLerpFactor(csCmdNPCAction, play);
         thisPos = &this->actor.world.pos;
-        thisPos->x = func_80AEB87C(temp_ret_2, unk_364->x, csCmdNPCAction->endPos.x);
-        thisPos->y = func_80AEB87C(temp_ret_2, unk_364->y, csCmdNPCAction->endPos.y);
-        thisPos->z = func_80AEB87C(temp_ret_2, unk_364->z, csCmdNPCAction->endPos.z);
+        thisPos->x = EnRu1_Lerp(temp_ret_2, unk_364->x, csCmdNPCAction->endPos.x);
+        thisPos->y = EnRu1_Lerp(temp_ret_2, unk_364->y, csCmdNPCAction->endPos.y);
+        thisPos->z = EnRu1_Lerp(temp_ret_2, unk_364->z, csCmdNPCAction->endPos.z);
     }
 }
 
