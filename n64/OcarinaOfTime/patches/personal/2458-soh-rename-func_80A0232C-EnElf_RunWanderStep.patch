             this->unk_2C0 = 0;
             this->disappearTimer = 240;
             break;
@@ -618,7 +619,7 @@ void func_80A0329C(EnElf* this, PlayState* play) {
         this->unk_2AE = (s16)(Rand_ZeroFloat(1024.0f)) + 0x200;
     }
 
-    func_80A0232C(this, play);
+    EnElf_RunWanderStep(this, play);  // was func_80A0232C [LLM:HIGH]
     this->unk_28C.y = player->bodyPartsPos[0].y;
