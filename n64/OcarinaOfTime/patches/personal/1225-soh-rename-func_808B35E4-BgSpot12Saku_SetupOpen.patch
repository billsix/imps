From 4b637860ebd99ef84636cdadedfae829874160d1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:01:57 +0000
Subject: [PATCH 1225/3799] soh: rename func_808B35E4 -> BgSpot12Saku_SetupOpen

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the opening action once the delay timer has run out.
Defined in soh/src/overlays/actors/ovl_Bg_Spot12_Saku/z_bg_spot12_saku.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot12_Saku/z_bg_spot12_saku.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot12_Saku/z_bg_spot12_saku.c b/soh/src/overlays/actors/ovl_Bg_Spot12_Saku/z_bg_spot12_saku.c
index fa01a19b0..873bc044c 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot12_Saku/z_bg_spot12_saku.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot12_Saku/z_bg_spot12_saku.c
@@ -19,7 +19,8 @@ void BgSpot12Saku_Draw(Actor* thisx, PlayState* play);
 void BgSpot12Saku_SetupWaitForSwitch(BgSpot12Saku* this);  // was func_808B3550 [LLM:HIGH]
 // LLM generated name (HIGH), was func_808B357C: waits for the GTG gate switch flag, then arms the 20-frame delay and starts the one-point cutscene that shows the gate.
 void BgSpot12Saku_WaitForSwitch(BgSpot12Saku* this, PlayState* play);  // was func_808B357C [LLM:HIGH]
-void func_808B35E4(BgSpot12Saku* this);
+// LLM generated name (HIGH), was func_808B35E4: installs the opening action once the delay timer has run out.
+void BgSpot12Saku_SetupOpen(BgSpot12Saku* this);  // was func_808B35E4 [LLM:HIGH]
 void func_808B3604(BgSpot12Saku* this, PlayState* play);
 void func_808B3714(BgSpot12Saku* this);
 void func_808B37AC(BgSpot12Saku* this, PlayState* play);
@@ -86,13 +87,13 @@ void BgSpot12Saku_SetupWaitForSwitch(BgSpot12Saku* this) {
 
 void BgSpot12Saku_WaitForSwitch(BgSpot12Saku* this, PlayState* play) {
     if (GameInteractor_Should(VB_GTG_GATE_BE_OPEN, Flags_GetSwitch(play, this->dyna.actor.params & 0x3F))) {
-        func_808B35E4(this);
+        BgSpot12Saku_SetupOpen(this);  // was func_808B35E4 [LLM:HIGH]
         this->timer = 20;
         OnePointCutscene_Init(play, 4170, -99, &this->dyna.actor, CAM_ID_MAIN);
     }
 }
 
-void func_808B35E4(BgSpot12Saku* this) {
+void BgSpot12Saku_SetupOpen(BgSpot12Saku* this) {
     if (this->timer == 0) {
         this->actionFunc = func_808B3604;
     }
