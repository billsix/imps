From 9d119f8a77a1dff4a7e57352b943c14a26d1dbba Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:14:12 +0000
Subject: [PATCH 2154/3799] soh: rename D_8096931C -> sStreakScales

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the four-step scale cycle applied to each falling streak
Defined in soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c b/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
index c70d98ec0..e17653593 100644
--- a/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
+++ b/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
@@ -84,7 +84,8 @@ static Color_RGB8 sEnvColors[] = {
 };
 // LLM generated name (HIGH), was D_8096930C: the four-step 1.0 / 1.04 / 1.0 / 0.96 pulse applied to the whiteout scale
 static f32 sPulseScales[] = { 1.0f, 1.04f, 1.0f, 0.96f };  // was D_8096930C [LLM:HIGH]
-static f32 D_8096931C[] = { 1.1f, 1.0f, 0.9f, 0.8f };
+// LLM generated name (HIGH), was D_8096931C: the four-step scale cycle applied to each falling streak
+static f32 sStreakScales[] = { 1.1f, 1.0f, 0.9f, 0.8f };  // was D_8096931C [LLM:HIGH]
 
 void Demo6K_SetupAction(Demo6K* this, Demo6KActionFunc actionFunc) {
     this->actionFunc = actionFunc;
@@ -734,9 +735,9 @@ void Demo6K_DrawStreaks(Actor* thisx, PlayState* play2) {
                            sEnvColors[this->unk_274[i]].b, 255);
             Matrix_Push();
             Matrix_Translate(this->unk_174[i], this->unk_1B4[i], 0.0f, MTXMODE_APPLY);
-            Matrix_Scale(this->unk_234[i] * D_8096931C[(frames + i) & 3],
-                         this->unk_234[i] * D_8096931C[(frames + i) & 3],
-                         this->unk_234[i] * D_8096931C[(frames + i) & 3], MTXMODE_APPLY);
+            Matrix_Scale(this->unk_234[i] * sStreakScales[(frames + i) & 3],  // was D_8096931C [LLM:HIGH]
+                         this->unk_234[i] * sStreakScales[(frames + i) & 3],  // was D_8096931C [LLM:HIGH]
+                         this->unk_234[i] * sStreakScales[(frames + i) & 3], MTXMODE_APPLY);  // was D_8096931C [LLM:HIGH]
             Matrix_ReplaceRotation(&play->billboardMtxF);
             gSPMatrix(POLY_XLU_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
             gSPDisplayList(POLY_XLU_DISP++, gEffFlash1DL);
