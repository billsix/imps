From 7b4d36f76da2fa2a0ad9f874649a4e19f99087fe Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:14 +0000
Subject: [PATCH 3460/3799] soh: rename D_80A9A62C -> sTrackYOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-type, per-quest-state head-tracking offset EnKo_GetTrackYOffset returns
Defined in soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
index b726979af..78f2bc0eb 100644
--- a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
+++ b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
@@ -635,7 +635,7 @@ s32 EnKo_GetForestQuestState(EnKo* this) {
 
 // LLM generated name (HIGH), was func_80A97BC0: returns the head-tracking yOffset for this Kokiri's type and forest quest state; Fado as adult is a fixed -20
 f32 EnKo_GetTrackYOffset(EnKo* this) {
-    f32 D_80A9A62C[13][5] = {
+    f32 sTrackYOffsets[13][5] = {  // was D_80A9A62C [LLM:HIGH]
         /* ENKO_TYPE_CHILD_0    */ { 0.0f, 0.0f, 0.0f, -30.0f, -20.0f },
         /* ENKO_TYPE_CHILD_1    */ { 0.0f, 0.0f, 0.0f, -20.0f, -10.0f },
         /* ENKO_TYPE_CHILD_2    */ { 0.0f, 0.0f, 0.0f, -30.0f, -20.0f },
@@ -654,7 +654,7 @@ f32 EnKo_GetTrackYOffset(EnKo* this) {
     if (LINK_IS_ADULT && ENKO_TYPE == ENKO_TYPE_CHILD_FADO) {
         return -20.0f;
     }
-    return D_80A9A62C[ENKO_TYPE][EnKo_GetForestQuestState(this)];
+    return sTrackYOffsets[ENKO_TYPE][EnKo_GetForestQuestState(this)];  // was D_80A9A62C [LLM:HIGH]
 }
 
 // LLM generated name (HIGH), was func_80A97C7C: the caller runs Actor_UpdateBgCheckInfo and sets gravity -1 when this is true, gravity 0 when false
-- 
