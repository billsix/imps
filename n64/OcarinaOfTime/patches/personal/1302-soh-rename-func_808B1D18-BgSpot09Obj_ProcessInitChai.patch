From 44bb85b58698736b1e5e4ef179bf255b8733e4a2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:08:54 +0000
Subject: [PATCH 1302/3799] soh: rename func_808B1D18 ->
 BgSpot09Obj_ProcessInitChain2

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: applies the second init chain instead.
Defined in soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
index 43a756afc..7feccdb24 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
@@ -128,14 +128,15 @@ s32 BgSpot09Obj_ProcessInitChain1(BgSpot09Obj* this, PlayState* play) {
     return true;
 }
 
-s32 func_808B1D18(BgSpot09Obj* this, PlayState* play) {
+// LLM generated name (HIGH), was func_808B1D18: applies the second init chain instead.
+s32 BgSpot09Obj_ProcessInitChain2(BgSpot09Obj* this, PlayState* play) {
     Actor_ProcessInitChain(&this->dyna.actor, sInitChain2);
     return true;
 }
 
 s32 func_808B1D44(BgSpot09Obj* this, PlayState* play) {
     if (this->dyna.actor.params == 3) {
-        return func_808B1D18(this, play);
+        return BgSpot09Obj_ProcessInitChain2(this, play);  // was func_808B1D18 [LLM:HIGH]
     } else {
         return BgSpot09Obj_ProcessInitChain1(this, play);  // was func_808B1CEC [LLM:HIGH]
     }
