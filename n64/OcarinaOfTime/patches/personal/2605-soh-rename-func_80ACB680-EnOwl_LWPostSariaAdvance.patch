Subject: [PATCH 2605/3799] soh: rename func_80ACB680 ->
 EnOwl_LWPostSariaAdvance

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: continues the post-Saria message into its choice
Defined in soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
index 335471790..6e78a4911 100644
--- a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
+++ b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
@@ -48,7 +48,8 @@ void EnOwl_LakeHyliaAdvance(EnOwl* this, PlayState* play);  // was func_80ACAF74
 void func_80ACC30C(EnOwl* this, PlayState* play);
 // LLM generated name (HIGH), was func_80ACB4FC: continues the pre-Saria message into its choice
 void EnOwl_LWPreSariaAdvance(EnOwl* this, PlayState* play);  // was func_80ACB4FC [LLM:HIGH]
-void func_80ACB680(EnOwl* this, PlayState* play);
+// LLM generated name (HIGH), was func_80ACB680: continues the post-Saria message into its choice
+void EnOwl_LWPostSariaAdvance(EnOwl* this, PlayState* play);  // was func_80ACB680 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80ACA62C: sets this owl's switch flag when it has one, then unfolds the wings
 void EnOwl_SetSwitchAndUnfold(EnOwl* this, PlayState* play);  // was func_80ACA62C [LLM:HIGH]
 void func_80ACC460(EnOwl* this);
@@ -725,7 +726,7 @@ void EnOwl_LWPostSariaChoice(EnOwl* this, PlayState* play) {
         switch (play->msgCtx.choiceIndex) {
             case OWL_REPEAT:
                 Message_ContinueTextbox(play, 0x10C5);
-                this->actionFunc = func_80ACB680;
+                this->actionFunc = EnOwl_LWPostSariaAdvance;  // was func_80ACB680 [LLM:HIGH]
                 break;
             case OWL_OK:
                 Message_ContinueTextbox(play, 0x10C7);
@@ -738,7 +739,7 @@ void EnOwl_LWPostSariaChoice(EnOwl* this, PlayState* play) {
     }
 }
 
-void func_80ACB680(EnOwl* this, PlayState* play) {
+void EnOwl_LWPostSariaAdvance(EnOwl* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT && Message_ShouldAdvance(play)) {
         Message_ContinueTextbox(play, 0x10C6);
         this->actionFunc = EnOwl_LWPostSariaChoice;  // was func_80ACB5C4 [LLM:HIGH]
@@ -752,7 +753,7 @@ void EnOwl_WaitLWPostSaria(EnOwl* this, PlayState* play) {
 
     if (EnOwl_CheckInitTalk(this, play, 0x10C4, 360.0f, 0)) {
         Audio_PlayFanfare(NA_BGM_OWL);
-        this->actionFunc = func_80ACB680;
+        this->actionFunc = EnOwl_LWPostSariaAdvance;  // was func_80ACB680 [LLM:HIGH]
     }
 }
 
