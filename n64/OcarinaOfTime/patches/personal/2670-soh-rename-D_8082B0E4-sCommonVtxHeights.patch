From 2f6d000818a5672001c8ca0762a6d24aa0e8ef09 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:42 +0000
Subject: [PATCH 2670/3799] soh: rename D_8082B0E4 -> sCommonVtxHeights

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: heights of those same shared quads
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 25c557853..3b6721b4a 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2744,7 +2744,8 @@ static s16 sCommonVtxY[] = {  // was D_8082B0B8 [LLM:HIGH]
     0x002A, 0x0007, 0xFED4, 0xFED4, 0x0018, 0x0024, 0x0035, 0x0025, 0xFFF3, 0xFED4, 0x0000,
 };
 
-static s16 D_8082B0E4[] = {
+// LLM generated name (HIGH), was D_8082B0E4: heights of those same shared quads
+static s16 sCommonVtxHeights[] = {  // was D_8082B0E4 [LLM:HIGH]
     0x0024, 0x000F, 0x0010, 0x0017, 0x0017, 0x0010, 0x0018, 0x000D, 0x0011, 0x0012, 0x0001,
     0x0019, 0x000D, 0x0001, 0x0001, 0x000D, 0x0015, 0x000F, 0x000D, 0x000C, 0x0001, 0x0000,
 };
@@ -2958,7 +2959,7 @@ s16 KaleidoScope_SetPageVtx(PlayState* play, Vtx* vtx, s16 pageIndex, s16 arg3)
 
             vtx[vtxIndex + 0].v.ob[1] = vtx[vtxIndex + 1].v.ob[1] = sCommonVtxY[colorIndex] + pauseCtx->offsetY;  // was D_8082B0B8 [LLM:HIGH]
 
-            vtx[vtxIndex + 2].v.ob[1] = vtx[vtxIndex + 3].v.ob[1] = vtx[vtxIndex + 0].v.ob[1] - D_8082B0E4[colorIndex];
+            vtx[vtxIndex + 2].v.ob[1] = vtx[vtxIndex + 3].v.ob[1] = vtx[vtxIndex + 0].v.ob[1] - sCommonVtxHeights[colorIndex];  // was D_8082B0E4 [LLM:HIGH]
 
             vtxIndex += 12;
 
