From 0ff6150719e079e4175a4369ee4dfb2fb442cd68 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:50 +0000
Subject: [PATCH 3168/3799] soh: rename D_8015E638 -> sLineOCCylHitB

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the second intersection of that same call
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index 33fd24a5b..6b7bdc22c 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -3131,13 +3131,13 @@ s32 CollisionCheck_LineOC_JntSph(PlayState* play, CollisionCheckContext* colChkC
 s32 CollisionCheck_LineOC_Cyl(PlayState* play, CollisionCheckContext* colChkCtx, Collider* collider, Vec3f* a,
                               Vec3f* b) {
     static Vec3f sLineOCCylHitA;  // was D_8015E628 [LLM:HIGH]
-    static Vec3f D_8015E638;
+    static Vec3f sLineOCCylHitB;  // was D_8015E638 [LLM:HIGH]
     ColliderCylinder* cylinder = (ColliderCylinder*)collider;
 
     if (!(cylinder->info.ocElemFlags & OCELEM_ON)) {
         return false;
     }
-    if (Math3D_CylVsLineSeg(&cylinder->dim, a, b, &sLineOCCylHitA, &D_8015E638) != 0) {  // was D_8015E628 [LLM:HIGH]
+    if (Math3D_CylVsLineSeg(&cylinder->dim, a, b, &sLineOCCylHitA, &sLineOCCylHitB) != 0) {  // was D_8015E628 [LLM:HIGH]
         return true;
     }
     return false;
