From 2a5d337bda19cc176afd67dac37aeddf49a54029 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:02:04 +0000
Subject: [PATCH 207/225] soh: rename D_80B7A6A4 -> sReelCatchTimer

Name source: deduced from the code (confidence GUESS).
Defined in soh/src/overlays/actors/ovl_Fishing/z_fishing.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_Fishing/z_fishing.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
index 7808a650b..376478597 100644
--- a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
+++ b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
@@ -179,7 +179,8 @@ static s16 sRodCastState = 0;
 
 static Vec3f sFishMouthOffset = { 500.0f, 500.0f, 0.0f };
 
-static u8 D_80B7A6A4 = 0;
+// LLM generated name (GUESS), was D_80B7A6A4: set to 5, decremented per frame; gates fish-catch handling
+static u8 sReelCatchTimer = 0;
 
 static f32 sRodBendRotY = 0.0f;
 static f32 D_80B7A6AC = 0.0f;
@@ -1472,7 +1473,7 @@ void Fishing_UpdateLine(PlayState* play, Vec3f* basePos, Vec3f* pos, Vec3f* rot,
     f32 phi_f12;
     f32 phi_f2;
 
-    if (D_80B7A6A4 != 0) {
+    if (sReelCatchTimer != 0) {
         tempPos = *basePos;
         segPos = pos[LINE_SEG_COUNT - 1];
 
@@ -1494,7 +1495,7 @@ void Fishing_UpdateLine(PlayState* play, Vec3f* basePos, Vec3f* pos, Vec3f* rot,
     for (i = 0; i < LINE_SEG_COUNT; i++) {
         if (i <= spooled) {
             pos[i] = *basePos;
-        } else if (D_80B7A6A4 != 0) {
+        } else if (sReelCatchTimer != 0) {
             temp_f20 = (f32)(i - spooled) / (f32)(LINE_SEG_COUNT - spooled + 1);
             Math_ApproachF(&pos[i].x, (sp94 * temp_f20) + tempPos.x, 1.0f, 20.0f);
             Math_ApproachF(&pos[i].y, (sp90 * temp_f20) + tempPos.y, 1.0f, 20.0f);
@@ -2175,8 +2176,8 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
         D_80B7E150--;
     }
 
-    if (D_80B7A6A4 != 0) {
-        D_80B7A6A4--;
+    if (sReelCatchTimer != 0) {
+        sReelCatchTimer--;
     }
 
     if (sRumbleDelay != 0) {
@@ -2666,7 +2667,7 @@ void Fishing_UpdateLure(Fishing* this, PlayState* play) {
 
             if ((sLureTimer & 0x1F) == 0) {
                 if (sLineHooked || (sLureEquipped != FS_LURE_SINKING)) {
-                    D_80B7A6A4 = 5;
+                    sReelCatchTimer = 5;
                 }
             }
 
