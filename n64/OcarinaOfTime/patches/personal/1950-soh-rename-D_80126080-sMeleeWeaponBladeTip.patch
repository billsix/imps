From c9e3de647e6a575ebcdad4e66b77a2757df50dd3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:05:34 +0000
Subject: [PATCH 1950/3799] soh: rename D_80126080 -> sMeleeWeaponBladeTip

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: tip of the blade line in hand space; its x is overwritten each frame with the held weapon's length
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index ba3e4c35f..60194affd 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1570,7 +1570,8 @@ void Player_UpdateShieldCollider(PlayState* play, Player* this, ColliderQuad* co
     }
 }
 
-Vec3f D_80126080 = { 5000.0f, 400.0f, 0.0f };
+// LLM generated name (HIGH), was D_80126080: tip of the blade line in hand space; its x is overwritten each frame with the held weapon's length
+Vec3f sMeleeWeaponBladeTip = { 5000.0f, 400.0f, 0.0f };  // was D_80126080 [LLM:HIGH]
 Vec3f D_8012608C = { 5000.0f, -400.0f, 1000.0f };
 Vec3f D_80126098 = { 5000.0f, 1400.0f, -1000.0f };
 
@@ -1696,7 +1697,7 @@ void Player_DrawGetItem(PlayState* play, Player* this) {
 
 // Name from zeldaret/oot (was func_80090A28): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.99. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_player_lib.c]
 void Player_CalcMeleeWeaponTipPositions(Player* this, Vec3f* vecs) {
-    D_8012608C.x = D_80126080.x;
+    D_8012608C.x = sMeleeWeaponBladeTip.x;  // was D_80126080 [LLM:HIGH]
 
     if (this->unk_845 >= 3) {
         this->unk_845 += 1;
@@ -1706,7 +1707,7 @@ void Player_CalcMeleeWeaponTipPositions(Player* this, Vec3f* vecs) {
     D_8012608C.x += 1200.0f;
     D_80126098.x = D_8012608C.x;
 
-    Matrix_MultVec3f(&D_80126080, &vecs[0]);
+    Matrix_MultVec3f(&sMeleeWeaponBladeTip, &vecs[0]);  // was D_80126080 [LLM:HIGH]
     Matrix_MultVec3f(&D_8012608C, &vecs[1]);
     Matrix_MultVec3f(&D_80126098, &vecs[2]);
 }
@@ -1819,7 +1820,7 @@ void Player_PostLimbDrawGameplay(PlayState* play, s32 limbIndex, Gfx** dList, Ve
             OPEN_DISPS(play->state.gfxCtx);
 
             if (this->actor.scale.y >= 0.0f) {
-                D_80126080.x = this->unk_85C * 5000.0f;
+                sMeleeWeaponBladeTip.x = this->unk_85C * 5000.0f;  // was D_80126080 [LLM:HIGH]
                 Player_CalcMeleeWeaponTipPositions(this, sp124);
                 if (this->meleeWeaponState != 0) {
                     EffectBlureShip_ChangeType(Effect_GetByIndex(this->meleeWeaponEffectIndex), TRAIL_TYPE_STICK);
@@ -1841,9 +1842,9 @@ void Player_PostLimbDrawGameplay(PlayState* play, s32 limbIndex, Gfx** dList, Ve
             Vec3f spE4[3];
 
             if (Player_HoldsBrokenKnife(this)) {
-                D_80126080.x = 1500.0f;
+                sMeleeWeaponBladeTip.x = 1500.0f;  // was D_80126080 [LLM:HIGH]
             } else {
-                D_80126080.x = sMeleeWeaponLengths[Player_GetMeleeWeaponHeld(this)];
+                sMeleeWeaponBladeTip.x = sMeleeWeaponLengths[Player_GetMeleeWeaponHeld(this)];  // was D_80126080 [LLM:HIGH]
                 EffectBlureShip_ChangeType(Effect_GetByIndex(this->meleeWeaponEffectIndex),
                                            sSwordTypes[Player_GetMeleeWeaponHeld(this)]);
             }
-- 
