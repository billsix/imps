+void BgBdanSwitch_SetupHeavyDone(BgBdanSwitch* this);  // was func_8086DB24 [LLM:HIGH]
 void func_8086DB40(BgBdanSwitch* this, PlayState* play);
 void func_8086DB4C(BgBdanSwitch* this);
 void func_8086DB68(BgBdanSwitch* this, PlayState* play);
@@ -198,7 +199,7 @@ void BgBdanSwitch_Init(Actor* thisx, PlayState* play) {
             break;
         case YELLOW_HEAVY:
