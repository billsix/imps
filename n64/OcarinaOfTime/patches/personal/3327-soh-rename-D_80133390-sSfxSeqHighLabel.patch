From 7d55b34040d60b070f6b022ad3c875ed08dd5587 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:32 +0000
Subject: [PATCH 3327/3799] soh: rename D_80133390 -> sSfxSeqHighLabel

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the "SEQ H" label of the SFX debug display
Defined in soh/src/code/audio_sfx.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/variables.h  | 2 +-
 soh/src/code/audio_seq.c | 2 +-
 soh/src/code/audio_sfx.c | 3 ++-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/variables.h b/soh/include/variables.h
index 4d1263b1f..68ecec8b2 100644
--- a/soh/include/variables.h
+++ b/soh/include/variables.h
@@ -155,7 +155,7 @@ extern "C"
 	extern OcarinaNote sOcarinaSongNotes[OCARINA_SONG_MAX][20];
 	extern OcarinaSongButtons gOcarinaSongButtons[OCARINA_SONG_MAX];
 	extern SoundParams* gSoundParams[7];
-	extern char D_80133390[];
+	extern char sSfxSeqHighLabel[];  // was D_80133390 [LLM:HIGH]
 	extern char D_80133398[];
 	extern SoundBankEntry* gSoundBanks[7];
 	extern u8 gSfxChannelLayout;
diff --git a/soh/src/code/audio_seq.c b/soh/src/code/audio_seq.c
index f4f42bf21..4bc06840a 100644
--- a/soh/src/code/audio_seq.c
+++ b/soh/src/code/audio_seq.c
@@ -139,7 +139,7 @@ void Audio_ProcessSeqCmd(u32 cmd) {
     f32 freqScale;
 
     if (gAudioDebugPrintSeqCmd && (cmd & 0xF0000000) != 0x70000000) {
-        AudioDebug_ScrPrt((const s8*)D_80133390, (cmd >> 16) & 0xFFFF); // "SEQ H"
+        AudioDebug_ScrPrt((const s8*)sSfxSeqHighLabel, (cmd >> 16) & 0xFFFF); // "SEQ H", was D_80133390 [LLM:HIGH]
         AudioDebug_ScrPrt((const s8*)D_80133398, cmd & 0xFFFF);         // "    L"
     }
 
diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index 23dc025de..571a04e22 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -34,7 +34,8 @@ char sSfxDistOverPrintMsg[] = VT_COL(RED, WHITE) "<INAGAKI CHECK> dist over! fla
 s32 sSfxDebugPage = 0;  // was D_8013338C [LLM:GUESS]
 
 // rodata for Audio_ProcessSeqCmd (audio_seq.c, was code_800F9280.c)
-char D_80133390[] = "SEQ H";
+// LLM generated name (HIGH), was D_80133390: the "SEQ H" label of the SFX debug display
+char sSfxSeqHighLabel[] = "SEQ H";  // was D_80133390 [LLM:HIGH]
 char D_80133398[] = "    L";
 
 // LLM generated name (HIGH), was D_8016BAD0: gSoundBanks[0]; the doc comment above that array names entry 0 "Player Bank size 9", matching this array's length.
-- 
2.55.0

