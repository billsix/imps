From 0079717283dbc831c1b4e0a358b20c3fe7501060 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:43 +0000
Subject: [PATCH 0419/3799] soh: rename func_80AEB1B4 -> EnRu1_IsTextboxClosing

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 741f8c9ba..7dbb90cbf 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -346,7 +346,8 @@ s32 EnRu1_MessageShouldAdvance(PlayState* play) {
     return (Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT) && Message_ShouldAdvance(play);
 }
 
-s32 func_80AEB1B4(PlayState* play) {
+// Name from zeldaret/oot (was func_80AEB1B4): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_IsTextboxClosing(PlayState* play) {
     return Message_GetState(&play->msgCtx) == TEXT_STATE_CLOSING;
 }
 
@@ -2047,7 +2048,7 @@ void func_80AEF930(EnRu1* this, PlayState* play) {
 }
 
 void func_80AEF99C(EnRu1* this, PlayState* play) {
-    if (func_80AEB1B4(play) != 0) {
+    if (EnRu1_IsTextboxClosing(play) != 0) {
         func_80AEB0EC(this, 4);
         Actor_Kill(&this->actor);
     }
-- 
