     static Vec3f sBlureVertexA = { 0.0f, 400.0f, 1500.0f };  // was D_809B4E88 [LLM:HIGH]
     static Vec3f sBlureVertexB = { 0.0f, -400.0f, 1500.0f };  // was D_809B4E94 [LLM:HIGH]
