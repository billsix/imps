Subject: [PATCH 3182/3799] soh: rename D_8011D3EC -> sUnusedCameraFlag

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: an s32 beside sUpdateCameraDirection that nothing in the tree reads or writes
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera_data.inc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index ea6932ed3..f97ede9d4 100644
--- a/soh/src/code/z_camera_data.inc
+++ b/soh/src/code/z_camera_data.inc
@@ -2244,7 +2244,8 @@ s16 sAttentionPitchOffsets[] = {  // was D_8011D3CC [LLM:HIGH]
 };
 
 s32 sUpdateCameraDirection = 0;
-s32 D_8011D3EC = 0;
+// LLM generated name (GUESS), was D_8011D3EC: an s32 beside sUpdateCameraDirection that nothing in the tree reads or writes
+s32 sUnusedCameraFlag = 0;  // was D_8011D3EC [LLM:GUESS]
 static s32 D_8011D3F0 = 0;
 
 static s32 sDemo5PrevAction12Frame = -16;
