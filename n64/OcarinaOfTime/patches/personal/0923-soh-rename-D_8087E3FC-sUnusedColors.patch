From 2e42a2cf1692519a4d8bb4372731bfecdabb555a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:27:07 +0000
Subject: [PATCH 0923/3799] soh: rename D_8087E3FC -> sUnusedColors

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment directly above it reads "// Unused"; the five u32 words are RGBA colours (0xC8C800FF, 0xFF0000FF) and nothing reads them.
Defined in soh/src/overlays/actors/ovl_Bg_Haka_MeganeBG/z_bg_haka_meganebg.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Haka_MeganeBG/z_bg_haka_meganebg.c  | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Haka_MeganeBG/z_bg_haka_meganebg.c b/soh/src/overlays/actors/ovl_Bg_Haka_MeganeBG/z_bg_haka_meganebg.c
index 0091423b9..da6d439fc 100644
--- a/soh/src/overlays/actors/ovl_Bg_Haka_MeganeBG/z_bg_haka_meganebg.c
+++ b/soh/src/overlays/actors/ovl_Bg_Haka_MeganeBG/z_bg_haka_meganebg.c
@@ -43,7 +43,8 @@ static InitChainEntry sInitChain[] = {
 };
 
 // Unused
-static u32 D_8087E3FC[] = {
+// LLM generated name (HIGH), was D_8087E3FC: the in-tree comment directly above it reads "// Unused"; the five u32 words are RGBA colours (0xC8C800FF, 0xFF0000FF) and nothing reads them.
+static u32 sUnusedColors[] = {  // was D_8087E3FC [LLM:HIGH]
     0x00000000, 0x00000000, 0x00000000, 0xC8C800FF, 0xFF0000FF,
 };
 
