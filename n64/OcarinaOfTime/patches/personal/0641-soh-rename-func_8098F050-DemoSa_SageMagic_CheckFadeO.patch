Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 0.98.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 3e7e60022..3b3e06816 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -451,7 +451,8 @@ void DemoSa_SageMagic_Fade(DemoSa* this, PlayState* play) {
     this->actor.shape.shadowAlpha = this->alpha = (*unk_1A0 / (kREG(5) + 10.0f)) * 255.0f;
 }
 
-void func_8098F050(DemoSa* this, PlayState* play) {
+// Name from zeldaret/oot (was func_8098F050): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.98. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_SageMagic_CheckFadeOut(DemoSa* this, PlayState* play) {
     if (DemoSa_CheckForNoCue(this, play, 4, 4)) {
         this->action = 8;
         this->drawConfig = 2;
@@ -482,7 +483,7 @@ void func_8098F16C(DemoSa* this, PlayState* play) {
     DemoSa_UpdateBgCheckInfo(this, play);
     DemoSa_UpdateSkelAnime(this);
     DemoSa_SageMagic_LowerEyes(this);
-    func_8098F050(this, play);
+    DemoSa_SageMagic_CheckFadeOut(this, play);
     func_8098E554(this, play);
 }
 
