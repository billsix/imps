From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:32:04 +0000
Subject: [PATCH 1632/3799] soh: rename func_8096F224 -> DemoEc_SetupUpdate17

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loads the animation object, starts gDemoEcAnim_006930 and switches this Carpenter to update mode EC_UPDATE_17.
Defined in soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c b/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c
index a07577cb8..bc2cf4621 100644
--- a/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c
+++ b/soh/src/overlays/actors/ovl_Demo_Ec/z_demo_ec.c
@@ -809,7 +809,8 @@ void DemoEc_UpdateEyesAfterFrame32(DemoEc* this) {
     }
 }
 
-void func_8096F224(DemoEc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_8096F224: loads the animation object, starts gDemoEcAnim_006930 and switches this Carpenter to update mode EC_UPDATE_17.
+void DemoEc_SetupUpdate17(DemoEc* this, PlayState* play) {
     DemoEc_UseAnimationObject(this, play);
     DemoEc_ChangeAnimation(this, &gDemoEcAnim_006930, 2, -8.0f, false);
     this->updateMode = EC_UPDATE_17;
@@ -833,7 +834,7 @@ void func_8096F2B0(DemoEc* this, PlayState* play, s32 arg2) {
         if ((sp18 != this->npcAction)) {
             if (this->npcAction) {}
             if (sp18 == 2) {
-                func_8096F224(this, play);
+                DemoEc_SetupUpdate17(this, play);  // was func_8096F224 [LLM:HIGH]
             }
             this->npcAction = sp18;
         }
