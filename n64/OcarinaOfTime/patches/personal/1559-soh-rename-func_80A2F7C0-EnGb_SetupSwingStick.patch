From 1816cf13fb527f35711173c24bdfe84a90489dc4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:26:57 +0000
Subject: [PATCH 1559/3799] soh: rename func_80A2F7C0 -> EnGb_SetupSwingStick

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: starts the stick-swinging animation with its magic sfx and installs the swinging action.
Defined in soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c b/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
index 073296484..7457324f9 100644
--- a/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
+++ b/soh/src/overlays/actors/ovl_En_Gb/z_en_gb.c
@@ -268,7 +268,8 @@ s32 EnGb_AreSoulsStirring(EnGb* this) {
     return 0;
 }
 
-void func_80A2F7C0(EnGb* this) {
+// LLM generated name (HIGH), was func_80A2F7C0: starts the stick-swinging animation with its magic sfx and installs the swinging action.
+void EnGb_SetupSwingStick(EnGb* this) {
     Animation_Change(&this->skelAnime, &gPoeSellerSwingStickAnim, 1.0f, 0.0f,
                      Animation_GetLastFrame(&gPoeSellerSwingStickAnim), ANIMMODE_ONCE, 0.0f);
     Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_NALE_MAGIC);
@@ -282,7 +283,7 @@ void func_80A2F83C(EnGb* this, PlayState* play) {
         if (this->actionTimer != 0) {
             this->actionTimer--;
         } else {
-            func_80A2F7C0(this);
+            EnGb_SetupSwingStick(this);  // was func_80A2F7C0 [LLM:HIGH]
             return;
         }
     }
