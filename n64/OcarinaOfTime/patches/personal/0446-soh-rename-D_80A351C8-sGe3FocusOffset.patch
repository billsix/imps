From 48e1f03a06a1cbb5faea0e7fb3193a2a4e8a69a1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:38 +0000
Subject: [PATCH 446/488] soh: rename D_80A351C8 -> sGe3FocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same point in EnGe3_PostLimbDraw
Defined in soh/src/overlays/actors/ovl_En_Ge3/z_en_ge3.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Ge3/z_en_ge3.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ge3/z_en_ge3.c b/soh/src/overlays/actors/ovl_En_Ge3/z_en_ge3.c
index 356de4969..9dffc8ee1 100644
--- a/soh/src/overlays/actors/ovl_En_Ge3/z_en_ge3.c
+++ b/soh/src/overlays/actors/ovl_En_Ge3/z_en_ge3.c
@@ -271,10 +271,10 @@ s32 EnGe3_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* p
 
 void EnGe3_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
     EnGe3* this = (EnGe3*)thisx;
-    Vec3f D_80A351C8 = { 600.0f, 700.0f, 0.0f };
+    Vec3f sGe3FocusOffset = { 600.0f, 700.0f, 0.0f };  // was D_80A351C8 [LLM:HIGH]
 
     if (limbIndex == GELDB_LIMB_HEAD) {
-        Matrix_MultVec3f(&D_80A351C8, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sGe3FocusOffset, &this->actor.focus.pos);  // was D_80A351C8 [LLM:HIGH]
     }
 }
 
