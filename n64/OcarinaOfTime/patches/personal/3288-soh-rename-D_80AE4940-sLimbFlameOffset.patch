From abfc51d4cc8efe1bbbb7d83c42c1c89f9886c01c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:55 +0000
Subject: [PATCH 3288/3799] soh: rename D_80AE4940 -> sLimbFlameOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the limb-space point EnRd_PostLimbDraw transforms to place each burning limb's flame
Defined in soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c b/soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c
index 83eafcf86..808c8d042 100644
--- a/soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c
+++ b/soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c
@@ -122,7 +122,8 @@ static Color_RGBA8 sUnusedFreezePrimColor = { 200, 200, 255, 255 };  // was D_80
 // LLM generated name (GUESS), was D_80AE493C: the third of that unread group
 static Color_RGBA8 sUnusedFreezeEnvColor = { 0, 0, 255, 0 };  // was D_80AE493C [LLM:GUESS]
 
-static Vec3f D_80AE4940 = { 300.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80AE4940: the limb-space point EnRd_PostLimbDraw transforms to place each burning limb's flame
+static Vec3f sLimbFlameOffset = { 300.0f, 0.0f, 0.0f };  // was D_80AE4940 [LLM:HIGH]
 static Vec3f D_80AE494C = { 300.0f, 0.0f, 0.0f };
 static Vec3f D_80AE4958 = { 0.25f, 0.25f, 0.25f };
 
@@ -869,7 +870,7 @@ s32 EnRd_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 }
 
 void EnRd_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx, Gfx** gfx) {
-    Vec3f sp2C = D_80AE4940;
+    Vec3f sp2C = sLimbFlameOffset;  // was D_80AE4940 [LLM:HIGH]
     EnRd* this = (EnRd*)thisx;
     s32 idx = -1;
     Vec3f destPos;
-- 
