     }
 }
 
-s32 func_80ACC624(EnOwl* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80ACC624: true everywhere except the Desert Colossus outside the two cutscene frame windows where this owl is hidden
+s32 EnOwl_ShouldDrawInColossus(EnOwl* this, PlayState* play) {
     s32 switchFlag = (this->actor.params & 0xFC0) >> 6;
 
     if (play->sceneNum != SCENE_DESERT_COLOSSUS) {
@@ -1139,7 +1140,7 @@ void EnOwl_Update(Actor* thisx, PlayState* play) {
         return;
     }
 
