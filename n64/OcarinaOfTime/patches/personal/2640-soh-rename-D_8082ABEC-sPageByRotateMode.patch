From 562169f823eae3bd0b6b87cf9ed06a395bf26c83 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:39 +0000
Subject: [PATCH 2640/3799] soh: rename D_8082ABEC -> sPageByRotateMode

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the page each rotation mode lands on
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c      | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 8dcaa5dfb..b2b1254c8 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -949,7 +949,8 @@ static f32 sPageRotateEyeDz[] = {  // was D_8082ABCC [LLM:HIGH]
     -4.0f, -4.0f, -4.0f, 4.0f, 4.0f, 4.0f, 4.0f, -4.0f,
 };
 
-static u16 D_8082ABEC[] = {
+// LLM generated name (HIGH), was D_8082ABEC: the page each rotation mode lands on
+static u16 sPageByRotateMode[] = {  // was D_8082ABEC [LLM:HIGH]
     PAUSE_MAP, PAUSE_EQUIP, PAUSE_QUEST, PAUSE_ITEM, PAUSE_EQUIP, PAUSE_MAP, PAUSE_ITEM, PAUSE_QUEST,
 };
 
@@ -1284,7 +1285,7 @@ void KaleidoScope_SwitchPage(PauseContext* pauseCtx, u8 pt) {
     }
 
     if ((CVarGetInteger(CVAR_ENHANCEMENT("AssignableTunicsAndBoots"), 0) != 0) &&
-        (D_8082ABEC[pauseCtx->mode] == PAUSE_EQUIP)) {
+        (sPageByRotateMode[pauseCtx->mode] == PAUSE_EQUIP)) {  // was D_8082ABEC [LLM:HIGH]
         gSaveContext.buttonStatus[1] = BTN_ENABLED;
         gSaveContext.buttonStatus[2] = BTN_ENABLED;
         gSaveContext.buttonStatus[3] = BTN_ENABLED;
@@ -2561,7 +2562,7 @@ void KaleidoScope_RotatePageSlow(PlayState* play, Input* input) {
 
         if (pauseCtx->unk_1EA == 64) {
             pauseCtx->unk_1EA = 0;
-            pauseCtx->pageIndex = D_8082ABEC[pauseCtx->mode];
+            pauseCtx->pageIndex = sPageByRotateMode[pauseCtx->mode];  // was D_8082ABEC [LLM:HIGH]
             pauseCtx->unk_1E4 = 0;
         }
     }
@@ -3579,7 +3580,7 @@ void KaleidoScope_RotatePageFast(PlayState* play) {
             gSaveContext.buttonStatus[buttonIndex] = sButtonStatusByPage[pauseCtx->pageIndex][buttonIndex];  // was D_8082AB6C [LLM:HIGH]
         }
 
-        pauseCtx->pageIndex = D_8082ABEC[pauseCtx->mode];
+        pauseCtx->pageIndex = sPageByRotateMode[pauseCtx->mode];  // was D_8082ABEC [LLM:HIGH]
 
         if ((CVarGetInteger(CVAR_ENHANCEMENT("AssignableTunicsAndBoots"), 0) != 0) &&
             (pauseCtx->pageIndex == PAUSE_EQUIP)) {
@@ -3598,7 +3599,7 @@ void KaleidoScope_RotatePageFast(PlayState* play) {
         pauseCtx->alpha = 255;
         Interface_LoadActionLabelB(play, DO_ACTION_SAVE);
     } else if (pauseCtx->unk_1EA == 64) {
-        pauseCtx->pageIndex = D_8082ABEC[pauseCtx->mode];
+        pauseCtx->pageIndex = sPageByRotateMode[pauseCtx->mode];  // was D_8082ABEC [LLM:HIGH]
         pauseCtx->mode = (u16)(pauseCtx->pageIndex * 2) + 1;
     }
 }
