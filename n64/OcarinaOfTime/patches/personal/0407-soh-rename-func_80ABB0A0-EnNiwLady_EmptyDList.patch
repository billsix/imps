From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:41 +0000
Subject: [PATCH 407/784] soh: rename func_80ABB0A0 -> EnNiwLady_EmptyDList

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.91.
Defined in soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c.
---
 soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c b/soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c
index 42cb4c8bc..c133c09bd 100644
--- a/soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c
+++ b/soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c
@@ -554,7 +554,8 @@ void EnNiwLady_Update(Actor* thisx, PlayState* play) {
     }
 }
 
-Gfx* func_80ABB0A0(GraphicsContext* gfxCtx) {
+// Name from zeldaret/oot (was func_80ABB0A0): adopted upstream's name for this address; body verified to match upstream at 0.91. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c]
+Gfx* EnNiwLady_EmptyDList(GraphicsContext* gfxCtx) {
     Gfx* dList;
 
     dList = Graph_Alloc(gfxCtx, sizeof(Gfx));
@@ -592,7 +593,7 @@ void EnNiwLady_Draw(Actor* thisx, PlayState* play) {
         Gfx_SetupDL_25Opa(play->state.gfxCtx);
         gDPSetEnvColor(POLY_OPA_DISP++, 0, 0, 0, 255);
         gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(sEyeTextures[this->faceState]));
-        gSPSegment(POLY_OPA_DISP++, 0x0C, func_80ABB0A0(play->state.gfxCtx));
+        gSPSegment(POLY_OPA_DISP++, 0x0C, EnNiwLady_EmptyDList(play->state.gfxCtx));
         SkelAnime_DrawSkeletonOpa(play, &this->skelAnime, EnNiwLady_OverrideLimbDraw, NULL, this);
     }
     CLOSE_DISPS(play->state.gfxCtx);
