+// LLM generated name (HIGH), was D_8082AB2C: s16 table passed as the height argument of the same gDPLoadTextureBlock_4b call.
+s16 sCloudTexHeights[] = {  // was D_8082AB2C [LLM:HIGH]
     24, 72, 13, 22, 19, 20, 19, 27, 14, 26, 22, 21, 49, 32, 45, 60, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 16, 32, 8,
 };
 
@@ -2684,7 +2685,7 @@ static s16* D_8082B030[] = {
 };
 
 static s16* D_8082B048[] = {
-    D_8082AFC4, D_8082AFC8, D_8082AFCC, D_8082AFF0, D_8082AB2C, D_8082AFF4,
+    D_8082AFC4, D_8082AFC8, D_8082AFCC, D_8082AFF0, sCloudTexHeights, D_8082AFF4,  // was D_8082AB2C [LLM:HIGH]
 };
 
 static s16 D_8082B060[] = {
