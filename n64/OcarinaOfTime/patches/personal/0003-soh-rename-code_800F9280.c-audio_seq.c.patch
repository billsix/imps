 soh/src/code/{code_800F9280.c => audio_seq.c} | 0
 soh/src/code/code_800F7260.c                  | 2 +-
 3 files changed, 2 insertions(+), 2 deletions(-)
 rename soh/src/code/{code_800F9280.c => audio_seq.c} (100%)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 3fea838e1..aa9f04e45 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -7,7 +7,7 @@
