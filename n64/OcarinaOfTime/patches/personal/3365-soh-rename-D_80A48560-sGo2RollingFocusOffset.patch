From d1b4fcfda8d7f57804b9eedf0d74e86cecf2ada6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:00 +0000
Subject: [PATCH 3365/3799] soh: rename D_80A48560 -> sGo2RollingFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same for EnGo2_DrawRolling
Defined in soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
index c39a76f79..c9a5f97eb 100644
--- a/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
+++ b/soh/src/overlays/actors/ovl_En_Go2/z_en_go2.c
@@ -2046,7 +2046,7 @@ s32 EnGo2_DrawCurledUp(EnGo2* this, PlayState* play) {
 
 s32 EnGo2_DrawRolling(EnGo2* this, PlayState* play) {
     s32 pad;
-    Vec3f D_80A48560 = { 0.0f, 0.0f, 0.0f };
+    Vec3f sGo2RollingFocusOffset = { 0.0f, 0.0f, 0.0f };  // was D_80A48560 [LLM:HIGH]
     f32 speedXZ;
 
     OPEN_DISPS(play->state.gfxCtx);
@@ -2056,7 +2056,7 @@ s32 EnGo2_DrawRolling(EnGo2* this, PlayState* play) {
     gSPMatrix(POLY_OPA_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
     gSPDisplayList(POLY_OPA_DISP++, gGoronDL_00C140);
     CLOSE_DISPS(play->state.gfxCtx);
-    Matrix_MultVec3f(&D_80A48560, &this->actor.focus.pos);
+    Matrix_MultVec3f(&sGo2RollingFocusOffset, &this->actor.focus.pos);  // was D_80A48560 [LLM:HIGH]
     return 1;
 }
 
