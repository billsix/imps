From 4a9ee5dc981d46a8e9c306847cea43a195ea4c6b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:18 +0000
Subject: [PATCH 075/784] soh: rename D_801664D0 -> sGameStateSpeedMeter

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/game.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/game.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/game.c b/soh/src/code/game.c
index 5237a539b..9b706f15d 100644
--- a/soh/src/code/game.c
+++ b/soh/src/code/game.c
@@ -12,7 +12,8 @@ extern MessageTableEntry* sGerMessageEntryTablePtr;
 extern MessageTableEntry* sFraMessageEntryTablePtr;
 extern MessageTableEntry* sJpnMessageEntryTablePtr;
 
-SpeedMeter D_801664D0;
+// LLM generated name (HIGH), was D_801664D0: the GameState's SpeedMeter, Init/Draw/Destroy'd across the frame loop.
+SpeedMeter sGameStateSpeedMeter;
 VisCvg sVisCvg;
 VisZBuf sVisZBuf;
 VisMono sVisMono;
@@ -209,8 +210,8 @@ void GameState_Draw(GameState* gameState, GraphicsContext* gfxCtx) {
     func_80063D7C(gfxCtx);
 
     if (R_ENABLE_ARENA_DBG != 0) {
-        SpeedMeter_DrawTimeEntries(&D_801664D0, gfxCtx);
-        SpeedMeter_DrawAllocEntries(&D_801664D0, gfxCtx, gameState);
+        SpeedMeter_DrawTimeEntries(&sGameStateSpeedMeter, gfxCtx);
+        SpeedMeter_DrawAllocEntries(&sGameStateSpeedMeter, gfxCtx, gameState);
     }
 }
 
@@ -449,7 +450,7 @@ void GameState_Init(GameState* gameState, GameStateFunc init, GraphicsContext* g
     if (SREG(48) == 0) {
         ViMode_Init(&sViMode);
     }
-    SpeedMeter_Init(&D_801664D0);
+    SpeedMeter_Init(&sGameStateSpeedMeter);
     func_800AA0B4();
     osSendMesgPtr(&gameState->gfxCtx->queue, NULL, OS_MESG_BLOCK);
 
@@ -472,7 +473,7 @@ void GameState_Destroy(GameState* gameState) {
         gameState->destroy(gameState);
     }
     func_800AA0F0();
-    SpeedMeter_Destroy(&D_801664D0);
+    SpeedMeter_Destroy(&sGameStateSpeedMeter);
     VisCvg_Destroy(&sVisCvg);
     VisZBuf_Destroy(&sVisZBuf);
     VisMono_Destroy(&sVisMono);
