From 074118a18f26fac9bdf5529f7587dd42f67589ba Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:10:22 +0000
Subject: [PATCH 1320/3799] soh: rename func_8098393C ->
 DemoIk_Type1SetupHidden

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the type 1 cue-1 handler: puts the actor in action mode 0 with the invisible draw mode and no shadow.
Defined in soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c b/soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c
index 6a2ef521f..df2e7f58f 100644
--- a/soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c
+++ b/soh/src/overlays/actors/ovl_Demo_Ik/z_demo_ik.c
@@ -182,7 +182,8 @@ void DemoIk_Type1Init(DemoIk* this, PlayState* play) {
     Animation_Change(&this->skelAnime, animation, 1.0f, 0.0f, Animation_GetLastFrame(animation), ANIMMODE_ONCE, 0.0f);
 }
 
-void func_8098393C(DemoIk* this) {
+// LLM generated name (HIGH), was func_8098393C: the type 1 cue-1 handler: puts the actor in action mode 0 with the invisible draw mode and no shadow.
+void DemoIk_Type1SetupHidden(DemoIk* this) {
     this->actionMode = 0;
     this->drawMode = 0;
     this->actor.shape.shadowAlpha = 0;
@@ -214,7 +215,7 @@ void func_809839D0(DemoIk* this, PlayState* play) {
         if (nextCsAction != csAction) {
             switch (nextCsAction) {
                 case 1:
-                    func_8098393C(this);
+                    DemoIk_Type1SetupHidden(this);  // was func_8098393C [LLM:HIGH]
                     break;
                 case 2:
                     func_8098394C(this, play);
