Subject: [PATCH 502/784] soh: rename func_80AF6170 -> EnSa_CopyCueEndPos

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.81.
Defined in soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c.
---
 soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
index bcc7319e7..5c0db339a 100644
--- a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
+++ b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
@@ -487,7 +487,8 @@ void EnSa_CopyCueStartPos(CsCmdActorCue* csAction, Vec3f* dst) {
     dst->z = csAction->startPos.z;
 }
 
-void func_80AF6170(CsCmdActorCue* csAction, Vec3f* dst) {
+// Name from zeldaret/oot (was func_80AF6170): adopted upstream's name for this address; body verified to match upstream at 0.81. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Sa/z_en_sa.c]
+void EnSa_CopyCueEndPos(CsCmdActorCue* csAction, Vec3f* dst) {
     dst->x = csAction->endPos.x;
     dst->y = csAction->endPos.y;
     dst->z = csAction->endPos.z;
@@ -667,7 +668,7 @@ void func_80AF68E4(EnSa* this, PlayState* play) {
     csAction = play->csCtx.npcActions[1];
     if (csAction != NULL) {
         EnSa_CopyCueStartPos(csAction, &startPos);
-        func_80AF6170(csAction, &endPos);
+        EnSa_CopyCueEndPos(csAction, &endPos);
 
         if (this->unk_210 == 0) {
             this->actor.world.pos = startPos;
