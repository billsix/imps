From e977909eae6f81e0a2d7dc885df1a577a8d3f025 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:35:39 +0000
Subject: [PATCH 2578/3799] soh: rename D_80910638 -> sSwordTrailLength

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: counts recorded trail points; the trail is drawn only once it reaches four and resets when the sword is idle
Defined in soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
index b0861445d..e54910df8 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -90,11 +90,12 @@ static Vec3f sSwordTipTrail[4];  // was D_809105D8 [LLM:HIGH]
 // LLM generated name (HIGH), was D_80910608: the matching four-deep history of sword base positions
 static Vec3f sSwordBaseTrail[4];  // was D_80910608 [LLM:HIGH]
 
-static s8 D_80910638;
+// LLM generated name (HIGH), was D_80910638: counts recorded trail points; the trail is drawn only once it reaches four and resets when the sword is idle
+static s8 sSwordTrailLength;  // was D_80910638 [LLM:HIGH]
 
 #define BOSS_GANON2_SHIP_SAVESTATE_FIELDS(F) \
     F(sLightningSfxPos)                            \
-    F(D_80910638)                            \
+    F(sSwordTrailLength)                            \
     F(sZelda)                                \
     F(sNaviActor)                            \
     F(sSeed1)                                \
@@ -2502,7 +2503,7 @@ void BossGanon2_DrawSwordTrail(BossGanon2* this, PlayState* play) {
         sSwordTrailAlpha = 0xFF;  // was D_80907080 [LLM:HIGH]
     }
 
-    if (D_80910638 >= 4) {
+    if (sSwordTrailLength >= 4) {  // was D_80910638 [LLM:HIGH]
         gSPSegment(POLY_XLU_DISP++, 0x08,
                    Gfx_TwoTexScrollEx(play->state.gfxCtx, 0, 0, 0, 32, 32, 1, play->gameplayFrames * 18, 0, 32, 32, 0,
                                       0, 18, 0));
@@ -2918,14 +2919,14 @@ void BossGanon2_Draw(Actor* thisx, PlayState* play) {
             }
         }
 
-        D_80910638++;
+        sSwordTrailLength++;  // was D_80910638 [LLM:HIGH]
     } else {
         for (i = 0; i < 3; i++) {
             sSwordTipTrail[i] = this->unk_200;  // was D_809105D8 [LLM:HIGH]
             sSwordBaseTrail[i] = this->unk_20C;  // was D_80910608 [LLM:HIGH]
         }
 
-        D_80910638 = 0;
+        sSwordTrailLength = 0;  // was D_80910638 [LLM:HIGH]
     }
 
     CLOSE_DISPS(play->state.gfxCtx);
@@ -3208,7 +3209,7 @@ void BossGanon2_Reset(void) {
     sLightningSfxPos.x = 0;  // was D_8090EB20 [LLM:HIGH]
     sLightningSfxPos.y = 0;  // was D_8090EB20 [LLM:HIGH]
     sLightningSfxPos.z = 0;  // was D_8090EB20 [LLM:HIGH]
-    D_80910638 = 0;
+    sSwordTrailLength = 0;  // was D_80910638 [LLM:HIGH]
     sZelda = NULL;
     sNaviActor = NULL;  // was D_8090EB30 [LLM:HIGH]
     sSeed1 = 0;
