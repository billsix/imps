             if (D_809071EC[i] == 2) {
                 for (j = 0, phi_a1 = -0x180; j < 12; j++, phi_a1 += 0x40) {
-                    for (phi_v1 = -D_809071B4[j]; phi_v1 < D_809071B4[j]; phi_v1++) {
