From d7412063732747065e7a43eac1404a5ea1b20553 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:17:02 +0000
Subject: [PATCH 1404/3799] soh: rename func_80AADCD0 -> EnMm_UpdateTalking

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-frame talk driver Update calls after the action function: it opens the next textbox, feeds EnMm_UpdateTalkState while a conversation is running, and otherwise offers talk.
Defined in soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c b/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
index ec84bc0e8..ae195d37f 100644
--- a/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
+++ b/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
@@ -279,7 +279,8 @@ s32 EnMm_GetTextId(EnMm* this, PlayState* play) {
     return textId;
 }
 
-void func_80AADCD0(EnMm* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AADCD0: the per-frame talk driver Update calls after the action function: it opens the next textbox, feeds EnMm_UpdateTalkState while a conversation is running, and otherwise offers talk.
+void EnMm_UpdateTalking(EnMm* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
     f32 yawDiff;
     s16 sp26;
@@ -507,7 +508,7 @@ void EnMm_Update(Actor* thisx, PlayState* play) {
     EnMm* this = (EnMm*)thisx;
 
     this->actionFunc(this, play);
-    func_80AADCD0(this, play);
+    EnMm_UpdateTalking(this, play);  // was func_80AADCD0 [LLM:HIGH]
     Collider_UpdateCylinder(&this->actor, &this->collider);
     CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
 }
