+void Rumble_Update(PadMgr* a, s32 b) {
+    // TODO: Workaround for rumble being too long. Implement os thread functions.
+    // Game logic runs at 20hz but input thread runs at 60 hertz, so we call this 3 times
+    for (int i = 0; i < 3; i++) {
+        RumbleMgr_Update(&sRumbleMgr);
+        PadMgr_RumbleSet(a, sRumbleMgr.rumbleEnable);
+    }
+}
+
+// Name from zeldaret/oot src/code/z_rumble.c (was func_800A9F6C): writes the single override rumble slot (unk_10A-C). Source: https://github.com/zeldaret/oot/blob/main/src/code/z_rumble.c
+void Rumble_Override(f32 a, u8 b, u8 c, u8 d) {
+    s32 temp1;
+    s32 temp2;
+
+    if (1000000.0f < a) {
+        temp1 = 1000;
+    } else {
+        temp1 = sqrtf(a);
+    }
+
+    if ((temp1 < 1000) && (b != 0) && (d != 0)) {
+        temp2 = b - (temp1 * 255) / 1000;
+        if (temp2 > 0) {
+            sRumbleMgr.unk_10A = temp2;
+            sRumbleMgr.unk_10B = c;
+            sRumbleMgr.unk_10C = d;
+        }
+    }
+}
+
+void Rumble_Request(f32 a, u8 b, u8 c, u8 d) {
+    s32 temp1;
+    s32 temp2;
+    s32 i;
+
+    if (1000000.0f < a) {
+        temp1 = 1000;
+    } else {
+        temp1 = sqrtf(a);
+    }
+
+    if (temp1 < 1000 && b != 0 && d != 0) {
+        temp2 = b - (temp1 * 255) / 1000;
+
