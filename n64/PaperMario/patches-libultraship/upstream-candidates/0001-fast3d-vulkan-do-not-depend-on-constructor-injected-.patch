From c77499a7d3ea429e3d2e84981f3f6b6e89dd4613 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 22 Sep 2026 03:31:27 +0000
Subject: [PATCH] fast3d/vulkan: do not depend on constructor-injected Context
 objects
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

GfxRenderingAPIVK takes a console-variable store and a resource manager
in its constructor and uses them for CVAR lookups and shader templates,
but Fast3dWindow constructs the backend with the default arguments, so
both stay null. The first shader build and the first draw then dereference
them:

  Fast::BuildVulkanShader -> Ship::ResourceManager::LoadResource  SIGSEGV
  GfxRenderingAPIVK::DrawTriangles -> Ship::ConsoleVariable::GetInteger  SIGSEGV

Every Linux box where Vulkan_IsSupported() holds picks this backend by
default, so the game crashes on its first frame after extraction. Resolve
both through the Context on use — what the OpenGL backend already does —
when nothing was injected.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 include/fast/backends/gfx_vulkan.h |  1 +
 src/fast/backends/gfx_vulkan.cpp   | 25 ++++++++++++++++++++++---
 2 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/include/fast/backends/gfx_vulkan.h b/include/fast/backends/gfx_vulkan.h
index a9bf6f79..11bcaff4 100644
--- a/include/fast/backends/gfx_vulkan.h
+++ b/include/fast/backends/gfx_vulkan.h
@@ -271,6 +271,7 @@ class GfxRenderingAPIVK final : public GfxRenderingAPI {
 
     SDL_Window* mWindow = nullptr;
     std::shared_ptr<Ship::ConsoleVariable> mConsoleVariable;
+    Ship::ConsoleVariable* ConsoleVariables();
     VkInstance mInstance = VK_NULL_HANDLE;
     VkSurfaceKHR mSurface = VK_NULL_HANDLE;
     VkPhysicalDevice mPhysicalDevice = VK_NULL_HANDLE;
diff --git a/src/fast/backends/gfx_vulkan.cpp b/src/fast/backends/gfx_vulkan.cpp
index c6bf7ef7..9bfc6f66 100644
--- a/src/fast/backends/gfx_vulkan.cpp
+++ b/src/fast/backends/gfx_vulkan.cpp
@@ -26,6 +26,7 @@
 #include <SDL2/SDL.h>
 #include <SDL2/SDL_vulkan.h>
 #include <shaderc/shaderc.hpp>
+#include "ship/Context.h"
 #include <spdlog/spdlog.h>
 #include <prism/processor.h>
 
@@ -49,12 +50,30 @@ namespace Fast {
 
 static std::shared_ptr<Ship::ResourceManager> sVKResourceManager;
 
+// Fast3dWindow constructs this backend with the default (null) arguments, so the injected
+// resource manager and console-variable store are normally absent. Resolve both through the
+// Context on use (what the OpenGL backend does directly) instead of dereferencing null on the
+// first shader build / first draw.
+static Ship::ResourceManager* VKResourceManager() {
+    if (sVKResourceManager != nullptr) {
+        return sVKResourceManager.get();
+    }
+    return Ship::Context::GetRawInstance()->GetResourceManager().get();
+}
+
 GfxRenderingAPIVK::GfxRenderingAPIVK(std::shared_ptr<Ship::ConsoleVariable> consoleVariable,
                                      std::shared_ptr<Ship::ResourceManager> resourceManager)
     : mConsoleVariable(std::move(consoleVariable)) {
     sVKResourceManager = std::move(resourceManager);
 }
 
+Ship::ConsoleVariable* GfxRenderingAPIVK::ConsoleVariables() {
+    if (mConsoleVariable != nullptr) {
+        return mConsoleVariable.get();
+    }
+    return Ship::Context::GetRawInstance()->GetConsoleVariables().get();
+}
+
 // MARK: - Shader generation (prism -> Vulkan GLSL -> SPIR-V via shaderc)
 
 #define VK_RAND_NOISE \
@@ -198,7 +217,7 @@ static std::optional<std::string> vulkan_include_fs(const std::string& path) {
     init->Type = (uint32_t)Ship::ResourceType::Shader;
     init->ByteOrder = Ship::Endianness::Native;
     init->Format = RESOURCE_FORMAT_BINARY;
-    auto res = std::static_pointer_cast<Ship::Shader>(sVKResourceManager->LoadResource(path, false, init));
+    auto res = std::static_pointer_cast<Ship::Shader>(VKResourceManager()->LoadResource(path, false, init));
     if (res == nullptr) {
         return std::nullopt;
     }
@@ -281,7 +300,7 @@ static std::string BuildVulkanShader(const CCFeatures& cc_features, bool vertex,
         path = std::string(shaderName) + ".glsl";
     }
 
-    auto res = std::static_pointer_cast<Ship::Shader>(sVKResourceManager->LoadResource(path, false, init));
+    auto res = std::static_pointer_cast<Ship::Shader>(VKResourceManager()->LoadResource(path, false, init));
     if (res == nullptr) {
         SPDLOG_ERROR("Failed to load the Vulkan shader template, missing shaders/vulkan in the o2r?");
         abort();
@@ -1648,7 +1667,7 @@ void GfxRenderingAPIVK::DrawTriangles(float buf_vbo[], size_t buf_vbo_len, size_
     if (mCurrentZmodeDecal && !mCurrentStrictDecal) {
         const int n64modeFactor = 120;
         const int noVanishFactor = 100;
-        switch (mConsoleVariable->GetInteger(CVAR_Z_FIGHTING_MODE, 0)) {
+        switch (ConsoleVariables()->GetInteger(CVAR_Z_FIGHTING_MODE, 0)) {
             case 1:
                 bias = -1.0f * (float)mRenderTargetHeight / n64modeFactor;
                 break;

