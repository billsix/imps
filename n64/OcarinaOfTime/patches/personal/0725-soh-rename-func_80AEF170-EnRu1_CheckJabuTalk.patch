Subject: [PATCH 0725/3799] soh: rename func_80AEF170 -> EnRu1_CheckJabuTalk

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 11c8043c1..de055ca0f 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1982,7 +1982,8 @@ s32 EnRu1_BecomingCarrier(EnRu1* this, PlayState* play) {
     return false;
 }
 
-void func_80AEF170(EnRu1* this, PlayState* play, s32 cond) {
+// Name from zeldaret/oot (was func_80AEF170): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_CheckJabuTalk(EnRu1* this, PlayState* play, s32 cond) {
     if (cond) {
         this->action = 25;
     }
@@ -2030,7 +2031,7 @@ void EnRu1_SpeakableJabu_Idle(EnRu1* this, PlayState* play) {
     EnRu1_UpdateBgCheckInfo(this, play);
     cond = EnRu1_TalkOfferAccepted(this, play);
     func_80AED624(this, play);
-    func_80AEF170(this, play, cond);
+    EnRu1_CheckJabuTalk(this, play, cond);
 }
 
 void EnRu1_SpeakableJabu_Talking(EnRu1* this, PlayState* play) {
