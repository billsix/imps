From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:30:41 +0000
Subject: [PATCH 1609/3799] soh: rename func_80AACC04 -> EnMk_Mixing

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: holds the working animation for the mixing delay, then moves to the turn-back stage.
Defined in soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
index 62b7dc564..eb7dab8c1 100644
--- a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
+++ b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
@@ -131,7 +131,8 @@ void func_80AACBAC(EnMk* this, PlayState* play) {
     }
 }
 
-void func_80AACC04(EnMk* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AACC04: holds the working animation for the mixing delay, then moves to the turn-back stage.
+void EnMk_Mixing(EnMk* this, PlayState* play) {
     if (this->timer > 0) {
         this->timer--;
     } else {
@@ -150,7 +151,7 @@ void EnMk_TurnAway(EnMk* this, PlayState* play) {
         this->actor.shape.rot.y += 0x800;
     } else {
         this->timer = GameInteractor_Should(VB_PLAY_EYEDROP_CREATION_ANIM, true, this) ? 120 : 0;
-        this->actionFunc = func_80AACC04;
+        this->actionFunc = EnMk_Mixing;  // was func_80AACC04 [LLM:HIGH]
         Animation_Change(&this->skelAnime, &object_mk_Anim_000724, 1.0f, 0.0f,
                          Animation_GetLastFrame(&object_mk_Anim_000724), ANIMMODE_LOOP, -4.0f);
         this->flags &= ~2;
