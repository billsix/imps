From 6551954850620b728d29ec9eb7ae6e3f3031936c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:46 +0000
Subject: [PATCH 2928/3799] soh: rename func_80B400AC -> EnXc_KillOnCue9

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: kills the actor once cue 4 reaches action 9
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index f4dc716ab..8dfdd61e7 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -1755,7 +1755,8 @@ void EnXc_SetupShowTriforceIdleAction(EnXc* this, s32 animFinished) {
         this->action = SHEIK_ACTION_SHOW_TRIFORCE_IDLE;
     }
 }
-void func_80B400AC(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B400AC: kills the actor once cue 4 reaches action 9
+void EnXc_KillOnCue9(EnXc* this, PlayState* play) {
     if (EnXc_CompareCsAction(this, play, 9, 4)) {
         Actor_Kill(&this->actor);
     }
@@ -1789,7 +1790,7 @@ void EnXc_ShowTriforceIdle(EnXc* this, PlayState* play) {
     EnXc_BgCheck(this, play);
     EnXc_SetEyePattern(this);
     EnXc_CalcTriforce(&this->actor, play);
-    func_80B400AC(this, play);
+    EnXc_KillOnCue9(this, play);  // was func_80B400AC [LLM:HIGH]
 }
 
 s32 EnXc_TriforceOverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s* rot, void* thisx) {
