From 7864da3ab5d3f0dfe0bcf1ad2ce82be7c41f158f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:10 +0000
Subject: [PATCH 0940/3799] soh: rename D_80898794 -> sScales

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: f32 table indexed by actor.params and handed to Actor_SetScale.
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c         | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c b/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c
index cfe9f115b..061999a10 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c
@@ -70,7 +70,8 @@ static InitChainEntry sInitChain[] = {
     ICHAIN_F32(uncullZoneDownward, 1000, ICHAIN_STOP),
 };
 
-static f32 D_80898794[] = { 0.13f, 0.1f, 0.1f };
+// LLM generated name (HIGH), was D_80898794: f32 table indexed by actor.params and handed to Actor_SetScale.
+static f32 sScales[] = { 0.13f, 0.1f, 0.1f };  // was D_80898794 [LLM:HIGH]
 
 static Vec3f D_808987A0[] = { 0.0f, 14.0f, 0.0f };
 
@@ -121,7 +122,7 @@ void BgJyaHaheniron_Init(Actor* thisx, PlayState* play) {
     BgJyaHaheniron* this = (BgJyaHaheniron*)thisx;
 
     Actor_ProcessInitChain(&this->actor, sInitChain);
-    Actor_SetScale(&this->actor, D_80898794[this->actor.params]);
+    Actor_SetScale(&this->actor, sScales[this->actor.params]);  // was D_80898794 [LLM:HIGH]
     if (this->actor.params == 0) {
         BgJyaHaheniron_ColliderInit(this, play);
         this->actor.shape.rot.z = (Rand_ZeroOne() * 65535.0f);
