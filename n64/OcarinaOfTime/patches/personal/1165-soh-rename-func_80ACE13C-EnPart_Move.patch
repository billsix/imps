Subject: [PATCH 1165/3799] soh: rename func_80ACE13C -> EnPart_Move

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sActionFuncs[1]: the flight state, running the bg check for the grounded variants and spawning the per-params despawn effect when the lifetime expires.
Defined in soh/src/overlays/actors/ovl_En_Part/z_en_part.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Part/z_en_part.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Part/z_en_part.c b/soh/src/overlays/actors/ovl_En_Part/z_en_part.c
index 1fb77b4b3..148be172c 100644
--- a/soh/src/overlays/actors/ovl_En_Part/z_en_part.c
+++ b/soh/src/overlays/actors/ovl_En_Part/z_en_part.c
@@ -100,7 +100,8 @@ void EnPart_SetupMotion(EnPart* this, PlayState* play) {
     }
 }
 
-void func_80ACE13C(EnPart* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80ACE13C: sActionFuncs[1]: the flight state, running the bg check for the grounded variants and spawning the per-params despawn effect when the lifetime expires.
+void EnPart_Move(EnPart* this, PlayState* play) {
     s32 i;
     Vec3f pos;
     Vec3f velocity = { 0.0f, 0.0f, 0.0f };
@@ -241,7 +242,7 @@ void func_80ACE7E8(EnPart* this, PlayState* play) {
 
 void EnPart_Update(Actor* thisx, PlayState* play) {
     static EnPartActionFunc sActionFuncs[] = {
-        EnPart_SetupMotion, func_80ACE13C, func_80ACE5B8, func_80ACE5C8, func_80ACE7E8,  // was func_80ACDDE8 [LLM:HIGH]
+        EnPart_SetupMotion, EnPart_Move, func_80ACE5B8, func_80ACE5C8, func_80ACE7E8,  // was func_80ACDDE8 [LLM:HIGH]
     };
 
     EnPart* this = (EnPart*)thisx;
