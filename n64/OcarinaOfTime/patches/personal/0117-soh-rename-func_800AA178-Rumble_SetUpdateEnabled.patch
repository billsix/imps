From f8915b67f6f724e82e3245f3590261e9362fb3d3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:53 +0000
Subject: [PATCH 117/225] soh: rename func_800AA178 -> Rumble_SetUpdateEnabled

Name source: zeldaret/oot.
Defined in soh/src/code/z_rumble.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_play.c   | 4 ++--
 soh/src/code/z_rumble.c | 3 ++-
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 1823c04e9..d894182dd 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1390,7 +1390,7 @@ void Rumble_Destroy(void);  // was func_800AA0F0 [oot]
 u32 Rumble_Controller1HasRumblePak();  // was func_800AA148 [oot]
 void Rumble_Reset();  // was func_800AA15C [oot]
 void Rumble_ClearRequests();
-void func_800AA178(u32);
+void Rumble_SetUpdateEnabled(u32);  // was func_800AA178 [oot]
 View* View_New(GraphicsContext* gfxCtx);
 void View_Free(View* view);
 void View_Init(View*, GraphicsContext*);
diff --git a/soh/src/code/z_play.c b/soh/src/code/z_play.c
index c13d6dcbf..55e947eff 100644
--- a/soh/src/code/z_play.c
+++ b/soh/src/code/z_play.c
@@ -1127,7 +1127,7 @@ void Play_Update(PlayState* play) {
                 PLAY_LOG(3580);
 
                 play->gameplayFrames++;
-                func_800AA178(true);
+                Rumble_SetUpdateEnabled(true);
 
                 // Gameplay stat tracking
                 if (!gSaveContext.ship.stats.gameComplete &&
@@ -1187,7 +1187,7 @@ void Play_Update(PlayState* play) {
                     PLAY_LOG(3662);
                 }
             } else {
-                func_800AA178(false);
+                Rumble_SetUpdateEnabled(false);
             }
 
             PLAY_LOG(3672);
diff --git a/soh/src/code/z_rumble.c b/soh/src/code/z_rumble.c
index 589792b5c..6b7a6f334 100644
--- a/soh/src/code/z_rumble.c
+++ b/soh/src/code/z_rumble.c
@@ -95,6 +95,7 @@ void Rumble_ClearRequests(void) {
     sRumbleMgr.unk_104 = 0;
 }
 
-void func_800AA178(u32 a) {
+// Name from zeldaret/oot src/code/z_rumble.c (was func_800AA178): toggles the manager's enabled flag (unk_105). Source: https://github.com/zeldaret/oot/blob/main/src/code/z_rumble.c
+void Rumble_SetUpdateEnabled(u32 a) {
     sRumbleMgr.unk_105 = !!a;
 }
