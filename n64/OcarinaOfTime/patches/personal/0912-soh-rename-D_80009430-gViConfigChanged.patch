From 550872416b31c7d89d90a99d57ffaaceb301c6d6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:22:00 +0000
Subject: [PATCH 0912/3799] soh: rename D_80009430 -> gViConfigChanged

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: s8 set to 1 at boot right after osViSetMode and again in Graph_Update whenever gViConfigAdditionalScanLines or gViConfigYScale change; nothing in this tree reads it, so "changed flag" is inferred from the write sites.
Defined in soh/src/boot/idle.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/variables.h | 2 +-
 soh/src/boot/idle.c     | 5 +++--
 soh/src/code/game.c     | 2 +-
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/variables.h b/soh/include/variables.h
index a217d17ff..c2f63580c 100644
--- a/soh/include/variables.h
+++ b/soh/include/variables.h
@@ -17,7 +17,7 @@ extern "C"
 
 	extern u8 D_80009320[];
 	extern u8 D_800093F0[];
-	extern s8 D_80009430;
+	extern s8 gViConfigChanged;  // was D_80009430 [LLM:GUESS]
 	extern u32 gDmaMgrVerbose;  // was D_80009460 [oot]
 	extern u32 gDmaMgrDmaBuffSize;
 	extern vu8 gViConfigUseDefault;
diff --git a/soh/src/boot/idle.c b/soh/src/boot/idle.c
index 2273bda4d..649961300 100644
--- a/soh/src/boot/idle.c
+++ b/soh/src/boot/idle.c
@@ -10,7 +10,8 @@ OSViMode gViConfigMode;
 // LLM generated name (GUESS), was D_80013960: u8 set from osTvType at boot (2 NTSC, 0x1E MPAL, 0x2C PAL) and passed to Sched_Init as arg3, which that function ignores; named for where it goes because what the value means is unrecoverable from this tree.
 u8 gSchedTvTypeParam;  // was D_80013960 [LLM:GUESS]
 
-s8 D_80009430 = 1;
+// LLM generated name (GUESS), was D_80009430: s8 set to 1 at boot right after osViSetMode and again in Graph_Update whenever gViConfigAdditionalScanLines or gViConfigYScale change; nothing in this tree reads it, so "changed flag" is inferred from the write sites.
+s8 gViConfigChanged = 1;  // was D_80009430 [LLM:GUESS]
 vu8 gViConfigUseDefault = 1;
 u8 gViConfigAdditionalScanLines = 0;
 u32 gViConfigFeatures = OS_VI_DITHER_FILTER_ON | OS_VI_GAMMA_OFF;
@@ -75,7 +76,7 @@ void Idle_ThreadEntry(void* arg) {
             break;
     }
 
-    D_80009430 = 1;
+    gViConfigChanged = 1;  // was D_80009430 [LLM:GUESS]
     osViSetMode(&gViConfigMode);
     ViConfig_UpdateVi(1);
     osViBlack(1);
diff --git a/soh/src/code/game.c b/soh/src/code/game.c
index 529377567..5133742ec 100644
--- a/soh/src/code/game.c
+++ b/soh/src/code/game.c
@@ -337,7 +337,7 @@ void GameState_Update(GameState* gameState) {
             HREG(84) = HREG(81);
             gViConfigAdditionalScanLines = HREG(82);
             gViConfigYScale = HREG(81) == 0 ? 240.0f / (gViConfigAdditionalScanLines + 240.0f) : 1.0f;
-            D_80009430 = 1;
+            gViConfigChanged = 1;  // was D_80009430 [LLM:GUESS]
         }
     }
 
-- 
2.55.0

