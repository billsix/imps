From 0a2ae44b0d1163218fdce9085c39529ed00e8c0c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:38 +0000
Subject: [PATCH 2629/3799] soh: rename func_808265BC ->
 KaleidoScope_RotatePageFast

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the ZREG-scaled twin of KaleidoScope_RotatePageSlow, which also restores the B button item and reloads the button status for the new page
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 896f110a6..554919585 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -3554,7 +3554,8 @@ uint32_t _bswap32(uint32_t a) {
     return a;
 }
 
-void func_808265BC(PlayState* play) {
+// LLM generated name (HIGH), was func_808265BC: the ZREG-scaled twin of KaleidoScope_RotatePageSlow, which also restores the B button item and reloads the button status for the new page
+void KaleidoScope_RotatePageFast(PlayState* play) {
     PauseContext* pauseCtx = &play->pauseCtx;
 
     pauseCtx->eye.x += D_8082ABAC[pauseCtx->mode] * ZREG(46);
@@ -4250,12 +4251,12 @@ void KaleidoScope_Update(PlayState* play) {
                 pauseCtx->state = 5;
             }
 
-            func_808265BC(play);
+            KaleidoScope_RotatePageFast(play);  // was func_808265BC [LLM:HIGH]
             break;
 
         case 5:
             pauseCtx->alpha += (u16)(255 / (WREG(6) + WREG(4)));
-            func_808265BC(play);
+            KaleidoScope_RotatePageFast(play);  // was func_808265BC [LLM:HIGH]
             if (pauseCtx->state == 6) {
                 KaleidoScope_UpdateNamePanel(play);
             }
