From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:40 +0000
Subject: [PATCH 2871/3799] soh: rename func_80B3C888 ->
 EnXc_IdleWhenNoCutscene

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: drops the type 4 Sheik into that idle once no cutscene is running
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 6d1b40619..f84479e6c 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -240,7 +240,8 @@ void EnXc_SetupIdleAction53(EnXc* this) {
     this->action = SHEIK_ACTION_53;
 }
 
-void func_80B3C888(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B3C888: drops the type 4 Sheik into that idle once no cutscene is running
+void EnXc_IdleWhenNoCutscene(EnXc* this, PlayState* play) {
     if (EnXc_NoCutscenePlaying(play) && this->actor.params == SHEIK_TYPE_4) {
         EnXc_SetupIdleAction53(this);  // was func_80B3C820 [LLM:HIGH]
     }
@@ -1713,7 +1714,7 @@ void EnXc_ActionFunc54(EnXc* this, PlayState* play) {
     EnXc_BgCheck(this, play);
     EnXc_SetEyePattern(this);
     EnXc_SetupShowTriforceAction(this, play);
-    func_80B3C888(this, play);
+    EnXc_IdleWhenNoCutscene(this, play);  // was func_80B3C888 [LLM:HIGH]
 }
 
 void EnXc_ShowTriforce(EnXc* this, PlayState* play) {
@@ -1724,7 +1725,7 @@ void EnXc_ShowTriforce(EnXc* this, PlayState* play) {
     EnXc_CalcTriforce(&this->actor, play);
     func_80B3FAE0(this);
     EnXc_SetupShowTriforceIdleAction(this, animFinished);
-    func_80B3C888(this, play);
+    EnXc_IdleWhenNoCutscene(this, play);  // was func_80B3C888 [LLM:HIGH]
 }
 
 void EnXc_ShowTriforceIdle(EnXc* this, PlayState* play) {
