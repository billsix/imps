From cd1d45af92664a5cb745b7b6efa9c830ed41dc27 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:38 +0000
Subject: [PATCH 454/488] soh: rename D_80AAD64C -> sMkFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point EnMk_PostLimbDraw records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
index 5245cea1d..bfcffa69e 100644
--- a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
+++ b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
@@ -374,11 +374,11 @@ s32 EnMk_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 }
 
 void EnMk_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
-    static Vec3f D_80AAD64C = { 1000.0f, -100.0f, 0.0f };
+    static Vec3f sMkFocusOffset = { 1000.0f, -100.0f, 0.0f };  // was D_80AAD64C [LLM:HIGH]
     EnMk* this = (EnMk*)thisx;
 
     if (limbIndex == 11) {
-        Matrix_MultVec3f(&D_80AAD64C, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sMkFocusOffset, &this->actor.focus.pos);  // was D_80AAD64C [LLM:HIGH]
     }
 }
 
