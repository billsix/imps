From 3aa214b8ea47a71186eaad7e0d38931b4bd40e01 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:32 +0000
Subject: [PATCH 0187/3799] soh: rename D_80A65F38 -> sColChkInfoInit

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c b/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c
index 0ac346f8d..4a0991bca 100644
--- a/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c
+++ b/soh/src/overlays/actors/ovl_En_Horse/z_en_horse.c
@@ -148,7 +148,8 @@ static ColliderJntSphInit sJntSphInit = {
     sJntSphItemsInit,
 };
 
-static CollisionCheckInfoInit D_80A65F38 = { 10, 35, 100, MASS_HEAVY };
+// LLM generated name (HIGH), was D_80A65F38: collision-check info init (health/mass) passed to CollisionCheck_SetInfo.
+static CollisionCheckInfoInit sColChkInfoInit = { 10, 35, 100, MASS_HEAVY };
 
 typedef struct {
     s16 scene;
@@ -826,7 +827,7 @@ void EnHorse_Init(Actor* thisx, PlayState* play2) {
     Collider_SetCylinder(play, &this->cyl2, &this->actor, &sCylinderInit2);
     Collider_InitJntSph(play, &this->jntSph);
     Collider_SetJntSph(play, &this->jntSph, &this->actor, &sJntSphInit, &this->jntSphList);
-    CollisionCheck_SetInfo(&this->actor.colChkInfo, DamageTable_Get(0xB), &D_80A65F38);
+    CollisionCheck_SetInfo(&this->actor.colChkInfo, DamageTable_Get(0xB), &sColChkInfoInit);
     this->actor.focus.pos = this->actor.world.pos;
     this->actor.focus.pos.y += 70.0f;
     this->playerControlled = false;
