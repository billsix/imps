From b04d5fc69601d63263429e58fd67acfeb1e583e6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:36 +0000
Subject: [PATCH 422/488] soh: rename D_80A41BCC -> sGoHeadFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point EnGo_PostLimbDraw records the focus position from; named Go because sHeadFocusOffset is taken by Demo_Im
Defined in soh/src/overlays/actors/ovl_En_Go/z_en_go.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Go/z_en_go.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Go/z_en_go.c b/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
index 98b0159c8..4ecd47e36 100644
--- a/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
+++ b/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
@@ -1127,10 +1127,10 @@ s32 EnGo_OverrideLimbDraw(PlayState* play, s32 limb, Gfx** dList, Vec3f* pos, Ve
 
 void EnGo_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
     EnGo* this = (EnGo*)thisx;
-    Vec3f D_80A41BCC = { 600.0f, 0.0f, 0.0f };
+    Vec3f sGoHeadFocusOffset = { 600.0f, 0.0f, 0.0f };  // was D_80A41BCC [LLM:HIGH]
 
     if (limbIndex == 17) {
-        Matrix_MultVec3f(&D_80A41BCC, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sGoHeadFocusOffset, &this->actor.focus.pos);  // was D_80A41BCC [LLM:HIGH]
     }
 }
 
