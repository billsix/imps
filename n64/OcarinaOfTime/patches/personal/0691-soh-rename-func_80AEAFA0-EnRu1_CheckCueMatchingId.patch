From 821f8e57f82a8392042cfbc16244d5836112f8f7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:31 +0000
Subject: [PATCH 691/784] soh: rename func_80AEAFA0 -> EnRu1_CheckCueMatchingId

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index c9cec2968..5b2811120 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -301,7 +301,8 @@ CsCmdActorCue* EnRu1_GetCue(PlayState* play, s32 npcActionIdx) {
     return ret;
 }
 
-s32 func_80AEAFA0(PlayState* play, u16 action, s32 npcActionIdx) {
+// Name from zeldaret/oot (was func_80AEAFA0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_CheckCueMatchingId(PlayState* play, u16 action, s32 npcActionIdx) {
     CsCmdActorCue* csCmdNPCAction = EnRu1_GetCue(play, npcActionIdx);
 
     if ((csCmdNPCAction != NULL) && (csCmdNPCAction->action == action)) {
@@ -465,7 +466,7 @@ CsCmdActorCue* EnRu1_GetFountainCue(PlayState* play) {
 }
 
 s32 func_80AEB458(PlayState* play, u16 action) {
-    return func_80AEAFA0(play, action, 3);
+    return EnRu1_CheckCueMatchingId(play, action, 3);
 }
 
 s32 func_80AEB480(PlayState* play, u16 action) {
@@ -917,7 +918,7 @@ void EnRu1_PlayFallingSfx(EnRu1* this) {
 
 // Name from zeldaret/oot (was func_80AEC6E4): adopted upstream's name for this address; body verified to match upstream at 0.87. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
 void EnRu1_RespondToFalling(EnRu1* this, PlayState* play) {
-    if ((func_80AEAFA0(play, 4, 3)) && (this->isFalling == 0)) {
+    if ((EnRu1_CheckCueMatchingId(play, 4, 3)) && (this->isFalling == 0)) {
         Animation_Change(&this->skelAnime, &gRutoChildBringArmsUpAnim, 1.0f, 0,
                          Animation_GetLastFrame(&gRutoChildBringArmsUpAnim), ANIMMODE_ONCE, -8.0f);
         this->isFalling = 1;
@@ -963,7 +964,7 @@ void func_80AEC81C(EnRu1* this, PlayState* play) {
 
 // Name from zeldaret/oot (was func_80AEC8B8): adopted upstream's name for this address; body verified to match upstream at 0.83. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
 void EnRu1_CheckTurnAround(EnRu1* this, PlayState* play) {
-    if (func_80AEAFA0(play, 3, 3)) {
+    if (EnRu1_CheckCueMatchingId(play, 3, 3)) {
         Animation_Change(&this->skelAnime, &gRutoChildTurnAroundAnim, 1.0f, 0,
                          Animation_GetLastFrame(&gRutoChildTurnAroundAnim), ANIMMODE_ONCE, -8.0f);
         this->action = 10;
@@ -1001,7 +1002,7 @@ void EnRu1_CheckStartFalling(EnRu1* this) {
 }
 
 void func_80AECA44(EnRu1* this, PlayState* play) {
-    if (func_80AEAFA0(play, 5, 3)) {
+    if (EnRu1_CheckCueMatchingId(play, 5, 3)) {
         Flags_SetInfTable(INFTABLE_RUTO_IN_JJ_MEET_RUTO);
         this->action = 14;
     }
