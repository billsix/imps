From 1e24781b57a067ae1054113504a76da3077d380d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:48:26 +0000
Subject: [PATCH 1846/3799] soh: rename func_80AEADE0 -> EnRu1_GetType

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns the high byte of params, which selects which Ruto this actor is.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index f7d737ce4..a4cf16c5e 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -242,7 +242,8 @@ void EnRu1_DisableSittingOC(EnRu1* this) {
     this->isSittingOCActive = 0;
 }
 
-u8 func_80AEADE0(EnRu1* this) {
+// LLM generated name (HIGH), was func_80AEADE0: returns the high byte of params, which selects which Ruto this actor is.
+u8 EnRu1_GetType(EnRu1* this) {
     u8 params = this->actor.params >> 8;
 
     return params;
@@ -2184,7 +2185,7 @@ void EnRu1_EndRetrievalCutscene(EnRu1* this, PlayState* play) {
     if ((gSaveContext.sceneLayer < 4) && (EnRu1_IsCsStateIdle(play))) {
         curRoomNum = play->roomCtx.curRoom.num;
         Flags_SetInfTable(INFTABLE_145);
-        Flags_SetSwitch(play, func_80AEADE0(this));
+        Flags_SetSwitch(play, EnRu1_GetType(this));  // was func_80AEADE0 [LLM:HIGH]
         EnRu1_SetPlatformCamSetting(this, 1);
         this->action = 42;
         this->actor.room = curRoomNum;
-- 
