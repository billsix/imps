From 5c997e636c72891bbcf89e3aa49604e029626c8a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:47 +0000
Subject: [PATCH 0842/3799] soh: rename D_80AD8D24 -> sAlreadySpawned

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c.
---
 soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c b/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c
index ea2777f5d..422730bea 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c
@@ -71,7 +71,8 @@ static ColliderCylinderInit sCylinderInit = {
     { 30, 52, 0, { 0, 0, 0 } },
 };
 
-static s32 D_80AD8D24 = 0;
+// Name from zeldaret/oot (was D_80AD8D24): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c]
+static s32 sAlreadySpawned = 0;
 
 static InitChainEntry sInitChain[] = {
     ICHAIN_S8(naviEnemyId, 0x4F, ICHAIN_CONTINUE),
@@ -104,10 +105,10 @@ void EnPoRelay_Init(Actor* thisx, PlayState* play) {
                               255, 255, 255, 200);
     this->lightColor.a = 255;
     temp = 1;
-    if (D_80AD8D24 != 0) {
+    if (sAlreadySpawned != 0) {
         Actor_Kill(&this->actor);
     } else {
-        D_80AD8D24 = temp;
+        sAlreadySpawned = temp;
         Actor_SetTextWithPrefix(play, &this->actor, 65);
         this->textId = this->actor.textId;
         EnPoRelay_SetupIdle(this);
@@ -118,7 +119,7 @@ void EnPoRelay_Init(Actor* thisx, PlayState* play) {
 void EnPoRelay_Destroy(Actor* thisx, PlayState* play) {
     EnPoRelay* this = (EnPoRelay*)thisx;
 
-    D_80AD8D24 = 0;
+    sAlreadySpawned = 0;
     LightContext_RemoveLight(play, &play->lightCtx, this->lightNode);
     Collider_DestroyCylinder(play, &this->collider);
 }
