+        Math_Vec3s_ToVec3f(&rightPos, &right->dim.pos);
+        CollisionCheck_SetOCvsOC(&left->base, &left->info, &leftPos, &right->base, &right->info, &rightPos,
+                                 deadSpace);
     }
 }
 
