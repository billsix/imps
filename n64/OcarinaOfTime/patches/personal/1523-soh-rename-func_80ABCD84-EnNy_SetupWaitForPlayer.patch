Subject: [PATCH 1523/3799] soh: rename func_80ABCD84 ->
 EnNy_SetupWaitForPlayer

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the dormant action that waits for the player to come near.
Defined in soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
index b2f3d15f3..51a6d23d9 100644
--- a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
+++ b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
@@ -161,7 +161,8 @@ void EnNy_UpdateSwimSpeed(EnNy* this) {
     this->unk_1E8 = 2.8f * temp;
 }
 
-void func_80ABCD84(EnNy* this) {
+// LLM generated name (HIGH), was func_80ABCD84: installs the dormant action that waits for the player to come near.
+void EnNy_SetupWaitForPlayer(EnNy* this) {
     this->actionFunc = func_80ABCE50;
 }
 
@@ -283,7 +284,7 @@ void func_80ABD11C(EnNy* this, PlayState* play) {
         if (this->stoneTimer != 0) {
             this->stoneTimer--;
         } else {
-            func_80ABCD84(this);
+            EnNy_SetupWaitForPlayer(this);  // was func_80ABCD84 [LLM:HIGH]
         }
     }
     this->unk_1D4 = phi_v0;
