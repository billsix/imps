From 0137dc830f5c6f6868c32a1b9d41a0568cf6ba71 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:07:52 +0000
Subject: [PATCH 1991/3799] soh: rename func_80A99384 -> EnKo_FadoWaitToTrade

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Fado's idle: starts the laugh on text 0x10B9 and closes the textbox to hand over the saw on NPC_TALK_STATE_ACTION
Defined in soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../TimeSavers/SkipCutscene/Story/SkipBlueWarp.cpp    |  2 +-
 soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c           | 11 ++++++-----
 soh/src/overlays/actors/ovl_En_Ko/z_en_ko.h           |  2 +-
 3 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/soh/Enhancements/TimeSavers/SkipCutscene/Story/SkipBlueWarp.cpp b/soh/soh/Enhancements/TimeSavers/SkipCutscene/Story/SkipBlueWarp.cpp
index e565e0550..38607ec98 100644
--- a/soh/soh/Enhancements/TimeSavers/SkipCutscene/Story/SkipBlueWarp.cpp
+++ b/soh/soh/Enhancements/TimeSavers/SkipCutscene/Story/SkipBlueWarp.cpp
@@ -30,7 +30,7 @@ void EnKo_MoveWhenReady(EnKo* enKo, PlayState* play) {
         if (GameInteractor_Should(VB_OPEN_KOKIRI_FOREST, CHECK_QUEST_ITEM(QUEST_KOKIRI_EMERALD))) {
             enKo->collider.dim.height -= 200;
             Path_CopyLastPoint(enKo->path, &enKo->actor.world.pos);
-            enKo->actionFunc = func_80A99384;
+            enKo->actionFunc = EnKo_FadoWaitToTrade;  // was func_80A99384 [LLM:HIGH]
         }
     }
 }
diff --git a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
index 3cb9f8bf3..702658c40 100644
--- a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
+++ b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
@@ -25,7 +25,8 @@ void EnKo_Draw(Actor* thisx, PlayState* play);
 // LLM generated name (HIGH), was func_80A99048: holds until the animation and model objects load, then builds the skeleton and collider and installs the first real action
 void EnKo_WaitForObjects(EnKo* this, PlayState* play);  // was func_80A99048 [LLM:HIGH]
 void func_80A995CC(EnKo* this, PlayState* play);
-void func_80A99384(EnKo* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A99384: Fado's idle: starts the laugh on text 0x10B9 and closes the textbox to hand over the saw on NPC_TALK_STATE_ACTION
+void EnKo_FadoWaitToTrade(EnKo* this, PlayState* play);  // was func_80A99384 [LLM:HIGH]
 void func_80A99438(EnKo* this, PlayState* play);
 void func_80A99504(EnKo* this, PlayState* play);
 void func_80A99560(EnKo* this, PlayState* play);
@@ -1213,11 +1214,11 @@ void EnKo_WaitForObjects(EnKo* this, PlayState* play) {
             }
             Path_CopyLastPoint(this->path, &this->actor.world.pos);
         }
-        this->actionFunc = func_80A99384;
+        this->actionFunc = EnKo_FadoWaitToTrade;  // was func_80A99384 [LLM:HIGH]
     }
 }
 
-void func_80A99384(EnKo* this, PlayState* play) {
+void EnKo_FadoWaitToTrade(EnKo* this, PlayState* play) {
     if (ENKO_TYPE == ENKO_TYPE_CHILD_FADO && this->interactInfo.talkState != NPC_TALK_STATE_IDLE &&
         this->actor.textId == 0x10B9) {
         Animation_ChangeByInfo(&this->skelAnime, sAnimationInfo, ENKO_ANIM_LAUGHING);
@@ -1237,7 +1238,7 @@ void func_80A99438(EnKo* this, PlayState* play) {
         play->msgCtx.msgMode = MSGMODE_TEXT_CLOSING;
     } else if (this->interactInfo.talkState == NPC_TALK_STATE_IDLE || this->actor.textId != 0x10B9) {
         Animation_ChangeByInfo(&this->skelAnime, sAnimationInfo, ENKO_ANIM_IDLE);
-        this->actionFunc = func_80A99384;
+        this->actionFunc = EnKo_FadoWaitToTrade;  // was func_80A99384 [LLM:HIGH]
     }
 }
 
@@ -1256,7 +1257,7 @@ void func_80A99560(EnKo* this, PlayState* play) {
         Message_ContinueTextbox(play, this->actor.textId);
         this->interactInfo.talkState = NPC_TALK_STATE_TALKING;
         Flags_SetItemGetInf(ITEMGETINF_31);
-        this->actionFunc = func_80A99384;
+        this->actionFunc = EnKo_FadoWaitToTrade;  // was func_80A99384 [LLM:HIGH]
     }
 }
 
