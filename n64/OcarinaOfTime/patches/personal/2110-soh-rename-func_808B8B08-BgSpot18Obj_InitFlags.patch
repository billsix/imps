From cdfcaf68d779fb4780def03cd4263e7273e690e0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:12:54 +0000
Subject: [PATCH 2110/3799] soh: rename func_808B8B08 -> BgSpot18Obj_InitFlags

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: ORs this type's entry from sExtraFlags into actor.flags
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
index d217afcc1..411c71b53 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
@@ -21,7 +21,8 @@ s32 BgSpot18Obj_ShouldSpawn(BgSpot18Obj* this, PlayState* play);  // was func_80
 s32 BgSpot18Obj_InitScale(BgSpot18Obj* this, PlayState* play);  // was func_808B8A5C [LLM:HIGH]
 // LLM generated name (HIGH), was func_808B8A98: registers the type's collision header as a dynapoly bg actor
 s32 BgSpot18Obj_InitDynaPoly(BgSpot18Obj* this, PlayState* play);  // was func_808B8A98 [LLM:HIGH]
-s32 func_808B8B08(BgSpot18Obj* this, PlayState* play);
+// LLM generated name (HIGH), was func_808B8B08: ORs this type's entry from sExtraFlags into actor.flags
+s32 BgSpot18Obj_InitFlags(BgSpot18Obj* this, PlayState* play);  // was func_808B8B08 [LLM:HIGH]
 s32 func_808B8BB4(BgSpot18Obj* this, PlayState* play);
 s32 func_808B8C90(BgSpot18Obj* this, PlayState* play);
 void func_808B8DC0(BgSpot18Obj* this);
@@ -67,7 +68,7 @@ static BgSpot18ObjInitFunc D_808B910C[] = {
     BgSpot18Obj_InitDynaPoly,  // was func_808B8A98 [LLM:HIGH]
     BgSpot18Obj_ShouldSpawn,  // was func_808B8910 [LLM:HIGH]
     BgSpot18Obj_InitScale,  // was func_808B8A5C [LLM:HIGH]
-    func_808B8B08,
+    BgSpot18Obj_InitFlags,  // was func_808B8B08 [LLM:HIGH]
 };
 
 static InitChainEntry sInitChain1[] = {
@@ -137,7 +138,7 @@ s32 BgSpot18Obj_InitDynaPoly(BgSpot18Obj* this, PlayState* play) {
     return 1;
 }
 
-s32 func_808B8B08(BgSpot18Obj* this, PlayState* play) {
+s32 BgSpot18Obj_InitFlags(BgSpot18Obj* this, PlayState* play) {
     this->dyna.actor.flags |= D_808B9104[this->dyna.actor.params & 0xF];
     return 1;
 }
