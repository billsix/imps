From ae623a3a8ff746ba49f4cd9df6f8e4e7306f3d0e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:38 +0000
Subject: [PATCH 3082/3799] soh: rename D_8012151C -> sCs3040KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 3040 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 6 +++---
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 612d540d3..38536db46 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -27,7 +27,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(D_801211D4)                                   \
     F(sCs4510KeyFrames)                                   \
     F(sCs2210KeyFrames)                                   \
-    F(D_8012151C)                                   \
+    F(sCs3040KeyFrames)                                   \
     F(D_8012156C)                                   \
     F(D_801215BC)                                   \
     F(D_80121C24)                                   \
@@ -404,9 +404,9 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             break;
         case 3040:
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
-            D_8012151C[0].timerInit = timer - 1;
+            sCs3040KeyFrames[0].timerInit = timer - 1;  // was D_8012151C [LLM:HIGH]
 
-            csInfo->keyFrames = D_8012151C;
+            csInfo->keyFrames = sCs3040KeyFrames;  // was D_8012151C [LLM:HIGH]
             csInfo->keyFrameCnt = 2;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 70f158caa..a1cecaa54 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -288,7 +288,8 @@ static OnePointCsFull sCs4175KeyFrames[4] = {  // was D_8012147C [LLM:HIGH]
     { 0x11, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_8012151C[2] = {
+// LLM generated name (HIGH), was D_8012151C: the keyframe set one-point cutscene 3040 installs
+static OnePointCsFull sCs3040KeyFrames[2] = {  // was D_8012151C [LLM:HIGH]
     { 0x0F, 0x01, 0x0101, 29, 0, 60.0f, 1.0f, { -700.0f, 875.0f, -100.0f }, { -550.0f, 920.0f, -150.0f } },
     { 0x12, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
