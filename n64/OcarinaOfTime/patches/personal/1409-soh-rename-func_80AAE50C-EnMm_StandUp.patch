From 6bad1ab26b137ec7dad71d2f05e67f89bbd87d8b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:17:02 +0000
Subject: [PATCH 1409/3799] soh: rename func_80AAE50C -> EnMm_StandUp

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: waits for the stand-up animation, then picks the sprint or ordinary run animation depending on whether the player has already traded him the mask, and starts running.
Defined in soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c b/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
index 5b7d681c4..8641a724b 100644
--- a/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
+++ b/soh/src/overlays/actors/ovl_En_Mm/z_en_mm.c
@@ -33,7 +33,8 @@ void EnMm_Draw(Actor* thisx, PlayState* play);
 void func_80AAE598(EnMm* this, PlayState* play);
 // LLM generated name (HIGH), was func_80AAE294: the running action: steps the animation with footstep sfx, follows the path and, once night falls, breaks off to sit down.
 void EnMm_Run(EnMm* this, PlayState* play);  // was func_80AAE294 [LLM:HIGH]
-void func_80AAE50C(EnMm* this, PlayState* play);
+// LLM generated name (HIGH), was func_80AAE50C: waits for the stand-up animation, then picks the sprint or ordinary run animation depending on whether the player has already traded him the mask, and starts running.
+void EnMm_StandUp(EnMm* this, PlayState* play);  // was func_80AAE50C [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AAE224: waits for the current animation to finish, then parks the Running Man in the sitting-idle animation with his mouth closed and hands off to the sitting action.
 void EnMm_SitDown(EnMm* this, PlayState* play);  // was func_80AAE224 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AADA70: returns whether gSaveContext.dayTime is inside the daylight window; the Running Man only runs by day.
@@ -478,7 +479,7 @@ void EnMm_Run(EnMm* this, PlayState* play) {
     }
 }
 
-void func_80AAE50C(EnMm* this, PlayState* play) {
+void EnMm_StandUp(EnMm* this, PlayState* play) {
     if (SkelAnime_Update(&this->skelAnime)) {
         this->sitTimer = 0;
         this->actionFunc = EnMm_Run;  // was func_80AAE294 [LLM:HIGH]
@@ -501,7 +502,7 @@ void func_80AAE598(EnMm* this, PlayState* play) {
 
     if ((EnMm_IsDay() != 0) && (this->unk_1E0 == 0)) {  // was func_80AADA70 [LLM:HIGH]
         this->unk_1E0 = 3;
-        this->actionFunc = func_80AAE50C;
+        this->actionFunc = EnMm_StandUp;  // was func_80AAE50C [LLM:HIGH]
         this->unk_254 &= ~1;
         EnMm_ChangeAnim(this, RM_ANIM_STAND, &this->curAnimIndex);
     }
