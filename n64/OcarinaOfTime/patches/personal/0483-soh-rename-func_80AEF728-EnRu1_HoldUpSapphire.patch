From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:50 +0000
Subject: [PATCH 0483/3799] soh: rename func_80AEF728 -> EnRu1_HoldUpSapphire

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.80.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index b929b9cb6..c91fcc100 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -2060,7 +2060,8 @@ void EnRu1_SetupRetrievingSapphireAnimation(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEF728(EnRu1* this, UNK_TYPE arg1) {
+// Name from zeldaret/oot (was func_80AEF728): adopted upstream's name for this address; body verified to match upstream at 0.80. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_HoldUpSapphire(EnRu1* this, UNK_TYPE arg1) {
     if (arg1 != 0) {
         Animation_Change(&this->skelAnime, &gRutoChildHoldArmsUpAnim, 1.0f, 0.0f,
                          Animation_GetLastFrame(&gRutoChildHoldArmsUpAnim), ANIMMODE_LOOP, 0.0f);
@@ -2135,7 +2136,7 @@ void func_80AEFA2C(EnRu1* this, PlayState* play) {
     EnRu1_PlayLaughingSfx(this);
     func_80AEF5B8(this);
     EnRu1_PlayStepSoundNearSapphire(this);
-    func_80AEF728(this, something);
+    EnRu1_HoldUpSapphire(this, something);
     func_80AEB220(this, play);
 }
 
