From fef3b6d0abf42bbe193ec2be3547a7ba54dac3df Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:11:58 +0000
Subject: [PATCH 1350/3799] soh: rename D_80812848 -> sFileConfirmButtonVtx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same anchor indices for the confirm-file screen of the select menu, chosen by confirmButtonIndex.
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c
index 040348e3b..9577b9c47 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c
@@ -1168,7 +1168,8 @@ static s16 sMainMenuButtonVtx[] = { 0x0040, 0x0054, 0x0068, 0x0274, 0x0278, 0x02
 static s16 sSelectMenuButtonVtx[] = { 0x0040, 0x0054, 0x0068, 0x0278 };  // was D_8081283C [LLM:HIGH]
 // LLM generated name (HIGH), was D_80812844: the same anchor indices for the erase-confirm and copy-confirm screens.
 static s16 sConfirmMenuButtonVtx[] = { 0x0274, 0x0278 };  // was D_80812844 [LLM:HIGH]
-static s16 D_80812848[] = { 0x0274, 0x0278 };
+// LLM generated name (HIGH), was D_80812848: the same anchor indices for the confirm-file screen of the select menu, chosen by confirmButtonIndex.
+static s16 sFileConfirmButtonVtx[] = { 0x0274, 0x0278 };  // was D_80812848 [LLM:HIGH]
 
 void FileChoose_SetWindowContentVtx(GameState* thisx) {
     FileChooseContext* this = (FileChooseContext*)thisx;
@@ -1424,7 +1425,7 @@ void FileChoose_SetWindowContentVtx(GameState* thisx) {
                 phi_t5 = sMainMenuButtonVtx[this->buttonIndex];  // was D_80812830 [LLM:HIGH]
             }
         } else {
-            phi_t5 = D_80812848[this->confirmButtonIndex];
+            phi_t5 = sFileConfirmButtonVtx[this->confirmButtonIndex];  // was D_80812848 [LLM:HIGH]
         }
 
         this->windowContentVtx[phi_t2].v.ob[0] = this->windowContentVtx[phi_t2 + 2].v.ob[0] = this->windowPosX - 0xA;
-- 
