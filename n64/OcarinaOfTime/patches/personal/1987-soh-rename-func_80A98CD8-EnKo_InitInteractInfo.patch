From 047a3c5ee44b04196ce72f2f3127889768eb0784 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:07:51 +0000
Subject: [PATCH 1987/3799] soh: rename func_80A98CD8 -> EnKo_InitInteractInfo

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: copies this type's sInteractInfo row into targetMode, lookDist and appearDist
Defined in soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
index eb02934eb..04ddba166 100644
--- a/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
+++ b/soh/src/overlays/actors/ovl_En_Ko/z_en_ko.c
@@ -1083,7 +1083,8 @@ void EnKo_Blink(EnKo* this) {
     }
 }
 
-void func_80A98CD8(EnKo* this) {
+// LLM generated name (HIGH), was func_80A98CD8: copies this type's sInteractInfo row into targetMode, lookDist and appearDist
+void EnKo_InitInteractInfo(EnKo* this) {
     s32 type = ENKO_TYPE;
     EnKoInteractInfo* info = &sInteractInfo[type];
 
@@ -1196,7 +1197,7 @@ void func_80A99048(EnKo* this, PlayState* play) {
         }
         Animation_ChangeByInfo(&this->skelAnime, sAnimationInfo, sOsAnimeLookup[ENKO_TYPE][this->forestQuestState]);
         Actor_SetScale(&this->actor, 0.01f);
-        func_80A98CD8(this);
+        EnKo_InitInteractInfo(this);  // was func_80A98CD8 [LLM:HIGH]
         this->modelAlpha = 0.0f;
         this->path = Path_GetByIndex(play, ENKO_PATH, 0xFF);
         Actor_SpawnAsChild(&play->actorCtx, &this->actor, play, ACTOR_EN_ELF, this->actor.world.pos.x,
