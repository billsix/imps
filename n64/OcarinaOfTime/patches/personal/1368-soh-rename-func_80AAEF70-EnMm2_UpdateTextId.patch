From 56037a4ce3a4b1b362b02c31a200481f1e615ae8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:13:52 +0000
Subject: [PATCH 1368/3799] soh: rename func_80AAEF70 -> EnMm2_UpdateTextId

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: picks the Running Man's line from the carpenters flag, whether the race has been offered before, whether the sub-timer is running and the current marathon record.
Defined in soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c b/soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c
index 8787d1e01..a823d080d 100644
--- a/soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c
+++ b/soh/src/overlays/actors/ovl_En_Mm2/z_en_mm2.c
@@ -100,7 +100,8 @@ void EnMm2_ChangeAnim(EnMm2* this, s32 index, s32* currentIndex) {
     *currentIndex = index;
 }
 
-void func_80AAEF70(EnMm2* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AAEF70: picks the Running Man's line from the carpenters flag, whether the race has been offered before, whether the sub-timer is running and the current marathon record.
+void EnMm2_UpdateTextId(EnMm2* this, PlayState* play) {
     if (!GET_EVENTCHKINF_CARPENTERS_FREE_ALL()) {
         this->actor.textId = 0x6086;
     } else if (Flags_GetInfTable(INFTABLE_17F)) {
@@ -143,7 +144,7 @@ void EnMm2_Init(Actor* thisx, PlayState* play2) {
     if (this->actor.params == 1) {
         this->actionFunc = func_80AAF668;
     } else {
-        func_80AAEF70(this, play);
+        EnMm2_UpdateTextId(this, play);  // was func_80AAEF70 [LLM:HIGH]
         this->actionFunc = func_80AAF57C;
     }
     if (!LINK_IS_ADULT) {
@@ -241,13 +242,13 @@ void func_80AAF3C0(EnMm2* this, PlayState* play) {
             this->actionFunc = func_80AAF57C;
         }
         this->actionFunc = func_80AAF57C;
-        func_80AAEF70(this, play);
+        EnMm2_UpdateTextId(this, play);  // was func_80AAEF70 [LLM:HIGH]
     }
 }
 
 void func_80AAF57C(EnMm2* this, PlayState* play) {
     SkelAnime_Update(&this->skelAnime);
-    func_80AAEF70(this, play);
+    EnMm2_UpdateTextId(this, play);  // was func_80AAEF70 [LLM:HIGH]
     if ((func_80AAF224(this, play, func_80AAF3C0)) && (this->actor.textId == 0x607D)) {
         Flags_SetInfTable(INFTABLE_17F);
     }
