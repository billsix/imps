From 9533bcf0e698ebf0e0fe6d082043a5b1221232d4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:49:15 +0000
Subject: [PATCH 1876/3799] soh: rename func_809D01CC -> EnBw_SetupFreeze

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: arms the ice timer and the freeze duration and installs the frozen action.
Defined in soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c b/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c
index 21cf4e157..8b960f95c 100644
--- a/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c
+++ b/soh/src/overlays/actors/ovl_En_Bw/z_en_bw.c
@@ -44,7 +44,8 @@ void EnBw_FlipBack(EnBw* this, PlayState* play);  // was func_809CFF98 [LLM:HIGH
 void EnBw_SetupDie(EnBw* this);  // was func_809D00F4 [LLM:HIGH]
 // LLM generated name (HIGH), was func_809D014C: flattens and fades the slug out over forty frames, then kills the actor.
 void EnBw_Die(EnBw* this, PlayState* play);  // was func_809D014C [LLM:HIGH]
-void func_809D01CC(EnBw* this);
+// LLM generated name (HIGH), was func_809D01CC: arms the ice timer and the freeze duration and installs the frozen action.
+void EnBw_SetupFreeze(EnBw* this);  // was func_809D01CC [LLM:HIGH]
 void func_809D0268(EnBw* this, PlayState* play);
 void func_809D03CC(EnBw* this);
 void func_809D0424(EnBw* this, PlayState* play);
@@ -611,7 +612,7 @@ void EnBw_Die(EnBw* this, PlayState* play) {
     }
 }
 
-void func_809D01CC(EnBw* this) {
+void EnBw_SetupFreeze(EnBw* this) {
     this->unk_220 = 1;
     this->actor.speedXZ = 0.0f;
     this->unk_25C = (Rand_ZeroOne() * 0.25f) + 1.0f;
@@ -740,7 +741,7 @@ void func_809D0584(EnBw* this, PlayState* play) {
                 Audio_PlayActorSound2(&this->actor, NA_SE_EN_BUBLEWALK_DAMAGE);
                 Actor_SetColorFilter(&this->actor, 0x4000, 0xFF, 0, 8);
                 if (this->unk_220 != 5) {
-                    func_809D01CC(this);
+                    EnBw_SetupFreeze(this);  // was func_809D01CC [LLM:HIGH]
                 }
                 this->unk_248 = 0.0f;
             }
