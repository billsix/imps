From e7c85e9e42bd077fa95c9556f39e8d15b1ee9a68 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:41 +0000
Subject: [PATCH 3108/3799] soh: rename D_801228A4 -> sCs4150KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 4150 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index ab0bcb524..6efbb09dc 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -866,7 +866,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Camera_RequestMode(mainCam, CAM_MODE_NORMAL);
             break;
         case 4150:
-            csInfo->keyFrames = D_801228A4;
+            csInfo->keyFrames = sCs4150KeyFrames;  // was D_801228A4 [LLM:HIGH]
             csInfo->keyFrameCnt = 5;
 
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 719a3f31d..3503dcf65 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -523,7 +523,8 @@ static OnePointCsFull sCs4140KeyFrames[6] = {  // was D_801227B4 [LLM:HIGH]
     { 0x11, 0xFF, 0x0000, 1, -1, -1.0f, -1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_801228A4[5] = {
+// LLM generated name (HIGH), was D_801228A4: the keyframe set one-point cutscene 4150 installs
+static OnePointCsFull sCs4150KeyFrames[5] = {  // was D_801228A4 [LLM:HIGH]
     { 0x0F, 0x01, 0x0101, 20, 5, 30.0f, 1.0f, { 800.0f, -40.0f, 2170.0f }, { 512.0f, 142.0f, 2020.0f } },
     { 0x02, 0xFF, 0x0101, 20, -2, 70.0f, 0.8f, { 800.0f, -40.0f, 2170.0f }, { 512.0f, 142.0f, 2020.0f } },
     { 0x0F, 0x08, 0x0101, 90, 2, 62.0f, 1.0f, { 1140.0f, 125.0f, 1920.0f }, { 1255.0f, 150.0f, 1785.0f } },
