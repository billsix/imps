From 1d8c9d597686bbdb229f84351739d8c8dbd46474 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:36 +0000
Subject: [PATCH 3062/3799] soh: rename D_80120820 -> sCs6001EyePoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the first eye point set 6001 chooses between
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 925082cab..c7ad1303f 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -678,7 +678,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
             Actor_GetWorld(&spA0, actor);
             if (spA0.pos.z > -750.0f) {
-                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, sCs6001AtPoints, D_80120820);  // was D_801206A0 [LLM:HIGH]
+                OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, sCs6001AtPoints, sCs6001EyePoints);  // was D_801206A0 [LLM:HIGH]
             } else {
                 OnePointCutscene_SetCsCamPoints(csCam, D_801208E8, D_801208E4, sCs6001AtPoints, sCs6001EyePointsAlt);  // was D_801206A0 [LLM:HIGH]
             }
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index c157e45cd..1bed9fd42 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -124,7 +124,8 @@ static CutsceneCameraPoint sCs6001EyePointsAlt[12] = {  // was D_80120760 [LLM:H
     { CS_CMD_CONTINUE, 1, 0, 65.0f, { 75, 18, 123 } },  { CS_CMD_CONTINUE, 1, 0, 65.0f, { 75, 10, 123 } },
     { CS_CMD_STOP, 0, 0, 65.0f, { 75, 10, 122 } },      { CS_CMD_STOP, 0, 0, 65.0f, { 75, 10, 122 } },
 };
-static CutsceneCameraPoint D_80120820[12] = {
+// LLM generated name (HIGH), was D_80120820: the first eye point set 6001 chooses between
+static CutsceneCameraPoint sCs6001EyePoints[12] = {  // was D_80120820 [LLM:HIGH]
     { CS_CMD_CONTINUE, 6, 0, 80.0f, { 85, 5, 170 } },  { CS_CMD_CONTINUE, 6, 0, 80.0f, { 85, 10, 170 } },
     { CS_CMD_CONTINUE, 6, 0, 70.0f, { 80, 20, 167 } }, { CS_CMD_CONTINUE, 5, 0, 65.0f, { 74, 25, 165 } },
     { CS_CMD_CONTINUE, 4, 0, 65.0f, { 63, 30, 162 } }, { CS_CMD_CONTINUE, 3, 0, 65.0f, { 66, 34, 147 } },
