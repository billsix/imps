From f597d2d295bed185774699fe315d33ec2633a9c3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:03 +0000
Subject: [PATCH 3185/3799] soh: rename D_8011D678 -> sCsSpiralPoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the positions that same cutscene interpolates between
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c        | 20 ++++++++++----------
 soh/src/code/z_camera_data.inc |  3 ++-
 2 files changed, 12 insertions(+), 11 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 40dca0e86..72d8e0b5a 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -5867,7 +5867,7 @@ s32 Camera_Demo3(Camera* camera) {
             if (Camera_BGCheck(camera, &sp68, &sp74)) {
                 anim->yawDir = -anim->yawDir;
             }
-            OLib_Vec3fToVecSphGeo(&atOffset, &D_8011D678[0]);
+            OLib_Vec3fToVecSphGeo(&atOffset, &sCsSpiralPoints[0]);  // was D_8011D678 [LLM:HIGH]
             atOffset.yaw += camPlayerPosRot->rot.y;
             Camera_Vec3fVecSphGeoAdd(at, &anim->initialAt, &atOffset);
             eyeOffset.r = sCsSpiralOffsets[0].r;  // was D_8011D658 [LLM:HIGH]
@@ -5878,9 +5878,9 @@ s32 Camera_Demo3(Camera* camera) {
         case 1:
             temp_f0 = (anim->animFrame - 2) * (1.0f / 146.0f);
 
-            sp5C.x = F32_LERPIMP(D_8011D678[0].x, D_8011D678[1].x, temp_f0);
-            sp5C.y = F32_LERPIMP(D_8011D678[0].y, D_8011D678[1].y, temp_f0);
-            sp5C.z = F32_LERPIMP(D_8011D678[0].z, D_8011D678[1].z, temp_f0);
+            sp5C.x = F32_LERPIMP(sCsSpiralPoints[0].x, sCsSpiralPoints[1].x, temp_f0);  // was D_8011D678 [LLM:HIGH]
+            sp5C.y = F32_LERPIMP(sCsSpiralPoints[0].y, sCsSpiralPoints[1].y, temp_f0);  // was D_8011D678 [LLM:HIGH]
+            sp5C.z = F32_LERPIMP(sCsSpiralPoints[0].z, sCsSpiralPoints[1].z, temp_f0);  // was D_8011D678 [LLM:HIGH]
 
             OLib_Vec3fToVecSphGeo(&atOffset, &sp5C);
             atOffset.yaw = (atOffset.yaw * anim->yawDir) + camPlayerPosRot->rot.y;
@@ -5899,10 +5899,10 @@ s32 Camera_Demo3(Camera* camera) {
         case 2:
             temp_f0 = (anim->animFrame - 0x94) * 0.1f;
 
-            sp5C.x = F32_LERPIMP(D_8011D678[1].x, D_8011D678[2].x, temp_f0);
-            sp5C.y = F32_LERPIMP((D_8011D678[1].y - yOffset), D_8011D678[2].y, temp_f0);
+            sp5C.x = F32_LERPIMP(sCsSpiralPoints[1].x, sCsSpiralPoints[2].x, temp_f0);  // was D_8011D678 [LLM:HIGH]
+            sp5C.y = F32_LERPIMP((sCsSpiralPoints[1].y - yOffset), sCsSpiralPoints[2].y, temp_f0);  // was D_8011D678 [LLM:HIGH]
             sp5C.y += yOffset;
-            sp5C.z = F32_LERPIMP(D_8011D678[1].z, D_8011D678[2].z, temp_f0);
+            sp5C.z = F32_LERPIMP(sCsSpiralPoints[1].z, sCsSpiralPoints[2].z, temp_f0);  // was D_8011D678 [LLM:HIGH]
 
             OLib_Vec3fToVecSphGeo(&atOffset, &sp5C);
             atOffset.yaw = (atOffset.yaw * anim->yawDir) + camPlayerPosRot->rot.y;
@@ -5920,10 +5920,10 @@ s32 Camera_Demo3(Camera* camera) {
         case 3:
             temp_f0 = (anim->animFrame - 0x9F) * (1.0f / 9.0f);
 
-            sp5C.x = F32_LERPIMP(D_8011D678[2].x, D_8011D678[3].x, temp_f0);
-            sp5C.y = F32_LERPIMP(D_8011D678[2].y, D_8011D678[3].y, temp_f0);
+            sp5C.x = F32_LERPIMP(sCsSpiralPoints[2].x, sCsSpiralPoints[3].x, temp_f0);  // was D_8011D678 [LLM:HIGH]
+            sp5C.y = F32_LERPIMP(sCsSpiralPoints[2].y, sCsSpiralPoints[3].y, temp_f0);  // was D_8011D678 [LLM:HIGH]
             sp5C.y += yOffset;
-            sp5C.z = F32_LERPIMP(D_8011D678[2].z, D_8011D678[3].z, temp_f0);
+            sp5C.z = F32_LERPIMP(sCsSpiralPoints[2].z, sCsSpiralPoints[3].z, temp_f0);  // was D_8011D678 [LLM:HIGH]
 
             OLib_Vec3fToVecSphGeo(&atOffset, &sp5C);
             atOffset.yaw = (atOffset.yaw * anim->yawDir) + camPlayerPosRot->rot.y;
diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index 32afb5ae5..45490a3f8 100644
--- a/soh/src/code/z_camera_data.inc
+++ b/soh/src/code/z_camera_data.inc
@@ -2270,7 +2270,8 @@ VecSph sCsSpiralOffsets[] = {  // was D_8011D658 [LLM:HIGH]
     { 15.0f, 0xEE3A, 0x8008 },
 };
 
-Vec3f D_8011D678[] = {
+// LLM generated name (HIGH), was D_8011D678: the positions that same cutscene interpolates between
+Vec3f sCsSpiralPoints[] = {  // was D_8011D678 [LLM:HIGH]
     { 0.0f, 40.0f, 20.0f },
     { 0.0f, 40.0f, 0.0f },
     { 0.0f, 3.0f, -3.0f },
-- 
2.55.0

