From 1ddf272702d43f9bf5798080c4b214e437d90295 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:23:57 +0000
Subject: [PATCH 1500/3799] soh: rename D_8088BF60 -> sPushedRestPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the fixed position the pushable Fire Temple block settles at; Init snaps to it when the switch flag is already set, the push action tests against it and the flame is drawn there.
Defined in soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c       | 21 ++++++++++---------
 1 file changed, 11 insertions(+), 10 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
index 9b6780ce5..6b9358f1e 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
@@ -29,7 +29,8 @@ void func_8088B990(BgHidanRock* this, PlayState* play);
 
 void func_8088BC40(PlayState* play, BgHidanRock* this);
 
-static Vec3f D_8088BF60 = { 3310.0f, 120.0f, 0.0f };
+// LLM generated name (HIGH), was D_8088BF60: the fixed position the pushable Fire Temple block settles at; Init snaps to it when the switch flag is already set, the push action tests against it and the flame is drawn there.
+static Vec3f sPushedRestPos = { 3310.0f, 120.0f, 0.0f };  // was D_8088BF60 [LLM:HIGH]
 
 const ActorInit Bg_Hidan_Rock_InitVars = {
     ACTOR_BG_HIDAN_ROCK,
@@ -87,8 +88,8 @@ void BgHidanRock_Init(Actor* thisx, PlayState* play) {
 
     if (this->type == 0) {
         if (Flags_GetSwitch(play, thisx->params)) {
-            Math_Vec3f_Copy(&thisx->home.pos, &D_8088BF60);
-            Math_Vec3f_Copy(&thisx->world.pos, &D_8088BF60);
+            Math_Vec3f_Copy(&thisx->home.pos, &sPushedRestPos);  // was D_8088BF60 [LLM:HIGH]
+            Math_Vec3f_Copy(&thisx->world.pos, &sPushedRestPos);  // was D_8088BF60 [LLM:HIGH]
             this->timer = 60;
             this->actionFunc = func_8088B5F4;
         } else {
@@ -179,12 +180,12 @@ void func_8088B268(BgHidanRock* this, PlayState* play) {
         this->timer = 0;
     }
 
-    sp2C = this->dyna.actor.world.pos.z - D_8088BF60.z;
+    sp2C = this->dyna.actor.world.pos.z - sPushedRestPos.z;  // was D_8088BF60 [LLM:HIGH]
     if (sp2C < 0.5f) {
         Flags_SetSwitch(play, this->dyna.actor.params);
-        Math_Vec3f_Copy(&this->dyna.actor.home.pos, &D_8088BF60);
-        this->dyna.actor.world.pos.x = D_8088BF60.x;
-        this->dyna.actor.world.pos.z = D_8088BF60.z;
+        Math_Vec3f_Copy(&this->dyna.actor.home.pos, &sPushedRestPos);  // was D_8088BF60 [LLM:HIGH]
+        this->dyna.actor.world.pos.x = sPushedRestPos.x;  // was D_8088BF60 [LLM:HIGH]
+        this->dyna.actor.world.pos.z = sPushedRestPos.z;  // was D_8088BF60 [LLM:HIGH]
         this->dyna.actor.speedXZ = 0.0f;
         D_8088BFC0 = 0.0f;
         player->stateFlags2 &= ~PLAYER_STATE2_MOVING_DYNAPOLY;
@@ -368,7 +369,7 @@ void func_8088BC40(PlayState* play, BgHidanRock* this) {
     gDPSetEnvColor(POLY_XLU_DISP++, 255, 0, 0, 255);
 
     if (this->type == 0) {
-        Matrix_Translate(D_8088BF60.x, D_8088BF60.y - 40.0f, D_8088BF60.z, MTXMODE_NEW);
+        Matrix_Translate(sPushedRestPos.x, sPushedRestPos.y - 40.0f, sPushedRestPos.z, MTXMODE_NEW);  // was D_8088BF60 [LLM:HIGH]
     } else {
         Matrix_Translate(this->dyna.actor.home.pos.x, this->dyna.actor.home.pos.y - 40.0f, this->dyna.actor.home.pos.z,
                          MTXMODE_NEW);
@@ -397,7 +398,7 @@ void BgHidanRock_Draw(Actor* thisx, PlayState* play) {
 
     if (this->unk_16C > 0.0f) {
         if (this->type == 0) {
-            SkinMatrix_Vec3fMtxFMultXYZ(&play->viewProjectionMtxF, &D_8088BF60, &this->unk_170);
+            SkinMatrix_Vec3fMtxFMultXYZ(&play->viewProjectionMtxF, &sPushedRestPos, &this->unk_170);  // was D_8088BF60 [LLM:HIGH]
         } else {
             SkinMatrix_Vec3fMtxFMultXYZ(&play->viewProjectionMtxF, &this->dyna.actor.home.pos, &this->unk_170);
         }
@@ -409,4 +410,4 @@ void BgHidanRock_Draw(Actor* thisx, PlayState* play) {
 
 void BgHidanRock_Reset(void) {
     D_8088BFC0 = 0;
-}
\ No newline at end of file
+}
