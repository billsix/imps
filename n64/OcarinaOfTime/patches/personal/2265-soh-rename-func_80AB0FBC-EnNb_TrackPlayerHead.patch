Subject: [PATCH 2265/3799] soh: rename func_80AB0FBC -> EnNb_TrackPlayerHead

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: points Npc_TrackPoint at the player with NPC_TRACKING_HEAD_AND_TORSO
Defined in soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c b/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
index 453ed1d3f..31bd49d35 100644
--- a/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
+++ b/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
@@ -150,7 +150,8 @@ void EnNb_Destroy(Actor* thisx, PlayState* play) {
     Collider_DestroyCylinder(play, &this->collider);
 }
 
-void func_80AB0FBC(EnNb* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AB0FBC: points Npc_TrackPoint at the player with NPC_TRACKING_HEAD_AND_TORSO
+void EnNb_TrackPlayerHead(EnNb* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
 
     this->interactInfo.trackPos = player->actor.world.pos;
@@ -1331,7 +1332,7 @@ void EnNb_StandUpAfterNotice(EnNb* this, PlayState* play) {
 void EnNb_BlockCrawlspace(EnNb* this, PlayState* play) {
     func_80AB1284(this, play);
     EnNb_UpdateCollider(this, play);
-    func_80AB0FBC(this, play);
+    EnNb_TrackPlayerHead(this, play);  // was func_80AB0FBC [LLM:HIGH]
     EnNb_UpdateSkelAnime(this);
     EnNb_UpdateEyes(this);
     func_80AB3838(this, play);
@@ -1340,7 +1341,7 @@ void EnNb_BlockCrawlspace(EnNb* this, PlayState* play) {
 void EnNb_InitCrawlspaceDialogue(EnNb* this, PlayState* play) {
     func_80AB1284(this, play);
     EnNb_UpdateCollider(this, play);
-    func_80AB0FBC(this, play);
+    EnNb_TrackPlayerHead(this, play);  // was func_80AB0FBC [LLM:HIGH]
     EnNb_UpdateSkelAnime(this);
     EnNb_UpdateEyes(this);
     EnNb_SetTextIdAsChild(this, play);
@@ -1362,7 +1363,7 @@ void EnNb_FollowPath(EnNb* this, PlayState* play) {
 void func_80AB3DB0(EnNb* this, PlayState* play) {
     func_80AB1284(this, play);
     EnNb_UpdateCollider(this, play);
-    func_80AB0FBC(this, play);
+    EnNb_TrackPlayerHead(this, play);  // was func_80AB0FBC [LLM:HIGH]
     EnNb_UpdateSkelAnime(this);
     EnNb_UpdateEyes(this);
     func_80AB3B04(this, play);
