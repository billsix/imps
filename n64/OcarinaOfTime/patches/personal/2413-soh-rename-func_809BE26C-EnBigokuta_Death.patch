     if (this->unk_196 != 0) {
@@ -873,7 +874,7 @@ s32 EnBigokuta_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec
         }
     } else if (limbIndex == 10) {
         OPEN_DISPS(play->state.gfxCtx);
