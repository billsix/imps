From bf1e4ec1516ab54a7b47cc828690aaf4f260f9b1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:50 +0000
Subject: [PATCH 3170/3799] soh: rename D_8015CF00 -> sUpdateSpheresWorldCenter

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the world-space result of that transform
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index 1dbb0f50d..576968229 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -3279,7 +3279,7 @@ static s8 sBssDummy14;
  */
 void Collider_UpdateSpheres(s32 limb, ColliderJntSph* collider) {
     static Vec3f sUpdateSpheresModelCenter;  // was D_8015E648 [LLM:HIGH]
-    static Vec3f D_8015CF00; // bss ordering changes here
+    static Vec3f sUpdateSpheresWorldCenter; // bss ordering changes here, was D_8015CF00 [LLM:HIGH]
     s32 i;
 
     for (i = 0; i < collider->count; i++) {
@@ -3287,10 +3287,10 @@ void Collider_UpdateSpheres(s32 limb, ColliderJntSph* collider) {
             sUpdateSpheresModelCenter.x = collider->elements[i].dim.modelSphere.center.x;  // was D_8015E648 [LLM:HIGH]
             sUpdateSpheresModelCenter.y = collider->elements[i].dim.modelSphere.center.y;  // was D_8015E648 [LLM:HIGH]
             sUpdateSpheresModelCenter.z = collider->elements[i].dim.modelSphere.center.z;  // was D_8015E648 [LLM:HIGH]
-            Matrix_MultVec3f(&sUpdateSpheresModelCenter, &D_8015CF00);  // was D_8015E648 [LLM:HIGH]
-            collider->elements[i].dim.worldSphere.center.x = D_8015CF00.x;
-            collider->elements[i].dim.worldSphere.center.y = D_8015CF00.y;
-            collider->elements[i].dim.worldSphere.center.z = D_8015CF00.z;
+            Matrix_MultVec3f(&sUpdateSpheresModelCenter, &sUpdateSpheresWorldCenter);  // was D_8015E648 [LLM:HIGH]
+            collider->elements[i].dim.worldSphere.center.x = sUpdateSpheresWorldCenter.x;  // was D_8015CF00 [LLM:HIGH]
+            collider->elements[i].dim.worldSphere.center.y = sUpdateSpheresWorldCenter.y;  // was D_8015CF00 [LLM:HIGH]
+            collider->elements[i].dim.worldSphere.center.z = sUpdateSpheresWorldCenter.z;  // was D_8015CF00 [LLM:HIGH]
             collider->elements[i].dim.worldSphere.radius =
                 collider->elements[i].dim.modelSphere.radius * collider->elements[i].dim.scale;
         }
