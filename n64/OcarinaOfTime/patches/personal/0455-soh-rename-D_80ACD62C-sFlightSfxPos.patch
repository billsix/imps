From 66f5b715a42768a1b79a6fec035e35abf1c82a83 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:39 +0000
Subject: [PATCH 455/488] soh: rename D_80ACD62C -> sFlightSfxPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the fixed position the owl's flight sounds are played from
Defined in soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
index 9790abdf6..c8f80fe70 100644
--- a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
+++ b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
@@ -767,7 +767,7 @@ void EnOwl_WaitLWPostSaria(EnOwl* this, PlayState* play) {
 
 // LLM generated name (HIGH), was func_80ACB748: scales the wind, flutter and pass-by sounds by how fast the camera is moving during the travel cutscenes
 void EnOwl_PlayFlightSfx(EnOwl* this, PlayState* play) {
-    static Vec3f D_80ACD62C = { 0.0f, 0.0f, 0.0f };
+    static Vec3f sFlightSfxPos = { 0.0f, 0.0f, 0.0f };  // was D_80ACD62C [LLM:HIGH]
     f32 dist;
     f32 weight;
     s32 owlType = (this->actor.params & 0xFC0) >> 6;
@@ -784,22 +784,22 @@ void EnOwl_PlayFlightSfx(EnOwl* this, PlayState* play) {
 
     switch (owlType) {
         case 7:
-            Audio_PlaySfxScaledByRate(&D_80ACD62C, NA_SE_EV_FLYING_AIR - SFX_FLAG, weight * 2.0f);  // was func_800F436C [LLM:HIGH]
+            Audio_PlaySfxScaledByRate(&sFlightSfxPos, NA_SE_EV_FLYING_AIR - SFX_FLAG, weight * 2.0f);  // was func_800F436C [LLM:HIGH]
             if ((play->csCtx.frames > 324) || ((play->csCtx.frames >= 142 && (play->csCtx.frames <= 266)))) {
-                Audio_PlaySfxAtInterval(&D_80ACD62C, NA_SE_EN_OWL_FLUTTER, weight * 2.0f);  // was func_800F4414 [LLM:HIGH]
+                Audio_PlaySfxAtInterval(&sFlightSfxPos, NA_SE_EN_OWL_FLUTTER, weight * 2.0f);  // was func_800F4414 [LLM:HIGH]
             }
             if (play->csCtx.frames == 85) {
-                Audio_PlaySfxScaledByRate(&D_80ACD62C, NA_SE_EV_PASS_AIR, weight * 2.0f);  // was func_800F436C [LLM:HIGH]
+                Audio_PlaySfxScaledByRate(&sFlightSfxPos, NA_SE_EV_PASS_AIR, weight * 2.0f);  // was func_800F436C [LLM:HIGH]
             }
             break;
         case 8:
         case 9:
-            Audio_PlaySfxScaledByRate(&D_80ACD62C, NA_SE_EV_FLYING_AIR - SFX_FLAG, weight * 2.0f);  // was func_800F436C [LLM:HIGH]
+            Audio_PlaySfxScaledByRate(&sFlightSfxPos, NA_SE_EV_FLYING_AIR - SFX_FLAG, weight * 2.0f);  // was func_800F436C [LLM:HIGH]
             if ((play->csCtx.frames >= 420) || ((play->csCtx.frames > 0xC1 && (play->csCtx.frames <= 280)))) {
-                Audio_PlaySfxAtInterval(&D_80ACD62C, NA_SE_EN_OWL_FLUTTER, weight * 2.0f);  // was func_800F4414 [LLM:HIGH]
+                Audio_PlaySfxAtInterval(&sFlightSfxPos, NA_SE_EN_OWL_FLUTTER, weight * 2.0f);  // was func_800F4414 [LLM:HIGH]
             }
             if (play->csCtx.frames == 217) {
-                Audio_PlaySfxScaledByRate(&D_80ACD62C, NA_SE_EV_PASS_AIR, weight * 2.0f);  // was func_800F436C [LLM:HIGH]
+                Audio_PlaySfxScaledByRate(&sFlightSfxPos, NA_SE_EV_PASS_AIR, weight * 2.0f);  // was func_800F436C [LLM:HIGH]
             }
             break;
     }
