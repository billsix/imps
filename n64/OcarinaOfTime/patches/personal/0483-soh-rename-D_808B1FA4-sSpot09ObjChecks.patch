From 9aa5103a49e678fcb49e205f04efb38bdd7c3575 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:41 +0000
Subject: [PATCH 483/488] soh: rename D_808B1FA4 -> sSpot09ObjChecks

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the array of predicate functions BgSpot09Obj runs in turn, stopping at the first that fails
Defined in soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
index c6429dd54..3c1dbc3b0 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot09_Obj/z_bg_spot09_obj.c
@@ -39,7 +39,8 @@ static CollisionHeader* sCollisionHeaders[] = {  // was D_808B1F90 [LLM:HIGH]
     NULL, &gValleyObjects1Col, &gValleyObjects2Col, &gValleyObjects3Col, &gValleyObjects4Col,
 };
 
-static s32 (*D_808B1FA4[])(BgSpot09Obj* this, PlayState* play) = {
+// LLM generated name (HIGH), was D_808B1FA4: the array of predicate functions BgSpot09Obj runs in turn, stopping at the first that fails
+static s32 (*sSpot09ObjChecks[])(BgSpot09Obj* this, PlayState* play) = {  // was D_808B1FA4 [LLM:HIGH]
     BgSpot09Obj_InitCollision,  // was func_808B1BEC [LLM:HIGH]
     BgSpot09Obj_ShouldSpawn,  // was func_808B1AE0 [LLM:HIGH]
     BgSpot09Obj_SetScale,  // was func_808B1BA0 [LLM:HIGH]
@@ -112,8 +113,8 @@ s32 BgSpot09Obj_InitCollision(BgSpot09Obj* this, PlayState* play) {
 s32 BgSpot09Obj_RunSetupSteps(BgSpot09Obj* this, PlayState* play) {
     s32 i;
 
-    for (i = 0; i < ARRAY_COUNT(D_808B1FA4); i++) {
-        if (!D_808B1FA4[i](this, play)) {
+    for (i = 0; i < ARRAY_COUNT(sSpot09ObjChecks); i++) {  // was D_808B1FA4 [LLM:HIGH]
+        if (!sSpot09ObjChecks[i](this, play)) {  // was D_808B1FA4 [LLM:HIGH]
             return false;
         }
     }
