From e6b0c1c77099cc7c5f847a578f693033dcf67370 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:10 +0000
Subject: [PATCH 0938/3799] soh: rename D_8011578C -> sVtxTemplateFirst

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Vtx_t[4] copied into the first four vertices of every blure draw; its texture coordinates span the full 0-2048 range.
Defined in soh/src/code/z_eff_blure.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_eff_blure.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_eff_blure.c b/soh/src/code/z_eff_blure.c
index 2caaec074..1fcbc6317 100644
--- a/soh/src/code/z_eff_blure.c
+++ b/soh/src/code/z_eff_blure.c
@@ -958,7 +958,8 @@ void EffectBlure_DrawSimpleVertices(GraphicsContext* gfxCtx, EffectBlure* this,
     CLOSE_DISPS(gfxCtx);
 }
 
-Vtx_t D_8011578C[] = {
+// LLM generated name (HIGH), was D_8011578C: Vtx_t[4] copied into the first four vertices of every blure draw; its texture coordinates span the full 0-2048 range.
+Vtx_t sVtxTemplateFirst[] = {  // was D_8011578C [LLM:HIGH]
     VTX_T(0, 0, 0, 0, 1024, 0xFF, 0xFF, 0xFF, 0xFF),
     VTX_T(0, 0, 0, 0, 0, 0xFF, 0xFF, 0xFF, 0xFF),
     VTX_T(0, 0, 0, 2048, 1024, 0xFF, 0xFF, 0xFF, 0xFF),
@@ -998,7 +999,7 @@ void EffectBlure_DrawSimple(EffectBlure* this2, GraphicsContext* gfxCtx) {
 
         vtxIter = vtx;
         for (i = 0; i < 4; i++) {
-            vtxIter->v = D_8011578C[i];
+            vtxIter->v = sVtxTemplateFirst[i];  // was D_8011578C [LLM:HIGH]
             vtxIter++;
         }
 
-- 
