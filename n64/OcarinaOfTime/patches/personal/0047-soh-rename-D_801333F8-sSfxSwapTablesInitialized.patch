From 1afe24c94175c4e47d4b178bc026f2efad4cbfdf Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:15 +0000
Subject: [PATCH 047/225] soh: rename D_801333F8 -> sSfxSwapTablesInitialized

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/audio_sfx.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_sfx.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index a709cc073..2c7bc0f0e 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -98,7 +98,8 @@ u8 D_801333F0 = 0;
 
 u8 gAudioSfxSwapOff = 0;
 
-u8 D_801333F8 = 0;
+// LLM generated name (HIGH), was D_801333F8: one-shot flag guarding SFX swap-table initialization
+u8 sSfxSwapTablesInitialized = 0;
 
 void Audio_SetSfxBanksMute(u16 muteMask) {
     u8 bankId;
@@ -783,12 +784,12 @@ void Audio_ResetSounds(void) {
         gSoundBanks[bankId][i].prev = i - 1;
         gSoundBanks[bankId][i].next = 0xFF;
     }
-    if (D_801333F8 == 0) {
+    if (sSfxSwapTablesInitialized == 0) {
         for (bankId = 0; bankId < 10; bankId++) {
             gAudioSfxSwapSource[bankId] = 0;
             gAudioSfxSwapTarget[bankId] = 0;
             gAudioSfxSwapMode[bankId] = 0;
         }
-        D_801333F8++;
+        sSfxSwapTablesInitialized++;
     }
 }
