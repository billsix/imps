                             if ((dynaActor->world.pos.x != dynaActor->prevPos.x) ||
                                 (dynaActor->world.pos.y != dynaActor->prevPos.y) ||
                                 (dynaActor->world.pos.z != dynaActor->prevPos.z)) {
-                                D_80157D94[0]++;
+                                sDynaPolyMoved[0]++;  // was D_80157D94 [LLM:HIGH]
                                 break;
                             }
                         }
@@ -824,7 +824,7 @@ void EnItem00_Update(Actor* thisx, PlayState* play) {
             Actor_MoveXZGravity(&this->actor);
         }
 
-        if (sp3A || D_80157D94[0]) {
+        if (sp3A || sDynaPolyMoved[0]) {  // was D_80157D94 [LLM:HIGH]
             Actor_UpdateBgCheckInfo(play, &this->actor, 10.0f, 15.0f, 15.0f, 0x1D);
 
             if (GameInteractor_Should(VB_ITEM00_KILL, this->actor.floorHeight <= -10000.0f, this)) {
