Subject: [PATCH 526/784] soh: rename func_808B2AA8 -> BgSpot11Oasis_SetupFull

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c.
---
 .../actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c         | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c b/soh/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c
index 1c244b920..6096afd5e 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c
@@ -20,7 +20,8 @@ void BgSpot11Oasis_Wait(BgSpot11Oasis* this, PlayState* play);
 void BgSpot11Oasis_SetupRise(BgSpot11Oasis* this);
 // Name from zeldaret/oot (was func_808B29F0): adopted upstream's name for this address; body verified to match upstream at 0.89. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c]
 void BgSpot11Oasis_Rise(BgSpot11Oasis* this, PlayState* play);
-void func_808B2AA8(BgSpot11Oasis* this);
+// Name from zeldaret/oot (was func_808B2AA8): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c]
+void BgSpot11Oasis_SetupFull(BgSpot11Oasis* this);
 // Name from zeldaret/oot (was func_808B2AB8): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c]
 void BgSpot11Oasis_Full(BgSpot11Oasis* this, PlayState* play);
 
@@ -113,7 +114,7 @@ void BgSpot11Oasis_SetupRise(BgSpot11Oasis* this) {
 
 void BgSpot11Oasis_Rise(BgSpot11Oasis* this, PlayState* play) {
     if (Math_StepToF(&this->actor.world.pos.y, 0.0f, 0.7f)) {
-        func_808B2AA8(this);
+        BgSpot11Oasis_SetupFull(this);
         Actor_Spawn(&play->actorCtx, play, ACTOR_EN_ELF, this->actor.world.pos.x, this->actor.world.pos.y + 40.0f,
                     this->actor.world.pos.z, 0, 0, 0, FAIRY_SPAWNER);
         Sfx_PlaySfxCentered(NA_SE_SY_CORRECT_CHIME);
@@ -121,7 +122,7 @@ void BgSpot11Oasis_Rise(BgSpot11Oasis* this, PlayState* play) {
     BgSpot11Oasis_SetWaterLevel(play, this->actor.world.pos.y);
 }
 
-void func_808B2AA8(BgSpot11Oasis* this) {
+void BgSpot11Oasis_SetupFull(BgSpot11Oasis* this) {
     this->actionFunc = BgSpot11Oasis_Full;
 }
 
