From ea4a53b5994c6a8dbb4cdf315faec2801ef52403 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:45 +0000
Subject: [PATCH 0826/3799] soh: rename D_80126250 -> sQuakeUnused

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/z_quake.c.
---
 soh/src/code/z_quake.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_quake.c b/soh/src/code/z_quake.c
index 4cb9b7aa5..5f14e34b9 100644
--- a/soh/src/code/z_quake.c
+++ b/soh/src/code/z_quake.c
@@ -4,7 +4,8 @@
 #include <string.h>
 
 QuakeRequest sQuakeRequest[4];
-s16 D_80126250 = 1;
+// Name from zeldaret/oot (was D_80126250): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_quake.c]
+s16 sQuakeUnused = 1;
 s16 sQuakeRequestCount = 0;
 
 s16 (*sQuakeCallbacks[])(QuakeRequest*, ShakeInfo*) = {
@@ -289,7 +290,7 @@ void Quake_Init(void) {
         sQuakeRequest[i].callbackIdx = 0;
         sQuakeRequest[i].countdown = 0;
     }
-    D_80126250 = 1;
+    sQuakeUnused = 1;
     sQuakeRequestCount = 0;
 }
 
