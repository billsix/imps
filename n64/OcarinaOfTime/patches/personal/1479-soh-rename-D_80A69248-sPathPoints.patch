 static CollisionCheckInfoInit sColChkInfoInit = { 10, 35, 100, MASS_HEAVY };
 
-static unk_D_80A69248 D_80A69248[] = {
+// LLM generated name (HIGH), was D_80A69248: the fourteen waypoints the phantom horse gallops between, each carrying an XYZ position and the speed to hold on the way to it.
