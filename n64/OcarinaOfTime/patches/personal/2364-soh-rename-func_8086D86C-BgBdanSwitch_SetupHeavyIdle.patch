Date: Mon, 7 Sep 2026 23:24:04 +0000
Subject: [PATCH 2364/3799] soh: rename func_8086D86C ->
 BgBdanSwitch_SetupHeavyIdle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the YELLOW_HEAVY idle: installs the waiting action at full height
Defined in soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c         | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
index 2b3b0c774..b18de2a91 100644
--- a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
+++ b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
@@ -31,7 +31,8 @@ void BgBdanSwitch_Pressed(BgBdanSwitch* this, PlayState* play);  // was func_808
 void BgBdanSwitch_SetupRelease(BgBdanSwitch* this);  // was func_8086D7FC [LLM:HIGH]
 // LLM generated name (HIGH), was func_8086D80C: raises the switch by 0.2 a frame back to the idle
 void BgBdanSwitch_Release(BgBdanSwitch* this, PlayState* play);  // was func_8086D80C [LLM:HIGH]
-void func_8086D86C(BgBdanSwitch* this);
+// LLM generated name (HIGH), was func_8086D86C: the YELLOW_HEAVY idle: installs the waiting action at full height
+void BgBdanSwitch_SetupHeavyIdle(BgBdanSwitch* this);  // was func_8086D86C [LLM:HIGH]
 void func_8086D888(BgBdanSwitch* this, PlayState* play);
 void func_8086D8BC(BgBdanSwitch* this);
 void func_8086D8CC(BgBdanSwitch* this, PlayState* play);
@@ -191,7 +192,7 @@ void BgBdanSwitch_Init(Actor* thisx, PlayState* play) {
             if (flag) {
                 func_8086DB24(this);
             } else {
-                func_8086D86C(this);
+                BgBdanSwitch_SetupHeavyIdle(this);  // was func_8086D86C [LLM:HIGH]
             }
             break;
         case YELLOW_TALL_1:
@@ -332,7 +333,7 @@ void BgBdanSwitch_Release(BgBdanSwitch* this, PlayState* play) {
     }
 }
 
-void func_8086D86C(BgBdanSwitch* this) {
+void BgBdanSwitch_SetupHeavyIdle(BgBdanSwitch* this) {
     this->actionFunc = func_8086D888;
     this->unk_1C8 = 1.0f;
 }
@@ -404,7 +405,7 @@ void func_8086DAB4(BgBdanSwitch* this) {
 void func_8086DAC4(BgBdanSwitch* this, PlayState* play) {
     this->unk_1C8 += 0.2f;
     if (this->unk_1C8 >= 1.0f) {
-        func_8086D86C(this);
+        BgBdanSwitch_SetupHeavyIdle(this);  // was func_8086D86C [LLM:HIGH]
         Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_FOOT_SWITCH);
     }
 }
