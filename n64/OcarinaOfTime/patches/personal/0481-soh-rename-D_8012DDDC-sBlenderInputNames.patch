From e57824ae1e2c681944b4d5cbbb0f57d49d12ec11 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:41 +0000
Subject: [PATCH 481/488] soh: rename D_8012DDDC -> sBlenderInputNames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the four blender input words the render mode disassembler prints for each cycle slot
Defined in soh/src/code/ucode_disas.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/code/ucode_disas.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/ucode_disas.c b/soh/src/code/ucode_disas.c
index 0a4e192ed..3c7d24f96 100644
--- a/soh/src/code/ucode_disas.c
+++ b/soh/src/code/ucode_disas.c
@@ -201,7 +201,7 @@ void UCodeDisas_ParseRenderMode(UCodeDisas* this, u32 mode) {
         F3DZEX_RENDERMODE(ALPHA_CVG_SEL, 0x2000),
         F3DZEX_RENDERMODE(FORCE_BL, 0x4000),
     };
-    static const char* D_8012DDDC[4][4] = {
+    static const char* sBlenderInputNames[4][4] = {  // was D_8012DDDC [LLM:HIGH]
         { "G_BL_CLR_IN", "G_BL_CLR_MEM", "G_BL_CLR_BL", "G_BL_CLR_FOG" },
         { "G_BL_A_IN", "G_BL_A_FOG", "G_BL_A_SHADE", "G_BL_0" },
         { "G_BL_CLR_IN", "G_BL_CLR_MEM", "G_BL_CLR_BL", "G_BL_CLR_FOG" },
@@ -224,13 +224,13 @@ void UCodeDisas_ParseRenderMode(UCodeDisas* this, u32 mode) {
     b = (mode >> 16) & 0x3333;
 
     if (this->enableLog != 0) {
-        osSyncPrintf("\nGBL_c1(%s, %s, %s, %s)|", D_8012DDDC[0][a >> 12 & 3], D_8012DDDC[1][a >> 8 & 3],
-                     D_8012DDDC[2][a >> 4 & 3], D_8012DDDC[3][a >> 0 & 3]);
+        osSyncPrintf("\nGBL_c1(%s, %s, %s, %s)|", sBlenderInputNames[0][a >> 12 & 3], sBlenderInputNames[1][a >> 8 & 3],
+                     sBlenderInputNames[2][a >> 4 & 3], sBlenderInputNames[3][a >> 0 & 3]);  // was D_8012DDDC [LLM:HIGH]
     }
 
     if (this->enableLog) {
-        osSyncPrintf("\nGBL_c2(%s, %s, %s, %s)", D_8012DDDC[0][b >> 12 & 3], D_8012DDDC[1][b >> 8 & 3],
-                     D_8012DDDC[2][b >> 4 & 3], D_8012DDDC[3][b >> 0 & 3]);
+        osSyncPrintf("\nGBL_c2(%s, %s, %s, %s)", sBlenderInputNames[0][b >> 12 & 3], sBlenderInputNames[1][b >> 8 & 3],  // was D_8012DDDC [LLM:HIGH]
+                     sBlenderInputNames[2][b >> 4 & 3], sBlenderInputNames[3][b >> 0 & 3]);  // was D_8012DDDC [LLM:HIGH]
     }
 }
 
-- 
