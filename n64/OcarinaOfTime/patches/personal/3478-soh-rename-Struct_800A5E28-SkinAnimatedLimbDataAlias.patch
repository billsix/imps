From 112f7eaa061f9d5682282014666dd9ba1088081d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:20:38 +0000
Subject: [PATCH 3478/3799] soh: rename Struct_800A5E28 ->
 SkinAnimatedLimbDataAlias

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: a typedef alias of SkinAnimatedLimbData kept the same way
Defined in soh/include/z64skin.h.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/z64skin.h                | 3 ++-
 soh/soh/resource/type/SkeletonLimb.h | 6 +++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/z64skin.h b/soh/include/z64skin.h
index 1c710804e..0140e4aac 100644
--- a/soh/include/z64skin.h
+++ b/soh/include/z64skin.h
@@ -53,7 +53,8 @@ typedef struct {
 // LLM generated name (HIGH), was Struct_800A57C0: a typedef alias of SkinVertex kept for the address-named declarations
 typedef SkinVertex SkinVertexAlias;  // was Struct_800A57C0 [LLM:HIGH]
 typedef SkinTransformation Struct_800A598C_2;
-typedef SkinAnimatedLimbData Struct_800A5E28;
+// LLM generated name (HIGH), was Struct_800A5E28: a typedef alias of SkinAnimatedLimbData kept the same way
+typedef SkinAnimatedLimbData SkinAnimatedLimbDataAlias;  // was Struct_800A5E28 [LLM:HIGH]
 // LLM generated name (HIGH), was Struct_800A598C: a typedef alias of SkinLimbModif kept the same way
 typedef SkinLimbModif SkinLimbModifAlias;  // was Struct_800A598C [LLM:HIGH]
 
diff --git a/soh/soh/resource/type/SkeletonLimb.h b/soh/soh/resource/type/SkeletonLimb.h
index 42224d449..98afafc63 100644
--- a/soh/soh/resource/type/SkeletonLimb.h
+++ b/soh/soh/resource/type/SkeletonLimb.h
@@ -15,10 +15,10 @@ enum class LimbType {
 
 enum class ZLimbSkinType {
     SkinType_0,          // Segment = 0
-    SkinType_4 = 4,      // Segment = segmented address // Struct_800A5E28
+    SkinType_4 = 4,      // Segment = segmented address // SkinAnimatedLimbDataAlias
     SkinType_5 = 5,      // Segment = 0
     SkinType_DList = 11, // Segment = DList address
-};
+};  // was Struct_800A5E28 [LLM:HIGH]
 
 /**
  * Holds a compact version of a vertex used in the Skin system
@@ -131,4 +131,4 @@ class SkeletonLimb : public Ship::Resource<SkeletonLimbData> {
     std::vector<std::vector<SkinVertex>> skinLimbModifVertexArrays;
     std::vector<std::vector<SkinTransformation>> skinLimbModifTransformationArrays;
 };
-} // namespace SOH
\ No newline at end of file
+} // namespace SOH
