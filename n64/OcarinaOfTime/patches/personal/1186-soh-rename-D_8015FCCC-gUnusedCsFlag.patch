From a4e04265e7b3ff07a2032d4bcfb0cc932f139677 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:55:36 +0000
Subject: [PATCH 1186/3799] soh: rename D_8015FCCC -> gUnusedCsFlag

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment on its declaration reads "only written to, never read".
Defined in soh/src/code/z_demo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_demo.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_demo.c b/soh/src/code/z_demo.c
index 971009cb4..4f3218934 100644
--- a/soh/src/code/z_demo.c
+++ b/soh/src/code/z_demo.c
@@ -119,7 +119,8 @@ s16 sReturnToCamId;
 // Name from zeldaret/oot (was D_8015FCC8): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_demo.c]
 u8 gUseCutsceneCam;
 s16 sQuakeIndex;
-u16 D_8015FCCC;      // only written to, never read
+// LLM generated name (HIGH), was D_8015FCCC: the in-tree comment on its declaration reads "only written to, never read".
+u16 gUnusedCsFlag;      // only written to, never read, was D_8015FCCC [LLM:HIGH]
 char D_8015FCD0[20]; // unreferenced
 u8 D_8015FCE4;       // only written to, never read
 
@@ -2204,7 +2205,7 @@ void Cutscene_SetupScripted(PlayState* play, CutsceneContext* csCtx) {
 void Cutscene_InitUnusedState(PlayState* play) {
     s16 i;
 
-    D_8015FCCC = 0;
+    gUnusedCsFlag = 0;  // was D_8015FCCC [LLM:HIGH]
     for (i = 0; i < 20; i++) {
         ; // Empty Loop
     }
@@ -2213,8 +2214,8 @@ void Cutscene_InitUnusedState(PlayState* play) {
 
 // LLM generated name (GUESS), was func_8006907C: clears gUnusedCsFlag when it is set, and nothing else; nothing anywhere calls it.
 void Cutscene_ClearUnusedFlag(PlayState* play) {
-    if (D_8015FCCC != 0) {
-        D_8015FCCC = 0;
+    if (gUnusedCsFlag != 0) {  // was D_8015FCCC [LLM:HIGH]
+        gUnusedCsFlag = 0;  // was D_8015FCCC [LLM:HIGH]
     }
 }
 
