 void PreRender_CopyImageRegionImpl(PreRender* this, Gfx** gfxp);  // was func_800C1258 [oot]
-void func_800C170C(PreRender* this, Gfx** gfxp, void* fbuf, void* fbufSave, u32 r, u32 g, u32 b, u32 a);
+void PreRender_CopyImageTintedImpl(PreRender* this, Gfx** gfxp, void* fbuf, void* fbufSave, u32 r, u32 g, u32 b, u32 a);  // was func_800C170C [LLM:GUESS]
 void func_800C1AE8(PreRender* this, Gfx** gfxp, void* fbuf, void* fbufSave);
 void PreRender_CoverageRgba16ToI8(PreRender* this, Gfx** gfxp, void* fbuf, void* cvgSave);  // was func_800C1B24 [oot]
 void PreRender_SaveZBuffer(PreRender* this, Gfx** gfxp);  // was func_800C1E9C [oot]
diff --git a/soh/src/code/PreRender.c b/soh/src/code/PreRender.c
index 6ff229509..b8d93d9b4 100644
--- a/soh/src/code/PreRender.c
+++ b/soh/src/code/PreRender.c
@@ -136,7 +136,8 @@ void PreRender_CopyImageRegionImpl(PreRender* this, Gfx** gfxp) {
     *gfxp = gfx;
 }
 
-void func_800C170C(PreRender* this, Gfx** gfxp, void* fbuf, void* fbufSave, u32 r, u32 g, u32 b, u32 a) {
+// LLM generated name (GUESS), was func_800C170C: tiled blit from fbuf into fbufSave, differing from PreRender_CopyImage in that it runs in G_CYC_1CYCLE with a combiner that modulates the texel by the env colour rather than in copy mode; the r/g/b/a arguments are that env colour. Only its white-passing wrapper calls it, so "tinted" describes the capability, not any observed use.
+void PreRender_CopyImageTintedImpl(PreRender* this, Gfx** gfxp, void* fbuf, void* fbufSave, u32 r, u32 g, u32 b, u32 a) {
     Gfx* gfx;
     s32 x;
     s32 x2;
@@ -189,7 +190,7 @@ void func_800C170C(PreRender* this, Gfx** gfxp, void* fbuf, void* fbufSave, u32
 }
 
 void func_800C1AE8(PreRender* this, Gfx** gfxp, void* fbuf, void* fbufSave) {
-    func_800C170C(this, gfxp, fbuf, fbufSave, 255, 255, 255, 255);
+    PreRender_CopyImageTintedImpl(this, gfxp, fbuf, fbufSave, 255, 255, 255, 255);  // was func_800C170C [LLM:GUESS]
 }
 
