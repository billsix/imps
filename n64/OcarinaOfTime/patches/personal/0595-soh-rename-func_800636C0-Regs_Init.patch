-void func_800636C0(void);
+void Regs_Init(void);  // was func_800636C0 [oot]
 void DebugCamera_ScreenText(s32 arg0, s32 arg1, const char* text);  // was func_8006375C [oot]
 void func_8006376C(u8 x, u8 y, u8 colorId, const char* text);
 // ? func_80063828(?);
diff --git a/soh/src/code/main.c b/soh/src/code/main.c
