From 4c07defca5814eaffaf66a3e6328dcb67571d381 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:06:36 +0000
Subject: [PATCH 1975/3799] soh: rename D_8094A90C -> sTwinrovaEyeTexIndices

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the longer blink table indexed by work[TW_BLINK_IDX] for fused Twinrova's eyes
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index 7d1425821..7f2cef78e 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -2848,7 +2848,8 @@ static s16 sEyeTexIndices[] = {  // was D_8094A900 [LLM:HIGH]
     0, 1, 2, 2, 1,
 };
 
-static s16 D_8094A90C[] = {
+// LLM generated name (HIGH), was D_8094A90C: the longer blink table indexed by work[TW_BLINK_IDX] for fused Twinrova's eyes
+static s16 sTwinrovaEyeTexIndices[] = {  // was D_8094A90C [LLM:HIGH]
     0, 1, 2, 2, 2, 2, 2, 2, 1,
 };
 
@@ -3029,7 +3030,7 @@ void BossTw_TwinrovaUpdate(Actor* thisx, PlayState* play2) {
     }
 
     if (this->actionFunc == BossTw_TwinrovaMergeCS) {
-        this->leftEyeTexIdx = D_8094A90C[this->work[TW_BLINK_IDX]];
+        this->leftEyeTexIdx = sTwinrovaEyeTexIndices[this->work[TW_BLINK_IDX]];  // was D_8094A90C [LLM:HIGH]
         if (this->work[TW_BLINK_IDX] != 0) {
             this->work[TW_BLINK_IDX]--;
         }
