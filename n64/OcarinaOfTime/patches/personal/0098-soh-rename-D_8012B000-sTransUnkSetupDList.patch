From c282f909bbde7d44a819f7cc196b897a9e69d366 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 12:01:51 +0000
Subject: [PATCH 098/225] soh: rename D_8012B000 -> sTransUnkSetupDList

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/z_fbdemo.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/z_fbdemo.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_fbdemo.c b/soh/src/code/z_fbdemo.c
index e1e7dc5b3..2aa187ecf 100644
--- a/soh/src/code/z_fbdemo.c
+++ b/soh/src/code/z_fbdemo.c
@@ -17,7 +17,8 @@ Gfx sTransUnkBackgroundDL[] = {
     gsSPEndDisplayList(),
 };
 
-Gfx D_8012B000[] = {
+// LLM generated name (HIGH), was D_8012B000: Gfx display list run via gSPDisplayList before drawing TransitionUnk
+Gfx sTransUnkSetupDList[] = {
     gsDPPipeSync(),
     gsSPTexture(0x8000, 0x8000, 0, G_TX_RENDERTILE, G_ON),
     gsSPClearGeometryMode(G_ZBUFFER | G_SHADE | G_CULL_BOTH | G_FOG | G_LIGHTING | G_TEXTURE_GEN |
@@ -187,13 +188,13 @@ void TransitionUnk_SetData(TransitionUnk* this) {
 void TransitionUnk_Draw(TransitionUnk* this, Gfx** gfxP) {
     Gfx* gfx = *gfxP;
 
-    gSPDisplayList(gfx++, D_8012B000);
+    gSPDisplayList(gfx++, sTransUnkSetupDList);
     TransitionUnk_SetData(this);
     gSPMatrix(gfx++, &this->projection, G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_PROJECTION);
     gSPMatrix(gfx++, &this->modelView, G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
     gSPSegment(gfx++, 0xA, this->frame == 0 ? this->vtxFrame1 : this->vtxFrame2);
     gSPSegment(gfx++, 0xB, this->zBuffer);
-    gSPDisplayList(gfx++, D_8012B000);
+    gSPDisplayList(gfx++, sTransUnkSetupDList);
     gSPDisplayList(gfx++, this->gfx);
     gDPPipeSync(gfx++);
     this->frame ^= 1;
-- 
