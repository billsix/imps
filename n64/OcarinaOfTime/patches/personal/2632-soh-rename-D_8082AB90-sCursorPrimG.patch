From 39ce3e186e10f55b6fea2786d8472e1209b48aae Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:39 +0000
Subject: [PATCH 2632/3799] soh: rename D_8082AB90 -> sCursorPrimG

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: green of that same prim colour
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_scope_PAL.c   | 29 ++++++++++---------
 1 file changed, 15 insertions(+), 14 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index ef443604c..dfb88be9a 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -923,7 +923,8 @@ static u8 sButtonStatusByPage[][ARRAY_COUNT(gSaveContext.buttonStatus)] = {  //
 
 // LLM generated name (HIGH), was D_8082AB8C: red of the pause cursor prim colour, eased toward the current cursor colour set
 static s16 sCursorPrimR = 0;  // was D_8082AB8C [LLM:HIGH]
-static s16 D_8082AB90 = 0;
+// LLM generated name (HIGH), was D_8082AB90: green of that same prim colour
+static s16 sCursorPrimG = 0;  // was D_8082AB90 [LLM:HIGH]
 static s16 D_8082AB94 = 0;
 static s16 D_8082AB98 = 255;
 
@@ -1372,7 +1373,7 @@ void KaleidoScope_DrawCursor(PlayState* play, u16 pageIndex) {
             gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, sCursorColors[pauseCtx->cursorColorSet >> 2].r,
                             sCursorColors[pauseCtx->cursorColorSet >> 2].g,
                             sCursorColors[pauseCtx->cursorColorSet >> 2].b, 255);
-            gDPSetEnvColor(POLY_OPA_DISP++, sCursorPrimR, D_8082AB90, D_8082AB94, 255);  // was D_8082AB8C [LLM:HIGH]
+            gDPSetEnvColor(POLY_OPA_DISP++, sCursorPrimR, sCursorPrimG, D_8082AB94, 255);  // was D_8082AB8C [LLM:HIGH]
             gSPVertex(POLY_OPA_DISP++, pauseCtx->cursorVtx, 16, 0);
 
             for (i = j = 0; i < 4; i++, j += 4) {
@@ -1463,17 +1464,17 @@ void KaleidoScope_DrawPages(PlayState* play, GraphicsContext* gfxCtx) {
     if ((pauseCtx->state < 8) || (pauseCtx->state > 0x11)) {
         if (pauseCtx->state != 7) {
             stepR = ABS(sCursorPrimR - D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].r) / D_8082AD3C;  // was D_8082AB8C [LLM:HIGH]
-            stepG = ABS(D_8082AB90 - D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].g) / D_8082AD3C;
+            stepG = ABS(sCursorPrimG - D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].g) / D_8082AD3C;  // was D_8082AB90 [LLM:HIGH]
             stepB = ABS(D_8082AB94 - D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].b) / D_8082AD3C;
             if (sCursorPrimR >= D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].r) {  // was D_8082AB8C [LLM:HIGH]
                 sCursorPrimR -= stepR;  // was D_8082AB8C [LLM:HIGH]
             } else {
                 sCursorPrimR += stepR;  // was D_8082AB8C [LLM:HIGH]
             }
-            if (D_8082AB90 >= D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].g) {
-                D_8082AB90 -= stepG;
+            if (sCursorPrimG >= D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].g) {  // was D_8082AB90 [LLM:HIGH]
+                sCursorPrimG -= stepG;  // was D_8082AB90 [LLM:HIGH]
             } else {
-                D_8082AB90 += stepG;
+                sCursorPrimG += stepG;  // was D_8082AB90 [LLM:HIGH]
             }
             if (D_8082AB94 >= D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].b) {
                 D_8082AB94 -= stepB;
@@ -1484,7 +1485,7 @@ void KaleidoScope_DrawPages(PlayState* play, GraphicsContext* gfxCtx) {
             D_8082AD3C--;
             if (D_8082AD3C == 0) {
                 sCursorPrimR = D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].r;  // was D_8082AB8C [LLM:HIGH]
-                D_8082AB90 = D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].g;
+                sCursorPrimG = D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].g;  // was D_8082AB90 [LLM:HIGH]
                 D_8082AB94 = D_8082ACF4[pauseCtx->cursorColorSet + D_8082AD40].b;
                 D_8082AD3C = ZREG(28 + D_8082AD40);
                 D_8082AD40++;
@@ -3469,7 +3470,7 @@ void KaleidoScope_DrawGameOver(PlayState* play) {
     gDPSetCombineLERP(POLY_OPA_DISP++, TEXEL1, TEXEL0, PRIM_LOD_FRAC, TEXEL0, 0, 0, 0, TEXEL0, PRIMITIVE, ENVIRONMENT,
                       COMBINED, ENVIRONMENT, COMBINED, 0, PRIMITIVE, 0);
 
-    gDPSetPrimColor(POLY_OPA_DISP++, 0, 80, sCursorPrimR, D_8082AB90, D_8082AB94, D_8082AB98);  // was D_8082AB8C [LLM:HIGH]
+    gDPSetPrimColor(POLY_OPA_DISP++, 0, 80, sCursorPrimR, sCursorPrimG, D_8082AB94, D_8082AB98);  // was D_8082AB8C [LLM:HIGH]
     gDPSetEnvColor(POLY_OPA_DISP++, D_8082AB9C, D_8082ABA0, D_8082ABA4, 255);
 
     VREG(89) -= 2;
@@ -4568,7 +4569,7 @@ void KaleidoScope_Update(PlayState* play) {
 #endif
 
             sCursorPrimR = 255;  // was D_8082AB8C [LLM:HIGH]
-            D_8082AB90 = 130;
+            sCursorPrimG = 130;  // was D_8082AB90 [LLM:HIGH]
             D_8082AB94 = 0;
             D_8082AB98 = 0;
             D_8082AB9C = 30;
@@ -4582,7 +4583,7 @@ void KaleidoScope_Update(PlayState* play) {
 
         case 0xB:
             stepR = ABS(sCursorPrimR - 30) / D_8082B260;  // was D_8082AB8C [LLM:HIGH]
-            stepG = ABS(D_8082AB90) / D_8082B260;
+            stepG = ABS(sCursorPrimG) / D_8082B260;  // was D_8082AB90 [LLM:HIGH]
             stepB = ABS(D_8082AB94) / D_8082B260;
             stepA = ABS(D_8082AB98 - 255) / D_8082B260;
             if (sCursorPrimR >= 30) {  // was D_8082AB8C [LLM:HIGH]
@@ -4590,10 +4591,10 @@ void KaleidoScope_Update(PlayState* play) {
             } else {
                 sCursorPrimR += stepR;  // was D_8082AB8C [LLM:HIGH]
             }
-            if (D_8082AB90 >= 0) {
-                D_8082AB90 -= stepG;
+            if (sCursorPrimG >= 0) {  // was D_8082AB90 [LLM:HIGH]
+                sCursorPrimG -= stepG;  // was D_8082AB90 [LLM:HIGH]
             } else {
-                D_8082AB90 += stepG;
+                sCursorPrimG += stepG;  // was D_8082AB90 [LLM:HIGH]
             }
             if (D_8082AB94 >= 0) {
                 D_8082AB94 -= stepB;
@@ -4628,7 +4629,7 @@ void KaleidoScope_Update(PlayState* play) {
             D_8082B260--;
             if (D_8082B260 == 0) {
                 sCursorPrimR = 30;  // was D_8082AB8C [LLM:HIGH]
-                D_8082AB90 = 0;
+                sCursorPrimG = 0;  // was D_8082AB90 [LLM:HIGH]
                 D_8082AB94 = 0;
                 D_8082AB98 = 255;
 
