From 9fd50160610b61d4bb5ea8702d7e35d242e2ef64 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:38:47 +0000
Subject: [PATCH 1709/3799] soh: rename D_80AFA0DC -> sBlobRowsClass3

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-row half-widths of the smallest brush, used for size class 3.
Defined in soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
index 69d73aacc..d1ece6f08 100644
--- a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
+++ b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
@@ -32,7 +32,8 @@ const ActorInit En_Sda_InitVars = {
 
 static Vec3f D_80AFA0D0 = { 0.0f, 0.0f, 0.0f };
 
-static s16 D_80AFA0DC[] = {
+// LLM generated name (HIGH), was D_80AFA0DC: the per-row half-widths of the smallest brush, used for size class 3.
+static s16 sBlobRowsClass3[] = {  // was D_80AFA0DC [LLM:HIGH]
     1, 2, 3, 3, 2, 1,
 };
 
@@ -227,7 +228,7 @@ void func_80AF8F60(Player* player, u8* shadowTexture, f32 arg2) {
                 }
             } else {
                 for (j = 0, phi_a3 = -0x80; j < 6; j++, phi_a3 += 0x40) {
-                    for (phi_a0 = -D_80AFA0DC[j]; phi_a0 < D_80AFA0DC[j] - 1; phi_a0++) {
+                    for (phi_a0 = -sBlobRowsClass3[j]; phi_a0 < sBlobRowsClass3[j] - 1; phi_a0++) {  // was D_80AFA0DC [LLM:HIGH]
                         temp_v1 = temp_t0 + phi_a0;
                         if ((temp_v1 >= 0) && (temp_v1 < 0x40)) {
                             temp_v0 = temp_t1 + phi_a3;
-- 
