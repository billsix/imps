From 23745834885f3178d2411c1b9d2b0f5e65ccbc47 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:16:06 +0000
Subject: [PATCH 1387/3799] soh: rename func_80A89294 -> EnJs_SetupOffer

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the offer action and starts the idle animation.
Defined in soh/src/overlays/actors/ovl_En_Js/z_en_js.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Js/z_en_js.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Js/z_en_js.c b/soh/src/overlays/actors/ovl_En_Js/z_en_js.c
index 86046e966..86a0b5075 100644
--- a/soh/src/overlays/actors/ovl_En_Js/z_en_js.c
+++ b/soh/src/overlays/actors/ovl_En_Js/z_en_js.c
@@ -168,7 +168,8 @@ void func_80A891C4(EnJs* this, PlayState* play) {
     }
 }
 
-void func_80A89294(EnJs* this) {
+// LLM generated name (HIGH), was func_80A89294: installs the offer action and starts the idle animation.
+void EnJs_SetupOffer(EnJs* this) {
     En_Js_SetupAction(this, func_80A891C4);
     Animation_Change(&this->skelAnime, &gCarpetMerchantIdleAnim, 1.0f, 0.0f,
                      Animation_GetLastFrame(&gCarpetMerchantIdleAnim), ANIMMODE_ONCE, -4.0f);
@@ -176,7 +177,7 @@ void func_80A89294(EnJs* this) {
 
 void EnJs_Idle(EnJs* this, PlayState* play) {
     if (EnJs_OfferTalk(this, play, 0x6077)) {  // was func_80A88F64 [LLM:HIGH]
-        func_80A89294(this);
+        EnJs_SetupOffer(this);  // was func_80A89294 [LLM:HIGH]
     }
 }
 
