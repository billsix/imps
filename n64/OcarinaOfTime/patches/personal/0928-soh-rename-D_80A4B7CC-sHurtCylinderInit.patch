From f5db89d0fd4daecf5553deeed8b292a6c1a594f0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:27:07 +0000
Subject: [PATCH 0928/3799] soh: rename D_80A4B7CC -> sHurtCylinderInit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: ColliderCylinderInit for colCyl2, with AT_NONE and AC_ON | AC_TYPE_PLAYER, so it is the collider that receives the player's attacks.
Defined in soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c b/soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c
index 45a09f90a..fde161f82 100644
--- a/soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c
+++ b/soh/src/overlays/actors/ovl_En_Goma/z_en_goma.c
@@ -81,7 +81,8 @@ static ColliderCylinderInit sAttackCylinderInit = {  // was D_80A4B7A0 [LLM:HIGH
     { 15, 30, 10, { 0, 0, 0 } },
 };
 
-static ColliderCylinderInit D_80A4B7CC = {
+// LLM generated name (HIGH), was D_80A4B7CC: ColliderCylinderInit for colCyl2, with AT_NONE and AC_ON | AC_TYPE_PLAYER, so it is the collider that receives the player's attacks.
+static ColliderCylinderInit sHurtCylinderInit = {  // was D_80A4B7CC [LLM:HIGH]
     {
         COLTYPE_HIT3,
         AT_NONE,
@@ -176,7 +177,7 @@ void EnGoma_Init(Actor* thisx, PlayState* play) {
         Collider_InitCylinder(play, &this->colCyl1);
         Collider_SetCylinder(play, &this->colCyl1, &this->actor, &sAttackCylinderInit);  // was D_80A4B7A0 [LLM:HIGH]
         Collider_InitCylinder(play, &this->colCyl2);
-        Collider_SetCylinder(play, &this->colCyl2, &this->actor, &D_80A4B7CC);
+        Collider_SetCylinder(play, &this->colCyl2, &this->actor, &sHurtCylinderInit);  // was D_80A4B7CC [LLM:HIGH]
     }
 }
 
