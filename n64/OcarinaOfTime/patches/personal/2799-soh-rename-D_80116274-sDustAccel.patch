From 2f581af692a9b3d747d4158329a0cc1aabc15589 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:38 +0000
Subject: [PATCH 2799/3799] soh: rename D_80116274 -> sDustAccel

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the acceleration it passes with it
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index e91e37884..dd7a1ea37 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -4806,7 +4806,8 @@ void Actor_SpawnWoodDust(PlayState* play, Vec3f* pos, Vec3f* velocity, Vec3f* ac
 
 // LLM generated name (HIGH), was D_80116268: the velocity Actor_SpawnWoodDustAtPos passes
 Vec3f sDustVelocity = { 0.0f, -1.5f, 0.0f };  // was D_80116268 [LLM:HIGH]
-Vec3f D_80116274 = { 0.0f, -0.2f, 0.0f };
+// LLM generated name (HIGH), was D_80116274: the acceleration it passes with it
+Vec3f sDustAccel = { 0.0f, -0.2f, 0.0f };  // was D_80116274 [LLM:HIGH]
 
 Gfx D_80116280[] = {
     gsDPSetRenderMode(G_RM_FOG_SHADE_A, AA_EN | Z_CMP | Z_UPD | IM_RD | CLR_ON_CVG | CVG_DST_WRAP | ZMODE_XLU |
@@ -4817,7 +4818,7 @@ Gfx D_80116280[] = {
 
 // LLM generated name (GUESS), was func_800355B8: Actor_SpawnWoodDust with the file's shared velocity and acceleration
 void Actor_SpawnWoodDustAtPos(PlayState* play, Vec3f* pos) {
-    Actor_SpawnWoodDust(play, pos, &sDustVelocity, &D_80116274);  // was func_8003555C [LLM:GUESS]
+    Actor_SpawnWoodDust(play, pos, &sDustVelocity, &sDustAccel);  // was func_8003555C [LLM:GUESS]
 }
 
 // LLM generated name (GUESS), was func_800355E4: true for a player-type AC collider while meleeWeaponAnimation is 0x16; that animation number is not otherwise named
