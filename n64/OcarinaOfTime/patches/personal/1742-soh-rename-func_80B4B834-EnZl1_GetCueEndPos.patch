Date: Mon, 7 Sep 2026 22:40:08 +0000
Subject: [PATCH 1742/3799] soh: rename func_80B4B834 -> EnZl1_GetCueEndPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: copies an actor cue's end position into a Vec3f.
Defined in soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c b/soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c
index 5f5147358..604c1725a 100644
--- a/soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c
+++ b/soh/src/overlays/actors/ovl_En_Zl1/z_en_zl1.c
@@ -351,7 +351,8 @@ void EnZl1_GetCueStartPos(CsCmdActorCue* npcAction, Vec3f* pos) {
     pos->z = npcAction->startPos.z;
 }
 
-void func_80B4B834(CsCmdActorCue* npcAction, Vec3f* pos) {
+// LLM generated name (HIGH), was func_80B4B834: copies an actor cue's end position into a Vec3f.
+void EnZl1_GetCueEndPos(CsCmdActorCue* npcAction, Vec3f* pos) {
     pos->x = npcAction->endPos.x;
     pos->y = npcAction->endPos.y;
     pos->z = npcAction->endPos.z;
@@ -400,7 +401,7 @@ void func_80B4B8B4(EnZl1* this, PlayState* play) {
     npcAction = play->csCtx.npcActions[0];
     if (npcAction != NULL) {
         EnZl1_GetCueStartPos(npcAction, &sp74);  // was func_80B4B7F4 [LLM:HIGH]
-        func_80B4B834(npcAction, &sp68);
+        EnZl1_GetCueEndPos(npcAction, &sp68);  // was func_80B4B834 [LLM:HIGH]
         if (this->unk_1E6 == 0) {
             sp48 = sp74;
             this->actor.home.pos = sp48;
@@ -476,7 +477,7 @@ void func_80B4BC78(EnZl1* this, PlayState* play) {
     npcAction = play->csCtx.npcActions[0];
     if (npcAction != NULL) {
         EnZl1_GetCueStartPos(npcAction, &sp70);  // was func_80B4B7F4 [LLM:HIGH]
-        func_80B4B834(npcAction, &sp64);
+        EnZl1_GetCueEndPos(npcAction, &sp64);  // was func_80B4B834 [LLM:HIGH]
         if (this->unk_1E6 == 0) {
             this->actor.world.pos = this->actor.home.pos = sp70;
         }
