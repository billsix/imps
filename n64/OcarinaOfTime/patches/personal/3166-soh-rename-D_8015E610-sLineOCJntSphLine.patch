From c7773c807000bb3e4477b277caadffb0c14bf6a3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:50 +0000
Subject: [PATCH 3166/3799] soh: rename D_8015E610 -> sLineOCJntSphLine

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the line segment CollisionCheck_LineOC_JntSph tests each sphere against
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index c4bc6e050..a9b4dff1d 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -3106,7 +3106,7 @@ void CollisionCheck_Damage(PlayState* play, CollisionCheckContext* colChkCtx) {
  */
 s32 CollisionCheck_LineOC_JntSph(PlayState* play, CollisionCheckContext* colChkCtx, Collider* collider, Vec3f* a,
                                  Vec3f* b) {
-    static Linef D_8015E610;
+    static Linef sLineOCJntSphLine;  // was D_8015E610 [LLM:HIGH]
     ColliderJntSph* jntSph = (ColliderJntSph*)collider;
     s32 i;
 
@@ -3116,9 +3116,9 @@ s32 CollisionCheck_LineOC_JntSph(PlayState* play, CollisionCheckContext* colChkC
         if (!(element->info.ocElemFlags & OCELEM_ON)) {
             continue;
         }
-        D_8015E610.a = *a;
-        D_8015E610.b = *b;
-        if (Math3D_LineVsSph(&element->dim.worldSphere, &D_8015E610) == 1) {
+        sLineOCJntSphLine.a = *a;  // was D_8015E610 [LLM:HIGH]
+        sLineOCJntSphLine.b = *b;  // was D_8015E610 [LLM:HIGH]
+        if (Math3D_LineVsSph(&element->dim.worldSphere, &sLineOCJntSphLine) == 1) {  // was D_8015E610 [LLM:HIGH]
             return true;
         }
     }
