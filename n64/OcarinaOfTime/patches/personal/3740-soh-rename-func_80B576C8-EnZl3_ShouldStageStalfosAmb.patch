         this->action = 0x1F;
         this->unk_3CC = 0.0f;
         EnZl3_StepYawTowardsPlayer(this);  // was func_80B537E8 [LLM:HIGH]
         this->unk_3D8 = 1;
         OnePointCutscene_Init(play, 4010, -99, &this->actor, CAM_ID_MAIN);
-    } else if (!func_80B57C8C(this) && !func_80B576C8(this, play) && EnZl3_ShouldWaitForPlayer(this, play)) {  // was func_80B57564 [LLM:GUESS]
+    } else if (!func_80B57C8C(this) && !EnZl3_ShouldStageStalfosAmbush(this, play) && EnZl3_ShouldWaitForPlayer(this, play)) {  // was func_80B57564 [LLM:GUESS]
         EnZl3_ChangeAnim(this, &gZelda2Anime2Anim_009BE4, 0, -8.0f, 0);  // was func_80B54E14 [LLM:HIGH]
         EnZl3_PlayWaypointCutscene(this, play);  // was func_80B5764C [LLM:GUESS]
         this->action = 34;
