From 8ec6aeaf1066fd827a882a1b9642078af7c53549 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:02 +0000
Subject: [PATCH 3377/3799] soh: rename D_809AA560 -> sBuoyancyParams

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the constants EffectSsKakera_ApplyBuoyancy floats a shard on water with
Defined in soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c   | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
index decae86a6..39e9ad157 100644
--- a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
+++ b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
@@ -251,13 +251,13 @@ s32 EffectSsKakera_ApplyAttraction(EffectSs* this, Vec3f* diff, f32 dist) {
 
 // LLM generated name (HIGH), was func_809A9F10: the second force pass: adds one of seven fixed vertical accelerations, chosen by the next bits of the behaviour flags.
 s32 EffectSsKakera_ApplyBuoyancy(EffectSs* this, Vec3f* diff, f32 dist) {
-    static f32 D_809AA560[] = { 4.0f, 0.1f, 0.3f, 0.9f, -0.1f, -0.3f, -0.9f };
+    static f32 sBuoyancyParams[] = { 4.0f, 0.1f, 0.3f, 0.9f, -0.1f, -0.3f, -0.9f };  // was D_809AA560 [LLM:HIGH]
     s32 temp_v0;
 
     temp_v0 = (this->rReg0 >> 2) & 7;
 
     if (temp_v0 != 0) {
-        this->accel.y += D_809AA560[temp_v0];
+        this->accel.y += sBuoyancyParams[temp_v0];  // was D_809AA560 [LLM:HIGH]
     }
 
     return 1;
-- 
