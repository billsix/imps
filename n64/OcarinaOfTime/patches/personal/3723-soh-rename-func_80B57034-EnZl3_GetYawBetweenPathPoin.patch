Date: Tue, 8 Sep 2026 02:01:50 +0000
Subject: [PATCH 3723/3799] soh: rename func_80B57034 ->
 EnZl3_GetYawBetweenPathPoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: Math_FAtan2F of the xz delta between two path points, in binary angle units
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 85bb06a48..c2584524d 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -1736,7 +1736,8 @@ Vec3s* EnZl3_GetPathPoint(EnZl3* this, s32 arg1) {
     return NULL;
 }
 
-s32 func_80B57034(EnZl3* this, s32 arg1, s32 arg2) {
+// LLM generated name (HIGH), was func_80B57034: Math_FAtan2F of the xz delta between two path points, in binary angle units
+s32 EnZl3_GetYawBetweenPathPoints(EnZl3* this, s32 arg1, s32 arg2) {
     Vec3s* vec1 = EnZl3_GetPathPoint(this, arg1);  // was func_80B56FAC [LLM:HIGH]
     Vec3s* vec2 = EnZl3_GetPathPoint(this, arg2);  // was func_80B56FAC [LLM:HIGH]
 
@@ -1771,7 +1772,7 @@ s32 func_80B571A8(EnZl3* this) {
     if (EnZl3_PathHasPoint(this, unk_314 + 1) == 0) {  // was func_80B56F8C [LLM:GUESS]
         return this->actor.shape.rot.y;
     } else {
-        return func_80B57034(this, unk_314, unk_314 + 1);
+        return EnZl3_GetYawBetweenPathPoints(this, unk_314, unk_314 + 1);  // was func_80B57034 [LLM:HIGH]
     }
 }
 
