 void EnGo_FinishGetItem(EnGo* this, PlayState* play);  // was func_80A40C78 [LLM:HIGH]
 void EnGo_Eyedrops(EnGo* this, PlayState* play);
-void func_80A40DCC(EnGo* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A40DCC: waits out the eye-drops line, resets the animation and hands over to the get-item state.
+void EnGo_WaitForEyedropsText(EnGo* this, PlayState* play);  // was func_80A40DCC [LLM:HIGH]
 
