     this->actor.shape.shadowAlpha = 0;
 }
 
-void func_8098394C(DemoIk* this, PlayState* play) {
+// LLM generated name (HIGH), was func_8098394C: the type 1 cue-2 handler: ends any movement, snaps to the cue's start position, restores the shadow and switches to action mode 1 with the animation rewound.
+void DemoIk_Type1SetupAppear(DemoIk* this, PlayState* play) {
     DemoIk_EndMove(this);
     DemoIk_MoveToStartPos(this, play, DemoIk_GetIndexFromParams(this->actor.params));
     this->actionMode = 1;
@@ -218,7 +219,7 @@ void func_809839D0(DemoIk* this, PlayState* play) {
