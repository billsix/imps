From 9504f05784c8456544c5acd64aa0f8661c0206c2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:09 +0000
Subject: [PATCH 2431/3799] soh: rename func_80ADEAC4 -> EnPoh_Hover

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: hovers at the player's height until the player comes within 200 units or the timer runs out
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index 52c3ee908..227f1d5d0 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -22,7 +22,8 @@ void EnPoh_DrawRegular(Actor* thisx, PlayState* play);
 void EnPoh_DrawComposer(Actor* thisx, PlayState* play);
 void EnPoh_DrawSoul(Actor* thisx, PlayState* play);
 
-void func_80ADEAC4(EnPoh* this, PlayState* play);
+// LLM generated name (HIGH), was func_80ADEAC4: hovers at the player's height until the player comes within 200 units or the timer runs out
+void EnPoh_Hover(EnPoh* this, PlayState* play);  // was func_80ADEAC4 [LLM:HIGH]
 void EnPoh_Idle(EnPoh* this, PlayState* play);
 void func_80ADEC9C(EnPoh* this, PlayState* play);
 void EnPoh_Attack(EnPoh* this, PlayState* play);
@@ -263,7 +264,7 @@ void EnPoh_Destroy(Actor* thisx, PlayState* play) {
 void EnPoh_SetupHover(EnPoh* this) {
     Animation_PlayLoop(&this->skelAnime, this->info->idleAnim);
     this->unk_198 = Rand_S16Offset(2, 3);
-    this->actionFunc = func_80ADEAC4;
+    this->actionFunc = EnPoh_Hover;  // was func_80ADEAC4 [LLM:HIGH]
     this->actor.speedXZ = 0.0f;
 }
 
@@ -492,7 +493,7 @@ void EnPoh_TurnTowardHome(EnPoh* this) {
     Math_ScaledStepToS(&this->actor.world.rot.y, this->unk_19C, 0x71C);
 }
 
-void func_80ADEAC4(EnPoh* this, PlayState* play) {
+void EnPoh_Hover(EnPoh* this, PlayState* play) {
     SkelAnime_Update(&this->skelAnime);
     if (Animation_OnFrame(&this->skelAnime, 0.0f) && this->unk_198 != 0) {
         this->unk_198--;
@@ -907,13 +908,13 @@ void EnPoh_UpdateVisibility(EnPoh* this) {
                 this->unk_194 = 0;
             }
             if ((this->unk_194 == 20 || this->visibilityTimer == 0) &&
-                (this->actionFunc == func_80ADEAC4 || this->actionFunc == EnPoh_Idle ||
+                (this->actionFunc == EnPoh_Hover || this->actionFunc == EnPoh_Idle ||  // was func_80ADEAC4 [LLM:HIGH]
                  this->actionFunc == func_80ADEC9C || this->actionFunc == func_80ADF894 ||
                  this->actionFunc == func_80ADF5E0)) {
                 EnPoh_SetupDisappear(this);
             }
         } else if (this->lightColor.a == 0 && this->visibilityTimer == 0 &&
-                   (this->actionFunc == func_80ADEAC4 || this->actionFunc == EnPoh_Idle ||
+                   (this->actionFunc == EnPoh_Hover || this->actionFunc == EnPoh_Idle ||  // was func_80ADEAC4 [LLM:HIGH]
                     this->actionFunc == func_80ADEC9C || this->actionFunc == func_80ADF5E0)) {
             EnPoh_SetupAppear(this);
         }
