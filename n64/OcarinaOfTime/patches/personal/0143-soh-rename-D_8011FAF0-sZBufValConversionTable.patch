From ecaf91bb05a24da190d5de1f071f51fd35d922bf Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:10 +0000
Subject: [PATCH 143/488] soh: rename D_8011FAF0 -> sZBufValConversionTable

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.89.
Defined in soh/src/code/z_kankyo.c.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/code/z_kankyo.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_kankyo.c b/soh/src/code/z_kankyo.c
index dee201b8d..9240a6c7d 100644
--- a/soh/src/code/z_kankyo.c
+++ b/soh/src/code/z_kankyo.c
@@ -44,7 +44,8 @@ typedef struct {
     /* 0x04 */ s32 unk_04;
 } Struct_8011FAF0; // size = 0x8
 
-Struct_8011FAF0 D_8011FAF0[] = {
+// Name from zeldaret/oot (was D_8011FAF0): adopted upstream's name for this address; body verified to match upstream at 0.89. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_kankyo.c]
+Struct_8011FAF0 sZBufValConversionTable[] = {
     { 6, 0x00000000 }, { 5, 0x00020000 }, { 4, 0x00030000 }, { 3, 0x00038000 },
     { 2, 0x0003C000 }, { 1, 0x0003E000 }, { 0, 0x0003F000 }, { 0, 0x0003F800 },
 };
@@ -234,7 +235,7 @@ void LoadSkyboxTex(SkyboxContext* skyboxCtx, int segmentIndex, int imageIndex, c
 void Skybox_Update(SkyboxContext* skyboxCtx);
 
 s32 func_8006F0A0(s32 a0) {
-    s32 ret = ((a0 >> 4 & 0x7FF) << D_8011FAF0[a0 >> 15 & 7].unk_00) + D_8011FAF0[a0 >> 15 & 7].unk_04;
+    s32 ret = ((a0 >> 4 & 0x7FF) << sZBufValConversionTable[a0 >> 15 & 7].unk_00) + sZBufValConversionTable[a0 >> 15 & 7].unk_04;
 
     return ret;
 }
