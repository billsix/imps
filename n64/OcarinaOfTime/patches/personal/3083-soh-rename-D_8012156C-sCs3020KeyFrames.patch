From f644f7fd1c9125f3191eea7434b54e96a24ebe64 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:38 +0000
Subject: [PATCH 3083/3799] soh: rename D_8012156C -> sCs3020KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 3020 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 18 +++++++++---------
 soh/src/code/z_onepointdemo_data.inc |  3 ++-
 2 files changed, 11 insertions(+), 10 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 38536db46..94e65e6a0 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -28,7 +28,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs4510KeyFrames)                                   \
     F(sCs2210KeyFrames)                                   \
     F(sCs3040KeyFrames)                                   \
-    F(D_8012156C)                                   \
+    F(sCs3020KeyFrames)                                   \
     F(D_801215BC)                                   \
     F(D_80121C24)                                   \
     F(D_80121D3C)                                   \
@@ -412,18 +412,18 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
             break;
         case 3020:
-            D_8012156C[1].timerInit = timer - 1;
+            sCs3020KeyFrames[1].timerInit = timer - 1;  // was D_8012156C [LLM:HIGH]
             if (mainCam->play->state.frames & 1) {
-                D_8012156C[0].atTargetInit.x = -D_8012156C[0].atTargetInit.x;
-                D_8012156C[0].eyeTargetInit.x = -D_8012156C[0].eyeTargetInit.x;
-                D_8012156C[1].atTargetInit.x = -D_8012156C[1].atTargetInit.x;
-                D_8012156C[1].eyeTargetInit.x = -D_8012156C[1].eyeTargetInit.x;
+                sCs3020KeyFrames[0].atTargetInit.x = -sCs3020KeyFrames[0].atTargetInit.x;  // was D_8012156C [LLM:HIGH]
+                sCs3020KeyFrames[0].eyeTargetInit.x = -sCs3020KeyFrames[0].eyeTargetInit.x;  // was D_8012156C [LLM:HIGH]
+                sCs3020KeyFrames[1].atTargetInit.x = -sCs3020KeyFrames[1].atTargetInit.x;  // was D_8012156C [LLM:HIGH]
+                sCs3020KeyFrames[1].eyeTargetInit.x = -sCs3020KeyFrames[1].eyeTargetInit.x;  // was D_8012156C [LLM:HIGH]
             }
             tempRand = Rand_ZeroOne() * 15.0f;
-            D_8012156C[0].eyeTargetInit.x += tempRand;
-            D_8012156C[1].eyeTargetInit.x += tempRand;
+            sCs3020KeyFrames[0].eyeTargetInit.x += tempRand;  // was D_8012156C [LLM:HIGH]
+            sCs3020KeyFrames[1].eyeTargetInit.x += tempRand;  // was D_8012156C [LLM:HIGH]
 
-            csInfo->keyFrames = D_8012156C;
+            csInfo->keyFrames = sCs3020KeyFrames;  // was D_8012156C [LLM:HIGH]
             csInfo->keyFrameCnt = 2;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index a1cecaa54..285c218e5 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -294,7 +294,8 @@ static OnePointCsFull sCs3040KeyFrames[2] = {  // was D_8012151C [LLM:HIGH]
     { 0x12, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
 };
 
-static OnePointCsFull D_8012156C[2] = {
+// LLM generated name (HIGH), was D_8012156C: the keyframe set one-point cutscene 3020 installs
+static OnePointCsFull sCs3020KeyFrames[2] = {  // was D_8012156C [LLM:HIGH]
     { 0x8F, 0x4D, 0x4242, 1, 0, 65.0f, 1.0f, { 60.0f, 30.0f, 0.0f }, { 50.0f, 20.0f, 150.0f } },
     { 0x81, 0xFF, 0x4242, -1, 0, 65.0f, 1.0f, { -50.0f, 60.0f, 0.0f }, { -60.0f, 40.0f, 150.0f } },
 };
