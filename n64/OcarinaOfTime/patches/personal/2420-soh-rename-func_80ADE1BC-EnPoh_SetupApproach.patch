From 1aeb2b8916962339e97d3744a45b42a33a79b3ea Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:08 +0000
Subject: [PATCH 2420/3799] soh: rename func_80ADE1BC -> EnPoh_SetupApproach

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loops the second idle animation and starts drifting at speed 2
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index 9fcfeef29..d9363a27f 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -273,7 +273,8 @@ void EnPoh_SetupIdle(EnPoh* this) {
     this->actionFunc = EnPoh_Idle;
 }
 
-void func_80ADE1BC(EnPoh* this) {
+// LLM generated name (HIGH), was func_80ADE1BC: loops the second idle animation and starts drifting at speed 2
+void EnPoh_SetupApproach(EnPoh* this) {
     Animation_PlayLoop(&this->skelAnime, this->info->idleAnim2);
     this->actionFunc = func_80ADEC9C;
     this->unk_198 = 0;
@@ -488,7 +489,7 @@ void func_80ADEAC4(EnPoh* this, PlayState* play) {
     }
     EnPoh_MoveTowardsPlayerHeight(this, play);
     if (this->actor.xzDistToPlayer < 200.0f) {
-        func_80ADE1BC(this);
+        EnPoh_SetupApproach(this);  // was func_80ADE1BC [LLM:HIGH]
     } else if (this->unk_198 == 0) {
         EnPoh_SetupIdle(this);
     }
@@ -506,7 +507,7 @@ void EnPoh_Idle(EnPoh* this, PlayState* play) {
     func_80ADEA5C(this);
     EnPoh_MoveTowardsPlayerHeight(this, play);
     if (this->actor.xzDistToPlayer < 200.0f && this->unk_198 < 19) {
-        func_80ADE1BC(this);
+        EnPoh_SetupApproach(this);  // was func_80ADE1BC [LLM:HIGH]
     } else if (this->unk_198 == 0) {
         if (Rand_ZeroOne() < 0.1f) {
             func_80ADE514(this);
@@ -671,7 +672,7 @@ void func_80ADF5E0(EnPoh* this, PlayState* play) {
         EnPoh_SetupIdle(this);
     }
     if (this->actor.xzDistToPlayer < 200.0f) {
-        func_80ADE1BC(this);
+        EnPoh_SetupApproach(this);  // was func_80ADE1BC [LLM:HIGH]
     }
     EnPoh_MoveTowardsPlayerHeight(this, play);
 }
-- 
