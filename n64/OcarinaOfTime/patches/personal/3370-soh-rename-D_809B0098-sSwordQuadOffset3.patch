From e5aba210c193bfede5f85b7f670d58dad5a1f9e6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:01 +0000
Subject: [PATCH 3370/3799] soh: rename D_809B0098 -> sSwordQuadOffset3

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the fourth corner of that hitbox
Defined in soh/src/overlays/actors/ovl_En_Am/z_en_am.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Am/z_en_am.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Am/z_en_am.c b/soh/src/overlays/actors/ovl_En_Am/z_en_am.c
index f171d7227..578c54df2 100644
--- a/soh/src/overlays/actors/ovl_En_Am/z_en_am.c
+++ b/soh/src/overlays/actors/ovl_En_Am/z_en_am.c
@@ -783,13 +783,13 @@ void EnAm_TransformSwordHitbox(Actor* thisx, PlayState* play) {
     static Vec3f sSwordQuadOffset0 = { 2500.0f, 7000.0f, 0.0f };  // was D_809B0074 [LLM:HIGH]
     static Vec3f sSwordQuadOffset1 = { -2500.0f, 0.0f, 0.0f };  // was D_809B0080 [LLM:HIGH]
     static Vec3f sSwordQuadOffset2 = { 2500.0f, 7000.0f, 4000.0f };  // was D_809B008C [LLM:HIGH]
-    static Vec3f D_809B0098 = { -2500.0f, 0.0f, 4000.0f };
+    static Vec3f sSwordQuadOffset3 = { -2500.0f, 0.0f, 4000.0f };  // was D_809B0098 [LLM:HIGH]
     EnAm* this = (EnAm*)thisx;
 
     Matrix_MultVec3f(&sSwordQuadOffset0, &this->hitCollider.dim.quad[1]);  // was D_809B0074 [LLM:HIGH]
     Matrix_MultVec3f(&sSwordQuadOffset1, &this->hitCollider.dim.quad[0]);  // was D_809B0080 [LLM:HIGH]
     Matrix_MultVec3f(&sSwordQuadOffset2, &this->hitCollider.dim.quad[3]);  // was D_809B008C [LLM:HIGH]
-    Matrix_MultVec3f(&D_809B0098, &this->hitCollider.dim.quad[2]);
+    Matrix_MultVec3f(&sSwordQuadOffset3, &this->hitCollider.dim.quad[2]);  // was D_809B0098 [LLM:HIGH]
 
     Collider_SetQuadVertices(&this->hitCollider, &this->hitCollider.dim.quad[0], &this->hitCollider.dim.quad[1],
                              &this->hitCollider.dim.quad[2], &this->hitCollider.dim.quad[3]);
-- 
