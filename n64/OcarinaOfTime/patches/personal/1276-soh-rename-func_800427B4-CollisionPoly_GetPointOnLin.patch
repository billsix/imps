From 0aca7af176812162cbd449d47b9f85052fbcb245 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:07:17 +0000
Subject: [PATCH 1276/3799] soh: rename func_800427B4 ->
 CollisionPoly_GetPointOnLineSeg

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: its doc comment reads "Get the closestPoint to line (pointA, pointB) formed from the intersection of planes polyA and polyB"; it wraps Math3D_PlaneVsLineSegClosestPoint and the camera uses it.
Defined in soh/src/code/z_bgcheck.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h  | 2 +-
 soh/src/code/z_bgcheck.c | 3 ++-
 soh/src/code/z_camera.c  | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 7392411e4..9fc46a443 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -713,7 +713,7 @@ u32 WaterBox_GetCamDataIndex(CollisionContext* colCtx, WaterBox* waterBox);
 u16 WaterBox_GetCameraSType(CollisionContext* colCtx, WaterBox* waterBox);
 u32 WaterBox_GetLightSettingIndex(CollisionContext* colCtx, WaterBox* waterBox);
 s32 CollisionPoly_GetPointOnIntersectLine(CollisionPoly* polyA, CollisionPoly* polyB, Vec3f* point, Vec3f* closestPoint);  // was func_80042708 [LLM:HIGH]
-s32 func_800427B4(CollisionPoly* polyA, CollisionPoly* polyB, Vec3f* pointA, Vec3f* pointB, Vec3f* closestPoint);
+s32 CollisionPoly_GetPointOnLineSeg(CollisionPoly* polyA, CollisionPoly* polyB, Vec3f* pointA, Vec3f* pointB, Vec3f* closestPoint);  // was func_800427B4 [LLM:HIGH]
 void BgCheck_DrawDynaCollision(PlayState*, CollisionContext*);
 void BgCheck_DrawStaticCollision(PlayState*, CollisionContext*);
 void DynaPolyActor_SetStandingActorFlags(CollisionContext* colCtx, Actor* actor, s32 bgId);  // was func_80043334 [LLM:HIGH]
diff --git a/soh/src/code/z_bgcheck.c b/soh/src/code/z_bgcheck.c
index 89e55fb64..a855c17e4 100644
--- a/soh/src/code/z_bgcheck.c
+++ b/soh/src/code/z_bgcheck.c
@@ -4403,7 +4403,8 @@ s32 CollisionPoly_GetPointOnIntersectLine(CollisionPoly* polyA, CollisionPoly* p
  * Get the `closestPoint` to line (`pointA`, `pointB`) formed from the intersection of planes `polyA` and `polyB`
  * returns true if the `closestPoint` exists, else returns false
  */
-s32 func_800427B4(CollisionPoly* polyA, CollisionPoly* polyB, Vec3f* pointA, Vec3f* pointB, Vec3f* closestPoint) {
+// LLM generated name (HIGH), was func_800427B4: its doc comment reads "Get the closestPoint to line (pointA, pointB) formed from the intersection of planes polyA and polyB"; it wraps Math3D_PlaneVsLineSegClosestPoint and the camera uses it.
+s32 CollisionPoly_GetPointOnLineSeg(CollisionPoly* polyA, CollisionPoly* polyB, Vec3f* pointA, Vec3f* pointB, Vec3f* closestPoint) {
     f32 n1X;
     f32 n1Y;
     f32 n1Z;
diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 6485dfcb8..99d51cac8 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -797,7 +797,7 @@ Vec3f* Camera_BGCheckCorner(Vec3f* dst, Vec3f* linePointA, Vec3f* linePointB, Ca
                             CamColChk* pointBColChk) {
     Vec3f closestPoint;
 
-    if (!func_800427B4(pointAColChk->poly, pointBColChk->poly, linePointA, linePointB, &closestPoint)) {
+    if (!CollisionPoly_GetPointOnLineSeg(pointAColChk->poly, pointBColChk->poly, linePointA, linePointB, &closestPoint)) {  // was func_800427B4 [LLM:HIGH]
         osSyncPrintf(VT_COL(YELLOW, BLACK) "camera: corner check no cross point %x %x\n" VT_RST, pointAColChk,
                      pointBColChk);
         *dst = pointAColChk->pos;
