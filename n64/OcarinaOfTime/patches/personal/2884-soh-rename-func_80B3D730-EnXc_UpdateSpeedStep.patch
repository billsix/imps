From bc01e14acbbac5cbeabfd97ffc6b9c3c0275a855 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:42 +0000
Subject: [PATCH 2884/3799] soh: rename func_80B3D730 -> EnXc_UpdateSpeedStep

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: runs the XZ speed step
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index c24fd4879..e6dfbd56c 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -681,7 +681,8 @@ void EnXc_MoveWithGravity2(EnXc* this) {
     Actor_MoveXZGravity(&this->actor);
 }
 
-void func_80B3D730(EnXc* this) {
+// LLM generated name (HIGH), was func_80B3D730: runs the XZ speed step
+void EnXc_UpdateSpeedStep(EnXc* this) {
     EnXc_CalcXZSpeed(this);
 }
 
@@ -1068,7 +1069,7 @@ void EnXc_ActionFunc15(EnXc* this, PlayState* play) {
 }
 
 void EnXc_HaltAndWaitToThrowNut(EnXc* this, PlayState* play) {
-    func_80B3D730(this);
+    EnXc_UpdateSpeedStep(this);  // was func_80B3D730 [LLM:HIGH]
     EnXc_AnimIsFinished(this);
     EnXc_BgCheck(this, play);
     EnXc_SetEyePattern(this);
