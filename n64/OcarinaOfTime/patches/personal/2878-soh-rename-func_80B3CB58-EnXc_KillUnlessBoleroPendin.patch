From f17758a1aa59c60c0f806e2677f8655d21f525f7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:41 +0000
Subject: [PATCH 2878/3799] soh: rename func_80B3CB58 ->
 EnXc_KillUnlessBoleroPending

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same test against the Bolero
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 0ab046111..7bb538656 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -324,7 +324,8 @@ s32 EnXc_MinuetCS(EnXc* this, PlayState* play) {
     return true;
 }
 
-void func_80B3CB58(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B3CB58: the same test against the Bolero
+void EnXc_KillUnlessBoleroPending(EnXc* this, PlayState* play) {
     // If hasn't learned Bolero and Player is Adult
     if (!Flags_GetEventChkInf(EVENTCHKINF_LEARNED_BOLERO_OF_FIRE) && LINK_IS_ADULT) {
         this->action = SHEIK_ACTION_INIT;
@@ -2394,7 +2395,7 @@ void EnXc_Init(Actor* thisx, PlayState* play) {
             EnXc_KillUnlessMinuetPending(this, play);  // was func_80B3CA38 [LLM:HIGH]
             break;
         case SHEIK_TYPE_BOLERO:
-            func_80B3CB58(this, play);
+            EnXc_KillUnlessBoleroPending(this, play);  // was func_80B3CB58 [LLM:HIGH]
             break;
         case SHEIK_TYPE_SERENADE:
             EnXc_SetupSerenadeAction(this, play);
