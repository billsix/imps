From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:09 +0000
Subject: [PATCH 3425/3799] soh: rename D_8012EA90 -> sUnusedAudioTable1

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: an s16 table in audio_data.c that nothing in the tree reads
Defined in soh/src/code/audio_data.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_data.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_data.c b/soh/src/code/audio_data.c
index 1f2255a4e..980b0a888 100644
--- a/soh/src/code/audio_data.c
+++ b/soh/src/code/audio_data.c
@@ -212,7 +212,8 @@ s16 gWhiteNoiseSample[] = {
 };
 
 // Sine White Noise?
-s16 D_8012EA90[] = {
+// LLM generated name (GUESS), was D_8012EA90: an s16 table in audio_data.c that nothing in the tree reads
+s16 sUnusedAudioTable1[] = {  // was D_8012EA90 [LLM:GUESS]
     // Frequency of 1
     0,      16316,  20148,  20257,  27209,  -32657, 29264,  27259,
     -29394, -21494, -26410, 30770,  30033,  29130,  20206,  14129,
@@ -343,7 +344,7 @@ s16 gQuarterPulseWaveSample[] = {
 
 s16* gWaveSamples[] = {
     gSawtoothWaveSample, gTriangleWaveSample,    gSineWaveSample,         gSquareWaveSample,       gWhiteNoiseSample,
-    D_8012EA90,          gEighthPulseWaveSample, gQuarterPulseWaveSample, gQuarterPulseWaveSample,
+    sUnusedAudioTable1,          gEighthPulseWaveSample, gQuarterPulseWaveSample, gQuarterPulseWaveSample,  // was D_8012EA90 [LLM:GUESS]
 };
 
 f32 gBendPitchOneOctaveFrequencies[] = {
