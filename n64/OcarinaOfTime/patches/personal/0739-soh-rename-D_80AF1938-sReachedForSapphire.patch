From 951aaea3626f8903e7c979dd3dc1c9fa3291b8bb Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:45 +0000
Subject: [PATCH 0739/3799] soh: rename D_80AF1938 -> sReachedForSapphire

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 48a0eb5c2..022444c21 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -155,7 +155,8 @@ static s32 sUnused = 0;
 
 #include "z_en_ru1_cutscene_data.c" EARLY
 
-static u32 D_80AF1938 = 0;
+// Name from zeldaret/oot (was D_80AF1938): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+static u32 sReachedForSapphire = 0;
 
 static EnRu1ActionFunc sActionFuncs[] = {
     EnRu1_Fountain_GazingAtLink, EnRu1_Fountain_Diving, EnRu1_Fountain_Resurfacing, EnRu1_Fountain_TreadingWater, EnRu1_Fountain_StartingSwimBack, EnRu1_Fountain_SwimmingBack, EnRu1_Fountain_FinishingSwimBack,
@@ -256,7 +257,7 @@ u8 func_80AEADF0(EnRu1* this) {
 void EnRu1_Destroy(Actor* thisx, PlayState* play) {
     EnRu1* this = (EnRu1*)thisx;
 
-    D_80AF1938 = 0;
+    sReachedForSapphire = 0;
     EnRu1_DestroyColliders(this, play);
 }
 
@@ -2103,13 +2104,13 @@ void EnRu1_RespondToSapphirePlatformMoving(EnRu1* this) {
 void EnRu1_LookUpAtSapphire(EnRu1* this) {
     f32 curFrame;
 
-    if (D_80AF1938 == 0) {
+    if (sReachedForSapphire == 0) {
         curFrame = this->skelAnime.curFrame;
         if (curFrame >= 60.0f) {
             EnRu1_SetEyeIndex(this, 3);
             EnRu1_SetMouthIndex(this, 0);
             func_80AED57C(this);
-            D_80AF1938 = 1;
+            sReachedForSapphire = 1;
         }
     }
 }
