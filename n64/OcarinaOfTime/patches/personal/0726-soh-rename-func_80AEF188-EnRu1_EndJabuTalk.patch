Subject: [PATCH 726/784] soh: rename func_80AEF188 -> EnRu1_EndJabuTalk

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index de055ca0f..dfafaef24 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1989,7 +1989,8 @@ void EnRu1_CheckJabuTalk(EnRu1* this, PlayState* play, s32 cond) {
     }
 }
 
-void func_80AEF188(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEF188): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_EndJabuTalk(EnRu1* this, PlayState* play) {
     if (EnRu1_MessageShouldAdvance(play) && !EnRu1_BecomingCarrier(this, play)) {
         Message_CloseTextbox(play);
         Flags_SetInfTable(INFTABLE_RUTO_IN_JJ_TALK_FIRST_TIME);
@@ -2039,7 +2040,7 @@ void EnRu1_SpeakableJabu_Talking(EnRu1* this, PlayState* play) {
     EnRu1_UpdateSkelAnime(this);
     EnRu1_UpdateEyes(this);
     EnRu1_UpdateBgCheckInfo(this, play);
-    func_80AEF188(this, play);
+    EnRu1_EndJabuTalk(this, play);
 }
 
