From fb3f0023a244563976ba662c03ebf0fb5cc9e70b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:52:26 +0000
Subject: [PATCH 1140/3799] soh: rename func_808C0C50 -> BgZg_PlayOpenSfx

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays NA_SE_EV_METALDOOR_OPEN at the actor's position; called once when the bars start rising.
Defined in soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
index 034cd4aae..73be2994b 100644
--- a/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
+++ b/soh/src/overlays/actors/ovl_Bg_Zg/z_bg_zg.c
@@ -15,7 +15,8 @@ void BgZg_Destroy(Actor* thisx, PlayState* play);
 void BgZg_Update(Actor* thisx, PlayState* play);
 void BgZg_Draw(Actor* thisx, PlayState* play);
 
-void func_808C0C50(BgZg* this);
+// LLM generated name (HIGH), was func_808C0C50: plays NA_SE_EV_METALDOOR_OPEN at the actor's position; called once when the bars start rising.
+void BgZg_PlayOpenSfx(BgZg* this);  // was func_808C0C50 [LLM:HIGH]
 s32 func_808C0C98(BgZg* this, PlayState* play);
 s32 func_808C0CC8(BgZg* this);
 void func_808C0CD4(BgZg* this, PlayState* play);
@@ -54,7 +55,7 @@ void BgZg_Destroy(Actor* thisx, PlayState* play) {
     DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
 }
 
-void func_808C0C50(BgZg* this) {
+void BgZg_PlayOpenSfx(BgZg* this) {
     Audio_PlaySfxGeneral(NA_SE_EV_METALDOOR_OPEN, &this->dyna.actor.projectedPos, 4, &gSfxDefaultFreqAndVolScale,
                          &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
 }
@@ -74,7 +75,7 @@ s32 func_808C0CC8(BgZg* this) {
 void func_808C0CD4(BgZg* this, PlayState* play) {
     if (func_808C0C98(this, play) != 0) {
         this->action = 1;
-        func_808C0C50(this);
+        BgZg_PlayOpenSfx(this);  // was func_808C0C50 [LLM:HIGH]
     }
 }
 
