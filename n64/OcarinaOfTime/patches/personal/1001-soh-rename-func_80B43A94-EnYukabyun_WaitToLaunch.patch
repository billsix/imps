@@ -15,7 +15,8 @@ void EnYukabyun_Destroy(Actor* thisx, PlayState* play);
 void EnYukabyun_Update(Actor* thisx, PlayState* play);
 void EnYukabyun_Draw(Actor* thisx, PlayState* play);
 
-void func_80B43A94(EnYukabyun* this, PlayState* play);
+// LLM generated name (HIGH), was func_80B43A94: counts the per-params delay down, then enables targeting and hostility and starts the spin-up.
+void EnYukabyun_WaitToLaunch(EnYukabyun* this, PlayState* play);  // was func_80B43A94 [LLM:HIGH]
 void func_80B43AD4(EnYukabyun* this, PlayState* play);
 void func_80B43B6C(EnYukabyun* this, PlayState* play);
 
@@ -69,7 +70,7 @@ void EnYukabyun_Init(Actor* thisx, PlayState* play) {
     this->actor.params++;
     this->unk_152 = 0;
     this->unk_150 = (u8)(this->actor.params) * 0xA + 0x14;
-    this->actionfunc = func_80B43A94;
+    this->actionfunc = EnYukabyun_WaitToLaunch;  // was func_80B43A94 [LLM:HIGH]
 }
 
 void EnYukabyun_Destroy(Actor* thisx, PlayState* play) {
@@ -77,7 +78,7 @@ void EnYukabyun_Destroy(Actor* thisx, PlayState* play) {
     Collider_DestroyCylinder(play, &this->collider);
 }
 
-void func_80B43A94(EnYukabyun* this, PlayState* play) {
+void EnYukabyun_WaitToLaunch(EnYukabyun* this, PlayState* play) {
     if (this->unk_150 != 0) {
         this->unk_150--;
     }
@@ -133,7 +134,7 @@ void EnYukabyun_Update(Actor* thisx, PlayState* play) {
     this->actionfunc(this, play);
     Actor_MoveXZGravity(&this->actor);
 
-    if (!(this->actionfunc == func_80B43A94 || this->actionfunc == EnYukabyun_Break)) {
+    if (!(this->actionfunc == EnYukabyun_WaitToLaunch || this->actionfunc == EnYukabyun_Break)) {  // was func_80B43A94 [LLM:HIGH]
         Actor_UpdateBgCheckInfo(play, &this->actor, 5.0f, 20.0f, 8.0f, 5);
         Collider_UpdateCylinder(&this->actor, &this->collider);
 
