From c289e8a8c133abe9ce4173fe0dbd836d454209e8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:16 +0000
Subject: [PATCH 215/488] soh: rename D_80B8E670 -> sReflectionDrawn

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: file-static flag cleared by every MirRay_Update and set to 1 by the first MirRay_Draw that actually renders the mirror-shield reflection, so only one Mir_Ray draws it per frame.
Defined in soh/src/overlays/actors/ovl_Mir_Ray/z_mir_ray.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_Mir_Ray/z_mir_ray.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Mir_Ray/z_mir_ray.c b/soh/src/overlays/actors/ovl_Mir_Ray/z_mir_ray.c
index 057285849..4f64105c2 100644
--- a/soh/src/overlays/actors/ovl_Mir_Ray/z_mir_ray.c
+++ b/soh/src/overlays/actors/ovl_Mir_Ray/z_mir_ray.c
@@ -45,7 +45,8 @@ const ActorInit Mir_Ray_InitVars = {
     NULL,
 };
 
-static u8 D_80B8E670 = 0;
+// LLM generated name (HIGH), was D_80B8E670: file-static flag cleared by every MirRay_Update and set to 1 by the first MirRay_Draw that actually renders the mirror-shield reflection, so only one Mir_Ray draws it per frame.
+static u8 sReflectionDrawn = 0;  // was D_80B8E670 [LLM:HIGH]
 
 static ColliderQuadInit sQuadInit = {
     {
@@ -242,7 +243,7 @@ void MirRay_Update(Actor* thisx, PlayState* play) {
     MirRay* this = (MirRay*)thisx;
     Player* player = GET_PLAYER(play);
 
-    D_80B8E670 = 0;
+    sReflectionDrawn = 0;  // was D_80B8E670 [LLM:HIGH]
 
     if (!this->unLit) {
         if (sMirRayData[this->actor.params].params & 2) {
@@ -478,7 +479,7 @@ void MirRay_Draw(Actor* thisx, PlayState* play) {
     s32 temp;
 
     this->reflectIntensity = 0.0f;
-    if ((D_80B8E670 == 0) && !this->unLit && Player_HasMirrorShieldSetToDraw(play)) {
+    if ((sReflectionDrawn == 0) && !this->unLit && Player_HasMirrorShieldSetToDraw(play)) {  // was D_80B8E670 [LLM:HIGH]
         Matrix_Mult(&player->shieldMf, MTXMODE_NEW);
         MirRay_SetIntensity(this, play);
         if (!(this->reflectIntensity <= 0.0f)) {
@@ -519,7 +520,7 @@ void MirRay_Draw(Actor* thisx, PlayState* play) {
                 }
             }
 
-            D_80B8E670 = 1;
+            sReflectionDrawn = 1;  // was D_80B8E670 [LLM:HIGH]
 
             CLOSE_DISPS(play->state.gfxCtx);
         }
-- 
