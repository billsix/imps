From fbf152f37c6beebe75ebc5c4dad2c46aa153eb15 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:41:10 +0000
Subject: [PATCH 2595/3799] soh: rename func_80ACAF74 -> EnOwl_LakeHyliaAdvance

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: continues the Lake Hylia message into its choice
Defined in soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
index 88fef993d..61246c12d 100644
--- a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
+++ b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
@@ -42,7 +42,8 @@ void EnOwl_HyruleCastleAdvance(EnOwl* this, PlayState* play);  // was func_80ACA
 void EnOwl_KakarikoAdvance(EnOwl* this, PlayState* play);  // was func_80ACAC6C [LLM:HIGH]
 // LLM generated name (HIGH), was func_80ACADF0: continues the Gerudo Valley message into its choice
 void EnOwl_GerudoAdvance(EnOwl* this, PlayState* play);  // was func_80ACADF0 [LLM:HIGH]
-void func_80ACAF74(EnOwl* this, PlayState* play);
+// LLM generated name (HIGH), was func_80ACAF74: continues the Lake Hylia message into its choice
+void EnOwl_LakeHyliaAdvance(EnOwl* this, PlayState* play);  // was func_80ACAF74 [LLM:HIGH]
 void func_80ACC30C(EnOwl* this, PlayState* play);
 void func_80ACB4FC(EnOwl* this, PlayState* play);
 void func_80ACB680(EnOwl* this, PlayState* play);
@@ -537,7 +538,7 @@ void EnOwl_LakeHyliaChoice(EnOwl* this, PlayState* play) {
         switch (play->msgCtx.choiceIndex) {
             case OWL_REPEAT:
                 Message_ContinueTextbox(play, 0x2071);
-                this->actionFunc = func_80ACAF74;
+                this->actionFunc = EnOwl_LakeHyliaAdvance;  // was func_80ACAF74 [LLM:HIGH]
                 break;
             case OWL_OK:
                 Message_ContinueTextbox(play, 0x2072);
@@ -550,7 +551,7 @@ void EnOwl_LakeHyliaChoice(EnOwl* this, PlayState* play) {
     }
 }
 
-void func_80ACAF74(EnOwl* this, PlayState* play) {
+void EnOwl_LakeHyliaAdvance(EnOwl* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT && Message_ShouldAdvance(play)) {
         Message_ContinueTextbox(play, 0x206A);
         this->actionFunc = EnOwl_LakeHyliaChoice;  // was func_80ACAEB8 [LLM:HIGH]
@@ -564,7 +565,7 @@ void EnOwl_WaitLakeHylia(EnOwl* this, PlayState* play) {
 
     if (EnOwl_CheckInitTalk(this, play, 0x2071, 360.0f, 0)) {
         Audio_PlayFanfare(NA_BGM_OWL);
-        this->actionFunc = func_80ACAF74;
+        this->actionFunc = EnOwl_LakeHyliaAdvance;  // was func_80ACAF74 [LLM:HIGH]
     }
 }
 
