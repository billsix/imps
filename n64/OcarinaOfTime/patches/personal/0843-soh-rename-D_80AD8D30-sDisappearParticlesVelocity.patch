From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 19:50:47 +0000
Subject: [PATCH 0843/3799] soh: rename D_80AD8D30 ->
 sDisappearParticlesVelocity

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c.
---
 soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c b/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c
index 422730bea..a599b5fe2 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c
@@ -79,7 +79,8 @@ static InitChainEntry sInitChain[] = {
     ICHAIN_F32(targetArrowOffset, 1500, ICHAIN_STOP),
 };
 
-static Vec3f D_80AD8D30 = { 0.0f, 1.5f, 0.0f };
+// Name from zeldaret/oot (was D_80AD8D30): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Po_Relay/z_en_po_relay.c]
+static Vec3f sDisappearParticlesVelocity = { 0.0f, 1.5f, 0.0f };
 
 static Vec3f D_80AD8D3C = { 0.0f, 0.0f, 0.0f };
 
@@ -320,15 +321,15 @@ void EnPoRelay_DisappearAndReward(EnPoRelay* this, PlayState* play) {
             vec.x = (Math_SinS(Camera_GetCamDirYaw(GET_ACTIVE_CAM(play)) + 0x4800) * 23.0f) + this->actor.world.pos.x;
             vec.z = (Math_CosS(Camera_GetCamDirYaw(GET_ACTIVE_CAM(play)) + 0x4800) * 23.0f) + this->actor.world.pos.z;
         }
-        EffectSsDeadDb_Spawn(play, &vec, &D_80AD8D30, &D_80AD8D3C, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,
+        EffectSsDeadDb_Spawn(play, &vec, &sDisappearParticlesVelocity, &D_80AD8D3C, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,
                              0, 0, 255, 1, 9, true);
         vec.x = (this->actor.world.pos.x + this->actor.world.pos.x) - vec.x;
         vec.z = (this->actor.world.pos.z + this->actor.world.pos.z) - vec.z;
-        EffectSsDeadDb_Spawn(play, &vec, &D_80AD8D30, &D_80AD8D3C, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,
+        EffectSsDeadDb_Spawn(play, &vec, &sDisappearParticlesVelocity, &D_80AD8D3C, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,
                              0, 0, 255, 1, 9, true);
         vec.x = this->actor.world.pos.x;
         vec.z = this->actor.world.pos.z;
-        EffectSsDeadDb_Spawn(play, &vec, &D_80AD8D30, &D_80AD8D3C, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,
+        EffectSsDeadDb_Spawn(play, &vec, &sDisappearParticlesVelocity, &D_80AD8D3C, this->actionTimer * 10 + 80, 0, 255, 255, 255, 255,
                              0, 0, 255, 1, 9, true);
         if (this->actionTimer == 1) {
             Audio_PlayActorSound2(&this->actor, NA_SE_EN_EXTINCT);
