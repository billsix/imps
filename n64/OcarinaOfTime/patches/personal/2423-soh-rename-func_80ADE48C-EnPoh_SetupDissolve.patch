Subject: [PATCH 2423/3799] soh: rename func_80ADE48C -> EnPoh_SetupDissolve

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: stops the poe, drops targeting and starts the death dissolve
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index fa8e2d030..a1b45889d 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -336,7 +336,8 @@ void EnPoh_SetupInitialAction(EnPoh* this) {
     }
 }
 
-void func_80ADE48C(EnPoh* this) {
+// LLM generated name (HIGH), was func_80ADE48C: stops the poe, drops targeting and starts the death dissolve
+void EnPoh_SetupDissolve(EnPoh* this) {
     this->actor.speedXZ = 0.0f;
     this->actor.world.rot.y = this->actor.shape.rot.y;
     this->unk_198 = 0;
@@ -577,7 +578,7 @@ void func_80ADEECC(EnPoh* this, PlayState* play) {
         if (this->actor.colChkInfo.health != 0) {
             EnPoh_SetupFlee(this);  // was func_80ADE368 [LLM:HIGH]
         } else {
-            func_80ADE48C(this);
+            EnPoh_SetupDissolve(this);  // was func_80ADE48C [LLM:HIGH]
         }
     }
 }
