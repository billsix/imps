From 64da1f41bef77b7da9a0a67f8417476768c2cb7a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:18:57 +0000
Subject: [PATCH 1431/3799] soh: rename func_809B05F0 -> EnAni_OfferHeartPiece

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: offers GI_HEART_PIECE every frame while the textbox is up, and moves to the hand-off state once it closes.
Defined in soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c b/soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c
index 46eea8f94..fb225d555 100644
--- a/soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c
+++ b/soh/src/overlays/actors/ovl_En_Ani/z_en_ani.c
@@ -19,7 +19,8 @@ s32 EnAni_SetText(EnAni* this, PlayState* play, u16 textId);
 void func_809B04F0(EnAni* this, PlayState* play);
 void func_809B0524(EnAni* this, PlayState* play);
 void func_809B0558(EnAni* this, PlayState* play);
-void func_809B05F0(EnAni* this, PlayState* play);
+// LLM generated name (HIGH), was func_809B05F0: offers GI_HEART_PIECE every frame while the textbox is up, and moves to the hand-off state once it closes.
+void EnAni_OfferHeartPiece(EnAni* this, PlayState* play);  // was func_809B05F0 [LLM:HIGH]
 // LLM generated name (HIGH), was func_809B064C: the child-era idle on the roof: picks the day, night or face-reaction line, offers talk at two different ranges, and routes an accepted conversation to the heart-piece hand-off or to the plain talk state.
 void EnAni_ChildIdle(EnAni* this, PlayState* play);  // was func_809B064C [LLM:HIGH]
 // LLM generated name (HIGH), was func_809B07F8: the adult-era twin of EnAni_ChildIdle, choosing its line from whether Death Mountain has erupted and whether the heart piece has already been taken.
@@ -135,7 +136,7 @@ void func_809B0558(EnAni* this, PlayState* play) {
     }
 }
 
-void func_809B05F0(EnAni* this, PlayState* play) {
+void EnAni_OfferHeartPiece(EnAni* this, PlayState* play) {
     if (Actor_TextboxIsClosing(&this->actor, play)) {
         EnAni_SetupAction(this, func_809B0558);
     }
@@ -164,7 +165,7 @@ void EnAni_ChildIdle(EnAni* this, PlayState* play) {
         if (this->actor.textId == 0x5056) {
             EnAni_SetupAction(this, func_809B04F0);
         } else if (this->actor.textId == 0x5055) {
-            EnAni_SetupAction(this, func_809B05F0);
+            EnAni_SetupAction(this, EnAni_OfferHeartPiece);  // was func_809B05F0 [LLM:HIGH]
         } else {
             EnAni_SetupAction(this, func_809B04F0);
         }
@@ -190,7 +191,7 @@ void EnAni_AdultIdle(EnAni* this, PlayState* play) {
         if (this->actor.textId == 0x5056) {
             EnAni_SetupAction(this, func_809B0524);
         } else if (this->actor.textId == 0x5055) {
-            EnAni_SetupAction(this, func_809B05F0);
+            EnAni_SetupAction(this, EnAni_OfferHeartPiece);  // was func_809B05F0 [LLM:HIGH]
         } else {
             EnAni_SetupAction(this, func_809B0524);
         }
