             thisx->flags |= ACTOR_FLAG_UPDATE_CULLING_DISABLED | ACTOR_FLAG_DRAW_CULLING_DISABLED;
             thisx->uncullZoneForward = 3000.0f;
         }
-        this->actionFunc = func_808896B8;
