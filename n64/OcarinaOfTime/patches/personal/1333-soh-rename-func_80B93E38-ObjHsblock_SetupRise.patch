From f812f0eaa16771ce87101d13e13278186e4e0827 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:10:55 +0000
Subject: [PATCH 1333/3799] soh: rename func_80B93E38 -> ObjHsblock_SetupRise

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the rising action.
Defined in soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c b/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
index 9724e7af5..7d1acc496 100644
--- a/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
+++ b/soh/src/overlays/actors/ovl_Obj_Hsblock/z_obj_hsblock.c
@@ -22,7 +22,8 @@ void func_80B93E5C(ObjHsblock* this, PlayState* play);
 void ObjHsblock_SetupIdle(ObjHsblock* this);  // was func_80B93D90 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80B93DB0: sinks the block 105 units below home, disables update culling and installs the waiting action.
 void ObjHsblock_SetupWaitForSwitch(ObjHsblock* this);  // was func_80B93DB0 [LLM:HIGH]
-void func_80B93E38(ObjHsblock* this);
+// LLM generated name (HIGH), was func_80B93E38: installs the rising action.
+void ObjHsblock_SetupRise(ObjHsblock* this);  // was func_80B93E38 [LLM:HIGH]
 
 const ActorInit Obj_Hsblock_InitVars = {
     ACTOR_OBJ_HSBLOCK,
@@ -123,11 +124,11 @@ void ObjHsblock_SetupWaitForSwitch(ObjHsblock* this) {
 
 void ObjHsblock_WaitForSwitch(ObjHsblock* this, PlayState* play) {
     if (Flags_GetSwitch(play, (this->dyna.actor.params >> 8) & 0x3F)) {
-        func_80B93E38(this);
+        ObjHsblock_SetupRise(this);  // was func_80B93E38 [LLM:HIGH]
     }
 }
 
-void func_80B93E38(ObjHsblock* this) {
+void ObjHsblock_SetupRise(ObjHsblock* this) {
     ObjHsblock_SetupAction(this, func_80B93E5C);
 }
 
