From 5dfa4301aeff0788fc1766dac186b2254e829959 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:55 +0000
Subject: [PATCH 3291/3799] soh: rename D_808CA45C -> sHeadOriginOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the zero vector limb 6 records its own position from
Defined in soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c b/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
index 0299ed7b1..eeb72e1fa 100644
--- a/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
+++ b/soh/src/overlays/actors/ovl_Boss_Dodongo/z_boss_dodongo.c
@@ -1346,7 +1346,7 @@ block_1:
 
 void BossDodongo_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
     static Vec3f D_808CA450 = { 5000.0f, -2500.0f, 0.0f };
-    static Vec3f D_808CA45C = { 0.0f, 0.0f, 0.0f };
+    static Vec3f sHeadOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_808CA45C [LLM:HIGH]
     static Vec3f D_808CA468 = { 11500.0f, -3000.0f, 0.0f };
     static Vec3f D_808CA474 = { 5000.0f, -2000.0f, 0.0f };
     static Vec3f D_808CA480 = { 8000.0f, 0.0f, 0.0f };
@@ -1354,7 +1354,7 @@ void BossDodongo_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s
     BossDodongo* this = (BossDodongo*)thisx;
 
     if (limbIndex == 6) {
-        Matrix_MultVec3f(&D_808CA45C, &this->vec);
+        Matrix_MultVec3f(&sHeadOriginOffset, &this->vec);  // was D_808CA45C [LLM:HIGH]
         Matrix_MultVec3f(&D_808CA450, &this->actor.focus.pos);
         Matrix_MultVec3f(&D_808CA468, &this->firePos);
         Matrix_MultVec3f(&D_808CA474, &this->mouthPos);
-- 
