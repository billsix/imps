Date: Mon, 7 Sep 2026 23:49:31 +0000
Subject: [PATCH 2743/3799] soh: rename func_8002DDF4 ->
 Player_IsOnStationaryLadder

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns stateFlags2 & PLAYER_STATE2_STATIONARY_LADDER
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h                     | 2 +-
 soh/src/code/z_actor.c                      | 3 ++-
 soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c | 4 ++--
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 525eb129b..603da52f4 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -422,7 +422,7 @@ f32 Player_GetRunSpeedLimit(Player* player);  // was func_8002DCE4 [LLM:HIGH]
 s32 Player_HasItemInHand(Player* player);  // was func_8002DD6C [LLM:HIGH]
 s32 Player_IsAimingHeldItem(Player* player);  // was func_8002DD78 [LLM:GUESS]
 s32 Player_IsTakingStep(PlayState* play);  // was func_8002DDE4 [LLM:HIGH]
-s32 func_8002DDF4(PlayState* play);
+s32 Player_IsOnStationaryLadder(PlayState* play);  // was func_8002DDF4 [LLM:HIGH]
 void Actor_SwapHookshotAttachment(PlayState* play, Actor* actorA, Actor* actorB);
 void Actor_RequestHorseCameraSetting(PlayState* play, Player* player);
 void Actor_MountHorse(PlayState* play, Player* player, Actor* horse);
diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 930848d61..7c6e73afb 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -1445,7 +1445,8 @@ s32 Player_IsTakingStep(PlayState* play) {
     return player->stateFlags2 & PLAYER_STATE2_FOOTSTEP;
 }
 
-s32 func_8002DDF4(PlayState* play) {
+// LLM generated name (HIGH), was func_8002DDF4: returns stateFlags2 & PLAYER_STATE2_STATIONARY_LADDER
+s32 Player_IsOnStationaryLadder(PlayState* play) {
     Player* player = GET_PLAYER(play);
 
     return player->stateFlags2 & PLAYER_STATE2_STATIONARY_LADDER;
diff --git a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
index 88f019dbb..c2ad4b4ca 100644
--- a/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
+++ b/soh/src/overlays/actors/ovl_En_Sw/z_en_sw.c
@@ -726,7 +726,7 @@ s32 EnSw_ShouldChasePlayer(EnSw* this, PlayState* play, s32 arg2) {
 
     if (!(player->stateFlags1 & PLAYER_STATE1_CLIMBING_LADDER) && arg2) {
         return false;
-    } else if (func_8002DDF4(play) && arg2) {
+    } else if (Player_IsOnStationaryLadder(play) && arg2) {  // was func_8002DDF4 [LLM:HIGH]
         return false;
     } else if (ABS(EnSw_GetRollToward(this, &player->actor.world.pos) - this->actor.shape.rot.z) >= 0x1FC2) {  // was func_80B0DE34 [LLM:HIGH]
         return false;
@@ -891,7 +891,7 @@ void EnSw_Chase(EnSw* this, PlayState* play) {
                 this->unk_440 = 4;
             }
 
-            if (!(Math_Vec3f_DistXYZ(&this->actor.world.pos, &this->unk_448) > 13.0f) || func_8002DDF4(play)) {
+            if (!(Math_Vec3f_DistXYZ(&this->actor.world.pos, &this->unk_448) > 13.0f) || Player_IsOnStationaryLadder(play)) {  // was func_8002DDF4 [LLM:HIGH]
                 this->actionFunc = EnSw_StopDash;  // was func_80B0E90C [LLM:HIGH]
             }
         }
