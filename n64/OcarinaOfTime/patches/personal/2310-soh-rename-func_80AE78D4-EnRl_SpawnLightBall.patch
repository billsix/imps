From e8ba124a447df743ed83ca35b12b1d92161d69f1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:22:10 +0000
Subject: [PATCH 2310/3799] soh: rename func_80AE78D4 -> EnRl_SpawnLightBall

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: spawns the params 5 DEMO_6K light effect above Rauru
Defined in soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c b/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
index 63a879e0c..ef1e0385b 100644
--- a/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
+++ b/soh/src/overlays/actors/ovl_En_Rl/z_en_rl.c
@@ -211,7 +211,8 @@ void EnRl_InitSkelAnimeHidden(EnRl* this, PlayState* play) {
     this->actor.shape.shadowAlpha = 0;
 }
 
-void func_80AE78D4(EnRl* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AE78D4: spawns the params 5 DEMO_6K light effect above Rauru
+void EnRl_SpawnLightBall(EnRl* this, PlayState* play) {
     Actor_SpawnAsChild(&play->actorCtx, &this->actor, play, ACTOR_DEMO_6K, this->actor.world.pos.x,
                        kREG(18) + 22.0f + this->actor.world.pos.y, this->actor.world.pos.z, 0, 0, 0, 5);
 }
@@ -267,7 +268,7 @@ void func_80AE7AF8(EnRl* this, PlayState* play) {
         this->unk_19C = kREG(5) + 10.0f;
         this->alpha = 255;
         if (!this->lightBallSpawned) {
-            func_80AE78D4(this, play);
+            EnRl_SpawnLightBall(this, play);  // was func_80AE78D4 [LLM:HIGH]
             this->lightBallSpawned = 1;
         }
         this->actor.shape.shadowAlpha = 0xFF;
