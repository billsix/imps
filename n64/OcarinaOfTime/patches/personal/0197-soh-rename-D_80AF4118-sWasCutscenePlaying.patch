From aeacc409c72dcb47b63d8baa351a81856ebb0cff Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:33 +0000
Subject: [PATCH 0197/3799] soh: rename D_80AF4118 -> sWasCutscenePlaying

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c b/soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c
index 4a82b26e2..55ee95830 100644
--- a/soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c
+++ b/soh/src/overlays/actors/ovl_En_Ru2/z_en_ru2.c
@@ -91,7 +91,8 @@ static void* sEyeTextures[] = {
     gAdultRutoEyeClosedTex,
 };
 
-static UNK_TYPE D_80AF4118 = 0;
+// LLM generated name (HIGH), was D_80AF4118: latch remembering a cutscene ran, checked when csCtx returns to idle
+static UNK_TYPE sWasCutscenePlaying = 0;
 
 #include "z_en_ru2_cutscene_data.c" EARLY
 
@@ -153,7 +154,7 @@ void EnRu2_UpdateCollider(EnRu2* this, PlayState* play) {
 
 void EnRu2_Destroy(Actor* thisx, PlayState* play) {
     EnRu2* this = (EnRu2*)thisx;
-    D_80AF4118 = 0;
+    sWasCutscenePlaying = 0;
     Collider_DestroyCylinder(play, &this->collider);
 }
 
@@ -197,18 +198,18 @@ void func_80AF26D0(EnRu2* this, PlayState* play) {
     s32 one; // Needed to match
 
     if (play->csCtx.state == CS_STATE_IDLE) {
-        if (D_80AF4118 != 0) {
+        if (sWasCutscenePlaying != 0) {
             // Seems like this state is never reached
             if (this->actor.params == 2) {
                 func_80AF26AC(this);
             }
-            D_80AF4118 = 0;
+            sWasCutscenePlaying = 0;
             return;
         }
     } else {
         one = 1;
-        if (D_80AF4118 == 0) {
-            D_80AF4118 = one;
+        if (sWasCutscenePlaying == 0) {
+            sWasCutscenePlaying = one;
         }
     }
 }
