From b2363f8284eb897e4010eb149384fa59ce9264c3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:55:04 +0000
Subject: [PATCH 1177/3799] soh: rename func_809CBCEC ->
 EnBubble_SetupDisappear

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: shrinks the bubble's dimensions away and returns the twelve-frame countdown; the in-tree comment notes it is only reached from the unused EnBubble_Disappear action.
Defined in soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c b/soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c
index 185f91ab2..abe238cd9 100644
--- a/soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c
+++ b/soh/src/overlays/actors/ovl_En_Bubble/z_en_bubble.c
@@ -111,7 +111,8 @@ u32 EnBubble_SetupPop(EnBubble* this) {
 }
 
 // only called in an unused actionFunc
-u32 func_809CBCEC(EnBubble* this) {
+// LLM generated name (HIGH), was func_809CBCEC: shrinks the bubble's dimensions away and returns the twelve-frame countdown; the in-tree comment notes it is only reached from the unused EnBubble_Disappear action.
+u32 EnBubble_SetupDisappear(EnBubble* this) {
     EnBubble_SetDimensions(this, -1.0f);
     return 12;
 }
@@ -159,7 +160,7 @@ u32 func_809CBFD4(EnBubble* this) {
     if (DECR(this->explosionCountdown) != 0) {
         return -1;
     }
-    return func_809CBCEC(this);
+    return EnBubble_SetupDisappear(this);  // was func_809CBCEC [LLM:HIGH]
 }
 
 // only called in an unused actionFunc
