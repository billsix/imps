+u8 gLightConfigAfterUnderwater = 0;
 
 u8 D_8011FB38 = 0;
 
@@ -388,7 +389,7 @@ void Environment_Init(PlayState* play2, EnvironmentContext* envCtx, s32 unused)
     }
 
