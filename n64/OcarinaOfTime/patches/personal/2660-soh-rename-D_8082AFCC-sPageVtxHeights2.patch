Subject: [PATCH 2660/3799] soh: rename D_8082AFCC -> sPageVtxHeights2

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the heights in slot 2 of the sPageVtxHeights table
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index ee946ae54..fedb6d42a 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2691,7 +2691,8 @@ static s16 sPageVtxHeights1[] = {  // was D_8082AFC8 [LLM:HIGH]
     0x0000,
     0x0000,
 };
-static s16 D_8082AFCC[] = {
+// LLM generated name (HIGH), was D_8082AFCC: the heights in slot 2 of the sPageVtxHeights table
+static s16 sPageVtxHeights2[] = {  // was D_8082AFCC [LLM:HIGH]
     0x0055, 0x0055, 0x0010, 0x0018, 0x0018, 0x0018, 0x0010, 0x0010, 0x0010,
     0x0010, 0x0010, 0x0010, 0x0010, 0x0010, 0x0010, 0x0010, 0x0018, 0x0000,
 };
@@ -2716,7 +2717,7 @@ static s16* D_8082B030[] = {
 };
 
 static s16* D_8082B048[] = {
-    sPageVtxHeights0, sPageVtxHeights1, D_8082AFCC, D_8082AFF0, sCloudTexHeights, D_8082AFF4,  // was D_8082AB2C [LLM:HIGH]
+    sPageVtxHeights0, sPageVtxHeights1, sPageVtxHeights2, D_8082AFF0, sCloudTexHeights, D_8082AFF4,  // was D_8082AB2C [LLM:HIGH]
 };
 
 static s16 D_8082B060[] = {
