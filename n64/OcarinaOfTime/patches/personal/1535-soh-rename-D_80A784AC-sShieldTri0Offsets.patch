From 3580459fbd1cfc63285fd1478c89ced9933f1b1b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:25:46 +0000
Subject: [PATCH 1535/3799] soh: rename D_80A784AC -> sShieldTri0Offsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the three local-space corners of the shield collider's first triangle.
Defined in soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
index af94e094f..fc9826cb1 100644
--- a/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
+++ b/soh/src/overlays/actors/ovl_En_Ik/z_en_ik.c
@@ -901,7 +901,8 @@ static Vec3f sAxeQuadOffsets[] = {  // was D_80A7847C [LLM:HIGH]
     { -6000.0f, 2000.0f, -3000.0f },
 };
 
-static Vec3f D_80A784AC[] = {
+// LLM generated name (HIGH), was D_80A784AC: the three local-space corners of the shield collider's first triangle.
+static Vec3f sShieldTri0Offsets[] = {  // was D_80A784AC [LLM:HIGH]
     { -3000.0, -700.0, -5000.0 },
     { -3000.0, -700.0, 2000.0 },
     { 4000.0, -700.0, 2000.0 },
@@ -951,7 +952,7 @@ void EnIk_PostLimbDraw3(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
         }
         if (this->unk_2F8 == 9) {
             for (i = 0; i < ARRAY_COUNT(sp78); i++) {
-                Matrix_MultVec3f(&D_80A784AC[i], &sp9C[i]);
+                Matrix_MultVec3f(&sShieldTri0Offsets[i], &sp9C[i]);  // was D_80A784AC [LLM:HIGH]
                 Matrix_MultVec3f(&D_80A784D0[i], &sp78[i]);
             }
 
