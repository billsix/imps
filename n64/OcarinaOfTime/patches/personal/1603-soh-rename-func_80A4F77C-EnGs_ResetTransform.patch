From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:30:03 +0000
Subject: [PATCH 1603/3799] soh: rename func_80A4F77C -> EnGs_ResetTransform

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: zeroes the stone's three rotations and returns both scale pairs to 1.0 before a hit reaction starts deforming them.
Defined in soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c b/soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c
index d9cc24306..41212ba1e 100644
--- a/soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c
+++ b/soh/src/overlays/actors/ovl_En_Gs/z_en_gs.c
@@ -22,7 +22,8 @@ void EnGs_Idle(EnGs* this, PlayState* play);  // was func_80A4F734 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80A4F700: counts its timer down and kills the actor at zero.
 void EnGs_CountdownToDeath(EnGs* this, PlayState* play);  // was func_80A4F700 [LLM:HIGH]
 
-void func_80A4F77C(EnGs* this);
+// LLM generated name (HIGH), was func_80A4F77C: zeroes the stone's three rotations and returns both scale pairs to 1.0 before a hit reaction starts deforming them.
+void EnGs_ResetTransform(EnGs* this);  // was func_80A4F77C [LLM:HIGH]
 
 const ActorInit En_Gs_InitVars = {
     ACTOR_EN_GS,
@@ -512,7 +513,7 @@ void EnGs_Idle(EnGs* this, PlayState* play) {
     }
 }
 
-void func_80A4F77C(EnGs* this) {
+void EnGs_ResetTransform(EnGs* this) {
     static Vec3s D_80A4FE34 = { 0, 0, 0 };
     static Vec3f D_80A4FE3C = { 1.0f, 1.0f, 1.0f };
     s32 i;
@@ -541,27 +542,27 @@ void EnGs_Update(Actor* thisx, PlayState* play2) {
             switch (this->actor.colChkInfo.damageEffect) {
                 case 15:
                     this->unk_19E |= 1;
-                    func_80A4F77C(this);
+                    EnGs_ResetTransform(this);  // was func_80A4F77C [LLM:HIGH]
                     this->actionFunc = EnGs_HitWobble;  // was func_80A4E910 [LLM:HIGH]
                     break;
                 case 14:
                     this->unk_19E |= 1;
-                    func_80A4F77C(this);
+                    EnGs_ResetTransform(this);  // was func_80A4F77C [LLM:HIGH]
                     this->actionFunc = EnGs_HitSpin;  // was func_80A4EA08 [LLM:HIGH]
                     break;
                 case 13:
                     this->unk_19E |= 1;
-                    func_80A4F77C(this);
+                    EnGs_ResetTransform(this);  // was func_80A4F77C [LLM:HIGH]
                     this->actionFunc = EnGs_HitSquash;  // was func_80A4EB3C [LLM:HIGH]
                     break;
                 case 12:
                     this->unk_19E |= 2;
-                    func_80A4F77C(this);
+                    EnGs_ResetTransform(this);  // was func_80A4F77C [LLM:HIGH]
                     this->actionFunc = EnGs_Explode;  // was func_80A4ED34 [LLM:HIGH]
                     break;
                 case 11:
                     this->unk_19E |= 1;
-                    func_80A4F77C(this);
+                    EnGs_ResetTransform(this);  // was func_80A4F77C [LLM:HIGH]
                     this->actionFunc = EnGs_SpinAndRise;  // was func_80A4F13C [LLM:HIGH]
                     break;
             }
