Subject: [PATCH 0644/3799] soh: rename func_8098F50C ->
 DemoSa_Credits_InitPosition

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 1ec557219..0b66f427e 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -550,7 +550,8 @@ void DemoSa_Credits_FadeIn(DemoSa* this) {
     }
 }
 
-void func_8098F50C(DemoSa* this, PlayState* play) {
+// Name from zeldaret/oot (was func_8098F50C): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_Credits_InitPosition(DemoSa* this, PlayState* play) {
     DemoSa_SetStartPosRotFromCue(this, play, 4);
     this->action = 12;
     this->drawConfig = 2;
@@ -591,7 +592,7 @@ void func_8098F654(DemoSa* this, PlayState* play) {
         if (action != unk_1AC) {
             switch (action) {
                 case 7:
-                    func_8098F50C(this, play);
+                    DemoSa_Credits_InitPosition(this, play);
                     break;
                 case 8:
                     func_8098F590(this);
