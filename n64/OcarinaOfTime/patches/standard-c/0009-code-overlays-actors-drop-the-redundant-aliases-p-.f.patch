-            // & 0xFFFFFFFF necessary for matching.
-            hexDumpSize = (HREG(83) == 0 ? 0x100 : HREG(83) * 0x10) & 0xFFFFFFFF;
+            hexDumpSize = (HREG(83) == 0 ? 0x100 : HREG(83) * 0x10);
             LogUtils_LogHexDump(PHYSICAL_TO_VIRTUAL(HREG(82) << 8), hexDumpSize);
