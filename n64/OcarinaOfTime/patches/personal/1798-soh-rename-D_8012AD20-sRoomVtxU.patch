From 926e74afbb400f345bc0b85d589656b55fcae95b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:16 +0000
Subject: [PATCH 1798/3799] soh: rename D_8012AD20 -> sRoomVtxU

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the five texture U coordinates a room-skybox face's vertices are laid out on.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 5035bbab2..87ffc7d0b 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -91,7 +91,8 @@ u16 sRoomVtxIndices[2][0x20] = {  // was D_8012ACA0 [LLM:HIGH]
       0x15, 0x17, 0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0x1F, 0x21, 0x23, 0x24, 0x25, 0x26, 0x27, 0x29, 0x2B },
 };
 
-s16 D_8012AD20[5] = {
+// LLM generated name (HIGH), was D_8012AD20: the five texture U coordinates a room-skybox face's vertices are laid out on.
+s16 sRoomVtxU[5] = {  // was D_8012AD20 [LLM:HIGH]
     0x0000, 0x0FC0, 0x1F80, 0x2F40, 0x3F00,
 };
 
@@ -186,7 +187,7 @@ s32 func_800ADBB0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp1F0[k] = arg5;
                     sp358[k] = pad42C;
                     sp2A4[k] = pad428;
-                    sp13C[k] = D_8012AD20[j];
+                    sp13C[k] = sRoomVtxU[j];  // was D_8012AD20 [LLM:HIGH]
                     sp88[k] = D_8012AD2C[i];
                     pad42C += arg6;
                 }
@@ -204,7 +205,7 @@ s32 func_800ADBB0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp358[k] = arg3;
                     sp2A4[k] = pad428;
                     sp1F0[k] = pad42C;
-                    sp13C[k] = D_8012AD20[j];
+                    sp13C[k] = sRoomVtxU[j];  // was D_8012AD20 [LLM:HIGH]
                     sp88[k] = D_8012AD2C[i];
                     pad42C += arg6;
                 }
@@ -222,7 +223,7 @@ s32 func_800ADBB0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp2A4[k] = arg4;
                     sp358[k] = pad42C;
                     sp1F0[k] = pad428;
-                    sp13C[k] = D_8012AD20[j];
+                    sp13C[k] = sRoomVtxU[j];  // was D_8012AD20 [LLM:HIGH]
                     sp88[k] = D_8012AD2C[i];
                     pad42C += arg6;
                 }
