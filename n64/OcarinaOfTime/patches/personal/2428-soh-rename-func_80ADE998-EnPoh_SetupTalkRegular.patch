From d465190932e97dbe828773c8547638e09b23de9a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:28:09 +0000
Subject: [PATCH 2428/3799] soh: rename func_80ADE998 -> EnPoh_SetupTalkRegular

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the ordinary poe soul's conversation action
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index d4af6ffdd..5464a38a1 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -460,7 +460,8 @@ void EnPoh_SetupSoulVanish(EnPoh* this, s32 arg1) {
     this->actionFunc = func_80AE009C;
 }
 
-void func_80ADE998(EnPoh* this) {
+// LLM generated name (HIGH), was func_80ADE998: installs the ordinary poe soul's conversation action
+void EnPoh_SetupTalkRegular(EnPoh* this) {
     this->actionFunc = EnPoh_TalkRegular;
     this->actor.home.pos.y = this->actor.world.pos.y - 15.0f;
 }
@@ -781,7 +782,7 @@ void func_80ADFE80(EnPoh* this, PlayState* play) {
         if (this->actor.params >= EN_POH_SHARP) {
             func_80ADE9BC(this);
         } else {
-            func_80ADE998(this);
+            EnPoh_SetupTalkRegular(this);  // was func_80ADE998 [LLM:HIGH]
         }
         return;
     }
