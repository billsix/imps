Date: Tue, 8 Sep 2026 02:01:51 +0000
Subject: [PATCH 3726/3799] soh: rename func_80B571FC ->
 EnZl3_GetYawToCurrentPathPoint

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the heading from the actor to the current waypoint, falling back to the current shape.rot.y when that waypoint does not exist
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index f801c65c9..62bbe3e2d 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -1778,7 +1778,8 @@ s32 EnZl3_GetYawAlongPathSegment(EnZl3* this) {
     }
 }
 
-s32 func_80B571FC(EnZl3* this) {
+// LLM generated name (GUESS), was func_80B571FC: the heading from the actor to the current waypoint, falling back to the current shape.rot.y when that waypoint does not exist
+s32 EnZl3_GetYawToCurrentPathPoint(EnZl3* this) {
     s32 pad;
     s32 unk_314 = this->unk_314;
 
@@ -1790,7 +1791,7 @@ s32 func_80B571FC(EnZl3* this) {
 }
 
 void func_80B57240(EnZl3* this) {
-    s32 temp_a1 = func_80B571FC(this);
+    s32 temp_a1 = EnZl3_GetYawToCurrentPathPoint(this);  // was func_80B571FC [LLM:GUESS]
     s16* rotY = &this->actor.world.rot.y;
 
     Math_SmoothStepToS(rotY, temp_a1, 2, 6400, 1000);
