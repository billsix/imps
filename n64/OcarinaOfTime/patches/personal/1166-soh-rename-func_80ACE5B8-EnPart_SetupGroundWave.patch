From 7859714897f7b17099e30e28d0984aad063913ee Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:54:06 +0000
Subject: [PATCH 1166/3799] soh: rename func_80ACE5B8 -> EnPart_SetupGroundWave

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sActionFuncs[2]: a one-frame transition that advances to action 3, the ground-wave state.
Defined in soh/src/overlays/actors/ovl_En_Part/z_en_part.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Part/z_en_part.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Part/z_en_part.c b/soh/src/overlays/actors/ovl_En_Part/z_en_part.c
index 148be172c..08907458f 100644
--- a/soh/src/overlays/actors/ovl_En_Part/z_en_part.c
+++ b/soh/src/overlays/actors/ovl_En_Part/z_en_part.c
@@ -170,7 +170,8 @@ void EnPart_Move(EnPart* this, PlayState* play) {
     this->rotZ += this->rotZSpeed;
 }
 
-void func_80ACE5B8(EnPart* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80ACE5B8: sActionFuncs[2]: a one-frame transition that advances to action 3, the ground-wave state.
+void EnPart_SetupGroundWave(EnPart* this, PlayState* play) {
     this->action = 3;
 }
 
@@ -242,7 +243,7 @@ void func_80ACE7E8(EnPart* this, PlayState* play) {
 
 void EnPart_Update(Actor* thisx, PlayState* play) {
     static EnPartActionFunc sActionFuncs[] = {
-        EnPart_SetupMotion, EnPart_Move, func_80ACE5B8, func_80ACE5C8, func_80ACE7E8,  // was func_80ACDDE8 [LLM:HIGH]
+        EnPart_SetupMotion, EnPart_Move, EnPart_SetupGroundWave, func_80ACE5C8, func_80ACE7E8,  // was func_80ACDDE8 [LLM:HIGH]
     };
 
     EnPart* this = (EnPart*)thisx;
