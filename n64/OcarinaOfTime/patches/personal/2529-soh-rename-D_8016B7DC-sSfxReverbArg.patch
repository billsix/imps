From 0d9d89ec4ebd81b6074d249a52b262b69e5b4c73 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:59 +0000
Subject: [PATCH 2529/3799] soh: rename D_8016B7DC -> sSfxReverbArg

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: holds the caller's reverb for the duration of Audio_PlaySfxWithReverb
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index ef2fc9539..eb6c5ca40 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -1273,7 +1273,8 @@ FreqLerp sRiverFreqScaleLerp;
 FreqLerp sWaterfallFreqScaleLerp;
 // LLM generated name (HIGH), was D_8016B7D8: the rate-derived volume Audio_PlaySfxScaledByRate and Audio_PlaySfxAtInterval pass
 f32 sRateVolScale;  // was D_8016B7D8 [LLM:HIGH]
-s8 D_8016B7DC;
+// LLM generated name (HIGH), was D_8016B7DC: holds the caller's reverb for the duration of Audio_PlaySfxWithReverb
+s8 sSfxReverbArg;  // was D_8016B7DC [LLM:HIGH]
 f32 D_8016B7E0;
 u16 D_8016B7E4; // decomp: debug only
 struct {
@@ -1365,7 +1366,7 @@ s32 sAudioUpdateTaskEnd;      // decomp: debug only
     F(sRiverFreqScaleLerp)                             \
     F(sWaterfallFreqScaleLerp)                         \
     F(sRateVolScale)                                      \
-    F(D_8016B7DC)                                      \
+    F(sSfxReverbArg)                                      \
     F(D_8016B7E0)                                      \
     F(sRiverSoundMainBgmVol)                           \
     F(sRiverSoundMainBgmCurrentVol)                    \
@@ -4514,8 +4515,8 @@ void Audio_SetSfxIntervalRange(s8 arg0, s8 arg1) {
 
 // LLM generated name (HIGH), was func_800F4524: plays a sound with a caller-supplied reverb and default scales
 void Audio_PlaySfxWithReverb(Vec3f* pos, u16 sfxId, s8 arg2) {
-    D_8016B7DC = arg2;
-    Audio_PlaySfxGeneral(sfxId, pos, 4, &gSfxDefaultFreqAndVolScale, &gSfxDefaultFreqAndVolScale, &D_8016B7DC);
+    sSfxReverbArg = arg2;  // was D_8016B7DC [LLM:HIGH]
+    Audio_PlaySfxGeneral(sfxId, pos, 4, &gSfxDefaultFreqAndVolScale, &gSfxDefaultFreqAndVolScale, &sSfxReverbArg);  // was D_8016B7DC [LLM:HIGH]
 }
 
 // LLM generated name (HIGH), was func_800F4578: plays a sound with a caller-supplied volume scale and default frequency and reverb
