From 88b9d7c5096d103f9f3318e7f0af91a678835818 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:38 +0000
Subject: [PATCH 3084/3799] soh: rename D_801215BC -> sCs3010KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 3010 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 6 +++---
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 94e65e6a0..17c7d0199 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -29,7 +29,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs2210KeyFrames)                                   \
     F(sCs3040KeyFrames)                                   \
     F(sCs3020KeyFrames)                                   \
-    F(D_801215BC)                                   \
+    F(sCs3010KeyFrames)                                   \
     F(D_80121C24)                                   \
     F(D_80121D3C)                                   \
     F(D_80121F1C)                                   \
@@ -430,9 +430,9 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
             break;
         case 3010:
-            D_801215BC[0].timerInit = timer;
+            sCs3010KeyFrames[0].timerInit = timer;  // was D_801215BC [LLM:HIGH]
 
-            csInfo->keyFrames = D_801215BC;
+            csInfo->keyFrames = sCs3010KeyFrames;  // was D_801215BC [LLM:HIGH]
             csInfo->keyFrameCnt = 1;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 285c218e5..c3d552b99 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -300,7 +300,8 @@ static OnePointCsFull sCs3020KeyFrames[2] = {  // was D_8012156C [LLM:HIGH]
     { 0x81, 0xFF, 0x4242, -1, 0, 65.0f, 1.0f, { -50.0f, 60.0f, 0.0f }, { -60.0f, 40.0f, 150.0f } },
 };
 
-static OnePointCsFull D_801215BC[1] = {
+// LLM generated name (HIGH), was D_801215BC: the keyframe set one-point cutscene 3010 installs
+static OnePointCsFull sCs3010KeyFrames[1] = {  // was D_801215BC [LLM:HIGH]
     { 0x0F, 0xFF, 0x0101, 5, 0, 65.0f, 1.0f, { -1185.0f, 655.0f, 1185.0f }, { -1255.0f, 735.0f, 1255.0f } },
 };
 
