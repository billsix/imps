@@ -150,7 +150,8 @@ void DemoSa_SetMouthIndex(DemoSa* this, s16 mouthIndex) {
     this->mouthIndex = mouthIndex;
 }
 
-void func_8098E530(DemoSa* this) {
+// LLM generated name (HIGH), was func_8098E530: sets action to 7, which is sActionFuncs[7] = DemoSa_Action_SageInvisible, alongside drawConfig 0 (DrawNothing), alpha 0 and shadowAlpha 0.
+void DemoSa_SetupSageInvisible(DemoSa* this) {
     this->action = 7;
     this->drawConfig = 0;
     this->alpha = 0;
@@ -165,7 +166,7 @@ void func_8098E554(DemoSa* this, PlayState* play) {
     if (play->csCtx.state == CS_STATE_IDLE) {
         if (*something != 0) {
