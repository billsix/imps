From 149065a915d2b547b6cd77d709c63ba471a9d707 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:15:50 +0000
Subject: [PATCH 0876/3799] soh: rename D_80990108 -> sWasInCutscene

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: file-static latch set to 1 while a cutscene runs and cleared on the frame it ends; its only reader is the reset above.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 33ee4e1da..696d05a4d 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -91,7 +91,8 @@ static void* sMouthTextures[] = {
     gSariaMouthSmilingOpenTex, gSariaMouthFrowningTex,
 };
 
-static u32 D_80990108 = 0;
+// LLM generated name (HIGH), was D_80990108: file-static latch set to 1 while a cutscene runs and cleared on the frame it ends; its only reader is the reset above.
+static u32 sWasInCutscene = 0;  // was D_80990108 [LLM:HIGH]
 
 #include "z_demo_sa_cutscene_data.c" EARLY
 
@@ -162,7 +163,7 @@ void DemoSa_SetupSageInvisible(DemoSa* this) {
 
 // LLM generated name (HIGH), was func_8098E554: latches sWasInCutscene while csCtx.state is not CS_STATE_IDLE, and on the return to idle calls DemoSa_SetupSageInvisible for the params == 2 instance.
 void DemoSa_ResetWhenCsEnds(DemoSa* this, PlayState* play) {
-    u32* something = &D_80990108;
+    u32* something = &sWasInCutscene;  // was D_80990108 [LLM:HIGH]
 
     if (play->csCtx.state == CS_STATE_IDLE) {
         if (*something != 0) {
