From 8413fd73dd30ead637438950bb5337eb0b714cbc Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:21:15 +0000
Subject: [PATCH 2277/3799] soh: rename func_80AB2688 -> EnNb_ApplyRootMotion

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: enables the animation's root motion and queues AnimationContext_SetMoveActor
Defined in soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c b/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
index 22e0a4a2c..330240334 100644
--- a/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
+++ b/soh/src/overlays/actors/ovl_En_Nb/z_en_nb.c
@@ -751,7 +751,8 @@ void EnNb_InitDemo6KInConfrontation(EnNb* this, PlayState* play) {
                 kREG(21) + 22.0f + this->actor.world.pos.y, this->actor.world.pos.z, 0, 0, 0, 0xB);
 }
 
-void func_80AB2688(EnNb* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AB2688: enables the animation's root motion and queues AnimationContext_SetMoveActor
+void EnNb_ApplyRootMotion(EnNb* this, PlayState* play) {
     this->skelAnime.movementFlags |= 1;
     AnimationContext_SetMoveActor(play, &this->actor, &this->skelAnime, 1.0f);
 }
@@ -905,7 +906,7 @@ void EnNb_CheckConfrontationCsModeWrapper(EnNb* this, PlayState* play) {
 
 void func_80AB2C18(EnNb* this, PlayState* play) {
     EnNb_UpdateEyes(this);
-    func_80AB2688(this, play);
+    EnNb_ApplyRootMotion(this, play);  // was func_80AB2688 [LLM:HIGH]
     EnNb_UpdateBgCheck(this, play);  // was func_80AB1284 [LLM:HIGH]
     EnNb_CheckConfrontationCsMode(this, play);
 }
@@ -917,7 +918,7 @@ void EnNb_Kneel(EnNb* this, PlayState* play) {
     animFinished = EnNb_UpdateSkelAnime(this);
     EnNb_CheckIfKneeling(this, animFinished);
     EnNb_PlayKneelingOnGroundSFX(this);
-    func_80AB2688(this, play);
+    EnNb_ApplyRootMotion(this, play);  // was func_80AB2688 [LLM:HIGH]
     EnNb_UpdateBgCheck(this, play);  // was func_80AB1284 [LLM:HIGH]
     EnNb_CheckConfrontationCsMode(this, play);
 }
@@ -929,7 +930,7 @@ void EnNb_LookRight(EnNb* this, PlayState* play) {
     animFinished = EnNb_UpdateSkelAnime(this);
     EnNb_CheckIfLookingRight(this, animFinished);
     EnNb_PlayLookRightSFX(this);
-    func_80AB2688(this, play);
+    EnNb_ApplyRootMotion(this, play);  // was func_80AB2688 [LLM:HIGH]
     EnNb_UpdateBgCheck(this, play);  // was func_80AB1284 [LLM:HIGH]
     EnNb_CheckConfrontationCsMode(this, play);
 }
@@ -940,7 +941,7 @@ void EnNb_LookLeft(EnNb* this, PlayState* play) {
     EnNb_UpdateEyes(this);
     animFinished = EnNb_UpdateSkelAnime(this);
     EnNb_CheckIfLookLeft(this, animFinished);
-    func_80AB2688(this, play);
+    EnNb_ApplyRootMotion(this, play);  // was func_80AB2688 [LLM:HIGH]
     EnNb_UpdateBgCheck(this, play);  // was func_80AB1284 [LLM:HIGH]
     EnNb_CheckConfrontationCsMode(this, play);
 }
@@ -952,7 +953,7 @@ void EnNb_Run(EnNb* this, PlayState* play) {
     EnNb_UpdateEyes(this);
     animFinished = EnNb_UpdateSkelAnime(this);
     EnNb_PlayLookLeftSFX(this);
-    func_80AB2688(this, play);
+    EnNb_ApplyRootMotion(this, play);  // was func_80AB2688 [LLM:HIGH]
     EnNb_UpdateBgCheck(this, play);  // was func_80AB1284 [LLM:HIGH]
     EnNb_SetupDemo6KInConfrontation(this, play, animFinished);
     EnNb_CheckConfrontationCsMode(this, play);
