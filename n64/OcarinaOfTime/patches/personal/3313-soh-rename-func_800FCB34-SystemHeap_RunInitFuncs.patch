From 06e6ab74c0272d5ebaab6699f9579412ccdf8067 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:27 +0000
Subject: [PATCH 3313/3799] soh: rename func_800FCB34 ->
 SystemHeap_RunInitFuncs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: walks the sInitFuncs chain running each entry
Defined in soh/src/code/system_heap.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/system_heap.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/system_heap.c b/soh/src/code/system_heap.c
index 66ec8bf4a..513a0d415 100644
--- a/soh/src/code/system_heap.c
+++ b/soh/src/code/system_heap.c
@@ -179,7 +179,8 @@ void SystemHeap_DeleteArray(void* blk, u32 nBlk, u32 blkSize, arg3_800FCA18 arg3
     }
 }
 
-void func_800FCB34(void) {
+// LLM generated name (HIGH), was func_800FCB34: walks the sInitFuncs chain running each entry
+void SystemHeap_RunInitFuncs(void) {
     InitFunc* initFunc = (InitFunc*)&sInitFuncs;
     u32 nextOffset = initFunc->nextOffset;
     InitFunc* prev = NULL;
@@ -201,5 +202,5 @@ void func_800FCB34(void) {
 
 void SystemHeap_Init(void* start, size_t size) {
     SystemArena_Init(start, size);
-    func_800FCB34();
+    SystemHeap_RunInitFuncs();  // was func_800FCB34 [LLM:HIGH]
 }
