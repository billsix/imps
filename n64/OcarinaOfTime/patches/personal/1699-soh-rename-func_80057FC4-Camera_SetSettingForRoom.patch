From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:37:36 +0000
Subject: [PATCH 1699/3799] soh: rename func_80057FC4 ->
 Camera_SetSettingForRoom

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: picks the camera setting from the room's behaviour type, forcing CAM_SET_FREE0 for sub-cameras.
Defined in soh/src/code/z_camera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index d279a4e08..7f77cec37 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -7072,7 +7072,8 @@ void Camera_Init(Camera* camera, View* view, CollisionContext* colCtx, PlayState
     osSyncPrintf(VT_FGCOL(BLUE) "camera: initialize --- " VT_RST " UID %d\n", camera->uid);
 }
 
-void func_80057FC4(Camera* camera) {
+// LLM generated name (HIGH), was func_80057FC4: picks the camera setting from the room's behaviour type, forcing CAM_SET_FREE0 for sub-cameras.
+void Camera_SetSettingForRoom(Camera* camera) {
     if (camera != &camera->play->mainCamera) {
         camera->prevSetting = camera->setting = CAM_SET_FREE0;
         camera->unk_14C &= ~0x4;
@@ -7157,7 +7158,7 @@ void Camera_InitPlayerSettings(Camera* camera, Player* player) {
         sCameraInterfaceFlags = 0;
     }
 
-    func_80057FC4(camera);
+    Camera_SetSettingForRoom(camera);  // was func_80057FC4 [LLM:HIGH]
     camera->unk_14A = 0;
     camera->paramFlags = 0;
     camera->nextCamDataIdx = -1;
@@ -7337,7 +7338,7 @@ s32 Camera_UpdateWater(Camera* camera) {
             prevBgId = camera->bgCheckId;
             camera->bgCheckId = BGCHECK_SCENE;
             if (camera->waterPrevCamIdx < 0) {
-                func_80057FC4(camera);
+                Camera_SetSettingForRoom(camera);  // was func_80057FC4 [LLM:HIGH]
                 camera->camDataIdx = -1;
             } else {
                 Camera_ChangeDataIdx(camera, camera->waterPrevCamIdx);
-- 
