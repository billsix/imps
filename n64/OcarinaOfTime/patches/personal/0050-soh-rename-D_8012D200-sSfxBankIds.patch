From 4b563aad867e383cf333a47c5f0c3a969d79ec13 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:15 +0000
Subject: [PATCH 050/784] soh: rename D_8012D200 -> sSfxBankIds

Name source: zeldaret/oot.
Defined in soh/src/code/audio_stop_all_sfx.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_stop_all_sfx.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_stop_all_sfx.c b/soh/src/code/audio_stop_all_sfx.c
index bd3b37850..60fce3b4d 100644
--- a/soh/src/code/audio_stop_all_sfx.c
+++ b/soh/src/code/audio_stop_all_sfx.c
@@ -1,13 +1,14 @@
 #include "global.h"
 
-u8 D_8012D200[] = {
+// Name from zeldaret/oot, was D_8012D200: table of sfx bank ids 0..6 iterated by func_800C3C20 [oot: https://github.com/zeldaret/oot/blob/main/src/code/audio_stop_all_sfx.c]
+u8 sSfxBankIds[] = {
     0, 1, 2, 3, 4, 5, 6,
 };
 
 void func_800C3C20(void) {
     s32 i;
 
-    for (i = 0; (i < ARRAY_COUNT(D_8012D200)) & 0xFFFFFFFF; i++) {
-        Audio_StopSfxByBank(D_8012D200[i]);
+    for (i = 0; (i < ARRAY_COUNT(sSfxBankIds)) & 0xFFFFFFFF; i++) {
+        Audio_StopSfxByBank(sSfxBankIds[i]);
     }
 }
