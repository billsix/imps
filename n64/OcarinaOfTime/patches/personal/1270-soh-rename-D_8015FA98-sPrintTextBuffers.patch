From f28d068b732d197da573fb2a520aac9f87f13d9b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:06:42 +0000
Subject: [PATCH 1270/3799] soh: rename D_8015FA98 -> sPrintTextBuffers

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the 0x16-entry PrintTextBuffer array that DebugCamera_CopyText fills and DebugCamera_DrawText prints.
Defined in soh/src/code/z_debug.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_debug.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_debug.c b/soh/src/code/z_debug.c
index f158d3000..43425429a 100644
--- a/soh/src/code/z_debug.c
+++ b/soh/src/code/z_debug.c
@@ -16,7 +16,8 @@ typedef struct {
 GameInfo* gGameInfo;
 // LLM generated name (HIGH), was D_8015FA94: the in-tree comment on its declaration reads "// no known symbols"; nothing reads or writes it.
 s32 sUnusedDebugValue; // no known symbols, was D_8015FA94 [LLM:HIGH]
-PrintTextBuffer D_8015FA98[0x16];
+// LLM generated name (HIGH), was D_8015FA98: the 0x16-entry PrintTextBuffer array that DebugCamera_CopyText fills and DebugCamera_DrawText prints.
+PrintTextBuffer sPrintTextBuffers[0x16];  // was D_8015FA98 [LLM:HIGH]
 
 s16 D_8011E0B0 = 0; // PrintTextBuffer index
 Color_RGBA8 printTextColors[] = {
@@ -87,7 +88,7 @@ void DebugCamera_CopyText(u8 x, u8 y, u8 colorId, const char* text) {
     char* bufText;
     s16 i;
 
-    buf = &D_8015FA98[D_8011E0B0];
+    buf = &sPrintTextBuffers[D_8011E0B0];  // was D_8015FA98 [LLM:HIGH]
     if (D_8011E0B0 < 0x16) {
         buf->x = x;
         buf->y = y;
@@ -117,7 +118,7 @@ void DebugCamera_DrawText(GfxPrint* printer) {
     i = 0;
     if (D_8011E0B0 > 0) {
         do {
-            buffer = &D_8015FA98[i];
+            buffer = &sPrintTextBuffers[i];  // was D_8015FA98 [LLM:HIGH]
             text = buffer->text;
 
             color = &printTextColors[buffer->colorId];
-- 
