From bc7a98a05b28ffe18d7f42f9deb76afcb420ef7b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:14 +0000
Subject: [PATCH 045/225] soh: rename D_80133344 -> sSfxDistOverPrintMsg

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/audio_sfx.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_sfx.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_sfx.c b/soh/src/code/audio_sfx.c
index 13d3b6a86..e7a57704c 100644
--- a/soh/src/code/audio_sfx.c
+++ b/soh/src/code/audio_sfx.c
@@ -26,7 +26,8 @@ typedef struct {
 char sSfxDebugName[] = "SE";
 
 // rodata for Audio_ChooseActiveSounds (this file)
-char D_80133344[] = VT_COL(RED, WHITE) "<INAGAKI CHECK> dist over! flag:%04X ptr:%08X pos:%f-%f-%f" VT_RST "\n";
+// LLM generated name (HIGH), was D_80133344: format string for the "dist over" SFX debug print via osSyncPrintf
+char sSfxDistOverPrintMsg[] = VT_COL(RED, WHITE) "<INAGAKI CHECK> dist over! flag:%04X ptr:%08X pos:%f-%f-%f" VT_RST "\n";
 
 // file padding
 s32 D_8013338C = 0;
@@ -390,7 +391,7 @@ void Audio_ChooseActiveSounds(u8 bankId) {
             } else {
                 if (entry->dist > 0x7FFFFFD0) {
                     entry->dist = 0x70000008;
-                    osSyncPrintf(D_80133344, entry->sfxId, entry->posX, entry->posZ, *entry->posX, *entry->posY,
+                    osSyncPrintf(sSfxDistOverPrintMsg, entry->sfxId, entry->posX, entry->posZ, *entry->posX, *entry->posY,
                                  *entry->posZ);
                 }
                 temp3 = entry->sfxId; // fake
