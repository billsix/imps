Date: Mon, 7 Sep 2026 23:24:06 +0000
Subject: [PATCH 2380/3799] soh: rename func_8086DCCC ->
 BgBdanSwitch_SetupTallPressed

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: holds the tall switch at single height and installs its pressed action
Defined in soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c         | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
index 957cd6b29..92f575dc9 100644
--- a/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
+++ b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
@@ -61,7 +61,8 @@ void BgBdanSwitch_TallIdle(BgBdanSwitch* this, PlayState* play);  // was func_80
 void BgBdanSwitch_SetupTallPress(BgBdanSwitch* this);  // was func_8086DC30 [LLM:HIGH]
 // LLM generated name (HIGH), was func_8086DC48: sinks the tall switch by 0.3 a frame down to single height
 void BgBdanSwitch_TallPress(BgBdanSwitch* this, PlayState* play);  // was func_8086DC48 [LLM:HIGH]
-void func_8086DCCC(BgBdanSwitch* this);
+// LLM generated name (HIGH), was func_8086DCCC: holds the tall switch at single height and installs its pressed action
+void BgBdanSwitch_SetupTallPressed(BgBdanSwitch* this);  // was func_8086DCCC [LLM:HIGH]
 void func_8086DCE8(BgBdanSwitch* this, PlayState* play);
 void func_8086DDA8(BgBdanSwitch* this);
 void func_8086DDC0(BgBdanSwitch* this, PlayState* play);
@@ -212,7 +213,7 @@ void BgBdanSwitch_Init(Actor* thisx, PlayState* play) {
         case YELLOW_TALL_1:
         case YELLOW_TALL_2:
             if (flag) {
-                func_8086DCCC(this);
+                BgBdanSwitch_SetupTallPressed(this);  // was func_8086DCCC [LLM:HIGH]
             } else {
                 BgBdanSwitch_SetupTallIdle(this);  // was func_8086DB4C [LLM:HIGH]
             }
@@ -468,13 +469,13 @@ void BgBdanSwitch_TallPress(BgBdanSwitch* this, PlayState* play) {
     if ((Camera_GetTargetCategory() == this->dyna.actor.category) || (this->unk_1DA <= 0)) {  // was func_8005B198 [LLM:HIGH]
         this->unk_1C8 -= 0.3f;
         if (this->unk_1C8 <= 1.0f) {
-            func_8086DCCC(this);
+            BgBdanSwitch_SetupTallPressed(this);  // was func_8086DCCC [LLM:HIGH]
             Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_FOOT_SWITCH);
         }
     }
 }
 
-void func_8086DCCC(BgBdanSwitch* this) {
+void BgBdanSwitch_SetupTallPressed(BgBdanSwitch* this) {
     this->actionFunc = func_8086DCE8;
     this->unk_1C8 = 1.0f;
 }
