@@ -386,7 +387,7 @@ void EnBigokuta_SetupDeath(EnBigokuta* this) {
     Audio_PlayActorSound2(&this->actor, NA_SE_EN_DAIOCTA_DEAD2);
     this->unk_196 = 38;
     this->unk_198 = 10;
-    this->actionFunc = func_809BE26C;
+    this->actionFunc = EnBigokuta_Death;  // was func_809BE26C [LLM:HIGH]
 }
 
 // LLM generated name (HIGH), was func_809BD6B8: picks the spin duration from whether the octopus is facing the player and turns AC off
@@ -647,7 +648,7 @@ void EnBigokuta_Damage(EnBigokuta* this, PlayState* play) {
         }
     }
 }
-void func_809BE26C(EnBigokuta* this, PlayState* play) {
