@@ -201,7 +202,7 @@ void EnDu_TrackPlayer(EnDu* this, PlayState* play) {
     if (this->interactInfo.talkState == NPC_TALK_STATE_IDLE) {
         trackingMode = NPC_TRACKING_NONE;
     }
-    if (this->actionFunc == func_809FE890) {
+    if (this->actionFunc == EnDu_PerformCutsceneAction) {  // was func_809FE890 [LLM:HIGH]
         trackingMode = NPC_TRACKING_NONE;
     }
     this->interactInfo.trackPos = player->actor.world.pos;
@@ -346,7 +347,7 @@ void EnDu_Init(Actor* thisx, PlayState* play) {
     if (gSaveContext.cutsceneIndex >= 0xFFF0) {
         play->csCtx.segment = SEGMENTED_TO_VIRTUAL(gGoronCityDarunia01Cs);
         gSaveContext.cutsceneTrigger = 1;
-        EnDu_SetupAction(this, func_809FE890);
+        EnDu_SetupAction(this, EnDu_PerformCutsceneAction);  // was func_809FE890 [LLM:HIGH]
     } else if (play->sceneNum == SCENE_FIRE_TEMPLE) {
         EnDu_SetupAction(this, EnDu_FireTempleStartScene);  // was func_809FE638 [LLM:HIGH]
     } else if (!LINK_IS_ADULT) {
@@ -397,7 +398,7 @@ void EnDu_CheckOcarinaSong(EnDu* this, PlayState* play) {
             gSaveContext.cutsceneTrigger = 1;
         }
