From a04c52d144a6285ee5f30c983d42ec752f23e20a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:22:01 +0000
Subject: [PATCH 0920/3799] soh: rename D_8012A398 -> sJabuJabuWobblePhase

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: f32 phase advanced by 0.15 plus a room-state term under the VB_JABU_WOBBLE hook and fed to sinf to scale Jabu-Jabu's interior vertically.
Defined in soh/src/code/z_scene_table.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_scene_table.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_scene_table.c b/soh/src/code/z_scene_table.c
index f808d4004..5a865b92e 100644
--- a/soh/src/code/z_scene_table.c
+++ b/soh/src/code/z_scene_table.c
@@ -1589,7 +1589,8 @@ void Scene_DrawConfigFireTemple(PlayState* play) {
     CLOSE_DISPS(play->state.gfxCtx);
 }
 
-f32 D_8012A398 = 0.0f;
+// LLM generated name (HIGH), was D_8012A398: f32 phase advanced by 0.15 plus a room-state term under the VB_JABU_WOBBLE hook and fed to sinf to scale Jabu-Jabu's interior vertically.
+f32 sJabuJabuWobblePhase = 0.0f;  // was D_8012A398 [LLM:HIGH]
 
 // Name from zeldaret/oot (was func_8009FE58): adopted upstream's name for this address; body verified to match upstream at 0.89. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_scene_table.c]
 void Scene_DrawConfigJabuJabu(PlayState* play) {
@@ -1661,14 +1662,14 @@ void Scene_DrawConfigJabuJabu(PlayState* play) {
         }
 
         if (GameInteractor_Should(VB_JABU_WOBBLE, play->pauseCtx.state == 0)) {
-            D_8012A398 += 0.15f + (play->roomCtx.unk_74[1] * 0.001f);
+            sJabuJabuWobblePhase += 0.15f + (play->roomCtx.unk_74[1] * 0.001f);  // was D_8012A398 [LLM:HIGH]
         }
     }
 
     if (play->roomCtx.curRoom.num == 2) {
-        Matrix_Scale(1.0f, sinf(D_8012A398) * 0.8f, 1.0f, MTXMODE_NEW);
+        Matrix_Scale(1.0f, sinf(sJabuJabuWobblePhase) * 0.8f, 1.0f, MTXMODE_NEW);  // was D_8012A398 [LLM:HIGH]
     } else {
-        Matrix_Scale(1.005f, sinf(D_8012A398) * 0.8f, 1.005f, MTXMODE_NEW);
+        Matrix_Scale(1.005f, sinf(sJabuJabuWobblePhase) * 0.8f, 1.005f, MTXMODE_NEW);  // was D_8012A398 [LLM:HIGH]
     }
 
     gSPSegment(POLY_OPA_DISP++, 0x0D, MATRIX_NEWMTX(play->state.gfxCtx));
-- 
