Date: Mon, 7 Sep 2026 21:58:38 +0000
Subject: [PATCH 1219/3799] soh: rename func_8088E7A8 -> BgHidanSima_Slide

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sweeps the platform up to 200 units along its facing on a sine curve while looping the fire-pillar sfx, then returns to the pause.
Defined in soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c      | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
index f1a89c0b3..9be8eb1cb 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Sima/z_bg_hidan_sima.c
@@ -22,7 +22,8 @@ void BgHidanSima_Shake(BgHidanSima* this, PlayState* play);  // was func_8088E5D
 void BgHidanSima_Sink(BgHidanSima* this, PlayState* play);  // was func_8088E6D0 [LLM:HIGH]
 // LLM generated name (HIGH), was func_8088E760: the params 1 platform's pause between passes: on expiry it flips world.rot.y by 180 degrees and arms the 60-frame slide.
 void BgHidanSima_WaitToSlide(BgHidanSima* this, PlayState* play);  // was func_8088E760 [LLM:HIGH]
-void func_8088E7A8(BgHidanSima* this, PlayState* play);
+// LLM generated name (HIGH), was func_8088E7A8: sweeps the platform up to 200 units along its facing on a sine curve while looping the fire-pillar sfx, then returns to the pause.
+void BgHidanSima_Slide(BgHidanSima* this, PlayState* play);  // was func_8088E7A8 [LLM:HIGH]
 void func_8088E90C(BgHidanSima* this);
 
 const ActorInit Bg_Hidan_Sima_InitVars = {
@@ -173,11 +174,11 @@ void BgHidanSima_WaitToSlide(BgHidanSima* this, PlayState* play) {
     if (this->timer == 0) {
         this->dyna.actor.world.rot.y += 0x8000;
         this->timer = 60;
-        this->actionFunc = func_8088E7A8;
+        this->actionFunc = BgHidanSima_Slide;  // was func_8088E7A8 [LLM:HIGH]
     }
 }
 
-void func_8088E7A8(BgHidanSima* this, PlayState* play) {
+void BgHidanSima_Slide(BgHidanSima* this, PlayState* play) {
     f32 temp;
 
     if (this->timer != 0) {
@@ -219,11 +220,11 @@ void BgHidanSima_Update(Actor* thisx, PlayState* play) {
     if (this->dyna.actor.params != 0) {
         s32 temp = (this->dyna.actor.world.rot.y == this->dyna.actor.shape.rot.y) ? this->timer : (this->timer + 80);
 
-        if (this->actionFunc == func_8088E7A8) {
+        if (this->actionFunc == BgHidanSima_Slide) {  // was func_8088E7A8 [LLM:HIGH]
             temp += 20;
         }
         this->dyna.actor.world.pos.y = this->dyna.actor.home.pos.y - ((1.0f - cosf(temp * (M_PI / 20))) * 5.0f);
-        if (this->actionFunc == func_8088E7A8) {
+        if (this->actionFunc == BgHidanSima_Slide) {  // was func_8088E7A8 [LLM:HIGH]
             func_8088E90C(this);
             CollisionCheck_SetAT(play, &play->colChkCtx, &this->collider.base);
         }
@@ -287,7 +288,7 @@ void BgHidanSima_Draw(Actor* thisx, PlayState* play) {
         gSPDisplayList(POLY_OPA_DISP++, gFireTempleStonePlatform1DL);
     } else {
         gSPDisplayList(POLY_OPA_DISP++, gFireTempleStonePlatform2DL);
-        if (this->actionFunc == func_8088E7A8) {
+        if (this->actionFunc == BgHidanSima_Slide) {  // was func_8088E7A8 [LLM:HIGH]
             POLY_XLU_DISP = Gfx_SetupDL(POLY_XLU_DISP, 0x14);
             gDPSetPrimColor(POLY_XLU_DISP++, 0, 1, 255, 255, 0, 150);
             gDPSetEnvColor(POLY_XLU_DISP++, 255, 0, 0, 255);
