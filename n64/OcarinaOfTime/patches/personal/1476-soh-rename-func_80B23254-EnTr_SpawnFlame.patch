From 34f7100314d6f49828dea1b1f968be044f518317 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:17 +0000
Subject: [PATCH 1476/3799] soh: rename func_80B23254 -> EnTr_SpawnFlame

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: spawns one flame particle of the twin's own colour, offset across the camera-facing plane by sFlameXOffsets and sFlameYOffsets and thrown back toward the camera.
Defined in soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
index 658746dcd..84ded651f 100644
--- a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
+++ b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
@@ -215,7 +215,8 @@ void EnTr_FlyKidnapCutscene(EnTr* this, PlayState* play) {
     }
 }
 
-void func_80B23254(EnTr* this, PlayState* play, s32 arg2, f32 arg3, f32 scale) {
+// LLM generated name (HIGH), was func_80B23254: spawns one flame particle of the twin's own colour, offset across the camera-facing plane by sFlameXOffsets and sFlameYOffsets and thrown back toward the camera.
+void EnTr_SpawnFlame(EnTr* this, PlayState* play, s32 arg2, f32 arg3, f32 scale) {
     Vec3f pos;
     Vec3f velocity;
     Vec3f accel;
@@ -259,8 +260,8 @@ void EnTr_ShrinkVanish(EnTr* this, PlayState* play) {
         } else if (this->timer > 0) {
             s32 temp_hi = (this->timer * 2) % 7;
 
-            func_80B23254(this, play, temp_hi, 5.0f, 0.2f);
-            func_80B23254(this, play, (temp_hi + 1) % 7, 5.0f, 0.2f);
+            EnTr_SpawnFlame(this, play, temp_hi, 5.0f, 0.2f);  // was func_80B23254 [LLM:HIGH]
+            EnTr_SpawnFlame(this, play, (temp_hi + 1) % 7, 5.0f, 0.2f);  // was func_80B23254 [LLM:HIGH]
             Actor_SetScale(&this->actor, this->actor.scale.x * 0.9f);
             this->actor.shape.rot.y = (this->actor.shape.rot.y - (this->timer * 0x28F)) + 0x3D68;
         } else {
@@ -282,8 +283,8 @@ void EnTr_Reappear(EnTr* this, PlayState* play) {
     if (this->timer >= 31) {
         s32 temp_hi = (this->timer * 2) % 7;
 
-        func_80B23254(this, play, temp_hi, 5.0f, 1.0f);
-        func_80B23254(this, play, (temp_hi + 1) % 7, 5.0f, 1.0f);
+        EnTr_SpawnFlame(this, play, temp_hi, 5.0f, 1.0f);  // was func_80B23254 [LLM:HIGH]
+        EnTr_SpawnFlame(this, play, (temp_hi + 1) % 7, 5.0f, 1.0f);  // was func_80B23254 [LLM:HIGH]
     } else if (this->timer == 30) {
         this->actor.draw = EnTr_Draw;
         this->actor.shape.rot.y += this->timer * 0x1A6;
