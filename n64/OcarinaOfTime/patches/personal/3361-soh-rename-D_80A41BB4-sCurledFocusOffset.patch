From b0af4b161297e8127c9307d92b92dc31303000a8 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:00 +0000
Subject: [PATCH 3361/3799] soh: rename D_80A41BB4 -> sCurledFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the zero vector EnGo_DrawCurledUp records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Go/z_en_go.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Go/z_en_go.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Go/z_en_go.c b/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
index 29d53f78b..e5cfab72a 100644
--- a/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
+++ b/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
@@ -1060,7 +1060,7 @@ void EnGo_Update(Actor* thisx, PlayState* play) {
 }
 
 void EnGo_DrawCurledUp(EnGo* this, PlayState* play) {
-    Vec3f D_80A41BB4 = { 0.0f, 0.0f, 0.0f };
+    Vec3f sCurledFocusOffset = { 0.0f, 0.0f, 0.0f };  // was D_80A41BB4 [LLM:HIGH]
 
     OPEN_DISPS(play->state.gfxCtx);
 
@@ -1071,7 +1071,7 @@ void EnGo_DrawCurledUp(EnGo* this, PlayState* play) {
 
     gSPDisplayList(POLY_OPA_DISP++, gGoronDL_00BD80);
 
-    Matrix_MultVec3f(&D_80A41BB4, &this->actor.focus.pos);
+    Matrix_MultVec3f(&sCurledFocusOffset, &this->actor.focus.pos);  // was D_80A41BB4 [LLM:HIGH]
     Matrix_Pop();
 
     CLOSE_DISPS(play->state.gfxCtx);
