From d2267e8c3db37a4e4e4e7f2a44ea83167ee28c05 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:16:06 +0000
Subject: [PATCH 1385/3799] soh: rename func_80A89008 -> EnJs_SetupIdle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the idle action and starts the knee-slapping animation.
Defined in soh/src/overlays/actors/ovl_En_Js/z_en_js.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Js/z_en_js.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Js/z_en_js.c b/soh/src/overlays/actors/ovl_En_Js/z_en_js.c
index 1e599caff..21673359e 100644
--- a/soh/src/overlays/actors/ovl_En_Js/z_en_js.c
+++ b/soh/src/overlays/actors/ovl_En_Js/z_en_js.c
@@ -98,7 +98,8 @@ u8 EnJs_OfferTalk(EnJs* this, PlayState* play, u16 textId) {
     }
 }
 
-void func_80A89008(EnJs* this) {
+// LLM generated name (HIGH), was func_80A89008: installs the idle action and starts the knee-slapping animation.
+void EnJs_SetupIdle(EnJs* this) {
     En_Js_SetupAction(this, func_80A89304);
     Animation_Change(&this->skelAnime, &gCarpetMerchantSlappingKneeAnim, 1.0f, 0.0f,
                      Animation_GetLastFrame(&gCarpetMerchantSlappingKneeAnim), ANIMMODE_ONCE, -4.0f);
@@ -106,7 +107,7 @@ void func_80A89008(EnJs* this) {
 
 void func_80A89078(EnJs* this, PlayState* play) {
     if (Actor_TextboxIsClosing(&this->actor, play)) {
-        func_80A89008(this);
+        EnJs_SetupIdle(this);  // was func_80A89008 [LLM:HIGH]
         this->actor.flags &= ~ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED;
     }
 }
@@ -145,7 +146,7 @@ void func_80A891C4(EnJs* this, PlayState* play) {
             case 0: // yes
                 if (GameInteractor_Should(VB_CHECK_RANDO_PRICE_OF_CARPET_SALESMAN, gSaveContext.rupees < 200, this)) {
                     Message_ContinueTextbox(play, 0x6075);
-                    func_80A89008(this);
+                    EnJs_SetupIdle(this);  // was func_80A89008 [LLM:HIGH]
                 } else {
                     if (!GameInteractor_Should(VB_GIVE_ITEM_FROM_CARPET_SALESMAN, false, this)) {
                         if (GameInteractor_Should(VB_GIVE_BOMBCHUS_FROM_CARPET_SALESMAN, true, this) ||
@@ -154,14 +155,14 @@ void func_80A891C4(EnJs* this, PlayState* play) {
                             En_Js_SetupAction(this, func_80A89160);
                         } else {
                             Message_ContinueTextbox(play, 0x6073);
-                            func_80A89008(this);
+                            EnJs_SetupIdle(this);  // was func_80A89008 [LLM:HIGH]
                         }
                     }
                 }
                 break;
             case 1: // no
                 Message_ContinueTextbox(play, 0x6074);
-                func_80A89008(this);
+                EnJs_SetupIdle(this);  // was func_80A89008 [LLM:HIGH]
         }
     }
 }
