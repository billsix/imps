--- a/soh/src/overlays/actors/ovl_En_Zl4/z_en_zl4_cutscene_data.c
+++ b/soh/src/overlays/actors/ovl_En_Zl4/z_en_zl4_cutscene_data.c
@@ -192,7 +192,8 @@ static CutsceneCameraPoint sCsCameraAtPoints10[] = {  // was D_80B5F990 [LLM:HIG
     { 0, 0, 30, 20.799965f, { -511, 121, 7 } },   { 0, 0, 30, 20.799965f, { -511, 121, 7 } },
     { -1, 0, 30, 20.799965f, { -511, 121, 7 } },  { -1, 0, 30, 20.799965f, { -511, 121, 7 } },
 };
-static CutsceneCameraPoint D_80B5FA10[] = {
