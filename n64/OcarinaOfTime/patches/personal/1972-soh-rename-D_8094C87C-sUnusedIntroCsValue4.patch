Subject: [PATCH 1972/3799] soh: rename D_8094C87C -> sUnusedIntroCsValue4

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: only ever zeroed with the rest of this group; never written with a value and never read
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index b9cac330c..669f8df35 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -207,7 +207,8 @@ static s16 sUnusedIntroCsValue2;  // was D_8094C876 [LLM:GUESS]
 static u8 sUnusedIntroCsFlag1;  // was D_8094C878 [LLM:GUESS]
 // LLM generated name (GUESS), was D_8094C87A: written as 335 during the intro cutscene and never read
 static s16 sUnusedIntroCsValue3;  // was D_8094C87A [LLM:GUESS]
-static s16 D_8094C87C;
+// LLM generated name (GUESS), was D_8094C87C: only ever zeroed with the rest of this group; never written with a value and never read
+static s16 sUnusedIntroCsValue4;  // was D_8094C87C [LLM:GUESS]
 static u8 D_8094C87E;
 static BossTwEffect sEffects[150];
 
@@ -479,7 +480,7 @@ void BossTw_Init(Actor* thisx, PlayState* play2) {
         play->envCtx.unk_BD = 1;
         play->envCtx.unk_D8 = 0.0f;
 
-        sUnusedIntroCsValue1 = sUnusedIntroCsValue2 = sUnusedIntroCsFlag1 = sUnusedIntroCsValue3 = D_8094C87C = D_8094C87E = sShieldBlastActive = sShieldFlashTimer =  // was D_8094C86F [LLM:HIGH]
+        sUnusedIntroCsValue1 = sUnusedIntroCsValue2 = sUnusedIntroCsFlag1 = sUnusedIntroCsValue3 = sUnusedIntroCsValue4 = D_8094C87E = sShieldBlastActive = sShieldFlashTimer =  // was D_8094C86F [LLM:HIGH]
             sShieldFlashScroll = sBeamDivertTimer = sEnvType = sGroundBlastType = sFreezeState = sTwinrovaBlastType =  // was D_8094C872 [LLM:HIGH]
                 sFixedBlatSeq = sShieldFireCharge = sShieldIceCharge = 0;
 
