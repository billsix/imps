From 6817e26747f33e6f8bb66499e4299212b74cf2e3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:48:26 +0000
Subject: [PATCH 1107/3799] soh: rename D_80AF10A4 -> sRunToSapphireCs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: CutsceneData installed by the VB_RUTO_RUN_TO_SAPPHIRE branch, when Ruto is standing on the right Bg_Bdan_Objects platform.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1_cutscene_data.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c               | 2 +-
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1_cutscene_data.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index d3b570cba..5e6b6ed01 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1692,7 +1692,7 @@ s32 EnRu1_IsOnSapphirePlatform(EnRu1* this, PlayState* play) {
                                       play->msgCtx.msgLength == 0,
                                   this, dynaPolyActor)) {
             EnRu1_StopMoving(this);
-            play->csCtx.segment = &D_80AF10A4;
+            play->csCtx.segment = &sRunToSapphireCs;  // was D_80AF10A4 [LLM:HIGH]
             gSaveContext.cutsceneTrigger = 1;
             this->action = 36;
             this->drawConfig = 0;
diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1_cutscene_data.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1_cutscene_data.c
index e4a387ddf..1a0ab63d1 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1_cutscene_data.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1_cutscene_data.c
@@ -114,7 +114,8 @@ static CutsceneData sFirstEncounterCs[] = {  // was D_80AF0880 [LLM:HIGH]
 // LLM generated name (GUESS), was D_80AF10A0: a zero u32 sitting between two CutsceneData arrays with no reader anywhere; it reads as padding between them, but nothing confirms that.
 static u32 sUnusedCsValue1 = 0;  // was D_80AF10A0 [LLM:GUESS]
 
-static CutsceneData D_80AF10A4[] = {
+// LLM generated name (HIGH), was D_80AF10A4: CutsceneData installed by the VB_RUTO_RUN_TO_SAPPHIRE branch, when Ruto is standing on the right Bg_Bdan_Objects platform.
+static CutsceneData sRunToSapphireCs[] = {  // was D_80AF10A4 [LLM:HIGH]
     CS_BEGIN_CUTSCENE(14, 1299),
     CS_PLAYER_ACTION_LIST(3),
         CS_PLAYER_ACTION(0x0005, 0, 272, 0x0000, 0xC000, 0x0000, -1085, -1025, -3347, -1085, -1025, -3347, 1.1393037E-29f, 0.0f, 1.4E-45f),
