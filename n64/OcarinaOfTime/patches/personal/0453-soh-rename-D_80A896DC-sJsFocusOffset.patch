From bdc39f1f6b42d0218174c6af37044e2612b79cbb Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:38 +0000
Subject: [PATCH 453/488] soh: rename D_80A896DC -> sJsFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the zero vector EnJs_PostLimbDraw records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Js/z_en_js.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Js/z_en_js.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Js/z_en_js.c b/soh/src/overlays/actors/ovl_En_Js/z_en_js.c
index 6c2ccfe31..260883908 100644
--- a/soh/src/overlays/actors/ovl_En_Js/z_en_js.c
+++ b/soh/src/overlays/actors/ovl_En_Js/z_en_js.c
@@ -238,11 +238,11 @@ s32 EnJs_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 }
 
 void EnJs_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
-    static Vec3f D_80A896DC = { 0.0f, 0.0f, 0.0f };
+    static Vec3f sJsFocusOffset = { 0.0f, 0.0f, 0.0f };  // was D_80A896DC [LLM:HIGH]
     EnJs* this = (EnJs*)thisx;
 
     if (limbIndex == 12) {
-        Matrix_MultVec3f(&D_80A896DC, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sJsFocusOffset, &this->actor.focus.pos);  // was D_80A896DC [LLM:HIGH]
     }
 }
 void EnJs_Draw(Actor* thisx, PlayState* play) {
