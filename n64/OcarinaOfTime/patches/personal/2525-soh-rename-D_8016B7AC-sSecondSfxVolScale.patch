From 2f3333c4df23d9b722b7d7444c81d4a35624fba1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:32:58 +0000
Subject: [PATCH 2525/3799] soh: rename D_8016B7AC -> sSecondSfxVolScale

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the volume scale for the second sound Audio_PlayWalkSfx may add
Defined in soh/src/code/audio_general.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_general.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index a3b4e4047..4d0364029 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -1263,7 +1263,8 @@ u32 sAudioUpdateStartTime; // decomp: debug only
 u32 sAudioUpdateEndTime;   // decomp: debug only
 // LLM generated name (HIGH), was D_8016B7A8: the volume scale Audio_SetSfxScalesFromSpeed writes, 0.775 to 1.0
 f32 sSpeedVolScale;  // was D_8016B7A8 [LLM:HIGH]
-f32 D_8016B7AC;
+// LLM generated name (HIGH), was D_8016B7AC: the volume scale for the second sound Audio_PlayWalkSfx may add
+f32 sSecondSfxVolScale;  // was D_8016B7AC [LLM:HIGH]
 f32 D_8016B7B0;
 f32 D_8016B7B4;
 FreqLerp sRiverFreqScaleLerp;
@@ -1355,7 +1356,7 @@ s32 sAudioUpdateTaskEnd;      // decomp: debug only
     F(sSariaBgmPtr)                                    \
     F(sNearestBgmSourceDist)                                      \
     F(sSpeedVolScale)                                      \
-    F(D_8016B7AC)                                      \
+    F(sSecondSfxVolScale)                                      \
     F(D_8016B7B0)                                      \
     F(D_8016B7B4)                                      \
     F(sRiverFreqScaleLerp)                             \
@@ -4428,8 +4429,8 @@ void Audio_PlayWalkSfx(Vec3f* pos, u16 sfxId, f32 arg2) {
         } else {
             sfxId2 = NA_SE_PL_METALEFFECT_KID;
         }
-        D_8016B7AC = (sp24 * 0.7) + 0.3;
-        Audio_PlaySfxGeneral(sfxId2, pos, 4, &D_8016B7B0, &D_8016B7AC, &gSfxDefaultReverb);
+        sSecondSfxVolScale = (sp24 * 0.7) + 0.3;  // was D_8016B7AC [LLM:HIGH]
+        Audio_PlaySfxGeneral(sfxId2, pos, 4, &D_8016B7B0, &sSecondSfxVolScale, &gSfxDefaultReverb);  // was D_8016B7AC [LLM:HIGH]
     }
 }
 
