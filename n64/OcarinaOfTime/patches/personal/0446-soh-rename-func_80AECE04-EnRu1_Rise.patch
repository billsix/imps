     EnRu1_SetMouthIndex(this, 2);
 }
 
-void func_80AECE04(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AECE04): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_Rise(EnRu1* this, PlayState* play) {
     this->actor.shape.yOffset += (250.0f / 3.0f);
 }
 
@@ -1185,7 +1186,7 @@ void func_80AED324(EnRu1* this, PlayState* play) {
 }
 
