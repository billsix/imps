Date: Tue, 8 Sep 2026 01:52:01 +0000
Subject: [PATCH 3578/3799] soh: rename func_80B500E0 -> EnZl2_MoveAlongCue

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: eases Zelda between the cue's start and end positions, accelerating and decelerating at both ends
Defined in soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c b/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
index a17d7ea17..c6b0cdff0 100644
--- a/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
+++ b/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
@@ -738,7 +738,8 @@ void EnZl2_MoveCrystalToSelf(EnZl2* this) {
     }
 }
 
-void func_80B500E0(EnZl2* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B500E0: eases Zelda between the cue's start and end positions, accelerating and decelerating at both ends
+void EnZl2_MoveAlongCue(EnZl2* this, PlayState* play) {
     CsCmdActorCue* npcAction = EnZl2_GetNpcAction(play, 0);
     Vec3f* thisPos = &this->actor.world.pos;
     f32 startX;
@@ -1078,7 +1079,7 @@ void EnZl2_Action3(EnZl2* this, PlayState* play) {
     EnZl2_UpdateBgCheck(this, play);  // was func_80B4ED2C [LLM:HIGH]
     EnZl2_UpdateEyes(this);
     EnZl2_UpdateSkelAnime(this);
-    func_80B500E0(this, play);
+    EnZl2_MoveAlongCue(this, play);  // was func_80B500E0 [LLM:HIGH]
     EnZl2_SetupAction4OnCueEnd(this, play);  // was func_80B503DC [LLM:HIGH]
 }
 
@@ -1224,7 +1225,7 @@ void EnZl2_Action22(EnZl2* this, PlayState* play) {
     EnZl2_PlayAscendSfx(this);  // was func_80B4FE48 [LLM:HIGH]
     EnZl2_UpdateBgCheck(this, play);  // was func_80B4ED2C [LLM:HIGH]
     EnZl2_UpdateSkelAnime(this);
-    func_80B500E0(this, play);
+    EnZl2_MoveAlongCue(this, play);  // was func_80B500E0 [LLM:HIGH]
     EnZl2_MoveCrystalToSelf(this);  // was func_80B5008C [LLM:HIGH]
     func_80B50A04(this, play);
 }
