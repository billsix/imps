@@ -656,12 +657,12 @@ void EnNiw_Held(EnNiw* this, PlayState* play) {
         this->actor.shape.rot.y = this->actor.shape.rot.z;
         this->actor.shape.rot.x = this->actor.shape.rot.z;
         this->actor.flags |= ACTOR_FLAG_ATTENTION_ENABLED;
-        this->actionFunc = func_80AB6D08;
+        this->actionFunc = EnNiw_FlutterAfterRelease;  // was func_80AB6D08 [LLM:GUESS]
     }
     EnNiw_AnimateLimbs(this, play, 2);  // was func_80AB5BF8 [LLM:HIGH]
