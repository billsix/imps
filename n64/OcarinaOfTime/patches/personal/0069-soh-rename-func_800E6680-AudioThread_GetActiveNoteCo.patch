Subject: [PATCH 069/225] soh: rename func_800E6680 ->
 AudioThread_GetActiveNoteCount

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/audio_thread.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h      | 2 +-
 soh/src/code/audio_general.c | 2 +-
 soh/src/code/audio_thread.c  | 3 ++-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 502924e3b..ed9092f93 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1999,7 +1999,7 @@ u8* AudioThread_GetFontsForSequence(s32 arg0, u32* arg1);  // was func_800E5E84
 s32 AudioThread_ResetComplete(void);  // was func_800E5EDC [LLM:HIGH]
 s32 AudioThread_ResetAudioHeap(s32 arg0);  // was func_800E5F88 [oot]
 void Audio_PreNMIInternal(void);
-s32 func_800E6680(void);
+s32 AudioThread_GetActiveNoteCount(void);  // was func_800E6680 [LLM:HIGH]
 u32 Audio_NextRandom(void);
 void Audio_InitMesgQueues(void);
 void Audio_InvalDCache(void* buf, size_t size);
diff --git a/soh/src/code/audio_general.c b/soh/src/code/audio_general.c
index 4ec708d26..cbf1530c7 100644
--- a/soh/src/code/audio_general.c
+++ b/soh/src/code/audio_general.c
@@ -5417,7 +5417,7 @@ void Audio_DisableAllSeq(void) {
 }
 
