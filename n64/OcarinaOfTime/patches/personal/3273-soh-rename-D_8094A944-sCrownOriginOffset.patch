From f9f7e46b9aef7da85733af8c50ffc3d4f5421198 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:53 +0000
Subject: [PATCH 3273/3799] soh: rename D_8094A944 -> sCrownOriginOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the zero vector limb 21 records the head focus position from
Defined in soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
index 7f2cef78e..f417100f7 100644
--- a/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
+++ b/soh/src/overlays/actors/ovl_Boss_Tw/z_boss_tw.c
@@ -3213,7 +3213,7 @@ s32 BossTw_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f*
 }
 
 void BossTw_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
-    static Vec3f D_8094A944 = { 0.0f, 0.0f, 0.0f };
+    static Vec3f sCrownOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_8094A944 [LLM:HIGH]
     static Vec3f D_8094A950 = { 0.0f, 2000.0f, -2000.0f };
     static Vec3f D_8094A95C[] = {
         { 0.0f, 0.0f, -10000.0f }, { 0.0f, 0.0f, -8000.0f },  { 0.0f, 0.0f, -9000.0f },
@@ -3225,7 +3225,7 @@ void BossTw_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
 
     switch (limbIndex) {
         case 21:
-            Matrix_MultVec3f(&D_8094A944, &this->actor.focus.pos);
+            Matrix_MultVec3f(&sCrownOriginOffset, &this->actor.focus.pos);  // was D_8094A944 [LLM:HIGH]
             Matrix_MultVec3f(&D_8094A950, &this->crownPos);
 
             if (this->unk_5F8 != 0) {
