From 0ce747ce839850f9b80357c9980cab3090f8f7e6 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:25:00 +0000
Subject: [PATCH 1529/3799] soh: rename func_80ABCDBC -> EnNy_SetupMove

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: resets the turn rate, refreshes the swim speed, arms the 180-frame chase timer and installs EnNy_Move.
Defined in soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
index 69865a9ce..aea82735f 100644
--- a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
+++ b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
@@ -15,7 +15,8 @@ void EnNy_Move(EnNy* this, PlayState* play);
 void EnNy_Die(EnNy* this, PlayState* play);
 // LLM generated name (HIGH), was func_80ABCD40: sets the Shellblade's target speed, slowing it to 70 percent while it is under water.
 void EnNy_UpdateSwimSpeed(EnNy* this);  // was func_80ABCD40 [LLM:HIGH]
-void func_80ABCDBC(EnNy* this);
+// LLM generated name (HIGH), was func_80ABCDBC: resets the turn rate, refreshes the swim speed, arms the 180-frame chase timer and installs EnNy_Move.
+void EnNy_SetupMove(EnNy* this);  // was func_80ABCDBC [LLM:HIGH]
 void EnNy_TurnToStone(EnNy* this, PlayState* play);
 void func_80ABD11C(EnNy* this, PlayState* play);
 // LLM generated name (HIGH), was func_80ABCE50: stays stone until the player is within 160 units, then starts the shell opening.
@@ -140,7 +141,7 @@ void EnNy_Init(Actor* thisx, PlayState* play) {
         this->unk_1D4 = 0;
         this->unk_1D8 = 0xFF;
         this->unk_1E0 = 1.0f;
-        func_80ABCDBC(this);
+        EnNy_SetupMove(this);  // was func_80ABCDBC [LLM:HIGH]
     } else {
         // This mode is unused in the final game
         // "Dummy new initials"
@@ -180,7 +181,7 @@ void EnNy_SetupGrow(EnNy* this) {
     this->actionFunc = EnNy_Grow;  // was func_80ABCEEC [LLM:HIGH]
 }
 
-void func_80ABCDBC(EnNy* this) {
+void EnNy_SetupMove(EnNy* this) {
     this->unk_1F4 = 0.0f;
     EnNy_UpdateSwimSpeed(this);  // was func_80ABCD40 [LLM:HIGH]
     this->stoneTimer = 180;
@@ -226,7 +227,7 @@ void EnNy_Grow(EnNy* this, PlayState* play) {
     phi_f0 += 2.0f;
     if (phi_f0 >= 1.0f) {
         phi_f0 = 1.0f;
-        func_80ABCDBC(this);
+        EnNy_SetupMove(this);  // was func_80ABCDBC [LLM:HIGH]
     }
     this->unk_1E0 = phi_f0;
 }
