From 766201bfbbcab8040cf995070b59f5d2acae8627 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:04 +0000
Subject: [PATCH 3195/3799] soh: rename D_8011DA9C -> sSpec7EyeLowPoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the fixed eye positions it uses below that threshold
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c        | 4 ++--
 soh/src/code/z_camera_data.inc | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index c285f7f92..acbfdc323 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -6664,7 +6664,7 @@ s32 Camera_Special5(Camera* camera) {
 }
 
 /**
- * Camera's eye is fixed at points specified at sSpec7EyeHighPoints / D_8011DA9C  // was D_8011DA6C [LLM:HIGH]
+ * Camera's eye is fixed at points specified at sSpec7EyeHighPoints / sSpec7EyeLowPoints  // was D_8011DA6C [LLM:HIGH]
  * depending on the player's position
  */
 s32 Camera_Special7(Camera* camera) {
@@ -6703,7 +6703,7 @@ s32 Camera_Special7(Camera* camera) {
         atTarget.y += yOffset;
         Camera_LERPCeilVec3f(&atTarget, &camera->at, 0.4f, 0.4f, 0.1f);
         camera->roll = 0;
-        camera->eye = camera->eyeNext = D_8011DA9C[spec7->idx];
+        camera->eye = camera->eyeNext = sSpec7EyeLowPoints[spec7->idx];  // was D_8011DA9C [LLM:HIGH]
         camera->fov = 70.0f;
     }
 
diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index 3fe5b9222..a7733aade 100644
--- a/soh/src/code/z_camera_data.inc
+++ b/soh/src/code/z_camera_data.inc
@@ -2399,7 +2399,8 @@ Vec3f sSpec7EyeHighPoints[] = {  // was D_8011DA6C [LLM:HIGH]
     { 3050.0f, 700.0f, 0.0f }, { 1755.0f, 3415.0f, -380.0f }, { -3120.0f, 3160.0f, 245.0f }, { 0.0f, -10.0f, 240.0f }
 };
 
-Vec3f D_8011DA9C[] = {
+// LLM generated name (HIGH), was D_8011DA9C: the fixed eye positions it uses below that threshold
+Vec3f sSpec7EyeLowPoints[] = {  // was D_8011DA9C [LLM:HIGH]
     { 3160.0f, 2150.0f, 0.0f },
     { 1515.0f, 4130.0f, -835.0f },
     { -3040.0f, 4135.0f, 230.0f },
-- 
2.55.0

