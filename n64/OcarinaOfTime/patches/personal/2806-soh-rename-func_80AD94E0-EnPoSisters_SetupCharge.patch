-            func_80AD94E0(this);
+            EnPoSisters_SetupCharge(this);  // was func_80AD94E0 [LLM:HIGH]
         } else {
             func_80AD9C24(this, play);
         }
@@ -996,7 +997,7 @@ void func_80ADB770(EnPoSisters* this, PlayState* play) {
     } else if (this->unk_19C < 0) {
         this->unk_19C++;
