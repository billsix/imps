From bfe007c1746d060a38bf06e23650bffb5b04f0bc Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:41 +0000
Subject: [PATCH 2882/3799] soh: rename func_80B3D6F0 -> EnXc_AccelerateStep

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: runs the XZ acceleration step
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index f874181f9..3c2e53add 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -671,7 +671,8 @@ void EnXc_CalcXZSpeed(EnXc* this) {
     Actor_MoveXZGravity(&this->actor);
 }
 
-void func_80B3D6F0(EnXc* this) {
+// LLM generated name (HIGH), was func_80B3D6F0: runs the XZ acceleration step
+void EnXc_AccelerateStep(EnXc* this) {
     EnXc_CalcXZAccel(this);
 }
 
@@ -1046,7 +1047,7 @@ void EnXc_ActionFunc13(EnXc* this, PlayState* play) {
 }
 
 void EnXc_ReverseAccelerate(EnXc* this, PlayState* play) {
-    func_80B3D6F0(this);
+    EnXc_AccelerateStep(this);  // was func_80B3D6F0 [LLM:HIGH]
     EnXc_AnimIsFinished(this);
     EnXc_BgCheck(this, play);
     EnXc_SetEyePattern(this);
@@ -1235,7 +1236,7 @@ void EnXc_ActionFunc22(EnXc* this, PlayState* play) {
 }
 
 void EnXc_ActionFunc23(EnXc* this, PlayState* play) {
-    func_80B3D6F0(this);
+    EnXc_AccelerateStep(this);  // was func_80B3D6F0 [LLM:HIGH]
     EnXc_AnimIsFinished(this);
     EnXc_BgCheck(this, play);
     EnXc_SetEyePattern(this);
