From 7e8a04232e5a5e3876722c689dd80618db6e722f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:22 +0000
Subject: [PATCH 233/784] soh: rename func_800C8BC4 ->
 Sched_SetNextFramebufferFromTask

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.86.
Defined in soh/src/code/sched.c.
---
 soh/include/functions.h | 2 +-
 soh/src/code/sched.c    | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 67e9f1fa6..c31547e05 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1701,7 +1701,7 @@ void Sched_QueueTask(SchedContext* sc, OSScTask* task);
 void Sched_Yield(SchedContext* sc);
 OSScTask* func_800C89D4(SchedContext* sc, OSScTask* task);
 s32 Sched_Schedule(SchedContext* sc, OSScTask** sp, OSScTask** dp, s32 state);
-void func_800C8BC4(SchedContext* sc, OSScTask* task);
+void Sched_SetNextFramebufferFromTask(SchedContext* sc, OSScTask* task);  // was func_800C8BC4 [oot]
 u32 Sched_IsComplete(SchedContext* sc, OSScTask* task);
 void Sched_RunTask(SchedContext* sc, OSScTask* spTask, OSScTask* dpTask);
 void Sched_HandleEntry(SchedContext* sc);
diff --git a/soh/src/code/sched.c b/soh/src/code/sched.c
index 944df1af7..be815445b 100644
--- a/soh/src/code/sched.c
+++ b/soh/src/code/sched.c
@@ -218,7 +218,8 @@ s32 Sched_Schedule(SchedContext* sc, OSScTask** sp, OSScTask** dp, s32 state) {
     return ret;
 }
 
-void func_800C8BC4(SchedContext* sc, OSScTask* task) {
+// Name from zeldaret/oot (was func_800C8BC4): adopted upstream's name for this address; body verified to match upstream at 0.86. [oot: https://github.com/zeldaret/oot/blob/main/src/code/sched.c]
+void Sched_SetNextFramebufferFromTask(SchedContext* sc, OSScTask* task) {
     if (sc->pendingSwapBuf1 == NULL) {
         sc->pendingSwapBuf1 = task->framebuffer;
 
@@ -237,7 +238,7 @@ u32 Sched_IsComplete(SchedContext* sc, OSScTask* task) {
         }
 
         if (task->flags & OS_SC_SWAPBUFFER) {
-            func_800C8BC4(sc, task);
+            Sched_SetNextFramebufferFromTask(sc, task);
         }
 
         return 1;
-- 
2.55.0

