Date: Mon, 7 Sep 2026 23:49:35 +0000
Subject: [PATCH 2768/3799] soh: rename func_80034B54 ->
 Actor_AllocXluRenderModeDList

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: allocates a display list that sets the translucent fog render mode and ends
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 6c8e8d5fd..5fed7230a 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -4600,7 +4600,8 @@ Gfx* Actor_AllocEmptyDList(GraphicsContext* gfxCtx) {
     return displayList;
 }
 
-Gfx* func_80034B54(GraphicsContext* gfxCtx) {
+// LLM generated name (HIGH), was func_80034B54: allocates a display list that sets the translucent fog render mode and ends
+Gfx* Actor_AllocXluRenderModeDList(GraphicsContext* gfxCtx) {
     Gfx* displayListHead;
     Gfx* displayList;
 
@@ -4640,7 +4641,7 @@ void func_80034CC4(PlayState* play, SkelAnime* skelAnime, OverrideLimbDraw overr
 
     gDPPipeSync(POLY_XLU_DISP++);
     gDPSetEnvColor(POLY_XLU_DISP++, 0, 0, 0, alpha);
-    gSPSegment(POLY_XLU_DISP++, 0x0C, func_80034B54(play->state.gfxCtx));
+    gSPSegment(POLY_XLU_DISP++, 0x0C, Actor_AllocXluRenderModeDList(play->state.gfxCtx));  // was func_80034B54 [LLM:HIGH]
 
     POLY_XLU_DISP = SkelAnime_DrawFlex(play, skelAnime->skeleton, skelAnime->jointTable, skelAnime->dListCount,
                                        overrideLimbDraw, postLimbDraw, actor, POLY_XLU_DISP);
