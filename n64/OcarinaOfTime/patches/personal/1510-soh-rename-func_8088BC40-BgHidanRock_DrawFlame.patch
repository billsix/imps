From ac8de2d307de88ace7b54e674467e2b58680b4fb Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:23:58 +0000
Subject: [PATCH 1510/3799] soh: rename func_8088BC40 -> BgHidanRock_DrawFlame

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: draws the big vertical flame column beneath the block, billboarded to the camera and scaled by the fade value the rise and fall actions drive.
Defined in soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
index 65cd50c3e..6b0f39e22 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Rock/z_bg_hidan_rock.c
@@ -36,7 +36,8 @@ void BgHidanRock_HangAtTop(BgHidanRock* this, PlayState* play);  // was func_808
 // LLM generated name (HIGH), was func_8088B990: eases the block up to its per-type height, fading the flame column in as it goes, and on arrival arms the pause before it drops.
 void BgHidanRock_Rise(BgHidanRock* this, PlayState* play);  // was func_8088B990 [LLM:HIGH]
 
-void func_8088BC40(PlayState* play, BgHidanRock* this);
+// LLM generated name (HIGH), was func_8088BC40: draws the big vertical flame column beneath the block, billboarded to the camera and scaled by the fade value the rise and fall actions drive.
+void BgHidanRock_DrawFlame(PlayState* play, BgHidanRock* this);  // was func_8088BC40 [LLM:HIGH]
 
 // LLM generated name (HIGH), was D_8088BF60: the fixed position the pushable Fire Temple block settles at; Init snaps to it when the switch flag is already set, the push action tests against it and the flame is drawn there.
 static Vec3f sPushedRestPos = { 3310.0f, 120.0f, 0.0f };  // was D_8088BF60 [LLM:HIGH]
@@ -368,7 +369,7 @@ static void* sVerticalFlamesTexs[] = {
     gFireTempleBigVerticalFlame6Tex, gFireTempleBigVerticalFlame7Tex,
 };
 
-void func_8088BC40(PlayState* play, BgHidanRock* this) {
+void BgHidanRock_DrawFlame(PlayState* play, BgHidanRock* this) {
     s32 pad;
 
     OPEN_DISPS(play->state.gfxCtx);
@@ -413,7 +414,7 @@ void BgHidanRock_Draw(Actor* thisx, PlayState* play) {
         }
 
         Sfx_PlaySfxAtPos(&this->unk_170, NA_SE_EV_FIRE_PILLAR - SFX_FLAG);
-        func_8088BC40(play, this);
+        BgHidanRock_DrawFlame(play, this);  // was func_8088BC40 [LLM:HIGH]
     }
 }
 
