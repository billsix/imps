From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 02:01:53 +0000
Subject: [PATCH 3752/3799] soh: rename func_80B57C8C ->
 EnZl3_IsOnLastPathSegment

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: true when the path has no waypoint two ahead of the current one
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index 85b6cf8ae..efff289a7 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -2110,7 +2110,8 @@ s32 EnZl3_ReturnTrue(EnZl3* this, PlayState* play) {
     return 1;
 }
 
-s32 func_80B57C8C(EnZl3* this) {
+// LLM generated name (GUESS), was func_80B57C8C: true when the path has no waypoint two ahead of the current one
+s32 EnZl3_IsOnLastPathSegment(EnZl3* this) {
     return !EnZl3_PathHasPoint(this, this->unk_314 + 2);  // was func_80B56F8C [LLM:GUESS]
 }
 
@@ -2200,7 +2201,7 @@ void func_80B58014(EnZl3* this, PlayState* play) {
         EnZl3_ChangeAnim(this, &gZelda2Anime2Anim_003FF8, 0, -11.0f, 0);  // was func_80B54E14 [LLM:HIGH]
         this->action = 29;
         EnZl3_UpdateTurnToPlayer(this);  // was func_80B538B0 [LLM:GUESS]
-    } else if (func_80B57C8C(this) && func_80B57F84(this, play)) {
+    } else if (EnZl3_IsOnLastPathSegment(this) && func_80B57F84(this, play)) {  // was func_80B57C8C [LLM:GUESS]
         OnePointCutscene_Init(play, 4000, -99, &this->actor, CAM_ID_MAIN);
         this->unk_3D0 = 0;
     } else if (EnZl3_ShouldStageStalfosAmbush(this, play) && EnZl3_IsPlayerWithin150(this, play) && !Play_InCsMode(play)) {  // was func_80B575B0 [LLM:HIGH]
@@ -2209,7 +2210,7 @@ void func_80B58014(EnZl3* this, PlayState* play) {
         EnZl3_StepYawTowardsPlayer(this);  // was func_80B537E8 [LLM:HIGH]
         this->unk_3D8 = 1;
         OnePointCutscene_Init(play, 4010, -99, &this->actor, CAM_ID_MAIN);
-    } else if (!func_80B57C8C(this) && !EnZl3_ShouldStageStalfosAmbush(this, play) && EnZl3_ShouldWaitForPlayer(this, play)) {  // was func_80B57564 [LLM:GUESS]
+    } else if (!EnZl3_IsOnLastPathSegment(this) && !EnZl3_ShouldStageStalfosAmbush(this, play) && EnZl3_ShouldWaitForPlayer(this, play)) {  // was func_80B57564 [LLM:GUESS]
         EnZl3_ChangeAnim(this, &gZelda2Anime2Anim_009BE4, 0, -8.0f, 0);  // was func_80B54E14 [LLM:HIGH]
         EnZl3_PlayWaypointCutscene(this, play);  // was func_80B5764C [LLM:GUESS]
         this->action = 34;
