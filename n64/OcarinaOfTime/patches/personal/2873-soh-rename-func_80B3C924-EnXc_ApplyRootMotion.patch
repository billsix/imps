From e16dabc938c6eba20a6df8ed02e37907b9fd588d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:41 +0000
Subject: [PATCH 2873/3799] soh: rename func_80B3C924 -> EnXc_ApplyRootMotion

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: queues the animation's root motion unconditionally
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 968f725c0..1b0dc9f5c 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -257,7 +257,8 @@ void EnXc_ApplyRootMotionAboveBase(EnXc* this, PlayState* play) {
     }
 }
 
-void func_80B3C924(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B3C924: queues the animation's root motion unconditionally
+void EnXc_ApplyRootMotion(EnXc* this, PlayState* play) {
     this->skelAnime.movementFlags |= 3;
     AnimationContext_SetMoveActor(play, &this->actor, &this->skelAnime, 1.0f);
 }
@@ -2072,7 +2073,7 @@ void EnXc_Contort(EnXc* this, PlayState* play) {
     EnXc_AnimIsFinished(this);
     EnXc_SetEyePattern(this);
     if (!EnXc_SetupNocturneState(&this->actor, play)) {
-        func_80B3C924(this, play);
+        EnXc_ApplyRootMotion(this, play);  // was func_80B3C924 [LLM:HIGH]
         EnXc_BgCheck(this, play);
     }
 }
