From 6bcc96db7cfe3d5d702df3cb7356c566b3471193 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:43 +0000
Subject: [PATCH 3136/3799] soh: rename D_80122C64 -> sCs4220KeyFramesB

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the set it uses otherwise
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 2d0f16dbe..cd850063e 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -919,7 +919,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Quake_SetCountdown(i, timer - 80);
             break;
         case 4220:
-            csInfo->keyFrames = (player->actor.world.pos.z < -15.0f) ? sCs4220KeyFramesA : D_80122C64;  // was D_80122C3C [LLM:HIGH]
+            csInfo->keyFrames = (player->actor.world.pos.z < -15.0f) ? sCs4220KeyFramesA : sCs4220KeyFramesB;  // was D_80122C3C [LLM:HIGH]
             csInfo->keyFrameCnt = 1;
 
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index d9f23ca1a..a45a149bc 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -577,7 +577,8 @@ static OnePointCsFull sCs4220KeyFramesA[1] = {  // was D_80122C3C [LLM:HIGH]
     { 0x0F, 0xFF, 0x0101, 999, -2, 70.0f, 1.0f, { -62.0f, 60.0f, -315.0f }, { -115.0f, 30.0f, -445.0f } },
 };
 
-static OnePointCsFull D_80122C64[1] = {
+// LLM generated name (HIGH), was D_80122C64: the set it uses otherwise
+static OnePointCsFull sCs4220KeyFramesB[1] = {  // was D_80122C64 [LLM:HIGH]
     { 0x0F, 0xFF, 0x0101, 999, 3, 70.0f, 1.0f, { -40.0f, 80.0f, 375.0f }, { -85.0f, 45.0f, 485.0f } },
 };
 
