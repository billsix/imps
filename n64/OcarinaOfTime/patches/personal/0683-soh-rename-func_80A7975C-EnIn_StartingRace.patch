From 2ea23c88b4536977b2eec78ff3b5abde506a53df Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:29 +0000
Subject: [PATCH 0683/3799] soh: rename func_80A7975C -> EnIn_StartingRace

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_In/z_en_in.c.
---
 soh/src/overlays/actors/ovl_En_In/z_en_in.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_In/z_en_in.c b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
index 9607245d9..1992f7911 100644
--- a/soh/src/overlays/actors/ovl_En_In/z_en_in.c
+++ b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
@@ -361,7 +361,8 @@ void EnIn_ChangeAnim(EnIn* this, s32 index) {
                      sAnimationInfo[index].morphFrames);
 }
 
-s32 func_80A7975C(EnIn* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80A7975C): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_In/z_en_in.c]
+s32 EnIn_StartingRace(EnIn* this, PlayState* play) {
     if (this->actor.params != 1 || this->actor.shape.rot.z != 1 || !LINK_IS_ADULT) {
         return 0;
     }
@@ -526,7 +527,7 @@ void EnIn_WaitForObject(EnIn* this, PlayState* play) {
         Collider_InitCylinder(play, &this->collider);
         Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);
         CollisionCheck_SetInfo2(&this->actor.colChkInfo, NULL, &sColChkInfoInit);
-        if (func_80A7975C(this, play)) {
+        if (EnIn_StartingRace(this, play)) {
             gSaveContext.eventInf[0] &= ~0x8000;
             return;
         }
-- 
