                     ptc->flags |= 0x20;
-                    ; // needed to match
                 } else {
                     ptc->flags &= ~0x10;
                     ptc->flags &= ~0x20;
diff --git a/src/goddard/renderer.c b/src/goddard/renderer.c
index 2616a20f..49279b39 100644
--- a/src/goddard/renderer.c
+++ b/src/goddard/renderer.c
@@ -813,7 +813,6 @@ void gd_printf(const char *format, ...) {
                         csr++;
