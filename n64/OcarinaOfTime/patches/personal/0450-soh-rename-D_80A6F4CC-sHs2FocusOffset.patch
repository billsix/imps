From 535c535cf9aca48f5ca6ee5a975141b5d399878d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:38 +0000
Subject: [PATCH 450/488] soh: rename D_80A6F4CC -> sHs2FocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same point in EnHs2_PostLimbDraw
Defined in soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c b/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c
index b875fc7c8..2f19ae986 100644
--- a/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c
+++ b/soh/src/overlays/actors/ovl_En_Hs2/z_en_hs2.c
@@ -153,11 +153,11 @@ s32 EnHs2_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* p
 }
 
 void EnHs2_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
-    static Vec3f D_80A6F4CC = { 300.0f, 1000.0f, 0.0f };
+    static Vec3f sHs2FocusOffset = { 300.0f, 1000.0f, 0.0f };  // was D_80A6F4CC [LLM:HIGH]
     EnHs2* this = (EnHs2*)thisx;
 
     if (limbIndex == 9) {
-        Matrix_MultVec3f(&D_80A6F4CC, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sHs2FocusOffset, &this->actor.focus.pos);  // was D_80A6F4CC [LLM:HIGH]
     }
 }
 
