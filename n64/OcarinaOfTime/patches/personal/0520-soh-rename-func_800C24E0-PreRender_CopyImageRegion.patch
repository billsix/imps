From 4c401bfb70d7fa4a7451b51d168aec2b978a5840 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:12:04 +0000
Subject: [PATCH 0520/3799] soh: rename func_800C24E0 ->
 PreRender_CopyImageRegion

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.98.
Defined in soh/src/code/PreRender.c.
---
 soh/include/functions.h  | 2 +-
 soh/src/code/PreRender.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 6cd6bec8a..692ca6a8c 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1590,7 +1590,7 @@ void PreRender_DrawCoverage(PreRender* this, Gfx** gfxp);  // was func_800C20B4
 void PreRender_RestoreZBuffer(PreRender* this, Gfx** gfxp);  // was func_800C2118 [oot]
 void func_800C213C(PreRender* this, Gfx** gfxp);
 void PreRender_RestoreFramebuffer(PreRender* this, Gfx** gfxp);  // was func_800C24BC [oot]
-void func_800C24E0(PreRender* this, Gfx** gfxp);
+void PreRender_CopyImageRegion(PreRender* this, Gfx** gfxp);  // was func_800C24E0 [oot]
 void PreRender_AntiAliasFilter(PreRender* this, s32 x, s32 y);  // was func_800C2500 [oot]
 void func_800C2FE4(PreRender* this);
 void PreRender_Calc(PreRender* this);
diff --git a/soh/src/code/PreRender.c b/soh/src/code/PreRender.c
index e95105041..6ff229509 100644
--- a/soh/src/code/PreRender.c
+++ b/soh/src/code/PreRender.c
@@ -357,7 +357,8 @@ void PreRender_RestoreFramebuffer(PreRender* this, Gfx** gfxp) {
     PreRender_CopyImage(this, gfxp, this->fbufSave, this->fbuf);
 }
 
-void func_800C24E0(PreRender* this, Gfx** gfxp) {
+// Name from zeldaret/oot (was func_800C24E0): adopted upstream's name for this address; body verified to match upstream at 0.98. [oot: https://github.com/zeldaret/oot/blob/main/src/code/PreRender.c]
+void PreRender_CopyImageRegion(PreRender* this, Gfx** gfxp) {
     PreRender_CopyImageRegionImpl(this, gfxp);
 }
 
