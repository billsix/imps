From 95441915ddea8213bd41f0467aedca4d9a82f29d Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:44 +0000
Subject: [PATCH 1678/3799] soh: rename D_80ABB3B4 -> sCuccoInfTableBits

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the infTable[25] bit each numbered Cucco owns, set while it is inside the pen and cleared while it is out.
Defined in soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c b/soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c
index c133c09bd..e1c2708ef 100644
--- a/soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c
+++ b/soh/src/overlays/actors/ovl_En_Niw_Lady/z_en_niw_lady.c
@@ -43,7 +43,8 @@ static s16 sMissingCuccoTextIds[] = {
     0x5036, 0x5070, 0x5072, 0x5037, 0x5038, 0x5039, 0x503A, 0x503B, 0x503D, 0x503C,
 };
 
-static s16 D_80ABB3B4[] = {
+// LLM generated name (HIGH), was D_80ABB3B4: the infTable[25] bit each numbered Cucco owns, set while it is inside the pen and cleared while it is out.
+static s16 sCuccoInfTableBits[] = {  // was D_80ABB3B4 [LLM:HIGH]
     0x0200, 0x0400, 0x0800, 0x1000, 0x2000, 0x4000, 0x8000,
 };
 
@@ -211,16 +212,16 @@ void func_80ABA244(EnNiwLady* this, PlayState* play) {
             if ((fabsf(currentCucco->actor.world.pos.x - 330.0f) < 90.0f) &&
                 (fabsf(currentCucco->actor.world.pos.z - 1610.0f) < 190.0f)) {
                 if (this->unk_26C == 0) {
-                    gSaveContext.infTable[25] |= D_80ABB3B4[currentCucco->unk_2AA];
+                    gSaveContext.infTable[25] |= sCuccoInfTableBits[currentCucco->unk_2AA];  // was D_80ABB3B4 [LLM:HIGH]
                     if (BREG(1) != 0) {
                         // "GET inside the chicken fence!"
                         osSyncPrintf(VT_FGCOL(GREEN) "☆ 鶏柵内ＧＥＴ！☆ %x\n" VT_RST,
-                                     D_80ABB3B4[currentCucco->unk_2AA]);
+                                     sCuccoInfTableBits[currentCucco->unk_2AA]);  // was D_80ABB3B4 [LLM:HIGH]
                     }
                 }
                 this->cuccosInPen++;
             } else if (this->unk_26C == 0) {
-                gSaveContext.infTable[25] &= ~D_80ABB3B4[currentCucco->unk_2AA];
+                gSaveContext.infTable[25] &= ~sCuccoInfTableBits[currentCucco->unk_2AA];  // was D_80ABB3B4 [LLM:HIGH]
             }
         }
         currentCucco = (EnNiw*)currentCucco->actor.next;
