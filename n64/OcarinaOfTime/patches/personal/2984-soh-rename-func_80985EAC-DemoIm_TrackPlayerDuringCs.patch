Subject: [PATCH 2984/3799] soh: rename func_80985EAC ->
 DemoIm_TrackPlayerDuringCs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: head-tracks the player between cutscene frames 80 and 243 and centres the head otherwise
Defined in soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
index 13500eb70..355c49cee 100644
--- a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -586,7 +586,8 @@ void DemoIm_SetupCourtyardIdle(DemoIm* this, PlayState* play) {
     this->unk_280 = 1;
 }
 
-void func_80985EAC(DemoIm* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80985EAC: head-tracks the player between cutscene frames 80 and 243 and centres the head otherwise
+void DemoIm_TrackPlayerDuringCs(DemoIm* this, PlayState* play) {
     if ((play->csCtx.frames >= 80) && (play->csCtx.frames < 243)) {
         DemoIm_TrackPlayerHead(this, play);  // was func_80984F10 [LLM:HIGH]
     } else {
@@ -721,7 +722,7 @@ void func_809863BC(DemoIm* this, PlayState* play) {
 void func_809863DC(DemoIm* this, PlayState* play) {
     DemoIm_UpdateBgCheckInfo(this, play);
     DemoIm_UpdateSkelAnime(this);
-    func_80985EAC(this, play);
+    DemoIm_TrackPlayerDuringCs(this, play);  // was func_80985EAC [LLM:HIGH]
     DemoIm_UpdateEyes(this);  // was func_80984BE0 [LLM:HIGH]
     func_809862E0(this, play);
 }
@@ -731,7 +732,7 @@ void func_80986430(DemoIm* this, PlayState* play) {
 
     DemoIm_UpdateBgCheckInfo(this, play);
     sp24 = DemoIm_UpdateSkelAnime(this);
-    func_80985EAC(this, play);
+    DemoIm_TrackPlayerDuringCs(this, play);  // was func_80985EAC [LLM:HIGH]
     DemoIm_UpdateEyes(this);  // was func_80984BE0 [LLM:HIGH]
     func_80985FE8(this, sp24);
     func_809862E0(this, play);
