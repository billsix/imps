From 3bc46d62d9d961860a40bb29a32c08067a263365 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:30:41 +0000
Subject: [PATCH 1610/3799] soh: rename func_80AACBAC -> EnMk_TurnBack

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: spins the researcher back to face the player and opens the finished-eye-drops line.
Defined in soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
index eb7dab8c1..d6c2cefd0 100644
--- a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
+++ b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
@@ -121,7 +121,8 @@ void func_80AACB6C(EnMk* this, PlayState* play) {
     this->flags |= 1;
 }
 
-void func_80AACBAC(EnMk* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AACBAC: spins the researcher back to face the player and opens the finished-eye-drops line.
+void EnMk_TurnBack(EnMk* this, PlayState* play) {
     if (this->timer > 0) {
         this->timer--;
         this->actor.shape.rot.y -= 0x800;
@@ -137,7 +138,7 @@ void EnMk_Mixing(EnMk* this, PlayState* play) {
         this->timer--;
     } else {
         this->timer = GameInteractor_Should(VB_PLAY_EYEDROP_CREATION_ANIM, true, this) ? 16 : 0;
-        this->actionFunc = func_80AACBAC;
+        this->actionFunc = EnMk_TurnBack;  // was func_80AACBAC [LLM:HIGH]
         Animation_Change(&this->skelAnime, &object_mk_Anim_000D88, 1.0f, 0.0f,
                          Animation_GetLastFrame(&object_mk_Anim_000D88), ANIMMODE_LOOP, -4.0f);
         this->flags &= ~2;
-- 
2.55.0

