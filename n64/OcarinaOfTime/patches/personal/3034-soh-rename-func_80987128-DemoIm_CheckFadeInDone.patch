 }
 
-void func_80987128(DemoIm* this) {
+// LLM generated name (HIGH), was func_80987128: switches to the solid draw once the fade completes
+void DemoIm_CheckFadeInDone(DemoIm* this) {
     if (this->unk_268 >= kREG(17) + 10.0f) {
         this->action = 29;
         this->drawConfig = 1;
@@ -1174,7 +1175,7 @@ void func_809872A8(DemoIm* this, PlayState* play) {
