-void func_80AB6D08(EnNiw* this, PlayState* play) {
+void EnNiw_FlutterAfterRelease(EnNiw* this, PlayState* play) {
     if (this->path == 0) {
         if (!(this->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) {
             return;
@@ -1114,7 +1115,7 @@ void EnNiw_Update(Actor* thisx, PlayState* play) {
         if (thisx->params != 0xA && thisx->params != 0xD && thisx->params != 0xE && thisx->params != 4) {
             CollisionCheck_SetAC(play, &play->colChkCtx, &this->collider.base);
         }
-        if (this->actionFunc != EnNiw_Held && this->actionFunc != func_80AB6D08 &&  // was func_80AB6BF8 [LLM:HIGH]
+        if (this->actionFunc != EnNiw_Held && this->actionFunc != EnNiw_FlutterAfterRelease &&  // was func_80AB6BF8 [LLM:HIGH]
             this->actionFunc != EnNiw_WaitToFlyOff && this->actionFunc != EnNiw_Airborne &&  // was func_80AB6324 [LLM:GUESS]
             this->actionFunc != EnNiw_WaitToBeLifted) {  // was func_80AB6450 [LLM:HIGH]
             CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
