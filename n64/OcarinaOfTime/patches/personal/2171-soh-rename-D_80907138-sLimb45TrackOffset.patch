+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -2632,7 +2632,7 @@ void BossGanon2_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
     } else if (limbIndex == 41) {
         Matrix_MultVec3f(&sOrigin, &this->unk_1D0);  // was D_80906D60 [LLM:HIGH]
     } else if (limbIndex == 45) {
-        Matrix_MultVec3f(&D_80907138, &this->unk_1C4);
+        Matrix_MultVec3f(&sLimb45TrackOffset, &this->unk_1C4);  // was D_80907138 [LLM:HIGH]
     }
 
     temp_v0 = sLimbTrailIndices[limbIndex];  // was D_8090709C [LLM:GUESS]
diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
