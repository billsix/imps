-                            D_8082A124[phi_s3] = 0xFF;
+                            sSongNoteGlyphs[phi_s3] = 0xFF;  // was D_8082A124 [LLM:HIGH]
                             D_8082A150[phi_s3] = 0;
                         }
 
@@ -281,7 +281,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
 
             if (--sSongNoteTimer == 0) {  // was D_8082A120 [LLM:HIGH]
                 for (phi_s3 = 0; phi_s3 < 8; phi_s3++) {
-                    D_8082A124[phi_s3] = 0xFF;
+                    sSongNoteGlyphs[phi_s3] = 0xFF;  // was D_8082A124 [LLM:HIGH]
                     D_8082A150[phi_s3] = 0;
                 }
 
