From d8280fc01cc08e5d7267bcfd510cdcf2b4350b38 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:01 +0000
Subject: [PATCH 3222/3799] soh: rename D_8082A1AC -> sQuestCursorMoves

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-slot up, down, left and right neighbours the quest cursor moves to
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../misc/ovl_kaleido_scope/z_kaleido_collect.c | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
index 61debb244..e81a1b894 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
@@ -54,7 +54,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
     static s16 sQuestSlotB[] = {  // was D_8082A194 [LLM:HIGH]
         100, 40, 255, 0, 255, 100, 255, 255, 255, 255, 255, 255,
     };
-    static s8 D_8082A1AC[][4] = {
+    static s8 sQuestCursorMoves[][4] = {  // was D_8082A1AC [LLM:HIGH]
         { 0x05, 0x01, 0x05, 0xFE }, { 0x00, 0x02, 0x02, 0xFE }, { 0xFF, 0x13, 0x03, 0x01 }, { 0x04, 0x02, 0x11, 0x02 },
         { 0x05, 0x03, 0x18, 0x05 }, { 0xFF, 0xFF, 0x04, 0x00 }, { 0x0C, 0xFF, 0xFD, 0x07 }, { 0x0D, 0xFF, 0x06, 0x08 },
         { 0x0E, 0xFF, 0x07, 0x09 }, { 0x0F, 0xFF, 0x08, 0x0A }, { 0x10, 0xFF, 0x09, 0x0B }, { 0x11, 0xFF, 0x0A, 0x12 },
@@ -106,7 +106,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
                 phi_s3 = pauseCtx->cursorPoint[PAUSE_QUEST];
 
                 if ((pauseCtx->stickRelX < -30)) {
-                    phi_s0 = D_8082A1AC[phi_s3][2];
+                    phi_s0 = sQuestCursorMoves[phi_s3][2];  // was D_8082A1AC [LLM:HIGH]
                     if (phi_s0 == -3) {
                         KaleidoScope_MoveCursorToSpecialPos(play, PAUSE_CURSOR_PAGE_LEFT);
                         pauseCtx->unk_1E4 = 0;
@@ -115,11 +115,11 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
                             if ((s16)KaleidoScope_UpdateQuestStatusPoint(pauseCtx, phi_s0) != 0) {
                                 break;
                             }
-                            phi_s0 = D_8082A1AC[phi_s0][2];
+                            phi_s0 = sQuestCursorMoves[phi_s0][2];  // was D_8082A1AC [LLM:HIGH]
                         }
                     }
                 } else if ((pauseCtx->stickRelX > 30)) {
-                    phi_s0 = D_8082A1AC[phi_s3][3];
+                    phi_s0 = sQuestCursorMoves[phi_s3][3];  // was D_8082A1AC [LLM:HIGH]
                     if (phi_s0 == -2) {
                         KaleidoScope_MoveCursorToSpecialPos(play, PAUSE_CURSOR_PAGE_RIGHT);
                         pauseCtx->unk_1E4 = 0;
@@ -128,26 +128,26 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
                             if ((s16)KaleidoScope_UpdateQuestStatusPoint(pauseCtx, phi_s0) != 0) {
                                 break;
                             }
-                            phi_s0 = D_8082A1AC[phi_s0][3];
+                            phi_s0 = sQuestCursorMoves[phi_s0][3];  // was D_8082A1AC [LLM:HIGH]
                         }
                     }
                 }
 
                 if ((pauseCtx->stickRelY < -30)) {
-                    phi_s0 = D_8082A1AC[phi_s3][1];
+                    phi_s0 = sQuestCursorMoves[phi_s3][1];  // was D_8082A1AC [LLM:HIGH]
                     while (phi_s0 >= 0) {
                         if ((s16)KaleidoScope_UpdateQuestStatusPoint(pauseCtx, phi_s0) != 0) {
                             break;
                         }
-                        phi_s0 = D_8082A1AC[phi_s0][1];
+                        phi_s0 = sQuestCursorMoves[phi_s0][1];  // was D_8082A1AC [LLM:HIGH]
                     }
                 } else if ((pauseCtx->stickRelY > 30)) {
-                    phi_s0 = D_8082A1AC[phi_s3][0];
+                    phi_s0 = sQuestCursorMoves[phi_s3][0];  // was D_8082A1AC [LLM:HIGH]
                     while (phi_s0 >= 0) {
                         if ((s16)KaleidoScope_UpdateQuestStatusPoint(pauseCtx, phi_s0) != 0) {
                             break;
                         }
-                        phi_s0 = D_8082A1AC[phi_s0][0];
+                        phi_s0 = sQuestCursorMoves[phi_s0][0];  // was D_8082A1AC [LLM:HIGH]
                     }
                 }
 
