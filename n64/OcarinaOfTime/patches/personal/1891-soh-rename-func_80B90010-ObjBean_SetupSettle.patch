From 36646b55c8aec2e9364398c5ea5279f7a9dd8238 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:50:08 +0000
Subject: [PATCH 1891/3799] soh: rename func_80B90010 -> ObjBean_SetupSettle

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the settling action with its starting angle and decaying amplitude.
Defined in soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
index 8726e95d5..4e7e3a11a 100644
--- a/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
+++ b/soh/src/overlays/actors/ovl_Obj_Bean/z_obj_bean.c
@@ -50,7 +50,8 @@ void ObjBean_SetupGrowWaterPhase4(ObjBean* this);
 // LLM generated name (HIGH), was func_80B8FF8C: stretches the plant past its final size on a sine and hands off to the settle once it passes the threshold.
 void ObjBean_Overshoot(ObjBean* this, PlayState* play);  // was func_80B8FF8C [LLM:HIGH]
 void func_80B90050(ObjBean* this, PlayState* play);
-void func_80B90010(ObjBean* this);
+// LLM generated name (HIGH), was func_80B90010: installs the settling action with its starting angle and decaying amplitude.
+void ObjBean_SetupSettle(ObjBean* this);  // was func_80B90010 [LLM:HIGH]
 void func_80B908EC(ObjBean* this);
 void func_80B90918(ObjBean* this, PlayState* play);
 void func_80B90970(ObjBean* this);
@@ -608,11 +609,11 @@ void ObjBean_Overshoot(ObjBean* this, PlayState* play) {
     this->dyna.actor.scale.y = Math_SinS(this->unk_1B6.x) * 0.17434467f;
     this->dyna.actor.scale.x = this->dyna.actor.scale.z = Math_CosS(this->unk_1B6.x) * 0.12207746f;
     if (this->unk_1B6.x < 0x18E4) {
-        func_80B90010(this);
+        ObjBean_SetupSettle(this);  // was func_80B90010 [LLM:HIGH]
     }
 }
 
-void func_80B90010(ObjBean* this) {
+void ObjBean_SetupSettle(ObjBean* this) {
     this->actionFunc = func_80B90050;
     ObjBean_SetDrawMode(this, BEAN_STATE_DRAW_LEAVES | BEAN_STATE_DRAW_SOIL);
     this->unk_1B6.x = 0;
