+++ b/soh/src/overlays/actors/ovl_Arrow_Ice/z_arrow_ice.c
@@ -87,7 +87,8 @@ void ArrowIce_Charge(ArrowIce* this, PlayState* play) {
     }
 }
 
-void func_80867E8C(Vec3f* unkPos, Vec3f* icePos, f32 scale) {
+// LLM generated name (HIGH), was func_80867E8C: lerps unkPos toward icePos by scale (trail-follow)
+void ArrowIce_ApproachTrailPos(Vec3f* unkPos, Vec3f* icePos, f32 scale) {
     unkPos->x += ((icePos->x - unkPos->x) * scale);
     unkPos->y += ((icePos->y - unkPos->y) * scale);
     unkPos->z += ((icePos->z - unkPos->z) * scale);
@@ -162,7 +163,7 @@ void ArrowIce_Fly(ArrowIce* this, PlayState* play) {
     if (distanceScaled < 1.0f) {
         this->unk_160 = 1.0f;
     }
-    func_80867E8C(&this->unkPos, &this->actor.world.pos, 0.05f);
+    ArrowIce_ApproachTrailPos(&this->unkPos, &this->actor.world.pos, 0.05f);
 
     if (arrow->hitFlags & 1) {
         Audio_PlayActorSound2(&this->actor, NA_SE_IT_EXPLOSION_ICE);
