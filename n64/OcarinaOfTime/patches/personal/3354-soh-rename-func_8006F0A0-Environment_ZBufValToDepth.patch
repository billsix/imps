From 11e8d4cfa7e4078b110fceee22b6c1363a2ecf34 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:15:29 +0000
Subject: [PATCH 3354/3799] soh: rename func_8006F0A0 ->
 Environment_ZBufValToDepth

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: expands a packed Z buffer value through sZBufValConversionTable into a linear depth
Defined in soh/src/code/z_kankyo.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_kankyo.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index aa1b29fe7..505d2714d 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -908,7 +908,7 @@ void Font_LoadCharWide(Font* font, u16 arg1, u16 arg2);
 void Font_LoadChar(Font* font, u8 character, u16 codePointIndex);
 void Font_LoadMessageBoxIcon(Font* font, u16 icon);
 void Font_LoadOrderedFont(Font* font);
-s32 func_8006F0A0(s32 arg0);
+s32 Environment_ZBufValToDepth(s32 arg0);  // was func_8006F0A0 [LLM:HIGH]
 u16 Environment_GetPixelDepth(s32 x, s32 y);
 void Environment_GraphCallback(GraphicsContext* gfxCtx, void* param);
 void Environment_Init(PlayState* play, EnvironmentContext* envCtx, s32 unused);
diff --git a/soh/src/code/z_kankyo.c b/soh/src/code/z_kankyo.c
index dc7b0cf5a..b88268755 100644
--- a/soh/src/code/z_kankyo.c
+++ b/soh/src/code/z_kankyo.c
@@ -234,7 +234,8 @@ void LoadSkyboxTex(SkyboxContext* skyboxCtx, int segmentIndex, int imageIndex, c
                    int offsetW, int offsetH);
 void Skybox_Update(SkyboxContext* skyboxCtx);
 
-s32 func_8006F0A0(s32 a0) {
+// LLM generated name (HIGH), was func_8006F0A0: expands a packed Z buffer value through sZBufValConversionTable into a linear depth
+s32 Environment_ZBufValToDepth(s32 a0) {
     s32 ret = ((a0 >> 4 & 0x7FF) << sZBufValConversionTable[a0 >> 15 & 7].unk_00) + sZBufValConversionTable[a0 >> 15 & 7].unk_04;
 
     return ret;
