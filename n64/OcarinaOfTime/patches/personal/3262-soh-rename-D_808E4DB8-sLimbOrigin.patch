From 315081adc45518cf09af615c9982a72d85954072 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:10:29 +0000
Subject: [PATCH 3262/3799] soh: rename D_808E4DB8 -> sLimbOrigin

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the zero vector pushed through the current matrix to read a limb's world position back out
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index e27dd7a93..4983d3ce5 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -3329,7 +3329,7 @@ void BossGanon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
     };
     static Vec3f sLeftHandBaseOffset = { -500.0f, 200.0f, -300.0f };  // was D_808E4DA0 [LLM:HIGH]
     static Vec3f sRightHandBaseOffset = { -500.0f, 200.0f, 300.0f };  // was D_808E4DAC [LLM:HIGH]
-    static Vec3f D_808E4DB8 = { 0.0f, 0.0f, 0.0f };
+    static Vec3f sLimbOrigin = { 0.0f, 0.0f, 0.0f };  // was D_808E4DB8 [LLM:HIGH]
     static Vec3f D_808E4DC4 = { 0.0f, 0.0f, 0.0f };
     static Vec3f D_808E4DD0 = { 0.0f, 0.0f, 0.0f };
     static Vec3f D_808E4DDC = { 1300.0f, 0.0f, 0.0f };
@@ -3339,17 +3339,17 @@ void BossGanon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
 
     bodyPart = bodyPartLimbMap[limbIndex];
     if (bodyPart >= 0) {
-        Matrix_MultVec3f(&D_808E4DB8, &this->unk_2EC[bodyPart]);
+        Matrix_MultVec3f(&sLimbOrigin, &this->unk_2EC[bodyPart]);  // was D_808E4DB8 [LLM:HIGH]
     }
 
     if (limbIndex == 2) {
-        Matrix_MultVec3f(&D_808E4DB8, &this->unk_1FC);
+        Matrix_MultVec3f(&sLimbOrigin, &this->unk_1FC);  // was D_808E4DB8 [LLM:HIGH]
     } else if (limbIndex == 19) {
-        Matrix_MultVec3f(&D_808E4DB8, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sLimbOrigin, &this->actor.focus.pos);  // was D_808E4DB8 [LLM:HIGH]
     } else if (limbIndex == 11) {
         OPEN_DISPS(play->state.gfxCtx);
 
-        Matrix_MultVec3f(&D_808E4DB8, &this->unk_208);
+        Matrix_MultVec3f(&sLimbOrigin, &this->unk_208);  // was D_808E4DB8 [LLM:HIGH]
         gSPMatrix(POLY_XLU_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
         gSPDisplayList(POLY_XLU_DISP++, SEGMENTED_TO_VIRTUAL(gGanondorfEyesDL));
 
