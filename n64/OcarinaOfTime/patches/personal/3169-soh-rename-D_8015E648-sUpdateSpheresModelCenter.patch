From 395d65397450d495b37d5313e63eb0985682b2de Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:05:50 +0000
Subject: [PATCH 3169/3799] soh: rename D_8015E648 -> sUpdateSpheresModelCenter

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the model-space sphere centre Collider_UpdateSpheres transforms
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index 6b7bdc22c..1dbb0f50d 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -3278,16 +3278,16 @@ static s8 sBssDummy14;
  * Updates the world spheres for all of the collider's JntSph elements attached to the specified limb
  */
 void Collider_UpdateSpheres(s32 limb, ColliderJntSph* collider) {
-    static Vec3f D_8015E648;
+    static Vec3f sUpdateSpheresModelCenter;  // was D_8015E648 [LLM:HIGH]
     static Vec3f D_8015CF00; // bss ordering changes here
     s32 i;
 
     for (i = 0; i < collider->count; i++) {
         if (limb == collider->elements[i].dim.limb) {
-            D_8015E648.x = collider->elements[i].dim.modelSphere.center.x;
-            D_8015E648.y = collider->elements[i].dim.modelSphere.center.y;
-            D_8015E648.z = collider->elements[i].dim.modelSphere.center.z;
-            Matrix_MultVec3f(&D_8015E648, &D_8015CF00);
+            sUpdateSpheresModelCenter.x = collider->elements[i].dim.modelSphere.center.x;  // was D_8015E648 [LLM:HIGH]
+            sUpdateSpheresModelCenter.y = collider->elements[i].dim.modelSphere.center.y;  // was D_8015E648 [LLM:HIGH]
+            sUpdateSpheresModelCenter.z = collider->elements[i].dim.modelSphere.center.z;  // was D_8015E648 [LLM:HIGH]
+            Matrix_MultVec3f(&sUpdateSpheresModelCenter, &D_8015CF00);  // was D_8015E648 [LLM:HIGH]
             collider->elements[i].dim.worldSphere.center.x = D_8015CF00.x;
             collider->elements[i].dim.worldSphere.center.y = D_8015CF00.y;
             collider->elements[i].dim.worldSphere.center.z = D_8015CF00.z;
-- 
