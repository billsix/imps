     return NULL;
 }
 
-void func_80AEB0EC(EnRu1* this, s32 cameraSetting) {
+// Name from zeldaret/oot (was func_80AEB0EC): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_SetPlatformCamSetting(EnRu1* this, s32 cameraSetting) {
