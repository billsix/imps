From 1f0e5ab168a21f30f028bffe693db444a6d4cd65 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:24:59 +0000
Subject: [PATCH 1527/3799] soh: rename func_80ABCDAC -> EnNy_SetupGrow

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the action that scales the Shellblade back up to full size.
Defined in soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
index 2b84cfb49..d292d73d7 100644
--- a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
+++ b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
@@ -174,7 +174,8 @@ void EnNy_SetupOpenShell(EnNy* this) {
     this->actionFunc = EnNy_OpenShell;  // was func_80ABCE90 [LLM:HIGH]
 }
 
-void func_80ABCDAC(EnNy* this) {
+// LLM generated name (HIGH), was func_80ABCDAC: installs the action that scales the Shellblade back up to full size.
+void EnNy_SetupGrow(EnNy* this) {
     this->actionFunc = func_80ABCEEC;
 }
 
@@ -211,7 +212,7 @@ void EnNy_OpenShell(EnNy* this, PlayState* play) {
     if (phi_v0 >= 0xFF) {
         phi_v1 = 0;
         phi_v0 = 0xFF;
-        func_80ABCDAC(this);
+        EnNy_SetupGrow(this);  // was func_80ABCDAC [LLM:HIGH]
     }
     this->unk_1D4 = phi_v1;
     this->unk_1D8 = phi_v0;
-- 
