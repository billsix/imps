From ff06785c0d8ab332d09be969f9304d6dbee5aa08 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:09 +0000
Subject: [PATCH 0930/3799] soh: rename D_80B4A2F8 -> sTextureSettingDList

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: two-instruction display list holding a gsSPTexture scale, patched with IREG(0)/IREG(1) and bound to segment 0x08 in EnZf_Draw.
Defined in soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c b/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
index 2f6e0af4b..df4c97825 100644
--- a/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
+++ b/soh/src/overlays/actors/ovl_En_Zf/z_en_zf.c
@@ -2251,7 +2251,8 @@ void EnZf_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
     }
 }
 
-static Gfx D_80B4A2F8[] = {
+// LLM generated name (HIGH), was D_80B4A2F8: two-instruction display list holding a gsSPTexture scale, patched with IREG(0)/IREG(1) and bound to segment 0x08 in EnZf_Draw.
+static Gfx sTextureSettingDList[] = {  // was D_80B4A2F8 [LLM:HIGH]
     gsSPTexture(0x0A00, 0x0A00, 0, G_TX_RENDERTILE, G_ON),
     gsSPEndDisplayList(),
 };
@@ -2264,9 +2265,9 @@ void EnZf_Draw(Actor* thisx, PlayState* play) {
 
     func_8002EBCC(thisx, play, 1);
 
-    gSPTexture(D_80B4A2F8, IREG(0), IREG(1), 0, G_TX_RENDERTILE, G_ON);
+    gSPTexture(sTextureSettingDList, IREG(0), IREG(1), 0, G_TX_RENDERTILE, G_ON);  // was D_80B4A2F8 [LLM:HIGH]
 
-    gSPSegment(POLY_OPA_DISP++, 0x08, D_80B4A2F8);
+    gSPSegment(POLY_OPA_DISP++, 0x08, sTextureSettingDList);  // was D_80B4A2F8 [LLM:HIGH]
 
     if (this->alpha == 255) {
         Gfx_SetupDL_25Opa(play->state.gfxCtx);
-- 
