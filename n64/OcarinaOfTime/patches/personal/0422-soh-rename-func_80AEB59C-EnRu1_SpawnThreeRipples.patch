Subject: [PATCH 0422/3799] soh: rename func_80AEB59C ->
 EnRu1_SpawnThreeRipples

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 2456317e6..95e4131ab 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -453,7 +453,8 @@ void EnRu1_SpawnRippleTreading(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEB59C(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEB59C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_SpawnThreeRipples(EnRu1* this, PlayState* play) {
     EnRu1_SpawnRipple(this, play, kREG(2) + 500, 0);
     EnRu1_SpawnRipple(this, play, kREG(2) + 500, kREG(3) + 10.0f);
     EnRu1_SpawnRipple(this, play, kREG(2) + 500, (kREG(3) + 10.0f) * 2.0f);
@@ -630,7 +631,7 @@ void func_80AEBD1C(EnRu1* this, PlayState* play) {
         func_80AEB914(this, play);
         EnRu1_UpdateBgCheckInfo(this, play);
         EnRu1_SpawnSplash(this, play);
-        func_80AEB59C(this, play);
+        EnRu1_SpawnThreeRipples(this, play);
     }
 }
 
