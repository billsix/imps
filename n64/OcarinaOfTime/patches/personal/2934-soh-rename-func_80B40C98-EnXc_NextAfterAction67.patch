 }
 
-void func_80B40C98(EnXc* this) {
+// LLM generated name (HIGH), was func_80B40C98: the same guard from action 67 to 68
+void EnXc_NextAfterAction67(EnXc* this) {
     EnXc_CheckAndSetAction(this, SHEIK_ACTION_67, SHEIK_ACTION_68);
 }
 
@@ -2182,7 +2183,7 @@ void EnXc_ActionFunc66(EnXc* this, PlayState* play) {
 
