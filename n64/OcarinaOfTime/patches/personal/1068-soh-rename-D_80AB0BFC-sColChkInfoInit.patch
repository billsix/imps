From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:46:31 +0000
Subject: [PATCH 1068/3799] soh: rename D_80AB0BFC -> sColChkInfoInit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: CollisionCheckInfoInit2 passed to CollisionCheck_SetInfo2 in EnMu_Init.
Defined in soh/src/overlays/actors/ovl_En_Mu/z_en_mu.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mu/z_en_mu.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mu/z_en_mu.c b/soh/src/overlays/actors/ovl_En_Mu/z_en_mu.c
index acf76038f..0ebae5b11 100644
--- a/soh/src/overlays/actors/ovl_En_Mu/z_en_mu.c
+++ b/soh/src/overlays/actors/ovl_En_Mu/z_en_mu.c
@@ -38,7 +38,8 @@ static ColliderCylinderInit sCylinderInit = {  // was D_80AB0BD0 [LLM:HIGH]
     { 100, 70, 0, { 0, 0, 0 } },
 };
 
-static CollisionCheckInfoInit2 D_80AB0BFC = { 0, 0, 0, 0, MASS_IMMOVABLE };
+// LLM generated name (HIGH), was D_80AB0BFC: CollisionCheckInfoInit2 passed to CollisionCheck_SetInfo2 in EnMu_Init.
+static CollisionCheckInfoInit2 sColChkInfoInit = { 0, 0, 0, 0, MASS_IMMOVABLE };  // was D_80AB0BFC [LLM:HIGH]
 
 const ActorInit En_Mu_InitVars = {
     ACTOR_EN_MU,
@@ -136,7 +137,7 @@ void EnMu_Init(Actor* thisx, PlayState* play) {
     SkelAnime_InitFlex(play, &this->skelAnime, &object_mu_Skel_004F70, &object_mu_Anim_0003F4, NULL, NULL, 0);
     Collider_InitCylinder(play, &this->collider);
     Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);  // was D_80AB0BD0 [LLM:HIGH]
-    CollisionCheck_SetInfo2(&this->actor.colChkInfo, NULL, &D_80AB0BFC);
+    CollisionCheck_SetInfo2(&this->actor.colChkInfo, NULL, &sColChkInfoInit);  // was D_80AB0BFC [LLM:HIGH]
     this->actor.targetMode = 6;
     Actor_SetScale(&this->actor, 0.01f);
     EnMu_Interact(this, play);
