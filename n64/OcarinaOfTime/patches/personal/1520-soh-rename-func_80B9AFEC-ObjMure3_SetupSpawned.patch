Subject: [PATCH 1520/3799] soh: rename func_80B9AFEC -> ObjMure3_SetupSpawned

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: installs the action that runs while the rupees exist.
Defined in soh/src/overlays/actors/ovl_Obj_Mure3/z_obj_mure3.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Obj_Mure3/z_obj_mure3.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Obj_Mure3/z_obj_mure3.c b/soh/src/overlays/actors/ovl_Obj_Mure3/z_obj_mure3.c
index 7384aee9c..b94f91fbf 100644
--- a/soh/src/overlays/actors/ovl_Obj_Mure3/z_obj_mure3.c
+++ b/soh/src/overlays/actors/ovl_Obj_Mure3/z_obj_mure3.c
@@ -20,7 +20,8 @@ void ObjMure3_Idle(ObjMure3* this, PlayState* play);  // was func_80B9AF34 [LLM:
 void ObjMure3_SetupWaitForPlayer(ObjMure3* this);  // was func_80B9AF54 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80B9AF64: once the player's screen-space distance drops below 1150 it disables update culling and runs this variant's spawn function.
 void ObjMure3_WaitForPlayer(ObjMure3* this, PlayState* play);  // was func_80B9AF64 [LLM:HIGH]
-void func_80B9AFEC(ObjMure3* this);
+// LLM generated name (HIGH), was func_80B9AFEC: installs the action that runs while the rupees exist.
+void ObjMure3_SetupSpawned(ObjMure3* this);  // was func_80B9AFEC [LLM:HIGH]
 void func_80B9AFFC(ObjMure3* this, PlayState* play);
 
 const ActorInit Obj_Mure3_InitVars = {
@@ -183,11 +184,11 @@ void ObjMure3_WaitForPlayer(ObjMure3* this, PlayState* play) {
     if (Math3D_Dist1DSq(this->actor.projectedPos.x, this->actor.projectedPos.z) < SQ(1150.0f)) {
         this->actor.flags |= ACTOR_FLAG_UPDATE_CULLING_DISABLED;
         spawnFuncs[(this->actor.params >> 13) & 7](this, play);
-        func_80B9AFEC(this);
+        ObjMure3_SetupSpawned(this);  // was func_80B9AFEC [LLM:HIGH]
     }
 }
 
-void func_80B9AFEC(ObjMure3* this) {
+void ObjMure3_SetupSpawned(ObjMure3* this) {
     this->actionFunc = func_80B9AFFC;
 }
 
