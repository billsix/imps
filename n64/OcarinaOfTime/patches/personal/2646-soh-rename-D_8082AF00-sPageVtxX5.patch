From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:40 +0000
Subject: [PATCH 2646/3799] soh: rename D_8082AF00 -> sPageVtxX5

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the X offsets in slot 5 of the sPageVtxX table
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index bd84c47d7..a38d5cda7 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2623,7 +2623,8 @@ static s16 sPageVtxX4[] = {  // was D_8082AEC0 [LLM:HIGH]
     0x0047, 0xFFB4, 0xFFA9, 0xFF94, 0xFFCA, 0xFFA3, 0xFFBD, 0xFFC8, 0xFFDF, 0xFFF6, 0x0001,
     0x000E, 0x0018, 0x0023, 0x003A, 0x004A, 0x0059, 0x0000, 0xFFC6, 0x0013, 0x001C,
 };
-static s16 D_8082AF00[] = {
+// LLM generated name (HIGH), was D_8082AF00: the X offsets in slot 5 of the sPageVtxX table
+static s16 sPageVtxX5[] = {  // was D_8082AF00 [LLM:HIGH]
     0xFFB4, 0xFFC6, 0x000A, 0xFFC6, 0x000A, 0x0000,
 };
 static s16 D_8082AF0C[] = {
@@ -2690,7 +2691,7 @@ static s16 D_8082AFF4[] = {
 };
 
 static s16* D_8082B000[] = {
-    sPageVtxX0, sPageVtxX1, sPageVtxX2, sPageVtxX3, sPageVtxX4, D_8082AF00,  // was D_8082AE90 [LLM:HIGH]
+    sPageVtxX0, sPageVtxX1, sPageVtxX2, sPageVtxX3, sPageVtxX4, sPageVtxX5,  // was D_8082AE90 [LLM:HIGH]
 };
 
 static s16* D_8082B018[] = {
