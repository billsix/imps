Date: Mon, 7 Sep 2026 23:59:17 +0000
Subject: [PATCH 2955/3799] soh: rename func_80985134 -> DemoIm_IsNotCueAction

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: true when that cue channel is on any other action
Defined in soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
index f986fff4d..e638ce3fd 100644
--- a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -253,7 +253,8 @@ s32 DemoIm_IsCueAction(DemoIm* this, PlayState* play, u16 action, s32 actionIdx)
     return false;
 }
 
-s32 func_80985134(DemoIm* this, PlayState* play, u16 action, s32 actionIdx) {
+// LLM generated name (HIGH), was func_80985134: true when that cue channel is on any other action
+s32 DemoIm_IsNotCueAction(DemoIm* this, PlayState* play, u16 action, s32 actionIdx) {
     CsCmdActorCue* npcAction = DemoIm_GetNpcAction(play, actionIdx);
 
     if (npcAction != NULL) {
@@ -494,7 +495,7 @@ void func_809859E0(DemoIm* this, PlayState* play) {
 }
 
 void func_80985B34(DemoIm* this, PlayState* play) {
-    if (func_80985134(this, play, 4, 5)) {
+    if (DemoIm_IsNotCueAction(this, play, 4, 5)) {  // was func_80985134 [LLM:HIGH]
         Animation_Change(&this->skelAnime, &gImpaSealGanonAnim, 1.0f, 0.0f, Animation_GetLastFrame(&gImpaSealGanonAnim),
                          ANIMMODE_ONCE, -8.0f);
         this->action = 8;
