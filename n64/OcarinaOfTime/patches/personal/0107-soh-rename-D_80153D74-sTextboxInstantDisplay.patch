From 2296611aa3301d2acebda62a86097f9819aecb4f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:22 +0000
Subject: [PATCH 107/784] soh: rename D_80153D74 -> sTextboxInstantDisplay

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/z_message_PAL.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/z_message_PAL.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_message_PAL.c b/soh/src/code/z_message_PAL.c
index 91e690772..5b9aab1ab 100644
--- a/soh/src/code/z_message_PAL.c
+++ b/soh/src/code/z_message_PAL.c
@@ -4399,7 +4399,8 @@ void Message_Update(PlayState* play) {
         0x0400, 0x0400, 0x0200, 0x0000, 0x1038, 0x0008, 0x200A, 0x088B, 0x0007, 0x0009, 0x000A, 0x107E, 0x2008, 0x2007,
         0x0015, 0x0016, 0x0017, 0x0003, 0x0000, 0x270B, 0x00C8, 0x012C, 0x012D, 0xFFDA, 0x0014, 0x0016, 0x0014, 0x0016,
     };
-    static u8 D_80153D74 = 0;
+    // LLM generated name (HIGH), was D_80153D74: when set, snaps textDrawPos to decodedTextLen for instant full display.
+    static u8 sTextboxInstantDisplay = 0;
     static u16 D_80153D78 = 0;
     MessageContext* msgCtx = &play->msgCtx;
     InterfaceContext* interfaceCtx = &play->interfaceCtx;
@@ -4555,9 +4556,9 @@ void Message_Update(PlayState* play) {
             if (sTextFade) {
                 Interface_ChangeHudVisibilityMode(1);
             }
-            if (D_80153D74 != 0) {
+            if (sTextboxInstantDisplay != 0) {
                 msgCtx->textDrawPos = msgCtx->decodedTextLen;
-                D_80153D74 = 0;
+                sTextboxInstantDisplay = 0;
             }
             break;
         case MSGMODE_TEXT_CONTINUING:
-- 
