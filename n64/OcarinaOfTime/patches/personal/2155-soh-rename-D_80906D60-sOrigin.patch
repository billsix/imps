     if (temp_v0 >= 0) {
-        Matrix_MultVec3f(&D_80906D60, &sp4C);
+        Matrix_MultVec3f(&sOrigin, &sp4C);  // was D_80906D60 [LLM:HIGH]
         func_808FD080(temp_v0, &this->unk_424, &sp4C);
     }
 
@@ -2776,7 +2776,7 @@ void BossGanon2_PostLimbDraw2(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s
     BossGanon2* this = (BossGanon2*)thisx;
 
     if (temp_v1 >= 0) {
-        Matrix_MultVec3f(&D_80906D60, &this->unk_234[temp_v1]);
+        Matrix_MultVec3f(&sOrigin, &this->unk_234[temp_v1]);  // was D_80906D60 [LLM:HIGH]
     }
