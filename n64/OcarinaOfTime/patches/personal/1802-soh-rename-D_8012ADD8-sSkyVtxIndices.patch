From e86eb87c8da715531e418b1d8dc12bce60d050b9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:17 +0000
Subject: [PATCH 1802/3799] soh: rename D_8012ADD8 -> sSkyVtxIndices

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the 0x20 vertex indices used by each outdoor-skybox face.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 5450a796e..82cd22868 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -114,7 +114,8 @@ u32 sSkyFaceTexOffsets[6] = {  // was D_8012ADC0 [LLM:HIGH]
     0x00000000, 0x00002000, 0x00004000, 0x00006000, 0x00008000, 0x0000C000,
 };
 
-u16 D_8012ADD8[0x20] = {
+// LLM generated name (HIGH), was D_8012ADD8: the 0x20 vertex indices used by each outdoor-skybox face.
+u16 sSkyVtxIndices[0x20] = {  // was D_8012ADD8 [LLM:HIGH]
     0x00, 0x02, 0x0A, 0x0C, 0x02, 0x04, 0x0C, 0x0E, 0x0A, 0x0C, 0x14, 0x16, 0x0C, 0x0E, 0x16, 0x18,
     0x01, 0x03, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0B, 0x0D, 0x0F, 0x10, 0x11, 0x12, 0x13, 0x15, 0x17,
 };
@@ -348,7 +349,7 @@ s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
     skyboxCtx->unk_138 = &skyboxCtx->dListBuf[2 * arg8];
 
     for (i = 0; i < 0x20; i++) {
-        index = D_8012ADD8[i];
+        index = sSkyVtxIndices[i];  // was D_8012ADD8 [LLM:HIGH]
 
         roomVtx[arg2 + i].v.ob[0] = sp2B4[index];
         roomVtx[arg2 + i].v.ob[1] = sp250[index];
-- 
2.55.0

