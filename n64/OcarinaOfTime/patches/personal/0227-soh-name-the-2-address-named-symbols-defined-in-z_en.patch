+static ColliderCylinderInit sAttackCylinderInit = {  // was D_80A4B7A0 [LLM:HIGH]
     {
         COLTYPE_HIT3,
         AT_ON | AT_TYPE_ENEMY,
@@ -80,7 +81,8 @@ static ColliderCylinderInit D_80A4B7A0 = {
