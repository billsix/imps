From e29b1ba1d9dfa4d5af2fb79f8f63ca5962daf356 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:09:39 +0000
Subject: [PATCH 3253/3799] soh: rename func_800AAA9C -> View_ApplyPerspective

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: builds the viewport, guPerspective projection and viewing matrix and binds them
Defined in soh/src/code/z_view.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_view.c   | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index a78acd151..28312307b 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1412,7 +1412,7 @@ void View_ClearDistortion(View* view);
 void View_SetDistortion(View* view, Vec3f orientation, Vec3f scale, f32 speed);
 s32 View_StepDistortion(View* view, Mtx* projectionMtx);
 void View_Apply(View* view, s32 arg1);  // was func_800AAA50 [LLM:HIGH]
-s32 func_800AAA9C(View* view);
+s32 View_ApplyPerspective(View* view);  // was func_800AAA9C [LLM:HIGH]
 s32 func_800AB0A8(View* view);
 s32 func_800AB2C4(View* view);
 s32 func_800AB560(View* view);
diff --git a/soh/src/code/z_view.c b/soh/src/code/z_view.c
index 0d8b1c0fd..029b57d37 100644
--- a/soh/src/code/z_view.c
+++ b/soh/src/code/z_view.c
@@ -289,7 +289,7 @@ void View_Apply(View* view, s32 arg1) {
     if (arg1 & 8) {
         func_800AB0A8(view);
     } else {
-        func_800AAA9C(view);
+        View_ApplyPerspective(view);  // was func_800AAA9C [LLM:HIGH]
     }
 }
 
@@ -297,7 +297,8 @@ static float sqr(float a) {
     return a * a;
 }
 
-s32 func_800AAA9C(View* view) {
+// LLM generated name (HIGH), was func_800AAA9C: builds the viewport, guPerspective projection and viewing matrix and binds them
+s32 View_ApplyPerspective(View* view) {
     f32 aspect;
     s32 width;
     s32 height;
