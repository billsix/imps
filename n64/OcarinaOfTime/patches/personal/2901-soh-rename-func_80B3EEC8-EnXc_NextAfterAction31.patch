+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -1291,7 +1291,8 @@ void EnXc_NextAfterAction30(EnXc* this) {
     EnXc_CheckAndSetAction(this, SHEIK_ACTION_30, SHEIK_ACTION_31);
 }
 
-void func_80B3EEC8(EnXc* this) {
+// LLM generated name (HIGH), was func_80B3EEC8: the same guard from action 31 to 32
+void EnXc_NextAfterAction31(EnXc* this) {
     EnXc_CheckAndSetAction(this, SHEIK_ACTION_31, SHEIK_ACTION_32);
 }
 
@@ -1362,7 +1363,7 @@ void EnXc_ActionFunc30(EnXc* this, PlayState* play) {
 void EnXc_ActionFunc31(EnXc* this, PlayState* play) {
     EnXc_ActionFunc6(this, play);
     EnXc_SetPosRotFromCue(this, play, 4);  // was func_80B3C588 [LLM:HIGH]
-    func_80B3EEC8(this);
+    EnXc_NextAfterAction31(this);  // was func_80B3EEC8 [LLM:HIGH]
 }
 
