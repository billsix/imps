             return;
         }
     }
@@ -1129,7 +1130,7 @@ void EnKo_UpdateModelAlpha(EnKo* this, PlayState* play) {
     }
 }
 
-s32 func_80A98ECC(EnKo* this, PlayState* play) {
+s32 EnKo_UpdateByForestQuestState(EnKo* this, PlayState* play) {
     if (play->sceneNum == SCENE_LOST_WOODS && ENKO_TYPE == ENKO_TYPE_CHILD_FADO) {
         return EnKo_UpdateTrackNearbyPlayer(this, play);  // was func_80A97E18 [LLM:HIGH]
     }
