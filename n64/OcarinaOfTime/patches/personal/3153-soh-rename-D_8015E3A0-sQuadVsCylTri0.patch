Date: Tue, 8 Sep 2026 00:05:48 +0000
Subject: [PATCH 3153/3799] soh: rename D_8015E3A0 -> sQuadVsCylTri0

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the first triangle the AT quad is split into in CollisionCheck_AC_QuadVsCyl
Defined in soh/src/code/z_collision_check.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_collision_check.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_collision_check.c b/soh/src/code/z_collision_check.c
index 82f5ce1bc..58d361d4c 100644
--- a/soh/src/code/z_collision_check.c
+++ b/soh/src/code/z_collision_check.c
@@ -2260,7 +2260,7 @@ static s8 sBssDummy1;
  * AC overlap check. Calculates the center of each collider element and the point of contact.
  */
 void CollisionCheck_AC_QuadVsCyl(PlayState* play, CollisionCheckContext* colChkCtx, Collider* colAT, Collider* colAC) {
-    static TriNorm D_8015E3A0;
+    static TriNorm sQuadVsCylTri0;  // was D_8015E3A0 [LLM:HIGH]
     static TriNorm D_8015E3D8;
     static Vec3f D_8015E410;
     ColliderQuad* at = (ColliderQuad*)colAT;
@@ -2273,9 +2273,9 @@ void CollisionCheck_AC_QuadVsCyl(PlayState* play, CollisionCheckContext* colChkC
         if (CollisionCheck_NoSharedFlags(&at->info, &ac->info) == 1) {
             return;
         }
-        Math3D_TriNorm(&D_8015E3A0, &at->dim.quad[2], &at->dim.quad[3], &at->dim.quad[1]);
+        Math3D_TriNorm(&sQuadVsCylTri0, &at->dim.quad[2], &at->dim.quad[3], &at->dim.quad[1]);  // was D_8015E3A0 [LLM:HIGH]
         Math3D_TriNorm(&D_8015E3D8, &at->dim.quad[2], &at->dim.quad[1], &at->dim.quad[0]);
-        if (Math3D_CylTriVsIntersect(&ac->dim, &D_8015E3A0, &D_8015E410) == 1) {
+        if (Math3D_CylTriVsIntersect(&ac->dim, &sQuadVsCylTri0, &D_8015E410) == 1) {  // was D_8015E3A0 [LLM:HIGH]
             if (Collider_QuadSetNearestAC(play, at, &D_8015E410)) {
                 Vec3f atPos1;
                 Vec3f acPos1;
