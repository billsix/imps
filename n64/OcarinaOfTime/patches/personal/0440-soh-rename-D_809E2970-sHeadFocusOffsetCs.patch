From 1be8d64810776b8f2771679c620e0b12ce03fbb9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:37 +0000
Subject: [PATCH 440/488] soh: rename D_809E2970 -> sHeadFocusOffsetCs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point EnCs_PostLimbDraw records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Cs/z_en_cs.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Cs/z_en_cs.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Cs/z_en_cs.c b/soh/src/overlays/actors/ovl_En_Cs/z_en_cs.c
index a20ab98dd..dd583e436 100644
--- a/soh/src/overlays/actors/ovl_En_Cs/z_en_cs.c
+++ b/soh/src/overlays/actors/ovl_En_Cs/z_en_cs.c
@@ -508,11 +508,11 @@ s32 EnCs_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 }
 
 void EnCs_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
-    static Vec3f D_809E2970 = { 500.0f, 800.0f, 0.0f };
+    static Vec3f sHeadFocusOffsetCs = { 500.0f, 800.0f, 0.0f };  // was D_809E2970 [LLM:HIGH]
     EnCs* this = (EnCs*)thisx;
 
     if (limbIndex == 15) {
-        Matrix_MultVec3f(&D_809E2970, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sHeadFocusOffsetCs, &this->actor.focus.pos);  // was D_809E2970 [LLM:HIGH]
         Matrix_Translate(0.0f, -200.0f, 0.0f, MTXMODE_APPLY);
         Matrix_RotateY(0.0f, MTXMODE_APPLY);
         Matrix_RotateX(0.0f, MTXMODE_APPLY);
-- 
