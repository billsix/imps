         { 0.0f, 0.0f, -11000.0f }, { 0.0f, 0.0f, -12000.0f },
     };
@@ -3239,11 +3239,11 @@ void BossTw_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot
             }
             break;
         case 14:
