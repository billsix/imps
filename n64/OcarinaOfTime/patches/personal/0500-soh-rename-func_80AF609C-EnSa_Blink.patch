From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:52 +0000
Subject: [PATCH 500/784] soh: rename func_80AF609C -> EnSa_Blink

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.81.
Defined in soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c.
---
 soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
index 57eafc8d3..d1309ca0a 100644
--- a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
+++ b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
@@ -456,7 +456,8 @@ s32 EnSa_EyesStayClosed(EnSa* this) {
     return 1;
 }
 
-void func_80AF609C(EnSa* this) {
+// Name from zeldaret/oot (was func_80AF609C): adopted upstream's name for this address; body verified to match upstream at 0.81. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Sa/z_en_sa.c]
+void EnSa_Blink(EnSa* this) {
     s16 phi_v1;
 
     if (EnSa_EyesStayClosed(this) == 0) {
@@ -773,7 +774,7 @@ void EnSa_Update(Actor* thisx, PlayState* play) {
         Actor_UpdateBgCheckInfo(play, &this->actor, 0.0f, 0.0f, 0.0f, 4);
     }
 
-    func_80AF609C(this);
+    EnSa_Blink(this);
     this->actionFunc(this, play);
     EnSa_UpdateTalking(this, play);
     EnSa_UpdateTrackingMode(this, play);
