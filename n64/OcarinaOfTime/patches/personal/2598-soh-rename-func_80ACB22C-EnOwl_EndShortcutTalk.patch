From 44bda89ad8557fb338365917b55799d114fb8b86 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:41:10 +0000
Subject: [PATCH 2598/3799] soh: rename func_80ACB22C -> EnOwl_EndShortcutTalk

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the same close and takeoff without the switch flag
Defined in soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
index 8b32ca57d..1508589a9 100644
--- a/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
+++ b/soh/src/overlays/actors/ovl_En_Owl/z_en_owl.c
@@ -623,7 +623,8 @@ void EnOwl_WaitHyliaShortcut(EnOwl* this, PlayState* play) {
     }
 }
 
-void func_80ACB22C(EnOwl* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80ACB22C: the same close and takeoff without the switch flag
+void EnOwl_EndShortcutTalk(EnOwl* this, PlayState* play) {
     if (Actor_TextboxIsClosing(&this->actor, play)) {
         Audio_QueueSeqCmd(0x1 << 28 | SEQ_PLAYER_FANFARE << 24 | 0xFF);
         EnOwl_SetupUnfoldWings(this);  // was func_80ACA5C8 [LLM:HIGH]
@@ -650,7 +651,7 @@ void EnOwl_WaitDeathMountainShortcut(EnOwl* this, PlayState* play) {
     } else {
         if (EnOwl_OfferTalk(this, play, 0x3063)) {  // was func_80ACA558 [LLM:HIGH]
             Audio_PlayFanfare(NA_BGM_OWL);
-            this->actionFunc = func_80ACB22C;
+            this->actionFunc = EnOwl_EndShortcutTalk;  // was func_80ACB22C [LLM:HIGH]
         }
     }
 }
