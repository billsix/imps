From 03881e2512b6c4d355d15c25a7ca394e52880e8e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:08:50 +0000
Subject: [PATCH 2010/3799] soh: rename D_80897398 -> sShadowBrushSmall

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: 3x3 alpha brush stamped along the base outline of the same shadow texture
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
index 09280132e..9c727b049 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
@@ -62,7 +62,8 @@ static u8 sShadowBrushLarge[11][11] = {  // was D_8089731C [LLM:HIGH]
     { 0x00, 0x00, 0x20, 0x80, 0x80, 0x80, 0x80, 0x80, 0x20, 0x00, 0x00 },
 };
 
-static u8 D_80897398[3][3] = {
+// LLM generated name (HIGH), was D_80897398: 3x3 alpha brush stamped along the base outline of the same shadow texture
+static u8 sShadowBrushSmall[3][3] = {  // was D_80897398 [LLM:HIGH]
     { 0x20, 0x80, 0x20 },
     { 0x80, 0xA0, 0x80 },
     { 0x20, 0x80, 0x20 },
@@ -346,7 +347,7 @@ void BgJyaCobra_UpdateShadowFromSide(BgJyaCobra* this) {
                     for (l = 0; l < 3; l++) {
                         temp_x = x - 1 + l;
                         if (!(temp_x & ~0x3F)) {
-                            shadowTex[temp_z + temp_x] |= D_80897398[k][l];
+                            shadowTex[temp_z + temp_x] |= sShadowBrushSmall[k][l];  // was D_80897398 [LLM:HIGH]
                         }
                     }
                 }
@@ -363,7 +364,7 @@ void BgJyaCobra_UpdateShadowFromSide(BgJyaCobra* this) {
         shadowTex[j * 0x40 + 0] = 0;
         shadowTex[j * 0x40 + 0x3F] = 0;
     }
-    if (D_80897398[0][0]) {}
+    if (sShadowBrushSmall[0][0]) {}  // was D_80897398 [LLM:HIGH]
 }
 
