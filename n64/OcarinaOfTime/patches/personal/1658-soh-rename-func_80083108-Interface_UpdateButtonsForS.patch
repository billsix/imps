From d04e023d4e3460fb66efbf958c4ebcc78be43035 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:33:26 +0000
Subject: [PATCH 1658/3799] soh: rename func_80083108 ->
 Interface_UpdateButtonsForScene

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: enables or disables the B and C buttons for the current situation -- riding a horse, the shooting gallery, the bowling alley, being swordless -- and reloads the affected item icons.
Defined in soh/src/code/z_parameter.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/soh/Enhancements/TimeSavers/SkipCutscene/SkipIntro.cpp | 2 +-
 soh/src/code/z_parameter.c                                 | 7 ++++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/soh/Enhancements/TimeSavers/SkipCutscene/SkipIntro.cpp b/soh/soh/Enhancements/TimeSavers/SkipCutscene/SkipIntro.cpp
index 6a72312c6..c0b45dce4 100644
--- a/soh/soh/Enhancements/TimeSavers/SkipCutscene/SkipIntro.cpp
+++ b/soh/soh/Enhancements/TimeSavers/SkipCutscene/SkipIntro.cpp
@@ -26,7 +26,7 @@ static void SkipIntro_OnSceneSpawnActors() {
         player->actor.prevPos = sIntroEndPos;
         player->actor.home.pos = sIntroEndPos;
         gPlayState->unk_1242B = 1; // VIEWPOINT_LOCKED
-        // Watching the intro leaves this visit on the cutscene layer, which stops func_80083108
+        // Watching the intro leaves this visit on the cutscene layer, which stops Interface_UpdateButtonsForScene, was func_80083108 [LLM:HIGH]
         // from running & dimming the buttons. Zeroing cutsceneIndex loses that, so put it back
         gSaveContext.sceneLayer = SCENE_LAYER_CUTSCENE_FIRST + 1;
     }
diff --git a/soh/src/code/z_parameter.c b/soh/src/code/z_parameter.c
index e7e69d320..c9d55d9d8 100644
--- a/soh/src/code/z_parameter.c
+++ b/soh/src/code/z_parameter.c
@@ -812,7 +812,8 @@ void Interface_ApplyHudVisibility(PlayState* play, s16 maxAlpha) {
     }
 }
 
-void func_80083108(PlayState* play) {
+// LLM generated name (HIGH), was func_80083108: enables or disables the B and C buttons for the current situation -- riding a horse, the shooting gallery, the bowling alley, being swordless -- and reloads the affected item icons.
+void Interface_UpdateButtonsForScene(PlayState* play) {
     MessageContext* msgCtx = &play->msgCtx;
     Player* player = GET_PLAYER(play);
     InterfaceContext* interfaceCtx = &play->interfaceCtx;
@@ -1774,7 +1775,7 @@ void func_80084BF4(PlayState* play, u16 flag) {
             gSaveContext.buttonStatus[3] = BTN_ENABLED;
         gSaveContext.buttonStatus[5] = gSaveContext.buttonStatus[6] = gSaveContext.buttonStatus[7] =
             gSaveContext.buttonStatus[8] = BTN_ENABLED;
-        func_80083108(play);
+        Interface_UpdateButtonsForScene(play);  // was func_80083108 [LLM:HIGH]
     }
 }
 
@@ -6553,7 +6554,7 @@ void Interface_Update(PlayState* play) {
             if ((msgCtx->msgMode == MSGMODE_NONE) ||
                 ((msgCtx->msgMode != MSGMODE_NONE) && (play->sceneNum == SCENE_BOMBCHU_BOWLING_ALLEY))) {
                 if (play->gameOverCtx.state == GAMEOVER_INACTIVE) {
-                    func_80083108(play);
+                    Interface_UpdateButtonsForScene(play);  // was func_80083108 [LLM:HIGH]
                 }
             }
         }
