From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:12:05 +0000
Subject: [PATCH 0535/3799] soh: rename func_80A6E70C -> EnHs_OddMushroomNo

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c.
---
 soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c b/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
index 32b8a55e6..005e0f3e0 100644
--- a/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
+++ b/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
@@ -152,7 +152,8 @@ void EnHs_SleepingTalk(EnHs* this, PlayState* play) {
     }
 }
 
-void func_80A6E70C(EnHs* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80A6E70C): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Hs/z_en_hs.c]
+void EnHs_OddMushroomNo(EnHs* this, PlayState* play) {
     if (Actor_TextboxIsClosing(&this->actor, play)) {
         EnHs_SetActionFunc(this, EnHs_SleepingInteract);
     }
@@ -181,7 +182,7 @@ void func_80A6E7BC(EnHs* this, PlayState* play) {
                 break;
             case 1:
                 Message_ContinueTextbox(play, 0x10B4);
-                EnHs_SetActionFunc(this, func_80A6E70C);
+                EnHs_SetActionFunc(this, EnHs_OddMushroomNo);
                 break;
         }
 
