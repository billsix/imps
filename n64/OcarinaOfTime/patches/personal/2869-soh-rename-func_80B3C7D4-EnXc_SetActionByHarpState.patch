     }
 }
 
-void func_80B3C7D4(EnXc* this, s32 action1, s32 action2, s32 action3) {
+// LLM generated name (HIGH), was func_80B3C7D4: when the action has moved off the expected one, picks the next by whether the harp is being put away
+void EnXc_SetActionByHarpState(EnXc* this, s32 action1, s32 action2, s32 action3) {
     if (action1 != this->action) {
         if (this->action == SHEIK_ACTION_PUT_HARP_AWAY) {
             this->action = action2;
@@ -1276,7 +1277,7 @@ void func_80B3EF34(EnXc* this) {
