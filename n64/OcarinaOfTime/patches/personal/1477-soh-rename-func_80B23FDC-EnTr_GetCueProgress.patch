From c54375d5d2e93dea153053366986be771e9e3375 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:17 +0000
Subject: [PATCH 1477/3799] soh: rename func_80B23FDC -> EnTr_GetCueProgress

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns how far the current actor cue has progressed, from 0 at its start frame to a clamped 1 at its end frame.
Defined in soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
index 84ded651f..aa30f2882 100644
--- a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
+++ b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
@@ -454,7 +454,8 @@ void EnTr_Draw(Actor* thisx, PlayState* play) {
     }
 }
 
-f32 func_80B23FDC(PlayState* play, s32 actionIndex) {
+// LLM generated name (HIGH), was func_80B23FDC: returns how far the current actor cue has progressed, from 0 at its start frame to a clamped 1 at its end frame.
+f32 EnTr_GetCueProgress(PlayState* play, s32 actionIndex) {
     f32 phi_f2 = Environment_LerpWeight(play->csCtx.npcActions[actionIndex]->endFrame,
                                         play->csCtx.npcActions[actionIndex]->startFrame, play->csCtx.frames);
     phi_f2 = CLAMP_MAX(phi_f2, 1.0f);
@@ -476,7 +477,7 @@ void func_80B24038(EnTr* this, PlayState* play, s32 actionIndex) {
     endPos.y = play->csCtx.npcActions[actionIndex]->endPos.y;
     endPos.z = play->csCtx.npcActions[actionIndex]->endPos.z;
 
-    temp_f0 = func_80B23FDC(play, actionIndex);
+    temp_f0 = EnTr_GetCueProgress(play, actionIndex);  // was func_80B23FDC [LLM:HIGH]
 
     startPos.x = ((endPos.x - startPos.x) * temp_f0) + startPos.x;
     startPos.y = ((endPos.y - startPos.y) * temp_f0) + startPos.y;
-- 
