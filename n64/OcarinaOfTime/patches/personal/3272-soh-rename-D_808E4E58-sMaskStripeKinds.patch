From 47ef87eb299e59b08fafcfd2046e69458c19efc1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:10:30 +0000
Subject: [PATCH 3272/3799] soh: rename D_808E4E58 -> sMaskStripeKinds

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-limb selector, 0-3, choosing which of the four stripe width tables stamps that limb
Defined in soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
index aa5afc17b..399972184 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon/z_boss_ganon.c
@@ -3698,7 +3698,7 @@ void BossGanon_DrawMaskTexPattern(BossGanon* this, u8* tex, f32 arg2) {
     static s16 sMaskStripeWidths8[] = { 2, 3, 4, 4, 4, 4, 3, 2 };  // was D_808E4E10 [LLM:HIGH]
     static s16 sMaskStripeWidths12[] = { 2, 4, 5, 5, 6, 6, 6, 6, 5, 5, 4, 2 };  // was D_808E4E20 [LLM:HIGH]
     static s16 sMaskLimbParents[] = { 1, -1, 1, 1, 3, 4, 1, 6, 7, 2, 9, 10, 2, 12, 13 };  // was D_808E4E38 [LLM:HIGH]
-    static u8 D_808E4E58[] = { 3, 2, 2, 1, 3, 3, 1, 3, 3, 1, 0, 3, 1, 0, 3 };
+    static u8 sMaskStripeKinds[] = { 3, 2, 2, 1, 3, 3, 1, 3, 3, 1, 0, 3, 1, 0, 3 };  // was D_808E4E58 [LLM:HIGH]
     s16 baseX;
     s16 index;
     s16 i;
@@ -3736,7 +3736,7 @@ void BossGanon_DrawMaskTexPattern(BossGanon* this, u8* tex, f32 arg2) {
             baseX = (s16)(sp5C.x + 32.0f);
             baseY = (s16)sp5C.y * 64;
 
-            if (D_808E4E58[i] == 2) {
+            if (sMaskStripeKinds[i] == 2) {  // was D_808E4E58 [LLM:HIGH]
                 for (y = 0, addY = -0x180; y < 12; y++, addY += 0x40) {
                     for (x = -sMaskStripeWidths12[y]; x < sMaskStripeWidths12[y]; x++) {  // was D_808E4E20 [LLM:HIGH]
                         index = baseX + x + baseY + addY;
@@ -3745,7 +3745,7 @@ void BossGanon_DrawMaskTexPattern(BossGanon* this, u8* tex, f32 arg2) {
                         }
                     }
                 }
-            } else if (D_808E4E58[i] == 1) {
+            } else if (sMaskStripeKinds[i] == 1) {  // was D_808E4E58 [LLM:HIGH]
                 for (y = 0, addY = -0x100; y < 8; y++, addY += 0x40) {
                     for (x = -sMaskStripeWidths8[y]; x < sMaskStripeWidths8[y]; x++) {  // was D_808E4E10 [LLM:HIGH]
                         index = baseX + x + baseY + addY;
@@ -3754,7 +3754,7 @@ void BossGanon_DrawMaskTexPattern(BossGanon* this, u8* tex, f32 arg2) {
                         }
                     }
                 }
-            } else if (D_808E4E58[i] == 0) {
+            } else if (sMaskStripeKinds[i] == 0) {  // was D_808E4E58 [LLM:HIGH]
                 for (y = 0, addY = -0xC0; y < 7; y++, addY += 0x40) {
                     for (x = -sMaskStripeWidths7[y]; x < sMaskStripeWidths7[y] - 1; x++) {  // was D_808E4E00 [LLM:HIGH]
                         index = baseX + x + baseY + addY;
