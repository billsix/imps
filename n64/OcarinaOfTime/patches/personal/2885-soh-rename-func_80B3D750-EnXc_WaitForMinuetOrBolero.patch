 }
 
-void func_80B3D750(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B3D750: holds until both teaching cutscenes report done, then waits
+void EnXc_WaitForMinuetOrBolero(EnXc* this, PlayState* play) {
     if (EnXc_MinuetCS(this, play) && EnXc_BoleroCS(this, play)) {
         this->action = SHEIK_ACTION_WAIT;
     }
@@ -940,7 +941,7 @@ void EnXc_SetupDisappear(EnXc* this, PlayState* play) {
