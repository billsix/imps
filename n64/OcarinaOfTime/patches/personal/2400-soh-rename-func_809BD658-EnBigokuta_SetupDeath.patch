Subject: [PATCH 2400/3799] soh: rename func_809BD658 -> EnBigokuta_SetupDeath

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays the death animation with NA_SE_EN_DAIOCTA_DEAD2
Defined in soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c b/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
index 91e864201..c131a1c84 100644
--- a/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
+++ b/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
@@ -370,7 +370,8 @@ void EnBigokuta_SetupDamage(EnBigokuta* this) {
     Actor_SetColorFilter(&this->actor, 0x4000, 255, 0, 24);
     this->actionFunc = func_809BE180;
 }
-void func_809BD658(EnBigokuta* this) {
+// LLM generated name (HIGH), was func_809BD658: plays the death animation with NA_SE_EN_DAIOCTA_DEAD2
+void EnBigokuta_SetupDeath(EnBigokuta* this) {
 
     Animation_MorphToPlayOnce(&this->skelAnime, &object_bigokuta_Anim_000A74, -5.0f);
     Audio_PlayActorSound2(&this->actor, NA_SE_EN_DAIOCTA_DEAD2);
@@ -623,7 +624,7 @@ void func_809BE180(EnBigokuta* this, PlayState* play) {
         if (this->actor.colChkInfo.health != 0) {
             EnBigokuta_SetupTurnAround(this);  // was func_809BD4A4 [LLM:HIGH]
         } else {
-            func_809BD658(this);
+            EnBigokuta_SetupDeath(this);  // was func_809BD658 [LLM:HIGH]
         }
     } else if (this->unk_196 >= 8) {
         this->actor.shape.rot.y += this->unk_194 * 0x200;
