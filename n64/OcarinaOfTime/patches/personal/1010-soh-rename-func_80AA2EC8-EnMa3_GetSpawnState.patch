From 4519e5648bd49e8df502a941a1646ef1766a7f46 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:35:18 +0000
Subject: [PATCH 1010/3799] soh: rename func_80AA2EC8 -> EnMa3_GetSpawnState

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns 2 when Malon should not exist (child Link, or Epona not yet won), 1 when the race-in-progress eventInf bit is set, and 0 otherwise; Init kills the actor on 2 and treats 0 and 1 identically, so what distinguishes those two is not observable here.
Defined in soh/src/overlays/actors/ovl_En_Ma3/z_en_ma3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ma3/z_en_ma3.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ma3/z_en_ma3.c b/soh/src/overlays/actors/ovl_En_Ma3/z_en_ma3.c
index 3f2c84e44..5450bd305 100644
--- a/soh/src/overlays/actors/ovl_En_Ma3/z_en_ma3.c
+++ b/soh/src/overlays/actors/ovl_En_Ma3/z_en_ma3.c
@@ -21,7 +21,8 @@ s16 EnMa3_UpdateTalkState(PlayState* play, Actor* this);
 
 // LLM generated name (HIGH), was func_80AA2E54: feeds the player's position to Npc_TrackPoint, using NPC_TRACKING_NONE while Malon is idly singing and auto-turn tracking otherwise.
 void EnMa3_TrackPlayer(EnMa3* this, PlayState* play);  // was func_80AA2E54 [LLM:HIGH]
-s32 func_80AA2EC8(EnMa3* this, PlayState* play);
+// LLM generated name (GUESS), was func_80AA2EC8: returns 2 when Malon should not exist (child Link, or Epona not yet won), 1 when the race-in-progress eventInf bit is set, and 0 otherwise; Init kills the actor on 2 and treats 0 and 1 identically, so what distinguishes those two is not observable here.
+s32 EnMa3_GetSpawnState(EnMa3* this, PlayState* play);  // was func_80AA2EC8 [LLM:GUESS]
 s32 func_80AA2F28(EnMa3* this);
 void EnMa3_UpdateEyes(EnMa3* this);
 void func_80AA3200(EnMa3* this, PlayState* play);
@@ -197,7 +198,7 @@ void EnMa3_TrackPlayer(EnMa3* this, PlayState* play) {
     Npc_TrackPoint(&this->actor, &this->interactInfo, 0, trackingMode);
 }
 
-s32 func_80AA2EC8(EnMa3* this, PlayState* play) {
+s32 EnMa3_GetSpawnState(EnMa3* this, PlayState* play) {
     if (LINK_IS_CHILD) {
         return 2;
     }
@@ -252,7 +253,7 @@ void EnMa3_Init(Actor* thisx, PlayState* play) {
     Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);
     CollisionCheck_SetInfo2(&this->actor.colChkInfo, DamageTable_Get(22), &sColChkInfoInit);
 
-    switch (func_80AA2EC8(this, play)) {
+    switch (EnMa3_GetSpawnState(this, play)) {  // was func_80AA2EC8 [LLM:GUESS]
         case 0:
             EnMa3_ChangeAnim(this, ENMA3_ANIM_0);
             this->actionFunc = func_80AA3200;
