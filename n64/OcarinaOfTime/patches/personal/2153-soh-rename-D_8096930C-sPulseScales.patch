From 92ab7e3cca2ff92c0caa0e7c7df7f8c132248f54 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:14:12 +0000
Subject: [PATCH 2153/3799] soh: rename D_8096930C -> sPulseScales

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the four-step 1.0 / 1.04 / 1.0 / 0.96 pulse applied to the whiteout scale
Defined in soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c b/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
index d3affbcb3..c70d98ec0 100644
--- a/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
+++ b/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
@@ -82,7 +82,8 @@ static s16 sObjectIds[] = {
 static Color_RGB8 sEnvColors[] = {
     { 255, 50, 0 }, { 0, 200, 0 }, { 200, 255, 0 }, { 200, 50, 255 }, { 255, 150, 0 }, { 0, 150, 255 },
 };
-static f32 D_8096930C[] = { 1.0f, 1.04f, 1.0f, 0.96f };
+// LLM generated name (HIGH), was D_8096930C: the four-step 1.0 / 1.04 / 1.0 / 0.96 pulse applied to the whiteout scale
+static f32 sPulseScales[] = { 1.0f, 1.04f, 1.0f, 0.96f };  // was D_8096930C [LLM:HIGH]
 static f32 D_8096931C[] = { 1.1f, 1.0f, 0.9f, 0.8f };
 
 void Demo6K_SetupAction(Demo6K* this, Demo6KActionFunc actionFunc) {
@@ -269,7 +270,7 @@ void Demo6K_ReleaseLight(Demo6K* this, PlayState* play) {
 
 void Demo6K_ExpandWhiteout(Demo6K* this, PlayState* play) {
     if (this->timer1 < 5) {
-        this->unk_168 = D_8096930C[this->timer1 & 3];
+        this->unk_168 = sPulseScales[this->timer1 & 3];  // was D_8096930C [LLM:HIGH]
     } else if (this->timer1 < 15) {
         this->actor.scale.x += 0.012f;
         Actor_SetScale(&this->actor, this->actor.scale.x);
@@ -281,7 +282,7 @@ void Demo6K_ExpandWhiteout(Demo6K* this, PlayState* play) {
                                this->actor.world.pos.y, this->actor.world.pos.z, 0, 0, 0, EFF_DUST_TYPE_1);
         }
         Math_StepToF(&this->unk_16C, 1.0f, 0.02f);
-        this->unk_168 = D_8096930C[this->timer1 & 1];
+        this->unk_168 = sPulseScales[this->timer1 & 1];  // was D_8096930C [LLM:HIGH]
     }
 
     this->timer1++;
-- 
