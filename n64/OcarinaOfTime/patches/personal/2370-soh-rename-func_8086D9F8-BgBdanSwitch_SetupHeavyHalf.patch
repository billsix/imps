 void BgBdanSwitch_HeavyHalfPress(BgBdanSwitch* this, PlayState* play);  // was func_8086D8CC [LLM:HIGH]
 // LLM generated name (HIGH), was func_8086D95C: sinks the heavy switch the rest of the way once the camera looks at it or the wait expires
