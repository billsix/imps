From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:12:08 +0000
Subject: [PATCH 0558/3799] soh: rename func_80AEE568 -> EnRu1_CheckLanding

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.85.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 28fe35474..1e8ce6638 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1660,7 +1660,8 @@ void EnRu1_UpdateSittingAction(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEE568(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEE568): adopted upstream's name for this address; body verified to match upstream at 0.85. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_CheckLanding(EnRu1* this, PlayState* play) {
     if (!EnRu1_IsOnSapphirePlatform(this, play)) {
         if ((this->actor.bgCheckFlags & BGCHECKFLAG_GROUND) && (this->actor.speedXZ == 0.0f) &&
             (this->actor.minVelocityY == 0.0f)) {
@@ -1813,7 +1814,7 @@ void func_80AEEC5C(EnRu1* this, PlayState* play) {
     EnRu1_UpdatePosition(this, play);
     EnRu1_UpdateSkelAnime(this);
     EnRu1_UpdateEyes(this);
-    func_80AEE568(this, play);
+    EnRu1_CheckLanding(this, play);
     func_80AED624(this, play);
     EnRu1_ResetBgCheckFlags(this, play);
 }
