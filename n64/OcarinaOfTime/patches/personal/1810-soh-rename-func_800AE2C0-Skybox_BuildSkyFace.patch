From 49fca99901205a8288ec692bb19f979b02eedd1f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:18 +0000
Subject: [PATCH 1810/3799] soh: rename func_800AE2C0 -> Skybox_BuildSkyFace

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the outdoor-skybox twin: it generates one face's vertices and quads and returns the next free vertex index.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 950e7531b..44712be43 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -278,7 +278,8 @@ s32 Skybox_BuildRoomFace(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 a
     return arg2;
 }
 
-s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s32 arg4, s32 arg5, s32 arg6, s32 arg7,
+// LLM generated name (HIGH), was func_800AE2C0: the outdoor-skybox twin: it generates one face's vertices and quads and returns the next free vertex index.
+s32 Skybox_BuildSkyFace(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s32 arg4, s32 arg5, s32 arg6, s32 arg7,
                   s32 arg8) {
     s32 i;
     s32 j;
@@ -460,7 +461,7 @@ void func_800AF178(SkyboxContext* skyboxCtx, s32 arg1) {
     s32 i;
 
     for (i = 0; i < arg1; i++) {
-        phi_s2 = func_800AE2C0(skyboxCtx, skyboxCtx->roomVtx, phi_s2, sSkyFaceParams[i].unk_0, sSkyFaceParams[i].unk_4,  // was D_8012AF0C [LLM:HIGH]
+        phi_s2 = Skybox_BuildSkyFace(skyboxCtx, skyboxCtx->roomVtx, phi_s2, sSkyFaceParams[i].unk_0, sSkyFaceParams[i].unk_4,  // was D_8012AF0C [LLM:HIGH]
                                sSkyFaceParams[i].unk_8, sSkyFaceParams[i].unk_C, sSkyFaceParams[i].unk_10, i);  // was D_8012AF0C [LLM:HIGH]
     }
 }
