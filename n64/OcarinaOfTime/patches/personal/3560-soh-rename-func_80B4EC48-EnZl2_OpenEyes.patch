From d7fcd099f9938f38b9aae61482c6f1817cf4a02e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 01:52:00 +0000
Subject: [PATCH 3560/3799] soh: rename func_80B4EC48 -> EnZl2_OpenEyes

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: steps back 2, 1 and then hands over to the ordinary blink
Defined in soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c b/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
index 56dfac31f..144c57bc9 100644
--- a/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
+++ b/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
@@ -214,7 +214,8 @@ void EnZl2_ShutEyes(EnZl2* this) {
     this->eyeTexIndex2 = *eyeTexIndex;
 }
 
-void func_80B4EC48(EnZl2* this) {
+// LLM generated name (HIGH), was func_80B4EC48: steps back 2, 1 and then hands over to the ordinary blink
+void EnZl2_OpenEyes(EnZl2* this) {
     s16* eyeTexIndex = &this->eyeTexIndex;
     f32* unk_27C = &this->unk_27C;
 
@@ -1299,7 +1300,7 @@ void func_80B5154C(EnZl2* this, PlayState* play) {
         } else if (csCtx->frames == 0x5F0) {
             this->unk_27C = 0.0f;
         } else {
-            func_80B4EC48(this);
+            EnZl2_OpenEyes(this);  // was func_80B4EC48 [LLM:HIGH]
         }
     }
 }
