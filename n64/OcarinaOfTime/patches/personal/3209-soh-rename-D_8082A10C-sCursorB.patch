From ee633c898d52048e33f650fadc34b6c4a890b198 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:00 +0000
Subject: [PATCH 3209/3799] soh: rename D_8082A10C -> sCursorB

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the current blue of the quest cursor
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../misc/ovl_kaleido_scope/z_kaleido_collect.c     | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
index 624efefd8..36ed55626 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
@@ -26,7 +26,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
     static s16 sQuestItemFadeState = 0;  // was D_8082A100 [LLM:HIGH]
     static s16 sCursorR = 0;  // was D_8082A104 [LLM:HIGH]
     static s16 sCursorG = 0;  // was D_8082A108 [LLM:HIGH]
-    static s16 D_8082A10C = 0;
+    static s16 sCursorB = 0;  // was D_8082A10C [LLM:HIGH]
     static s16 D_8082A110 = 0;
     static s16 D_8082A114 = 20;
     static s16 D_8082A118 = 0;
@@ -416,7 +416,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
 
     sp226 = ABS(sCursorR - sCursorColorSets[D_8082A118][0]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
     sp224 = ABS(sCursorG - sCursorColorSets[D_8082A118][1]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
-    sp222 = ABS(D_8082A10C - sCursorColorSets[D_8082A118][2]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
+    sp222 = ABS(sCursorB - sCursorColorSets[D_8082A118][2]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
     sp220 = ABS(D_8082A110 - sCursorColorSets[D_8082A118][3]) / D_8082A114;  // was D_8082A070 [LLM:HIGH]
     if (sCursorR >= sCursorColorSets[D_8082A118][0]) {  // was D_8082A070 [LLM:HIGH]
         sCursorR -= sp226;  // was D_8082A104 [LLM:HIGH]
@@ -428,10 +428,10 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
     } else {
         sCursorG += sp224;  // was D_8082A108 [LLM:HIGH]
     }
-    if (D_8082A10C >= sCursorColorSets[D_8082A118][2]) {  // was D_8082A070 [LLM:HIGH]
-        D_8082A10C -= sp222;
+    if (sCursorB >= sCursorColorSets[D_8082A118][2]) {  // was D_8082A070 [LLM:HIGH]
+        sCursorB -= sp222;  // was D_8082A10C [LLM:HIGH]
     } else {
-        D_8082A10C += sp222;
+        sCursorB += sp222;  // was D_8082A10C [LLM:HIGH]
     }
     if (D_8082A110 >= sCursorColorSets[D_8082A118][3]) {  // was D_8082A070 [LLM:HIGH]
         D_8082A110 -= sp220;
@@ -442,7 +442,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
     if (--D_8082A114 == 0) {
         sCursorR = sCursorColorSets[D_8082A118][0];  // was D_8082A070 [LLM:HIGH]
         sCursorG = sCursorColorSets[D_8082A118][1];  // was D_8082A070 [LLM:HIGH]
-        D_8082A10C = sCursorColorSets[D_8082A118][2];  // was D_8082A070 [LLM:HIGH]
+        sCursorB = sCursorColorSets[D_8082A118][2];  // was D_8082A070 [LLM:HIGH]
         D_8082A110 = sCursorColorSets[D_8082A118][3];  // was D_8082A070 [LLM:HIGH]
         D_8082A114 = ZREG(24 + D_8082A118);
         if (++D_8082A118 >= 4) {
@@ -459,7 +459,7 @@ void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
             gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, sCursorColorSets[0][0], sCursorColorSets[0][1], sCursorColorSets[0][2],  // was D_8082A070 [LLM:HIGH]
                             pauseCtx->alpha);
         } else {
-            gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, sCursorR, sCursorG, D_8082A10C, D_8082A110);  // was D_8082A104 [LLM:HIGH]
+            gDPSetPrimColor(POLY_OPA_DISP++, 0, 0, sCursorR, sCursorG, sCursorB, D_8082A110);  // was D_8082A104 [LLM:HIGH]
         }
 
         gDPSetEnvColor(POLY_OPA_DISP++, 0, 0, 0, 255);
-- 
