From 00f5f5706848e56fcf12c1cbc87dcd186f1b1d92 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:03:17 +0000
Subject: [PATCH 1241/3799] soh: rename D_80127030 -> sUnusedWhiteFillDL

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the in-tree comment above it reads "// unused?"; it fills the whole screen with a near-white colour and restores the pixel depth source.
Defined in soh/src/code/z_rcp.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_rcp.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/z_rcp.c b/soh/src/code/z_rcp.c
index 221cac952..7a43a447e 100644
--- a/soh/src/code/z_rcp.c
+++ b/soh/src/code/z_rcp.c
@@ -825,7 +825,8 @@ Gfx sFillSetupDL[] = {
 };
 
 // unused?
-Gfx D_80127030[] = {
+// LLM generated name (HIGH), was D_80127030: the in-tree comment above it reads "// unused?"; it fills the whole screen with a near-white colour and restores the pixel depth source.
+Gfx sUnusedWhiteFillDL[] = {  // was D_80127030 [LLM:HIGH]
     gsDPPipeSync(),
     gsDPSetFillColor((GPACK_RGBA5551(255, 255, 240, 0) << 16) | GPACK_RGBA5551(255, 255, 240, 0)),
     gsDPFillRectangle(0, 0, SCREEN_WIDTH - 1, SCREEN_HEIGHT - 1),
-- 
2.55.0

