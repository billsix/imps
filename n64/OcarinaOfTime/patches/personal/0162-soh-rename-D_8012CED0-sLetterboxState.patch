From c8bdadefc3b702e36f6a73501c099bc03babab1b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:12 +0000
Subject: [PATCH 162/488] soh: rename D_8012CED0 -> sLetterboxState

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/shrink_window.c.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/code/shrink_window.c | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/src/code/shrink_window.c b/soh/src/code/shrink_window.c
index 075389174..937ee12a2 100644
--- a/soh/src/code/shrink_window.c
+++ b/soh/src/code/shrink_window.c
@@ -1,6 +1,7 @@
 #include "global.h"
 
-s32 D_8012CED0 = 0;
+// Name from zeldaret/oot (was D_8012CED0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/shrink_window.c]
+s32 sLetterboxState = 0;
 
 s32 sShrinkWindowVal = 0;
 s32 sShrinkWindowCurrentVal = 0;
@@ -39,7 +40,7 @@ void ShrinkWindow_Init(void) {
     if (HREG(80) == 0x13 && HREG(81) == 1) {
         osSyncPrintf("shrink_window_init()\n");
     }
-    D_8012CED0 = 0;
+    sLetterboxState = 0;
     sShrinkWindowVal = 0;
     sShrinkWindowCurrentVal = 0;
 }
@@ -61,8 +62,8 @@ void ShrinkWindow_Update(s32 updateRate) {
     }
 
     if (sShrinkWindowCurrentVal < sShrinkWindowVal) {
-        if (D_8012CED0 != 1) {
-            D_8012CED0 = 1;
+        if (sLetterboxState != 1) {
+            sLetterboxState = 1;
         }
 
         if (sShrinkWindowCurrentVal + off < sShrinkWindowVal) {
@@ -71,8 +72,8 @@ void ShrinkWindow_Update(s32 updateRate) {
             sShrinkWindowCurrentVal = sShrinkWindowVal;
         }
     } else if (sShrinkWindowVal < sShrinkWindowCurrentVal) {
-        if (D_8012CED0 != 2) {
-            D_8012CED0 = 2;
+        if (sLetterboxState != 2) {
+            sLetterboxState = 2;
         }
 
         if (sShrinkWindowVal < sShrinkWindowCurrentVal - off) {
@@ -81,7 +82,7 @@ void ShrinkWindow_Update(s32 updateRate) {
             sShrinkWindowCurrentVal = sShrinkWindowVal;
         }
     } else {
-        D_8012CED0 = 0;
+        sLetterboxState = 0;
     }
 
     if (HREG(80) == 0x13) {
@@ -97,7 +98,7 @@ void ShrinkWindow_Update(s32 updateRate) {
             HREG(88) = 0;
             HREG(89) = 0;
         }
-        HREG(83) = D_8012CED0;
+        HREG(83) = sLetterboxState;
         HREG(84) = sShrinkWindowCurrentVal;
         HREG(85) = sShrinkWindowVal;
         HREG(86) = off;
-- 
2.55.0

