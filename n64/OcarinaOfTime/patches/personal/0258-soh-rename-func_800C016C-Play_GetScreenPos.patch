     OTRPlay_SpawnScene(play, sceneId, spawn);
 }
 
-void func_800C016C(PlayState* play, Vec3f* src, Vec3f* dest) {
+// Name from zeldaret/oot (was func_800C016C): adopted upstream's name for this address; body verified to match upstream at 0.94. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_play.c]
+void Play_GetScreenPos(PlayState* play, Vec3f* src, Vec3f* dest) {
     f32 w;
 
     Matrix_Mult(&play->viewProjectionMtxF, MTXMODE_NEW);
