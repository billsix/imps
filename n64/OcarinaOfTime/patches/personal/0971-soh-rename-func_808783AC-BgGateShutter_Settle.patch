 void BgGateShutter_WaitToMove(BgGateShutter* this, PlayState* play);  // was func_8087828C [LLM:HIGH]
 // LLM generated name (HIGH), was func_80878300: slides the gate along -x toward -89 with the metal-gate sfx, then arms the 30-frame settle timer.
 void BgGateShutter_Open(BgGateShutter* this, PlayState* play);  // was func_80878300 [LLM:HIGH]
-void func_808783AC(BgGateShutter* this, PlayState* play);
+// LLM generated name (HIGH), was func_808783AC: waits out the 30-frame timer set by the two slide actions, clears openingState and returns to the idle action.
+void BgGateShutter_Settle(BgGateShutter* this, PlayState* play);  // was func_808783AC [LLM:HIGH]
