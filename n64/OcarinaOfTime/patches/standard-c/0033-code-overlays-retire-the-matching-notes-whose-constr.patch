 soh/src/overlays/actors/ovl_En_Zl4/z_en_zl4.c                 | 1 -
 soh/src/overlays/actors/ovl_player_actor/z_player.c           | 1 -
 soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_item.c      | 4 +---
 12 files changed, 5 insertions(+), 17 deletions(-)

diff --git a/soh/src/code/audio_heap.c b/soh/src/code/audio_heap.c
index b2898350a..7ddd4ed39 100644
--- a/soh/src/code/audio_heap.c
+++ b/soh/src/code/audio_heap.c
@@ -1027,8 +1027,7 @@ void* AudioHeap_AllocPermanent(s32 tableType, s32 id, size_t size) {
     gAudioContext.permanentCache[index].tableType = tableType;
     gAudioContext.permanentCache[index].id = id;
     gAudioContext.permanentCache[index].size = size;
-    //! @bug UB: missing return. "ret" is in v0 at this point, but doing an
-    // explicit return uses an additional register.
+    // The ROM fell off the end here with `ret` still in v0; the port returns it explicitly.
     return ret;
 }
 
