Subject: [PATCH 0698/3799] soh: rename func_80AEB3DC ->
 EnRu1_InitOutsideJabuJabu

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 2ac67c149..7b220a636 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -458,7 +458,8 @@ void EnRu1_StopWalkingTowardSapphire(EnRu1* this) {
     this->skelAnime.movementFlags &= ~0x1;
 }
 
-void func_80AEB3DC(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEB3DC): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_InitOutsideJabuJabu(EnRu1* this, PlayState* play) {
     EnRu1_AnimationChange(this, &gRutoChildWaitHandsBehindBackAnim, 0, 0, 0);
     this->action = 0;
     this->drawConfig = 1;
@@ -2375,7 +2376,7 @@ void EnRu1_Init(Actor* thisx, PlayState* play) {
             func_80AECDA0(this, play);
             break;
         case 1:
-            func_80AEB3DC(this, play);
+            EnRu1_InitOutsideJabuJabu(this, play);
             break;
         case 2:
             func_80AEC320(this, play);
