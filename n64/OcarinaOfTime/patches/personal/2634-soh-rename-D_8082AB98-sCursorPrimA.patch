From 91b5d45d7cdbe6966ea6c24199a5823339fd6195 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:39 +0000
Subject: [PATCH 2634/3799] soh: rename D_8082AB98 -> sCursorPrimA

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: alpha of that same prim colour, ramped up from zero when the cursor appears
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../ovl_kaleido_scope/z_kaleido_scope_PAL.c     | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index aea2d14f8..64d7ac791 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -927,7 +927,8 @@ static s16 sCursorPrimR = 0;  // was D_8082AB8C [LLM:HIGH]
 static s16 sCursorPrimG = 0;  // was D_8082AB90 [LLM:HIGH]
 // LLM generated name (HIGH), was D_8082AB94: blue of that same prim colour
 static s16 sCursorPrimB = 0;  // was D_8082AB94 [LLM:HIGH]
-static s16 D_8082AB98 = 255;
+// LLM generated name (HIGH), was D_8082AB98: alpha of that same prim colour, ramped up from zero when the cursor appears
+static s16 sCursorPrimA = 255;  // was D_8082AB98 [LLM:HIGH]
 
 static s16 D_8082AB9C = 255;
 static s16 D_8082ABA0 = 0;
@@ -3471,7 +3472,7 @@ void KaleidoScope_DrawGameOver(PlayState* play) {
     gDPSetCombineLERP(POLY_OPA_DISP++, TEXEL1, TEXEL0, PRIM_LOD_FRAC, TEXEL0, 0, 0, 0, TEXEL0, PRIMITIVE, ENVIRONMENT,
                       COMBINED, ENVIRONMENT, COMBINED, 0, PRIMITIVE, 0);
 
-    gDPSetPrimColor(POLY_OPA_DISP++, 0, 80, sCursorPrimR, sCursorPrimG, sCursorPrimB, D_8082AB98);  // was D_8082AB8C [LLM:HIGH]
+    gDPSetPrimColor(POLY_OPA_DISP++, 0, 80, sCursorPrimR, sCursorPrimG, sCursorPrimB, sCursorPrimA);  // was D_8082AB8C [LLM:HIGH]
     gDPSetEnvColor(POLY_OPA_DISP++, D_8082AB9C, D_8082ABA0, D_8082ABA4, 255);
 
     VREG(89) -= 2;
@@ -4572,7 +4573,7 @@ void KaleidoScope_Update(PlayState* play) {
             sCursorPrimR = 255;  // was D_8082AB8C [LLM:HIGH]
             sCursorPrimG = 130;  // was D_8082AB90 [LLM:HIGH]
             sCursorPrimB = 0;  // was D_8082AB94 [LLM:HIGH]
-            D_8082AB98 = 0;
+            sCursorPrimA = 0;  // was D_8082AB98 [LLM:HIGH]
             D_8082AB9C = 30;
             D_8082ABA0 = 0;
             D_8082ABA4 = 0;
@@ -4586,7 +4587,7 @@ void KaleidoScope_Update(PlayState* play) {
             stepR = ABS(sCursorPrimR - 30) / D_8082B260;  // was D_8082AB8C [LLM:HIGH]
             stepG = ABS(sCursorPrimG) / D_8082B260;  // was D_8082AB90 [LLM:HIGH]
             stepB = ABS(sCursorPrimB) / D_8082B260;  // was D_8082AB94 [LLM:HIGH]
-            stepA = ABS(D_8082AB98 - 255) / D_8082B260;
+            stepA = ABS(sCursorPrimA - 255) / D_8082B260;  // was D_8082AB98 [LLM:HIGH]
             if (sCursorPrimR >= 30) {  // was D_8082AB8C [LLM:HIGH]
                 sCursorPrimR -= stepR;  // was D_8082AB8C [LLM:HIGH]
             } else {
@@ -4602,10 +4603,10 @@ void KaleidoScope_Update(PlayState* play) {
             } else {
                 sCursorPrimB += stepB;  // was D_8082AB94 [LLM:HIGH]
             }
-            if (D_8082AB98 >= 255) {
-                D_8082AB98 -= stepA;
+            if (sCursorPrimA >= 255) {  // was D_8082AB98 [LLM:HIGH]
+                sCursorPrimA -= stepA;  // was D_8082AB98 [LLM:HIGH]
             } else {
-                D_8082AB98 += stepA;
+                sCursorPrimA += stepA;  // was D_8082AB98 [LLM:HIGH]
             }
 
             stepR = ABS(D_8082AB9C - 255) / D_8082B260;
@@ -4632,7 +4633,7 @@ void KaleidoScope_Update(PlayState* play) {
                 sCursorPrimR = 30;  // was D_8082AB8C [LLM:HIGH]
                 sCursorPrimG = 0;  // was D_8082AB90 [LLM:HIGH]
                 sCursorPrimB = 0;  // was D_8082AB94 [LLM:HIGH]
-                D_8082AB98 = 255;
+                sCursorPrimA = 255;  // was D_8082AB98 [LLM:HIGH]
 
                 D_8082AB9C = 255;
                 D_8082ABA0 = 130;
-- 
2.55.0

