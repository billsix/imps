+++ b/soh/src/overlays/actors/ovl_Bg_Bdan_Switch/z_bg_bdan_switch.c
@@ -19,7 +19,8 @@ void BgBdanSwitch_Draw(Actor* thisx, PlayState* play);
 void BgBdanSwitch_SetupIdle(BgBdanSwitch* this);  // was func_8086D5C4 [LLM:HIGH]
 // LLM generated name (HIGH), was func_8086D5E0: waits for the blue switch to be weighed down or for the player to stand on the yellow one
 void BgBdanSwitch_Idle(BgBdanSwitch* this, PlayState* play);  // was func_8086D5E0 [LLM:HIGH]
-void func_8086D67C(BgBdanSwitch* this);
+// LLM generated name (HIGH), was func_8086D67C: installs the pressing action and arms the 100-frame camera wait
+void BgBdanSwitch_SetupPress(BgBdanSwitch* this);  // was func_8086D67C [LLM:HIGH]
 void func_8086D694(BgBdanSwitch* this, PlayState* play);
