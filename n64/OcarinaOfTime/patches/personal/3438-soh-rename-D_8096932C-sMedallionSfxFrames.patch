From c9f3740d62f5e9df594e2486f5e6e735eedb723f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:10 +0000
Subject: [PATCH 3438/3799] soh: rename D_8096932C -> sMedallionSfxFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-sage cutscene frame the medallion light stops its gather sound at
Defined in soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c b/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
index e17653593..455ef2f6b 100644
--- a/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
+++ b/soh/src/overlays/actors/ovl_Demo_6K/z_demo_6k.c
@@ -304,7 +304,7 @@ void Demo6K_FadeWhiteout(Demo6K* this, PlayState* play) {
 }
 
 void Demo6K_PulseMedallionLight(Demo6K* this, PlayState* play) {
-    static u16 D_8096932C[] = { 275, 275, 275, 275, 275, 275 };
+    static u16 sMedallionSfxFrames[] = { 275, 275, 275, 275, 275, 275 };  // was D_8096932C [LLM:HIGH]
     u32 frames = play->state.frames;
 
     if (this->actor.scale.x < 0.1f) {
@@ -326,7 +326,7 @@ void Demo6K_PulseMedallionLight(Demo6K* this, PlayState* play) {
 
     this->timer2++;
 
-    if ((play->sceneNum == SCENE_INSIDE_GANONS_CASTLE) && (play->csCtx.frames < D_8096932C[this->actor.params - 3])) {
+    if ((play->sceneNum == SCENE_INSIDE_GANONS_CASTLE) && (play->csCtx.frames < sMedallionSfxFrames[this->actor.params - 3])) {  // was D_8096932C [LLM:HIGH]
         Actor_PlaySfx_Flagged(&this->actor, NA_SE_EV_LIGHT_GATHER - SFX_FLAG);
     }
 }
