From 14ea151a96895dd93398c75a940ab7716fb5e1f5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:53:58 +0000
Subject: [PATCH 2859/3799] soh: rename D_80ADD784 -> sSistersAtPostFlags

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: one bit per sister, set as each reaches her post; the group waits for all four at 15
Defined in soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_En_Po_Sisters/z_en_po_sisters.c  | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
index 5dc18798c..dde4597d6 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
@@ -167,7 +167,8 @@ static DamageTable sDamageTable = {
     /* Unknown 2     */ DMG_ENTRY(0, 0x0),
 };
 
-static s32 D_80ADD784 = 0;
+// LLM generated name (HIGH), was D_80ADD784: one bit per sister, set as each reaches her post; the group waits for all four at 15
+static s32 sSistersAtPostFlags = 0;  // was D_80ADD784 [LLM:HIGH]
 
 static InitChainEntry sInitChain[] = {
     ICHAIN_VEC3F_DIV1000(scale, 7, ICHAIN_CONTINUE),
@@ -570,7 +571,7 @@ void EnPoSisters_SetupWaitAtHome(EnPoSisters* this) {
 }
 
 void EnPoSisters_SetupWaitForCs(EnPoSisters* this, PlayState* play) {
-    D_80ADD784 = 0;
+    sSistersAtPostFlags = 0;  // was D_80ADD784 [LLM:HIGH]
     this->unk_22E.a = 0;
     this->unk_199 = 128;
     this->unk_19A = 50;
@@ -600,7 +601,7 @@ void EnPoSisters_SetupFormUp(EnPoSisters* this) {
         this->unk_19A = 76;
     }
     this->unk_198 = 0;
-    D_80ADD784 = 0;
+    sSistersAtPostFlags = 0;  // was D_80ADD784 [LLM:HIGH]
     this->actionFunc = EnPoSisters_FormUp;  // was func_80ADBD8C [LLM:HIGH]
 }
 
@@ -1095,7 +1096,7 @@ void EnPoSisters_WaitAtHome(EnPoSisters* this, PlayState* play) {
 }
 
 void EnPoSisters_WaitForCs(EnPoSisters* this, PlayState* play) {
-    if (D_80ADD784 != 0 || !Player_InCsMode(play)) {
+    if (sSistersAtPostFlags != 0 || !Player_InCsMode(play)) {  // was D_80ADD784 [LLM:HIGH]
         if (this->unk_19A != 0) {
             this->unk_19A--;
         }
@@ -1103,7 +1104,7 @@ void EnPoSisters_WaitForCs(EnPoSisters* this, PlayState* play) {
             if (this->unk_194 == 0) {
                 OnePointCutscene_Init(play, 3140, 999, NULL, CAM_ID_MAIN);
             }
-            D_80ADD784 = 1;
+            sSistersAtPostFlags = 1;  // was D_80ADD784 [LLM:HIGH]
         }
         if (this->unk_19A == 0) {
             EnPoSisters_SetupSpreadRing(this);  // was func_80ADA10C [LLM:HIGH]
@@ -1129,12 +1130,12 @@ void EnPoSisters_FormUp(EnPoSisters* this, PlayState* play) {
     if (this->unk_19A <= 0) {
         if (SkelAnime_Update(&this->skelAnime)) {
             this->unk_22E.a = 255;
-            D_80ADD784 |= (1 << this->unk_194);
+            sSistersAtPostFlags |= (1 << this->unk_194);  // was D_80ADD784 [LLM:HIGH]
         } else {
             this->unk_22E.a = (this->skelAnime.curFrame * 255.0f) / this->skelAnime.endFrame;
         }
     }
-    if (D_80ADD784 == 15) {
+    if (sSistersAtPostFlags == 15) {  // was D_80ADD784 [LLM:HIGH]
         EnPoSisters_SetupGatherRing(this);  // was func_80ADA25C [LLM:HIGH]
     }
 }
@@ -1480,5 +1481,5 @@ void EnPoSisters_Draw(Actor* thisx, PlayState* play) {
 }
 
 void EnPoSisters_Reset(void) {
-    D_80ADD784 = 0;
+    sSistersAtPostFlags = 0;  // was D_80ADD784 [LLM:HIGH]
 }
