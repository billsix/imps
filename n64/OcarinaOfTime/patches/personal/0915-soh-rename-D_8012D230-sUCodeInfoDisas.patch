From 8bcf061c4d4941d496d0433226e76ab8f712e7f5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:22:01 +0000
Subject: [PATCH 0915/3799] soh: rename D_8012D230 -> sUCodeInfoDisas

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: UCodeInfo table registered with the disassembler by Graph_DisassembleUCode.
Defined in soh/src/code/graph.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/graph.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/graph.c b/soh/src/code/graph.c
index 662e4a946..acdc4c2ca 100644
--- a/soh/src/code/graph.c
+++ b/soh/src/code/graph.c
@@ -31,7 +31,8 @@ FaultClient sGraphUcodeFaultClient;
 void PadMgr_ThreadEntry(PadMgr* padMgr);
 
 // clang-format off
-UCodeInfo D_8012D230[3] = {
+// LLM generated name (HIGH), was D_8012D230: UCodeInfo table registered with the disassembler by Graph_DisassembleUCode.
+UCodeInfo sUCodeInfoDisas[3] = {  // was D_8012D230 [LLM:HIGH]
     //{ UCODE_F3DZEX, D_80155F50 },
     { UCODE_UNK, NULL },
     //{ UCODE_S2DEX, D_80113070 },
@@ -60,7 +61,7 @@ void Graph_DisassembleUCode(Gfx* workBuf) {
     if (HREG(80) == 7 && HREG(81) != 0) {
         UCodeDisas_Init(&disassembler);
         disassembler.enableLog = HREG(83);
-        UCodeDisas_RegisterUCode(&disassembler, ARRAY_COUNT(D_8012D230), D_8012D230);
+        UCodeDisas_RegisterUCode(&disassembler, ARRAY_COUNT(sUCodeInfoDisas), sUCodeInfoDisas);  // was D_8012D230 [LLM:HIGH]
         //UCodeDisas_SetCurUCode(&disassembler, D_80155F50);
         UCodeDisas_Disassemble(&disassembler, workBuf);
         HREG(93) = disassembler.dlCnt;
-- 
