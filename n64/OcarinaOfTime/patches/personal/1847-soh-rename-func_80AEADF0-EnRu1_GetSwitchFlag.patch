From 1f778f3fe832b7f6e77e8bd087c945d91674774f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:48:26 +0000
Subject: [PATCH 1847/3799] soh: rename func_80AEADF0 -> EnRu1_GetSwitchFlag

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns the low byte of params.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index a4cf16c5e..eab172a64 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -249,7 +249,8 @@ u8 EnRu1_GetType(EnRu1* this) {
     return params;
 }
 
-u8 func_80AEADF0(EnRu1* this) {
+// LLM generated name (HIGH), was func_80AEADF0: returns the low byte of params.
+u8 EnRu1_GetSwitchFlag(EnRu1* this) {
     s16 params = this->actor.params;
 
     return params;
@@ -2414,7 +2415,7 @@ void EnRu1_Init(Actor* thisx, PlayState* play) {
     ActorShape_Init(&this->actor.shape, 0.0f, ActorShadow_DrawCircle, 30.0f);
     SkelAnime_InitFlex(play, &this->skelAnime, &gRutoChildSkel, NULL, this->jointTable, this->morphTable, 17);
     EnRu1_InitColliders(&this->actor, play);
-    switch (func_80AEADF0(this)) {
+    switch (EnRu1_GetSwitchFlag(this)) {  // was func_80AEADF0 [LLM:HIGH]
         case 0:
             EnRu1_InitInBossRoom(this, play);
             break;
@@ -2442,7 +2443,7 @@ void EnRu1_Init(Actor* thisx, PlayState* play) {
         default:
             Actor_Kill(&this->actor);
             // "Relevant arge_data = %d unacceptable"
-            osSyncPrintf("該当 arge_data = %d 無し\n", func_80AEADF0(this));
+            osSyncPrintf("該当 arge_data = %d 無し\n", EnRu1_GetSwitchFlag(this));  // was func_80AEADF0 [LLM:HIGH]
             break;
     }
 }
