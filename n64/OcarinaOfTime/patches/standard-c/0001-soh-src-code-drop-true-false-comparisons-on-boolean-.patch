From b308be45d59c334be46aab3b6063f02734a336c7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 22 Sep 2026 16:30:51 +0000
Subject: [PATCH 01/36] soh/src/code: drop `== true` / `!= false` comparisons
 on boolean-valued expressions
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Comparing a value that is already 0 or 1 against true/false is a MIPS-era
habit; C tests the value. This patch covers only the 4 file(s) in
soh/src/code where every rewritten operand is a bitfield, a `u8`, a comparison
result or a local the compiler already knows to be 0/1 — which is why the
generated code is unchanged. Sites whose operand is a plain `s32` field or
an `s32` function result compared with 1 are deliberately left for a
separate patch: they are behaviour-preserving only by the (verified)
invariant that the value is only ever 0/1, and their codegen changes
(cmp $1 -> test).

Verified: every file compiles to byte-identical assembly before and after
with the port's own flags (asmdiff over compile_commands.json).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 soh/src/code/audio_heap.c      | 4 ++--
 soh/src/code/audio_playback.c  | 2 +-
 soh/src/code/audio_synthesis.c | 4 ++--
 soh/src/code/code_800430A0.c   | 2 +-
 4 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/soh/src/code/audio_heap.c b/soh/src/code/audio_heap.c
index a6f2dae1e..f0d1afb44 100644
--- a/soh/src/code/audio_heap.c
+++ b/soh/src/code/audio_heap.c
@@ -1109,7 +1109,7 @@ SampleCacheEntry* AudioHeap_AllocTemporarySampleCacheEntry(size_t size) {
     index = -1;
     for (i = 0; i < gAudioContext.preloadSampleStackTop; i++) {
         preload = &gAudioContext.preloadSampleStack[i];
-        if (preload->isFree == false) {
+        if (!preload->isFree) {
             start = preload->ramAddr;
             end = preload->ramAddr + preload->sample->size - 1;
 
@@ -1126,7 +1126,7 @@ SampleCacheEntry* AudioHeap_AllocTemporarySampleCacheEntry(size_t size) {
     }
 
     for (i = 0; i < pool->size; i++) {
-        if (pool->entries[i].inUse == false) {
+        if (!pool->entries[i].inUse) {
             continue;
         }
 
diff --git a/soh/src/code/audio_playback.c b/soh/src/code/audio_playback.c
index ce6c5d6f1..f5c3f367a 100644
--- a/soh/src/code/audio_playback.c
+++ b/soh/src/code/audio_playback.c
@@ -152,7 +152,7 @@ void Audio_NoteInit(Note* note) {
 
 extern void aOPUSFree(struct OggOpusFile* opusFile);
 void Audio_NoteDisable(Note* note) {
-    if (note->noteSubEu.bitField0.needsInit == true) {
+    if (note->noteSubEu.bitField0.needsInit) {
         note->noteSubEu.bitField0.needsInit = false;
     }
     note->playbackState.priority = 0;
diff --git a/soh/src/code/audio_synthesis.c b/soh/src/code/audio_synthesis.c
index 7b2db2267..cc8ee8661 100644
--- a/soh/src/code/audio_synthesis.c
+++ b/soh/src/code/audio_synthesis.c
@@ -720,7 +720,7 @@ Acmd* AudioSynth_ProcessNote(s32 noteIndex, NoteSubEu* noteSubEu, NoteSynthesisS
     note = &gAudioContext.notes[noteIndex];
     flags = A_CONTINUE;
 
-    if (noteSubEu->bitField0.needsInit == true) {
+    if (noteSubEu->bitField0.needsInit) {
         flags = A_INIT;
         synthState->restart = 0;
         synthState->samplePosInt = note->unk_BC;
@@ -1025,7 +1025,7 @@ Acmd* AudioSynth_ProcessNote(s32 noteIndex, NoteSubEu* noteSubEu, NoteSynthesisS
     }
 
     flags = A_CONTINUE;
-    if (noteSubEu->bitField0.needsInit == true) {
+    if (noteSubEu->bitField0.needsInit) {
         noteSubEu->bitField0.needsInit = false;
         flags = A_INIT;
     }
diff --git a/soh/src/code/code_800430A0.c b/soh/src/code/code_800430A0.c
index d1ccacc0d..d7b9d4363 100644
--- a/soh/src/code/code_800430A0.c
+++ b/soh/src/code/code_800430A0.c
@@ -77,7 +77,7 @@ s32 func_800433A4(CollisionContext* colCtx, s32 bgId, Actor* actor) {
     s32 result = false;
     DynaPolyActor* dynaActor;
 
-    if (DynaPoly_IsBgIdBgActor(bgId) == false) {
+    if (!DynaPoly_IsBgIdBgActor(bgId)) {
         return false;
     }
 

