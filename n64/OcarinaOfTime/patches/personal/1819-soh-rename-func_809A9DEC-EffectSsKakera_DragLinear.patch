From 3b32cee8a267b04275a7865ddf686f7744d61660 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:47:00 +0000
Subject: [PATCH 1819/3799] soh: rename func_809A9DEC ->
 EffectSsKakera_DragLinear

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: falls off as the threshold over the distance once the distance passes the threshold.
Defined in soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c  | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
index 30a159832..6b5fce858 100644
--- a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
+++ b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
@@ -201,7 +201,8 @@ static f32 sDragThresholds[] = {  // was D_809AA530 [LLM:HIGH]
     1.0f, 100.0f, 40.0f, 5.0f, 100.0f, 40.0f, 5.0f, 100.0f, 40.0f, 5.0f,
 };
 
-f32 func_809A9DEC(f32 arg0, s32 arg1) {
+// LLM generated name (HIGH), was func_809A9DEC: falls off as the threshold over the distance once the distance passes the threshold.
+f32 EffectSsKakera_DragLinear(f32 arg0, s32 arg1) {
     if (sDragThresholds[arg1] < arg0) {  // was D_809AA530 [LLM:HIGH]
         return sDragThresholds[arg1] / arg0;  // was D_809AA530 [LLM:HIGH]
     } else {
@@ -282,7 +283,7 @@ s32 func_809A9F4C(EffectSs* this, Vec3f* diff, f32 dist) {
 
 s32 func_809A9FD8(EffectSs* this, Vec3f* diff, f32 dist) {
     static f32 (*D_809AA588[])(f32 dist, s32 arg1) = {
-        EffectSsKakera_DragNone, func_809A9DEC, func_809A9DEC, func_809A9DEC, func_809A9E28,  // was func_809A9DD8 [LLM:HIGH]
+        EffectSsKakera_DragNone, EffectSsKakera_DragLinear, EffectSsKakera_DragLinear, EffectSsKakera_DragLinear, func_809A9E28,  // was func_809A9DD8 [LLM:HIGH]
         func_809A9E28, func_809A9E28, func_809A9E68, func_809A9E68, func_809A9E68,
     };
     f32 temp_f0;
