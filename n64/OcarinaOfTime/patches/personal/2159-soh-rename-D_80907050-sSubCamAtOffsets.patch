From db1c92771d9fe9c0ee4a10ce33a8607dbb4d8599 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:15:35 +0000
Subject: [PATCH 2159/3799] soh: rename D_80907050 -> sSubCamAtOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the matching at offsets for the same sub-camera steps
Defined in soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c     | 6 +++---
 .../overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c    | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
index a762a3d3c..079365052 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -1760,9 +1760,9 @@ void func_8090120C(BossGanon2* this, PlayState* play) {
                 this->subCamEye.x = sSubCamEyeOffsets[phi_a1].x + (player->actor.world.pos.x - 50.0f);  // was D_8090702C [LLM:HIGH]
                 this->subCamEye.y = sSubCamEyeOffsets[phi_a1].y + (player->actor.world.pos.y + 50.0f);  // was D_8090702C [LLM:HIGH]
                 this->subCamEye.z = sSubCamEyeOffsets[phi_a1].z + (player->actor.world.pos.z + 40.0f);  // was D_8090702C [LLM:HIGH]
-                this->subCamAt.x = D_80907050[phi_a1].x + player->actor.world.pos.x;
-                this->subCamAt.y = D_80907050[phi_a1].y + (player->actor.world.pos.y + 40.0f);
-                this->subCamAt.z = D_80907050[phi_a1].z + player->actor.world.pos.z;
+                this->subCamAt.x = sSubCamAtOffsets[phi_a1].x + player->actor.world.pos.x;  // was D_80907050 [LLM:HIGH]
+                this->subCamAt.y = sSubCamAtOffsets[phi_a1].y + (player->actor.world.pos.y + 40.0f);  // was D_80907050 [LLM:HIGH]
+                this->subCamAt.z = sSubCamAtOffsets[phi_a1].z + player->actor.world.pos.z;  // was D_80907050 [LLM:HIGH]
             }
             if (this->csTimer > 80) {
                 Audio_QueueSeqCmd(0x1 << 28 | SEQ_PLAYER_BGM_MAIN << 24 | 0x100FF);
diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
index 2bb6a108f..4919fb2b2 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
@@ -248,7 +248,8 @@ static Vec3f sSubCamEyeOffsets[] = {  // was D_8090702C [LLM:HIGH]
     { 70.0f, -30.0f, 10.0f },
 };
 
-static Vec3f D_80907050[] = {
+// LLM generated name (HIGH), was D_80907050: the matching at offsets for the same sub-camera steps
+static Vec3f sSubCamAtOffsets[] = {  // was D_80907050 [LLM:HIGH]
     { -20.0f, 0.0f, 0.0f },
     { -15.0f, 0.0f, 10.0f },
     { -16.0f, -12.0f, 40.0f },
