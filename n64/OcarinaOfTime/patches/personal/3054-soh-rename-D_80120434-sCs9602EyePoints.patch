From dcadbff9b287f5c6d8ea2f6581e1ad7bb32c30f7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:36 +0000
Subject: [PATCH 3054/3799] soh: rename D_80120434 -> sCs9602EyePoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the eye points for 9602, which shares 9601's at points
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 4 ++--
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 1a515a584..a5b357785 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -379,8 +379,8 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Play_CameraChangeSetting(play, CAM_ID_MAIN, mainCam->prevSetting);
             if (GameInteractor_Should(VB_CRAWL_SPEED_EXIT_CS, true, csCam, csId, sCs9601Flags, sCs9601Duration, sCs9601AtPoints,  // was D_80120308 [LLM:HIGH]
-                                      D_80120434)) {
-                OnePointCutscene_SetCsCamPoints(csCam, sCs9601Flags | 0x1000, sCs9601Duration, sCs9601AtPoints, D_80120434);  // was D_80120308 [LLM:HIGH]
+                                      sCs9602EyePoints)) {  // was D_80120434 [LLM:HIGH]
+                OnePointCutscene_SetCsCamPoints(csCam, sCs9601Flags | 0x1000, sCs9601Duration, sCs9601AtPoints, sCs9602EyePoints);  // was D_80120308 [LLM:HIGH]
             }
             break;
         case 4175:
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 069d66ffc..b6c189fa9 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -56,7 +56,8 @@ static s16 sCs9601PointCount = 9;  // was D_80120428 [LLM:HIGH]
 static s16 sCs9601Duration = 90;  // was D_8012042C [LLM:HIGH]
 // LLM generated name (HIGH), was D_80120430: the flags argument for 9601 and 9602, ORed with 0x1000 at the call
 static s16 sCs9601Flags = 1;  // was D_80120430 [LLM:HIGH]
-static CutsceneCameraPoint D_80120434[10] = {
+// LLM generated name (HIGH), was D_80120434: the eye points for 9602, which shares 9601's at points
+static CutsceneCameraPoint sCs9602EyePoints[10] = {  // was D_80120434 [LLM:HIGH]
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 9, -45 } },   { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 9, -45 } },
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 8, -50 } },   { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 17, -58 } },
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 21, -78 } },  { CS_CMD_CONTINUE, 0, 0, 60.0f, { 0, 46, -109 } },
-- 
2.55.0

