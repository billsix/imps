From 31d2b6f49c0cd0057d101171c9d22b712f20bc9f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:36 +0000
Subject: [PATCH 3056/3799] soh: rename D_801205B4 -> sCs3400EyePoints

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the eye points for 3400
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 6 +++---
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index 456036f79..9a86b4506 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -15,7 +15,7 @@ static s32 sPrevFrameCs1100 = -4096;
     F(sCs3050AtPoints)                                   \
     F(sCs3050EyePoints)                                   \
     F(sCs3400AtPoints)                                   \
-    F(D_801205B4)                                   \
+    F(sCs3400EyePoints)                                   \
     F(D_801208EC)                                   \
     F(D_80120964)                                   \
     F(D_801209B4)                                   \
@@ -691,8 +691,8 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
         case 3400:
             Play_CameraChangeSetting(play, camIdx, CAM_SET_CS_3);
             Player_SetCsAction(play, &player->actor, 8);
-            OnePointCutscene_SetCsCamPoints(csCam, D_8012069C | 0x2000, D_80120698, sCs3400AtPoints, D_801205B4);  // was D_801204D4 [LLM:HIGH]
-            OnePointCutscene_Vec3sToVec3f(&mainCam->eye, &D_801205B4[D_80120694 - 2].pos);
+            OnePointCutscene_SetCsCamPoints(csCam, D_8012069C | 0x2000, D_80120698, sCs3400AtPoints, sCs3400EyePoints);  // was D_801204D4 [LLM:HIGH]
+            OnePointCutscene_Vec3sToVec3f(&mainCam->eye, &sCs3400EyePoints[D_80120694 - 2].pos);  // was D_801205B4 [LLM:HIGH]
             OnePointCutscene_Vec3sToVec3f(&mainCam->at, &sCs3400AtPoints[D_80120694 - 2].pos);  // was D_801204D4 [LLM:HIGH]
 
             i = Quake_Add(csCam, 1);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index e3b9aeae8..6d831859a 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -82,7 +82,8 @@ static CutsceneCameraPoint sCs3400AtPoints[14] = {  // was D_801204D4 [LLM:HIGH]
     { CS_CMD_STOP, 6, 30, 85.199936f, { 25, 127, -950 } },
     { CS_CMD_STOP, 0, 30, 85.199936f, { 25, 127, -950 } },
 };
-static CutsceneCameraPoint D_801205B4[14] = {
+// LLM generated name (HIGH), was D_801205B4: the eye points for 3400
+static CutsceneCameraPoint sCs3400EyePoints[14] = {  // was D_801205B4 [LLM:HIGH]
     { CS_CMD_CONTINUE, 0, 0, 60.0f, { -225, 785, -242 } },
     { CS_CMD_CONTINUE, -21, 0, 80.600006f, { -245, 784, -242 } },
     { CS_CMD_CONTINUE, -21, 0, 80.600006f, { -288, 485, -379 } },
