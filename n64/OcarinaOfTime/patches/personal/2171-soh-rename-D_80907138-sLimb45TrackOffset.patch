+static Vec3f sLimb45TrackOffset = { 0.0f, 0.0f, 0.0f };  // was D_80907138 [LLM:HIGH]
 
 static s8 D_80907144[] = {
     0xFF, 0xFF, 0x01, 0xFF, 0x03, 0x04, 0x05, 0xFF, 0x06, 0x07, 0x08, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
