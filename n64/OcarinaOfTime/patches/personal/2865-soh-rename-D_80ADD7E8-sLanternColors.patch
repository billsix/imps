From ae1c8745b1a735020e38f26059d4d9cf214a0f6e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:53:59 +0000
Subject: [PATCH 2865/3799] soh: rename D_80ADD7E8 -> sLanternColors

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the four sisters' lantern colours
Defined in soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
index 3c71b39c8..8e9a3fffc 100644
--- a/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
+++ b/soh/src/overlays/actors/ovl_En_Po_Sisters/z_en_po_sisters.c
@@ -207,7 +207,8 @@ static Gfx* sFaceDLists[4] = {  // was D_80ADD7D8 [LLM:HIGH]
     gPoSistersAmyFaceDL,
 };
 
-static Color_RGBA8 D_80ADD7E8[4] = {
+// LLM generated name (HIGH), was D_80ADD7E8: the four sisters' lantern colours
+static Color_RGBA8 sLanternColors[4] = {  // was D_80ADD7E8 [LLM:HIGH]
     { 80, 0, 100, 0 },
     { 80, 15, 0, 0 },
     { 0, 70, 50, 0 },
@@ -1359,7 +1360,7 @@ s32 EnPoSisters_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Ve
         gDPPipeSync((*gfxP)++);
         gDPSetEnvColor((*gfxP)++, this->unk_22E.r, this->unk_22E.g, this->unk_22E.b, this->unk_22E.a);
     } else if (limbIndex == 11) {
-        color = &D_80ADD7E8[this->unk_194];
+        color = &sLanternColors[this->unk_194];  // was D_80ADD7E8 [LLM:HIGH]
         gDPPipeSync((*gfxP)++);
         gDPSetEnvColor((*gfxP)++, color->r, color->g, color->b, this->unk_22E.a);
     }
