Subject: [PATCH 2434/3799] soh: rename func_80ADEF38 -> EnPoh_RegularAppear

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: fades the ordinary poe in over its appear animation, the counterpart of EnPoh_ComposerAppear
Defined in soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
index d955a8221..0533c6185 100644
--- a/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
+++ b/soh/src/overlays/actors/ovl_En_Poh/z_en_poh.c
@@ -32,7 +32,8 @@ void EnPoh_Attack(EnPoh* this, PlayState* play);
 void EnPoh_Damage(EnPoh* this, PlayState* play);  // was func_80ADEECC [LLM:HIGH]
 void func_80ADF894(EnPoh* this, PlayState* play);
 void EnPoh_ComposerAppear(EnPoh* this, PlayState* play);
-void func_80ADEF38(EnPoh* this, PlayState* play);
+// LLM generated name (HIGH), was func_80ADEF38: fades the ordinary poe in over its appear animation, the counterpart of EnPoh_ComposerAppear
+void EnPoh_RegularAppear(EnPoh* this, PlayState* play);  // was func_80ADEF38 [LLM:HIGH]
 void func_80ADF15C(EnPoh* this, PlayState* play);
 void func_80ADF574(EnPoh* this, PlayState* play);
 void func_80ADF5E0(EnPoh* this, PlayState* play);
@@ -329,7 +330,7 @@ void EnPoh_SetupInitialAction(EnPoh* this) {
     this->actor.flags &= ~ACTOR_FLAG_ATTENTION_ENABLED;
     if (this->infoIdx == EN_POH_INFO_NORMAL) {
         Animation_PlayOnceSetSpeed(&this->skelAnime, &gPoeAppearAnim, 0.0f);
-        this->actionFunc = func_80ADEF38;
+        this->actionFunc = EnPoh_RegularAppear;  // was func_80ADEF38 [LLM:HIGH]
     } else {
         Animation_PlayOnceSetSpeed(&this->skelAnime, &gPoeComposerAppearAnim, 1.0f);
         this->actor.world.pos.y = this->actor.home.pos.y + 20.0f;
@@ -593,7 +594,7 @@ void EnPoh_Damage(EnPoh* this, PlayState* play) {
     }
 }
 
-void func_80ADEF38(EnPoh* this, PlayState* play) {
+void EnPoh_RegularAppear(EnPoh* this, PlayState* play) {
     if (SkelAnime_Update(&this->skelAnime)) {
         this->lightColor.a = 255;
         this->visibilityTimer = Rand_S16Offset(700, 300);
@@ -897,7 +898,7 @@ void func_80AE032C(EnPoh* this, PlayState* play) {
 }
 
 void EnPoh_UpdateVisibility(EnPoh* this) {
-    if (this->actionFunc != EnPoh_Appear && this->actionFunc != EnPoh_Disappear && this->actionFunc != func_80ADEF38 &&
+    if (this->actionFunc != EnPoh_Appear && this->actionFunc != EnPoh_Disappear && this->actionFunc != EnPoh_RegularAppear &&  // was func_80ADEF38 [LLM:HIGH]
         this->actionFunc != EnPoh_ComposerAppear) {
         if (this->visibilityTimer != 0) {
             this->visibilityTimer--;
@@ -988,7 +989,7 @@ void func_80AE067C(EnPoh* this) {
 void func_80AE089C(EnPoh* this) {
     f32 rand;
 
-    if ((this->actionFunc == func_80ADEF38 || this->actionFunc == EnPoh_ComposerAppear) &&
+    if ((this->actionFunc == EnPoh_RegularAppear || this->actionFunc == EnPoh_ComposerAppear) &&  // was func_80ADEF38 [LLM:HIGH]
         this->skelAnime.curFrame < 12.0f) {
         this->envColor.r = this->envColor.g = this->envColor.b = (s16)(this->skelAnime.curFrame * 16.66f) + 55;
         this->envColor.a = this->skelAnime.curFrame * (100.0f / 6.0f);
