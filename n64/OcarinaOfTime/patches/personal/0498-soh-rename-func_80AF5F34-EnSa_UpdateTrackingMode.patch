+void EnSa_UpdateTrackingMode(EnSa* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
     s16 trackingMode = NPC_TRACKING_PLAYER_AUTO_TURN;
 
@@ -774,7 +775,7 @@ void EnSa_Update(Actor* thisx, PlayState* play) {
