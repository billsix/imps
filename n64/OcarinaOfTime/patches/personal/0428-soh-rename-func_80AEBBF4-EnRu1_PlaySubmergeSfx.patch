+void EnRu1_PlaySubmergeSfx(EnRu1* this) {
     if (Animation_OnFrame(&this->skelAnime, 8.0f)) {
         Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_PL_SUBMERGE);
     }
@@ -752,7 +753,7 @@ void func_80AEC1D4(EnRu1* this, PlayState* play) {
