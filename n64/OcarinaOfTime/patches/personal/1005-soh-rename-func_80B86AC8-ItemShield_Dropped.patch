From 863aa5a6336259b4dbf3ccd529e2085ab6dc29b3 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:35:18 +0000
Subject: [PATCH 1005/3799] soh: rename func_80B86AC8 -> ItemShield_Dropped

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: after the shield is knocked loose: falls under gravity, keeps offering GI_SHIELD_DEKU, blinks for the last 60 frames of its timer and then despawns.
Defined in soh/src/overlays/actors/ovl_Item_Shield/z_item_shield.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Item_Shield/z_item_shield.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Item_Shield/z_item_shield.c b/soh/src/overlays/actors/ovl_Item_Shield/z_item_shield.c
index 4fbe8a3eb..6d778eab8 100644
--- a/soh/src/overlays/actors/ovl_Item_Shield/z_item_shield.c
+++ b/soh/src/overlays/actors/ovl_Item_Shield/z_item_shield.c
@@ -99,7 +99,8 @@ void ItemShield_Destroy(Actor* thisx, PlayState* play) {
     Collider_DestroyCylinder(play, &this->collider);
 }
 
-void func_80B86AC8(ItemShield* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B86AC8: after the shield is knocked loose: falls under gravity, keeps offering GI_SHIELD_DEKU, blinks for the last 60 frames of its timer and then despawns.
+void ItemShield_Dropped(ItemShield* this, PlayState* play) {
     Actor_MoveXZGravity(&this->actor);
     if (Actor_HasParent(&this->actor, play)) {
         Actor_Kill(&this->actor);
@@ -129,7 +130,7 @@ void func_80B86BC8(ItemShield* this, PlayState* play) {
     }
     Actor_OfferGetItem(&this->actor, play, GI_SHIELD_DEKU, 30.0f, 50.0f);
     if (this->collider.base.acFlags & AC_HIT) {
-        ItemShield_SetupAction(this, func_80B86AC8);
+        ItemShield_SetupAction(this, ItemShield_Dropped);  // was func_80B86AC8 [LLM:HIGH]
         this->actor.velocity.y = 4.0f;
         this->actor.minVelocityY = -4.0f;
         this->actor.gravity = -0.8f;
