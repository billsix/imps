From 01cd4177a91477dd52dd98256f88e1752358f7c2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:12:55 +0000
Subject: [PATCH 2125/3799] soh: rename D_808B90F0 -> sSpawnByAge

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-type, per-age flag read by BgSpot18Obj_ShouldSpawn
Defined in soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c  | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
index 8a47d86d6..818680003 100644
--- a/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
+++ b/soh/src/overlays/actors/ovl_Bg_Spot18_Obj/z_bg_spot18_obj.c
@@ -57,7 +57,8 @@ const ActorInit Bg_Spot18_Obj_InitVars = {
     NULL,
 };
 
-static u8 D_808B90F0[2][2] = { { 0x01, 0x01 }, { 0x01, 0x00 } };
+// LLM generated name (HIGH), was D_808B90F0: per-type, per-age flag read by BgSpot18Obj_ShouldSpawn
+static u8 sSpawnByAge[2][2] = { { 0x01, 0x01 }, { 0x01, 0x00 } };  // was D_808B90F0 [LLM:HIGH]
 
 static f32 D_808B90F4[] = {
     0.1f,
@@ -115,13 +116,13 @@ s32 BgSpot18Obj_ShouldSpawn(BgSpot18Obj* this, PlayState* play) {
         return 0;
     }
 
-    switch (D_808B90F0[this->dyna.actor.params & 0xF][age]) {
+    switch (sSpawnByAge[this->dyna.actor.params & 0xF][age]) {  // was D_808B90F0 [LLM:HIGH]
         case 0:
         case 1:
-            if (D_808B90F0[this->dyna.actor.params & 0xF][age] == 0) {
+            if (sSpawnByAge[this->dyna.actor.params & 0xF][age] == 0) {  // was D_808B90F0 [LLM:HIGH]
                 osSyncPrintf("出現しない Object (0x%04x)\n", this->dyna.actor.params);
             }
-            return D_808B90F0[this->dyna.actor.params & 0xF][age];
+            return sSpawnByAge[this->dyna.actor.params & 0xF][age];  // was D_808B90F0 [LLM:HIGH]
         case 2:
             osSyncPrintf("Error : Obj出現判定が設定されていない(%s %d)(arg_data 0x%04x)\n", __FILE__, __LINE__,
                          this->dyna.actor.params);
-- 
