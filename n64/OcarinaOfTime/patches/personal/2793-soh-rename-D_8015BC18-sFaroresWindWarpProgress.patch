From 037d3e1f2cca59d2b056c7084e00c25de78d8736 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:38 +0000
Subject: [PATCH 2793/3799] soh: rename D_8015BC18 -> sFaroresWindWarpProgress

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: drives the pull toward the warp point once the timer expires; read as progress from how it is stepped to zero
Defined in soh/src/code/z_actor.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 21 +++++++++++----------
 1 file changed, 11 insertions(+), 10 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 5707bc340..89dcee30a 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -2358,7 +2358,8 @@ LightInfo sFaroresWindLight;  // was D_8015BC00 [LLM:HIGH]
 LightNode* D_8015BC10;
 // LLM generated name (HIGH), was D_8015BC14: counts the frames of the Farore's Wind warp effect down
 s32 sFaroresWindTimer;  // was D_8015BC14 [LLM:HIGH]
-f32 D_8015BC18;
+// LLM generated name (GUESS), was D_8015BC18: drives the pull toward the warp point once the timer expires; read as progress from how it is stepped to zero
+f32 sFaroresWindWarpProgress;  // was D_8015BC18 [LLM:GUESS]
 
 // LLM generated name (HIGH), was func_8002FA60: copies the Farore's Wind save data into the top respawn slot and inserts its light
 void Actor_InitFaroresWindPoint(PlayState* play) {
@@ -2390,7 +2391,7 @@ void Actor_InitFaroresWindPoint(PlayState* play) {
 
     D_8015BC10 = LightContext_InsertLight(play, &play->lightCtx, &sFaroresWindLight);  // was D_8015BC00 [LLM:HIGH]
     sFaroresWindTimer = 0;  // was D_8015BC14 [LLM:HIGH]
-    D_8015BC18 = 0.0f;
+    sFaroresWindWarpProgress = 0.0f;  // was D_8015BC18 [LLM:GUESS]
 }
 
 void Actor_DrawFaroresWindPointer(PlayState* play) {
@@ -2411,10 +2412,10 @@ void Actor_DrawFaroresWindPointer(PlayState* play) {
             gSaveContext.respawn[RESPAWN_MODE_TOP].data = ++params;
             ratio = ABS(params) * 0.025f;
             sFaroresWindTimer = 60;  // was D_8015BC14 [LLM:HIGH]
-            D_8015BC18 = 1.0f;
+            sFaroresWindWarpProgress = 1.0f;  // was D_8015BC18 [LLM:GUESS]
         } else if (sFaroresWindTimer) {  // was D_8015BC14 [LLM:HIGH]
             sFaroresWindTimer -= CVarGetInteger(CVAR_ENHANCEMENT("FastFarores"), 0) ? 5 : 1;  // was D_8015BC14 [LLM:HIGH]
-        } else if (D_8015BC18 > 0.0f) {
+        } else if (sFaroresWindWarpProgress > 0.0f) {  // was D_8015BC18 [LLM:GUESS]
             static Vec3f effectVel = { 0.0f, -0.05f, 0.0f };
             static Vec3f effectAccel = { 0.0f, -0.025f, 0.0f };
             Color_RGBA8 effectPrimCol = { 255, 255, 255, 0 };
@@ -2427,7 +2428,7 @@ void Actor_DrawFaroresWindPointer(PlayState* play) {
             }
             Vec3f* curPos = &gSaveContext.respawn[RESPAWN_MODE_TOP].pos;
             Vec3f* nextPos = &gSaveContext.respawn[RESPAWN_MODE_DOWN].pos;
-            f32 prevNum = D_8015BC18;
+            f32 prevNum = sFaroresWindWarpProgress;  // was D_8015BC18 [LLM:GUESS]
             Vec3f dist;
             f32 diff = Math_Vec3f_DistXYZAndStoreDiff(nextPos, curPos, &dist);
             Vec3f effectPos;
@@ -2437,14 +2438,14 @@ void Actor_DrawFaroresWindPointer(PlayState* play) {
             f32 speed;
 
             if (diff < 20.0f) {
-                D_8015BC18 = 0.0f;
+                sFaroresWindWarpProgress = 0.0f;  // was D_8015BC18 [LLM:GUESS]
                 Math_Vec3f_Copy(curPos, nextPos);
             } else {
-                length = diff * (1.0f / D_8015BC18);
+                length = diff * (1.0f / sFaroresWindWarpProgress);  // was D_8015BC18 [LLM:GUESS]
                 speed = 20.0f / length;
                 speed = CLAMP_MIN(speed, 0.05f);
-                Math_StepToF(&D_8015BC18, 0.0f, speed);
-                factor = (diff * (D_8015BC18 / prevNum)) / diff;
+                Math_StepToF(&sFaroresWindWarpProgress, 0.0f, speed);  // was D_8015BC18 [LLM:GUESS]
+                factor = (diff * (sFaroresWindWarpProgress / prevNum)) / diff;  // was D_8015BC18 [LLM:GUESS]
                 curPos->x = nextPos->x + (dist.x * factor);
                 curPos->y = nextPos->y + (dist.y * factor);
                 curPos->z = nextPos->z + (dist.z * factor);
@@ -2461,7 +2462,7 @@ void Actor_DrawFaroresWindPointer(PlayState* play) {
             EffectSsKiraKira_SpawnDispersed(play, &effectPos, &effectVel, &effectAccel, &effectPrimCol, &effectEnvCol,
                                             1000, 16);
 
-            if (D_8015BC18 == 0.0f) {
+            if (sFaroresWindWarpProgress == 0.0f) {  // was D_8015BC18 [LLM:GUESS]
                 gSaveContext.respawn[RESPAWN_MODE_TOP] = gSaveContext.respawn[RESPAWN_MODE_DOWN];
                 gSaveContext.respawn[RESPAWN_MODE_TOP].playerParams = 0x06FF;
                 gSaveContext.respawn[RESPAWN_MODE_TOP].data = 40;
-- 
