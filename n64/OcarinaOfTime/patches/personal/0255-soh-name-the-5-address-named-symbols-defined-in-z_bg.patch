From 5bdf7189c01bef9c62b2c65d043d2c5d0096c509 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:20 +0000
Subject: [PATCH 255/488] soh: name the 5 address-named symbols defined in
 z_bg_hidan_syoku.c

SoH carries the Ocarina of Time decomp, in which several thousand symbols are
still named after their ROM address. This commit names every such symbol DEFINED
IN ONE FILE, so the work can be reviewed a file at a time.

The file names the unit; it does not bound it. Each rename is applied wherever
the symbol occurs -- the declaration in the header, the definition, and every
call site -- so this commit reaches into whatever other files use these symbols
and leaves no dangling reference. It is a pure rename: no behaviour changes, and
the only edits that are not renames are the provenance comments described below.

Two name sources are used, and every name says which it came from:

  * zeldaret/oot -- SoH's decomp IS zeldaret/oot at the same ROM addresses, so
    where oot has already named a symbol, that name is adopted verbatim. The
    definition gets a "Name from zeldaret/oot" comment and every declaration a
    short "// was <addr> [oot]" tag.

  * DEDUCED -- oot leaves a great many symbols address-named too, so those
    names are inferred from the body and its callers, and are marked as OURS
    rather than passed off as upstream. The definition gets
    "LLM generated name (HIGH|GUESS), was <addr>: <reason>" and the short tag
    reads "[LLM:HIGH]" or "[LLM:GUESS]". A GUESS is tagged at every call site
    as well, not only the declaration, so a reader who meets the name anywhere
    knows it is inferred. "git grep '[LLM:'" lists every place the decomp
    leans on an inference.

The justification recorded for each individual name follows, one entry per
symbol, in the order the renames were made. Nothing is summarised away: these
are the per-commit reasons from the unsquashed history, with the boilerplate
that was identical in every one of them hoisted into the text above.

All 5 are defined in soh/src/overlays/actors/ovl_Bg_Hidan_Syoku/z_bg_hidan_syoku.c.

  * func_8088F47C -> BgHidanSyoku_SetupWait
    deduced, confidence HIGH: arms the 60-frame pause, plays the landing sfx
    and installs the waiting action; called at the end of both travel
    directions.

  * func_8088F4B8 -> BgHidanSyoku_WaitForPlayer
    deduced, confidence HIGH: the initial action: starts the 140-frame
    ascent once the room is cleared and the player is standing on the
    platform.

  * func_8088F514 -> BgHidanSyoku_MoveUp
    deduced, confidence HIGH: drives world.pos.y from home minus 540 up to
    home plus 540 over 140 frames on a cosine curve, looping the elevator
    sfx.

  * func_8088F5A0 -> BgHidanSyoku_MoveDown
    deduced, confidence HIGH: the sign-flipped mirror of
    BgHidanSyoku_MoveUp, running the same 140-frame cosine curve downward.

  * func_8088F62C -> BgHidanSyoku_Wait
    deduced, confidence HIGH: holds for the 60-frame pause, then rearms the
    140-frame timer and picks the up or down travel by comparing world.pos.y
    to home.pos.y.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../ovl_Bg_Hidan_Syoku/z_bg_hidan_syoku.c     | 35 +++++++++++--------
 1 file changed, 20 insertions(+), 15 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Hidan_Syoku/z_bg_hidan_syoku.c b/soh/src/overlays/actors/ovl_Bg_Hidan_Syoku/z_bg_hidan_syoku.c
index a535dfec1..6b6f21d4e 100644
--- a/soh/src/overlays/actors/ovl_Bg_Hidan_Syoku/z_bg_hidan_syoku.c
+++ b/soh/src/overlays/actors/ovl_Bg_Hidan_Syoku/z_bg_hidan_syoku.c
@@ -14,9 +14,12 @@ void BgHidanSyoku_Destroy(Actor* thisx, PlayState* play);
 void BgHidanSyoku_Update(Actor* thisx, PlayState* play);
 void BgHidanSyoku_Draw(Actor* thisx, PlayState* play);
 
-void func_8088F4B8(BgHidanSyoku* this, PlayState* play);
-void func_8088F514(BgHidanSyoku* this, PlayState* play);
-void func_8088F62C(BgHidanSyoku* this, PlayState* play);
+// LLM generated name (HIGH), was func_8088F4B8: the initial action: starts the 140-frame ascent once the room is cleared and the player is standing on the platform.
+void BgHidanSyoku_WaitForPlayer(BgHidanSyoku* this, PlayState* play);  // was func_8088F4B8 [LLM:HIGH]
+// LLM generated name (HIGH), was func_8088F514: drives world.pos.y from home minus 540 up to home plus 540 over 140 frames on a cosine curve, looping the elevator sfx.
+void BgHidanSyoku_MoveUp(BgHidanSyoku* this, PlayState* play);  // was func_8088F514 [LLM:HIGH]
+// LLM generated name (HIGH), was func_8088F62C: holds for the 60-frame pause, then rearms the 140-frame timer and picks the up or down travel by comparing world.pos.y to home.pos.y.
+void BgHidanSyoku_Wait(BgHidanSyoku* this, PlayState* play);  // was func_8088F62C [LLM:HIGH]
 
 const ActorInit Bg_Hidan_Syoku_InitVars = {
     ACTOR_BG_HIDAN_SYOKU,
@@ -44,7 +47,7 @@ void BgHidanSyoku_Init(Actor* thisx, PlayState* play) {
     DynaPolyActor_Init(&this->dyna, DPM_PLAYER);
     CollisionHeader_GetVirtual(&gFireTempleFlareDancerPlatformCol, &colHeader);
     this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, &this->dyna.actor, colHeader);
-    this->actionFunc = func_8088F4B8;
+    this->actionFunc = BgHidanSyoku_WaitForPlayer;  // was func_8088F4B8 [LLM:HIGH]
     this->dyna.actor.home.pos.y += 540.0f;
 }
 
@@ -54,53 +57,55 @@ void BgHidanSyoku_Destroy(Actor* thisx, PlayState* play) {
     DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
 }
 
-void func_8088F47C(BgHidanSyoku* this) {
+// LLM generated name (HIGH), was func_8088F47C: arms the 60-frame pause, plays the landing sfx and installs the waiting action; called at the end of both travel directions.
+void BgHidanSyoku_SetupWait(BgHidanSyoku* this) {
     this->timer = 60;
     Audio_PlayActorSound2(&this->dyna.actor, NA_SE_EV_BLOCK_BOUND);
-    this->actionFunc = func_8088F62C;
+    this->actionFunc = BgHidanSyoku_Wait;  // was func_8088F62C [LLM:HIGH]
 }
 
-void func_8088F4B8(BgHidanSyoku* this, PlayState* play) {
+void BgHidanSyoku_WaitForPlayer(BgHidanSyoku* this, PlayState* play) {
     if (Flags_GetClear(play, this->dyna.actor.room) && DynaPolyActor_IsPlayerOnTop(&this->dyna)) {
         this->timer = 140;
-        this->actionFunc = func_8088F514;
+        this->actionFunc = BgHidanSyoku_MoveUp;  // was func_8088F514 [LLM:HIGH]
     }
 }
 
-void func_8088F514(BgHidanSyoku* this, PlayState* play) {
+void BgHidanSyoku_MoveUp(BgHidanSyoku* this, PlayState* play) {
     if (this->timer != 0) {
         this->timer--;
     }
     this->dyna.actor.world.pos.y = (cosf(this->timer * (M_PI / 140)) * 540.0f) + this->dyna.actor.home.pos.y;
     if (this->timer == 0) {
-        func_8088F47C(this);
+        BgHidanSyoku_SetupWait(this);  // was func_8088F47C [LLM:HIGH]
     } else {
         Actor_PlaySfx_Flagged(&this->dyna.actor, NA_SE_EV_ELEVATOR_MOVE3 - SFX_FLAG);
     }
 }
 
-void func_8088F5A0(BgHidanSyoku* this, PlayState* play) {
+// LLM generated name (HIGH), was func_8088F5A0: the sign-flipped mirror of BgHidanSyoku_MoveUp, running the same 140-frame cosine curve downward.
+void BgHidanSyoku_MoveDown(BgHidanSyoku* this, PlayState* play) {
     if (this->timer != 0) {
         this->timer--;
     }
     this->dyna.actor.world.pos.y = this->dyna.actor.home.pos.y - (cosf(this->timer * (M_PI / 140)) * 540.0f);
     if (this->timer == 0) {
-        func_8088F47C(this);
+        BgHidanSyoku_SetupWait(this);  // was func_8088F47C [LLM:HIGH]
     } else {
         Actor_PlaySfx_Flagged(&this->dyna.actor, NA_SE_EV_ELEVATOR_MOVE3 - SFX_FLAG);
     }
 }
 
-void func_8088F62C(BgHidanSyoku* this, PlayState* play) {
+void BgHidanSyoku_Wait(BgHidanSyoku* this, PlayState* play) {
     if (this->timer != 0) {
         this->timer--;
     }
     if (this->timer == 0) {
         this->timer = 140;
         if (this->dyna.actor.world.pos.y < this->dyna.actor.home.pos.y) {
-            this->actionFunc = func_8088F514;
+            this->actionFunc = BgHidanSyoku_MoveUp;  // was func_8088F514 [LLM:HIGH]
         } else {
-            this->actionFunc = func_8088F5A0;
+            this->actionFunc = BgHidanSyoku_MoveDown;  // was func_8088F5A0 [LLM:HIGH]
         }
     }
 }
