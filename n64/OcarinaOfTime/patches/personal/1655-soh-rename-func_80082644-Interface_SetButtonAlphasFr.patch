From 66f2e59db73d6828d21c7d2b1065ca52ef69cbab Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:33:25 +0000
Subject: [PATCH 1655/3799] soh: rename func_80082644 ->
 Interface_SetButtonAlphasFromStatus

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: sets each HUD button's alpha to the caller's value, or to the dimmed 70 for any button whose buttonStatus is BTN_DISABLED.
Defined in soh/src/code/z_parameter.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_parameter.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_parameter.c b/soh/src/code/z_parameter.c
index 80ef10011..00b78dd58 100644
--- a/soh/src/code/z_parameter.c
+++ b/soh/src/code/z_parameter.c
@@ -217,7 +217,8 @@ void Interface_ChangeHudVisibilityMode(u16 hudVisibilityMode) {
     }
 }
 
-void func_80082644(PlayState* play, s16 alpha) {
+// LLM generated name (HIGH), was func_80082644: sets each HUD button's alpha to the caller's value, or to the dimmed 70 for any button whose buttonStatus is BTN_DISABLED.
+void Interface_SetButtonAlphasFromStatus(PlayState* play, s16 alpha) {
     InterfaceContext* interfaceCtx = &play->interfaceCtx;
 
     if (gSaveContext.buttonStatus[0] == BTN_DISABLED) {
@@ -315,7 +316,7 @@ void func_8008277C(PlayState* play, s16 maxAlpha, s16 alpha) {
     InterfaceContext* interfaceCtx = &play->interfaceCtx;
 
     if (gSaveContext.forceRisingButtonAlphas != 0) {
-        func_80082644(play, alpha);
+        Interface_SetButtonAlphasFromStatus(play, alpha);  // was func_80082644 [LLM:HIGH]
         return;
     }
 
@@ -571,7 +572,7 @@ void func_80082850(PlayState* play, s16 maxAlpha) {
                 interfaceCtx->minimapAlpha = maxAlpha;
             }
 
-            func_80082644(play, alpha);
+            Interface_SetButtonAlphasFromStatus(play, alpha);  // was func_80082644 [LLM:HIGH]
 
             if (interfaceCtx->healthAlpha != 255) {
                 interfaceCtx->healthAlpha = alpha;
@@ -6594,7 +6595,7 @@ void Interface_Update(PlayState* play) {
             }
 
             osSyncPrintf("case 50 : alpha=%d  alpha1=%d\n", alpha, alpha1);
-            func_80082644(play, alpha1);
+            Interface_SetButtonAlphasFromStatus(play, alpha1);  // was func_80082644 [LLM:HIGH]
 
             if (interfaceCtx->healthAlpha != 255) {
                 interfaceCtx->healthAlpha = alpha1;
-- 
