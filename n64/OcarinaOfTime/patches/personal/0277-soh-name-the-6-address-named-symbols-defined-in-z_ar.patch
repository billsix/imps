-            Matrix_MultVec3f(&D_80865B88, &sp6C);
-            Matrix_MultVec3f(&D_80865B94, &sp60);
+            Matrix_MultVec3f(&sStowedHookOffset, &this->unk_1E8);  // was D_80865B70 [LLM:HIGH]
+            Matrix_MultVec3f(&sStowedWeaponTip, &sp6C);  // was D_80865B88 [LLM:HIGH]
+            Matrix_MultVec3f(&sStowedWeaponBase, &sp60);  // was D_80865B94 [LLM:HIGH]
             this->hookInfo.active = 0;
         } else {
-            Matrix_MultVec3f(&D_80865B7C, &this->unk_1E8);
-            Matrix_MultVec3f(&D_80865BA0, &sp6C);
-            Matrix_MultVec3f(&D_80865BAC, &sp60);
+            Matrix_MultVec3f(&sShotHookOffset, &this->unk_1E8);  // was D_80865B7C [LLM:HIGH]
+            Matrix_MultVec3f(&sShotWeaponTip, &sp6C);  // was D_80865BA0 [LLM:HIGH]
+            Matrix_MultVec3f(&sShotWeaponBase, &sp60);  // was D_80865BAC [LLM:HIGH]
         }
 
         Player_UpdateWeaponInfo(play, &this->collider, &this->hookInfo, &sp6C, &sp60);
