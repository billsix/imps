Subject: [PATCH 2958/3799] soh: rename func_80985310 ->
 DemoIm_SetupUnderground

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: loops the idle animation with the model sunk 10000 units below the floor
Defined in soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
index 127f8bbbe..bfeeb8b66 100644
--- a/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -309,7 +309,8 @@ void DemoIm_ChangeAnim(DemoIm* this, AnimationHeader* animHeaderSeg, u8 animMode
     Animation_Change(&this->skelAnime, animHeaderSeg, playbackSpeed, startFrame, endFrame, animMode, transitionRate);
 }
 
-void func_80985310(DemoIm* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80985310: loops the idle animation with the model sunk 10000 units below the floor
+void DemoIm_SetupUnderground(DemoIm* this, PlayState* play) {
     DemoIm_ChangeAnim(this, &gImpaIdleAnim, ANIMMODE_LOOP, 0.0f, false);
     this->actor.shape.yOffset = -10000.0f;
 }
@@ -1152,7 +1153,7 @@ void DemoIm_Init(Actor* thisx, PlayState* play) {
             func_80987018(this, play);
             break;
         default:
-            func_80985310(this, play);
+            DemoIm_SetupUnderground(this, play);  // was func_80985310 [LLM:HIGH]
     }
 }
 
