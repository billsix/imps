From c1f4b5a8f27746382a8fa34ee5a209ac2946180b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:08 +0000
Subject: [PATCH 1669/3799] soh: rename D_80B2EB28 -> sBeamAimOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the point 1600 units ahead of the eye that gives the beam its direction.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index dd8b7ed83..3012d241b 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -112,7 +112,8 @@ static Vec3f sBeamFarLeftTemplate = { -500.0f, 0.0f, 0.0f };  // was D_80B2EB10
 // LLM generated name (HIGH), was D_80B2EB1C: the local-space point the beam is emitted from, transformed by the eye limb's matrix.
 static Vec3f sBeamOriginOffset = { 0.0f, 0.0f, 0.0f };  // was D_80B2EB1C [LLM:HIGH]
 
-static Vec3f D_80B2EB28 = { 0.0f, 0.0f, 1600.0f };
+// LLM generated name (HIGH), was D_80B2EB28: the point 1600 units ahead of the eye that gives the beam its direction.
+static Vec3f sBeamAimOffset = { 0.0f, 0.0f, 1600.0f };  // was D_80B2EB28 [LLM:HIGH]
 
 static Vec3f D_80B2EB34 = { 1000.0f, 700.0f, 2000.0f };
 
@@ -484,7 +485,7 @@ void EnVm_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
 
     if (limbIndex == 2) {
         Matrix_MultVec3f(&sBeamOriginOffset, &this->beamPos1);  // was D_80B2EB1C [LLM:HIGH]
-        Matrix_MultVec3f(&D_80B2EB28, &this->beamPos2);
+        Matrix_MultVec3f(&sBeamAimOffset, &this->beamPos2);  // was D_80B2EB28 [LLM:HIGH]
 
         if (this->unk_260 >= 3) {
             poly = NULL;
-- 
