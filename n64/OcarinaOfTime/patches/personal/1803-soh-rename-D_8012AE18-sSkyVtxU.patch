From 81fcc6a551903992c086adb056fd54ae488df994 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:17 +0000
Subject: [PATCH 1803/3799] soh: rename D_8012AE18 -> sSkyVtxU

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the five texture U coordinates for an outdoor-skybox face.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 82cd22868..7be8608ee 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -120,7 +120,8 @@ u16 sSkyVtxIndices[0x20] = {  // was D_8012ADD8 [LLM:HIGH]
     0x01, 0x03, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0B, 0x0D, 0x0F, 0x10, 0x11, 0x12, 0x13, 0x15, 0x17,
 };
 
-s16 D_8012AE18[5] = {
+// LLM generated name (HIGH), was D_8012AE18: the five texture U coordinates for an outdoor-skybox face.
+s16 sSkyVtxU[5] = {  // was D_8012AE18 [LLM:HIGH]
     0x0000, 0x07C0, 0x0F80, 0x1740, 0x1F00,
 };
 
@@ -302,7 +303,7 @@ s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp1EC[k] = arg5;
                     sp2B4[k] = temp2;
                     sp250[k] = temp1;
-                    sp188[k] = D_8012AE18[j];
+                    sp188[k] = sSkyVtxU[j];  // was D_8012AE18 [LLM:HIGH]
                     sp124[k] = D_8012AE30[i];
                     temp2 += arg6;
                 }
@@ -320,7 +321,7 @@ s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp2B4[k] = arg3;
                     sp250[k] = temp1;
                     sp1EC[k] = temp2;
-                    sp188[k] = D_8012AE18[j];
+                    sp188[k] = sSkyVtxU[j];  // was D_8012AE18 [LLM:HIGH]
                     sp124[k] = D_8012AE30[i];
                     temp2 += arg6;
                 }
@@ -338,7 +339,7 @@ s32 func_800AE2C0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s3
                     sp250[k] = arg4;
                     sp2B4[k] = temp2;
                     sp1EC[k] = temp1;
-                    sp188[k] = D_8012AE18[j];
+                    sp188[k] = sSkyVtxU[j];  // was D_8012AE18 [LLM:HIGH]
                     sp124[k] = D_8012AE24[i];
                     temp2 += arg6;
                 }
-- 
