From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:40 +0000
Subject: [PATCH 2645/3799] soh: rename D_8082AEC0 -> sPageVtxX4

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the X offsets in slot 4 of the sPageVtxX table, the slot whose widths and heights are the already-named cloud tables
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 7449f182a..bd84c47d7 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2617,7 +2617,8 @@ static s16 sPageVtxX3[] = {  // was D_8082AEBC [LLM:HIGH]
     0x0000,
     0x0000,
 };
-static s16 D_8082AEC0[] = {
+// LLM generated name (HIGH), was D_8082AEC0: the X offsets in slot 4 of the sPageVtxX table, the slot whose widths and heights are the already-named cloud tables
+static s16 sPageVtxX4[] = {  // was D_8082AEC0 [LLM:HIGH]
     0x002F, 0xFFCF, 0xFFEF, 0xFFF1, 0xFFF7, 0x0018, 0x002B, 0x000E, 0x0009, 0x0026, 0x0052,
     0x0047, 0xFFB4, 0xFFA9, 0xFF94, 0xFFCA, 0xFFA3, 0xFFBD, 0xFFC8, 0xFFDF, 0xFFF6, 0x0001,
     0x000E, 0x0018, 0x0023, 0x003A, 0x004A, 0x0059, 0x0000, 0xFFC6, 0x0013, 0x001C,
@@ -2689,7 +2690,7 @@ static s16 D_8082AFF4[] = {
 };
 
 static s16* D_8082B000[] = {
-    sPageVtxX0, sPageVtxX1, sPageVtxX2, sPageVtxX3, D_8082AEC0, D_8082AF00,  // was D_8082AE90 [LLM:HIGH]
+    sPageVtxX0, sPageVtxX1, sPageVtxX2, sPageVtxX3, sPageVtxX4, D_8082AF00,  // was D_8082AE90 [LLM:HIGH]
 };
 
 static s16* D_8082B018[] = {
