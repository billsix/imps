From 734224d15be859ac24e7eb8f7ee976da6c93c697 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:04:39 +0000
Subject: [PATCH 3091/3799] soh: rename D_80121A44 -> sCs3130KeyFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the keyframe set one-point cutscene 3130 installs
Defined in soh/src/code/z_onepointdemo_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_onepointdemo.c        | 2 +-
 soh/src/code/z_onepointdemo_data.inc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_onepointdemo.c b/soh/src/code/z_onepointdemo.c
index c9724f407..c78319b2a 100644
--- a/soh/src/code/z_onepointdemo.c
+++ b/soh/src/code/z_onepointdemo.c
@@ -528,7 +528,7 @@ s32 OnePointCutscene_SetInfo(PlayState* play, s16 camIdx, s16 csId, Actor* actor
             Play_InitCameraDataUsingPlayer(play, camIdx, player, CAM_SET_CS_C);
             break;
         case 3130:
-            csInfo->keyFrames = D_80121A44;
+            csInfo->keyFrames = sCs3130KeyFrames;  // was D_80121A44 [LLM:HIGH]
             csInfo->keyFrameCnt = 12;
 
             Player_SetCsActionWithHaltedActors(play, NULL, 8);
diff --git a/soh/src/code/z_onepointdemo_data.inc b/soh/src/code/z_onepointdemo_data.inc
index 8f509f563..1b016e01d 100644
--- a/soh/src/code/z_onepointdemo_data.inc
+++ b/soh/src/code/z_onepointdemo_data.inc
@@ -363,7 +363,8 @@ static OnePointCsFull sCs3120KeyFrames[3][2] = {  // was D_80121954 [LLM:HIGH]
     },
 };
 
-static OnePointCsFull D_80121A44[12] = {
+// LLM generated name (HIGH), was D_80121A44: the keyframe set one-point cutscene 3130 installs
+static OnePointCsFull sCs3130KeyFrames[12] = {  // was D_80121A44 [LLM:HIGH]
     { 0x4F, 0x05, 0x2121, 10, 0, 60.0f, 1.0f, { 0.0f, -5.0f, 0.0f }, { 0.0f, 0.0f, -80.0f } },
     { 0x42, 0x01, 0x4242, 30, 0, 50.0f, 1.0f, { 0.0f, 45.0f, 0.0f }, { 0.0f, 45.0f, 50.0f } },
     { 0x55, 0xFF, 0x0000, 1, 0, 60.0f, 1.0f, { -1.0f, -1.0f, -1.0f }, { -1.0f, -1.0f, -1.0f } },
-- 
2.55.0

