From 3ff34865dc5257d898dbba39002f7ee82431db8e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 20 Oct 2026 03:48:19 +0000
Subject: [PATCH 490/490] soh: reconcile develop-pin new reference to a renamed
 symbol

Upstream between 9.3.0 (ecd889c2) and develop (41ae6cd3) added a comment in
AudioEditor.cpp that refers to func_800FA0B4 by its old decomp name; the rename
stream renames that symbol everywhere, so carry the rename into this new-at-pin
reference too (comment only, no codegen change).

  * func_800FA0B4 -> Audio_GetActiveSeqId
---
 soh/soh/Enhancements/audio/AudioEditor.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/soh/soh/Enhancements/audio/AudioEditor.cpp b/soh/soh/Enhancements/audio/AudioEditor.cpp
index 5f6c8f701..3dc19b0ef 100644
--- a/soh/soh/Enhancements/audio/AudioEditor.cpp
+++ b/soh/soh/Enhancements/audio/AudioEditor.cpp
@@ -94,7 +94,7 @@ static const std::map<int32_t, const char*> audioRandomizerModes = {
     { RANDOMIZE_ON_FILE_LOAD_SEEDED, "On File Load (Seeded)" },
 };
 
-// The last BGM sequence the game asked for. Unlike func_800FA0B4 this still works when the area's music is set
+// The last BGM sequence the game asked for. Unlike Audio_GetActiveSeqId this still works when the area's music is set
 // to "None", where the sequence player sits idle because nothing loaded.
 static u16 GetCurrentBGM() {
     return gActiveSeqs[SEQ_PLAYER_BGM_MAIN].seqId;
-- 
2.56.0

