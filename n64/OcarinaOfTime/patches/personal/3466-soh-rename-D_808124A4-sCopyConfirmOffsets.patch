From 3d774dc6d43550fbba26ed306143c7030e1dd0ad Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:14 +0000
Subject: [PATCH 3466/3799] soh: rename D_808124A4 -> sCopyConfirmOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the vertical positions the copy confirmation window slides through
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../gamestates/ovl_file_choose/z_file_copy_erase.c        | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c
index eb2da0f39..9e977afec 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c
@@ -316,7 +316,7 @@ void FileChoose_ExitToCopySource2(GameState* thisx) {
  * Update function for `CM_SETUP_COPY_CONFIRM_1`
  */
 void FileChoose_SetupCopyConfirm1(GameState* thisx) {
-    static s16 D_808124A4[] = { -56, -40, -24, 0 };
+    static s16 sCopyConfirmOffsets[] = { -56, -40, -24, 0 };  // was D_808124A4 [LLM:HIGH]
     FileChooseContext* this = (FileChooseContext*)thisx;
     s16 i;
     s16 yStep;
@@ -334,11 +334,11 @@ void FileChoose_SetupCopyConfirm1(GameState* thisx) {
             }
         } else {
             if (this->copyDestFileIndex == i) {
-                yStep = ABS(this->buttonYOffsets[i] - D_808124A4[i]) / this->actionTimer;
+                yStep = ABS(this->buttonYOffsets[i] - sCopyConfirmOffsets[i]) / this->actionTimer;  // was D_808124A4 [LLM:HIGH]
                 this->buttonYOffsets[i] += yStep;
 
-                if (this->buttonYOffsets[i] >= D_808124A4[i]) {
-                    this->buttonYOffsets[i] = D_808124A4[i];
+                if (this->buttonYOffsets[i] >= sCopyConfirmOffsets[i]) {  // was D_808124A4 [LLM:HIGH]
+                    this->buttonYOffsets[i] = sCopyConfirmOffsets[i];  // was D_808124A4 [LLM:HIGH]
                 }
             }
         }
