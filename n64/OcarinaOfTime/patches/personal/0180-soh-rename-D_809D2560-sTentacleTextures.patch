     gSPSegment(POLY_OPA_DISP++, 0x09,
                Gfx_TwoTexScrollEx(play->state.gfxCtx, 0, 0, 0, 16, 16, 1, 0, (play->gameplayFrames * -10) % 128, 32, 32,
                                   0, 0, 0, -10));
