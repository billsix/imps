From 1c7b45bcf7dd5716479bccb0f4187cb4322ec2f2 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:36:07 +0000
Subject: [PATCH 1667/3799] soh: rename D_80B2EB10 -> sBeamFarLeftTemplate

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the matching template for the beam quad's far left corner.
Defined in soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
index efbb3b444..22f137cb9 100644
--- a/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
+++ b/soh/src/overlays/actors/ovl_En_Vm/z_en_vm.c
@@ -106,7 +106,8 @@ static Vec3f sBeamEndTemplate = { 0.0f, 0.0f, 0.0f };  // was D_80B2EAF8 [LLM:HI
 // LLM generated name (HIGH), was D_80B2EB04: the template for the beam quad's far right corner; only its Z is overwritten with the measured beam length.
 static Vec3f sBeamFarRightTemplate = { 500.0f, 0.0f, 0.0f };  // was D_80B2EB04 [LLM:HIGH]
 
-static Vec3f D_80B2EB10 = { -500.0f, 0.0f, 0.0f };
+// LLM generated name (HIGH), was D_80B2EB10: the matching template for the beam quad's far left corner.
+static Vec3f sBeamFarLeftTemplate = { -500.0f, 0.0f, 0.0f };  // was D_80B2EB10 [LLM:HIGH]
 
 static Vec3f D_80B2EB1C = { 0.0f, 0.0f, 0.0f };
 
@@ -473,7 +474,7 @@ void EnVm_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
     EnVm* this = (EnVm*)thisx;
     Vec3f sp80 = sBeamEndTemplate;  // was D_80B2EAF8 [LLM:HIGH]
     Vec3f sp74 = sBeamFarRightTemplate;  // was D_80B2EB04 [LLM:HIGH]
-    Vec3f sp68 = D_80B2EB10;
+    Vec3f sp68 = sBeamFarLeftTemplate;  // was D_80B2EB10 [LLM:HIGH]
     s32 pad;
     Vec3f posResult;
     CollisionPoly* poly;
-- 
