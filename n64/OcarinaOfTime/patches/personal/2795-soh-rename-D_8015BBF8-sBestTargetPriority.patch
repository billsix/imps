From 4c8b6c41a4e2ea94d8329d98083a9908c02ad882 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:38 +0000
Subject: [PATCH 2795/3799] soh: rename D_8015BBF8 -> sBestTargetPriority

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the best targetPriority found so far in that same search
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_actor.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 49ffd65d8..603b1fdbb 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -3582,7 +3582,8 @@ Actor* D_8015BBEC;
 // LLM generated name (HIGH), was D_8015BBF0: the best weighted distance found so far while searching for a Z-target
 f32 sNearestTargetDistSq;  // was D_8015BBF0 [LLM:HIGH]
 f32 sbgmEnemyDistSq;
-s32 D_8015BBF8;
+// LLM generated name (HIGH), was D_8015BBF8: the best targetPriority found so far in that same search
+s32 sBestTargetPriority;  // was D_8015BBF8 [LLM:HIGH]
 s16 D_8015BBFC;
 
 void Attention_FindActorInCategory(PlayState* play, ActorContext* actorCtx, Player* player, u32 actorCategory) {
@@ -3620,9 +3621,9 @@ void Attention_FindActorInCategory(PlayState* play, ActorContext* actorCtx, Play
                                               1, 1, 1, 1, &sp7C) ||
                      SurfaceType_IsIgnoredByProjectiles(&play->colCtx, sp80, sp7C))) {
                     if (actor->targetPriority != 0) {
-                        if (actor->targetPriority < D_8015BBF8) {
+                        if (actor->targetPriority < sBestTargetPriority) {  // was D_8015BBF8 [LLM:HIGH]
                             D_8015BBEC = actor;
-                            D_8015BBF8 = actor->targetPriority;
+                            sBestTargetPriority = actor->targetPriority;  // was D_8015BBF8 [LLM:HIGH]
                         }
                     } else {
                         D_8015BBE8 = actor;
@@ -3647,7 +3648,7 @@ Actor* Attention_FindActor(PlayState* play, ActorContext* actorCtx, Actor** acto
 
     D_8015BBE8 = D_8015BBEC = NULL;
     sNearestTargetDistSq = sbgmEnemyDistSq = FLT_MAX;  // was D_8015BBF0 [LLM:HIGH]
-    D_8015BBF8 = 0x7FFFFFFF;
+    sBestTargetPriority = 0x7FFFFFFF;  // was D_8015BBF8 [LLM:HIGH]
 
     if (!Player_InCsMode(play)) {
         entry = &D_801160A0[0];
