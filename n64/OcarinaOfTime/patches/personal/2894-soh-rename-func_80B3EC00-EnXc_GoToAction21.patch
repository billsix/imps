     this->action = SHEIK_ACTION_20;
 }
 
-void func_80B3EC00(EnXc* this) {
+// LLM generated name (HIGH), was func_80B3EC00: sets action 21
+void EnXc_GoToAction21(EnXc* this) {
     this->action = SHEIK_ACTION_21;
 }
 
@@ -1232,7 +1233,7 @@ void func_80B3ECD8(EnXc* this) {
 }
 
 void EnXc_ActionFunc20(EnXc* this, PlayState* play) {
-    func_80B3EC00(this);
