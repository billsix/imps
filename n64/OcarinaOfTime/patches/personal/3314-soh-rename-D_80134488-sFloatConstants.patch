From 4b8c2715f0d9a245a4f7b97c6b50e1f4c933f5dd Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:27 +0000
Subject: [PATCH 3314/3799] soh: rename D_80134488 -> sFloatConstants

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: an 0x18-byte table holding the bit patterns of zero, positive infinity, negative infinity and negative zero; nothing in the tree reads it
Defined in soh/src/code/system_heap.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/system_heap.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soh/src/code/system_heap.c b/soh/src/code/system_heap.c
index 513a0d415..ccf0578d5 100644
--- a/soh/src/code/system_heap.c
+++ b/soh/src/code/system_heap.c
@@ -15,7 +15,8 @@ void* sInitFuncs = NULL;
 
 char sNew[] = { 'n', 'e', 'w' };
 
-char D_80134488[0x18] = {
+// LLM generated name (GUESS), was D_80134488: an 0x18-byte table holding the bit patterns of zero, positive infinity, negative infinity and negative zero; nothing in the tree reads it
+char sFloatConstants[0x18] = {  // was D_80134488 [LLM:GUESS]
     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x7F, 0x80, 0x00, 0x00,
     0xFF, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x00, 0x00, 0x00,
 };
