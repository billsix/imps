From 45046248d54c42881e41972f38d6989153747e2b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:39 +0000
Subject: [PATCH 2641/3799] soh: rename D_8082AE90 -> sPageVtxX0

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the X offsets in slot 0 of the sPageVtxX table
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index b2b1254c8..a0478ef14 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -2597,7 +2597,8 @@ static u8 sPageVtxColorB[][4] = {
     { 50, 70, 70, 50 },   { 30, 60, 60, 30 }, { 50, 110, 110, 50 },
 };
 
-static s16 D_8082AE90[] = {
+// LLM generated name (HIGH), was D_8082AE90: the X offsets in slot 0 of the sPageVtxX table
+static s16 sPageVtxX0[] = {  // was D_8082AE90 [LLM:HIGH]
     0x0000,
     0x0000,
 };
@@ -2685,7 +2686,7 @@ static s16 D_8082AFF4[] = {
 };
 
 static s16* D_8082B000[] = {
-    D_8082AE90, D_8082AE94, D_8082AE98, D_8082AEBC, D_8082AEC0, D_8082AF00,
+    sPageVtxX0, D_8082AE94, D_8082AE98, D_8082AEBC, D_8082AEC0, D_8082AF00,  // was D_8082AE90 [LLM:HIGH]
 };
 
 static s16* D_8082B018[] = {
