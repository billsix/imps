+void EnRu1_UpdateHeadRotation(EnRu1* this) {
     s32 temp_hi;
     s16* unk_2AC = &this->headRotTimer;
     s16* someY = &this->interactInfo.headRot.y;
@@ -1896,7 +1897,7 @@ void EnRu1_Sitting_SinkingInWater(EnRu1* this, PlayState* play) {
 }
 
 void EnRu1_Sitting_Carried(EnRu1* this, PlayState* play) {
