From 7662b703e763cba08d6180c2c643f354d4cee8e5 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:30:41 +0000
Subject: [PATCH 1611/3799] soh: rename func_80AACB6C ->
 EnMk_WaitForEyedropsTalk

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: waits for the player to accept that conversation.
Defined in soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
index d6c2cefd0..4a9ecc57a 100644
--- a/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
+++ b/soh/src/overlays/actors/ovl_En_Mk/z_en_mk.c
@@ -113,7 +113,8 @@ void func_80AACB14(EnMk* this, PlayState* play) {
     }
 }
 
-void func_80AACB6C(EnMk* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AACB6C: waits for the player to accept that conversation.
+void EnMk_WaitForEyedropsTalk(EnMk* this, PlayState* play) {
     if (Actor_ProcessTalkRequest(&this->actor, play)) {
         this->actionFunc = func_80AACB14;
     }
@@ -127,7 +128,7 @@ void EnMk_TurnBack(EnMk* this, PlayState* play) {
         this->timer--;
         this->actor.shape.rot.y -= 0x800;
     } else {
-        this->actionFunc = func_80AACB6C;
+        this->actionFunc = EnMk_WaitForEyedropsTalk;  // was func_80AACB6C [LLM:HIGH]
         Message_ContinueTextbox(play, 0x4030);
     }
 }
