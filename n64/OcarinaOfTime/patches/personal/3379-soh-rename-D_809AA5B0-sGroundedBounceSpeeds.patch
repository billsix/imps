From 3fb413d8b546787891904896606d4cd67c23794b Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:02 +0000
Subject: [PATCH 3379/3799] soh: rename D_809AA5B0 -> sGroundedBounceSpeeds

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the three speeds EffectSsKakera_UpdateGrounded picks a bounce from
Defined in soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
index cf78a9a7c..ab1cb87ea 100644
--- a/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
+++ b/soh/src/overlays/effects/ovl_Effect_Ss_Kakera/z_eff_ss_kakera.c
@@ -361,7 +361,7 @@ s32 EffectSsKakera_UpdateAccel(EffectSs* this) {
 
 // LLM generated name (HIGH), was func_809AA230: stops the fragment dead once it has fallen below the floor, clearing its velocity, acceleration, gravity and spin.
 void EffectSsKakera_UpdateGrounded(EffectSs* this, PlayState* play) {
-    static f32 D_809AA5B0[] = { 10.0f, 20.0f, 40.0f };
+    static f32 sGroundedBounceSpeeds[] = { 10.0f, 20.0f, 40.0f };  // was D_809AA5B0 [LLM:HIGH]
     Player* player = GET_PLAYER(play);
 
     if (this->rReg8 == 0) {
@@ -387,7 +387,7 @@ void EffectSsKakera_UpdateGrounded(EffectSs* this, PlayState* play) {
                 break;
             case 1:
                 if (this->velocity.y < 0.0f) {
-                    if (BgCheck_SphVsFirstPoly(&play->colCtx, &this->pos, D_809AA5B0[(this->rReg4 >> 2) & 3])) {
+                    if (BgCheck_SphVsFirstPoly(&play->colCtx, &this->pos, sGroundedBounceSpeeds[(this->rReg4 >> 2) & 3])) {  // was D_809AA5B0 [LLM:HIGH]
                         this->velocity.x *= EffectSsKakera_RandCentered(0.9f, 0.2f);  // was func_809A9818 [LLM:HIGH]
                         this->velocity.y *= -0.8f;
                         this->velocity.z *= EffectSsKakera_RandCentered(0.9f, 0.2f);  // was func_809A9818 [LLM:HIGH]
@@ -399,7 +399,7 @@ void EffectSsKakera_UpdateGrounded(EffectSs* this, PlayState* play) {
                 }
                 break;
             case 2:
-                if (BgCheck_SphVsFirstPoly(&play->colCtx, &this->pos, D_809AA5B0[(this->rReg4 >> 2) & 3])) {}
+                if (BgCheck_SphVsFirstPoly(&play->colCtx, &this->pos, sGroundedBounceSpeeds[(this->rReg4 >> 2) & 3])) {}  // was D_809AA5B0 [LLM:HIGH]
                 break;
         }
     }
