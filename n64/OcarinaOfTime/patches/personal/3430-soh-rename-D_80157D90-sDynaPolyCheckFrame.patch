From 70ab9b24d383d477a19c75cca9e751e9e39c41b1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:09 +0000
Subject: [PATCH 3430/3799] soh: rename D_80157D90 -> sDynaPolyCheckFrame

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the gameplay frame the shared dynapoly movement test last ran on, so it runs once a frame for all collectibles
Defined in soh/src/code/z_en_item00.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_en_item00.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_en_item00.c b/soh/src/code/z_en_item00.c
index 3a8415673..260b6dc9b 100644
--- a/soh/src/code/z_en_item00.c
+++ b/soh/src/code/z_en_item00.c
@@ -759,7 +759,7 @@ void EnItem00_Collected(EnItem00* this, PlayState* play) {
 
 // The BSS in the function acted weird in the past. It is matching now but might cause issues in the future
 void EnItem00_Update(Actor* thisx, PlayState* play) {
-    static u32 D_80157D90;
+    static u32 sDynaPolyCheckFrame;  // was D_80157D90 [LLM:HIGH]
     static s16 D_80157D94[1];
     s16* params;
     Actor* dynaActor;
@@ -794,7 +794,7 @@ void EnItem00_Update(Actor* thisx, PlayState* play) {
 
     this->actionFunc(this, play);
     Math_SmoothStepToF(&this->actor.scale.x, this->scale, 0.1f, this->scale * 0.1f, 0.0f);
-    temp = &D_80157D90;
+    temp = &sDynaPolyCheckFrame;  // was D_80157D90 [LLM:HIGH]
 
     this->actor.scale.z = this->actor.scale.x;
     this->actor.scale.y = this->actor.scale.x;
@@ -802,7 +802,7 @@ void EnItem00_Update(Actor* thisx, PlayState* play) {
     if (this->actor.gravity) {
         if (this->actor.bgCheckFlags & 0x0003) {
             if (*temp != play->gameplayFrames) {
-                D_80157D90 = play->gameplayFrames;
+                sDynaPolyCheckFrame = play->gameplayFrames;  // was D_80157D90 [LLM:HIGH]
                 D_80157D94[0] = 0;
                 for (i = 0; i < 50; i++) {
                     if (play->colCtx.dyna.bgActorFlags[i] & 1) {
