From 10a917a2ab27c9c7781b5c7f7d16d7379d102813 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:10:58 +0000
Subject: [PATCH 2054/3799] soh: rename func_80AB7290 -> EnNiw_SetupFlee

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: restarts gCuccoAnim and installs the flee action at speed 4
Defined in soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c b/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c
index a82bec085..a1ea6a1a4 100644
--- a/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c
+++ b/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c
@@ -42,7 +42,8 @@ void EnNiw_SwarmWindUp(EnNiw* this, PlayState* play);  // was func_80AB70F8 [LLM
 void EnNiw_SwarmCall(EnNiw* this, PlayState* play);  // was func_80AB714C [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AB7204: spawns the attacking cuccos and runs at the player
 void EnNiw_SwarmAttack(EnNiw* this, PlayState* play);  // was func_80AB7204 [LLM:HIGH]
-void func_80AB7290(EnNiw* this, PlayState* play);
+// LLM generated name (HIGH), was func_80AB7290: restarts gCuccoAnim and installs the flee action at speed 4
+void EnNiw_SetupFlee(EnNiw* this, PlayState* play);  // was func_80AB7290 [LLM:HIGH]
 void func_80AB7328(EnNiw* this, PlayState* play);
 void EnNiw_FeatherSpawn(EnNiw* this, Vec3f* pos, Vec3f* vel, Vec3f* accel, f32 scale);
 void EnNiw_FeatherUpdate(EnNiw* this, PlayState* play);
@@ -474,7 +475,7 @@ void EnNiw_WaitToBeLifted(EnNiw* this, PlayState* play) {
     if (this->actor.xzDistToPlayer < 30.0f && fabsf(this->actor.world.pos.y - player->actor.world.pos.y) < 5.0f) {
         this->timer6 = 100;
         this->actor.gravity = -2.0f;
-        this->actionFunc = func_80AB7290;
+        this->actionFunc = EnNiw_SetupFlee;  // was func_80AB7290 [LLM:HIGH]
     } else if (Actor_HasParent(&this->actor, play)) {
         this->actor.gravity = -2.0f;
         Audio_PlayActorSound2(&this->actor, NA_SE_EV_CHICKEN_CRY_M);
@@ -698,7 +699,7 @@ void EnNiw_FlutterAfterRelease(EnNiw* this, PlayState* play) {
             this->timer6 = 100;
             this->timer4 = 0;
             this->path = 0;
-            this->actionFunc = func_80AB7290;
+            this->actionFunc = EnNiw_SetupFlee;  // was func_80AB7290 [LLM:HIGH]
             return;
         }
     }
@@ -769,7 +770,7 @@ void EnNiw_Swim(EnNiw* this, PlayState* play) {
             this->timer4 = 0;
             this->actor.velocity.y = 0.0f;
             if (this->unk_2A8 == 0) {
-                this->actionFunc = func_80AB7290;
+                this->actionFunc = EnNiw_SetupFlee;  // was func_80AB7290 [LLM:HIGH]
             } else {
                 this->actionFunc = EnNiw_SwarmAttack;  // was func_80AB7204 [LLM:HIGH]
             }
@@ -845,7 +846,7 @@ void EnNiw_SwarmAttack(EnNiw* this, PlayState* play) {
     }
 }
 
-void func_80AB7290(EnNiw* this, PlayState* play) {
+void EnNiw_SetupFlee(EnNiw* this, PlayState* play) {
     Animation_Change(&this->skelAnime, &gCuccoAnim, 1.0f, 0.0f, Animation_GetLastFrame(&gCuccoAnim), ANIMMODE_LOOP,
                      -10.0f);
     this->unk_2A0 = Rand_ZeroFloat(1.99f);
@@ -895,7 +896,7 @@ void func_80AB747C(EnNiw* this, PlayState* play) {
         Audio_PlayActorSound2(&this->actor, NA_SE_EV_CHICKEN_CRY_M);
         this->timer6 = 100;
         this->path = 0;
-        this->actionFunc = func_80AB7290;
+        this->actionFunc = EnNiw_SetupFlee;  // was func_80AB7290 [LLM:HIGH]
     }
 }
 
