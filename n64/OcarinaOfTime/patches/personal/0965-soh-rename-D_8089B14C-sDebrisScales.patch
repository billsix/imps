From 93eb73250b1b03e5faba5e0417f0e67a6a1cf55c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:30:47 +0000
Subject: [PATCH 0965/3799] soh: rename D_8089B14C -> sDebrisScales

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: feeds the scale parameter (10th argument) of EffectSsKakera_Spawn in BgJyaMegami_SpawnEffect, and also sizes the dust cloud passed to func_80033480.
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c    | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c b/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c
index 41f04c61b..23be17ff4 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Megami/z_bg_jya_megami.c
@@ -79,7 +79,8 @@ static BgJyaMegamiPieceInit sPiecesInit[] = {
     { { 14.759999f, -125.8f, -44.16f }, 0.2f, 0x0320, 0x0258, 20 },
 };
 
-static s16 D_8089B14C[] = {
+// LLM generated name (HIGH), was D_8089B14C: feeds the scale parameter (10th argument) of EffectSsKakera_Spawn in BgJyaMegami_SpawnEffect, and also sizes the dust cloud passed to func_80033480.
+static s16 sDebrisScales[] = {  // was D_8089B14C [LLM:HIGH]
     0x0005, 0x0008, 0x000B, 0x000E, 0x0011, 0x0014, 0x0017, 0x001A,
 };
 
@@ -129,12 +130,12 @@ void BgJyaMegami_SpawnEffect(PlayState* play, Vec3f* pos, Vec3f* velocity, s32 n
     for (i = 0; i < num; i++) {
         s32 idx = ((s16)(Rand_ZeroOne() * 8.0f)) & D_8089B17C[arg4];
         s16 arg5 = ((idx < 5) && (Rand_ZeroOne() < 0.7f)) ? 0x40 : 0x20;
-        EffectSsKakera_Spawn(play, pos, velocity, pos, -90, arg5, D_8089B16C[idx], 4, 0, D_8089B14C[idx], 0, 5,
+        EffectSsKakera_Spawn(play, pos, velocity, pos, -90, arg5, D_8089B16C[idx], 4, 0, sDebrisScales[idx], 0, 5,  // was D_8089B14C [LLM:HIGH]
                              D_8089B15C[idx], KAKERA_COLOR_NONE, OBJECT_JYA_OBJ, gMegami2DL);
         if (Rand_ZeroOne() < 0.45f) {
             Math_Vec3f_Copy(&spB4, pos);
             spB4.z += 25.0f;
-            func_80033480(play, &spB4, 60.0f, 0, D_8089B14C[idx] * 4 + 50, D_8089B14C[idx] * 4 + 70, 1);
+            func_80033480(play, &spB4, 60.0f, 0, sDebrisScales[idx] * 4 + 50, sDebrisScales[idx] * 4 + 70, 1);  // was D_8089B14C [LLM:HIGH]
         }
     }
 }
