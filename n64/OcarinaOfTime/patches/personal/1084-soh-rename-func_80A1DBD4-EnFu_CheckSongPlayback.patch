From bb3599ee60b0a4d42c9defd6241d31fecb81b0fa Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:47:36 +0000
Subject: [PATCH 1084/3799] soh: rename func_80A1DBD4 -> EnFu_CheckSongPlayback

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: reads msgCtx.ocarinaMode after the playback prompt; on a correct performance it awards ITEM_SONG_STORMS, starts gSongOfStormsCs and sets the windmill event flag, and otherwise returns to EnFu_WaitAdult.
Defined in soh/src/overlays/actors/ovl_En_Fu/z_en_fu.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Fu/z_en_fu.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Fu/z_en_fu.c b/soh/src/overlays/actors/ovl_En_Fu/z_en_fu.c
index dc3b70129..c842b3276 100644
--- a/soh/src/overlays/actors/ovl_En_Fu/z_en_fu.c
+++ b/soh/src/overlays/actors/ovl_En_Fu/z_en_fu.c
@@ -30,7 +30,8 @@ void EnFu_TeachSong(EnFu* this, PlayState* play);
 void EnFu_WaitForPlayback(EnFu* this, PlayState* play);
 // LLM generated name (HIGH), was func_80A1DBA0: the adult-era conversation state: waits for the textbox to close, then returns to EnFu_WaitAdult.
 void EnFu_TalkAdult(EnFu* this, PlayState* play);  // was func_80A1DBA0 [LLM:HIGH]
-void func_80A1DBD4(EnFu* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A1DBD4: reads msgCtx.ocarinaMode after the playback prompt; on a correct performance it awards ITEM_SONG_STORMS, starts gSongOfStormsCs and sets the windmill event flag, and otherwise returns to EnFu_WaitAdult.
+void EnFu_CheckSongPlayback(EnFu* this, PlayState* play);  // was func_80A1DBD4 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80A1DB60: waits for the Song of Storms cutscene to end, then sets EVENTCHKINF_LEARNED_SONG_OF_STORMS and returns to EnFu_WaitAdult.
 void EnFu_WaitForSongCutscene(EnFu* this, PlayState* play);  // was func_80A1DB60 [LLM:HIGH]
 
@@ -169,7 +170,7 @@ void EnFu_TalkAdult(EnFu* this, PlayState* play) {
     }
 }
 
-void func_80A1DBD4(EnFu* this, PlayState* play) {
+void EnFu_CheckSongPlayback(EnFu* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
 
     if (play->msgCtx.ocarinaMode >= OCARINA_MODE_04) {
@@ -204,7 +205,7 @@ void EnFu_WaitForPlayback(EnFu* this, PlayState* play) {
     // if dialog state is 7, player has played back the song
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_SONG_DEMO_DONE) {
         Message_StartOcarinaSunsSongEnabled(play, OCARINA_ACTION_PLAYBACK_STORMS);
-        this->actionFunc = func_80A1DBD4;
+        this->actionFunc = EnFu_CheckSongPlayback;  // was func_80A1DBD4 [LLM:HIGH]
     }
 }
 
