Date: Mon, 7 Sep 2026 15:02:48 +0000
Subject: [PATCH 0464/3799] soh: rename func_80AEE264 ->
 EnRu1_TalkOfferAccepted

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.87.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index deea39ec0..7cfc9ce75 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1555,7 +1555,8 @@ void EnRu1_UpdateWaterState(EnRu1* this) {
     }
 }
 
-s32 func_80AEE264(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEE264): adopted upstream's name for this address; body verified to match upstream at 0.87. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+s32 EnRu1_TalkOfferAccepted(EnRu1* this, PlayState* play) {
     if (!Actor_ProcessTalkRequest(&this->actor, play)) {
         this->actor.flags |= ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_FRIENDLY;
         if ((Flags_GetInfTable(INFTABLE_143))) {
@@ -1936,7 +1937,7 @@ void func_80AEF2D0(EnRu1* this, PlayState* play) {
     EnRu1_UpdateEyes(this);
     EnRu1_UpdateStandingOC(this, play);
     EnRu1_UpdateBgCheckInfo(this, play);
-    cond = func_80AEE264(this, play);
+    cond = EnRu1_TalkOfferAccepted(this, play);
     func_80AED624(this, play);
     func_80AEF170(this, play, cond);
 }
