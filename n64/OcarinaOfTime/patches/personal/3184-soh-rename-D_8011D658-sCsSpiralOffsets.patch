From ed6f729c4f509cd8b1163d0f50846c149244bb55 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:03 +0000
Subject: [PATCH 3184/3799] soh: rename D_8011D658 -> sCsSpiralOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the spherical offsets the demo 3 spiral cutscene interpolates the eye and at through
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c        | 28 ++++++++++++++--------------
 soh/src/code/z_camera_data.inc |  3 ++-
 2 files changed, 16 insertions(+), 15 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index cd41369ca..40dca0e86 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -5861,18 +5861,18 @@ s32 Camera_Demo3(Camera* camera) {
                 angle += 0x3FFF;
                 anim->yawDir = -1;
             }
-            sp74.x = sp68.x + (D_8011D658[1].r * Math_SinS(angle));
+            sp74.x = sp68.x + (sCsSpiralOffsets[1].r * Math_SinS(angle));  // was D_8011D658 [LLM:HIGH]
             sp74.y = anim->initialAt.y + 5.0f;
-            sp74.z = sp68.z + (D_8011D658[1].r * Math_CosS(angle));
+            sp74.z = sp68.z + (sCsSpiralOffsets[1].r * Math_CosS(angle));  // was D_8011D658 [LLM:HIGH]
             if (Camera_BGCheck(camera, &sp68, &sp74)) {
                 anim->yawDir = -anim->yawDir;
             }
             OLib_Vec3fToVecSphGeo(&atOffset, &D_8011D678[0]);
             atOffset.yaw += camPlayerPosRot->rot.y;
             Camera_Vec3fVecSphGeoAdd(at, &anim->initialAt, &atOffset);
-            eyeOffset.r = D_8011D658[0].r;
-            eyeOffset.pitch = D_8011D658[0].pitch;
-            eyeOffset.yaw = (D_8011D658[0].yaw * anim->yawDir) + camPlayerPosRot->rot.y;
+            eyeOffset.r = sCsSpiralOffsets[0].r;  // was D_8011D658 [LLM:HIGH]
+            eyeOffset.pitch = sCsSpiralOffsets[0].pitch;  // was D_8011D658 [LLM:HIGH]
+            eyeOffset.yaw = (sCsSpiralOffsets[0].yaw * anim->yawDir) + camPlayerPosRot->rot.y;  // was D_8011D658 [LLM:HIGH]
             anim->unk_0C = 1.0f;
             break;
         case 1:
@@ -5886,9 +5886,9 @@ s32 Camera_Demo3(Camera* camera) {
             atOffset.yaw = (atOffset.yaw * anim->yawDir) + camPlayerPosRot->rot.y;
             Camera_Vec3fVecSphGeoAdd(at, &anim->initialAt, &atOffset);
 
-            atOffset.r = F32_LERPIMP(D_8011D658[0].r, D_8011D658[1].r, temp_f0);
-            atOffset.pitch = BINANG_LERPIMP(D_8011D658[0].pitch, D_8011D658[1].pitch, temp_f0);
-            atOffset.yaw = BINANG_LERPIMP(D_8011D658[0].yaw, D_8011D658[1].yaw, temp_f0);
+            atOffset.r = F32_LERPIMP(sCsSpiralOffsets[0].r, sCsSpiralOffsets[1].r, temp_f0);  // was D_8011D658 [LLM:HIGH]
+            atOffset.pitch = BINANG_LERPIMP(sCsSpiralOffsets[0].pitch, sCsSpiralOffsets[1].pitch, temp_f0);  // was D_8011D658 [LLM:HIGH]
+            atOffset.yaw = BINANG_LERPIMP(sCsSpiralOffsets[0].yaw, sCsSpiralOffsets[1].yaw, temp_f0);  // was D_8011D658 [LLM:HIGH]
 
             eyeOffset.r = atOffset.r;
             eyeOffset.pitch = atOffset.pitch;
@@ -5908,9 +5908,9 @@ s32 Camera_Demo3(Camera* camera) {
             atOffset.yaw = (atOffset.yaw * anim->yawDir) + camPlayerPosRot->rot.y;
             Camera_Vec3fVecSphGeoAdd(at, &anim->initialAt, &atOffset);
 
-            atOffset.r = F32_LERPIMP(D_8011D658[1].r, D_8011D658[2].r, temp_f0);
-            atOffset.pitch = BINANG_LERPIMP(D_8011D658[1].pitch, D_8011D658[2].pitch, temp_f0);
-            atOffset.yaw = BINANG_LERPIMP(D_8011D658[1].yaw, D_8011D658[2].yaw, temp_f0);
+            atOffset.r = F32_LERPIMP(sCsSpiralOffsets[1].r, sCsSpiralOffsets[2].r, temp_f0);  // was D_8011D658 [LLM:HIGH]
+            atOffset.pitch = BINANG_LERPIMP(sCsSpiralOffsets[1].pitch, sCsSpiralOffsets[2].pitch, temp_f0);  // was D_8011D658 [LLM:HIGH]
+            atOffset.yaw = BINANG_LERPIMP(sCsSpiralOffsets[1].yaw, sCsSpiralOffsets[2].yaw, temp_f0);  // was D_8011D658 [LLM:HIGH]
 
             eyeOffset.r = atOffset.r;
             eyeOffset.pitch = atOffset.pitch;
@@ -5929,9 +5929,9 @@ s32 Camera_Demo3(Camera* camera) {
             atOffset.yaw = (atOffset.yaw * anim->yawDir) + camPlayerPosRot->rot.y;
             Camera_Vec3fVecSphGeoAdd(at, &anim->initialAt, &atOffset);
 
-            atOffset.r = F32_LERPIMP(D_8011D658[2].r, D_8011D658[3].r, temp_f0);
-            atOffset.pitch = BINANG_LERPIMP(D_8011D658[2].pitch, D_8011D658[3].pitch, temp_f0);
-            atOffset.yaw = BINANG_LERPIMP(D_8011D658[2].yaw, D_8011D658[3].yaw, temp_f0);
+            atOffset.r = F32_LERPIMP(sCsSpiralOffsets[2].r, sCsSpiralOffsets[3].r, temp_f0);  // was D_8011D658 [LLM:HIGH]
+            atOffset.pitch = BINANG_LERPIMP(sCsSpiralOffsets[2].pitch, sCsSpiralOffsets[3].pitch, temp_f0);  // was D_8011D658 [LLM:HIGH]
+            atOffset.yaw = BINANG_LERPIMP(sCsSpiralOffsets[2].yaw, sCsSpiralOffsets[3].yaw, temp_f0);  // was D_8011D658 [LLM:HIGH]
 
             eyeOffset.r = atOffset.r;
             eyeOffset.pitch = atOffset.pitch;
diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index 9af680960..32afb5ae5 100644
--- a/soh/src/code/z_camera_data.inc
+++ b/soh/src/code/z_camera_data.inc
@@ -2262,7 +2262,8 @@ char sCameraFunctionNames[][8] = {
     "SPEC9()", "",        "",        "",        "",        "",
 };
 
-VecSph D_8011D658[] = {
+// LLM generated name (HIGH), was D_8011D658: the spherical offsets the demo 3 spiral cutscene interpolates the eye and at through
+VecSph sCsSpiralOffsets[] = {  // was D_8011D658 [LLM:HIGH]
     { 50.0f, 0xEE3A, 0xD558 },
     { 75.0f, 0x0000, 0x8008 },
     { 80.0f, 0xEE3A, 0x8008 },
