Subject: [PATCH 0460/3799] soh: rename func_80AEDB30 -> EnRu1_UpdateBouncing

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.86.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 8b7060c4e..20bfe8678 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -1379,7 +1379,8 @@ void EnRu1_ResetBgCheckFlags(EnRu1* this, PlayState* play) {
     }
 }
 
-void func_80AEDB30(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEDB30): adopted upstream's name for this address; body verified to match upstream at 0.86. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_UpdateBouncing(EnRu1* this, PlayState* play) {
     DynaPolyActor* dynaPolyActor;
     f32* velocityY;
     f32* speedXZ;
@@ -1484,7 +1485,7 @@ void func_80AEDEF4(EnRu1* this, PlayState* play) {
 }
 
 void func_80AEDFF4(EnRu1* this, PlayState* play) {
-    func_80AEDB30(this, play);
+    EnRu1_UpdateBouncing(this, play);
     func_80AEDEF4(this, play);
     Actor_MoveXZGravity(&this->actor);
 }
