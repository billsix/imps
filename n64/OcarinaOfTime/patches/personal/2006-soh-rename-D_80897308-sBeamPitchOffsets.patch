From 54f3e368c5013cacc97b35945fd56eefd5b3d359 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:08:49 +0000
Subject: [PATCH 2006/3799] soh: rename D_80897308 -> sBeamPitchOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-params X rotation added to the beam direction and to the beam model, all zero in the shipped table
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
index b3fee212a..3b733388d 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
@@ -38,7 +38,8 @@ const ActorInit Bg_Jya_Cobra_InitVars = {
     NULL,
 };
 
-static s16 D_80897308[] = { 0, 0, 0, 0 };
+// LLM generated name (HIGH), was D_80897308: per-params X rotation added to the beam direction and to the beam model, all zero in the shipped table
+static s16 sBeamPitchOffsets[] = { 0, 0, 0, 0 };  // was D_80897308 [LLM:HIGH]
 
 static u8 D_80897310[] = { true, false, true, false };
 
@@ -189,7 +190,7 @@ void BgJyaCobra_UpdateLightBeam(BgJyaCobra* this) {
         mirRay->unLit = 0;
         Math_Vec3f_Copy(&mirRay->sourcePt, &this->unk_180);
         Matrix_RotateY(this->dyna.actor.shape.rot.y * (M_PI / 0x8000), MTXMODE_NEW);
-        Matrix_RotateX(D_80897308[this->dyna.actor.params & 3] * (M_PI / 0x8000), MTXMODE_APPLY);
+        Matrix_RotateX(sBeamPitchOffsets[this->dyna.actor.params & 3] * (M_PI / 0x8000), MTXMODE_APPLY);  // was D_80897308 [LLM:HIGH]
         sp28.x = 0.0f;
         sp28.y = 0.0;
         sp28.z = this->unk_190 * 2800.0f;
@@ -555,7 +556,7 @@ void BgJyaCobra_DrawLightBeam(BgJyaCobra* this, PlayState* play) {
     OPEN_DISPS(play->state.gfxCtx);
     Gfx_SetupDL_25Xlu(play->state.gfxCtx);
 
-    sp44.x = D_80897308[this->dyna.actor.params & 3] + this->dyna.actor.shape.rot.x;
+    sp44.x = sBeamPitchOffsets[this->dyna.actor.params & 3] + this->dyna.actor.shape.rot.x;  // was D_80897308 [LLM:HIGH]
     sp44.y = this->dyna.actor.shape.rot.y;
     sp44.z = this->dyna.actor.shape.rot.z;
     Matrix_SetTranslateRotateYXZ(this->unk_180.x, this->unk_180.y, this->unk_180.z, &sp44);
-- 
