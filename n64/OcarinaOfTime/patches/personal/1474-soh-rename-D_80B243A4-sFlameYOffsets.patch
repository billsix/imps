From 26de60ef5f8c279a5d94a6633555d3b540705d56 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:17 +0000
Subject: [PATCH 1474/3799] soh: rename D_80B243A4 -> sFlameYOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the matching vertical offsets for the same seven particles.
Defined in soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
index 5fad059ad..3935c7a18 100644
--- a/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
+++ b/soh/src/overlays/actors/ovl_En_Tr/z_en_tr.c
@@ -71,7 +71,8 @@ static AnimationHeader* sCastMagicAnims[] = {  // was D_80B24380 [LLM:HIGH]
 // LLM generated name (HIGH), was D_80B24388: the sideways offsets of the seven flame particles, applied along the camera-facing axis so the cluster spreads across the screen.
 static f32 sFlameXOffsets[] = { 0.0f, 20.0f, -30.0f, 20.0f, -20.0f, -20.0f, 30.0f };  // was D_80B24388 [LLM:HIGH]
 
-static f32 D_80B243A4[] = { 0.0f, 30.0f, 0.0f, -30.0f, 30.0f, -30.0f, 0.0f };
+// LLM generated name (HIGH), was D_80B243A4: the matching vertical offsets for the same seven particles.
+static f32 sFlameYOffsets[] = { 0.0f, 30.0f, 0.0f, -30.0f, 30.0f, -30.0f, 0.0f };  // was D_80B243A4 [LLM:HIGH]
 
 // Has to be 1-dimensional to match
 static Color_RGBA8 D_80B243C0[4] = {
@@ -242,7 +243,7 @@ void func_80B23254(EnTr* this, PlayState* play, s32 arg2, f32 arg3, f32 scale) {
     sp58.z -= velocity.z * 10.0f;
 
     pos.x = sp58.x + ((sFlameXOffsets[arg2] * scale) * Math_CosS(yaw));  // was D_80B24388 [LLM:HIGH]
-    pos.y = sp58.y + (D_80B243A4[arg2] * scale);
+    pos.y = sp58.y + (sFlameYOffsets[arg2] * scale);  // was D_80B243A4 [LLM:HIGH]
     pos.z = sp58.z - ((sFlameXOffsets[arg2] * scale) * Math_SinS(yaw));  // was D_80B24388 [LLM:HIGH]
     func_8002829C(play, &pos, &velocity, &accel, primColor, envColor, (s32)(800.0f * scale), (s32)(80.0f * scale));
 }
-- 
