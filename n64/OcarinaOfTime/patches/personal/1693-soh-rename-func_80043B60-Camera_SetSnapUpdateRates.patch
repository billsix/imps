     camera->fovUpdateRate = PCT(OREG(4));
 }
 
-void func_80043B60(Camera* camera) {
+// LLM generated name (HIGH), was func_80043B60: sets every update rate to the same REG value and the three offset rates to 0.001, so the camera snaps rather than easing.
+void Camera_SetSnapUpdateRates(Camera* camera) {
     camera->rUpdateRateInv = OREG(27);
     camera->yawUpdateRateInv = OREG(27);
     camera->pitchUpdateRateInv = OREG(27);
@@ -3631,7 +3632,7 @@ s32 Camera_KeepOn3(Camera* camera) {
 
     if (camera->unk_14C & 8) {
         sCameraInterfaceFlags = 0;
