From 244ea36041b1c9bcac0e18d4b97b906c3e0a67de Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:05:34 +0000
Subject: [PATCH 1946/3799] soh: rename D_80126058 -> sLegIkThighLengthSq

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: SQ(13.04) and SQ(6.95) -- the thigh length in world units, squared, for the IK law of cosines
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index 82192d400..74f9beed9 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1158,7 +1158,8 @@ Vec3f sLegIkThighOffsets[] = {  // was D_80126038 [LLM:HIGH]
 
 // LLM generated name (HIGH), was D_80126050: per-age translation from the shin joint out to the foot (1265 adult, 826 child)
 f32 sLegIkShinLengths[] = { 1265.0f, 826.0f };  // was D_80126050 [LLM:HIGH]
-f32 D_80126058[] = { SQ(13.04f), SQ(6.95f) };
+// LLM generated name (HIGH), was D_80126058: SQ(13.04) and SQ(6.95) -- the thigh length in world units, squared, for the IK law of cosines
+f32 sLegIkThighLengthSq[] = { SQ(13.04f), SQ(6.95f) };  // was D_80126058 [LLM:HIGH]
 f32 D_80126060[] = { 10.019104f, -19.925102f };
 f32 D_80126068[] = { 5.0f, 3.0f };
 
@@ -1193,7 +1194,7 @@ void Player_AdjustLegToFloor(PlayState* play, Player* this, SkelAnime* skelAnime
         (Player_ActionToMagicSpell(this, this->itemAction) < 0)) {
         s32 pad;
 
-        sp7C = D_80126058[gSaveContext.linkAge];
+        sp7C = sLegIkThighLengthSq[gSaveContext.linkAge];  // was D_80126058 [LLM:HIGH]
         sp78 = D_80126060[gSaveContext.linkAge];
         sp74 = D_80126068[gSaveContext.linkAge] - this->unk_6C4;
 
