From 86594524e30d0a3e8b60aa08129fdeccf3bbd18e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:23 +0000
Subject: [PATCH 246/784] soh: rename func_80041EC8 -> SurfaceType_IsSoft

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/code/z_bgcheck.c.
---
 soh/include/functions.h  | 2 +-
 soh/src/code/z_bgcheck.c | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index cb5989357..2280bb3c3 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -689,7 +689,7 @@ s32 SurfaceType_CheckWallFlag1(CollisionContext* colCtx, CollisionPoly* poly, s3
 s32 SurfaceType_CheckWallFlag2(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041E4C [oot]
 s32 SurfaceType_GetFloorProperty2(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041E80 [oot]
 u32 SurfaceType_GetFloorProperty(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041EA4 [oot]
-u32 func_80041EC8(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
+u32 SurfaceType_IsSoft(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);  // was func_80041EC8 [oot]
 u32 SurfaceType_IsHorseBlocked(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
 u32 func_80041F10(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
 u16 SurfaceType_GetSfx(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId);
diff --git a/soh/src/code/z_bgcheck.c b/soh/src/code/z_bgcheck.c
index ed8c672c8..d4876e93f 100644
--- a/soh/src/code/z_bgcheck.c
+++ b/soh/src/code/z_bgcheck.c
@@ -1733,7 +1733,7 @@ f32 BgCheck_RaycastFloorImpl(PlayState* play, CollisionContext* colCtx, u16 xpFl
         yIntersect = yIntersectDyna;
     }
 
-    if (yIntersect != BGCHECK_Y_MIN && func_80041EC8(colCtx, *outPoly, *outBgId)) {
+    if (yIntersect != BGCHECK_Y_MIN && SurfaceType_IsSoft(colCtx, *outPoly, *outBgId)) {
         yIntersect -= 1.0f;
     }
     return yIntersect;
@@ -4079,7 +4079,8 @@ u32 SurfaceType_GetFloorProperty(CollisionContext* colCtx, CollisionPoly* poly,
 /**
  * SurfaceType Is Floor Minus 1
  */
-u32 func_80041EC8(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
+// Name from zeldaret/oot (was func_80041EC8): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_bgcheck.c]
+u32 SurfaceType_IsSoft(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
     return SurfaceType_GetData(colCtx, poly, bgId, 0) >> 30 & 1;
 }
 
-- 
2.55.0

