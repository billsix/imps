     } else {
         Actor_Kill(&this->actor);
@@ -2247,7 +2248,7 @@ void func_80AEFCE8(EnRu1* this, PlayState* play) {
     if (this->unk_28C != NULL) {
         this->action = 42;
         this->drawConfig = 1;
-        func_80AEB0EC(this, 1);
+        EnRu1_SetPlatformCamSetting(this, 1);
     }
 }
 
