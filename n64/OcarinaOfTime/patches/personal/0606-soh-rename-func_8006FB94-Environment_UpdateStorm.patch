From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:11 +0000
Subject: [PATCH 606/784] soh: rename func_8006FB94 -> Environment_UpdateStorm

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/z_kankyo.c.
---
 soh/src/code/z_kankyo.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_kankyo.c b/soh/src/code/z_kankyo.c
index b4b201b5b..60647ac22 100644
--- a/soh/src/code/z_kankyo.c
+++ b/soh/src/code/z_kankyo.c
@@ -572,7 +572,8 @@ f32 Environment_LerpWeightAccelDecel(u16 endFrame, u16 startFrame, u16 curFrame,
     return ret;
 }
 
-void func_8006FB94(EnvironmentContext* envCtx, u8 unused) {
+// Name from zeldaret/oot (was func_8006FB94): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_kankyo.c]
+void Environment_UpdateStorm(EnvironmentContext* envCtx, u8 unused) {
     if (envCtx->gloomySkyMode != 0) {
         switch (envCtx->unk_DE) {
             case 0:
@@ -668,7 +669,7 @@ void Environment_UpdateSkybox(PlayState* play, u8 skyboxId, EnvironmentContext*
             }
         }
 
-        func_8006FB94(envCtx, skyboxBlend);
+        Environment_UpdateStorm(envCtx, skyboxBlend);
 
         if (envCtx->unk_19 >= 3) {
             newSkybox1Index = D_8011FC1C[envCtx->unk_17][i].skybox1Index;
