From 248cb23b75c76c21b984e9f7c99a034867133dca Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:10:58 +0000
Subject: [PATCH 2058/3799] soh: rename D_80AB85E0 -> sCuccoSwarmActive

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: overlay-wide flag set once a cucco has been hit enough times to summon the swarm, and cleared by the reset hook
Defined in soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c b/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c
index a7d661e9b..a786a777a 100644
--- a/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c
+++ b/soh/src/overlays/actors/ovl_En_Niw/z_en_niw.c
@@ -50,7 +50,8 @@ void EnNiw_FeatherSpawn(EnNiw* this, Vec3f* pos, Vec3f* vel, Vec3f* accel, f32 s
 void EnNiw_FeatherUpdate(EnNiw* this, PlayState* play);
 void EnNiw_FeatherDraw(EnNiw* this, PlayState* play);
 
-static s16 D_80AB85E0 = 0;
+// LLM generated name (HIGH), was D_80AB85E0: overlay-wide flag set once a cucco has been hit enough times to summon the swarm, and cleared by the reset hook
+static s16 sCuccoSwarmActive = 0;  // was D_80AB85E0 [LLM:HIGH]
 
 const ActorInit En_Niw_InitVars = {
     ACTOR_EN_NIW,
@@ -90,7 +91,7 @@ static u8 sLowerRiverSpawned = false;
 static u8 sUpperRiverSpawned = false;
 
 #define EN_NIW_SHIP_SAVESTATE_FIELDS(F) \
-    F(D_80AB85E0)                       \
+    F(sCuccoSwarmActive)                       \
     F(sLowerRiverSpawned)               \
     F(sUpperRiverSpawned)
 
@@ -892,7 +893,7 @@ void EnNiw_CheckHit(EnNiw* this, PlayState* play) {
         this->collider.base.acFlags & AC_HIT) {
         this->collider.base.acFlags &= ~AC_HIT;
         this->sfxTimer1 = 30;
-        if (this->unk_2A4 > 0 && D_80AB85E0 == 0) {
+        if (this->unk_2A4 > 0 && sCuccoSwarmActive == 0) {  // was D_80AB85E0 [LLM:HIGH]
             this->unk_2A4--;
         }
         this->unk_2A6 = 1;
@@ -1076,11 +1077,11 @@ void EnNiw_Update(Actor* thisx, PlayState* play) {
         return;
     }
 
-    if (D_80AB85E0 == 0 && this->unk_2A4 <= 0 && thisx->params != 0xD && thisx->params != 0xE && thisx->params != 0xA) {
+    if (sCuccoSwarmActive == 0 && this->unk_2A4 <= 0 && thisx->params != 0xD && thisx->params != 0xE && thisx->params != 0xA) {  // was D_80AB85E0 [LLM:HIGH]
         this->timer6 = 100;
 
         if (thisx->xzDistToPlayer > 10.0f) {
-            D_80AB85E0 = 1;
+            sCuccoSwarmActive = 1;  // was D_80AB85E0 [LLM:HIGH]
             this->timer5 = this->timer4 = this->unk_29E = 0;
             thisx->speedXZ = 0.0f;
             this->unk_2FC = 0.0f;
@@ -1257,7 +1258,7 @@ void EnNiw_FeatherDraw(EnNiw* this, PlayState* play) {
 }
 
 void EnNiw_Reset(void) {
-    D_80AB85E0 = 0;
+    sCuccoSwarmActive = 0;  // was D_80AB85E0 [LLM:HIGH]
     sLowerRiverSpawned = false;
     sUpperRiverSpawned = false;
 }
