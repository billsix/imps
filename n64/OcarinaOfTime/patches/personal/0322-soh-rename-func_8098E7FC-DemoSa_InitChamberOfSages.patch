Subject: [PATCH 0322/3799] soh: rename func_8098E7FC ->
 DemoSa_InitChamberOfSages

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.97.
Defined in soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c.
---
 soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
index 3901a535e..bba6be2f6 100644
--- a/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
+++ b/soh/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c
@@ -218,7 +218,8 @@ void func_8098E76C(DemoSa* this, AnimationHeader* animHeaderSeg, u8 arg2, f32 tr
     Animation_Change(&this->skelAnime, animHeaderSeg, playbackSpeed, unk0, fc, arg2, transitionRate);
 }
 
-void func_8098E7FC(DemoSa* this, PlayState* play) {
+// Name from zeldaret/oot (was func_8098E7FC): adopted upstream's name for this address; body verified to match upstream at 0.97. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Demo_Sa/z_demo_sa.c]
+void DemoSa_InitChamberOfSages(DemoSa* this, PlayState* play) {
     SkelAnime_InitFlex(play, &this->skelAnime, &gSariaSkel, &gSariaWaitArmsToSideAnim, NULL, NULL, 0);
     this->actor.shape.yOffset = -10000.0f;
     DemoSa_SetEyeIndex(this, SARIA_EYE_HALF);
@@ -782,7 +783,7 @@ void DemoSa_Init(Actor* thisx, PlayState* play) {
             func_8098F83C(this, play);
             break;
         default:
-            func_8098E7FC(this, play);
+            DemoSa_InitChamberOfSages(this, play);
     }
 }
 
