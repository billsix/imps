     }
 }
@@ -138,6 +139,6 @@ void BgSpot01Objects2_Update(Actor* thisx, PlayState* play) {
     this->actionFunc(this, play);
 }
 
-void func_808AC4A4(Actor* thisx, PlayState* play) {
