From 244d8cbe5dbea4097b99749f82435567f139912f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:16:13 +0000
Subject: [PATCH 2208/3799] soh: rename D_8097D468 -> sDrawFuncs

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the two draw configs indexed by DemoGo.drawConfig
Defined in soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c b/soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c
index 62e8d94d5..78c794dc6 100644
--- a/soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c
+++ b/soh/src/overlays/actors/ovl_Demo_Go/z_demo_go.c
@@ -43,7 +43,8 @@ static DemoGoActionFunc sActionFuncs[] = {  // was D_8097D44C [LLM:HIGH]
     DemoGo_Action0, DemoGo_Action1, DemoGo_Action2, DemoGo_Action3, DemoGo_Action4, DemoGo_Action5, DemoGo_Action6,  // was func_8097CFDC [LLM:HIGH]
 };
 
-static DemoGoDrawFunc D_8097D468[] = {
+// LLM generated name (HIGH), was D_8097D468: the two draw configs indexed by DemoGo.drawConfig
+static DemoGoDrawFunc sDrawFuncs[] = {  // was D_8097D468 [LLM:HIGH]
     DemoGo_DrawNothing,  // was func_8097D290 [LLM:HIGH]
     DemoGo_DrawSkeleton,  // was func_8097D29C [LLM:HIGH]
 };
@@ -372,9 +373,9 @@ void DemoGo_DrawSkeleton(DemoGo* this, PlayState* play) {
 void DemoGo_Draw(Actor* thisx, PlayState* play) {
     DemoGo* this = (DemoGo*)thisx;
 
-    if (this->drawConfig < 0 || this->drawConfig >= 2 || D_8097D468[this->drawConfig] == NULL) {
+    if (this->drawConfig < 0 || this->drawConfig >= 2 || sDrawFuncs[this->drawConfig] == NULL) {  // was D_8097D468 [LLM:HIGH]
         osSyncPrintf(VT_FGCOL(RED) "描画モードがおかしい!!!!!!!!!!!!!!!!!!!!!!!!!\n" VT_RST);
         return;
     }
-    D_8097D468[this->drawConfig](this, play);
+    sDrawFuncs[this->drawConfig](this, play);  // was D_8097D468 [LLM:HIGH]
 }
