From 82020ba591a58c30df1bf46eb1e6814d1ec6d088 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:28 +0000
Subject: [PATCH 3317/3799] soh: rename D_8012A380 -> sSpot12Textures

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the day and night textures the Gerudo Valley draw config binds
Defined in soh/src/code/z_scene_table.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_scene_table.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_scene_table.c b/soh/src/code/z_scene_table.c
index c8ab87986..d877fdbfa 100644
--- a/soh/src/code/z_scene_table.c
+++ b/soh/src/code/z_scene_table.c
@@ -1386,7 +1386,8 @@ void Scene_DrawConfigDesertColossus(PlayState* play) {
 }
 
 // walls of GF room where they throw you when you get caught
-void* D_8012A380[] = {
+// LLM generated name (HIGH), was D_8012A380: the day and night textures the Gerudo Valley draw config binds
+void* sSpot12Textures[] = {  // was D_8012A380 [LLM:HIGH]
     gSpot12_009678Tex,
     gSpot12_00DE78Tex,
 };
@@ -1398,7 +1399,7 @@ void Scene_DrawConfigSpot12(PlayState* play) {
 
     { s32 pad[2]; }
 
-    gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_8012A380[gSaveContext.nightFlag]));
+    gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(sSpot12Textures[gSaveContext.nightFlag]));  // was D_8012A380 [LLM:HIGH]
 
     CLOSE_DISPS(play->state.gfxCtx);
 }
