@@ -20,7 +20,8 @@ void BgJyaAmishutter_WaitForPlayer(BgJyaAmishutter* this);
 void BgJyaAmishutter_SetupOpen(BgJyaAmishutter* this);  // was func_80893428 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80893438: raises the shutter 100 units above home with the metal-door slide sfx, ending on the stop sfx.
 void BgJyaAmishutter_Open(BgJyaAmishutter* this);  // was func_80893438 [LLM:HIGH]
