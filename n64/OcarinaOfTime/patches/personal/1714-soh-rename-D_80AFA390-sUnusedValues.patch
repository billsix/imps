+++ b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
@@ -94,7 +94,8 @@ static Vec3f sUnusedBlobOffsets[] = {  // was D_80AFA288 [LLM:HIGH]
     { 1.0f, -2.0f, -0.2f }, { 0.0f, -3.0f, -0.5f },
 };
 
-static u32 D_80AFA390[] = { 0, 0 };
+// LLM generated name (HIGH), was D_80AFA390: two zeroed u32 words with no reader anywhere in the tree.
+static u32 sUnusedValues[] = { 0, 0 };  // was D_80AFA390 [LLM:HIGH]
 
 #include "overlays/ovl_En_Sda/ovl_En_Sda.h"
 
