From 30baf876bb38981535ab979ec7b059f1510f561a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:05:34 +0000
Subject: [PATCH 1948/3799] soh: rename D_80126068 -> sLegIkFootHeightOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: per-age height added to the raycast floor Y before the leg is bent onto it
Defined in soh/src/code/z_player_lib.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_player_lib.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_player_lib.c b/soh/src/code/z_player_lib.c
index a4b4eb798..eabd94710 100644
--- a/soh/src/code/z_player_lib.c
+++ b/soh/src/code/z_player_lib.c
@@ -1162,7 +1162,8 @@ f32 sLegIkShinLengths[] = { 1265.0f, 826.0f };  // was D_80126050 [LLM:HIGH]
 f32 sLegIkThighLengthSq[] = { SQ(13.04f), SQ(6.95f) };  // was D_80126058 [LLM:HIGH]
 // LLM generated name (HIGH), was D_80126060: thigh squared minus shin squared per age (13.04^2 - 12.65^2 = 10.019, 6.95^2 - 8.26^2 = -19.925), the constant term of the same law of cosines
 f32 sLegIkLimbLengthSqDiff[] = { 10.019104f, -19.925102f };  // was D_80126060 [LLM:HIGH]
-f32 D_80126068[] = { 5.0f, 3.0f };
+// LLM generated name (HIGH), was D_80126068: per-age height added to the raycast floor Y before the leg is bent onto it
+f32 sLegIkFootHeightOffsets[] = { 5.0f, 3.0f };  // was D_80126068 [LLM:HIGH]
 
 Vec3f D_80126070 = { 0.0f, -300.0f, 0.0f };
 
@@ -1197,7 +1198,7 @@ void Player_AdjustLegToFloor(PlayState* play, Player* this, SkelAnime* skelAnime
 
         sp7C = sLegIkThighLengthSq[gSaveContext.linkAge];  // was D_80126058 [LLM:HIGH]
         sp78 = sLegIkLimbLengthSqDiff[gSaveContext.linkAge];  // was D_80126060 [LLM:HIGH]
-        sp74 = D_80126068[gSaveContext.linkAge] - this->unk_6C4;
+        sp74 = sLegIkFootHeightOffsets[gSaveContext.linkAge] - this->unk_6C4;  // was D_80126068 [LLM:HIGH]
 
         Matrix_Push();
         Matrix_TranslateRotateZYX(pos, rot);
-- 
