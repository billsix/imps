From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:43 +0000
Subject: [PATCH 2674/3799] soh: rename D_8082B138 -> sQuestVtxX

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: X position of each quest status icon
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 945967c0b..41e4d451b 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -3029,7 +3029,8 @@ static s16 sEquipColumnX[] = { -114, 12, 44, 76 };  // was D_8082B12C [LLM:HIGH]
 // LLM generated name (GUESS), was D_8082B134: added to each equipment value to reach its icon index; which icon table it lands in is not established
 static u8 sEquipIconBaseIndices[] = { 1, 5, 9, 13 };  // was D_8082B134 [LLM:GUESS]
 
-static s16 D_8082B138[] = {
+// LLM generated name (HIGH), was D_8082B138: X position of each quest status icon
+static s16 sQuestVtxX[] = {  // was D_8082B138 [LLM:HIGH]
     74,  74,  46,  18,  18,  46,   -108, -90,  -72, -54, -36, -18, -108, -90, -72, -54,
     -36, -18, 20,  46,  72,  -110, -86,  -110, -54, -98, -86, -74, -62,  -50, -38, -26,
     -14, -98, -86, -74, -62, -50,  -38,  -26,  -14, -88, -81, -72, -90,  -83, -74,
@@ -3430,7 +3431,7 @@ void KaleidoScope_InitVertices(PlayState* play, GraphicsContext* gfxCtx) {
         phi_t2_2 = D_8082B1F8[phi_t3];
 
         if ((phi_t3 < 6) || (phi_t3 >= 41)) {
-            pauseCtx->questVtx[phi_t4 + 0].v.ob[0] = pauseCtx->questVtx[phi_t4 + 2].v.ob[0] = D_8082B138[phi_t3];
+            pauseCtx->questVtx[phi_t4 + 0].v.ob[0] = pauseCtx->questVtx[phi_t4 + 2].v.ob[0] = sQuestVtxX[phi_t3];  // was D_8082B138 [LLM:HIGH]
 
             pauseCtx->questVtx[phi_t4 + 1].v.ob[0] = pauseCtx->questVtx[phi_t4 + 3].v.ob[0] =
                 pauseCtx->questVtx[phi_t4 + 0].v.ob[0] + D_8082B1F8[phi_t3];
@@ -3458,7 +3459,7 @@ void KaleidoScope_InitVertices(PlayState* play, GraphicsContext* gfxCtx) {
                 phi_t2_2 = 16;
             }
 
-            pauseCtx->questVtx[phi_t4 + 0].v.ob[0] = pauseCtx->questVtx[phi_t4 + 2].v.ob[0] = D_8082B138[phi_t3] + 2;
+            pauseCtx->questVtx[phi_t4 + 0].v.ob[0] = pauseCtx->questVtx[phi_t4 + 2].v.ob[0] = sQuestVtxX[phi_t3] + 2;  // was D_8082B138 [LLM:HIGH]
 
             pauseCtx->questVtx[phi_t4 + 1].v.ob[0] = pauseCtx->questVtx[phi_t4 + 3].v.ob[0] =
                 pauseCtx->questVtx[phi_t4 + 0].v.ob[0] + phi_t2_2 - 4;
