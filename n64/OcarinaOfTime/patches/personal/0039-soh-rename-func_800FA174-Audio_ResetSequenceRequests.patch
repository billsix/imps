From a4cdf8c77c05075c0f5029bb74b1f5017eea813a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:14 +0000
Subject: [PATCH 039/225] soh: rename func_800FA174 ->
 Audio_ResetSequenceRequests

Name source: zeldaret/oot.
Defined in soh/src/code/audio_seq.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h  | 2 +-
 soh/src/code/audio_seq.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 9aa0e139c..853a1e884 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -2165,7 +2165,7 @@ void Audio_ProcessSeqCmd(u32);
 void Audio_ProcessSeqCmds(void);
 u16 Audio_GetActiveSeqId(u8 a0);  // was func_800FA0B4 [oot]
 s32 Audio_IsSeqCmdNotQueued(u32 arg0, u32 arg1);  // was func_800FA11C [oot]
-void func_800FA174(u8);
+void Audio_ResetSequenceRequests(u8);  // was func_800FA174 [oot]
 void func_800FA18C(u8, u8);
 void Audio_SetVolScale(u8 playerIdx, u8 scaleIdx, u8 targetVol, u8 volFadeTimer);
 void func_800FA3DC(void);
diff --git a/soh/src/code/audio_seq.c b/soh/src/code/audio_seq.c
index bf30feebf..be26d4028 100644
--- a/soh/src/code/audio_seq.c
+++ b/soh/src/code/audio_seq.c
@@ -426,7 +426,8 @@ s32 Audio_IsSeqCmdNotQueued(u32 arg0, u32 arg1) {
     return true;
 }
 
-void func_800FA174(u8 playerIdx) {
+// Name from zeldaret/oot, was func_800FA174: clears the player's pending sequence-request count. [oot: https://github.com/zeldaret/oot/blob/main/src/audio/game/sequence.c]
+void Audio_ResetSequenceRequests(u8 playerIdx) {
     sNumSeqRequests[playerIdx] = 0;
 }
 
