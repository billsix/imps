From f11bf03773d61366accc92f352c992c86c5b0d2c Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:43:39 +0000
Subject: [PATCH 2639/3799] soh: rename D_8082ABCC -> sPageRotateEyeDz

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the matching Z step
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index 4301de81e..8dcaa5dfb 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -944,7 +944,8 @@ static f32 sPageRotateEyeDx[] = {  // was D_8082ABAC [LLM:HIGH]
     -4.0f, 4.0f, 4.0f, 4.0f, 4.0f, -4.0f, -4.0f, -4.0f,
 };
 
-static f32 D_8082ABCC[] = {
+// LLM generated name (HIGH), was D_8082ABCC: the matching Z step
+static f32 sPageRotateEyeDz[] = {  // was D_8082ABCC [LLM:HIGH]
     -4.0f, -4.0f, -4.0f, 4.0f, 4.0f, 4.0f, 4.0f, -4.0f,
 };
 
@@ -2546,7 +2547,7 @@ void KaleidoScope_RotatePageSlow(PlayState* play, Input* input) {
     if (!cond) {
         mode = pauseCtx->mode;
         pauseCtx->eye.x += sPageRotateEyeDx[mode];  // was D_8082ABAC [LLM:HIGH]
-        pauseCtx->eye.z += D_8082ABCC[mode];
+        pauseCtx->eye.z += sPageRotateEyeDz[mode];  // was D_8082ABCC [LLM:HIGH]
 
         if (pauseCtx->unk_1EA < 32) {
             WREG(16) -= WREG(25) / WREG(6);
@@ -3568,7 +3569,7 @@ void KaleidoScope_RotatePageFast(PlayState* play) {
     PauseContext* pauseCtx = &play->pauseCtx;
 
     pauseCtx->eye.x += sPageRotateEyeDx[pauseCtx->mode] * ZREG(46);  // was D_8082ABAC [LLM:HIGH]
-    pauseCtx->eye.z += D_8082ABCC[pauseCtx->mode] * ZREG(46);
+    pauseCtx->eye.z += sPageRotateEyeDz[pauseCtx->mode] * ZREG(46);  // was D_8082ABCC [LLM:HIGH]
     pauseCtx->unk_1EA += 4 * ZREG(46);
 
     if (pauseCtx->unk_1EA == (64 * ZREG(47))) {
-- 
