Subject: [PATCH 2929/3799] soh: rename func_80B40590 ->
 EnXc_SetupNocturneSquint

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: enters the Nocturne init action with the squinting draw
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 8dfdd61e7..88321b511 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -1849,7 +1849,8 @@ void EnXc_DrawTriforce(Actor* thisx, PlayState* play) {
     CLOSE_DISPS(gfxCtx);
 }
 
-void func_80B40590(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B40590: enters the Nocturne init action with the squinting draw
+void EnXc_SetupNocturneSquint(EnXc* this, PlayState* play) {
     this->action = SHEIK_ACTION_NOCTURNE_INIT;
     this->drawMode = SHEIK_DRAW_SQUINT;
 }
@@ -2439,7 +2440,7 @@ void EnXc_Init(Actor* thisx, PlayState* play) {
             EnXc_SetupTriforceIdle(this, play);  // was func_80B3FA08 [LLM:HIGH]
             break;
         case SHEIK_TYPE_5:
-            func_80B40590(this, play);
+            EnXc_SetupNocturneSquint(this, play);  // was func_80B40590 [LLM:HIGH]
             break;
         case SHEIK_TYPE_MINUET:
             EnXc_KillUnlessMinuetPending(this, play);  // was func_80B3CA38 [LLM:HIGH]
