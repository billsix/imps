From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:29:56 +0000
Subject: [PATCH 2454/3799] soh: rename func_80A01F90 -> EnElf_IsFartherThanXZ

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns whether the XZ distance between two points exceeds a radius
Defined in soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c b/soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c
index 175421f6e..29f277835 100644
--- a/soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c
+++ b/soh/src/overlays/actors/ovl_En_Elf/z_en_elf.c
@@ -208,14 +208,15 @@ void EnElf_SetMotionMode(EnElf* this, s32 arg1) {
     }
 }
 
-s32 func_80A01F90(Vec3f* this, Vec3f* arg1, f32 arg2) {
+// LLM generated name (HIGH), was func_80A01F90: returns whether the XZ distance between two points exceeds a radius
+s32 EnElf_IsFartherThanXZ(Vec3f* this, Vec3f* arg1, f32 arg2) {
     return SQ(arg2) < (SQ(arg1->x - this->x) + SQ(arg1->z - this->z));
 }
 
 void func_80A01FE0(EnElf* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
 
-    if (!func_80A01F90(&this->actor.world.pos, &player->actor.world.pos, 30.0f)) {
+    if (!EnElf_IsFartherThanXZ(&this->actor.world.pos, &player->actor.world.pos, 30.0f)) {  // was func_80A01F90 [LLM:HIGH]
         this->unk_2B8 = 0.5f;
     } else {
         this->unk_2B8 = 2.0f;
@@ -235,7 +236,7 @@ void func_80A01FE0(EnElf* this, PlayState* play) {
 void func_80A020A4(EnElf* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
 
-    if (func_80A01F90(&this->actor.world.pos, &player->actor.world.pos, 50.0f)) {
+    if (EnElf_IsFartherThanXZ(&this->actor.world.pos, &player->actor.world.pos, 50.0f)) {  // was func_80A01F90 [LLM:HIGH]
         if (this->unk_2C0 > 0) {
             this->unk_2C0--;
         } else {
@@ -294,7 +295,7 @@ void func_80A0214C(EnElf* this, PlayState* play) {
 }
 
 void func_80A0232C(EnElf* this, PlayState* play) {
-    if (func_80A01F90(&this->unk_28C, &this->actor.world.pos, 100.0f)) {
+    if (EnElf_IsFartherThanXZ(&this->unk_28C, &this->actor.world.pos, 100.0f)) {  // was func_80A01F90 [LLM:HIGH]
         this->unk_2A8 = 0;
         this->unk_2AC = 0x200;
         this->func_2C8 = func_80A0214C;
@@ -632,7 +633,7 @@ void func_80A0329C(EnElf* this, PlayState* play) {
         heightDiff = this->actor.world.pos.y - refActor->actor.world.pos.y;
 
         if ((heightDiff > 0.0f) && (heightDiff < 60.0f)) {
-            if (!func_80A01F90(&this->actor.world.pos, &refActor->actor.world.pos, 10.0f)) {
+            if (!EnElf_IsFartherThanXZ(&this->actor.world.pos, &refActor->actor.world.pos, 10.0f)) {  // was func_80A01F90 [LLM:HIGH]
                 if (GameInteractor_Should(VB_FAIRY_HEAL, true, this)) {
                     Health_ChangeBy(play, 128);
                 }
