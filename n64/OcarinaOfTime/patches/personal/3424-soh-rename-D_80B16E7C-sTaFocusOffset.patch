From af3848d8c55b5b3eb405f27f2a6acb81399e0d67 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:09 +0000
Subject: [PATCH 3424/3799] soh: rename D_80B16E7C -> sTaFocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point EnTa_PostLimbDraw records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c b/soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c
index ad008a6d1..938e3258d 100644
--- a/soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c
+++ b/soh/src/overlays/actors/ovl_En_Ta/z_en_ta.c
@@ -1202,7 +1202,7 @@ s32 EnTa_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* po
 }
 
 void EnTa_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
-    static Vec3f D_80B16E7C = {
+    static Vec3f sTaFocusOffset = {  // was D_80B16E7C [LLM:HIGH]
         1100.0f,
         1000.0f,
         0.0f,
@@ -1210,7 +1210,7 @@ void EnTa_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot,
     EnTa* this = (EnTa*)thisx;
 
     if (limbIndex == 15) {
-        Matrix_MultVec3f(&D_80B16E7C, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sTaFocusOffset, &this->actor.focus.pos);  // was D_80B16E7C [LLM:HIGH]
     }
 }
 
