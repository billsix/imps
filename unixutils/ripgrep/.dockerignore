# The image build only needs entrypoint/ (COPY'd explicitly). Keep the large,
# gitignored runtime checkout, its Cargo build output, and image tarballs OUT of
# the build context so `podman build` isn't sent source it never uses (the warm
# step clones its own fresh copy of ripgrep at the pin).
checkout/
target/
ripgrep-doc-builder-*.tar
.check-comment-only/
__pycache__/
