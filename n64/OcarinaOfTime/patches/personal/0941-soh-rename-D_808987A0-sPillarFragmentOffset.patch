From 4fadd3ef48315c233a56675246766e5b80df4d3e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:28:10 +0000
Subject: [PATCH 0941/3799] soh: rename D_808987A0 -> sPillarFragmentOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the Vec3f BgJyaHaheniron_PillarCrumble passes to BgJyaHaheniron_SpawnFragments before killing the actor.
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c         | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c b/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c
index 061999a10..e7bafc755 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Haheniron/z_bg_jya_haheniron.c
@@ -73,7 +73,8 @@ static InitChainEntry sInitChain[] = {
 // LLM generated name (HIGH), was D_80898794: f32 table indexed by actor.params and handed to Actor_SetScale.
 static f32 sScales[] = { 0.13f, 0.1f, 0.1f };  // was D_80898794 [LLM:HIGH]
 
-static Vec3f D_808987A0[] = { 0.0f, 14.0f, 0.0f };
+// LLM generated name (HIGH), was D_808987A0: the Vec3f BgJyaHaheniron_PillarCrumble passes to BgJyaHaheniron_SpawnFragments before killing the actor.
+static Vec3f sPillarFragmentOffset[] = { 0.0f, 14.0f, 0.0f };  // was D_808987A0 [LLM:HIGH]
 
 static Vec3f D_808987AC[] = { 0.0f, 8.0f, 0.0f };
 
@@ -176,7 +177,7 @@ void BgJyaHaheniron_PillarCrumble(BgJyaHaheniron* this, PlayState* play) {
     if (this->timer >= 8) {
         Actor_MoveXZGravity(&this->actor);
     } else if (this->timer >= 17) {
-        BgJyaHaheniron_SpawnFragments(play, &this->actor.world.pos, D_808987A0);
+        BgJyaHaheniron_SpawnFragments(play, &this->actor.world.pos, sPillarFragmentOffset);  // was D_808987A0 [LLM:HIGH]
         Actor_Kill(&this->actor);
     }
     this->actor.shape.rot.y += 0x258;
-- 
