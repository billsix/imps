From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:30 +0000
Subject: [PATCH 0686/3799] soh: rename D_80A7B918 -> sHorsebackAnimations

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_In/z_en_in.c.
---
 soh/src/overlays/actors/ovl_En_In/z_en_in.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_In/z_en_in.c b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
index 96ff24860..084d401d8 100644
--- a/soh/src/overlays/actors/ovl_En_In/z_en_in.c
+++ b/soh/src/overlays/actors/ovl_En_In/z_en_in.c
@@ -91,7 +91,8 @@ static AnimationFrameCountInfo sAnimationInfo[] = {
     { &object_in_Anim_01431C, 1.0f, ANIMMODE_LOOP, 0.0f }, { &object_in_Anim_014CA8, 1.0f, ANIMMODE_LOOP, 0.0f },
 };
 
-static AnimationHeader* D_80A7B918[] = {
+// Name from zeldaret/oot (was D_80A7B918): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_In/z_en_in.c]
+static AnimationHeader* sHorsebackAnimations[] = {
     &object_in_Anim_0151C8, &object_in_Anim_015DF0, &object_in_Anim_016B3C, &object_in_Anim_015814,
     &object_in_Anim_01646C, &object_in_Anim_0175D0, &object_in_Anim_017B58, &object_in_Anim_018C38,
 };
@@ -369,8 +370,8 @@ s32 EnIn_StartingRace(EnIn* this, PlayState* play) {
     }
     this->animationIdx = 1;
     this->collider.base.ocFlags1 &= ~OC1_ON;
-    Animation_Change(&this->skelAnime, D_80A7B918[this->animationIdx], 1.0f, 0.0f,
-                     Animation_GetLastFrame(D_80A7B918[this->animationIdx]), 2, 0.0f);
+    Animation_Change(&this->skelAnime, sHorsebackAnimations[this->animationIdx], 1.0f, 0.0f,
+                     Animation_GetLastFrame(sHorsebackAnimations[this->animationIdx]), 2, 0.0f);
     this->actionFunc = EnIn_Racing;
     return 1;
 }
@@ -644,8 +645,8 @@ void EnIn_Racing(EnIn* this, PlayState* play) {
                                      &gSfxDefaultFreqAndVolScale, &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
             }
         }
-        Animation_Change(&this->skelAnime, D_80A7B918[this->animationIdx], 1.0f, 0.0f,
-                         Animation_GetLastFrame(D_80A7B918[this->animationIdx]), 2, -10.0f);
+        Animation_Change(&this->skelAnime, sHorsebackAnimations[this->animationIdx], 1.0f, 0.0f,
+                         Animation_GetLastFrame(sHorsebackAnimations[this->animationIdx]), 2, -10.0f);
     }
 }
 
