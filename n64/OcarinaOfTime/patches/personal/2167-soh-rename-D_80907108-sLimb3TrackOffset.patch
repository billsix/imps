From 621b0b4e5ed53d4afc4e07ceedbb02ccdf0d6455 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:15:36 +0000
Subject: [PATCH 2167/3799] soh: rename D_80907108 -> sLimb3TrackOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the offset whose transformed position limb 3 records
Defined in soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c      | 2 +-
 soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
index 6702f55d4..93bf4c17c 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2.c
@@ -2624,7 +2624,7 @@ void BossGanon2_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s*
     if (limbIndex == 15) {
         Matrix_MultVec3f(&sOrigin, &this->unk_1B8);  // was D_80906D60 [LLM:HIGH]
     } else if (limbIndex == 3) {
-        Matrix_MultVec3f(&D_80907108, &this->unk_1F4);
+        Matrix_MultVec3f(&sLimb3TrackOffset, &this->unk_1F4);  // was D_80907108 [LLM:HIGH]
     } else if (limbIndex == 9) {
         Matrix_MultVec3f(&D_80907114, &this->unk_1E8);
     } else if (limbIndex == 38) {
diff --git a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
index 441082353..17b43d12b 100644
--- a/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
+++ b/soh/src/overlays/actors/ovl_Boss_Ganon2/z_boss_ganon2_data.c
@@ -284,7 +284,8 @@ static s8 sLimbPosIndices[] = {  // was D_809070CC [LLM:HIGH]
 // LLM generated name (GUESS), was D_809070FC: the hand-space point recorded as the sword trail's anchor at limbs 7 and 13; named for the trail it feeds, not from an identified model feature
 static Vec3f sSwordTrailAnchorOffset = { 0.0f, 0.0f, 5000.0f };  // was D_809070FC [LLM:GUESS]
 
-static Vec3f D_80907108 = { 0.0f, 2000.0f, 0.0f };
+// LLM generated name (HIGH), was D_80907108: the offset whose transformed position limb 3 records
+static Vec3f sLimb3TrackOffset = { 0.0f, 2000.0f, 0.0f };  // was D_80907108 [LLM:HIGH]
 
 static Vec3f D_80907114 = { 0.0f, 2000.0f, 0.0f };
 
