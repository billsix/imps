Subject: [PATCH 2897/3799] soh: rename func_80B3ECD8 ->
 EnXc_StartWalkAfterDelay

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: after 12 frames sets the kREG-tunable walk speed and enters action 24
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 9c8241aa6..dda06cd4e 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -1226,7 +1226,8 @@ void EnXc_BlockPedestalUnlessAction6(EnXc* this, PlayState* play) {
     }
 }
 
-void func_80B3ECD8(EnXc* this) {
+// LLM generated name (HIGH), was func_80B3ECD8: after 12 frames sets the kREG-tunable walk speed and enters action 24
+void EnXc_StartWalkAfterDelay(EnXc* this) {
     this->timer++;
     if (this->timer >= 12.0f) {
         this->actor.speedXZ = kREG(2) * 0.01f + 1.2f;
@@ -1255,7 +1256,7 @@ void EnXc_ActionFunc23(EnXc* this, PlayState* play) {
     EnXc_BgCheck(this, play);
     EnXc_SetEyePattern(this);
     EnXc_SetWalkingSFX(this, play);
-    func_80B3ECD8(this);
+    EnXc_StartWalkAfterDelay(this);  // was func_80B3ECD8 [LLM:HIGH]
 }
 
 void EnXc_ActionFunc24(EnXc* this, PlayState* play) {
