Subject: [PATCH 3661/3799] soh: rename func_80B55A58 ->
 EnZl3_StepYawTowardsPlayerIfMainCam

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: runs EnZl3_StepYawTowardsPlayer only while play->activeCamera is CAM_ID_MAIN, i.e. not during a one-point cutscene
Defined in soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
index d81c5451b..5f59b3222 100644
--- a/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
+++ b/soh/src/overlays/actors/ovl_En_Zl3/z_en_zl3.c
@@ -1119,7 +1119,8 @@ void EnZl3_LerpToLungeTarget(EnZl3* this) {
     thisPos->z = unk_32C->z + (temp_f0 * (unk_338->z - unk_32C->z));
 }
 
-void func_80B55A58(EnZl3* this, PlayState* play) {
+// LLM generated name (GUESS), was func_80B55A58: runs EnZl3_StepYawTowardsPlayer only while play->activeCamera is CAM_ID_MAIN, i.e. not during a one-point cutscene
+void EnZl3_StepYawTowardsPlayerIfMainCam(EnZl3* this, PlayState* play) {
     if (play->activeCamera == CAM_ID_MAIN) {
         EnZl3_StepYawTowardsPlayer(this);  // was func_80B537E8 [LLM:HIGH]
     }
@@ -1481,7 +1482,7 @@ void func_80B567CC(EnZl3* this, PlayState* play) {
 
 void func_80B5682C(EnZl3* this, PlayState* play) {
     EnZl3_SetAnimObjectSegment(this, play);  // was func_80B54DE0 [LLM:HIGH]
-    func_80B55A58(this, play);
+    EnZl3_StepYawTowardsPlayerIfMainCam(this, play);  // was func_80B55A58 [LLM:GUESS]
     EnZl3_UpdateCollider(this, play);  // was func_80B533FC [LLM:HIGH]
     EnZl3_UpdateBgCheckInfo(this, play);  // was func_80B5366C [LLM:HIGH]
     EnZl3_UpdateEyes(this);
