From 052d4654d5bcd8ad83e4f342d8d6f8fd68a06578 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:26:29 +0000
Subject: [PATCH 1550/3799] soh: rename D_8089BA30 -> sBandToSegment

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: which wall segment each of those six bands belongs to, so the check can read that segment's speed out of sWallSpeeds.
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c     | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c b/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
index 3f1a4cd53..e48c90f71 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Zurerukabe/z_bg_jya_zurerukabe.c
@@ -55,7 +55,8 @@ static s16 sLadderBands[6][2] = {  // was D_8089BA18 [LLM:HIGH]
     { 0x04B4, 0x04C1 }, { 0x0518, 0x0528 }, { 0x0581, 0x0590 },
 };
 
-static s16 D_8089BA30[6] = {
+// LLM generated name (HIGH), was D_8089BA30: which wall segment each of those six bands belongs to, so the check can read that segment's speed out of sWallSpeeds.
+static s16 sBandToSegment[6] = {  // was D_8089BA30 [LLM:HIGH]
     0, 0, 1, 2, 2, 3,
 };
 
@@ -99,13 +100,13 @@ void func_8089B4C8(BgJyaZurerukabe* this, PlayState* play) {
             case 2:
             case 3:
             case 5:
-                if (fabsf(sWallSpeeds[D_8089BA30[i]]) > 1.0f) {  // was D_8089B9C0 [LLM:HIGH]
+                if (fabsf(sWallSpeeds[sBandToSegment[i]]) > 1.0f) {  // was D_8089B9C0 [LLM:HIGH]
                     Actor_SetPlayerKnockbackLarge(play, &this->dyna.actor, 1.5f, this->dyna.actor.shape.rot.y, 0.0f, 0);
                 }
                 break;
             case 1:
             case 4:
-                if (fabsf(sWallSpeeds[D_8089BA30[i]] - sWallSpeeds[D_8089BA30[i + 1]]) > 1.0f) {  // was D_8089B9C0 [LLM:HIGH]
+                if (fabsf(sWallSpeeds[sBandToSegment[i]] - sWallSpeeds[sBandToSegment[i + 1]]) > 1.0f) {  // was D_8089B9C0 [LLM:HIGH]
                     Actor_SetPlayerKnockbackLarge(play, &this->dyna.actor, 1.5f, this->dyna.actor.shape.rot.y, 0.0f, 0);
                 }
                 break;
