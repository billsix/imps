+++ b/soh/src/overlays/actors/ovl_Demo_Im/z_demo_im.c
@@ -891,7 +891,8 @@ void DemoIm_Action17(DemoIm* this, PlayState* play) {
     DemoIm_HandleEscapeCues(this, play);  // was func_8098680C [LLM:HIGH]
 }
 
-void func_809869B0(DemoIm* this, PlayState* play) {
+// LLM generated name (HIGH), was func_809869B0: loops the idle with no shadow at action 18
+void DemoIm_SetupHiddenAction18(DemoIm* this, PlayState* play) {
     DemoIm_ChangeAnim(this, &gImpaIdleAnim, ANIMMODE_LOOP, 0.0f, false);
     this->action = 18;
     this->actor.shape.shadowAlpha = 0;
@@ -1199,7 +1200,7 @@ void DemoIm_Init(Actor* thisx, PlayState* play) {
             DemoIm_SetupIdleAction15(this, play);  // was func_8098652C [LLM:HIGH]
             break;
