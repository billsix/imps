From 3ebcc8a437a76b5b37032ec770b430e7ba52c09a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:13:28 +0000
Subject: [PATCH 3316/3799] soh: rename D_8012A330 -> sWaterTempleTextures

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the day and night entrance textures the Water Temple draw config binds
Defined in soh/src/code/z_scene_table.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_scene_table.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_scene_table.c b/soh/src/code/z_scene_table.c
index c05359c94..c8ab87986 100644
--- a/soh/src/code/z_scene_table.c
+++ b/soh/src/code/z_scene_table.c
@@ -461,7 +461,8 @@ void Scene_DrawConfigThievesHideout(PlayState* play) {
     CLOSE_DISPS(play->state.gfxCtx);
 }
 
-void* D_8012A330[] = {
+// LLM generated name (HIGH), was D_8012A330: the day and night entrance textures the Water Temple draw config binds
+void* sWaterTempleTextures[] = {  // was D_8012A330 [LLM:HIGH]
     gWaterTempleDayEntranceTex,
     gWaterTempleNightEntranceTex,
 };
@@ -482,7 +483,7 @@ void Scene_DrawConfigWaterTemple(PlayState* play) {
     if (ResourceMgr_IsGameMasterQuest()) {
         gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_8012A330_MQ[gSaveContext.nightFlag]));
     } else {
-        gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_8012A330[gSaveContext.nightFlag]));
+        gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(sWaterTempleTextures[gSaveContext.nightFlag]));  // was D_8012A330 [LLM:HIGH]
     }
 
     if (spB0 == 1) {
