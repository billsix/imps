From 22f4991973f82a8397a16802f3f5e27cfb0d34d9 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:46 +0000
Subject: [PATCH 743/784] soh: rename func_80AF5DFC -> EnSa_GetType

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 0.96.
Defined in soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c.
---
 soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
index 705e440b4..2b0203b55 100644
--- a/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
+++ b/soh/src/overlays/actors/ovl_En_Sa/z_en_sa.c
@@ -394,7 +394,8 @@ void EnSa_ChangeAnim(EnSa* this, s32 index) {
                      sAnimationInfo1[index].morphFrames);
 }
 
-s32 func_80AF5DFC(EnSa* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AF5DFC): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 0.96. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Sa/z_en_sa.c]
+s32 EnSa_GetType(EnSa* this, PlayState* play) {
     if (gSaveContext.cutsceneIndex >= 0xFFF0 && gSaveContext.cutsceneIndex != 0xFFFD) {
         if (play->sceneNum == SCENE_KOKIRI_FOREST) {
             return 4;
@@ -508,7 +509,7 @@ void EnSa_Init(Actor* thisx, PlayState* play) {
     Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);
     CollisionCheck_SetInfo2(&this->actor.colChkInfo, NULL, &sColChkInfoInit);
 
-    switch (func_80AF5DFC(this, play)) {
+    switch (EnSa_GetType(this, play)) {
         case 2:
             EnSa_ChangeAnim(this, ENSA_ANIM1_11);
             this->actionFunc = func_80AF6448;
-- 
