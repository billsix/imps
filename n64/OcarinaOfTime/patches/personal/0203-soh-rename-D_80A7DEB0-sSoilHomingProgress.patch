     } else if (Rand_ZeroOne() < 0.07f) {
@@ -620,7 +621,7 @@ void EnInsect_Dropped(EnInsect* this, PlayState* play) {
             this->unk_324 = Rand_ZeroOne() * 0.8f + 1.0f;
