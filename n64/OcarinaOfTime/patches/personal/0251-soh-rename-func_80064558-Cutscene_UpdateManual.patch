From 10cb111800a47ee2784d354f6660f05de13f1277 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:24 +0000
Subject: [PATCH 0251/3799] soh: rename func_80064558 -> Cutscene_UpdateManual

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.81.
Defined in soh/src/code/z_demo.c.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_demo.c   | 3 ++-
 soh/src/code/z_play.c   | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 804ea37be..9c3c70577 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -865,7 +865,7 @@ void DebugDisplay_DrawObjects(PlayState* play);
 void Cutscene_InitContext(PlayState* play, CutsceneContext* csCtx);  // was func_8006450C [oot]
 void func_80064520(PlayState* play, CutsceneContext* csCtx);
 void Cutscene_StopManual(PlayState* play, CutsceneContext* csCtx);  // was func_80064534 [oot]
-void func_80064558(PlayState* play, CutsceneContext* csCtx);
+void Cutscene_UpdateManual(PlayState* play, CutsceneContext* csCtx);  // was func_80064558 [oot]
 void func_800645A0(PlayState* play, CutsceneContext* csCtx);
 void Cutscene_HandleEntranceTriggers(PlayState* play);
 void Cutscene_HandleConditionalTriggers(PlayState* play);
diff --git a/soh/src/code/z_demo.c b/soh/src/code/z_demo.c
index ddd8b82a8..f4fe97e08 100644
--- a/soh/src/code/z_demo.c
+++ b/soh/src/code/z_demo.c
@@ -150,7 +150,8 @@ void Cutscene_StopManual(PlayState* play, CutsceneContext* csCtx) {
     }
 }
 
-void func_80064558(PlayState* play, CutsceneContext* csCtx) {
+// Name from zeldaret/oot (was func_80064558): adopted upstream's name for this address; body verified to match upstream at 0.81. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_demo.c]
+void Cutscene_UpdateManual(PlayState* play, CutsceneContext* csCtx) {
     if (gSaveContext.cutsceneIndex < 0xFFF0) {
         sCsStateHandlers1[csCtx->state](play, csCtx);
     }
diff --git a/soh/src/code/z_play.c b/soh/src/code/z_play.c
index d33b25be5..985bc3935 100644
--- a/soh/src/code/z_play.c
+++ b/soh/src/code/z_play.c
@@ -1173,7 +1173,7 @@ void Play_Update(PlayState* play) {
                     }
 
                     PLAY_LOG(3643);
-                    func_80064558(play, &play->csCtx);
+                    Cutscene_UpdateManual(play, &play->csCtx);
 
                     PLAY_LOG(3648);
                     func_800645A0(play, &play->csCtx);
-- 
