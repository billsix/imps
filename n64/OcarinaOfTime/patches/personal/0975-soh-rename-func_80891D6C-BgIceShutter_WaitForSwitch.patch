From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:33:16 +0000
Subject: [PATCH 0975/3799] soh: rename func_80891D6C ->
 BgIceShutter_WaitForSwitch

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the switch-flag variant of the same wait, used when the shutter is keyed to a switch rather than to clearing the room.
Defined in soh/src/overlays/actors/ovl_Bg_Ice_Shutter/z_bg_ice_shutter.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_Bg_Ice_Shutter/z_bg_ice_shutter.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Ice_Shutter/z_bg_ice_shutter.c b/soh/src/overlays/actors/ovl_Bg_Ice_Shutter/z_bg_ice_shutter.c
index 07ed1634b..c230c773d 100644
--- a/soh/src/overlays/actors/ovl_Bg_Ice_Shutter/z_bg_ice_shutter.c
+++ b/soh/src/overlays/actors/ovl_Bg_Ice_Shutter/z_bg_ice_shutter.c
@@ -16,7 +16,8 @@ void BgIceShutter_Draw(Actor* thisx, PlayState* play);
 
 // LLM generated name (HIGH), was func_80891CF4: waits for the room's temp-clear flag, then sets the permanent clear flag, plays the sliding-door sfx and starts opening.
 void BgIceShutter_WaitForRoomClear(BgIceShutter* thisx, PlayState* play);  // was func_80891CF4 [LLM:HIGH]
-void func_80891D6C(BgIceShutter* thisx, PlayState* play);
+// LLM generated name (HIGH), was func_80891D6C: the switch-flag variant of the same wait, used when the shutter is keyed to a switch rather than to clearing the room.
+void BgIceShutter_WaitForSwitch(BgIceShutter* thisx, PlayState* play);  // was func_80891D6C [LLM:HIGH]
 void func_80891DD4(BgIceShutter* thisx, PlayState* play);
 
 const ActorInit Bg_Ice_Shutter_InitVars = {
@@ -76,7 +77,7 @@ void BgIceShutter_Init(Actor* thisx, PlayState* play) {
         if (Flags_GetSwitch(play, this->dyna.actor.params)) {
             Actor_Kill(&this->dyna.actor);
         } else {
-            this->actionFunc = func_80891D6C;
+            this->actionFunc = BgIceShutter_WaitForSwitch;  // was func_80891D6C [LLM:HIGH]
         }
     }
 
@@ -108,7 +109,7 @@ void BgIceShutter_WaitForRoomClear(BgIceShutter* this, PlayState* play) {
     }
 }
 
-void func_80891D6C(BgIceShutter* this, PlayState* play) {
+void BgIceShutter_WaitForSwitch(BgIceShutter* this, PlayState* play) {
     if (Flags_GetSwitch(play, this->dyna.actor.params)) {
         SoundSource_PlaySfxAtFixedWorldPos(play, &this->dyna.actor.world.pos, 30, NA_SE_EV_SLIDE_DOOR_OPEN);
         this->actionFunc = func_80891DD4;
