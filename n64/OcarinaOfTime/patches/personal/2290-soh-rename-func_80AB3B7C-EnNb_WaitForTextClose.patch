     }
 }
 
-void func_80AB3B7C(EnNb* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80AB3B7C: returns to the idle action and drops targeting once the textbox closes
+void EnNb_WaitForTextClose(EnNb* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_CLOSING) {
         this->action = NB_IDLE_AFTER_TALK;
         this->actor.flags &= ~(ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_FRIENDLY);
@@ -1399,7 +1400,7 @@ void func_80AB3E10(EnNb* this, PlayState* play) {
     EnNb_TrackPlayerBody(this, play);  // was func_80AB1040 [LLM:HIGH]
