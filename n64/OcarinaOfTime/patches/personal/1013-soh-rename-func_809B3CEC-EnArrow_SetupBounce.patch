From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:35:18 +0000
Subject: [PATCH 1013/3799] soh: rename func_809B3CEC -> EnArrow_SetupBounce

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: called when the arrow strikes something that repels it: plays gArrow1Anim, flips the yaw by roughly 180 degrees with jitter, converts forward speed into an upward hop, enables gravity and starts a 50-frame countdown.
Defined in soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c b/soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c
index 4c815ea29..50ad2600b 100644
--- a/soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c
+++ b/soh/src/overlays/actors/ovl_En_Arrow/z_en_arrow.c
@@ -248,7 +248,8 @@ void EnArrow_Shoot(EnArrow* this, PlayState* play) {
     }
 }
 
-void func_809B3CEC(PlayState* play, EnArrow* this) {
+// LLM generated name (HIGH), was func_809B3CEC: called when the arrow strikes something that repels it: plays gArrow1Anim, flips the yaw by roughly 180 degrees with jitter, converts forward speed into an upward hop, enables gravity and starts a 50-frame countdown.
+void EnArrow_SetupBounce(PlayState* play, EnArrow* this) {
     EnArrow_SetupAction(this, func_809B4640);
     Animation_PlayOnce(&this->skelAnime, &gArrow1Anim);
     this->actor.world.rot.y += (s32)(24576.0f * (Rand_ZeroOne() - 0.5f)) + 0x8000;
@@ -361,7 +362,7 @@ void EnArrow_Fly(EnArrow* this, PlayState* play) {
                         this->actor.world.pos.z = this->collider.info.atHitInfo->bumper.hitPos.z;
                     }
 
-                    func_809B3CEC(play, this);
+                    EnArrow_SetupBounce(play, this);  // was func_809B3CEC [LLM:HIGH]
                     Audio_PlayActorSound2(&this->actor, NA_SE_IT_ARROW_STICK_CRE);
                 }
             } else if (this->touchedPoly) {
