From 0a55761b650a396de2add325eb029984feccb91f Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:02:25 +0000
Subject: [PATCH 261/784] soh: rename func_80096FD4 -> Room_Init

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/code/z_room.c.
---
 soh/include/functions.h | 2 +-
 soh/soh/z_play_otr.cpp  | 2 +-
 soh/src/code/z_play.c   | 2 +-
 soh/src/code/z_room.c   | 3 ++-
 4 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 9a8ea956b..3e555e477 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1241,7 +1241,7 @@ void func_80095974(GraphicsContext* gfxCtx);
 void func_80095AA0(PlayState* play, Room* room, Input* arg2, UNK_TYPE arg3);
 void Room_DrawBackground2D(Gfx** gfxP, void* tex, void* tlut, u16 width, u16 height, u8 fmt, u8 siz, u16 tlutMode,
                            u16 tlutCount, f32 offsetX, f32 offsetY);
-void func_80096FD4(PlayState* play, Room* room);
+void Room_Init(PlayState* play, Room* room);  // was func_80096FD4 [oot]
 u32 func_80096FE8(PlayState* play, RoomContext* roomCtx);
 s32 Room_RequestNewRoom(PlayState* play, RoomContext* roomCtx, s32 roomNum);
 s32 func_800973FC(PlayState* play, RoomContext* roomCtx);
diff --git a/soh/soh/z_play_otr.cpp b/soh/soh/z_play_otr.cpp
index a9537cea2..5396ad6e9 100644
--- a/soh/soh/z_play_otr.cpp
+++ b/soh/soh/z_play_otr.cpp
@@ -79,7 +79,7 @@ void OTRPlay_InitScene(PlayState* play, s32 spawn) {
     Object_InitBank(play, &play->objectCtx);
     LightContext_Init(play, &play->lightCtx);
     TransitionActor_InitContext(&play->state, &play->transiActorCtx);
-    func_80096FD4(play, &play->roomCtx.curRoom);
+    Room_Init(play, &play->roomCtx.curRoom);
     YREG(15) = 0;
     gSaveContext.worldMapArea = 0;
     OTRScene_ExecuteCommands(play, (SOH::Scene*)play->sceneSegment);
diff --git a/soh/src/code/z_play.c b/soh/src/code/z_play.c
index 50214be48..86974a370 100644
--- a/soh/src/code/z_play.c
+++ b/soh/src/code/z_play.c
@@ -1806,7 +1806,7 @@ void Play_InitScene(PlayState* play, s32 spawn) {
     Object_InitBank(play, &play->objectCtx);
     LightContext_Init(play, &play->lightCtx);
     TransitionActor_InitContext(&play->state, &play->transiActorCtx);
-    func_80096FD4(play, &play->roomCtx.curRoom);
+    Room_Init(play, &play->roomCtx.curRoom);
     YREG(15) = 0;
     gSaveContext.worldMapArea = 0;
     Scene_ExecuteCommands(play, play->sceneSegment);
diff --git a/soh/src/code/z_room.c b/soh/src/code/z_room.c
index cfdedcdaa..deaf9df10 100644
--- a/soh/src/code/z_room.c
+++ b/soh/src/code/z_room.c
@@ -513,7 +513,8 @@ void func_80096F6C(PlayState* play, Room* room, u32 flags) {
     }
 }
 
-void func_80096FD4(PlayState* play, Room* room) {
+// Name from zeldaret/oot (was func_80096FD4): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_room.c]
+void Room_Init(PlayState* play, Room* room) {
     room->num = -1;
     room->segment = NULL;
 }
