From d06d5d38c36f38c75fc0ec4e6e9697e6249c4175 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:31 +0000
Subject: [PATCH 2738/3799] soh: rename func_8002DCE4 ->
 Player_GetRunSpeedLimit

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns the player speed cap the camera divides by: 8 on horse, 60 percent of R_RUN_SPEED_LIMIT in water, otherwise the full limit
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/code/z_actor.c  | 3 ++-
 soh/src/code/z_camera.c | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 6fce40420..5f7b43da6 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -418,7 +418,7 @@ void Actor_WorldToActorCoords(Actor* actor, Vec3f* result, Vec3f* arg2);
 f32 Actor_HeightDiff(Actor* actorA, Actor* actorB);
 f32 Player_GetHeight(Player* player);
 s32 Player_ActionHandler_2(Player* player, PlayState* play);
-f32 func_8002DCE4(Player* player);
+f32 Player_GetRunSpeedLimit(Player* player);  // was func_8002DCE4 [LLM:HIGH]
 s32 func_8002DD6C(Player* player);
 s32 func_8002DD78(Player* player);
 s32 func_8002DDE4(PlayState* play);
diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 7ab63a1a1..9cfe0194a 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -1410,7 +1410,8 @@ f32 Player_GetHeight(Player* player) {
     }
 }
 
-f32 func_8002DCE4(Player* player) {
+// LLM generated name (HIGH), was func_8002DCE4: returns the player speed cap the camera divides by: 8 on horse, 60 percent of R_RUN_SPEED_LIMIT in water, otherwise the full limit
+f32 Player_GetRunSpeedLimit(Player* player) {
     if (player->stateFlags1 & PLAYER_STATE1_ON_HORSE) {
         return 8.0f;
     } else if (player->stateFlags1 & PLAYER_STATE1_IN_WATER) {
diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index b7783e531..8ba89f1e9 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -7556,7 +7556,7 @@ Vec3s Camera_Update(Camera* camera) {
         Actor_GetWorldPosShapeRot(&curPlayerPosRot, &camera->player->actor);
         camera->xzSpeed = playerXZSpeed = OLib_Vec3fDistXZ(&curPlayerPosRot.pos, &camera->playerPosRot.pos);
 
-        camera->speedRatio = OLib_ClampMaxDist(playerXZSpeed / (func_8002DCE4(camera->player) * PCT(OREG(8))), 1.0f);
+        camera->speedRatio = OLib_ClampMaxDist(playerXZSpeed / (Player_GetRunSpeedLimit(camera->player) * PCT(OREG(8))), 1.0f);  // was func_8002DCE4 [LLM:HIGH]
         camera->playerPosDelta.x = curPlayerPosRot.pos.x - camera->playerPosRot.pos.x;
         camera->playerPosDelta.y = curPlayerPosRot.pos.y - camera->playerPosRot.pos.y;
         camera->playerPosDelta.z = curPlayerPosRot.pos.z - camera->playerPosRot.pos.z;
