+            Matrix_MultVec3f(&sScepterFlameOffsets[2], &this->scepterFlamePos[2]);  // was D_8094A95C [LLM:HIGH]
+            Matrix_MultVec3f(&sScepterFlameOffsets[3], &this->scepterFlamePos[3]);  // was D_8094A95C [LLM:HIGH]
+            Matrix_MultVec3f(&sScepterFlameOffsets[4], &this->scepterFlamePos[4]);  // was D_8094A95C [LLM:HIGH]
 
