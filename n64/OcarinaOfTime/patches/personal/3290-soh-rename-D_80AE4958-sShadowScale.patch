From 74cd16a4e80db20896e072949c8c648cc0c98d7e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:11:55 +0000
Subject: [PATCH 3290/3799] soh: rename D_80AE4958 -> sShadowScale

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the scale passed to Actor_DrawShadowAtPos for the redead's shadow
Defined in soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c b/soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c
index c23ed7551..5c5ff4deb 100644
--- a/soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c
+++ b/soh/src/overlays/actors/ovl_En_Rd/z_en_rd.c
@@ -126,7 +126,8 @@ static Color_RGBA8 sUnusedFreezeEnvColor = { 0, 0, 255, 0 };  // was D_80AE493C
 static Vec3f sLimbFlameOffset = { 300.0f, 0.0f, 0.0f };  // was D_80AE4940 [LLM:HIGH]
 // LLM generated name (GUESS), was D_80AE494C: an identical copy of sLimbFlameOffset that nothing in the overlay reads
 static Vec3f sUnusedLimbOffset = { 300.0f, 0.0f, 0.0f };  // was D_80AE494C [LLM:GUESS]
-static Vec3f D_80AE4958 = { 0.25f, 0.25f, 0.25f };
+// LLM generated name (HIGH), was D_80AE4958: the scale passed to Actor_DrawShadowAtPos for the redead's shadow
+static Vec3f sShadowScale = { 0.25f, 0.25f, 0.25f };  // was D_80AE4958 [LLM:HIGH]
 
 void EnRd_SetupAction(EnRd* this, EnRdActionFunc actionFunc) {
     this->actionFunc = actionFunc;
@@ -933,7 +934,7 @@ void EnRd_Draw(Actor* thisx, PlayState* play) {
         POLY_OPA_DISP =
             SkelAnime_DrawFlex(play, this->skelAnime.skeleton, this->skelAnime.jointTable, this->skelAnime.dListCount,
                                EnRd_OverrideLimbDraw, EnRd_PostLimbDraw, this, POLY_OPA_DISP);
-        Actor_DrawShadowAtPos(&thisPos, &D_80AE4958, 255, play);  // was func_80033C30 [LLM:HIGH]
+        Actor_DrawShadowAtPos(&thisPos, &sShadowScale, 255, play);  // was func_80033C30 [LLM:HIGH]
         if (this->fireTimer != 0) {
             thisx->colorFilterTimer++;
             this->fireTimer--;
@@ -950,7 +951,7 @@ void EnRd_Draw(Actor* thisx, PlayState* play) {
             SkelAnime_DrawFlex(play, this->skelAnime.skeleton, this->skelAnime.jointTable, this->skelAnime.dListCount,
                                EnRd_OverrideLimbDraw, NULL, this, POLY_XLU_DISP);
 
-        Actor_DrawShadowAtPos(&thisPos, &D_80AE4958, this->alpha, play);  // was func_80033C30 [LLM:HIGH]
+        Actor_DrawShadowAtPos(&thisPos, &sShadowScale, this->alpha, play);  // was func_80033C30 [LLM:HIGH]
     }
 
     CLOSE_DISPS(play->state.gfxCtx);
-- 
