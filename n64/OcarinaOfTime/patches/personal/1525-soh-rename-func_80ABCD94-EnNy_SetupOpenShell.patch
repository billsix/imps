From 675245ef74133727cbc936081e7b26e9d6e3e873 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:24:59 +0000
Subject: [PATCH 1525/3799] soh: rename func_80ABCD94 -> EnNy_SetupOpenShell

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: arms the 20-frame opening timer and installs the opening action.
Defined in soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
index cc06b7e97..bf7cd4481 100644
--- a/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
+++ b/soh/src/overlays/actors/ovl_En_Ny/z_en_ny.c
@@ -167,7 +167,8 @@ void EnNy_SetupWaitForPlayer(EnNy* this) {
     this->actionFunc = EnNy_WaitForPlayer;  // was func_80ABCE50 [LLM:HIGH]
 }
 
-void func_80ABCD94(EnNy* this) {
+// LLM generated name (HIGH), was func_80ABCD94: arms the 20-frame opening timer and installs the opening action.
+void EnNy_SetupOpenShell(EnNy* this) {
     this->stoneTimer = 0x14;
     this->actionFunc = func_80ABCE90;
 }
@@ -196,7 +197,7 @@ void func_80ABCE38(EnNy* this) {
 
 void EnNy_WaitForPlayer(EnNy* this, PlayState* play) {
     if (this->actor.xyzDistToPlayerSq <= 25600.0f) {
-        func_80ABCD94(this);
+        EnNy_SetupOpenShell(this);  // was func_80ABCD94 [LLM:HIGH]
     }
 }
 
