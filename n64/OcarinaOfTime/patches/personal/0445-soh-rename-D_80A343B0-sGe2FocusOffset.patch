From 77764773c1f507f53130da0f05ceac6c0cfdb204 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 03:25:38 +0000
Subject: [PATCH 445/488] soh: rename D_80A343B0 -> sGe2FocusOffset

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the head-space point EnGe2_PostLimbDraw records the focus position from
Defined in soh/src/overlays/actors/ovl_En_Ge2/z_en_ge2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 soh/src/overlays/actors/ovl_En_Ge2/z_en_ge2.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ge2/z_en_ge2.c b/soh/src/overlays/actors/ovl_En_Ge2/z_en_ge2.c
index 87b507ad3..d7685d93e 100644
--- a/soh/src/overlays/actors/ovl_En_Ge2/z_en_ge2.c
+++ b/soh/src/overlays/actors/ovl_En_Ge2/z_en_ge2.c
@@ -645,11 +645,11 @@ s32 EnGe2_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* p
 }
 
 void EnGe2_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
-    static Vec3f D_80A343B0 = { 600.0f, 700.0f, 0.0f };
+    static Vec3f sGe2FocusOffset = { 600.0f, 700.0f, 0.0f };  // was D_80A343B0 [LLM:HIGH]
     EnGe2* this = (EnGe2*)thisx;
 
     if (limbIndex == 6) {
-        Matrix_MultVec3f(&D_80A343B0, &this->actor.focus.pos);
+        Matrix_MultVec3f(&sGe2FocusOffset, &this->actor.focus.pos);  // was D_80A343B0 [LLM:HIGH]
     }
 }
 
