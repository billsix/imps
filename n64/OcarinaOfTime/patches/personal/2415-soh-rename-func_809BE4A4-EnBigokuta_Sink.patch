From f75f00723d6446e1689997ef17af9341660ec1e1 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:25:27 +0000
Subject: [PATCH 2415/3799] soh: rename func_809BE4A4 -> EnBigokuta_Sink

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: drops 10 units a frame while spinning until 200 below home, then resurfaces elsewhere
Defined in soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c   | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c b/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
index e6d014713..625ba81be 100644
--- a/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
+++ b/soh/src/overlays/actors/ovl_En_Bigokuta/z_en_bigokuta.c
@@ -29,7 +29,8 @@ void EnBigokuta_WaitBeforeCircle(EnBigokuta* this, PlayState* play);  // was fun
 void EnBigokuta_Circle(EnBigokuta* this, PlayState* play);  // was func_809BDC08 [LLM:HIGH]
 // LLM generated name (HIGH), was func_809BE3E4: spins in place, then picks the direction it was turned toward and resumes circling
 void EnBigokuta_Spin(EnBigokuta* this, PlayState* play);  // was func_809BE3E4 [LLM:HIGH]
-void func_809BE4A4(EnBigokuta* this, PlayState* play);
+// LLM generated name (HIGH), was func_809BE4A4: drops 10 units a frame while spinning until 200 below home, then resurfaces elsewhere
+void EnBigokuta_Sink(EnBigokuta* this, PlayState* play);  // was func_809BE4A4 [LLM:HIGH]
 void func_809BE518(EnBigokuta* this, PlayState* play);
 // LLM generated name (HIGH), was func_809BCF68: spawns the ripple and splash trailing behind the moving octopus, with its splash sound
 void EnBigokuta_SpawnWakeSplash(EnBigokuta* this, PlayState* play);  // was func_809BCF68 [LLM:HIGH]
@@ -246,7 +247,7 @@ void EnBigokuta_SpawnWakeSplash(EnBigokuta* this, PlayState* play) {
     } else {
         rot = this->actor.shape.rot.y - this->unk_194 * 0xA00 - Rand_S16Offset(0x1200, 0xC00);
     }
-    if (this->actionFunc != func_809BE4A4) {
+    if (this->actionFunc != EnBigokuta_Sink) {  // was func_809BE4A4 [LLM:HIGH]
         if (this->actionFunc == EnBigokuta_Spin || (play->gameplayFrames & 2)) {  // was func_809BE3E4 [LLM:HIGH]
             effectPos.x = this->actor.world.pos.x - Math_SinS(rot) * 80.0f;
             effectPos.z = this->actor.world.pos.z - Math_CosS(rot) * 80.0f;
@@ -264,7 +265,7 @@ void EnBigokuta_SpawnWakeSplash(EnBigokuta* this, PlayState* play) {
         EffectSsGRipple_Spawn(play, &effectPos, 100, 500, 0);
     }
     EffectSsGSplash_Spawn(play, &effectPos, NULL, NULL, 1, 800);
-    if (this->actionFunc != func_809BE4A4) {
+    if (this->actionFunc != EnBigokuta_Sink) {  // was func_809BE4A4 [LLM:HIGH]
         Actor_PlaySfx_Flagged(&this->actor, NA_SE_EN_DAIOCTA_SPLASH - SFX_FLAG);
     }
 }
@@ -418,7 +419,7 @@ void EnBigokuta_SetupSink(EnBigokuta* this) {
     this->actor.flags &= ~ACTOR_FLAG_ATTENTION_ENABLED;
     this->cylinder[0].base.atFlags &= ~AT_ON;
     Audio_PlayActorSound2(&this->actor, NA_SE_EN_DAIOCTA_SINK);
-    this->actionFunc = func_809BE4A4;
+    this->actionFunc = EnBigokuta_Sink;  // was func_809BE4A4 [LLM:HIGH]
 }
 
 // LLM generated name (HIGH), was func_809BD7F0: re-aims the ring position at the player's side of the arena before rising
@@ -707,7 +708,7 @@ void EnBigokuta_Spin(EnBigokuta* this, PlayState* play) {
     EnBigokuta_SpawnWakeSplash(this, play);  // was func_809BCF68 [LLM:HIGH]
 }
 
-void func_809BE4A4(EnBigokuta* this, PlayState* play) {
+void EnBigokuta_Sink(EnBigokuta* this, PlayState* play) {
     this->actor.world.pos.y -= 10.0f;
     this->actor.shape.rot.y += 0x2000;
     if (this->actor.world.pos.y < (this->actor.home.pos.y + -200.0f)) {
