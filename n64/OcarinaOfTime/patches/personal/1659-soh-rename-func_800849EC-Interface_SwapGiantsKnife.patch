+++ b/soh/soh/SohGui/SohMenuEnhancements.cpp
@@ -1250,7 +1250,7 @@ void SohMenu::AddMenuEnhancements() {
             bool knifeIsBroken = gSaveContext.swordHealth == 0.0f;
 
             if (hasGiantsKnife && (hasBrokenKnife != knifeIsBroken)) {
-                func_800849EC(gPlayState);
+                Interface_SwapGiantsKnife(gPlayState);  // was func_800849EC [LLM:HIGH]
             }
         })
         .Options(
diff --git a/soh/src/code/z_parameter.c b/soh/src/code/z_parameter.c
index c9d55d9d8..433b7affd 100644
--- a/soh/src/code/z_parameter.c
+++ b/soh/src/code/z_parameter.c
@@ -1708,7 +1708,8 @@ void Interface_InitHorsebackArchery(PlayState* play) {
     }
 }
 
-void func_800849EC(PlayState* play) {
+// LLM generated name (HIGH), was func_800849EC: toggles the Giant's Knife between whole and broken in the equipment flags and puts the matching item on the B button.
+void Interface_SwapGiantsKnife(PlayState* play) {
     gSaveContext.inventory.equipment |= OWNED_EQUIP_FLAG(EQUIP_TYPE_SWORD, EQUIP_INV_SWORD_BIGGORON);
     gSaveContext.inventory.equipment ^= OWNED_EQUIP_FLAG_ALT(EQUIP_TYPE_SWORD, EQUIP_INV_SWORD_BROKENGIANTKNIFE);
 
diff --git a/soh/src/overlays/actors/ovl_En_GirlA/z_en_girla.c b/soh/src/overlays/actors/ovl_En_GirlA/z_en_girla.c
