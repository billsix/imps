From 08e929fa9ee7661ab95a36c579d7ab463fafedb0 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:16 +0000
Subject: [PATCH 0056/3799] soh: rename func_800E59AC ->
 AudioThread_SetFadeInTimer

Name source: zeldaret/oot.
Defined in soh/src/code/audio_thread.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/audio_thread.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/audio_thread.c b/soh/src/code/audio_thread.c
index 3077cb0af..622c67cb5 100644
--- a/soh/src/code/audio_thread.c
+++ b/soh/src/code/audio_thread.c
@@ -22,7 +22,7 @@ typedef enum {
 } ChannelUpdateType;
 
 void func_800E6300(SequenceChannel* channel, AudioCmd* arg1);
-void func_800E59AC(s32 playerIdx, s32 fadeTimer);
+void AudioThread_SetFadeInTimer(s32 playerIdx, s32 fadeTimer);
 void Audio_InitMesgQueues(void);
 AudioTask* AudioThread_UpdateImpl(void);
 void Audio_ProcessCmds(u32);
@@ -255,7 +255,7 @@ void AudioThread_ProcessGlobalCmd(AudioCmd* cmd) {
         case 0x82:
             // 16-bit seqId packed in opArgs bits 0-15. See Audio_StartSequence().
             AudioLoad_SyncInitSeqPlayer(cmd->arg0, cmd->opArgs & 0xFFFF, 0);
-            func_800E59AC(cmd->arg0, cmd->data);
+            AudioThread_SetFadeInTimer(cmd->arg0, cmd->data);
             return;
         case 0x85:
             AudioLoad_SyncInitSeqPlayerSkipTicks(cmd->arg0, cmd->opArgs & 0xFFFF, cmd->data);
@@ -365,7 +365,9 @@ void AudioThread_SetFadeOutTimer(s32 playerIdx, s32 fadeTimer) {
 }
 
 // SetFadeInTimer
-void func_800E59AC(s32 playerIdx, s32 fadeTimer) {
+// Name from zeldaret/oot, was func_800E59AC: mirror of fade-out; ramps seqPlayer fade volume in over [oot: https://github.com/zeldaret/oot/blob/main/src/audio/internal/thread.c]
+// fadeTimer
+void AudioThread_SetFadeInTimer(s32 playerIdx, s32 fadeTimer) {
     SequencePlayer* seqPlayer;
     if (fadeTimer != 0) {
         seqPlayer = &gAudioContext.seqPlayers[playerIdx];
-- 
