From 6cc6593cb03000cb07553c86fac88c28c5d15d99 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:10 +0000
Subject: [PATCH 3436/3799] soh: rename D_80884EC8 -> sHeavyBlockOrigin

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the zero vector BgHeavyBlock_Draw transforms
Defined in soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c b/soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c
index 187348fa5..4396d5407 100644
--- a/soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c
+++ b/soh/src/overlays/actors/ovl_Bg_Heavy_Block/z_bg_heavy_block.c
@@ -486,7 +486,7 @@ void BgHeavyBlock_Update(Actor* thisx, PlayState* play) {
 }
 
 void BgHeavyBlock_Draw(Actor* thisx, PlayState* play) {
-    static Vec3f D_80884EC8 = { 0.0f, 0.0f, 0.0f };
+    static Vec3f sHeavyBlockOrigin = { 0.0f, 0.0f, 0.0f };  // was D_80884EC8 [LLM:HIGH]
     static Vec3f D_80884ED4 = { 0.0f, 400.0f, 0.0f };
     BgHeavyBlock* this = (BgHeavyBlock*)thisx;
     s32 pad;
@@ -503,7 +503,7 @@ void BgHeavyBlock_Draw(Actor* thisx, PlayState* play) {
         Matrix_Translate(-D_80884ED4.x, -D_80884ED4.y, -D_80884ED4.z, MTXMODE_APPLY);
     }
 
-    Matrix_MultVec3f(&D_80884EC8, &thisx->world.pos);
+    Matrix_MultVec3f(&sHeavyBlockOrigin, &thisx->world.pos);  // was D_80884EC8 [LLM:HIGH]
     Matrix_MultVec3f(&D_80884ED4, &thisx->home.pos);
     Gfx_SetupDL_25Opa(play->state.gfxCtx);
 
