From ba94e9cb61164a4f612803efb925bf4cb312fe37 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:08:48 +0000
Subject: [PATCH 1996/3799] soh: rename func_808958F0 -> BgJyaCobra_RotateVecY

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: rotates src about the Y axis by a caller-supplied sine and cosine, leaving y alone
Defined in soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
index e504b58e9..8f75473d0 100644
--- a/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
+++ b/soh/src/overlays/actors/ovl_Bg_Jya_Cobra/z_bg_jya_cobra.c
@@ -113,7 +113,8 @@ static Vec3f D_80897548[] = {
     { 0.1f, 0.1f, 0.132f },
 };
 
-void func_808958F0(Vec3f* dest, Vec3f* src, f32 arg2, f32 arg3) {
+// LLM generated name (HIGH), was func_808958F0: rotates src about the Y axis by a caller-supplied sine and cosine, leaving y alone
+void BgJyaCobra_RotateVecY(Vec3f* dest, Vec3f* src, f32 arg2, f32 arg3) {
     dest->x = (src->z * arg2) + (src->x * arg3);
     dest->y = src->y;
     dest->z = (src->z * arg3) - (src->x * arg2);
@@ -197,7 +198,7 @@ void func_80895BEC(BgJyaCobra* this, PlayState* play) {
     s32 pad;
     Vec3f sp2C;
 
-    func_808958F0(&sp2C, &this->unk_174, Math_SinS(this->unk_170), Math_CosS(this->unk_170));
+    BgJyaCobra_RotateVecY(&sp2C, &this->unk_174, Math_SinS(this->unk_170), Math_CosS(this->unk_170));  // was func_808958F0 [LLM:HIGH]
     player->actor.world.pos.x = this->dyna.actor.world.pos.x + sp2C.x;
     player->actor.world.pos.y = this->dyna.actor.world.pos.y + sp2C.y;
     player->actor.world.pos.z = this->dyna.actor.world.pos.z + sp2C.z;
