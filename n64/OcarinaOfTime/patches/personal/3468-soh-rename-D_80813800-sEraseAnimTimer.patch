From 2230f007510e6176f8991c4ae80643d60d50ecce Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:14 +0000
Subject: [PATCH 3468/3799] soh: rename D_80813800 -> sEraseAnimTimer

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: counts the erase animation FileChoose_EraseAnim1 plays
Defined in soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../gamestates/ovl_file_choose/z_file_copy_erase.c        | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c b/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c
index 4f436b69c..af0a6f978 100644
--- a/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c
+++ b/soh/src/overlays/gamestates/ovl_file_choose/z_file_copy_erase.c
@@ -955,12 +955,12 @@ void FileChoose_ExitToEraseSelect2(GameState* thisx) {
  * Update function for `CM_ERASE_ANIM_1`
  */
 void FileChoose_EraseAnim1(GameState* thisx) {
-    static s16 D_80813800;
+    static s16 sEraseAnimTimer;  // was D_80813800 [LLM:HIGH]
     FileChooseContext* this = (FileChooseContext*)thisx;
 
     if (sEraseDelayTimer == 0) {
         if (this->actionTimer == 8) {
-            D_80813800 = 1;
+            sEraseAnimTimer = 1;  // was D_80813800 [LLM:HIGH]
         }
 
         if (this->actionTimer != 0) {
@@ -971,9 +971,9 @@ void FileChoose_EraseAnim1(GameState* thisx) {
             this->confirmButtonAlpha[FS_BTN_CONFIRM_QUIT] -= 25;
         }
 
-        this->fileNamesY[this->selectedFileIndex] -= D_80813800;
+        this->fileNamesY[this->selectedFileIndex] -= sEraseAnimTimer;  // was D_80813800 [LLM:HIGH]
         this->actionTimer--;
-        D_80813800 += 2;
+        sEraseAnimTimer += 2;  // was D_80813800 [LLM:HIGH]
 
         if (this->actionTimer == 0) {
             Save_DeleteFile(this->selectedFileIndex);
