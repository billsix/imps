From 2dbb90f7ac280fb1f957f082afb2ce90a0273e29 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:17:04 +0000
Subject: [PATCH 3386/3799] soh: rename D_80B41DA8 -> sPrevFlameCueAction

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the cue action EnXc_DestroyFlame last acted on, so each new one fires once
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index bd81be3b1..39165dcff 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -576,7 +576,8 @@ void EnXc_DestroyFlame(EnXc* this) {
     Actor_Kill(&this->actor);
 }
 
-static s32 D_80B41DA8 = 1;
+// LLM generated name (HIGH), was D_80B41DA8: the cue action EnXc_DestroyFlame last acted on, so each new one fires once
+static s32 sPrevFlameCueAction = 1;  // was D_80B41DA8 [LLM:HIGH]
 void EnXc_InitFlame(EnXc* this, PlayState* play) {
     s32 pad;
     s16 sceneNum = play->sceneNum;
@@ -586,7 +587,7 @@ void EnXc_InitFlame(EnXc* this, PlayState* play) {
         if (npcAction != NULL) {
             s32 action = npcAction->action;
 
-            if (D_80B41DA8 != action) {
+            if (sPrevFlameCueAction != action) {  // was D_80B41DA8 [LLM:HIGH]
                 if (action != 1) {
                     EnXc_SpawnFlame(this, play);
                 }
@@ -595,7 +596,7 @@ void EnXc_InitFlame(EnXc* this, PlayState* play) {
                     EnXc_DestroyFlame(this);
                 }
 
-                D_80B41DA8 = action;
+                sPrevFlameCueAction = action;  // was D_80B41DA8 [LLM:HIGH]
             }
 
             EnXc_SetupFlamePos(this, play);
@@ -1497,7 +1498,7 @@ static s32 D_80B41DAC = 1;
 #define EN_XC_SHIP_SAVESTATE_FIELDS(F) \
     F(sWindSfxStarted)                      \
     F(sFlameSpawned)                   \
-    F(D_80B41DA8)                      \
+    F(sPrevFlameCueAction)                      \
     F(D_80B41DAC)
 
 SHIP_SAVESTATE_DEFINE(EnXc, EN_XC_SHIP_SAVESTATE_FIELDS)
@@ -2568,6 +2569,6 @@ const ActorInit En_Xc_InitVars = {
 void EnXc_Reset(void) {
     sWindSfxStarted = 0;  // was D_80B41D90 [LLM:HIGH]
     sFlameSpawned = false;
-    D_80B41DA8 = 1;
+    sPrevFlameCueAction = 1;  // was D_80B41DA8 [LLM:HIGH]
     D_80B41DAC = 1;
 }
