From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:38:47 +0000
Subject: [PATCH 1706/3799] soh: rename D_80AFA0E8 -> sBlobRowsClass0

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the per-row half-widths of the brush used for size class 0.
Defined in soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
index e88355111..e02e4e2e9 100644
--- a/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
+++ b/soh/src/overlays/actors/ovl_En_Sda/z_en_sda.c
@@ -36,7 +36,8 @@ static s16 D_80AFA0DC[] = {
     1, 2, 3, 3, 2, 1,
 };
 
-static s16 D_80AFA0E8[] = {
+// LLM generated name (HIGH), was D_80AFA0E8: the per-row half-widths of the brush used for size class 0.
+static s16 sBlobRowsClass0[] = {  // was D_80AFA0E8 [LLM:HIGH]
     2, 3, 4, 4, 4, 3, 2, 0,
 };
 
@@ -200,7 +201,7 @@ void func_80AF8F60(Player* player, u8* shadowTexture, f32 arg2) {
                 }
             } else if (sBlobSizeClass[i] == 0) {  // was D_80AFA15C [LLM:HIGH]
                 for (j = 0, phi_a3 = -0xC0; j < 7; j++, phi_a3 += 0x40) {
-                    for (phi_a0 = -D_80AFA0E8[j]; phi_a0 < D_80AFA0E8[j] - 1; phi_a0++) {
+                    for (phi_a0 = -sBlobRowsClass0[j]; phi_a0 < sBlobRowsClass0[j] - 1; phi_a0++) {  // was D_80AFA0E8 [LLM:HIGH]
                         temp_v1 = temp_t0 + phi_a0;
                         if ((temp_v1 >= 0) && (temp_v1 < 0x40)) {
                             temp_v0 = temp_t1 + phi_a3;
@@ -312,7 +313,7 @@ void func_80AF95C4(EnSda* this, u8* shadowTexture, Player* player, PlayState* pl
 
             do {
                 for (j = 0, phi_a3 = -0xC0; j < 7; j++, phi_a3 += 0x40) {
-                    for (phi_a0 = -D_80AFA0E8[j]; phi_a0 < D_80AFA0E8[j] - 1; phi_a0++) {
+                    for (phi_a0 = -sBlobRowsClass0[j]; phi_a0 < sBlobRowsClass0[j] - 1; phi_a0++) {  // was D_80AFA0E8 [LLM:HIGH]
                         temp_v0 = temp_t0 + phi_a0;
                         if ((temp_v0 >= 0) && (temp_v0 < 0x40)) {
                             temp_v1 = temp_t1 + phi_a3;
