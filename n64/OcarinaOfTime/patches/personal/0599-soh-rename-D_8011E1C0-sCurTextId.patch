From 36e0d5aa165652b2e317410816e73e8cd5d1c602 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 15:21:09 +0000
Subject: [PATCH 0599/3799] soh: rename D_8011E1C0 -> sCurTextId

Name source: zeldaret/oot (same decomp, same ROM address).
Structure verified against upstream at 1.00.
Defined in soh/src/code/z_demo.c.
---
 soh/src/code/z_demo.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/soh/src/code/z_demo.c b/soh/src/code/z_demo.c
index e1648c6ec..4b7f29667 100644
--- a/soh/src/code/z_demo.c
+++ b/soh/src/code/z_demo.c
@@ -36,7 +36,8 @@
 #include "soh/ResourceManagerHelpers.h"
 #include "soh/Enhancements/game-interactor/GameInteractor_Hooks.h"
 
-u16 D_8011E1C0 = 0;
+// Name from zeldaret/oot (was D_8011E1C0): adopted upstream's name for this address; structure verified to match upstream (identifiers and constants differ, upstream having since renamed them) at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/code/z_demo.c]
+u16 sCurTextId = 0;
 u16 D_8011E1C4 = 0;
 
 typedef void (*CutsceneStateHandler)(PlayState*, CutsceneContext*);
@@ -1601,8 +1602,8 @@ void Cutscene_Command_Textbox(PlayState* play, CutsceneContext* csCtx, CsCmdText
 
     if ((cmd->startFrame < csCtx->frames) && (csCtx->frames <= cmd->endFrame)) {
         if (cmd->type != 2) {
-            if (D_8011E1C0 != cmd->base) {
-                D_8011E1C0 = cmd->base;
+            if (sCurTextId != cmd->base) {
+                sCurTextId = cmd->base;
                 if ((cmd->type == 3) && CHECK_QUEST_ITEM(QUEST_ZORA_SAPPHIRE)) {
                     Message_StartTextbox(play, cmd->textId1, NULL);
                 } else if ((cmd->type == 4) && CHECK_QUEST_ITEM(QUEST_GORON_RUBY)) {
@@ -1710,7 +1711,7 @@ void Cutscene_Command_Textbox(PlayState* play, CutsceneContext* csCtx, CsCmdText
 
             if (csCtx->frames == originalCsFrames) {
                 Interface_ChangeHudVisibilityMode(1);
-                D_8011E1C0 = 0;
+                sCurTextId = 0;
                 D_8011E1C4 = 0;
             }
         }
@@ -2148,7 +2149,7 @@ void Cutscene_SetupScripted(PlayState* play, CutsceneContext* csCtx) {
     if ((gSaveContext.cutsceneIndex >= 0xFFF0) && (csCtx->state == CS_STATE_IDLE)) {
         Flags_UnsetEnv(play, 0);
 
-        D_8011E1C0 = 0;
+        sCurTextId = 0;
         D_8011E1C4 = 0;
         csCtx->unk_12 = 0;
         csCtx->linkAction = NULL;
-- 
