         }
     }
 
@@ -145,7 +146,7 @@ void func_80A686A8(EnHorseGanon* this, PlayState* play) {
         } else {
             this->actor.speedXZ -= 1.0f;
         }
-    } else if (this->actor.speedXZ < D_80A69248[this->unk_1EC].unk_6) {
+    } else if (this->actor.speedXZ < sPathPoints[this->unk_1EC].unk_6) {  // was D_80A69248 [LLM:HIGH]
         this->actor.speedXZ += 0.5f;
     } else {
         this->actor.speedXZ -= 0.5f;
