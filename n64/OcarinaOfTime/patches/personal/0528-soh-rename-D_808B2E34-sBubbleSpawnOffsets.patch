     ICHAIN_F32(uncullZoneDownward, 1000, ICHAIN_STOP),
 };
 
-static Vec3f D_808B2E34[] = {
+// Name from zeldaret/oot (was D_808B2E34): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Bg_Spot11_Oasis/z_bg_spot11_oasis.c]
