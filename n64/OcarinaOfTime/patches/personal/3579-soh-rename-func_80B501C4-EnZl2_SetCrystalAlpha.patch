From 78bdadee2e5befc5b7465d28ed2060b83427d2d4 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 01:52:02 +0000
Subject: [PATCH 3579/3799] soh: rename func_80B501C4 -> EnZl2_SetCrystalAlpha

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: writes an alpha into the crystal child
Defined in soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c b/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
index c6b0cdff0..cc4764494 100644
--- a/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
+++ b/soh/src/overlays/actors/ovl_En_Zl2/z_en_zl2.c
@@ -765,7 +765,8 @@ void EnZl2_MoveAlongCue(EnZl2* this, PlayState* play) {
     }
 }
 
-void func_80B501C4(EnZl2* this, s32 alpha) {
+// LLM generated name (HIGH), was func_80B501C4: writes an alpha into the crystal child
+void EnZl2_SetCrystalAlpha(EnZl2* this, s32 alpha) {
     if (this->actor.child != NULL) {
         ((DoorWarp1*)this->actor.child)->crystalAlpha = alpha;
     }
@@ -777,7 +778,7 @@ void func_80B501E8(EnZl2* this, PlayState* play) {
     if (npcAction != NULL) {
         this->actor.shape.shadowAlpha = this->alpha =
             (1.0f - Environment_LerpWeight(npcAction->endFrame, npcAction->startFrame, play->csCtx.frames)) * 255.0f;
-        func_80B501C4(this, this->alpha);
+        EnZl2_SetCrystalAlpha(this, this->alpha);  // was func_80B501C4 [LLM:HIGH]
     }
 }
 
