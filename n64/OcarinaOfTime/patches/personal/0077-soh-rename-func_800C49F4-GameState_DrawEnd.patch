Subject: [PATCH 077/225] soh: rename func_800C49F4 -> GameState_DrawEnd

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/game.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/include/functions.h | 2 +-
 soh/src/code/game.c     | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 374cc570f..46c4424aa 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1639,7 +1639,7 @@ void GameState_SetFBFilter(Gfx** gfx);
 void GameState_DrawInputDisplay(u16 input, Gfx** gfx);
 void GameState_Draw(GameState* gameState, GraphicsContext* gfxCtx);
 void GameState_SetFrameBuffer(GraphicsContext* gfxCtx);
-// ? func_800C49F4(?);
+// ? GameState_DrawEnd(?);
 void GameState_ReqPadData(GameState* gameState);
 void GameState_Update(GameState* gameState);
 void GameState_InitArena(GameState* gameState, size_t size);
diff --git a/soh/src/code/game.c b/soh/src/code/game.c
index ed5bb042b..1ffbfcaa0 100644
--- a/soh/src/code/game.c
+++ b/soh/src/code/game.c
@@ -232,7 +232,8 @@ void GameState_SetFrameBuffer(GraphicsContext* gfxCtx) {
     CLOSE_DISPS(gfxCtx);
 }
 
-void func_800C49F4(GraphicsContext* gfxCtx) {
+// LLM generated name (HIGH), was func_800C49F4: closes the frame's display lists, branching POLY_OPA to the overlay.
+void GameState_DrawEnd(GraphicsContext* gfxCtx) {
     Gfx* newDlist;
     Gfx* polyOpaP;
 
@@ -342,7 +343,7 @@ void GameState_Update(GameState* gameState) {
 
     if (R_PAUSE_MENU_MODE != 2u) {
         GameState_Draw(gameState, gfxCtx);
-        func_800C49F4(gfxCtx);
+        GameState_DrawEnd(gfxCtx);
     }
 
     gSaveContext.language = CVarGetInteger(CVAR_SETTING("Languages"), LANGUAGE_ENG);
