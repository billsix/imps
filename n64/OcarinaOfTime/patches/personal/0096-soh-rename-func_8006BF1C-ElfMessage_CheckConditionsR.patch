From ba6cf294dea048f5a013f55059d7faaaa34a5d53 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:21 +0000
Subject: [PATCH 0096/3799] soh: rename func_8006BF1C ->
 ElfMessage_CheckConditionsRandom

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/code/z_elf_message.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/code/z_elf_message.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/z_elf_message.c b/soh/src/code/z_elf_message.c
index 516d4b3cb..ea72ac530 100644
--- a/soh/src/code/z_elf_message.c
+++ b/soh/src/code/z_elf_message.c
@@ -84,7 +84,8 @@ u32 ElfMessage_CheckConditionsAnd(ElfMessage** msgp) {
     }
 }
 
-u32 func_8006BF1C(ElfMessage** msgp) {
+// LLM generated name (HIGH), was func_8006BF1C: collects satisfied conditions and randomly selects one via Rand_ZeroFloat.
+u32 ElfMessage_CheckConditionsRandom(ElfMessage** msgp) {
     ElfMessage* msg = *msgp;
     u32 sp44[10];
     s32 temp1 = 0;
@@ -131,7 +132,7 @@ u16 ElfMessage_GetTextFromMsgs(ElfMessage* msg) {
                 }
                 break;
             case (ELF_MSG_TYPE_UNK_2 << 5):
-                if (func_8006BF1C(&msg)) {
+                if (ElfMessage_CheckConditionsRandom(&msg)) {
                     return msg->byte2 | 0x100;
                 }
                 break;
