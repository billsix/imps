Date: Mon, 7 Sep 2026 23:56:41 +0000
Subject: [PATCH 2874/3799] soh: rename func_80B3C964 ->
 EnXc_ResetAndApplyRootMotion

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: rebases the root motion on the current joint before queueing it
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 1b0dc9f5c..7f67fd801 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -263,7 +263,8 @@ void EnXc_ApplyRootMotion(EnXc* this, PlayState* play) {
     AnimationContext_SetMoveActor(play, &this->actor, &this->skelAnime, 1.0f);
 }
 
-void func_80B3C964(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B3C964: rebases the root motion on the current joint before queueing it
+void EnXc_ResetAndApplyRootMotion(EnXc* this, PlayState* play) {
     this->skelAnime.baseTransl = this->skelAnime.jointTable[0];
     this->skelAnime.prevTransl = this->skelAnime.jointTable[0];
     this->skelAnime.movementFlags |= 3;
@@ -702,7 +703,7 @@ void EnXc_SetupFallFromSkyAction(EnXc* this, PlayState* play) {
             pos->z = npcAction->startPos.z;
 
             func_80B3D48C(this, play);
-            func_80B3C964(this, play);
+            EnXc_ResetAndApplyRootMotion(this, play);  // was func_80B3C964 [LLM:HIGH]
             Animation_Change(skelAnime, &gSheikFallingFromSkyAnim, 1.0f, 0.0f, frameCount, ANIMMODE_ONCE, 0.0f);
             func_80B3D118(play);
         }
@@ -1869,7 +1870,7 @@ void EnXc_SetupContortions(EnXc* this, PlayState* play) {
 
     Animation_Change(skelAnime, &gSheikIdleAnim, 1.0f, 0.0f, frameCount, ANIMMODE_LOOP, 0.0f);
     EnXc_SetPosRotFromCue(this, play, 4);  // was func_80B3C588 [LLM:HIGH]
-    func_80B3C964(this, play);
+    EnXc_ResetAndApplyRootMotion(this, play);  // was func_80B3C964 [LLM:HIGH]
     Animation_Change(skelAnime, &gSheikContortionsAnim, 1.0f, 0.0f, Animation_GetLastFrame(&gSheikContortionsAnim),
                      ANIMMODE_ONCE, 0.0f);
     this->action = SHEIK_ACTION_CONTORT;
@@ -1884,7 +1885,7 @@ void EnXc_SetupFallInNocturne(EnXc* this, PlayState* play) {
 
     Animation_Change(skelAnime, &gSheikIdleAnim, 1.0f, 0.0f, frameCount, ANIMMODE_LOOP, 0.0f);
     EnXc_SetPosRotFromCue(this, play, 4);  // was func_80B3C588 [LLM:HIGH]
-    func_80B3C964(this, play);
+    EnXc_ResetAndApplyRootMotion(this, play);  // was func_80B3C964 [LLM:HIGH]
     Animation_Change(skelAnime, &gSheikFallingFromContortionsAnim, 1.0f, 0.0f,
                      Animation_GetLastFrame(&gSheikFallingFromContortionsAnim), ANIMMODE_ONCE, 0.0f);
     this->action = SHEIK_ACTION_NOCTURNE_FALL;
