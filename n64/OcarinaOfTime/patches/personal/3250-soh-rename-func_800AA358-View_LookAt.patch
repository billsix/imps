From f77d227d082a33571c249329812bedb05210fb21 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:09:39 +0000
Subject: [PATCH 3250/3799] soh: rename func_800AA358 -> View_LookAt

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: stores the eye, look-at and up vectors, nudging the eye off a perfectly vertical line first
Defined in soh/src/code/z_view.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h                                       | 2 +-
 soh/src/code/z_camera.c                                       | 4 ++--
 soh/src/code/z_parameter.c                                    | 2 +-
 soh/src/code/z_sample.c                                       | 2 +-
 soh/src/code/z_view.c                                         | 3 ++-
 soh/src/overlays/gamestates/ovl_file_choose/z_file_choose.c   | 2 +-
 soh/src/overlays/gamestates/ovl_title/z_title.c               | 2 +-
 soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c | 2 +-
 8 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index a43fc36b6..0e548117d 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -1394,7 +1394,7 @@ void Rumble_SetUpdateEnabled(u32);  // was func_800AA178 [oot]
 View* View_New(GraphicsContext* gfxCtx);
 void View_Free(View* view);
 void View_Init(View*, GraphicsContext*);
-void func_800AA358(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up);
+void View_LookAt(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up);  // was func_800AA358 [LLM:HIGH]
 void func_800AA3F0(View* view, Vec3f* eye, Vec3f* lookAt, Vec3f* up);
 void View_SetScale(View* view, f32 scale);
 void View_GetScale(View* view, f32* scale);
