Date: Mon, 7 Sep 2026 15:02:45 +0000
Subject: [PATCH 439/784] soh: rename func_80AEC6E4 -> EnRu1_RespondToFalling

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.87.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index 57cc3f263..79116ce68 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -874,7 +874,8 @@ void EnRu1_PlayFallingSfx(EnRu1* this) {
     Sfx_PlaySfxAtPos(&this->actor.projectedPos, NA_SE_VO_RT_FALL);
 }
 
-void func_80AEC6E4(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEC6E4): adopted upstream's name for this address; body verified to match upstream at 0.87. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_RespondToFalling(EnRu1* this, PlayState* play) {
     if ((func_80AEAFA0(play, 4, 3)) && (this->isFalling == 0)) {
         Animation_Change(&this->skelAnime, &gRutoChildBringArmsUpAnim, 1.0f, 0,
                          Animation_GetLastFrame(&gRutoChildBringArmsUpAnim), ANIMMODE_ONCE, -8.0f);
@@ -996,7 +997,7 @@ void func_80AECB60(EnRu1* this, PlayState* play) {
 
 void func_80AECBB8(EnRu1* this, PlayState* play) {
     EnRu1_MoveForwardConstant(this);
-    func_80AEC6E4(this, play);
+    EnRu1_RespondToFalling(this, play);
     EnRu1_UpdateSkelAnime(this);
     EnRu1_UpdateEyes(this);
     EnRu1_UpdateBgCheckInfo(this, play);
@@ -1006,7 +1007,7 @@ void func_80AECBB8(EnRu1* this, PlayState* play) {
 
 void func_80AECC1C(EnRu1* this, PlayState* play) {
     EnRu1_AccelerateDownHole(this);
-    func_80AEC6E4(this, play);
+    EnRu1_RespondToFalling(this, play);
     EnRu1_UpdateSkelAnime(this);
     EnRu1_UpdateEyes(this);
     EnRu1_UpdateBgCheckInfo(this, play);
