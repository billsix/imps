From ea5f06474073e2ae523752d3a266b2c427337316 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:08:49 +0000
Subject: [PATCH 3237/3799] soh: rename D_8082AE30 -> sAreaGsIndices

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: maps a world map cursor position onto the gold skulltula area index
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c       | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
index ec383f451..0ddd85851 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_scope_PAL.c
@@ -1966,7 +1966,7 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
     static s16 sUnusedAreaIndices[] = {  // was D_8082AE08 [LLM:GUESS]
         10, 16, 16, 17, 12, 13, 18, 17, 17, 19, 13, 21, 20, 21, 14, 15, 15, 15, 11, 14,
     };
-    static s16 D_8082AE30[] = {
+    static s16 sAreaGsIndices[] = {  // was D_8082AE30 [LLM:HIGH]
         21, 20, 19, 18, 11, 14, 10, 15, 16, 13, 12, 17,
     };
     static s16 D_808321A0;
@@ -2207,14 +2207,14 @@ void KaleidoScope_DrawInfoPanel(PlayState* play) {
                 osSyncPrintf(VT_RST);
 
                 YREG(7) = 0;
-                SET_GS_FLAGS(D_8082AE30[pauseCtx->cursorPoint[PAUSE_WORLD_MAP]],
-                             gAreaGsFlags[D_8082AE30[pauseCtx->cursorPoint[PAUSE_WORLD_MAP]]]);
+                SET_GS_FLAGS(sAreaGsIndices[pauseCtx->cursorPoint[PAUSE_WORLD_MAP]],  // was D_8082AE30 [LLM:HIGH]
+                             gAreaGsFlags[sAreaGsIndices[pauseCtx->cursorPoint[PAUSE_WORLD_MAP]]]);  // was D_8082AE30 [LLM:HIGH]
             }
         }
 
         if ((pauseCtx->pageIndex == PAUSE_MAP) && !sInDungeonScene) {
-            if (GET_GS_FLAGS(D_8082AE30[pauseCtx->cursorPoint[PAUSE_WORLD_MAP]]) ==
-                gAreaGsFlags[D_8082AE30[pauseCtx->cursorPoint[PAUSE_WORLD_MAP]]]) {
+            if (GET_GS_FLAGS(sAreaGsIndices[pauseCtx->cursorPoint[PAUSE_WORLD_MAP]]) ==  // was D_8082AE30 [LLM:HIGH]
+                gAreaGsFlags[sAreaGsIndices[pauseCtx->cursorPoint[PAUSE_WORLD_MAP]]]) {  // was D_8082AE30 [LLM:HIGH]
 
                 pauseCtx->infoPanelVtx[24].v.ob[0] = pauseCtx->infoPanelVtx[26].v.ob[0] = -74;
 
