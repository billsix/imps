From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:44:18 +0000
Subject: [PATCH 1809/3799] soh: rename func_800ADBB0 -> Skybox_BuildRoomFace

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: generates the vertices and quads of one room-skybox face into roomVtx and the display list buffer, returning the next free vertex index.
Defined in soh/src/code/z_vr_box.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_vr_box.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/code/z_vr_box.c b/soh/src/code/z_vr_box.c
index 138168639..950e7531b 100644
--- a/soh/src/code/z_vr_box.c
+++ b/soh/src/code/z_vr_box.c
@@ -165,7 +165,8 @@ Struct_8012AF0C sSkyFaceParams[6] = {  // was D_8012AF0C [LLM:HIGH]
     { 0x40, 0x40, -0x40, 0x20, -0x20 },  { -0x40, 0x40, 0x40, 0x20, -0x20 }, { -0x40, -0x40, -0x40, 0x20, 0x20 },
 };
 
-s32 func_800ADBB0(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s32 arg4, s32 arg5, s32 arg6, s32 arg7,
+// LLM generated name (HIGH), was func_800ADBB0: generates the vertices and quads of one room-skybox face into roomVtx and the display list buffer, returning the next free vertex index.
+s32 Skybox_BuildRoomFace(SkyboxContext* skyboxCtx, Vtx* roomVtx, s32 arg2, s32 arg3, s32 arg4, s32 arg5, s32 arg6, s32 arg7,
                   s32 arg8, s32 arg9) {
     u32 pad42C;
     s32 pad428;
@@ -438,17 +439,17 @@ void func_800AEFC8(SkyboxContext* skyboxCtx, s16 skyboxId) {
     if (skyboxId == SKYBOX_BAZAAR || skyboxId == SKYBOX_HAPPY_MASK_SHOP ||
         (skyboxId >= SKYBOX_KOKIRI_SHOP && skyboxId <= SKYBOX_BOMBCHU_SHOP)) {
         for (j = 0, i = 0; i < 2; i++, j += 2) {
-            phi_s3 = func_800ADBB0(skyboxCtx, skyboxCtx->roomVtx, phi_s3, sRoomFaceParams[i].unk_0, sRoomFaceParams[i].unk_4,  // was D_8012AEBC [LLM:HIGH]
+            phi_s3 = Skybox_BuildRoomFace(skyboxCtx, skyboxCtx->roomVtx, phi_s3, sRoomFaceParams[i].unk_0, sRoomFaceParams[i].unk_4,  // was D_8012AEBC [LLM:HIGH]
                                    sRoomFaceParams[i].unk_8, sRoomFaceParams[i].unk_C, sRoomFaceParams[i].unk_10, i, j);  // was D_8012AEBC [LLM:HIGH]
         }
     } else if (skyboxCtx->unk_140 == 2) {
         for (j = 0, i = 0; i < 3; i++, j += 2) {
-            phi_s3 = func_800ADBB0(skyboxCtx, skyboxCtx->roomVtx, phi_s3, sRoomFaceParams[i].unk_0, sRoomFaceParams[i].unk_4,  // was D_8012AEBC [LLM:HIGH]
+            phi_s3 = Skybox_BuildRoomFace(skyboxCtx, skyboxCtx->roomVtx, phi_s3, sRoomFaceParams[i].unk_0, sRoomFaceParams[i].unk_4,  // was D_8012AEBC [LLM:HIGH]
                                    sRoomFaceParams[i].unk_8, sRoomFaceParams[i].unk_C, sRoomFaceParams[i].unk_10, i, j);  // was D_8012AEBC [LLM:HIGH]
         }
     } else {
         for (j = 0, i = 0; i < 4; i++, j += 2) {
-            phi_s3 = func_800ADBB0(skyboxCtx, skyboxCtx->roomVtx, phi_s3, sRoomFaceParams[i].unk_0, sRoomFaceParams[i].unk_4,  // was D_8012AEBC [LLM:HIGH]
+            phi_s3 = Skybox_BuildRoomFace(skyboxCtx, skyboxCtx->roomVtx, phi_s3, sRoomFaceParams[i].unk_0, sRoomFaceParams[i].unk_4,  // was D_8012AEBC [LLM:HIGH]
                                    sRoomFaceParams[i].unk_8, sRoomFaceParams[i].unk_C, sRoomFaceParams[i].unk_10, i, j);  // was D_8012AEBC [LLM:HIGH]
         }
     }
