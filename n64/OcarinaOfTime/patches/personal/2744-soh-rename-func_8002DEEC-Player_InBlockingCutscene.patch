From f1bb887f17a24803c76246dc0a55f3fe1cbf444e Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:49:31 +0000
Subject: [PATCH 2744/3799] soh: rename func_8002DEEC ->
 Player_InBlockingCutscene

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: true when the player is dead, in a cutscene, or running a csAction
Defined in soh/src/code/z_actor.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h                                        | 2 +-
 soh/src/code/z_actor.c                                         | 3 ++-
 .../overlays/actors/ovl_Obj_Makekinsuta/z_obj_makekinsuta.c    | 2 +-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 603da52f4..b122013f3 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -426,7 +426,7 @@ s32 Player_IsOnStationaryLadder(PlayState* play);  // was func_8002DDF4 [LLM:HIG
 void Actor_SwapHookshotAttachment(PlayState* play, Actor* actorA, Actor* actorB);
 void Actor_RequestHorseCameraSetting(PlayState* play, Player* player);
 void Actor_MountHorse(PlayState* play, Player* player, Actor* horse);
-s32 func_8002DEEC(Player* player);
+s32 Player_InBlockingCutscene(Player* player);  // was func_8002DEEC [LLM:HIGH]
 void Actor_InitPlayerHorse(PlayState* play, Player* player);
 s32 Player_SetCsAction(PlayState* play, Actor* actor, u8 csMode);
 s32 Player_SetCsActionWithHaltedActors(PlayState* play, Actor* actor, u8 arg2);
diff --git a/soh/src/code/z_actor.c b/soh/src/code/z_actor.c
index 7c6e73afb..7e994c80b 100644
--- a/soh/src/code/z_actor.c
+++ b/soh/src/code/z_actor.c
@@ -1475,7 +1475,8 @@ void Actor_MountHorse(PlayState* play, Player* player, Actor* horse) {
     horse->child = &player->actor;
 }
 
-s32 func_8002DEEC(Player* player) {
+// LLM generated name (HIGH), was func_8002DEEC: true when the player is dead, in a cutscene, or running a csAction
+s32 Player_InBlockingCutscene(Player* player) {
     return (player->stateFlags1 & (PLAYER_STATE1_DEAD | PLAYER_STATE1_IN_CUTSCENE)) || (player->csAction != 0);
 }
 
diff --git a/soh/src/overlays/actors/ovl_Obj_Makekinsuta/z_obj_makekinsuta.c b/soh/src/overlays/actors/ovl_Obj_Makekinsuta/z_obj_makekinsuta.c
index 1bf028da4..663727f40 100644
--- a/soh/src/overlays/actors/ovl_Obj_Makekinsuta/z_obj_makekinsuta.c
+++ b/soh/src/overlays/actors/ovl_Obj_Makekinsuta/z_obj_makekinsuta.c
@@ -50,7 +50,7 @@ void ObjMakekinsuta_Init(Actor* thisx, PlayState* play) {
 // LLM generated name (HIGH), was func_80B98320: action func waiting on timer>=60 to spawn skulltula (ACTOR_EN_SW)
 void ObjMakekinsuta_WaitToSpawn(ObjMakekinsuta* this, PlayState* play) {
     if (this->unk_152 != 0) {
-        if (GameInteractor_Should(VB_SPAWN_BEAN_SKULLTULA, this->timer >= 60) && !func_8002DEEC(GET_PLAYER(play))) {
+        if (GameInteractor_Should(VB_SPAWN_BEAN_SKULLTULA, this->timer >= 60) && !Player_InBlockingCutscene(GET_PLAYER(play))) {  // was func_8002DEEC [LLM:HIGH]
             Actor_Spawn(&play->actorCtx, play, ACTOR_EN_SW, this->actor.world.pos.x, this->actor.world.pos.y,
                         this->actor.world.pos.z, 0, this->actor.shape.rot.y, 0, (this->actor.params | 0x8000));
             this->actionFunc = ObjMakekinsuta_DoNothing;
