From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:13 +0000
Subject: [PATCH 3453/3799] soh: rename D_8082A6D4 -> sWorldMapScroll

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the scroll it advances each frame
Defined in soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_map_PAL.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../misc/ovl_kaleido_scope/z_kaleido_map_PAL.c       | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_map_PAL.c b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_map_PAL.c
index 4c0ae6f02..c01ce79a8 100644
--- a/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_map_PAL.c
+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_map_PAL.c
@@ -441,7 +441,7 @@ void KaleidoScope_DrawWorldMap(PlayState* play, GraphicsContext* gfxCtx) {
         gPauseCurrentPositionFRATex,
         gPauseCurrentPositionJPNTex,
     };
-    static u16 D_8082A6D4 = 0;
+    static u16 sWorldMapScroll = 0;  // was D_8082A6D4 [LLM:HIGH]
     PauseContext* pauseCtx = &play->pauseCtx;
     Input* input = &play->state.input[0];
     s16 i;
@@ -467,7 +467,7 @@ void KaleidoScope_DrawWorldMap(PlayState* play, GraphicsContext* gfxCtx) {
                  ((pauseCtx->stickRelX > 30) || (dpad && CHECK_BTN_ALL(input->press.button, BTN_DRIGHT)))) ||
                 (mirroredWorld &&
                  ((pauseCtx->stickRelX < -30) || (dpad && CHECK_BTN_ALL(input->press.button, BTN_DLEFT))))) {
-                D_8082A6D4 = 0;
+                sWorldMapScroll = 0;  // was D_8082A6D4 [LLM:HIGH]
 
                 do {
                     pauseCtx->cursorPoint[PAUSE_WORLD_MAP]++;
@@ -482,7 +482,7 @@ void KaleidoScope_DrawWorldMap(PlayState* play, GraphicsContext* gfxCtx) {
                         ((pauseCtx->stickRelX < -30) || (dpad && CHECK_BTN_ALL(input->press.button, BTN_DLEFT)))) ||
                        (mirroredWorld &&
                         ((pauseCtx->stickRelX > 30) || (dpad && CHECK_BTN_ALL(input->press.button, BTN_DRIGHT))))) {
-                D_8082A6D4 = 0;
+                sWorldMapScroll = 0;  // was D_8082A6D4 [LLM:HIGH]
 
                 do {
                     pauseCtx->cursorPoint[PAUSE_WORLD_MAP]--;
