From f5cb6e20acdb94dfa9ba5f1130df0a8f8b259c91 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:29 +0000
Subject: [PATCH 0161/3799] soh: rename D_809982D4 -> sBossDoorTextures

Name source: zeldaret/oot.
Defined in soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c b/soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c
index 641975aed..320c66d47 100644
--- a/soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c
+++ b/soh/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c
@@ -179,7 +179,8 @@ static Gfx* sJabuDoorDLists[] = {
     gJabuDoorSection5DL, gJabuDoorSection4DL, gJabuDoorSection3DL, gJabuDoorSection2DL,
 };
 
-static void* D_809982D4[] = {
+// Name from zeldaret/oot, was D_809982D4: array of boss-door textures indexed by bossDoorTexIndex during draw [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c]
+static void* sBossDoorTextures[] = {
     gBossDoorDefaultTex,      gBossDoorFireTex,   gBossDoorWaterTex,  gBossDoorShadowTex,
     gBossDoorGanonsCastleTex, gBossDoorForestTex, gBossDoorSpiritTex,
 };
@@ -765,7 +766,7 @@ void DoorShutter_Draw(Actor* thisx, PlayState* play) {
                     Matrix_RotateY(M_PI, MTXMODE_APPLY);
                 }
             } else if (this->doorType == SHUTTER_BOSS) {
-                gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(D_809982D4[this->bossDoorTexIndex]));
+                gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(sBossDoorTextures[this->bossDoorTexIndex]));
             }
             gSPMatrix(POLY_OPA_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
             gSPDisplayList(POLY_OPA_DISP++, sp70->a);
