From 8567bcb8159ea1043c47eb9af4ef616c4c986075 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 13:35:34 +0000
Subject: [PATCH 209/784] soh: rename D_80B7A6B0 -> sRodBendApproachRateY

Name source: deduced from the code (confidence HIGH).
Defined in soh/src/overlays/actors/ovl_Fishing/z_fishing.c.

Provenance comments accompany the definition and every header declaration,
so the name can be re-derived or overturned later. See
tasks/reference/ocarina/decomp-renaming.md.
---
 soh/src/overlays/actors/ovl_Fishing/z_fishing.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
index 53ffeff2f..40b4198db 100644
--- a/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
+++ b/soh/src/overlays/actors/ovl_Fishing/z_fishing.c
@@ -185,7 +185,8 @@ static u8 sReelCatchTimer = 0;
 static f32 sRodBendRotY = 0.0f;
 // LLM generated name (HIGH), was D_80B7A6AC: X counterpart of sRodBendRotY; rod-bend angle used when drawing rod
 static f32 sRodBendRotX = 0.0f;
-static f32 D_80B7A6B0 = 0.0f;
+// LLM generated name (HIGH), was D_80B7A6B0: Math_ApproachF step rate for sRodBendRotY; ramps toward 1.0
+static f32 sRodBendApproachRateY = 0.0f;
 static f32 D_80B7A6B4 = 0.0f;
 static f32 D_80B7A6B8 = 0.0f;
 static f32 D_80B7A6BC = 0.0f;
@@ -2018,7 +2019,7 @@ void Fishing_DrawRod(PlayState* play) {
 
     if ((sRodCastState == 3) || (sRodCastState == 4)) {
         if ((input->rel.stick_x == 0) && (sStickAdjXPrev != 0)) {
-            D_80B7A6B0 = 0.0f;
+            sRodBendApproachRateY = 0.0f;
         }
         if ((input->rel.stick_y == 0) && (sStickAdjYPrev != 0)) {
             D_80B7A6B4 = 0.0f;
@@ -2047,8 +2048,8 @@ void Fishing_DrawRod(PlayState* play) {
             player->unk_85C = -1.0f;
         }
 
-        Math_ApproachF(&sRodBendRotY, spC4 * 70.0f * -0.01f, 1.0f, D_80B7A6B0);
-        Math_ApproachF(&D_80B7A6B0, 1.0f, 1.0f, 0.1f);
+        Math_ApproachF(&sRodBendRotY, spC4 * 70.0f * -0.01f, 1.0f, sRodBendApproachRateY);
+        Math_ApproachF(&sRodBendApproachRateY, 1.0f, 1.0f, 0.1f);
         Math_ApproachF(&sRodBendRotX, lureXZLen * 70.0f * 0.01f, 1.0f, D_80B7A6B4);
         Math_ApproachF(&D_80B7A6B4, 1.0f, 1.0f, 0.1f);
         Math_ApproachZeroF(&D_80B7A6B8, 1.0f, 0.05f);
