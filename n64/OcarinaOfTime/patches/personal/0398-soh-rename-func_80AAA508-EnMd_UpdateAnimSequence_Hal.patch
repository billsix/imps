@@ -168,7 +168,8 @@ void EnMd_UpdateAnimSequence_TwitchIdle_Unused(EnMd* this) {
     }
 }
 
-void func_80AAA508(EnMd* this) {
+// Name from zeldaret/oot (was func_80AAA508): adopted upstream's name for this address; body verified to match upstream at 0.89. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Md/z_en_md.c]
+void EnMd_UpdateAnimSequence_HaltToIdle(EnMd* this) {
     switch (this->animSequenceEntry) {
         case 0:
             Animation_ChangeByInfo(&this->skelAnime, sAnimationInfo, ENMD_ANIM_2);
@@ -282,7 +283,7 @@ void EnMd_UpdateAnimSequence(EnMd* this) {
             EnMd_UpdateAnimSequence_TwitchIdle_Unused(this);
             break;
         case 5:
-            func_80AAA508(this);
+            EnMd_UpdateAnimSequence_HaltToIdle(this);
             break;
         case 6:
             func_80AAA5A4(this);
