From fe8d15f9ef1db14bb294f64a5896db1673782b96 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:07:03 +0000
Subject: [PATCH 3181/3799] soh: rename D_8011D3CC -> sAttentionPitchOffsets

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the pitch offsets tried alongside them
Defined in soh/src/code/z_camera_data.inc.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/z_camera.c        | 4 ++--
 soh/src/code/z_camera_data.inc | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/code/z_camera.c b/soh/src/code/z_camera.c
index 5c0f3f200..12b11392c 100644
--- a/soh/src/code/z_camera.c
+++ b/soh/src/code/z_camera.c
@@ -3602,7 +3602,7 @@ s32 Camera_KeepOn3(Camera* camera) {
                     break;
                 }
                 atToEyeAdj.yaw = sp80 + sAttentionYawOffsets[i];  // was D_8011D3B0 [LLM:HIGH]
-                atToEyeAdj.pitch = sp82 + D_8011D3CC[i];
+                atToEyeAdj.pitch = sp82 + sAttentionPitchOffsets[i];  // was D_8011D3CC [LLM:HIGH]
                 Camera_Vec3fVecSphGeoAdd(&lineChkPointB, &anim->atTarget, &atToEyeAdj);
                 i++;
             }
@@ -3885,7 +3885,7 @@ s32 Camera_KeepOn4(Camera* camera) {
                         break;
                     }
                     spB8.yaw = sAttentionYawOffsets[i] + spA0;  // was D_8011D3B0 [LLM:HIGH]
-                    spB8.pitch = D_8011D3CC[i] + spA2;
+                    spB8.pitch = sAttentionPitchOffsets[i] + spA2;  // was D_8011D3CC [LLM:HIGH]
                     Camera_Vec3fVecSphGeoAdd(&sKeepOn4ScratchC, &sKeepOn4ScratchA, &spB8);  // was D_8015BD50 [LLM:GUESS]
                 }
                 osSyncPrintf("camera: item: BG&collision check %d time(s)\n", i);
diff --git a/soh/src/code/z_camera_data.inc b/soh/src/code/z_camera_data.inc
index 9ead07de6..ea6932ed3 100644
--- a/soh/src/code/z_camera_data.inc
+++ b/soh/src/code/z_camera_data.inc
@@ -2238,7 +2238,8 @@ s16 sAttentionYawOffsets[] = {  // was D_8011D3B0 [LLM:HIGH]
     0x0AAA, 0xF556, 0x1555, 0xEAAB, 0x2AAA, 0xD556, 0x3FFF, 0xC001, 0x5555, 0xAAAB, 0x6AAA, 0x9556, 0x7FFF, 0x0000,
 };
 
-s16 D_8011D3CC[] = {
+// LLM generated name (HIGH), was D_8011D3CC: the pitch offsets tried alongside them
+s16 sAttentionPitchOffsets[] = {  // was D_8011D3CC [LLM:HIGH]
     0x0000, 0x02C6, 0x058C, 0x0000, 0x0000, 0xFD3A, 0x0000, 0x0852, 0x0000, 0x0000, 0x0B18, 0x02C6, 0xFA74, 0x0000,
 };
 
