From e8dabfef19c887a1bd98a8cce9fa60df851292ab Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 20:20:57 +0000
Subject: [PATCH 0859/3799] soh: rename func_80001F8C ->
 Locale_IsForeignRegionWithCtrlr3

Name source: DEDUCED from the code (confidence GUESS) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the complement of Locale_IsForeignRegionWithoutCtrlr3 -- true when the region is not native AND a controller IS in port 3. Also unused; named for the test, not a supposed purpose.
Defined in soh/src/boot/z_locale.c.

Tagged [LLM:GUESS] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/include/functions.h | 2 +-
 soh/src/boot/z_locale.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/include/functions.h b/soh/include/functions.h
index 61cd9f284..b4a484b65 100644
--- a/soh/include/functions.h
+++ b/soh/include/functions.h
@@ -57,7 +57,7 @@ void Yaz0_Decompress(uintptr_t romStart, void* dst, size_t size);
 void Locale_Init(void);
 void Locale_ResetRegion(void);
 u32 Locale_IsForeignRegionWithoutCtrlr3(void);  // was func_80001F48 [LLM:GUESS]
-u32 func_80001F8C(void);
+u32 Locale_IsForeignRegionWithCtrlr3(void);  // was func_80001F8C [LLM:GUESS]
 u32 Locale_IsRegionNative(void);
 #ifdef __WIIU__
 void _assert(const char* exp, const char* file, s32 line);
diff --git a/soh/src/boot/z_locale.c b/soh/src/boot/z_locale.c
index a828cf30c..d37c3cadb 100644
--- a/soh/src/boot/z_locale.c
+++ b/soh/src/boot/z_locale.c
@@ -46,7 +46,8 @@ u32 Locale_IsForeignRegionWithoutCtrlr3(void) {
     return 1;
 }
 
-u32 func_80001F8C(void) {
+// LLM generated name (GUESS), was func_80001F8C: the complement of Locale_IsForeignRegionWithoutCtrlr3 -- true when the region is not native AND a controller IS in port 3. Also unused; named for the test, not a supposed purpose.
+u32 Locale_IsForeignRegionWithCtrlr3(void) {
     if (gCurrentRegion == REGION_NATIVE) {
         return 0;
     }
