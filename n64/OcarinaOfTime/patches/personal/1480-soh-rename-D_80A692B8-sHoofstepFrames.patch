From c26e5753153883eebb34bd82723521cd059bc3d7 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:22:44 +0000
Subject: [PATCH 1480/3799] soh: rename D_80A692B8 -> sHoofstepFrames

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the two animation frames at which the walking hoofstep sfx fires, stepped through by soundCount.
Defined in soh/src/overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 .../overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c b/soh/src/overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c
index a257d1f10..975af2dbf 100644
--- a/soh/src/overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c
+++ b/soh/src/overlays/actors/ovl_En_Horse_Ganon/z_en_horse_ganon.c
@@ -101,7 +101,8 @@ static unk_D_80A69248 sPathPoints[] = {  // was D_80A69248 [LLM:HIGH]
     { 0xF47B, 0xFFDD, 0x11AF, 0x07 }, { 0xF88D, 0xFFD1, 0x0BA2, 0x07 },
 };
 
-static s32 D_80A692B8[] = { 0, 16 };
+// LLM generated name (HIGH), was D_80A692B8: the two animation frames at which the walking hoofstep sfx fires, stepped through by soundCount.
+static s32 sHoofstepFrames[] = { 0, 16 };  // was D_80A692B8 [LLM:HIGH]
 
 static InitChainEntry sInitChain[] = {
     ICHAIN_F32(uncullZoneScale, 1200, ICHAIN_STOP),
@@ -154,8 +155,8 @@ void func_80A686A8(EnHorseGanon* this, PlayState* play) {
 }
 
 void func_80A68870(EnHorseGanon* this) {
-    if ((this->skin.skelAnime.curFrame > D_80A692B8[this->soundCount]) &&
-        (this->soundCount != 0 || !(this->skin.skelAnime.curFrame > D_80A692B8[1]))) {
+    if ((this->skin.skelAnime.curFrame > sHoofstepFrames[this->soundCount]) &&  // was D_80A692B8 [LLM:HIGH]
+        (this->soundCount != 0 || !(this->skin.skelAnime.curFrame > sHoofstepFrames[1]))) {  // was D_80A692B8 [LLM:HIGH]
         Audio_PlaySfxGeneral(NA_SE_EV_HORSE_WALK, &this->actor.projectedPos, 4, &gSfxDefaultFreqAndVolScale,
                              &gSfxDefaultFreqAndVolScale, &gSfxDefaultReverb);
 
