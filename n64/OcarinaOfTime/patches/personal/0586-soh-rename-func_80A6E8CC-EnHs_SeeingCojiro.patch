Date: Mon, 7 Sep 2026 15:12:15 +0000
Subject: [PATCH 586/784] soh: rename func_80A6E8CC -> EnHs_SeeingCojiro

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 0.82.
Defined in soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c.
---
 soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c b/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
index b0c394bb4..096b8e84b 100644
--- a/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
+++ b/soh/src/overlays/actors/ovl_En_Hs/z_en_hs.c
@@ -194,7 +194,8 @@ void EnHs_OddMushroomChoice(EnHs* this, PlayState* play) {
     this->unk_2A8 |= 1;
 }
 
-void func_80A6E8CC(EnHs* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80A6E8CC): adopted upstream's name for this address; body verified to match upstream at 0.82. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Hs/z_en_hs.c]
+void EnHs_SeeingCojiro(EnHs* this, PlayState* play) {
     Player* player = GET_PLAYER(play);
 
     if ((Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT) && Message_ShouldAdvance(play)) {
@@ -221,7 +222,7 @@ void EnHs_SleepingInteract(EnHs* this, PlayState* play) {
     if (Actor_ProcessTalkRequest(&this->actor, play)) {
         if (Actor_GetPlayerExchangeItemId(play) == 7) {
             player->actor.textId = 0x10B2;
-            EnHs_SetActionFunc(this, func_80A6E8CC);
+            EnHs_SetActionFunc(this, EnHs_SeeingCojiro);
             Animation_Change(&this->skelAnime, &object_hs_Anim_000304, 1.0f, 0.0f,
                              Animation_GetLastFrame(&object_hs_Anim_000304), ANIMMODE_LOOP, 8.0f);
             this->unk_2AA = 40;
