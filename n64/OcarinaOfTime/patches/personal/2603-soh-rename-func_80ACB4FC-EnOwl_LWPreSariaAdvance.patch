     if (Message_GetState(&play->msgCtx) == TEXT_STATE_EVENT && Message_ShouldAdvance(play)) {
         Message_ContinueTextbox(play, 0x10C2);
         this->actionFunc = EnOwl_LWPreSariaChoice;  // was func_80ACB440 [LLM:HIGH]
@@ -714,7 +715,7 @@ void EnOwl_WaitLWPreSaria(EnOwl* this, PlayState* play) {
 
     if (EnOwl_CheckInitTalk(this, play, 0x10C0, 190.0f, 0)) {
         Audio_PlayFanfare(NA_BGM_OWL);
-        this->actionFunc = func_80ACB4FC;
+        this->actionFunc = EnOwl_LWPreSariaAdvance;  // was func_80ACB4FC [LLM:HIGH]
     }
 }
 
