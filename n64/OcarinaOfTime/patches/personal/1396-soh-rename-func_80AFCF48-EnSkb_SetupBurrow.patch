From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:16:31 +0000
Subject: [PATCH 1396/3799] soh: rename func_80AFCF48 -> EnSkb_SetupBurrow

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: plays the uncurling animation in reverse with the hiding sfx and installs the burrowing action.
Defined in soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
index 3cd2fab1f..2a206c053 100644
--- a/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
+++ b/soh/src/overlays/actors/ovl_En_Skb/z_en_skb.c
@@ -16,7 +16,8 @@ void EnSkb_ChooseAction(EnSkb* this);  // was func_80AFCD60 [LLM:HIGH]
 void EnSkb_SetupEmerge(EnSkb* this);  // was func_80AFCDF8 [LLM:HIGH]
 // LLM generated name (HIGH), was func_80AFCE5C: raises the Stalchild out of the ground, growing its shadow and throwing debris, and once it is fully up hands over to EnSkb_ChooseAction.
 void EnSkb_Emerge(EnSkb* this, PlayState* play);  // was func_80AFCE5C [LLM:HIGH]
-void func_80AFCF48(EnSkb* this);
+// LLM generated name (HIGH), was func_80AFCF48: plays the uncurling animation in reverse with the hiding sfx and installs the burrowing action.
+void EnSkb_SetupBurrow(EnSkb* this);  // was func_80AFCF48 [LLM:HIGH]
 void func_80AFCFF0(EnSkb* this, PlayState* play);
 void func_80AFD0A4(EnSkb* this);
 void EnSkb_Advance(EnSkb* this, PlayState* play);
@@ -199,7 +200,7 @@ void EnSkb_Destroy(Actor* thisx, PlayState* play) {
 void EnSkb_ChooseAction(EnSkb* this) {
     // Don't despawn stallchildren during daytime when enemy randomizer is enabled.
     if (IS_DAY && !CVarGetInteger(CVAR_ENHANCEMENT("RandomizedEnemies"), 0)) {
-        func_80AFCF48(this);
+        EnSkb_SetupBurrow(this);  // was func_80AFCF48 [LLM:HIGH]
     } else if (Actor_IsFacingPlayer(&this->actor, 0x11C7) &&
                (this->actor.xzDistToPlayer < (60.0f + (this->actor.params * 6.0f)))) {
         func_80AFD33C(this);
@@ -233,7 +234,7 @@ void EnSkb_Emerge(EnSkb* this, PlayState* play) {
     }
 }
 
-void func_80AFCF48(EnSkb* this) {
+void EnSkb_SetupBurrow(EnSkb* this) {
     Animation_Change(&this->skelAnime, &gStalchildUncurlingAnim, -1.0f,
                      Animation_GetLastFrame(&gStalchildUncurlingAnim), 0.0f, ANIMMODE_ONCE, -4.0f);
     this->actionState = 0;
@@ -299,7 +300,7 @@ void EnSkb_Advance(EnSkb* this, PlayState* play) {
     // randomizer is enabled.
     if ((Math_Vec3f_DistXZ(&this->actor.home.pos, &player->actor.world.pos) > 800.0f || IS_DAY) &&
         !CVarGetInteger(CVAR_ENHANCEMENT("RandomizedEnemies"), 0)) {
-        func_80AFCF48(this);
+        EnSkb_SetupBurrow(this);  // was func_80AFCF48 [LLM:HIGH]
     } else if (Actor_IsFacingPlayer(&this->actor, 0x11C7) &&
                (this->actor.xzDistToPlayer < (60.0f + (this->actor.params * 6.0f)))) {
         func_80AFD33C(this);
