From adb3f1ddd0a399d0a229a6fb1fcfadfcf4912290 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 22:27:42 +0000
Subject: [PATCH 1576/3799] soh: rename func_80A40B1C -> EnGo_WaitToWalk

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: holds the Goron City doors Goron in the standing idle until INFTABLE_EB is set, then starts him walking his path.
Defined in soh/src/overlays/actors/ovl_En_Go/z_en_go.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Go/z_en_go.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Go/z_en_go.c b/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
index 04349143c..79e6d02ad 100644
--- a/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
+++ b/soh/src/overlays/actors/ovl_En_Go/z_en_go.c
@@ -31,7 +31,8 @@ void EnGo_BiggoronActionFunc(EnGo* this, PlayState* play);
 // LLM generated name (HIGH), was func_80A408D8: winds the animation back to the seated frame and then either curls up when its timer runs out, or stands again when the camera settles on the Goron.
 void EnGo_Sit(EnGo* this, PlayState* play);  // was func_80A408D8 [LLM:HIGH]
 
-void func_80A40B1C(EnGo* this, PlayState* play);
+// LLM generated name (HIGH), was func_80A40B1C: holds the Goron City doors Goron in the standing idle until INFTABLE_EB is set, then starts him walking his path.
+void EnGo_WaitToWalk(EnGo* this, PlayState* play);  // was func_80A40B1C [LLM:HIGH]
 void EnGo_GetItem(EnGo* this, PlayState* play);
 void func_80A40C78(EnGo* this, PlayState* play);
 void EnGo_Eyedrops(EnGo* this, PlayState* play);
@@ -409,7 +410,7 @@ void EnGo_TrackPlayer(EnGo* this, PlayState* play) {
     s16 trackingMode;
 
     if (this->actionFunc != EnGo_BiggoronActionFunc && this->actionFunc != EnGo_FireGenericActionFunc &&
-        this->actionFunc != func_80A40B1C) {
+        this->actionFunc != EnGo_WaitToWalk) {  // was func_80A40B1C [LLM:HIGH]
         trackingMode = NPC_TRACKING_NONE;
     }
 
@@ -588,7 +589,7 @@ void func_80A3F908(EnGo* this, PlayState* play) {
     if (this->actionFunc == EnGo_BiggoronActionFunc || this->actionFunc == EnGo_GoronLinkRolling ||
         this->actionFunc == EnGo_FireGenericActionFunc || this->actionFunc == EnGo_Eyedrops ||
         this->actionFunc == func_80A40DCC || this->actionFunc == EnGo_GetItem || this->actionFunc == func_80A40C78 ||
-        this->actionFunc == func_80A40B1C) {
+        this->actionFunc == EnGo_WaitToWalk) {  // was func_80A40B1C [LLM:HIGH]
 
         interactRange = (this->collider.dim.radius + 30.0f);
         interactRange *= (this->actor.scale.x / 0.01f);
@@ -859,7 +860,7 @@ void EnGo_Uncurl(EnGo* this, PlayState* play) {
         this->skelAnime.playSpeed = 0.0f;
         this->unk_212 = Rand_S16Offset(30, 30);
         if (((this->actor.params & 0xF0) == 0x40) && ((Flags_GetInfTable(INFTABLE_EB)) == 0)) {
-            EnGo_SetupAction(this, func_80A40B1C);
+            EnGo_SetupAction(this, EnGo_WaitToWalk);  // was func_80A40B1C [LLM:HIGH]
         } else {
             EnGo_SetupAction(this, EnGo_BiggoronActionFunc);
         }
@@ -945,7 +946,7 @@ void EnGo_WalkPath(EnGo* this, PlayState* play) {
     }
 }
 
-void func_80A40B1C(EnGo* this, PlayState* play) {
+void EnGo_WaitToWalk(EnGo* this, PlayState* play) {
     if (Flags_GetInfTable(INFTABLE_EB)) {
         EnGo_ChangeAnim(this, ENGO_ANIM_3);
         EnGo_SetupAction(this, EnGo_WalkPath);  // was func_80A40A54 [LLM:HIGH]
@@ -1038,7 +1039,7 @@ void EnGo_Update(Actor* thisx, PlayState* play) {
     SkelAnime_Update(&this->skelAnime);
 
     if (this->actionFunc == EnGo_BiggoronActionFunc || this->actionFunc == EnGo_FireGenericActionFunc ||
-        this->actionFunc == func_80A40B1C) {
+        this->actionFunc == EnGo_WaitToWalk) {  // was func_80A40B1C [LLM:HIGH]
         Actor_UpdateFidgetTables(play, this->jointTable, this->morphTable, 18);
     }
 
