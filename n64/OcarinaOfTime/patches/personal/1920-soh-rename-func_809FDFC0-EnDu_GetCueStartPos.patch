From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:03:59 +0000
Subject: [PATCH 1920/3799] soh: rename func_809FDFC0 -> EnDu_GetCueStartPos

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: copies a CsCmdActorCue's startPos into the caller's Vec3f
Defined in soh/src/overlays/actors/ovl_En_Du/z_en_du.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Du/z_en_du.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Du/z_en_du.c b/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
index db90abe14..588882910 100644
--- a/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
+++ b/soh/src/overlays/actors/ovl_En_Du/z_en_du.c
@@ -258,7 +258,8 @@ void EnDu_UpdateFace(EnDu* this) {
     }
 }
 
-void func_809FDFC0(CsCmdActorCue* csAction, Vec3f* dst) {
+// LLM generated name (HIGH), was func_809FDFC0: copies a CsCmdActorCue's startPos into the caller's Vec3f
+void EnDu_GetCueStartPos(CsCmdActorCue* csAction, Vec3f* dst) {
     dst->x = csAction->startPos.x;
     dst->y = csAction->startPos.y;
     dst->z = csAction->startPos.z;
@@ -488,10 +489,10 @@ void func_809FE890(EnDu* this, PlayState* play) {
     csAction = play->csCtx.npcActions[2];
 
     if (csAction != NULL) {
-        func_809FDFC0(csAction, &startPos);
+        EnDu_GetCueStartPos(csAction, &startPos);  // was func_809FDFC0 [LLM:HIGH]
         func_809FE000(csAction, &endPos);
         if (this->unk_1EA == 0) {
-            func_809FDFC0(csAction, &startPos);
+            EnDu_GetCueStartPos(csAction, &startPos);  // was func_809FDFC0 [LLM:HIGH]
             this->actor.world.pos = startPos;
         }
         if (this->unk_1EA != csAction->action) {
