 }
 
-void func_80B40C74(EnXc* this) {
+// LLM generated name (HIGH), was func_80B40C74: the same guard from action 66 to 67
+void EnXc_NextAfterAction66(EnXc* this) {
     EnXc_CheckAndSetAction(this, SHEIK_ACTION_66, SHEIK_ACTION_67);
 }
 
@@ -2176,7 +2177,7 @@ void EnXc_ActionFunc65(EnXc* this, PlayState* play) {
 
