From e6cacce5adaa0323b3146cfa42371893d8fdf70a Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Tue, 8 Sep 2026 00:19:09 +0000
Subject: [PATCH 3427/3799] soh: rename D_80130510 -> sVibratoFreqScale

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: the frequency scale Audio_GetVibratoFreqScale keeps between calls
Defined in soh/src/code/audio_effects.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/audio_effects.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/audio_effects.c b/soh/src/code/audio_effects.c
index 476e8e3ba..64c7eaf88 100644
--- a/soh/src/code/audio_effects.c
+++ b/soh/src/code/audio_effects.c
@@ -109,7 +109,7 @@ s16 Audio_GetVibratoPitchChange(VibratoState* vib) {
 }
 
 f32 Audio_GetVibratoFreqScale(VibratoState* vib) {
-    static f32 D_80130510 = 0.0f;
+    static f32 sVibratoFreqScale = 0.0f;  // was D_80130510 [LLM:HIGH]
     static s32 D_80130514 = 0;
     f32 pitchChange;
     f32 extent;
@@ -166,7 +166,7 @@ f32 Audio_GetVibratoFreqScale(VibratoState* vib) {
 
     result = 1.0f / ((extent - invExtent) * pitchChange / 65536.0f + invExtent);
 
-    D_80130510 += result;
+    sVibratoFreqScale += result;  // was D_80130510 [LLM:HIGH]
     D_80130514++;
 
     return result;
-- 
2.55.0

