From 2bd522179c5af5cd328a79c18896aad9b8ea9692 Mon Sep 17 00:00:00 2001
From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 21:22:01 +0000
Subject: [PATCH 0916/3799] soh: rename D_8012D248 -> sUCodeInfoFault

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: UCodeInfo table registered with the disassembler by Graph_UCodeFaultClient.
Defined in soh/src/code/graph.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/code/graph.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/code/graph.c b/soh/src/code/graph.c
index acdc4c2ca..92241f3a5 100644
--- a/soh/src/code/graph.c
+++ b/soh/src/code/graph.c
@@ -38,7 +38,8 @@ UCodeInfo sUCodeInfoDisas[3] = {  // was D_8012D230 [LLM:HIGH]
     //{ UCODE_S2DEX, D_80113070 },
 };
 
-UCodeInfo D_8012D248[3] = {
+// LLM generated name (HIGH), was D_8012D248: UCodeInfo table registered with the disassembler by Graph_UCodeFaultClient.
+UCodeInfo sUCodeInfoFault[3] = {  // was D_8012D248 [LLM:HIGH]
     //{ UCODE_F3DZEX, D_80155F50 },
     { UCODE_UNK, NULL },
     //{ UCODE_S2DEX, D_80113070 },
@@ -97,7 +98,7 @@ void Graph_UCodeFaultClient(Gfx* workBuf) {
 
     UCodeDisas_Init(&disassembler);
     disassembler.enableLog = true;
-    UCodeDisas_RegisterUCode(&disassembler, ARRAY_COUNT(D_8012D248), D_8012D248);
+    UCodeDisas_RegisterUCode(&disassembler, ARRAY_COUNT(sUCodeInfoFault), sUCodeInfoFault);  // was D_8012D248 [LLM:HIGH]
     //UCodeDisas_SetCurUCode(&disassembler, D_80155F50);
     UCodeDisas_Disassemble(&disassembler, workBuf);
     UCodeDisas_Destroy(&disassembler);
-- 
