Subject: [PATCH 0539/3799] soh: rename func_80AEB954 ->
 EnRu1_StartSwimmingTowardLink

Name source: zeldaret/oot (same decomp, same ROM address).
Body verified against upstream at 1.00.
Defined in soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c.
---
 soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
index a50e15035..96fb0e881 100644
--- a/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
+++ b/soh/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c
@@ -540,7 +540,8 @@ void func_80AEB934(EnRu1* this, PlayState* play) {
     func_80AEB89C(this, play);
 }
 
-void func_80AEB954(EnRu1* this, PlayState* play) {
+// Name from zeldaret/oot (was func_80AEB954): adopted upstream's name for this address; body verified to match upstream at 1.00. [oot: https://github.com/zeldaret/oot/blob/main/src/overlays/actors/ovl_En_Ru1/z_en_ru1.c]
+void EnRu1_StartSwimmingTowardLink(EnRu1* this, PlayState* play) {
     EnRu1_StartMovingInWater(this, play);
 }
 
@@ -672,7 +673,7 @@ void func_80AEBE3C(EnRu1* this, PlayState* play, s32 arg2) {
         Animation_Change(&this->skelAnime, &gRutoChildTreadWaterAnim, 1.0f, 0, frameCount, ANIMMODE_LOOP, -8.0f);
         this->action = 3;
     } else {
-        func_80AEB954(this, play);
+        EnRu1_StartSwimmingTowardLink(this, play);
     }
 }
 
