                          &gSfxDefaultReverb);
 }
 
-void func_800F4254(Vec3f* pos, u8 level) {
+// Name from zeldaret/oot src/audio/game/general.c (was func_800F4254): plays sword-charge SFX at pos by charge level. Source: https://github.com/zeldaret/oot/blob/main/src/audio/game/general.c
+void Audio_PlaySwordChargeSfx(Vec3f* pos, u8 level) {
     level &= 3;
     if (level != sPrevChargeLevel) {
         sSfxSwordChargeFreq = sSfxSwordChargeFreqLevels[level];
diff --git a/soh/src/overlays/actors/ovl_En_M_Thunder/z_en_m_thunder.c b/soh/src/overlays/actors/ovl_En_M_Thunder/z_en_m_thunder.c
