     PauseContext* pauseCtx = &play->pauseCtx;
     s32 cond = false;
     s32 mode;
@@ -4290,7 +4291,7 @@ void KaleidoScope_Update(PlayState* play) {
                     break;
 
                 case 1:
-                    func_808237B4(play, play->state.input);
+                    KaleidoScope_RotatePageSlow(play, play->state.input);  // was func_808237B4 [LLM:HIGH]
                     break;
 
                 case 2:
