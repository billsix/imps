From: William Emerison Six <billsix@gmail.com>
Date: Mon, 7 Sep 2026 23:56:48 +0000
Subject: [PATCH 2944/3799] soh: rename func_80B41798 ->
 EnXc_BlockPedestalAfterText

Name source: DEDUCED from the code (confidence HIGH) -- zeldaret/oot
leaves this symbol address-named too, so there is no upstream name to adopt.
Reason: returns to blocking the pedestal and drops targeting once the textbox closes
Defined in soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c.

Tagged [LLM:HIGH] at the definition, every declaration and every call site, so a
reader meeting the name anywhere knows it is inferred.
---
 soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
index 01be93820..344a17202 100644
--- a/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
+++ b/soh/src/overlays/actors/ovl_En_Xc/z_en_xc.c
@@ -2312,7 +2312,8 @@ void EnXc_SetupDialogueAction(EnXc* this, PlayState* play) {
     }
 }
 
-void func_80B41798(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B41798: returns to blocking the pedestal and drops targeting once the textbox closes
+void EnXc_BlockPedestalAfterText(EnXc* this, PlayState* play) {
     if (Message_GetState(&play->msgCtx) == TEXT_STATE_CLOSING) {
         this->action = SHEIK_ACTION_BLOCK_PEDESTAL;
         this->actor.flags &= ~(ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_FRIENDLY);
@@ -2334,7 +2335,7 @@ void EnXc_ActionFunc80(EnXc* this, PlayState* play) {
     EnXc_CalculateHeadTurn(this, play);
     EnXc_AnimIsFinished(this);
     EnXc_SetEyePattern(this);
-    func_80B41798(this, play);
+    EnXc_BlockPedestalAfterText(this, play);  // was func_80B41798 [LLM:HIGH]
 }
 
 static EnXcActionFunc sActionFuncs[] = {
