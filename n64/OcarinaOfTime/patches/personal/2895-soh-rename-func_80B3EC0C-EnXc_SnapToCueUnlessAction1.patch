     this->action = SHEIK_ACTION_21;
 }
 
-void func_80B3EC0C(EnXc* this, PlayState* play) {
+// LLM generated name (HIGH), was func_80B3EC0C: snaps Sheik onto cue 4's start position whenever that cue is on anything but action 1
+void EnXc_SnapToCueUnlessAction1(EnXc* this, PlayState* play) {
     CutsceneContext* csCtx = &play->csCtx;
 
     if (csCtx->state != 0) {
@@ -1237,7 +1238,7 @@ void EnXc_ActionFunc20(EnXc* this, PlayState* play) {
 }
 
 void EnXc_ActionFunc21(EnXc* this, PlayState* play) {
-    func_80B3EC0C(this, play);
+    EnXc_SnapToCueUnlessAction1(this, play);  // was func_80B3EC0C [LLM:HIGH]
 }
 
